    private static string? GetInterventionDescription(
        ConsultationItem item)
    {
        var root =
            GetRawRootElement(item);

        var header =
            GetObjectProperty(
                root,
                "Header",
                "header");

        var quote =
            GetSelectedQuotationElement(item);

        var line =
            GetRelatedLineElement(
                item,
                quote);

        var directWork =
            GetJsonText(
                root,
                "WorkDescription",
                "workDescription",
                "NeedDescription",
                "needDescription");

        var headerNeed =
            GetJsonText(
                header,
                "NeedDescription",
                "needDescription",
                "Justification",
                "justification");

        var quoteDetail =
            GetJsonText(
                quote,
                "AdditionalDetails",
                "additionalDetails",
                "Description",
                "description");

        var lineDetail =
            GetJsonText(
                line,
                "Details",
                "details",
                "Novelty",
                "novelty",
                "ItemDescription",
                "itemDescription",
                "NeedDetail",
                "needDetail");

        return FirstNonBlank(
            directWork,
