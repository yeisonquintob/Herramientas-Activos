        editingQuoteId = quote.Id;
        quoteForm.Provider = quote.Provider;
        quoteForm.LineIdText =
            quote.LineId?.ToString()
            ??
            GetDefaultQuotationLineIdText();
        quoteForm.QuotationDate = quote.QuotationDate;
        quoteForm.DeliveryTime = quote.DeliveryTime;
        quoteForm.PriceBeforeVat = quote.PriceBeforeVat;
        quoteForm.EvidenceId = quote.EvidenceId;
        quoteForm.EvidencePendingUpload =
            !quote.EvidenceId.HasValue &&
            IsDataImage(quote.EvidencePreview);
        quoteForm.EvidenceFileName = quote.EvidenceFileName;
        quoteForm.EvidenceContentType = quote.EvidenceContentType;
        quoteForm.EvidencePreview = quote.EvidencePreview;
        quoteForm.AdditionalDetails = quote.AdditionalDetails;
    }

