@page "/counter"
@rendermode InteractiveServer

<PageTitle>Contador - NAVI</PageTitle>

<NaviPageHero Pill="DEMO"
              Title="Contador"
              Description="Vista técnica de prueba con el estándar visual del Admin Web." />

<section class="admin-standard-card demo-standard-card">
    <p role="status">Conteo actual: <strong>@currentCount</strong></p>

    <button class="btn btn-primary" @onclick="IncrementCount">Incrementar</button>
</section>

<style>
    .demo-standard-card {
        padding: 1rem;
        display: grid;
        gap: .85rem;
        justify-items: start;
    }

    .demo-standard-card p {
        margin: 0;
        color: #344054;
        font-size: .95rem;
        font-weight: 700;
    }
</style>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
