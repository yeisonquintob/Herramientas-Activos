@page "/asset-assignment-history"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Navi.ToolsAssets.Admin.Services.Auth
@using Navi.ToolsAssets.Admin.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject NaviAccessScopeService AccessScope
@inject WebAuthSessionService AuthSession

<PageTitle>Historial de asignaciones - NAVI</PageTitle>

<PermissionGuard Permission="AssetAssignment.History" ModuleName="Historial de asignaciones">

<NaviPageHero
    Pill="ACTIVOS FIJOS"
    Title="Historial de asignaciones"
    Description="Consulta herramientas asignadas por usuario, sede, estado, fecha de entrega, fecha de regreso y detalle del movimiento.">

    <button type="button" @onclick="LoadHistoryAsync">
        Actualizar
    </button>

</NaviPageHero>


<section class="assignment-history-kpis assignment-history-kpi-grid">
    <article class="assignment-history-kpi total">
        <span>Movimientos</span>
        <strong>@FilteredHistory.Count()</strong>
        <small>Según filtros activos</small>
    </article>

    <article class="assignment-history-kpi blue">
        <span>Asignadas / prestadas</span>
        <strong>@FilteredHistory.Count(x => string.Equals(x.CurrentStatus, "Assigned", StringComparison.OrdinalIgnoreCase) || string.Equals(x.CurrentStatus, "Loaned", StringComparison.OrdinalIgnoreCase))</strong>
        <small>Con responsable</small>
    </article>

    <article class="assignment-history-kpi warning">
        <span>Regresos</span>
        <strong>@FilteredHistory.Count(x => x.ReturnedAt.HasValue)</strong>
        <small>Con fecha de regreso</small>
    </article>

    <article class="assignment-history-kpi success">
        <span>Sedes</span>
        <strong>@FilteredHistory.Select(x => x.CurrentBranchCode ?? string.Empty).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Count()</strong>
        <small>En resultado filtrado</small>
    </article>

    <article class="assignment-history-kpi danger">
        <span>Usuarios</span>
        <strong>@FilteredHistory.Select(x => x.CurrentResponsibleName ?? string.Empty).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Count()</strong>
        <small>Responsables visibles</small>
    </article>
</section>

<section class="assignment-history-status-filters assignment-history-status-filters-modern" aria-label="Estados del historial">
    <button type="button"
            class="assignment-history-status-filter-chip assignment-history-status-all @(selectedStatuses.Count == 0 ? "active" : "")"
            @onclick="ClearStatusFilter">
        Todos
        <span>@AssignmentHistoryBaseFiltered.Count()</span>
    </button>

    @foreach (var status in StatusOptions)
    {
        var selected = selectedStatuses.Contains(status.Value);

        <button type="button"
                class="@GetAssignmentHistoryStatusChipClass(status.Value, selected)"
                @onclick="() => ToggleStatus(status.Value)">
            @status.Text
            <span>@AssignmentHistoryBaseFiltered.Count(x => string.Equals(x.CurrentStatus, status.Value, StringComparison.OrdinalIgnoreCase))</span>
        </button>
    }
</section>

<section class="assignment-history-page-filters" aria-label="Filtros del historial de asignaciones">
    <input class="form-control form-control-sm"
           placeholder="Buscar código, herramienta, serial, detalle, usuario, sede o ubicación..."
           @bind="search"
           @bind:event="oninput" />

    <input class="form-control form-control-sm"
           list="assignment-history-responsibles-list"
           value="@selectedResponsibleSearchText"
           @oninput="OnResponsibleFilterInput"
           placeholder="Todos los usuarios" />

    <datalist id="assignment-history-responsibles-list">
        <option value="Todos los usuarios"></option>
        @foreach (var responsible in VisibleResponsibles)
        {
            <option value="@FormatResponsibleHistoryOption(responsible)"></option>
            <option value="@responsible.FullName"></option>
        }
    </datalist>

    @if (AccessScope.IsAllBranchScope() || AccessScope.IsAdminRole())
    {
        <select class="form-select form-select-sm" @bind="selectedBranchCode">
            <option value="">Todas las sedes</option>
            @foreach (var branch in BranchOptions)
            {
                <option value="@branch">@branch</option>
            }
        </select>
    }
    else
    {
        <input class="form-control form-control-sm" value="@ScopeLabel" disabled />
    }

    <div class="assignment-history-filter-actions">
        <button type="button" class="btn btn-primary btn-sm" @onclick="LoadHistoryAsync">
            Filtrar
        </button>

        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearFilters">
            Limpiar
        </button>
    </div>
</section>

<section class="history-card history-card-v2">
    <div class="history-table-header history-table-header-v2">
        <div>
            <h3>Resultado del historial</h3>
            <p>Se muestran las asignaciones y regresos encontrados según usuario, sede, estado y texto de búsqueda.</p>
        </div>

        <div class="history-summary-pill-v2">
            @FilteredHistory.Count() de @VisibleHistory.Count()
        </div>
    </div>

    @if (isLoading)
    {
        <p>Cargando historial...</p>
    }
    else if (!FilteredHistory.Any())
    {
        <div class="alert alert-info">No hay movimientos para mostrar con los filtros actuales.</div>
    }
    else
    {
        <table class="table table-hover align-middle history-table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Herramienta / Activo</th>
                    <th>Usuario actual</th>
                    <th>Sede / ubicación</th>
                    <th>Estado</th>
                    <th>Fecha entrega</th>
                    <th>Fecha regreso</th>
                    <th>Detalle</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in FilteredHistory)
                {
                    <tr>
                        <td><strong>@item.ToolInternalCode</strong></td>

                        <td>
                            <div>@item.ToolName</div>
                            <small class="text-muted">@Show(item.ToolSerialNumber)</small>
                        </td>

                        <td>@Show(item.CurrentResponsibleName)</td>

                        <td>
                            <div>@Show(item.CurrentBranchCode)</div>
                            <small class="text-muted">@Show(item.CurrentLocationName)</small>
                        </td>

                        <td>
                            <span class="@GetStatusBadge(item.CurrentStatus ?? string.Empty)">
                                @GetStatusLabel(item.CurrentStatus ?? string.Empty)
                            </span>
                        </td>

                        <td>@ShowDate(item.AssignedAt)</td>

                        <td>@ShowDate(item.ReturnedAt)</td>

                        <td>
                            <div>@Show(item.Detail)</div>

                            @if (!string.IsNullOrWhiteSpace(item.ReturnDetail))
                            {
                                <small class="text-muted">Regreso: @item.ReturnDetail</small>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

</PermissionGuard>

