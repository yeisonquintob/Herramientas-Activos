@using System.Collections.Generic
@using Microsoft.AspNetCore.Components

@inject NaviMobilePageHeaderState ShellHeader

@if (RenderActions)
{
    <div @attributes="AdditionalAttributes"
         class="@ActionsCssClass"
         data-ntx-component="mobile-page-published-actions">
        @Actions
    </div>
}

@code {
    /*
     * Este componente se conserva para no modificar todas las
     * páginas que ya lo utilizan.
     *
     * Ya no dibuja un segundo encabezado. Publica el título,
     * descripción y configuración del botón regresar al banner
     * global del MainLayout.
     */

    [Parameter]
    public string? Pill { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool ShowHomeButton { get; set; } = true;

    [Parameter]
    public bool ShowBackButton { get; set; } = true;

    [Parameter]
    public string HomeText { get; set; } = "Inicio";

    [Parameter]
    public string BackText { get; set; } = "Atrás";

    [Parameter]
    public string HomeUrl { get; set; } = "/";

    [Parameter]
    public string? BackUrl { get; set; }

    [Parameter]
    public string BackFallbackUrl { get; set; } = "/";

    [Parameter]
    public bool UseBrowserHistoryWhenNoBackUrl { get; set; } = true;

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>?
        AdditionalAttributes { get; set; }

    protected override void OnParametersSet()
    {
        ShellHeader.Set(
            Title,
            Description,
            ShowBackButton,
            BackUrl,
            BackFallbackUrl,
            UseBrowserHistoryWhenNoBackUrl);
    }

    private bool IsHomePrincipalBanner =>
        !string.IsNullOrWhiteSpace(Class) &&
        Class.Contains(
            "navi-mobile-home-principal-banner",
            StringComparison.OrdinalIgnoreCase);

    /*
     * El inicio ya tiene el cierre de sesión dentro del avatar.
     * Por eso se descartan las acciones antiguas de ese banner.
     */
    private bool RenderActions =>
        Actions is not null &&
        !IsHomePrincipalBanner;

    private string ActionsCssClass =>
        "navi-mobile-published-actions";
}
