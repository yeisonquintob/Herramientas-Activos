            lineDetail,
            item.Description);
    }

    private static JsonElement
        GetSelectedQuotationElement(
            ConsultationItem item)
    {
        var root =
            GetRawRootElement(item);

        var quotations =
            GetArrayProperty(
                root,
                "Quotations",
                "quotations");

        if (
            quotations.ValueKind
            != JsonValueKind.Array)
        {
            return default;
        }

        JsonElement? onlyQuotation = null;
        var quotationCount = 0;

        foreach (
            var quotation
            in quotations.EnumerateArray())
        {
            if (
                quotation.ValueKind
                != JsonValueKind.Object)
            {
                continue;
            }

            quotationCount++;

            onlyQuotation ??=
                quotation.Clone();

            if (
                GetJsonBoolean(
                    quotation,
                    "Selected",
                    "selected"))
            {
                return quotation.Clone();
            }
        }

        return (
            quotationCount == 1
            && onlyQuotation.HasValue)
            ? onlyQuotation.Value
            : default;
    }

    private static JsonElement
        GetRelatedLineElement(
            ConsultationItem item,
            JsonElement quotation)
    {
        var root =
            GetRawRootElement(item);

        var lines =
            GetArrayProperty(
                root,
                "Lines",
                "lines");

        if (
            lines.ValueKind
            != JsonValueKind.Array)
        {
            return default;
        }

        var quotationLineId =
            GetJsonText(
                quotation,
                "LineId",
                "lineId");

        JsonElement? onlyLine = null;
        var lineCount = 0;

        foreach (
            var line
            in lines.EnumerateArray())
        {
            if (
                line.ValueKind
                != JsonValueKind.Object)
            {
                continue;
            }

            lineCount++;

            onlyLine ??=
                line.Clone();

            var lineId =
                GetJsonText(
                    line,
                    "Id",
                    "id");

            if (
                !string.IsNullOrWhiteSpace(
                    quotationLineId)
                && string.Equals(
                    quotationLineId,
                    lineId,
                    StringComparison.OrdinalIgnoreCase))
            {
                return line.Clone();
            }
        }

        return (
            lineCount == 1
            && onlyLine.HasValue)
            ? onlyLine.Value
            : default;
    }

    private static JsonElement
        GetRawRootElement(
            ConsultationItem item)
    {
        if (
            string.IsNullOrWhiteSpace(
                item.RawText))
        {
            return default;
        }

        try
        {
            using var document =
                JsonDocument.Parse(
                    item.RawText);

            return document
                .RootElement
                .Clone();
        }
        catch
        {
            return default;
        }
    }

    private static JsonElement
        GetObjectProperty(
            JsonElement element,
            params string[] names)
    {
        if (
            TryGetJsonProperty(
                element,
                out var property,
                names)
            && property.ValueKind
                == JsonValueKind.Object)
        {
            return property.Clone();
        }

        return default;
    }

    private static JsonElement
        GetArrayProperty(
            JsonElement element,
            params string[] names)
    {
        if (
            TryGetJsonProperty(
                element,
                out var property,
                names)
            && property.ValueKind
                == JsonValueKind.Array)
        {
            return property.Clone();
        }

        return default;
    }

    private static string? GetJsonText(
        JsonElement element,
        params string[] names)
    {
        if (
            !TryGetJsonProperty(
                element,
                out var property,
                names))
        {
            return null;
        }

        return property.ValueKind switch
        {
            JsonValueKind.String
                => property.GetString(),

            JsonValueKind.Number
                or JsonValueKind.True
                or JsonValueKind.False
                => property.ToString(),

            _ => null
        };
    }

    private static bool GetJsonBoolean(
        JsonElement element,
        params string[] names)
    {
        if (
            !TryGetJsonProperty(
                element,
                out var property,
                names))
        {
            return false;
        }

        if (
            property.ValueKind
            == JsonValueKind.True)
        {
            return true;
        }

        if (
            property.ValueKind
            == JsonValueKind.False)
        {
            return false;
        }

        return bool.TryParse(
            property.ToString(),
            out var result)
            && result;
    }

    private static bool TryGetJsonProperty(
        JsonElement element,
        out JsonElement value,
        params string[] names)
    {
        value = default;

        if (
            element.ValueKind
            != JsonValueKind.Object)
        {
            return false;
        }

        foreach (
            var property
            in element.EnumerateObject())
        {
            if (
                names.Any(
                    name => string.Equals(
                        property.Name,
                        name,
                        StringComparison.OrdinalIgnoreCase)))
            {
                value = property.Value;
                return true;
            }
        }

        return false;
    }

    private static string? FirstNonBlank(
        params string?[] values)
    {
        return values.FirstOrDefault(
            value =>
                !string.IsNullOrWhiteSpace(
                    value));
    }

    private static bool IsUsableImageSource(
        string? source)
    {
        if (
            string.IsNullOrWhiteSpace(
                source))
        {
            return false;
        }

        return source.StartsWith(
                   "data:image/",
                   StringComparison.OrdinalIgnoreCase)
               || source.StartsWith(
                   "https://",
                   StringComparison.OrdinalIgnoreCase)
               || source.StartsWith(
                   "http://",
                   StringComparison.OrdinalIgnoreCase)
               || source.StartsWith(
                   "/",
                   StringComparison.Ordinal);
    }

    
