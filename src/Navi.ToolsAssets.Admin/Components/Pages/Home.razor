    private string GetDashboardLifePercentLabel(
        int value)
    {
        var total =
            GetDashboardLifeRecordTotal();

        if (value <= 0 || total <= 0)
        {
            return "0%";
        }

        var percentage = Math.Round(
            (decimal)value / total * 100,
            1);

        var percentageText = percentage.ToString(
            "0.#",
            System.Globalization.CultureInfo.InvariantCulture);

        return percentageText + "%";
    }

    private string GetDashboardLifeRingSegmentStyle(
        int value,
        int previousValue)
    {
        const decimal circumference = 263.89m;

        var total =
            GetDashboardLifeRecordTotal();

        if (value <= 0 || total <= 0)
        {
            return
                "stroke-dasharray:0 263.89;" +
                "stroke-dashoffset:0;";
        }

        var segmentLength =
            circumference * value / total;

        var remainingLength = Math.Max(
            0,
            circumference - segmentLength);

        var offset =
            -(circumference * previousValue / total);

        var segmentText = segmentLength.ToString(
            "0.##",
            System.Globalization.CultureInfo.InvariantCulture);

        var remainingText = remainingLength.ToString(
            "0.##",
            System.Globalization.CultureInfo.InvariantCulture);

        var offsetText = offset.ToString(
            "0.##",
            System.Globalization.CultureInfo.InvariantCulture);

        return
            "stroke-dasharray:"
            + segmentText
            + " "
            + remainingText
            + ";stroke-dashoffset:"
            + offsetText
            + ";";
    }

