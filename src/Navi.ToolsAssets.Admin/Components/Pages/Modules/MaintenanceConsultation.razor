@page "/maintenance"
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Navi.ToolsAssets.Admin.Services.Auth
@using Navi.ToolsAssets.Admin.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject WebAuthSessionService AuthSession
@inject IJSRuntime JS

<PageTitle>Consulta Compras y Mtto.</PageTitle>

@if (!CanViewModule)
{
    <NaviPageHero
        Pill="OPERACIONES"
        Title="Consulta Compras y Mtto."
        Description="No tienes permisos para consultar solicitudes de compra o mantenimiento." />

    <div class="alert alert-warning">
        Requiere al menos <strong>Purchases.View</strong> o <strong>Maintenance.View</strong>.
    </div>
}
else
{
    @* NAVI CONSULTA COMPRAS MTTO VISUAL V134 START *@
    <section class="assignment-history-web-v26 consult-history-layout-v137">
    
    <NaviPageHero
        Pill="OPERACIONES"
        Title="Consulta Compras y Mtto."
        Description="Consulta solicitudes y cotizaciones de compra y mantenimiento. La generación final y la cotización se realizan desde la solicitud; esta vista es de consulta, seguimiento y cierre." />
    
    <NaviKpiToolbar
        Class="consult-kpi-toolbar-v134"
        Refresh="RefreshAsync"
        IsRefreshing="isLoading"
        RefreshTitle="Actualizar consulta"
        RefreshAriaLabel="Actualizar consulta de compras y mantenimiento">
    
        <NaviKpiGrid
            Columns="6"
            Dividers="true"
            Compact="true"
            Class="consult-kpi-grid consult-kpi-grid-v134">
    
            <NaviKpiCard
                Title="Total"
                Description="Solicitudes visibles"
                Tone="neutral"
                Compact="true"
                Class="consult-kpi consult-kpi-v134">
    
                <IconContent>
                    <NaviKpiIcon Name="document" />
                </IconContent>
    
                <ValueContent>
                    @FilteredItems.Count()
                </ValueContent>
            </NaviKpiCard>
    
            <NaviKpiCard
                Title="Compras"
                Description="Herramientas y AF"
                Tone="neutral"
                Compact="true"
                Class="consult-kpi consult-kpi-v134">
    
                <IconContent>
                    <NaviKpiIcon Name="cart" />
                </IconContent>
    
                <ValueContent>
                    @FilteredPurchases.Count()
                </ValueContent>
            </NaviKpiCard>
    
            <NaviKpiCard
                Title="Mantenimiento"
                Description="Solicitudes de mtto."
                Tone="soft"
                Compact="true"
                Class="consult-kpi consult-kpi-v134">
    
                <IconContent>
                    <NaviKpiIcon Name="wrench" />
                </IconContent>
    
                <ValueContent>
                    @FilteredMaintenances.Count()
                </ValueContent>
            </NaviKpiCard>
    
            <NaviKpiCard
                Title="En revisión"
                Description="Pendientes por aprobar"
                Tone="warning"
                Compact="true"
                Class="consult-kpi consult-kpi-v134">
    
                <IconContent>
                    <NaviKpiIcon Name="clock" />
                </IconContent>
    
                <ValueContent>
                    @FilteredItems.Count(x => IsStatus(x, "InReview"))
                </ValueContent>
            </NaviKpiCard>
    
            <NaviKpiCard
                Title="Aprobadas / ejecución"
                Description="Solicitudes que suman costo"
                Tone="positive"
                Compact="true"
                Class="consult-kpi consult-kpi-v134">
    
                <IconContent>
                    <NaviKpiIcon Name="check" />
                </IconContent>
    
                <ValueContent>
                    @FilteredItems.Count(x => IsPositiveCostStatus(x.Status))
                </ValueContent>
            </NaviKpiCard>
    
            <NaviKpiCard
                Title="Rechazadas"
                Description="No continúan ni suman"
                Tone="danger"
                Compact="true"
                Class="consult-kpi consult-kpi-v134">
    
                <IconContent>
                    <NaviKpiIcon Name="alert" />
                </IconContent>
    
                <ValueContent>
                    @FilteredItems.Count(x => IsRejectedOrCanceled(x.Status))
                </ValueContent>
            </NaviKpiCard>
    
            
    
        </NaviKpiGrid>
    </NaviKpiToolbar>
    
    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="alert alert-success consult-alert-v134">
            @StatusMessage
        </div>
    }
    
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-warning consult-alert-v134">
            @ErrorMessage
        </div>
    }
    
    <section
        class="assignment-history-v26-filter-card consult-page-filters consult-page-filters-v134"
        aria-label="Filtros de consulta">
    
        <div class="assignment-history-v26-field consult-filter-field-v134">
            <label for="consult-type-filter-v134">
                Tipo de consulta
            </label>
    
            <select
                id="consult-type-filter-v134"
                class="form-select form-select-sm"
                @bind="typeFilter"
                name="navi-maintenanceconsultation-field-001">
    
                <option value="all">
                    Compra y mantenimiento
                </option>
    
                <option value="purchase">
                    Solo compras
                </option>
    
                <option value="maintenance">
                    Solo mantenimiento
                </option>
            </select>
        </div>
    
        
        <div class="assignment-history-v26-field consult-filter-field-v134">
            <label for="consult-status-filter-v1371">
                Estado
            </label>

            <select
                id="consult-status-filter-v1371"
                class="form-select form-select-sm"
                @bind="statusFilter"
                name="navi-maintenanceconsultation-field-status">

                <option value="all">
                    Todos (@ConsultBaseFilteredItems.Count())
                </option>

                @foreach (var status in ConsultStatusOptions)
                {
                    <option value="@status.Value">
                        @status.Text
                        (@ConsultBaseFilteredItems.Count(
                            x => IsStatus(x, status.Value)))
                    </option>
                }
            </select>
        </div>

<div class="assignment-history-v26-field consult-filter-field-v134">
            <label for="consult-search-filter-v134">
                Buscar
            </label>
    
            <input
                id="consult-search-filter-v134"
                class="form-control form-control-sm"
                @bind="searchText"
                @bind:event="oninput"
                placeholder="Solicitud, activo, proveedor, técnico o sede..."
                name="navi-maintenanceconsultation-field-002" />
        </div>
    
        <div class="assignment-history-v26-filter-actions consult-page-filter-actions">
            <button
                type="button"
                class="assignment-history-v26-filter-button btn ntx-btn--operation btn-sm"
                @onclick="ApplyFilters"
                data-ntx-tone="operation">
    
                Filtrar
            </button>
    
            <button
                type="button"
                class="assignment-history-v26-clear-button btn btn-outline-secondary btn-sm"
                @onclick="ClearConsultFilters"
                data-ntx-tone="secondary">
    
                Limpiar
            </button>
        </div>
    </section>

@* NAVI CONSULT COST SUMMARY COMPACT V135.1 START *@
<section
    class="consult-panel consult-cost-summary-v134 consult-cost-summary-v135"
    aria-labelledby="consult-cost-summary-title-v1351">

    <div class="consult-cost-summary-header-v135">
        <div class="consult-cost-summary-copy-v135">
            <span class="consult-eyebrow-v134">
                RESUMEN FINANCIERO
            </span>

            <h3 id="consult-cost-summary-title-v1351">
                Resumen de costos
            </h3>

            <p>
                Solo suman solicitudes aprobadas, programadas,
                en ejecución o cerradas.
            </p>
        </div>

        <div class="consult-cost-total-v135">
            <small>Total estimado</small>
            <strong>@FormatMoney(TotalEstimatedCost)</strong>
            <span>@CostedItemsCount solicitudes con costo</span>
        </div>
    </div>

    <div class="cost-summary-stack-v134 cost-summary-stack-v135">

        <section
                            class="cost-block purchase cost-kpi-card-v134 cost-kpi-card-v135"
                            aria-labelledby="consult-purchase-cost-title-v134">
    
                            <div class="cost-kpi-heading-v134">
                                <span class="cost-kpi-icon-v134" aria-hidden="true">
                                    <NaviKpiIcon Name="cart" />
                                </span>
    
                                <div>
                                    <small>Compras</small>
    
                                    <strong id="consult-purchase-cost-title-v134">
                                        @FormatMoney(PurchaseCost)
                                    </strong>
                                </div>
                            </div>
    
                            <div
                                class="consult-cost-chart-v134"
                                role="img"
                                aria-label="Participación del costo de compras">
    
                                <div class="consult-cost-chart-track-v134">
                                    <span
                                        class="consult-cost-chart-fill-v134 purchase"
                                        style="@NaviChartWidth(
                                            PurchaseCost,
                                            TotalEstimatedCost)">
                                    </span>
                                </div>
    
                                <small>
                                    Participación sobre el costo total
                                </small>
                            </div>
    
                            <dl class="cost-metrics-v134">
                                <div>
                                    <dt>Promedio</dt>
                                    <dd>@FormatMoney(PurchaseAverage)</dd>
                                </div>
    
                                <div>
                                    <dt>Mayor costo</dt>
                                    <dd>@FormatMoney(PurchaseMax)</dd>
                                </div>
    
                                <div>
                                    <dt>Proveedores</dt>
                                    <dd>@PurchaseProviders</dd>
                                </div>
                            </dl>
                        </section>

        <section
                            class="cost-block maintenance cost-kpi-card-v134 cost-kpi-card-v135"
                            aria-labelledby="consult-maintenance-cost-title-v134">
    
                            <div class="cost-kpi-heading-v134">
                                <span class="cost-kpi-icon-v134" aria-hidden="true">
                                    <NaviKpiIcon Name="wrench" />
                                </span>
    
                                <div>
                                    <small>Mantenimiento</small>
    
                                    <strong id="consult-maintenance-cost-title-v134">
                                        @FormatMoney(MaintenanceCost)
                                    </strong>
                                </div>
                            </div>
    
                            <div
                                class="consult-cost-chart-v134"
                                role="img"
                                aria-label="Participación del costo de mantenimiento">
    
                                <div class="consult-cost-chart-track-v134">
                                    <span
                                        class="consult-cost-chart-fill-v134 maintenance"
                                        style="@NaviChartWidth(
                                            MaintenanceCost,
                                            TotalEstimatedCost)">
                                    </span>
                                </div>
    
                                <small>
                                    Participación sobre el costo total
                                </small>
                            </div>
    
                            <dl class="cost-metrics-v134">
                                <div>
                                    <dt>Promedio</dt>
                                    <dd>@FormatMoney(MaintenanceAverage)</dd>
                                </div>
    
                                <div>
                                    <dt>Mayor costo</dt>
                                    <dd>@FormatMoney(MaintenanceMax)</dd>
                                </div>
    
                                <div>
                                    <dt>Proveedores</dt>
                                    <dd>@MaintenanceProviders</dd>
                                </div>
                            </dl>
                        </section>
    </div>
</section>
@* NAVI CONSULT COST SUMMARY COMPACT V135.1 END *@

<section class="consult-layout consult-layout-v134 consult-layout-results-only-v135">
    
        <article class="assignment-history-v26-result-card consult-panel main consult-results-panel-v134">
    
            <div class="assignment-history-v26-result-header consult-title-row consult-title-row-v134">
                <div>
                    <span class="consult-eyebrow-v134">
                        SOLICITUDES REGISTRADAS
                    </span>
    
                    <h3>Compras y mantenimientos</h3>
    
                    <p>
                        Consulta cada flujo por separado sin mezclar los
                        registros ni perder la lectura de sus estados.
                    </p>
                </div>
    
                <span class="assignment-history-v26-result-count consult-result-count-v134">
                    @FilteredItems.Count() resultados
                </span>
            </div>
    
            @if (ShowPurchases)
            {
                <section
                    class="consult-request-group-v134 purchase"
                    aria-labelledby="consult-purchase-title-v134">
    
                    <div class="consult-section-title">
                        <div>
                            <strong id="consult-purchase-title-v134">
                                Compras
                            </strong>
    
                            <small>
                                Solicitudes de herramientas y activos fijos.
                            </small>
                        </div>
    
                        <span>@FilteredPurchases.Count()</span>
                    </div>
    
                    <div class="assignment-history-v26-table-wrap consult-table-wrap">
                        <div
                            class="ntx-table-scroll"
                            tabindex="0"
                            aria-label="Tabla de solicitudes de compra">
    
                            <table
                                class="assignment-history-v26-table consult-table"
                                aria-label="Solicitudes de compra">
    
                                <colgroup>
                                    <col class="ntx-col--14" />
                                    <col class="ntx-col--25" />
                                    <col class="ntx-col--7" />
                                    <col class="ntx-col--7" />
                                    <col class="ntx-col--8" />
                                    <col class="ntx-col--10" />
                                    <col class="ntx-col--9" />
                                    <col class="ntx-col--9" />
                                    <col class="ntx-col--11" />
                                </colgroup>
    
                                <thead>
                                    <tr>
                                        <th>Solicitud</th>
                                        <th>Necesidad / activo</th>
                                        <th>Tipo</th>
                                        <th>Prioridad</th>
                                        <th>Estado</th>
                                        <th>Costo / proveedor</th>
                                        <th>Fechas</th>
                                        <th>Responsable</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
    
                                <tbody>
                                    @if (!FilteredPurchases.Any())
                                    {
                                        <tr>
                                            <td colspan="9">
                                                <div class="consult-empty">
                                                    No hay solicitudes de compra
                                                    para los filtros seleccionados.
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in FilteredPurchases)
                                        {
                                            @RenderConsultRow(item)
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            }
    
            @if (ShowMaintenances)
            {
                <section
                    class="consult-request-group-v134 maintenance"
                    aria-labelledby="consult-maintenance-title-v134">
    
                    <div class="consult-section-title maintenance">
                        <div>
                            <strong id="consult-maintenance-title-v134">
                                Mantenimiento
                            </strong>
    
                            <small>
                                Solicitudes preventivas y correctivas.
                            </small>
                        </div>
    
                        <span>@FilteredMaintenances.Count()</span>
                    </div>
    
                    <div class="assignment-history-v26-table-wrap consult-table-wrap">
                        <div
                            class="ntx-table-scroll"
                            tabindex="0"
                            aria-label="Tabla de solicitudes de mantenimiento">
    
                            <table
                                class="assignment-history-v26-table consult-table"
                                aria-label="Solicitudes de mantenimiento">
    
                                <colgroup>
                                    <col class="ntx-col--14" />
                                    <col class="ntx-col--25" />
                                    <col class="ntx-col--7" />
                                    <col class="ntx-col--7" />
                                    <col class="ntx-col--8" />
                                    <col class="ntx-col--10" />
                                    <col class="ntx-col--9" />
                                    <col class="ntx-col--9" />
                                    <col class="ntx-col--11" />
                                </colgroup>
    
                                <thead>
                                    <tr>
                                        <th>Solicitud</th>
                                        <th>Necesidad / activo</th>
                                        <th>Tipo</th>
                                        <th>Prioridad</th>
                                        <th>Estado</th>
                                        <th>Costo / proveedor</th>
                                        <th>Fechas</th>
                                        <th>Responsable</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
    
                                <tbody>
                                    @if (!FilteredMaintenances.Any())
                                    {
                                        <tr>
                                            <td colspan="9">
                                                <div class="consult-empty">
                                                    No hay solicitudes de
                                                    mantenimiento para los
                                                    filtros seleccionados.
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in FilteredMaintenances)
                                        {
                                            @RenderConsultRow(item)
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            }
        </article>
    
        
    </section>
    
        </section>

    @* NAVI CONSULTA COMPRAS MTTO VISUAL V134 END *@

    @* NAVI CONSULT DETAIL MODAL V138 START *@
    @if (selectedItem is not null)
    {
        var approvedImage =
            GetApprovedImage(selectedItem);

        var approvedImageName =
            GetApprovedImageName(selectedItem);

        var approvedItemName =
            GetApprovedItemName(selectedItem);

        var approvedProvider =
            GetApprovedProvider(selectedItem);

        var interventionDescription =
            GetInterventionDescription(
                selectedItem);

        var requestDetail =
            GetConsultRequestDetailV139(
                selectedItem);

        var requestedTools =
            GetConsultRequestedToolsV139(
                selectedItem);

        var approvedQuotations =
            GetConsultApprovedQuotationsV139(
                selectedItem);

        var approvedEvidenceAvailable =
            !string.IsNullOrWhiteSpace(
                approvedImage);

        <div
            class="consult-modal-backdrop"
            @onclick="CloseDetails">

            <div
                class="consult-modal consult-detail-modal-v138 consult-detail-modal-v139"
                role="dialog"
                aria-modal="true"
                aria-labelledby="consult-detail-title-v138"
                @onclick:stopPropagation="true">

                <header
                    class="consult-modal-header consult-detail-header-v138">

                    <div>
                        <span>
                            @(selectedItem.Kind
                                == RequestKind.Purchase
                                ? "Detalle de compra"
                                : "Detalle de mantenimiento")
                        </span>

                        <h3 id="consult-detail-title-v138">
                            @selectedItem.Number
                        </h3>

                        <p>
                            @Dash(approvedItemName)
                        </p>
                    </div>

                    <button
                        type="button"
                        class="consult-detail-close-v138"
                        @onclick="CloseDetails"
                        data-ntx-tone="ghost">

                        Cerrar
                    </button>
                </header>

                <div class="consult-detail-scroll-v138">
                    <section
                        class="consult-modal-grid consult-detail-summary-v138"
                        aria-label="Resumen de la solicitud">

                        <div>
                            <span>Estado</span>

                            <strong>
                                @StatusLabel(
                                    selectedItem.Status)
                            </strong>
                        </div>

                        <div>
                            <span>Prioridad</span>

                            <strong>
                                @selectedItem.Priority
                            </strong>
                        </div>

                        <div>
                            <span>Tipo</span>

                            <strong>
                                @selectedItem.Type
                            </strong>
                        </div>

                        <div>
                            <span>Costo</span>

                            <strong>
                                @FormatMoney(
                                    selectedItem.EstimatedCost)
                            </strong>
                        </div>

                        <div>
                            <span>
                                Proveedor aprobado
                            </span>

                            <strong>
                                @Dash(approvedProvider)
                            </strong>
                        </div>

                        <div>
                            <span>Sede</span>

                            <strong>
                                @Dash(selectedItem.Branch)
                            </strong>
                        </div>

                        <div>
                            <span>Solicitó</span>

                            <strong>
                                @Dash(
                                    selectedItem.RequestedBy)
                            </strong>
                        </div>

                        <div>
                            <span>Preparó</span>

                            <strong>
                                @Dash(
                                    selectedItem.PreparedBy)
                            </strong>
                        </div>

                        <div>
                            <span>Técnico</span>

                            <strong>
                                @Dash(
                                    selectedItem.Technician)
                            </strong>
                        </div>

                        <div>
                            <span>Creada</span>

                            <strong>
                                @FormatDate(
                                    selectedItem.CreatedAt)
                            </strong>
                        </div>

                        <div>
                            <span>Programada</span>

                            <strong>
                                @FormatDate(
                                    selectedItem.ScheduledAt)
                            </strong>
                        </div>

                        <div>
                            <span>Cerrada</span>

                            <strong>
                                @FormatDate(
                                    selectedItem.ClosedAt)
                            </strong>
                        </div>
                    </section>

                    <section class="consult-approved-layout-v138">
                        <article class="consult-approved-image-card-v138">
                            <header>
                                <div>
                                    <span class="consult-detail-eyebrow-v138">
                                        Evidencia aprobada
                                    </span>

                                    <h4>
                                        Foto de la opción seleccionada
                                    </h4>
                                </div>

                                <span class="consult-detail-status-v138">
                                    @(approvedEvidenceAvailable
                                        ? "Disponible"
                                        : "Sin imagen")
                                </span>
                            </header>

                            @if (approvedEvidenceAvailable)
                            {
                                <figure class="consult-approved-figure-v138">
                                    <img
                                        src="@approvedImage"
                                        alt="@(
                                            $"Evidencia aprobada de {Dash(approvedItemName)}")" />

                                    @if (
                                        !string.IsNullOrWhiteSpace(
                                            approvedImageName))
                                    {
                                        <figcaption>
                                            @approvedImageName
                                        </figcaption>
                                    }
                                </figure>
                            }
                            else
                            {
                                <div
                                    class="consult-approved-empty-v138"
                                    role="note">

                                    <span aria-hidden="true">
                                        ▧
                                    </span>

                                    <strong>
                                        No hay una imagen persistida
                                    </strong>

                                    <p>
                                        La fotografía de la cotización
                                        seleccionada aparecerá aquí cuando la
                                        evidencia esté disponible dentro de la
                                        información de la solicitud.
                                    </p>
                                </div>
                            }
                        </article>

                        <article class="consult-approved-detail-card-v138">
                            <div class="consult-approved-title-v138">
                                <span class="consult-detail-eyebrow-v138">
                                    Opción aprobada
                                </span>

                                <h4>
                                    @Dash(approvedItemName)
                                </h4>
                            </div>

                            <dl class="consult-approved-facts-v138">
                                <div>
                                    <dt>Proveedor</dt>

                                    <dd>
                                        @Dash(approvedProvider)
                                    </dd>
                                </div>

                                <div>
                                    <dt>Valor aprobado</dt>

                                    <dd>
                                        @FormatMoney(
                                            selectedItem.EstimatedCost)
                                    </dd>
                                </div>
                            </dl>

                            <div class="consult-detail-copy-v138">
                                <span>
                                    @(selectedItem.Kind
                                        == RequestKind.Maintenance
                                        ? "Descripción de la intervención"
                                        : "Descripción de la opción aprobada")
                                </span>

                                <p>
                                    @Dash(
                                        interventionDescription)
                                </p>
                            </div>

                            <section
                                class="consult-approved-section-v139"
                                aria-labelledby="consult-request-detail-title-v139">

                                <div class="consult-approved-section-title-v139">
                                    <span class="consult-detail-eyebrow-v138">
                                        Solicitud
                                    </span>

                                    <h5 id="consult-request-detail-title-v139">
                                        Detalles de la solicitud
                                    </h5>
                                </div>

                                <dl class="consult-request-facts-v139">
                                    <div>
                                        <dt>Nombre</dt>

                                        <dd>
                                            @Dash(
                                                requestDetail.RequestName)
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>
                                            Responsable que aprueba
                                        </dt>

