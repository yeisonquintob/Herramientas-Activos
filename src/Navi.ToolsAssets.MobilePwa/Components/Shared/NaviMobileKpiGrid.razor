@using Microsoft.AspNetCore.Components

<section @attributes="AdditionalAttributes"
         class="@CssClass"
         data-ntx-component="mobile-kpi-grid"
         data-kpi-dividers="@DividersText">
    @ChildContent
</section>

@code {
    [Parameter]
    public int? Columns { get; set; }

    [Parameter]
    public bool Compact { get; set; } = true;

    [Parameter]
    public bool Dividers { get; set; } = true;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>?
        AdditionalAttributes { get; set; }

    private string DividersText =>
        Dividers
            ? "true"
            : "false";

    private string CssClass
    {
        get
        {
            var classes = "navi-mobile-kpi-grid";

            if (Compact)
            {
                classes += " is-compact";
            }

            if (Dividers)
            {
                classes += " has-dividers";
            }

            if (Columns is >= 1 and <= 6)
            {
                classes += $" columns-{Columns}";
            }

            if (!string.IsNullOrWhiteSpace(Class))
            {
                classes += $" {Class.Trim()}";
            }

            return classes;
        }
    }
}
