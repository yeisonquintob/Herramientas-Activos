@page "/mobile/physical-counts"

@using System.Net.Http
@using Microsoft.AspNetCore.Components.Forms
@using Navi.ToolsAssets.MobilePwa.Models
@using System.Collections.Generic

@inject NaviMobileApiClient Api
@inject MobileAuthSessionService Auth
@inject NavigationManager Navigation

<PageTitle>Toma física móvil - NAVI Herramientas y AF</PageTitle>

<section class="mobile-page navi-mobile-physical-v3 mobile-physical-standard-page navi-mobile-physical-counts-v6 navi-mobile-physical-counts-kpi-inicio-v7 navi-mobile-physical-counts-kpis-standard-v8">
    @if (isLoading && !initialized)
    {
        <div class="mobile-loading" role="status" aria-busy="true">Cargando toma física...</div>
    }
    else if (!Auth.IsAuthenticated)
    {
        <div class="mobile-empty">
            <strong>Sesión requerida</strong>
            <span>Debes iniciar sesión para consultar toma física.</span>
            <button class="mobile-primary-button" type="button" @onclick="GoLogin" data-ntx-tone="ghost" >Ir al login</button>
        </div>
    }
    else if (!CanAccessPhysicalCounts)
    {
        <div class="mobile-empty">
            <strong>Sin permiso</strong>
            <span>No tienes permisos para consultar toma física.</span>
            <button class="mobile-primary-button" type="button" @onclick="GoHome" data-ntx-tone="secondary" >Volver al inicio</button>
        </div>
    }
    else
    {

        <NaviMobileAppBanner Class="navi-mobile-physical-counts-start-banner navi-mobile-app-banner--home-only"
                             Pill="CONTROL ∙ TOMA FÍSICA"
                             Title="Toma física"
                             Description="@($"{Display(Auth.CurrentUser?.DisplayName)} ∙ {ScopeLabel}")"
                             HomeUrl="/"
                             ShowHomeButton="true"
                             ShowBackButton="false" />

        <NaviMobileKpiOverflow PrimaryCount="3" OverflowCount="3" ButtonLabel="Mostrar indicadores adicionales">
            <PrimaryContent>
        <NaviMobileKpiGrid Class="navi-mobile-physical-kpi-board-v2 navi-mobile-physical-kpi-board-v2--counts">
            <NaviMobileKpiCard Class="navi-mobile-physical-kpi-tile-v2 total">
                <span>Total</span>
                <strong>@FilteredCounts.Count()</strong>
                <small>Tomas visibles</small>
            </NaviMobileKpiCard>

            <NaviMobileKpiCard Class="navi-mobile-physical-kpi-tile-v2 info">
                <span>En proceso</span>
                <strong>@FilteredCounts.Count(x => Same(x.Status, "InProgress"))</strong>
                <small>Activas</small>
            </NaviMobileKpiCard>

            <NaviMobileKpiCard Class="navi-mobile-physical-kpi-tile-v2 success">
                <span>Cerradas</span>
                <strong>@FilteredCounts.Count(x => Same(x.Status, "Completed") || Same(x.Status, "Reconciled"))</strong>
                <small>Finalizadas</small>
            </NaviMobileKpiCard>
        </NaviMobileKpiGrid>
            </PrimaryContent>
            <OverflowContent>
        <NaviMobileKpiGrid Class="navi-mobile-physical-kpi-board-v2 navi-mobile-physical-kpi-board-v2--counts">

            <NaviMobileKpiCard Class="navi-mobile-physical-kpi-tile-v2 warning">
                <span>Reportadas</span>
                <strong>@FilteredCounts.Sum(GetManagedAssignedItems)</strong>
                <small>Gestionadas</small>
            </NaviMobileKpiCard>

            <NaviMobileKpiCard Class="navi-mobile-physical-kpi-tile-v2 danger">
                <span>Pendientes</span>
                <strong>@FilteredCounts.Sum(GetPendingAssignedItems)</strong>
                <small>Sin reportar</small>
            </NaviMobileKpiCard>

            <NaviMobileKpiCard Class="navi-mobile-physical-kpi-tile-v2 primary">
                <span>Avance</span>
                <strong>@OverallProgressText</strong>
                <small>@OverallProgressManagedItems de @OverallProgressExpectedItems</small>
            </NaviMobileKpiCard>
        </NaviMobileKpiGrid>
            </OverflowContent>
        </NaviMobileKpiOverflow>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="mobile-alert error">@errorMessage</div>
        }

        <section class="mph-filter-card mobile-physical-filter mobile-physical-filter-v4">
            <label>
                <span>Estado</span>
                <select @bind="selectedStatus" name="navi-mobilephysicalcounts-field-001">
                    <option value="">Todos los estados</option>
                    <option value="Draft">Borrador</option>
                    <option value="InProgress">En proceso</option>
                    <option value="Completed">Completada</option>
                    <option value="Reconciled">Conciliada</option>
                    <option value="Cancelled">Cancelada</option>
                </select>
            </label>

            <label>
                <span>Toma</span>
                @if (UserCanSeeAllBranches)
                {
                    <select @bind="selectedCountId" name="navi-mobilephysicalcounts-field-002">
                        <option value="">Todas las tomas</option>
                        @foreach (var count in CountFilterOptions)
                        {
                            <option value="@count.Id.ToString()">@Display(count.CountNumber) · @Display(count.BranchCode) · @StatusLabel(count.Status, count.StatusLabel)</option>
                        }
                    </select>
                }
                else
                {
                    <input value="@LatestActiveCountLabel" disabled name="navi-mobilephysicalcounts-field-003" />
                }
            </label>

            <label>
                <span>Sede</span>
                @if (UserCanSeeAllBranches)
                {
                    <select @bind="selectedBranchCode" name="navi-mobilephysicalcounts-field-004">
                        <option value="">Todas las sedes</option>
                        @foreach (var branch in VisibleBranches)
                        {
                            <option value="@branch.Code">@branch.Code - @branch.Name</option>
                        }
                    </select>
                }
                else
                {
                    <input value="@ScopeLabel" disabled name="navi-mobilephysicalcounts-field-005" />
                }
            </label>

            <label>
                <span>Desde</span>
                <InputDate TValue="DateTime?" @bind-Value="fromDate" name="navi-mobilephysicalcounts-field-006" />
            </label>

            <label>
                <span>Hasta</span>
                <InputDate TValue="DateTime?" @bind-Value="toDate" name="navi-mobilephysicalcounts-field-007" />
            </label>

            <label class="mph-full">
                <span>Buscar</span>
                <input @bind="searchText"
                       @bind:event="oninput"
                       placeholder="Toma, sede, responsable, observación..." name="navi-mobilephysicalcounts-field-008" />
            </label>

            <div class="mph-filter-actions">
                <button type="button" @onclick="ClearFilters" data-ntx-tone="secondary" >Limpiar</button>
            </div>
        </section>

        <article class="mph-card mph-campaigns-card mobile-physical-card">
            <section class="mph-static-head">
                <div>
                    <strong>Tomas físicas creadas</strong>
                    <span>Solo consulta. Ingresa al detalle para reportar o cargar evidencias según permisos.</span>
                </div>

                <em>@FilteredCounts.Count()</em>
            </section>

            @if (isLoading)
            {
                <div class="mobile-empty compact" role="status" aria-busy="true">Cargando tomas físicas...</div>
            }
            else if (!FilteredCounts.Any())
            {
                <div class="mobile-empty compact">No hay tomas físicas para los filtros seleccionados.</div>
            }
            else
            {
                <div class="mph-list mph-count-list mobile-physical-list">
                    @foreach (var item in FilteredCounts)
                    {
                        <article class="@GetCountRowClass(item.Status) mobile-physical-list-card">
                            <div class="mph-item-head">
                                <div>
                                    <strong>@Display(item.CountNumber)</strong>
                                    <span>@Display(item.BranchCode) · @Display(item.BranchName)</span>
                                </div>

                                <span class="@GetCountBadgeClass(item.Status)">
                                    @StatusLabel(item.Status, item.StatusLabel)
                                </span>
                            </div>

                            <section class="mph-mini-grid mph-count-grid">
                                <div><span>Responsable</span><strong>@Display(item.ResponsibleBy)</strong></div>
                                <div><span>Inicio</span><strong>@FormatDateTime(item.StartedAt)</strong></div>
                                <div><span>Cierre</span><strong>@FormatDateTime(item.FinishedAt)</strong></div>
                                <div><span>Total</span><strong>@GetExpectedAssignedItems(item)</strong><small>Asignadas</small></div>
                                <div><span>Reportadas</span><strong>@GetManagedAssignedItems(item)</strong><small>Gestionadas</small></div>
                                <div><span>Pendientes</span><strong>@GetPendingAssignedItems(item)</strong><small>Sin reportar</small></div>
                            </section>

                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                <p class="mph-notes">@item.Notes</p>
                            }

                            <div class="mph-actions one">
                                <button type="button" class="view" @onclick="() => GoDetail(item.Id)" data-ntx-tone="consult" >
                                    Detalle
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
        </article>
    }
</section>

@code {
    private bool initialized;
    private bool isLoading;
    private bool branchFilterInitialized;

    private string selectedStatus = string.Empty;
    private string selectedCountId = string.Empty;
    private string selectedBranchCode = string.Empty;
    private string searchText = string.Empty;
    private DateTime? fromDate;
    private DateTime? toDate;
    private string? errorMessage;

    private List<PhysicalCountItem> counts = new();
    private List<MobileBranchDto> branches = new();
    private Dictionary<Guid, PhysicalCountParticipantDto> participantSummaries = new();

    private bool IsAdmin =>
        Same(Auth.CurrentUser?.RoleCode, "ADMIN") ||
        Same(Auth.CurrentUser?.RoleCode, "SUPERADMIN") ||
        Same(Auth.CurrentUser?.RoleName, "Administrador") ||
        Same(Auth.CurrentUser?.RoleName, "Administrador NAVI");

    private bool CanConsultPhysicalCounts =>
        IsAdmin ||
        Has("PhysicalCounts.View");

    private bool CanReportPhysicalCounts =>
        IsAdmin ||
        Has("PhysicalCounts.Report");

    private bool CanUploadPhysicalEvidence =>
        IsAdmin ||
        Has("PhysicalCounts.Evidence.Upload");

    private bool CanAccessPhysicalCounts =>
        CanConsultPhysicalCounts;

    private bool UserCanSeeAllBranches =>
        IsAdmin ||
        IsAllBranchValue(Auth.CurrentUser?.BranchCode) ||
        Same(Auth.CurrentUser?.BranchName, "Todas las sedes");

    private IEnumerable<MobileBranchDto> VisibleBranches =>
        branches
            .Where(x => x.IsActive)
            .Where(x => UserCanSeeAllBranches || Same(x.Code, Auth.CurrentUser?.BranchCode) || x.Id == Auth.CurrentUser?.BranchId)
            .OrderBy(x => x.Code);

    private IEnumerable<PhysicalCountItem> BaseVisibleCounts
    {
        get
        {
            var scoped = counts.Where(MatchesBranchFilter);

            if (UserCanSeeAllBranches)
            {
                return scoped;
            }

            var latestActive = scoped
                .Where(IsActiveCount)
                .OrderByDescending(GetCountSortDate)
                .Take(1)
                .ToList();

            if (latestActive.Any())
            {
                return latestActive;
            }

            return scoped
                .OrderByDescending(GetCountSortDate)
                .Take(1)
                .ToList();
        }
    }

    private IEnumerable<PhysicalCountItem> CountFilterOptions =>
        BaseVisibleCounts.OrderByDescending(GetCountSortDate);

    private string LatestActiveCountLabel =>
        CountFilterOptions.FirstOrDefault() is { } count
            ? $"{Display(count.CountNumber)} · {StatusLabel(count.Status, count.StatusLabel)}"
            : "Sin toma vigente";

    private IEnumerable<PhysicalCountItem> FilteredCounts =>
        BaseVisibleCounts
            .Where(MatchesSelectedCountFilter)
            .Where(x => string.IsNullOrWhiteSpace(selectedStatus) || Same(x.Status, selectedStatus))
            .Where(MatchesDateFilter)
            .Where(MatchesSearch)
            .OrderByDescending(GetCountSortDate);
    private IEnumerable<PhysicalCountItem> ProgressCounts
    {
        get
        {
            var source = FilteredCounts?.ToList() ?? new();

            if (!string.IsNullOrWhiteSpace(selectedCountId))
            {
                var selected = source
                    .Where(PhysicalCountMatchesSelected)
                    .ToList();

                return selected.Any()
                    ? selected
                    : source.Take(1);
            }

            if (source.Count == 1)
            {
                return source;
            }

            if (!UserCanSeeAllBranches && source.Count > 0)
            {
                return source.Take(1);
            }

            return Enumerable.Empty<PhysicalCountItem>();
        }
    }

    private int OverallProgressExpectedItems =>
        ProgressCounts.Sum(GetExpectedAssignedItems);

    private int OverallProgressManagedItems =>
        ProgressCounts.Sum(GetManagedAssignedItems);

    private decimal OverallProgressPercent =>
        OverallProgressExpectedItems <= 0
            ? 0m
            : Math.Round((decimal)OverallProgressManagedItems * 100m / OverallProgressExpectedItems, 2);

    private string OverallProgressText
    {
        get
        {
            var format = OverallProgressPercent % 1 == 0 ? "0" : "0.##";
            return $"{OverallProgressPercent.ToString(format, System.Globalization.CultureInfo.CurrentCulture)}%";
        }
    }

    private int OverallProgress =>
        (int)Math.Round(OverallProgressPercent, 0);

    private bool PhysicalCountMatchesSelected(PhysicalCountItem count)
    {
        if (string.IsNullOrWhiteSpace(selectedCountId))
        {
            return true;
        }

        var selected = NormalizeCountFilterValue(selectedCountId);

        foreach (var propertyName in new[] { "Id", "PhysicalCountId", "CountId", "Number", "Code", "CountNumber", "Name", "Title" })
        {
            var value = NormalizeCountFilterValue(GetPhysicalCountStringValue(count, propertyName));

            if (string.IsNullOrWhiteSpace(value))
            {
                continue;
            }

            if (string.Equals(value, selected, StringComparison.OrdinalIgnoreCase) ||
                selected.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                value.Contains(selected, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    private static int GetExpectedAssignedItems(PhysicalCountItem count)
    {
        var expected = GetPhysicalCountIntValue(
            count,
            "ExpectedItems",
            "AssignedItems",
            "TotalAssignedItems",
            "TotalItems",
            "ToolsCount",
            "AssetsCount",
            "Total");

        return Math.Max(0, expected);
    }

    private static int GetManagedAssignedItems(PhysicalCountItem count)
    {
        var expected = GetExpectedAssignedItems(count);

        var directManaged = Math.Max(
            GetPhysicalCountIntValue(
                count,
                "ValidatedItems",
                "ManagedItems",
                "CountedItems",
                "ReportedItems",
                "CompletedItems",
                "ConfirmedItems",
                "ClosedItems",
                "DoneItems"),
            0);

        var pending = GetPhysicalCountIntValue(
            count,
            "PendingItems",
            "PendingCount",
            "OpenItems",
            "RemainingItems");

        var byPending = expected > 0 && pending >= 0
            ? Math.Max(0, expected - pending)
            : 0;

        var managed = Math.Max(directManaged, byPending);

        return expected > 0
            ? Math.Min(expected, managed)
            : managed;
    }

    private static int GetPhysicalCountIntValue(PhysicalCountItem count, params string[] propertyNames)
    {
        foreach (var propertyName in propertyNames)
        {
            var value = GetPhysicalCountObjectValue(count, propertyName);

            if (value is null)
            {
                continue;
            }

            try
            {
                if (value is int intValue)
                {
                    return intValue;
                }

                if (value is long longValue)
                {
                    return (int)longValue;
                }

                if (value is decimal decimalValue)
                {
                    return (int)decimalValue;
                }

                if (value is double doubleValue)
                {
                    return (int)doubleValue;
                }

                if (int.TryParse(value.ToString(), out var parsed))
                {
                    return parsed;
                }
            }
            catch
            {
                // Se ignora y se continúa con el siguiente nombre posible.
            }
        }

        return 0;
    }

    private static string? GetPhysicalCountStringValue(PhysicalCountItem count, string propertyName)
    {
        var value = GetPhysicalCountObjectValue(count, propertyName);
        return value?.ToString();
    }

    private static object? GetPhysicalCountObjectValue(PhysicalCountItem count, string propertyName)
    {
        var property = count
            .GetType()
            .GetProperty(
                propertyName,
                System.Reflection.BindingFlags.Public |
                System.Reflection.BindingFlags.Instance |
                System.Reflection.BindingFlags.IgnoreCase);

        return property?.GetValue(count);
    }

    private static string NormalizeCountFilterValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? string.Empty
            : value.Trim();
    }

    private string ScopeLabel =>
        UserCanSeeAllBranches && string.IsNullOrWhiteSpace(selectedBranchCode)
            ? "Todas las sedes"
            : Display(selectedBranchCode);

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();

        if (!Auth.IsAuthenticated)
        {
            initialized = true;
            return;
        }

        var refreshedUser = await Api.RefreshCurrentSessionAsync();

        if (refreshedUser is null || !Auth.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        await LoadBranchesAsync();
        ApplyDefaultBranchFilterIfNeeded();
        await LoadAsync();

        initialized = true;
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            await LoadBranchesAsync();
            ApplyDefaultBranchFilterIfNeeded();
            counts = await Api.GetListJsonAsync<PhysicalCountItem>("api/physical-counts");
            await LoadParticipantSummariesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudieron cargar las tomas físicas: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadParticipantSummariesAsync()
    {
        participantSummaries = new();

        var visibleCounts = counts
            .Where(MatchesBranchFilter)
            .OrderByDescending(GetCountSortDate)
            .Take(UserCanSeeAllBranches ? 80 : 10)
            .ToList();

        foreach (var count in visibleCounts)
        {
            try
            {
                var board = await Api.GetJsonAsync<PhysicalCountBoardDto>($"api/physical-counts/{count.Id}/participants-board");
                var participant = board?.Participants.FirstOrDefault(IsOwnParticipant);

                if (participant is not null)
                {
                    participantSummaries[count.Id] = participant;
                }
            }
            catch
            {
                // Si una toma no puede cargar participante, no se rompe la pantalla.
                // El cálculo usará fallback seguro.
            }
        }
    }

    private bool TryGetOwnParticipant(PhysicalCountItem item, out PhysicalCountParticipantDto participant)
    {
        return participantSummaries.TryGetValue(item.Id, out participant!);
    }

    private int GetPendingAssignedItems(PhysicalCountItem item)
    {
        var expected = GetExpectedAssignedItems(item);
        var managed = GetManagedAssignedItems(item);

        return Math.Max(0, expected - managed);
    }

    private static int ManagedParticipantItems(PhysicalCountParticipantDto? participant)
    {
        if (participant is null)
        {
            return 0;
        }

        var expected = Math.Max(0, participant.ExpectedItems);

        // CountedItems debe representar herramientas asignadas ya gestionadas.
        // No suma ExtraItems, porque los no listados no afectan el avance.
        var counted = Math.Max(0, participant.CountedItems);

        if (counted > 0)
        {
            return expected > 0
                ? Math.Min(expected, counted)
                : counted;
        }

        var byPending = expected > 0 && participant.PendingItems >= 0
            ? Math.Max(0, expected - participant.PendingItems)
            : 0;

        var byCounters =
            Math.Max(0, participant.FoundItems) +
            Math.Max(0, participant.MissingItems) +
            Math.Max(0, participant.DifferentItems) +
            Math.Max(0, participant.DamagedItems);

        var managed = Math.Max(byPending, byCounters);

        return expected > 0
            ? Math.Min(expected, managed)
            : managed;
    }

    private bool IsOwnParticipant(PhysicalCountParticipantDto participant)
    {
        var userName = Auth.CurrentUser?.UserName;
        var displayName = Auth.CurrentUser?.DisplayName;
        var responsibleId = Auth.CurrentUser?.ResponsiblePersonId;

        return Same(participant.UserName, userName) ||
               Same(participant.DisplayName, displayName) ||
               Same(participant.DisplayName, Auth.CurrentUser?.ResponsiblePersonName) ||
               (responsibleId.HasValue && participant.ResponsiblePersonId.HasValue && responsibleId.Value == participant.ResponsiblePersonId.Value);
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            branches = await Api.GetBranchesAsync();
        }
        catch
        {
            branches = new();
        }
    }

    private void ApplyDefaultBranchFilterIfNeeded()
    {
        if (branchFilterInitialized)
        {
            return;
        }

        branchFilterInitialized = true;

        if (UserCanSeeAllBranches)
        {
            selectedBranchCode = string.Empty;
            return;
        }

        var userBranchCode = Auth.CurrentUser?.BranchCode;

        if (!string.IsNullOrWhiteSpace(userBranchCode) && !IsAllBranchValue(userBranchCode))
        {
            selectedBranchCode = userBranchCode;
            return;
        }

        if (Auth.CurrentUser?.BranchId is Guid branchId)
        {
            var branch = branches.FirstOrDefault(x => x.Id == branchId);

            if (branch is not null)
            {
                selectedBranchCode = branch.Code;
            }
        }
    }

    private bool MatchesBranchFilter(PhysicalCountItem item)
    {
        if (UserCanSeeAllBranches && string.IsNullOrWhiteSpace(selectedBranchCode))
        {
            return true;
        }

        if (string.IsNullOrWhiteSpace(selectedBranchCode))
        {
            return false;
        }

        return Same(item.BranchCode, selectedBranchCode) ||
               Contains(item.BranchCode, selectedBranchCode) ||
               Contains(item.BranchName, selectedBranchCode);
    }

    private bool MatchesSelectedCountFilter(PhysicalCountItem item)
    {
        if (string.IsNullOrWhiteSpace(selectedCountId))
        {
            return true;
        }

        return item.Id.ToString().Equals(selectedCountId, StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsActiveCount(PhysicalCountItem item)
    {
        return Same(item.Status, "InProgress") ||
               Same(item.Status, "Draft");
    }

    private static DateTime GetCountSortDate(PhysicalCountItem item)
    {
        return item.CreatedAt ??
               item.StartedAt ??
               item.FinishedAt ??
               DateTime.MinValue;
    }

    private bool MatchesDateFilter(PhysicalCountItem item)
    {
        var date = item.CreatedAt ?? item.StartedAt;

        if (!date.HasValue)
        {
            return !fromDate.HasValue && !toDate.HasValue;
        }

        if (fromDate.HasValue && date.Value.Date < fromDate.Value.Date)
        {
            return false;
        }

        if (toDate.HasValue && date.Value.Date > toDate.Value.Date)
        {
            return false;
        }

        return true;
    }

    private bool MatchesSearch(PhysicalCountItem item)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return true;
        }

        return Contains(item.CountNumber, searchText) ||
               Contains(item.BranchCode, searchText) ||
               Contains(item.BranchName, searchText) ||
               Contains(item.ResponsibleBy, searchText) ||
               Contains(item.Notes, searchText) ||
               Contains(item.StatusLabel, searchText);
    }
    private void ClearFilters()
    {
        selectedStatus = string.Empty;

        selectedCountId = string.Empty;

        searchText = string.Empty;
        fromDate = null;
        toDate = null;
        branchFilterInitialized = false;
        ApplyDefaultBranchFilterIfNeeded();
    }

    private bool Has(string permission) => Auth.HasPermission(permission);

    private void GoDetail(Guid id) => Navigation.NavigateTo($"/mobile/physical-counts/{id}");
    private void GoHome() => Navigation.NavigateTo("/");
    private void GoLogin() => Navigation.NavigateTo("/login", replace: true);

    private static string StatusLabel(string? status, string? label)
    {
        if (!string.IsNullOrWhiteSpace(label))
        {
            return label;
        }

        return status switch
        {
            "Draft" => "Borrador",
            "InProgress" => "En proceso",
            "Completed" => "Completada",
            "Reconciled" => "Conciliada",
            "Cancelled" => "Cancelada",
            _ => Display(status)
        };
    }

    private static string GetCountBadgeClass(string? status)
    {
        return status switch
        {
            "InProgress" => "mph-status progress",
            "Completed" or "Reconciled" => "mph-status completed",
            "Cancelled" => "mph-status cancelled",
            _ => "mph-status draft"
        };
    }

    private static string GetCountRowClass(string? status)
    {
        return status switch
        {
            "InProgress" => "mph-item mph-count-card progress",
            "Completed" or "Reconciled" => "mph-item mph-count-card completed",
            "Cancelled" => "mph-item mph-count-card cancelled",
            _ => "mph-item mph-count-card draft"
        };
    }

    private static bool Contains(string? source, string? value)
    {
        return !string.IsNullOrWhiteSpace(source) &&
               !string.IsNullOrWhiteSpace(value) &&
               Normalize(source).Contains(Normalize(value), StringComparison.OrdinalIgnoreCase);
    }

    private static bool Same(string? left, string? right)
    {
        return string.Equals(Normalize(left), Normalize(right), StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsAllBranchValue(string? value)
    {
        return Same(value, "TODAS") ||
               Same(value, "ALL") ||
               Same(value, "Todas las sedes");
    }

    private static string Normalize(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value.Trim()
            .ToUpperInvariant()
            .Replace("Á", "A")
            .Replace("É", "E")
            .Replace("Í", "I")
            .Replace("Ó", "O")
            .Replace("Ú", "U")
            .Replace("Ü", "U")
            .Replace("Ñ", "N");
    }

    private static string FormatDateTime(DateTime? value)
    {
        return value.HasValue
            ? value.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            : "—";
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "—" : value;
    }

