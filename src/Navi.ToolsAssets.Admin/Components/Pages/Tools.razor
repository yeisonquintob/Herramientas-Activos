    }

    private static bool IsBlocked(
        ToolListItem tool)
    {
        return tool.OperationalStatus is
            "Damaged"
            or "NotSuitable"
            or "InMaintenance"
            or "PendingDisposal"
            or "Disposed"
            or "NotLocated"
            or "Inconsistent";
