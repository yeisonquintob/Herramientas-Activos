@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Navi.ToolsAssets.Admin.Components.Shared
@using Navi.ToolsAssets.Admin.Services.Auth

@implements IAsyncDisposable

@inject IHttpClientFactory HttpClientFactory
@inject WebAuthSessionService AuthSession
@inject IJSRuntime JS

<section class="login-appearance-card"
         aria-labelledby="login-appearance-title">
    <header class="login-appearance-card__header">
        <div>
            <span>IMAGEN DE ACCESO</span>

            <h2 id="login-appearance-title">
                Fondo corporativo del login
            </h2>

            <p>
                Carga una imagen horizontal para el panel derecho
                de la pantalla de acceso del Admin Web.
            </p>
        </div>

        <span class="login-appearance-card__status">
            @(appearance.HasImage
                ? "Imagen configurada"
                : "Fondo predeterminado")
        </span>
    </header>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="@MessageClass"
             role="@MessageRole"
             aria-live="@MessageLive">
            @message
        </div>
    }

    <div class="login-appearance-card__layout">
        <article class="login-appearance-preview">
            @if (!string.IsNullOrWhiteSpace(PreviewUrl))
            {
                <img src="@PreviewUrl"
                     alt="Vista previa de la imagen corporativa del login"
                     draggable="false" />

                <div class="login-appearance-preview__overlay"
                     aria-hidden="true">
                    <strong>NAVI</strong>
                    <span>Herramientas y Activos</span>
                </div>
            }
            else
            {
                <div class="login-appearance-preview__empty">
                    <span aria-hidden="true">N</span>

                    <strong>
                        Fondo corporativo predeterminado
                    </strong>

                    <small>
                        El login conservará la superficie institucional
                        mientras no exista una imagen cargada.
                    </small>
                </div>
            }
        </article>

        <article class="login-appearance-controls">
            <div class="login-appearance-controls__information">
                <strong>Archivo permitido</strong>

                <span>
                    JPG, JPEG, PNG o WebP.
                </span>

                <span>
                    Tamaño máximo: 5 MB.
                </span>

                <span>
                    Resolución recomendada: 1920 × 1080.
                </span>
            </div>

            <div class="login-appearance-controls__field">
                <label for="@InputId">
                    Seleccionar imagen
                </label>

                <InputFile id="@InputId"
                           name="@InputId"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                           disabled="@(!CanManageSettings || isBusy)"
                           OnChange="HandleFileSelected" />

                @if (selectedImage is not null)
                {
                    <small>
                        Seleccionada:
                        <strong>@selectedImage.Name</strong>
                        · @FormatBytes(selectedImage.Size)
                    </small>
                }
                else if (appearance.HasImage)
                {
                    <small>
                        Actual:
                        <strong>
                            @appearance.FileName
                        </strong>
                    </small>
                }
                else
                {
                    <small>
                        No hay una imagen personalizada.
                    </small>
                }
            </div>

            <div class="login-appearance-controls__actions">
                <NaviActionButton
                    Tone="affirmative"
                    Disabled="@(
                        !CanManageSettings
                        || selectedImage is null
                        || isBusy
                    )"
                    OnClick="UploadImageAsync">
                    @(isUploading
                        ? "Guardando..."
                        : "Guardar imagen")
                </NaviActionButton>

                <NaviActionButton
                    Tone="danger"
                    Disabled="@(
                        !CanManageSettings
                        || !appearance.HasImage
                        || isBusy
                    )"
                    OnClick="DeleteImageAsync">
                    @(isDeleting
                        ? "Eliminando..."
                        : "Eliminar imagen")
                </NaviActionButton>

                <NaviActionButton
                    Tone="secondary"
                    Disabled="@(
                        selectedImage is null
                        || isBusy
                    )"
                    OnClick="ClearSelectionAsync">
                    Limpiar selección
                </NaviActionButton>
            </div>

            @if (!CanManageSettings)
            {
                <div class="login-appearance-controls__permission"
                     role="note">
                    Puedes consultar la imagen, pero necesitas
                    el permiso <strong>Settings.Manage</strong>
                    para modificarla.
                </div>
            }

            @if (appearance.UpdatedAtUtc.HasValue)
            {
                <footer class="login-appearance-controls__footer">
                    Última actualización:
                    @appearance.UpdatedAtUtc.Value
                        .ToLocalTime()
                        .ToString("dd/MM/yyyy HH:mm")
                </footer>
            }
        </article>
    </div>
</section>

@code {
    private const long MaxImageBytes =
        5L * 1024L * 1024L;

    private const string InputId =
        "naviAdminLoginAppearanceImage";

    private IBrowserFile? selectedImage;

    private LoginAppearanceDto appearance =
        new();

    private string? currentImageUrl;
    private string? selectedPreviewUrl;
    private string? message;

    private bool messageIsError;
    private bool isBusy;
    private bool isUploading;
    private bool isDeleting;

    private bool IsAdmin =>
        string.Equals(
            AuthSession.RoleCode,
            "ADMIN",
            StringComparison.OrdinalIgnoreCase)
        ||
        string.Equals(
            AuthSession.RoleCode,
            "SUPERADMIN",
            StringComparison.OrdinalIgnoreCase)
        ||
        string.Equals(
            AuthSession.RoleName,
            "Administrador",
            StringComparison.OrdinalIgnoreCase)
        ||
        string.Equals(
            AuthSession.RoleName,
            "Administrador NAVI",
            StringComparison.OrdinalIgnoreCase);

    private bool CanManageSettings =>
        IsAdmin
        ||
        AuthSession.HasPermission(
            "Settings.Manage");

    private string? PreviewUrl =>
        selectedPreviewUrl
        ??
        currentImageUrl;

    private string MessageClass =>
        messageIsError
            ? "login-appearance-message login-appearance-message--error"
            : "login-appearance-message login-appearance-message--success";

    private string MessageRole =>
        messageIsError
            ? "alert"
            : "status";

    private string MessageLive =>
        messageIsError
            ? "assertive"
            : "polite";

    protected override async Task OnInitializedAsync()
    {
        await LoadConfigurationAsync();
    }

    private async Task LoadConfigurationAsync()
    {
        try
        {
            isBusy = true;

            var api =
                HttpClientFactory.CreateClient(
                    "NaviApi");

            var configuration =
                await api.GetFromJsonAsync<
                    LoginAppearanceDto>(
                        "api/login-appearance");

            ApplyConfiguration(
                api,
                configuration ?? new());
        }
        catch
        {
            appearance =
                new LoginAppearanceDto();

            currentImageUrl = null;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task HandleFileSelected(
        InputFileChangeEventArgs args)
    {
        message = null;
        messageIsError = false;

        var file =
            args.File;

        var extension =
            Path.GetExtension(
                file.Name)
                .ToLowerInvariant();

        var validExtension =
            extension is
                ".jpg"
                or ".jpeg"
                or ".png"
                or ".webp";

        if (!validExtension)
        {
            selectedImage = null;

            await ClearPreviewObjectAsync();

            ShowError(
                "Solo se permiten imágenes JPG, PNG o WebP.");

            return;
        }

        if (file.Size > MaxImageBytes)
        {
            selectedImage = null;

            await ClearPreviewObjectAsync();

            ShowError(
                "La imagen no puede superar 5 MB.");

            return;
        }

        selectedImage = file;

        try
        {
            selectedPreviewUrl =
                await JS.InvokeAsync<string?>(
                    "naviLoginAppearance.createPreview",
                    InputId);
        }
        catch
        {
            selectedPreviewUrl = null;
        }
    }

    private async Task UploadImageAsync()
    {
        if (
            !CanManageSettings
            ||
            selectedImage is null
        )
        {
            return;
        }

        try
        {
            isBusy = true;
            isUploading = true;
            message = null;
            messageIsError = false;

            var api =
                HttpClientFactory.CreateClient(
                    "NaviApi");

            await using var stream =
                selectedImage.OpenReadStream(
                    MaxImageBytes);

            using var fileContent =
                new StreamContent(
                    stream);

            fileContent.Headers.ContentType =
                new MediaTypeHeaderValue(
                    GetContentType(
                        selectedImage.Name));

            using var form =
                new MultipartFormDataContent();

            form.Add(
                fileContent,
                "image",
                selectedImage.Name);

            using var response =
                await api.PostAsync(
                    "api/login-appearance/image",
                    form);

            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(
                    await ReadErrorAsync(
                        response));
            }

            var configuration =
                await response.Content
                    .ReadFromJsonAsync<
                        LoginAppearanceDto>()
                ??
                new LoginAppearanceDto();

            ApplyConfiguration(
                api,
                configuration);

            await ClearSelectionInternalAsync();

            ShowSuccess(
                "La imagen del login fue guardada correctamente.");
        }
        catch (Exception ex)
        {
            ShowError(
                "No fue posible guardar la imagen. "
                + ex.Message);
        }
        finally
        {
            isUploading = false;
            isBusy = false;
        }
    }

    private async Task DeleteImageAsync()
    {
        if (
            !CanManageSettings
            ||
            !appearance.HasImage
        )
        {
            return;
        }

        try
        {
            isBusy = true;
            isDeleting = true;
            message = null;
            messageIsError = false;

            var api =
                HttpClientFactory.CreateClient(
                    "NaviApi");

            using var response =
                await api.DeleteAsync(
                    "api/login-appearance/image");

            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(
                    await ReadErrorAsync(
                        response));
            }

            appearance =
                new LoginAppearanceDto();

            currentImageUrl = null;

            await ClearSelectionInternalAsync();

            ShowSuccess(
                "La imagen fue eliminada. "
                + "El login utilizará el fondo predeterminado.");
        }
        catch (Exception ex)
        {
            ShowError(
                "No fue posible eliminar la imagen. "
                + ex.Message);
        }
        finally
        {
            isDeleting = false;
            isBusy = false;
        }
    }

    private async Task ClearSelectionAsync()
    {
        if (isBusy)
        {
            return;
        }

        await ClearSelectionInternalAsync();

        message = null;
        messageIsError = false;
    }

    private async Task ClearSelectionInternalAsync()
    {
        selectedImage = null;

        await ClearPreviewObjectAsync();
    }

    private async Task ClearPreviewObjectAsync()
    {
        selectedPreviewUrl = null;

        try
        {
            await JS.InvokeVoidAsync(
                "naviLoginAppearance.clearPreview",
                InputId);
        }
        catch
        {
            // El control puede no estar renderizado todavía.
        }
    }

    private void ApplyConfiguration(
        HttpClient api,
        LoginAppearanceDto configuration)
    {
        appearance = configuration;

        currentImageUrl =
            BuildImageUrl(
                api,
                configuration);
    }

    private static string? BuildImageUrl(
        HttpClient api,
        LoginAppearanceDto configuration)
    {
        if (
            !configuration.HasImage
            ||
            string.IsNullOrWhiteSpace(
                configuration.ImageUrl)
            ||
            api.BaseAddress is null
        )
        {
            return null;
        }

        var relativeUrl =
            configuration.ImageUrl
                .TrimStart('/');

        var absoluteUri =
            new Uri(
                api.BaseAddress,
                relativeUrl);

        var version =
            string.IsNullOrWhiteSpace(
                configuration.Version)
                ? DateTime.UtcNow
                    .Ticks
                    .ToString()
                : configuration.Version;

        return absoluteUri
            + "?v="
            + Uri.EscapeDataString(
                version);
    }

    private static string GetContentType(
        string fileName)
    {
        return Path.GetExtension(
            fileName)
            .ToLowerInvariant()
            switch
            {
                ".png" =>
                    "image/png",

                ".webp" =>
                    "image/webp",

                _ =>
                    "image/jpeg"
            };
    }

    private static string FormatBytes(
        long bytes)
    {
        return bytes >= 1024L * 1024L
            ? $"{bytes / 1024d / 1024d:N2} MB"
            : $"{bytes / 1024d:N2} KB";
    }

    private static async Task<string> ReadErrorAsync(
        HttpResponseMessage response)
    {
        var body =
            await response.Content
                .ReadAsStringAsync();

        if (string.IsNullOrWhiteSpace(body))
        {
            return
                $"La API respondió "
                + $"{(int)response.StatusCode}.";
        }

        try
        {
            using var document =
                JsonDocument.Parse(
                    body);

            if (
                document.RootElement
                    .TryGetProperty(
                        "message",
                        out var messageElement)
            )
            {
                return messageElement
                    .GetString()
                    ??
                    body;
            }
        }
        catch
        {
            // Se devuelve el contenido original.
        }

        return body;
    }

    private void ShowSuccess(
        string value)
    {
        messageIsError = false;
        message = value;
    }

    private void ShowError(
        string value)
    {
        messageIsError = true;
        message = value;
    }

    public async ValueTask DisposeAsync()
    {
        await ClearPreviewObjectAsync();
    }

    private sealed class LoginAppearanceDto
    {
        public bool HasImage { get; set; }

        public string? ImageUrl { get; set; }

        public string? FileName { get; set; }

        public string? ContentType { get; set; }

        public DateTime? UpdatedAtUtc { get; set; }

        public string? Version { get; set; }
    }
}
