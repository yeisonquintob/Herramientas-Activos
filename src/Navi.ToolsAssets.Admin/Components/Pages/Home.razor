    }

    private int GetBranchAssignedPercent(BranchItem item)
    {
        if (item.Total <= 0)
        {
            return 0;
        }

        return Math.Min(100, Math.Max(0, (int)Math.Round((decimal)GetBranchAssigned(item) / item.Total * 100)));
    }

    private int GetBranchPending(BranchItem item)
    {
        return Math.Max(0, item.PendingValidation);
    }

    private int GetBranchDifferences(BranchItem item)
    {
        return Math.Max(0, item.NotLocated);
    }

    private int GetBranchMaintenance(BranchItem item)
    {
        return Math.Max(0, item.InMaintenance);
    }

    private int GetBranchDamaged(BranchItem item)
    {
        return Math.Max(0, item.Damaged);
    }

    private int GetBranchDisposed(BranchItem item)
    {
        return Math.Max(0, item.Disposed);
    }

    private int GetBranchValidated(BranchItem item)
    {
        var notValidated =
            GetBranchPending(item) +
            GetBranchDifferences(item) +
            GetBranchMaintenance(item) +
            GetBranchDamaged(item) +
            GetBranchDisposed(item);

        return Math.Max(0, item.Total - notValidated);
    }

    private int GetBranchAdvance(BranchItem item)
    {
        if (item.Total <= 0)
        {
            return 0;
        }

        var valid = GetBranchValidated(item);

        return Math.Min(100, Math.Max(0, (int)Math.Round((decimal)valid / item.Total * 100)));
    }

    private int GetMaxBranch()
    {
        if (dashboard is null || dashboard.ToolsByBranch.Count == 0)
        {
            return 1;
        }

        return Math.Max(1, dashboard.ToolsByBranch.Max(x => x.Total));
    }


    private int GetBranchChartMax()
    {
        var max = GetMaxBranch();

        if (max <= 30)
        {
            return 30;
        }

        if (max <= 60)
        {
            return 60;
        }

        if (max <= 100)
        {
            return 100;
        }

        var step = max <= 250 ? 50 : 100;

        return (int)(Math.Ceiling(max / (decimal)step) * step);
    }

    private IEnumerable<int> GetBranchAxisLabels()
    {
        var max = GetBranchChartMax();
        var step = Math.Max(1, max / 4);

        return Enumerable.Range(0, 5).Select(index => max - (step * index));
    }

