    private async Task SaveDraftAsync()
    {
        var saved = await SaveOrUpdateStoredRequestAsync(
            LocalStatusDraft);

        if (!saved)
        {
            return;
        }

        successMessage =
            "Borrador guardado. "
            + "La solicitud quedó registrada abajo "
            + "para editar o confirmar.";

        ClearWorkspace();
    }


    private async Task ConfirmRequestAsync()
    {
        if (!CanCreateOrConfirmRequest)
        {
            return;
        }

        var saved = await SaveOrUpdateStoredRequestAsync(
            LocalStatusConfirmed);

        if (!saved)
        {
            return;
        }

        successMessage =
            "Solicitud confirmada. "
            + "Quedó registrada abajo "
            + "como pendiente por cotizar.";

        ClearWorkspace();
    }

    private async Task<bool> SaveOrUpdateStoredRequestAsync(string status)
    {
        if (!SelectedLines.Any())
        {
            errorMessage = "Debes agregar y seleccionar al menos una herramienta.";
            return false;
        }

        var now = DateTime.Now;
        var id = activeStoredRequestId ?? Guid.NewGuid();

        var item = storedRequests.FirstOrDefault(x => x.Id == id);

        if (item is null)
        {
            item = new StoredRequest
            {
                Id = id,
                CreatedAt = now,
                LocalNumber = BuildLocalNumber(status, now)
            };

            storedRequests.Add(item);
        }

        item.Status = status;
        item.Header = header.Clone();
        item.Lines = currentLines.Select(x => x.Clone()).ToList();
        item.Quotations = currentQuotes.Select(x => x.Clone()).ToList();
        item.UpdatedAt = now;

        await SaveLocalStateAsync();

        return true;
}

    private void LoadDraftForEdit(Guid id)
    {
        var item = storedRequests.FirstOrDefault(x => x.Id == id && x.Status == LocalStatusDraft);

        if (item is null)
        {
            return;
        }

        LoadStoredRequestToWorkspace(item);
        currentStatus = LocalStatusDraft;
        successMessage = "Borrador cargado para edición.";
    }

    private async Task ConfirmStoredRequestAsync(Guid id)
    {
        var item = storedRequests.FirstOrDefault(x => x.Id == id && x.Status == LocalStatusDraft);

        if (item is null)
        {
            return;
        }

        item.Status = LocalStatusConfirmed;
        item.UpdatedAt = DateTime.Now;
        await SaveLocalStateAsync();

        if (activeStoredRequestId == id)
        {
            ClearWorkspace();
        }

        successMessage = "Borrador confirmado. Ahora puedes realizar cotización.";
    }

    private async Task LoadQuotationRouteAsync()
    {
        errorMessage = null;
        successMessage = null;

        if (!QuotationRequestId.HasValue)
        {
            errorMessage =
                "No se indicó la solicitud que se va a cotizar.";

            return;
        }

        if (!CanRegisterQuotation)
        {
            errorMessage =
                "No tienes permiso para registrar cotizaciones.";

            return;
        }

        var item = storedRequests.FirstOrDefault(
            request =>
                request.Id == QuotationRequestId.Value);

        if (item is null)
        {
            errorMessage =
                "La solicitud seleccionada no fue encontrada.";

            return;
        }

        if (item.Status == LocalStatusConfirmed)
        {
            item.Status = LocalStatusQuoting;
            item.UpdatedAt = DateTime.Now;

            await SaveLocalStateAsync();
        }

        if (item.Status != LocalStatusQuoting)
        {
            errorMessage =
                "La solicitud no se encuentra disponible para cotización.";

            return;
        }

        LoadStoredRequestToWorkspace(item);

        currentStatus = LocalStatusQuoting;
    }


    private async Task StartQuotationAsync(Guid id)
    {
        if (!CanRegisterQuotation)
        {
            return;
        }

        var item = storedRequests.FirstOrDefault(
            request =>
                request.Id == id
                &&
                request.Status == LocalStatusConfirmed);

        if (item is null)
        {
            return;
        }

        item.Status = LocalStatusQuoting;
        item.UpdatedAt = DateTime.Now;

        await SaveLocalStateAsync();

        NavigationManager.NavigateTo(
            BuildQuotationRoute(item.Id));
    }


    private void ContinueQuotation(Guid id)
    {
        if (!CanRegisterQuotation)
        {
            return;
        }

        var item = storedRequests.FirstOrDefault(
            request =>
                request.Id == id
                &&
                request.Status == LocalStatusQuoting);

        if (item is null)
        {
            return;
        }

        NavigationManager.NavigateTo(
            BuildQuotationRoute(item.Id));
    }


    private void LoadStoredRequestToWorkspace(StoredRequest item)
    {
        activeStoredRequestId = item.Id;
        header.CopyFrom(item.Header);
        currentLines = item.Lines.Select(x => x.Clone()).ToList();
        currentQuotes = item.Quotations.Select(x => x.Clone()).ToList();
        ClearLine();
        ClearQuotation();
    }

    private async Task AddQuotationAsync()
    {

        if (!CanRegisterQuotation)
        {
            return;
        }

        errorMessage = null;

        if (!CanQuote)
        {
            errorMessage = "Primero debes seleccionar una solicitud confirmada y presionar Realizar cotización.";
            return;
        }

        if (string.IsNullOrWhiteSpace(quoteForm.Provider))
        {
            errorMessage = "Debes indicar el proveedor.";
            return;
        }

        var lineId =
            TryGuid(
                quoteForm.LineIdText);

        if (
            !CanQuoteWholeRequest
            &&
            !lineId.HasValue
        )
        {
            errorMessage =
                "Para este tipo de solicitud debes "
                + "seleccionar una herramienta específica.";

            return;
        }

        if (
            lineId.HasValue
            &&
            !currentLines.Any(
                item =>
                    item.Id
                    ==
                    lineId.Value)
        )
        {
            errorMessage =
                "La herramienta seleccionada no pertenece "
                + "a la solicitud activa.";

            return;
        }


        var quoteId = editingQuoteId ?? Guid.NewGuid();
        var evidenceId = quoteForm.EvidenceId;
        var evidenceFileName = quoteForm.EvidenceFileName;
        var evidenceContentType = quoteForm.EvidenceContentType;
        var evidencePreview = quoteForm.EvidencePreview;

        if (IsPurchase &&
            quoteForm.EvidencePendingUpload &&
            IsDataImage(evidencePreview))
        {
            if (!activeStoredRequestId.HasValue)
            {
                errorMessage =
                    "No se encontró la solicitud local asociada a la cotización.";
                return;
            }

            var uploaded = await UploadWorkspaceEvidenceAsync(
                activeStoredRequestId.Value,
                quoteId,
                "QuotationImage",
                quoteForm.Provider.Trim(),
                evidenceFileName,
                evidenceContentType,
                evidencePreview);

            if (uploaded is null)
            {
                return;
            }

            evidenceId = uploaded.Id;
            evidenceFileName = uploaded.FileName;
            evidenceContentType = uploaded.ContentType;
        }

        if (editingQuoteId.HasValue)
        {
            var existing = currentQuotes.FirstOrDefault(x => x.Id == editingQuoteId.Value);

            if (existing is not null)
            {
                existing.Provider = quoteForm.Provider.Trim();
                existing.LineId = lineId;
                existing.QuotationDate = quoteForm.QuotationDate;
                existing.DeliveryTime = quoteForm.DeliveryTime?.Trim();
                existing.PriceBeforeVat = quoteForm.PriceBeforeVat;
                existing.EvidenceId = evidenceId;
                existing.EvidenceFileName = evidenceFileName;
                existing.EvidenceContentType = evidenceContentType;
                existing.EvidencePreview = evidencePreview;
                existing.AdditionalDetails = quoteForm.AdditionalDetails?.Trim();
            }
        }
        else
        {
            currentQuotes.Add(new QuotationItem
            {
                Id = quoteId,
                Selected = false,
                Provider = quoteForm.Provider.Trim(),
                LineId = lineId,
                QuotationDate = quoteForm.QuotationDate,
                DeliveryTime = quoteForm.DeliveryTime?.Trim(),
                PriceBeforeVat = quoteForm.PriceBeforeVat,
                AdditionalDetails = quoteForm.AdditionalDetails?.Trim(),
                EvidenceId = evidenceId,
                EvidenceFileName = evidenceFileName,
                EvidenceContentType = evidenceContentType,
                EvidencePreview = evidencePreview,

            });
        }

        await PersistActiveQuotationStateAsync();
        ClearQuotation();
    }

    private void EditQuotation(Guid id)
    {

        if (!CanRegisterQuotation)
        {
            return;
        }

        if (!CanQuote)
        {
            return;
        }

        var quote = currentQuotes.FirstOrDefault(x => x.Id == id);

        if (quote is null)
        {
