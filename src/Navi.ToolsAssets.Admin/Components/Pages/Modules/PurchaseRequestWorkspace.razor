    private sealed class RequestHeader
    {
        public string? RequestName { get; set; }
        public string? BranchIdText { get; set; }
        public string? RequestedBy { get; set; }
        public string? Approver { get; set; }
        public string? RequestType { get; set; }
        public string Priority { get; set; } = "Media";
        public DateTime? RequiredAt { get; set; }
        public string? Location { get; set; }
        public string? NeedDescription { get; set; }

        public RequestHeader Clone()
        {
            return new RequestHeader
            {
                RequestName = RequestName,
                BranchIdText = BranchIdText,
                RequestedBy = RequestedBy,
                Approver = Approver,
                RequestType = RequestType,
                Priority = Priority,
                RequiredAt = RequiredAt,
                Location = Location,
                NeedDescription = NeedDescription
            };
        }

        public void CopyFrom(RequestHeader source)
        {
            RequestName = source.RequestName;
            BranchIdText = source.BranchIdText;
            RequestedBy = source.RequestedBy;
            Approver = source.Approver;
            RequestType = source.RequestType;
            Priority = source.Priority;
            RequiredAt = source.RequiredAt;
            Location = source.Location;
            NeedDescription = source.NeedDescription;
        }

        public void Clear()
        {
            RequestName = string.Empty;
            Approver = string.Empty;
            RequiredAt = null;
            Location = string.Empty;
            NeedDescription = string.Empty;
        }
    }

