    private bool IsActive(string url)
    {
        var current =
            "/" + GetCurrentPath();

        var target =
            "/" + (url ?? "/").Trim('/');

        if (target == "/")
        {
            return current == "/" ||
                   string.IsNullOrWhiteSpace(
                       current.Trim('/'));
        }

        return current.Equals(
                   target,
                   StringComparison.OrdinalIgnoreCase) ||
               current.StartsWith(
                   target + "/",
                   StringComparison.OrdinalIgnoreCase);
    }

    private string GetCurrentPath()
    {
        return Navigation
            .ToBaseRelativePath(
                Navigation.Uri)
            .Split('?', '#')[0]
            .Trim('/')
            .ToLowerInvariant();
    }

    private string GetItemClass(bool active)
    {
        return active
            ? "navi-mobile-shell-menu__item active"
            : "navi-mobile-shell-menu__item";
    }

    private bool HasPermission(
        string permission)
    {
        return Auth.HasPermission(permission);
    }

    private bool HasAny(
        params string[] permissions)
    {
        return Auth.HasAnyPermission(
            permissions);
    }

    private static string GetMenuSymbol(
        string iconKey)
    {
        return iconKey switch
        {
            "home" => "⌂",
            "dashboard" => "▦",
            "mytools" => "◫",
            "inventory" => "▤",
            "location" => "⌖",
            "assign" => "↔",
            "history" => "◷",
            "life" => "▥",
            "damage" => "!",
            "purchase" => "＋",
            "maintenance" => "⌁",
            "consult" => "⌕",
            "calendar" => "□",
            "physical" => "◉",
            "reconcile" => "≋",
            "document" => "▱",
            "reports" => "▦",
            "settings" => "⚙",
            _ => "•"
        };
    }

    private string GetInitials()
    {
        var value =
            DisplayName.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

        if (value.Length == 0)
        {
            return "N";
        }

        if (value.Length == 1)
        {
            return value[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        value[0].Length))
                .ToUpperInvariant();
        }

        return string.Concat(
                value[0][0],
                value[^1][0])
            .ToUpperInvariant();
    }

    private void OnAuthChanged()
    {
        if (isDisposed)
        {
            return;
        }

        _ = InvokeAsync(
            StateHasChanged);
    }

    private void OnHeaderStateChanged()
    {
        _ = InvokeAsync(
            StateHasChanged);
    }

    private void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs args)
    {
        CloseMenus();
        ApplyRouteFallback();

        _ = InvokeAsync(
            async () =>
            {
                await RefreshLoanNotificationsAsync();
                StateHasChanged();
            });
    }

    private void ApplyRouteFallback()
    {
        var presentation =
            GetFallbackPresentation();

        HeaderState.Reset(
            presentation.Title,
            presentation.Description);
    }

