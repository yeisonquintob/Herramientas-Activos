    private List<DashboardBranchOption>
        DashboardBranchFilterOptions =>
            GetScopedDashboardBranches()
                .OrderBy(branch => branch.Code)
                .ThenBy(branch => branch.Name)
                .ToList();

    private List<MobileBranchItem>
        BuildDashboardBranches()
    {
        var scopedBranches =
            GetScopedDashboardBranches();

        var result = scopedBranches
            .Select(branch => new MobileBranchItem
            {
                BranchCode = branch.Code,
                BranchName = branch.Name,
                Total = DashboardFilteredTools.Count(tool =>
                    IsDashboardToolFromBranch(
                        tool,
                        branch.Code,
                        branch.Name))
            })
            .ToList();

        var knownCodes = result
            .Select(item => Normalize(item.BranchCode))
            .Where(code => !string.IsNullOrWhiteSpace(code))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var fallbackBranches = DashboardFilteredTools
            .Where(tool =>
                !knownCodes.Contains(
                    Normalize(tool.BranchCode)))
            .GroupBy(tool => new
            {
                Code = string.IsNullOrWhiteSpace(
                    tool.BranchCode)
                        ? "-"
                        : tool.BranchCode.Trim(),

                Name = string.IsNullOrWhiteSpace(
                    tool.BranchName)
                        ? (
                            string.IsNullOrWhiteSpace(
                                tool.BranchCode)
                                ? "-"
                                : tool.BranchCode.Trim())
                        : tool.BranchName.Trim()
            })
            .Select(group => new MobileBranchItem
            {
                BranchCode = group.Key.Code,
                BranchName = group.Key.Name,
                Total = group.Count()
            });

        result.AddRange(fallbackBranches);

        return result
            .OrderBy(item => item.BranchCode)
            .ThenBy(item => item.BranchName)
            .ToList();
    }

    private List<DashboardBranchOption>
        GetScopedDashboardBranches()
    {
        IEnumerable<DashboardBranchOption> source =
            dashboardBranches
                .Where(branch => branch.IsActive);

        var user = Auth.CurrentUser;

        if (!UserCanSeeAllBranches() &&
            user is not null)
        {
            source = source.Where(branch =>
                SameNormalized(
                    branch.Code,
                    user.BranchCode)
                ||
                SameNormalized(
                    branch.Name,
                    user.BranchName)
                ||
                SameNormalized(
                    branch.Code,
                    user.BranchName)
                ||
                SameNormalized(
                    branch.Name,
                    user.BranchCode));
        }

        if (!string.IsNullOrWhiteSpace(
                filterBranchCode))
        {
            source = source.Where(branch =>
                SameNormalized(
                    branch.Code,
                    filterBranchCode)
                ||
                SameNormalized(
                    branch.Name,
                    filterBranchCode));
        }

        var result = source.ToList();

        if (result.Count > 0)
        {
            return result;
        }

        return FilterByOperationalScope(tools)
            .GroupBy(tool => new
            {
                Code = string.IsNullOrWhiteSpace(
                    tool.BranchCode)
                        ? "-"
                        : tool.BranchCode.Trim(),

                Name = string.IsNullOrWhiteSpace(
                    tool.BranchName)
                        ? (
                            string.IsNullOrWhiteSpace(
                                tool.BranchCode)
                                ? "-"
                                : tool.BranchCode.Trim())
                        : tool.BranchName.Trim()
            })
            .Select(group =>
                new DashboardBranchOption
                {
                    Code = group.Key.Code,
                    Name = group.Key.Name,
                    IsActive = true
                })
            .OrderBy(branch => branch.Code)
            .ToList();
    }

    private static bool IsDashboardToolFromBranch(
        MobileToolDto tool,
        string? branchCode,
        string? branchName)
    {
        return
            SameNormalized(
                tool.BranchCode,
                branchCode)
            ||
            SameNormalized(
                tool.BranchName,
                branchName)
            ||
            SameNormalized(
                tool.BranchCode,
                branchName)
            ||
            SameNormalized(
                tool.BranchName,
                branchCode);
    }

