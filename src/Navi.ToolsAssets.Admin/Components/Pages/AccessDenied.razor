@page "/access-denied"
@rendermode InteractiveServer

@using System.Text.Json
@using Microsoft.JSInterop
@using Navi.ToolsAssets.Admin.Services.Auth

@inject WebAuthSessionService AuthSession
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Acceso denegado - NAVI</PageTitle>

<NaviPageHero Pill="SEGURIDAD"
              Title="Acceso denegado"
              Description="Tu usuario o rol actual no tiene permisos para ingresar a este módulo.">
    <NaviActionButton Tone="primary" OnClick="GoToAllowedStart">
        @NaviPermissionRouteService.GetStartLabel(AuthSession)
    </NaviActionButton>
</NaviPageHero>

<section class="access-denied-page">
    <article class="access-denied-card admin-standard-card">
        <span>Permisos insuficientes</span>
        <h2>No tienes acceso a esta vista</h2>

        <p>
            Puedes volver al primer módulo disponible para tu rol o solicitar la habilitación del permiso correspondiente.
        </p>

        <NaviActionButton Tone="primary" OnClick="GoToAllowedStart">
            Ir a módulo permitido
        </NaviActionButton>
    </article>
</section>

<style>
    .access-denied-page {
        min-height: calc(100vh - 260px);
        display: grid;
        place-items: center;
        padding: 1rem;
    }

    .access-denied-card {
        width: min(560px, 100%);
        padding: 1.4rem;
        text-align: center;
    }

    .access-denied-card span {
        display: inline-flex;
        border-radius: 999px;
        background: #fff8df;
        color: #8a4b00;
        border: 1px solid #fedf89;
        padding: .22rem .7rem;
        font-size: .72rem;
        font-weight: 950;
        margin-bottom: .7rem;
    }

    .access-denied-card h2 {
        margin: 0;
        color: #111827;
        font-size: 1.45rem;
        font-weight: 950;
    }

    .access-denied-card p {
        color: #5f6b7a;
        font-size: .95rem;
        line-height: 1.45;
        margin: .6rem 0 1rem;
    }
</style>

@code {
    private const string StorageKey = "navi-auth-session";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || AuthSession.IsAuthenticated)
        {
            return;
        }

        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);

            if (!string.IsNullOrWhiteSpace(json))
            {
                var user = JsonSerializer.Deserialize<AuthSessionUser>(
                    json,
                    new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });

                if (user is not null && !string.IsNullOrWhiteSpace(user.UserName))
                {
                    AuthSession.Login(user);
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch
        {
            try
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", StorageKey);
            }
            catch
            {
                // Ignorar error JS.
            }
        }
    }

    private void GoToAllowedStart()
    {
        Navigation.NavigateTo(NaviPermissionRouteService.GetStartRoute(AuthSession), forceLoad: true);
    }
}
