@page "/tools/{ToolId:guid}"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Navi.ToolsAssets.Admin.Services.Auth
@using Navi.ToolsAssets.Admin.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject WebAuthSessionService AuthSession

<PageTitle>Detalle herramienta - NAVI Herramientas</PageTitle>



@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @errorMessage
    </div>
}
else if (isLoading && tool is null)
{
    <div class="alert alert-info">
        Cargando detalle de la herramienta...
    </div>
}
else if (tool is not null)
{
        <NaviPageHero
        Pill="ACTIVOS FIJOS"
        Title="@tool!.Name"
        Description="Consulta visual de datos maestros, ubicación, clasificación, estados y hoja de vida operativa.">

        <button type="button" @onclick="LoadAsync" disabled="@isLoading" data-ntx-tone="secondary" >
            @(isLoading ? "Actualizando..." : "Actualizar")
        </button>

    </NaviPageHero>

    <section class="tool-detail-summary-shell">
        <section class="tool-detail-kpis navi-final-kpi-row tool-detail-summary-kpis">
        <article>
            <span>Código interno</span>
            <strong>@ShowValue(tool!.InternalCode)</strong>
            <small>Activo fijo</small>
        </article>

        <article>
            <span>Estado operativo</span>
            <strong>@GetStatusLabel(tool!.OperationalStatus)</strong>
            <small>Control actual</small>
        </article>

        <article>
            <span>Clasificación</span>
            <strong>@(tool!.IsSpecialized ? "Especializada" : "No especializada")</strong>
            <small>Tipo de activo</small>
        </article>

        <article>
            <span>Responsable</span>
            <strong>@ShowValue(tool!.ResponsiblePersonName)</strong>
            <small>Custodia actual</small>
        </article>
    </section>

        <aside class="tool-detail-summary-actions">
            <button type="button" @onclick="GoBack" class="btn-detail-back" data-ntx-tone="secondary" >
                Volver al inventario
            </button>

            @if (CanOpenLifeRecord)
            {
                <a class="detail-action detail-action-primary navi-life-record-hero-link"
                   href="@($"/tools/{ToolId}/technical-life-record-view")" data-ntx-tone="primary" >
                    Ver hoja vida técnica
                </a>
            }
        </aside>
    </section>


    <section class="tool-detail-panel tool-admin-control">
        <div class="admin-control-header">
            <div>
                <h2>Control administrativo del activo</h2>
                <p>Permite editar datos maestros, guardar cambios, cancelar edición o marcar el activo como no apto.</p>
            </div>

            <div class="admin-control-actions">
                @if (!isEditingMasterData)
                {
                    <button type="button" @onclick="StartMasterDataEdit" class="detail-action detail-action-primary" data-ntx-tone="primary" >
                        Editar
                    </button>


                }
                else
                {
                    <button type="button" @onclick="SaveMasterDataAsync" class="detail-action detail-action-success" data-ntx-tone="primary" >
                        Guardar
                    </button>

                    <button type="button" @onclick="CancelMasterDataEdit" class="detail-action detail-action-neutral" data-ntx-tone="secondary" >
                        Cancelar
                    </button>


                }
            </div>
        </div>

        @if (isEditingMasterData)
        {
            <div class="admin-edit-grid">
                <div>
                    <label>Código interno</label>
                    <input class="form-control" @bind="editModel.InternalCode" />
                </div>

                <div>
                    <label>Nombre</label>
                    <input class="form-control" @bind="editModel.Name" />
                </div>

                <div>
                    <label>Serial</label>
                    <input class="form-control" @bind="editModel.SerialNumber" />
                </div>

                <div>
                    <label>Activo fijo</label>
                    <input class="form-control" @bind="editModel.FixedAssetCode" />
                </div>

                <div>
                    <label>Código Fenix365</label>
                    <input class="form-control" @bind="editModel.FenixCode" />
                </div>

                <div>
                    <label>Marca</label>
                    <input class="form-control" @bind="editModel.Brand" />
                </div>

                <div>
                    <label>Modelo</label>
                    <input class="form-control" @bind="editModel.Model" />
                </div>

                <div>
                    <label>Estado operativo</label>
                    <select class="form-select" @bind="editModel.OperationalStatus">
                        <option value="Available">Disponible</option>
                        <option value="Assigned">Asignado</option>
                        <option value="Loaned">Prestado</option>
                        <option value="InMaintenance">En mantenimiento</option>
                        <option value="Damaged">Dañado</option>
                        <option value="NotSuitable">No apto</option>
                        <option value="PendingValidation">Pendiente validación</option>
                        <option value="Inconsistent">Inconsistente</option>
                        <option value="NotLocated">No localizado</option>
                        <option value="PendingDisposal">Pendiente baja</option>
                        <option value="Disposed">Dado de baja</option>
                    </select>
                </div>

                <div>
                    <label>Estado físico</label>
                    <select class="form-select" @bind="editModel.PhysicalStatus">
                        <option value="Good">Bueno</option>
                        <option value="Regular">Regular</option>
                        <option value="Damaged">Dañado</option>
                        <option value="Lost">Perdido</option>
                        <option value="Incomplete">Incompleto</option>
                    </select>
                </div>

                <div class="admin-check">
                    <input type="checkbox" class="form-check-input" @bind="editModel.IsSpecialized" />
                    <label>Activo especializado</label>
                </div>

                <div class="admin-check">
                    <input type="checkbox" class="form-check-input" @bind="editModel.RequiresMaintenance" />
                    <label>Requiere mantenimiento</label>
                </div>

                <div class="admin-check">
                    <input type="checkbox" class="form-check-input" @bind="editModel.RequiresPreOperationalCheck" />
                    <label>Requiere preoperacional</label>
                </div>

                <div class="admin-check">
                    <input type="checkbox" class="form-check-input" @bind="editModel.RequiresCertification" />
                    <label>Requiere certificación</label>
                </div>

                <div>
                    <label>Vence certificación</label>
                    <InputDate class="form-control" @bind-Value="editModel.CertificationExpirationDate" />
                </div>

                <div>
                    <label>Periodo mantenimiento meses</label>
                    <input type="number" class="form-control" @bind="editModel.MaintenancePeriodMonths" min="0" />
                </div>

                <div class="admin-edit-full">
                    <label>Descripción / observación</label>
                    <textarea class="form-control" rows="3" @bind="editModel.Description"></textarea>
                </div>
            </div>
        }
        else
        {
            <div class="admin-readonly-note">
                <strong>Modo lectura.</strong> Presiona <b>Editar</b> para modificar datos del activo. Usa <b>No apto</b> cuando el activo debe permanecer creado, pero fuera de operación.
            </div>
        }
    </section>


    @if (reportedSource?.HasSource == true)
    {
        <section class="tool-detail-panel tool-source-panel">
            <div class="source-header">
                <div>
                    <span class="source-pill">ORIGEN DEL ACTIVO</span>
                    <h2>Origen desde toma física</h2>
                    <p>Este activo fue creado desde un registro reportado durante una toma física.</p>
                </div>
            </div>

            <div class="source-grid">
                <div>
                    <span>Toma física</span>
                    <strong>@DisplaySourceValue(reportedSource.PhysicalCountNumber)</strong>
                </div>

                <div>
                    <span>Participante / reportante</span>
                    <strong>@DisplaySourceValue(reportedSource.ParticipantName)</strong>
                    <small>@DisplaySourceValue(reportedSource.ParticipantUserName)</small>
                </div>

                <div>
                    <span>Código reportado</span>
                    <strong>@DisplaySourceValue(reportedSource.ReportedCode)</strong>
                </div>

                <div>
                    <span>Nombre reportado</span>
                    <strong>@DisplaySourceValue(reportedSource.ReportedName)</strong>
                </div>

                <div>
                    <span>Ubicación encontrada</span>
                    <strong>@DisplaySourceValue(reportedSource.FoundLocation)</strong>
                </div>

                <div>
                    <span>Estado conciliación</span>
                    <strong>@DisplaySourceValue(reportedSource.ReconciliationStatus)</strong>
                    <small>@DisplaySourceValue(reportedSource.ReconciliationObservation)</small>
                </div>

                <div class="source-full">
                    <span>Observación del reporte</span>
                    <strong>@DisplaySourceValue(reportedSource.Observation)</strong>
                </div>
            </div>
        </section>
    }

<div class="tool-detail-grid"><section class="tool-detail-panel">
            <h2>Datos principales</h2>

            <div class="detail-list">
                <div>
                    <span>Código interno</span>
                    <strong>@tool!.InternalCode</strong>
                </div>

                <div>
                    <span>Serial</span>
                    <strong>@ShowValue(tool!.SerialNumber)</strong>
                </div>

                <div>
                    <span>Activo fijo</span>
                    <strong>@ShowValue(tool!.FixedAssetCode)</strong>
                </div>

                <div>
                    <span>Código Fenix365</span>
                    <strong>@ShowValue(tool!.FenixCode)</strong>
                </div>

                <div>
                    <span>Marca</span>
                    <strong>@ShowValue(tool!.Brand)</strong>
                </div>

                <div>
                    <span>Modelo</span>
                    <strong>@ShowValue(tool!.Model)</strong>
                </div>
            </div>
        </section>

        <section class="tool-detail-panel">
            <h2>Ubicación y clasificación</h2>

            <div class="detail-list">
                <div>
                    <span>Sede</span>
                    <strong>@ShowValue(tool!.BranchCode) - @ShowValue(tool!.BranchName)</strong>
                </div>

                <div>
                    <span>Ubicación</span>
                    <strong>@ShowValue(tool!.LocationCode) - @ShowValue(tool!.LocationName)</strong>
                </div>

                <div>
                    <span>Responsable</span>
                    <strong>@ShowValue(tool!.ResponsiblePersonName)</strong>
                </div>

                <div>
                    <span>Tipo</span>
                    <strong>@ShowValue(tool!.ToolTypeName)</strong>
                </div>

                <div>
                    <span>Categoría</span>
                    <strong>@ShowValue(tool!.ToolCategoryName)</strong>
                </div>

                <div>
                    <span>Unidad / Cantidad</span>
                    <strong>@ShowValue(tool!.UnitOfMeasure) / @tool!.Quantity</strong>
                </div>
            </div>
        </section>
    </div>


    @if (reportedSource?.HasSource == true)
    {
        <section class="tool-detail-panel tool-source-panel">
            <div class="source-header">
                <div>
                    <span class="source-pill">ORIGEN DEL ACTIVO</span>
                    <h2>Origen desde toma física</h2>
                    <p>Este activo fue creado desde un registro reportado durante una toma física.</p>
                </div>
            </div>

            <div class="source-grid">
                <div>
                    <span>Toma física</span>
                    <strong>@DisplaySourceValue(reportedSource.PhysicalCountNumber)</strong>
                </div>

                <div>
                    <span>Participante / reportante</span>
                    <strong>@DisplaySourceValue(reportedSource.ParticipantName)</strong>
                    <small>@DisplaySourceValue(reportedSource.ParticipantUserName)</small>
                </div>

                <div>
                    <span>Código reportado</span>
                    <strong>@DisplaySourceValue(reportedSource.ReportedCode)</strong>
                </div>

                <div>
                    <span>Nombre reportado</span>
                    <strong>@DisplaySourceValue(reportedSource.ReportedName)</strong>
                </div>

                <div>
                    <span>Ubicación encontrada</span>
                    <strong>@DisplaySourceValue(reportedSource.FoundLocation)</strong>
                </div>

                <div>
                    <span>Estado conciliación</span>
                    <strong>@DisplaySourceValue(reportedSource.ReconciliationStatus)</strong>
                    <small>@DisplaySourceValue(reportedSource.ReconciliationObservation)</small>
                </div>

                <div class="source-full">
                    <span>Observación del reporte</span>
                    <strong>@DisplaySourceValue(reportedSource.Observation)</strong>
                </div>
            </div>
        </section>
    }

<div class="tool-detail-grid">
        @if (CanUseDetailActions)
    {
<section class="tool-detail-panel">
            <h2>Acciones rápidas</h2>

            <div class="quick-actions">
                <div>
                    <label class="form-label">Cambiar estado operativo</label>
                    <select class="form-select" @bind="selectedOperationalStatus" disabled="@(!CanChangeOperationalStatus)">
                        <option value="Available">Disponible</option>
                        <option value="PendingValidation">Pendiente validación</option>
                        <option value="Assigned">Asignada</option>
                        <option value="Loaned">Prestada</option>
                        <option value="InMaintenance">En mantenimiento</option>
                        <option value="Damaged">Dañada</option>
                        <option value="NotSuitable">No apta</option>
                        <option value="Inconsistent">Inconsistente</option>
                        <option value="NotLocated">No localizada</option>
                        <option value="PendingDisposal">Pendiente de baja</option>
                        <option value="Disposed">Dada de baja</option>
                    </select>
                </div>

                <div>
                    <label class="form-label">Observación</label>
                    <input class="form-control"
                           placeholder="Motivo del cambio..."
                           @bind="actionObservation"
                           disabled="@(!CanChangeOperationalStatus)" />
                </div>

                <div class="detail-actions-group">
                    @if (CanChangeOperationalStatus)
                    {
                        <button @onclick="ChangeOperationalStatusAsync" disabled="@isSaving" class="btn btn-primary btn-sm navi-admin-quick-save-status-tone-positive-v5" data-ntx-tone="primary" >
                            @(isSaving ? "Guardando..." : "Guardar estado")
                        </button>
                    }

                    @if (CanMarkSpecialized)
                    {
                        <button @onclick="ToggleSpecializedAsync" disabled="@isSaving" class="btn btn-outline-primary btn-sm" data-ntx-tone="ghost" >
                            @(tool!.IsSpecialized == true ? "Marcar no especializada" : "Marcar especializada")
                        </button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(actionMessage))
                {
                    <div class="alert alert-success mb-0">
                        @actionMessage
                    </div>
                }
            </div>
        </section>
    }



        <section class="tool-detail-panel">
            <h2>Estados</h2>

            <div class="status-chip-grid">
                <div>
                    <span>Operativo</span>
                    <strong>@GetStatusLabel(tool!.OperationalStatus)</strong>
                </div>

                <div>
                    <span>Físico</span>
                    <strong>@ShowValue(tool!.PhysicalStatus)</strong>
                </div>

                <div>
                    <span>Custodia</span>
                    <strong>@ShowValue(tool!.CustodyStatus)</strong>
                </div>

                <div>
                    <span>Conciliación</span>
                    <strong>@ShowValue(tool!.ReconciliationStatus)</strong>
                </div>

                <div>
                    <span>Sincronización</span>
                    <strong>@ShowValue(tool!.SyncStatus)</strong>
                </div>
            </div>
        </section>

        <section class="tool-detail-panel">
            <h2>Reglas operativas</h2>

            <div class="status-chip-grid">
                <div>
                    <span>Mantenimiento</span>
                    <strong>@BoolLabel(tool!.RequiresMaintenance == true)</strong>
                </div>

                <div>
                    <span>Preoperacional</span>
                    <strong>@BoolLabel(tool!.RequiresPreOperationalCheck == true)</strong>
                </div>

                <div>
                    <span>Certificación</span>
                    <strong>@BoolLabel(tool!.RequiresCertification == true)</strong>
                </div>

                <div>
                    <span>Vence certificación</span>
                    <strong>@FormatDate(tool!.CertificationExpirationDate)</strong>
                </div>
            </div>
        </section>
    </div>

    <section class="tool-detail-panel">
        <h2>Hoja de vida / Actividad reciente</h2>

        @if (lifeCycleEvents.Count == 0)
        {
            <p class="text-muted">Esta herramienta aún no tiene eventos registrados.</p>
        }
        else
        {
            <div class="timeline">
                @foreach (var item in lifeCycleEvents.OrderByDescending(x => x.EventDate))
                {
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>

                        <div class="timeline-content">
                            <div class="timeline-header">
                                <strong>@item.Title</strong>
                                <span>@item.EventDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </div>

                            <small class="text-muted">@item.EventType</small>

                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <p>@item.Description</p>
                            }

                            <div class="timeline-values">
                                <span>Anterior: @ShowValue(item.PreviousValue)</span>
                                <span>Nuevo: @ShowValue(item.NewValue)</span>
                                <span>Usuario: @ShowValue(item.PerformedBy)</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}

@code {


    private bool CanEditTool => AuthSession.HasPermission("Tools.Edit");

    private bool CanUseDetailActions => AuthSession.HasPermission("ToolDetail.Actions");

    private bool CanChangeOperationalStatus =>
        CanUseDetailActions && AuthSession.HasPermission("Tools.Status.Change");

    private bool CanMarkSpecialized =>
        CanUseDetailActions && AuthSession.HasPermission("Tools.Specialized.Mark");

    private bool CanOpenLifeRecord =>
        AuthSession.HasPermission("ToolDetail.LifeRecord.Open") ||
        AuthSession.HasPermission("TechnicalLifeRecord.View");

    private bool CanDeactivateTool => AuthSession.HasPermission("Tools.Delete");

    private void DenyAction(string action)
    {
        errorMessage = $"No tienes permiso para {action}.";
        successMessage = null;
        actionMessage = null;
    }

[Parameter]
    public Guid ToolId { get; set; }

    private bool isLoading;
    private bool isSaving;
    private string? actionMessage;
    private string selectedOperationalStatus = "PendingValidation";
    private string actionObservation = string.Empty;
    private string? errorMessage;
    private ToolDetailItem? tool;
    private List<LifeCycleEventItem> lifeCycleEvents = new();
    private ToolReportedSourceModel? reportedSource;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var client = HttpClientFactory.CreateClient("NaviApi");

            tool = await client.GetFromJsonAsync<ToolDetailItem>($"api/tools/{ToolId}");

            if (tool is not null)
            {
                selectedOperationalStatus = tool!.OperationalStatus;
            }
            lifeCycleEvents = await client.GetFromJsonAsync<List<LifeCycleEventItem>>($"api/tools/{ToolId}/life-cycle-events") ?? new();
                reportedSource = await client.GetFromJsonAsync<ToolReportedSourceModel>($"api/tools/{ToolId}/reported-source");
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar el detalle. Valida que la API esté activa en http://localhost:5218. Detalle: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangeOperationalStatusAsync()
    {

        if (!CanChangeOperationalStatus)
        {
            DenyAction("cambiar el estado operativo del activo");
            return;
        }

        if (tool is null)
        {
            return;
        }

        try
        {
            isSaving = true;
            actionMessage = null;
            errorMessage = null;

            var client = HttpClientFactory.CreateClient("NaviApi");

            var payload = new
            {
                operationalStatus = selectedOperationalStatus,
                changedBy = "yquinto",
                updatedBy = "yquinto",
                reason = actionObservation,
                observation = actionObservation
            };

            var response = await client.PatchAsJsonAsync($"api/tools/{tool.Id}/operational-status", payload);

            if (!response.IsSuccessStatusCode)
            {
                var detail = await response.Content.ReadAsStringAsync();
                errorMessage = $"No se pudo cambiar el estado. Código: {(int)response.StatusCode}. Detalle: {detail}";
                return;
            }

            actionMessage = "Estado operativo actualizado correctamente.";
            actionObservation = string.Empty;

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cambiar el estado. Detalle: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleSpecializedAsync()
    {

        if (!CanMarkSpecialized)
        {
            DenyAction("marcar o desmarcar especialización del activo");
            return;
        }

        if (tool is null)
        {
            return;
        }

        try
        {
            isSaving = true;
            actionMessage = null;
            errorMessage = null;

            var client = HttpClientFactory.CreateClient("NaviApi");

            var payload = new
            {
                isSpecialized = !tool.IsSpecialized,
                changedBy = "yquinto",
                updatedBy = "yquinto",
                reason = "Cambio de clasificación desde Admin."
            };

            var response = await client.PatchAsJsonAsync($"api/tools/{tool.Id}/classification", payload);

            if (!response.IsSuccessStatusCode)
            {
                var detail = await response.Content.ReadAsStringAsync();
                errorMessage = $"No se pudo cambiar la clasificación. Código: {(int)response.StatusCode}. Detalle: {detail}";
                return;
            }

            actionMessage = "Clasificación actualizada correctamente.";

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cambiar la clasificación. Detalle: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
    private void GoBack()
    {
        NavigationManager.NavigateTo("/tools");
    }

    private static string ShowValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static string BoolLabel(bool value)
    {
        return value ? "Sí" : "No";
    }

    private static string FormatDate(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "-";
    }

    private static string GetStatusLabel(string? status)
    {
        return status switch
        {
            "Available" => "Disponible",
            "Assigned" => "Asignada",
            "Loaned" => "Prestada",
            "InMaintenance" => "En mantenimiento",
            "Damaged" => "Dañada",
            "NotSuitable" => "No apta",
            "PendingValidation" => "Pendiente validación",
            "Inconsistent" => "Inconsistente",
            "NotLocated" => "No localizada",
            "PendingDisposal" => "Pendiente de baja",
            "Disposed" => "Dada de baja",
            _ => NaviStatusLabels.ToSpanish(status)
        };
    }

    private sealed class ToolDetailItem
    {
        public Guid Id { get; set; }
        public string InternalCode { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? Brand { get; set; }
        public string? Model { get; set; }
        public string? SerialNumber { get; set; }
        public string? FixedAssetCode { get; set; }
        public string? FenixCode { get; set; }
        public string? UnitOfMeasure { get; set; }
        public decimal Quantity { get; set; }
        public bool IsSpecialized { get; set; }
        public bool RequiresMaintenance { get; set; }
        public bool RequiresPreOperationalCheck { get; set; }
        public bool RequiresCertification { get; set; }
        public DateTime? CertificationExpirationDate { get; set; }
        public string? BranchCode { get; set; }
        public string? BranchName { get; set; }
        public string? LocationCode { get; set; }
        public string? LocationName { get; set; }
        public string? ResponsiblePersonName { get; set; }
        public string? ToolTypeCode { get; set; }
        public string? ToolTypeName { get; set; }
        public string? ToolCategoryCode { get; set; }
        public string? ToolCategoryName { get; set; }
        public string OperationalStatus { get; set; } = string.Empty;
        public string PhysicalStatus { get; set; } = string.Empty;
        public string CustodyStatus { get; set; } = string.Empty;
        public string ReconciliationStatus { get; set; } = string.Empty;
        public string SyncStatus { get; set; } = string.Empty;
    }

    private sealed class LifeCycleEventItem
    {
        public Guid Id { get; set; }
        public Guid ToolAssetId { get; set; }
        public string EventType { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? PreviousValue { get; set; }
        public string? NewValue { get; set; }
        public DateTime EventDate { get; set; }
