@code {

    private string PhysicalCountHeroTitle =>
        board?.CountNumber ?? "Toma física";


    private bool IsAdmin =>
        string.Equals(AuthSession.RoleCode, "ADMIN", StringComparison.OrdinalIgnoreCase)
        || string.Equals(AuthSession.RoleCode, "SUPERADMIN", StringComparison.OrdinalIgnoreCase)
        || string.Equals(AuthSession.RoleName, "Administrador", StringComparison.OrdinalIgnoreCase)
        || string.Equals(AuthSession.RoleName, "Administrador NAVI", StringComparison.OrdinalIgnoreCase);

    private bool CanCreatePhysicalCount => PcHasPermission("PhysicalCounts.Create");
    private bool CanStartPhysicalCount => PcHasPermission("PhysicalCounts.Start");
    private bool CanClosePhysicalCount => PcHasPermission("PhysicalCounts.Close");
    private bool CanCancelPhysicalCount => PcHasPermission("PhysicalCounts.Cancel");
    private bool CanReportPhysicalCount => PcHasPermission("PhysicalCounts.Report");
    private bool CanUploadPhysicalEvidence => PcHasPermission("PhysicalCounts.Evidence.Upload");

    private bool CanSeeAllParticipants => IsAdmin || CanCreatePhysicalCount;

    private IEnumerable<ParticipantItem> VisibleParticipants
    {
        get
        {
            var participants = board?.Participants ?? new();

            if (CanSeeAllParticipants)
            {
                return DistinctParticipants(participants);
            }

            return DistinctParticipants(participants.Where(PcIsCurrentUserParticipant));
        }
    }

    private int VisibleTotalParticipants => VisibleParticipants.Count();

    private int VisibleInProgress =>
        VisibleParticipants.Count(x =>
            string.Equals(x.Status, "InProgress", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.StatusLabel, "En proceso", StringComparison.OrdinalIgnoreCase));

    private int VisibleFinished =>
        VisibleParticipants.Count(x =>
            string.Equals(x.Status, "Finished", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.Status, "FinishedWithDifferences", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.StatusLabel, "Finalizada", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.StatusLabel, "Finalizada con diferencias", StringComparison.OrdinalIgnoreCase));

    private int VisibleTotalPending => VisibleParticipants.Sum(x => x.PendingItems);

    private int VisibleDifferences =>
        VisibleParticipants.Sum(x => x.DifferentItems + x.MissingItems + x.DamagedItems + x.ExtraItems);

    private int VisibleTotalExpected => VisibleParticipants.Sum(x => x.ExpectedItems);
    private int VisibleTotalCounted => VisibleParticipants.Sum(x => x.CountedItems);

    private decimal VisibleProgress =>
        VisibleTotalExpected <= 0
            ? 0
            : Math.Round((decimal)VisibleTotalCounted * 100 / VisibleTotalExpected, 2);

    private bool PcHasPermission(string permission)
    {
        return AuthSession.HasPermission(permission)
            || string.Equals(AuthSession.RoleCode, "ADMIN", StringComparison.OrdinalIgnoreCase)
            || string.Equals(AuthSession.RoleCode, "SUPERADMIN", StringComparison.OrdinalIgnoreCase);
    }

    private bool CanViewParticipantDetail(ParticipantItem participant)
    {
        return CanSeeAllParticipants || PcIsCurrentUserParticipant(participant);
    }

    private bool CanStartParticipant(ParticipantItem participant)
    {
        return CanStartPhysicalCount && CanViewParticipantDetail(participant);
    }

    private bool CanFinishParticipant(ParticipantItem participant)
    {
        return CanClosePhysicalCount && CanViewParticipantDetail(participant);
    }

    private bool PcIsCurrentUserParticipant(ParticipantItem participant)
    {
        var currentUserId = AuthSession.UserId?.ToString();
        var currentUserName = AuthSession.UserName;
        var currentDisplayName = AuthSession.DisplayName;
        var currentEmail = AuthSession.Email;

        return PcSameUser(participant.UserId, currentUserId)
            || PcSameUser(participant.UserName, currentUserName)
            || PcSameUser(participant.DisplayName, currentDisplayName)
            || PcSameUser(participant.UserName, currentEmail)
            || PcContainsUser(participant.UserName, currentUserName)
            || PcContainsUser(participant.DisplayName, currentDisplayName);
    }

    private static IEnumerable<ParticipantItem> DistinctParticipants(IEnumerable<ParticipantItem> source)
    {
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var item in source.OrderBy(x => x.DisplayName))
        {
            var key =
                !string.IsNullOrWhiteSpace(item.UserId) ? $"USERID:{PcNormalizeKey(item.UserId)}" :
                !string.IsNullOrWhiteSpace(item.UserName) ? $"USERNAME:{PcNormalizeKey(item.UserName)}" :
                item.ResponsiblePersonId.HasValue ? $"RESP:{item.ResponsiblePersonId.Value}" :
                $"NAME:{PcNormalizeKey(item.DisplayName)}";

            if (seen.Add(key))
            {
                yield return item;
            }
        }
    }

    private async Task SelectDefaultParticipantAsync()
    {
        var visible = VisibleParticipants.ToList();

        if (selectedPending is not null && visible.Any(x => x.Id == selectedPending.Id))
        {
            return;
        }

        if (!CanSeeAllParticipants && visible.Count == 1)
        {
            await LoadPendingToolsAsync(visible[0].Id);
            return;
        }

        selectedPending = null;
        showQuickReportForm = false;
    }

    private static bool PcSameUser(string? left, string? right)
    {
        var leftKey = PcNormalizeKey(left);
        var rightKey = PcNormalizeKey(right);

        return !string.IsNullOrWhiteSpace(leftKey)
            && !string.IsNullOrWhiteSpace(rightKey)
            && leftKey.Equals(rightKey, StringComparison.OrdinalIgnoreCase);
    }

    private static bool PcContainsUser(string? text, string? user)
    {
        var textKey = PcNormalizeKey(text);
        var userKey = PcNormalizeKey(user);

        return !string.IsNullOrWhiteSpace(textKey)
            && !string.IsNullOrWhiteSpace(userKey)
            && textKey.Contains(userKey, StringComparison.OrdinalIgnoreCase);
    }

    private static string PcNormalizeKey(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return new string(value
            .Where(char.IsLetterOrDigit)
            .Select(char.ToUpperInvariant)
            .ToArray());
    }





private bool CanManagePhysicalCount =>
        IsAdmin || CanCreatePhysicalCount || CanStartPhysicalCount || CanClosePhysicalCount || CanCancelPhysicalCount;



    [Parameter] public Guid Id { get; set; }

    private PhysicalCountBoard? board;
    private ExtraItemsResponse? extraItems;
    private ReportedItemsBoard? reportedItemsBoard;
    private QuickReportedItemForm quickReportedItem = new();
    private bool isSavingQuickReport;
    private bool showQuickReportForm;
    private string? quickReportError;
    private string? quickReportSuccess;
    private PendingToolsResponse? selectedPending;
    private bool isLoading;
    private string searchText = string.Empty;
    private string selectedParticipantStatus = string.Empty;
    private string? successMessage;
    private string? errorMessage;

    private readonly (string Value, string Text)[] ParticipantStatusOptions =
    {
        ("NotStarted", "No iniciada"),
        ("InProgress", "En proceso"),
        ("Finished", "Finalizada"),
        ("FinishedWithDifferences", "Con diferencias"),
        ("Expired", "Vencida")
    };




    private IEnumerable<ReportedItem> SelectedParticipantReportedItems =>
        (reportedItemsBoard?.Items ?? new())
            .Where(IsReportForSelectedParticipant)
            .OrderByDescending(x => x.ReportedAt);

    private bool IsReportForSelectedParticipant(ReportedItem item)
    {
        if (selectedPending is null)
        {
            return false;
        }

        if (item.PhysicalCountParticipantId.HasValue &&
            item.PhysicalCountParticipantId.Value == selectedPending.Id)
        {
            return true;
        }

        if (!string.IsNullOrWhiteSpace(item.ParticipantName) &&
            item.ParticipantName.Equals(selectedPending.DisplayName, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (!string.IsNullOrWhiteSpace(item.ParticipantUserName) &&
            !string.IsNullOrWhiteSpace(selectedPending.UserName) &&
            item.ParticipantUserName.Equals(selectedPending.UserName, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return false;
    }

    private List<ReportedItem> GetReportsForParticipant(ParticipantItem participant)
    {
        return (reportedItemsBoard?.Items ?? new())
            .Where(item =>
                item.PhysicalCountParticipantId == participant.Id ||
                (!string.IsNullOrWhiteSpace(item.ParticipantName) &&
                    item.ParticipantName.Equals(participant.DisplayName, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(item.ParticipantUserName) &&
                    item.ParticipantUserName.Equals(participant.UserName, StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }

    private int GetParticipantReportedCount(ParticipantItem participant)
    {
        var reports = GetReportsForParticipant(participant);
        return reports.Count;
    }

    private int GetParticipantPendingCount(ParticipantItem participant)
    {
        var reported = GetParticipantReportedCount(participant);
        var expected = participant.ExpectedItems;

        if (expected <= 0)
        {
            return participant.PendingItems;
        }

        var pending = expected - reported;
        return pending < 0 ? 0 : pending;
    }

    private int GetParticipantProgress(ParticipantItem participant)
    {
        var expected = participant.ExpectedItems;

        if (expected <= 0)
        {
            return Convert.ToInt32(Math.Round(participant.Progress, 0, MidpointRounding.AwayFromZero));
        }

        var reported = GetParticipantReportedCount(participant);
        var progress = (int)Math.Round((reported * 100.0) / expected);

        if (progress < 0)
        {
            return 0;
        }

        if (progress > 100)
        {
            return 100;
        }

        return progress;
    }

    private IReadOnlyList<string> GetParticipantDifferenceLines(ParticipantItem participant)
    {
        var reports = GetReportsForParticipant(participant);

        var missing = reports.Count(x => IsReportType(x, "NotFound"));
        var extra = reports.Count(x => IsReportType(x, "ExtraNotListed"));
        var damaged = reports.Count(x => IsReportType(x, "Damaged"));
        var returned = reports.Count(x => IsReportType(x, "ReturnedOrDelivered"));

        return new[]
        {
            $"Faltantes: {missing}",
            $"No listadas: {extra}",
            $"Dañadas: {damaged}",
            $"Devueltas: {returned}"
        };
    }

    private int GetSelectedPendingVisualCount()
    {
        if (selectedPending is null)
        {
            return 0;
        }

        var expected = selectedPending.ExpectedItems;
        var reported = SelectedParticipantReportedItems.Count();

        if (expected <= 0)
        {
            return selectedPending.PendingItems;
        }

        var pending = expected - reported;
        return pending < 0 ? 0 : pending;
    }

    private static bool IsReportType(ReportedItem item, string reportType)
    {
        return !string.IsNullOrWhiteSpace(item.ReportType) &&
               item.ReportType.Equals(reportType, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesParticipantSearch(ParticipantItem item)
    {
        return string.IsNullOrWhiteSpace(searchText) ||
               Contains(item.DisplayName, searchText) ||
               Contains(item.UserName, searchText) ||
               Contains(item.Area, searchText) ||
               Contains(item.Position, searchText);
    }

    private bool MatchesParticipantStatus(ParticipantItem item)
    {
        return string.IsNullOrWhiteSpace(selectedParticipantStatus) ||
               string.Equals(item.Status, selectedParticipantStatus, StringComparison.OrdinalIgnoreCase);
    }

    private void SelectParticipantStatus(string status)
    {
        selectedParticipantStatus = status;
    }

    private void ClearParticipantFilters()
    {
        selectedParticipantStatus = string.Empty;
        searchText = string.Empty;
    }

    private string GetParticipantStatusFilterChipClass(string? status)
    {
        var value = status ?? string.Empty;

        var selected = string.Equals(
            selectedParticipantStatus ?? string.Empty,
            value,
            StringComparison.OrdinalIgnoreCase)
            ? " active"
            : string.Empty;

        var css = string.IsNullOrWhiteSpace(value)
            ? "all"
            : value switch
            {
                "NotStarted" => "not-started",
                "InProgress" => "in-progress",
                "Finished" => "finished",
                "FinishedWithDifferences" => "differences",
                "Expired" => "expired",
                _ => "other"
            };

        return $"pc-status-filter-chip pc-status-filter-{css}{selected}";
    }

    private static bool IsParticipantInProgress(ParticipantItem participant)
    {
        return string.Equals(participant.Status, "InProgress", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(participant.StatusLabel, "En proceso", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsParticipantFinished(ParticipantItem participant)
    {
        return string.Equals(participant.Status, "Finished", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(participant.Status, "FinishedWithDifferences", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(participant.StatusLabel, "Finalizada", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(participant.StatusLabel, "Finalizada con diferencias", StringComparison.OrdinalIgnoreCase);
    }

    private static int GetParticipantDifferenceCount(ParticipantItem participant)
    {
        return participant.DifferentItems +
               participant.MissingItems +
               participant.DamagedItems +
               participant.ExtraItems;
    }

    private decimal GetFilteredParticipantsProgress()
    {
        var expected = FilteredParticipants.Sum(x => x.ExpectedItems);

        if (expected <= 0)
        {
            return 0;
        }

        var counted = FilteredParticipants.Sum(GetParticipantReportedCount);

        return Math.Round((decimal)counted * 100 / expected, 2);
    }

    private IEnumerable<ParticipantItem> PhysicalCountBaseFilteredParticipants =>
        VisibleParticipants
            .Where(MatchesParticipantSearch);

    private IEnumerable<ParticipantItem> FilteredParticipants =>
        PhysicalCountBaseFilteredParticipants
            .Where(MatchesParticipantStatus)
            .OrderBy(x => x.DisplayName);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private HttpClient CreateApiClient()
    {
        var api = HttpClientFactory.CreateClient("NaviApi");

        api.DefaultRequestHeaders.Remove("X-Navi-User");
        api.DefaultRequestHeaders.Remove("X-Navi-Role");
        api.DefaultRequestHeaders.Remove("X-Navi-Role-Code");
        api.DefaultRequestHeaders.Remove("X-Navi-Permissions");

        api.DefaultRequestHeaders.Add("X-Navi-User", string.IsNullOrWhiteSpace(AuthSession.UserName) ? "admin" : AuthSession.UserName);
        api.DefaultRequestHeaders.Add("X-Navi-Role", string.IsNullOrWhiteSpace(AuthSession.RoleName) ? "Administrador" : AuthSession.RoleName);
        api.DefaultRequestHeaders.Add("X-Navi-Role-Code", string.IsNullOrWhiteSpace(AuthSession.RoleCode) ? "ADMIN" : AuthSession.RoleCode);
        api.DefaultRequestHeaders.Add("X-Navi-Permissions", string.Join(";", AuthSession.Permissions ?? new List<string>()));

        return api;
    }
private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var api = CreateApiClient();
            board = await api.GetFromJsonAsync<PhysicalCountBoard>($"api/physical-counts/{Id}/participants-board");
            await LoadExtraItemsAsync();
            await LoadReportedItemsAsync();
            await SelectDefaultParticipantAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar el tablero de toma física: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
private async Task GenerateParticipantsAsync()
    {
        if (!CanCreatePhysicalCount)
        {
            errorMessage = "No tienes permiso para generar participantes de la toma física.";
            return;
        }

        await ExecuteAsync(
            $"api/physical-counts/{Id}/generate-participants",
            new
            {
                ScopeMode = "Branch",
                IncludeToolsWithoutResponsible = false,
                ActionBy = AuthSession.UserName ?? "admin"
            },
            "Participantes generados correctamente según usuarios activos de la sede.");
    }
private async Task ActivateAsync()
    {
        if (!CanStartPhysicalCount)
        {
            errorMessage = "No tienes permiso para activar o iniciar tomas físicas.";
            return;
        }

        await PatchAsync(
            $"api/physical-counts/{Id}/activate",
            new
            {
                ActionBy = AuthSession.UserName ?? "admin",
                Notes = "Toma física activada desde el módulo de control."
            },
            "Toma física activada.");
    }
private async Task CloseAsync()
    {
        if (!CanClosePhysicalCount)
        {
            errorMessage = "No tienes permiso para cerrar tomas físicas.";
            return;
        }

        await PatchAsync(
            $"api/physical-counts/{Id}/close-with-participants",
            new
            {
                ActionBy = AuthSession.UserName ?? "admin",
                Notes = "Toma física cerrada desde el módulo de control.",
                ForceClose = true
            },
            "Toma física cerrada correctamente.");
    }
private async Task StartParticipantAsync(Guid participantId)
    {
        var participant = (board?.Participants ?? new()).FirstOrDefault(x => x.Id == participantId);

        if (participant is null || !CanStartParticipant(participant))
        {
            errorMessage = "No tienes permiso para iniciar este participante.";
            return;
        }

        await PatchAsync(
            $"api/physical-counts/participants/{participantId}/start",
            new
            {
                ActionBy = AuthSession.UserName ?? "admin"
            },
            "Participante iniciado.");
    }
private async Task FinishParticipantAsync(Guid participantId)
    {
        var participant = (board?.Participants ?? new()).FirstOrDefault(x => x.Id == participantId);

        if (participant is null || !CanFinishParticipant(participant))
        {
            errorMessage = "No tienes permiso para finalizar este participante.";
            return;
        }

        await PatchAsync(
            $"api/physical-counts/participants/{participantId}/finish",
            new
            {
                ActionBy = AuthSession.UserName ?? "admin",
                Observation = "Finalizado desde administración."
            },
            "Participante finalizado.");
    }





    private string GetReportedItemsUrl()
    {
        if (selectedPending is not null)
        {
            return $"/physical-counts/{Id}/reported-items?participantId={selectedPending.Id}";
        }

