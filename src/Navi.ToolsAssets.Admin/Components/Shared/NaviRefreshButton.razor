@using Microsoft.AspNetCore.Components

<button @attributes="AdditionalAttributes"
        type="button"
        class="@CssClass"
        disabled="@(Disabled || Loading)"
        title="@Title"
        aria-label="@AriaLabel"
        aria-busy="@Loading"
        data-ntx-icon-only="true"
        data-ntx-tone="refresh"
        @onclick="OnClick">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path class="navi-refresh-icon-button__orbit"
              d="M20 12a8 8 0 1 1-2.34-5.66" />
        <path class="navi-refresh-icon-button__arrow"
              d="M20 4v6h-6" />
    </svg>
</button>

@code {
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string Title { get; set; } = "Actualizar";
    [Parameter] public string AriaLabel { get; set; } = "Actualizar";
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass =>
        string.Join(
            " ",
            new[]
            {
                "navi-refresh-icon-button",
                Loading ? "is-loading" : null,
                string.IsNullOrWhiteSpace(Class) ? null : Class.Trim()
            }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
