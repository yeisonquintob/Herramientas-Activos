    private static IReadOnlyList<ConsultApprovedQuotationV139>
        GetConsultApprovedQuotationsV139(
            ConsultationItem item)
    {
        var root =
            GetRawRootElement(item);

        var quotations =
            GetArrayProperty(
                root,
                "Quotations",
                "quotations");

        if (
            quotations.ValueKind
            != JsonValueKind.Array)
        {
            return Array.Empty<
                ConsultApprovedQuotationV139>();
        }

        var all =
            quotations
                .EnumerateArray()
                .Where(
                    quotation =>
                        quotation.ValueKind
                        == JsonValueKind.Object)
                .Select(
                    quotation =>
                        quotation.Clone())
                .ToList();

        var selected =
            all
                .Where(
                    quotation =>
                        GetJsonBoolean(
                            quotation,
                            "Selected",
                            "selected"))
                .ToList();

        if (
            selected.Count == 0
            && all.Count == 1)
        {
            selected = all;
        }

        var result =
            new List<
                ConsultApprovedQuotationV139>();

        foreach (
            var quotation
            in selected)
        {
            var line =
                GetRelatedLineElement(
                    item,
                    quotation);

            var price =
                GetConsultJsonDecimalV139(
                    quotation,
                    "PriceBeforeVat",
                    "priceBeforeVat",
                    "PriceBeforeTax",
                    "priceBeforeTax",
                    "Price",
                    "price",
                    "Amount",
                    "amount");

            result.Add(
                new ConsultApprovedQuotationV139(
                    FirstNonBlank(
                        GetJsonText(
                            line,
                            "ToolName",
                            "toolName",
                            "ItemName",
                            "itemName",
                            "Name",
                            "name"),
                        GetJsonText(
                            quotation,
                            "ToolName",
                            "toolName",
                            "ItemName",
                            "itemName"),
                        item.AssetName),
                    FirstNonBlank(
                        GetJsonText(
                            quotation,
                            "Provider",
                            "provider",
                            "Supplier",
                            "supplier"),
                        item.Provider),
                    FormatConsultJsonDateV139(
                        GetJsonText(
                            quotation,
                            "QuotationDate",
                            "quotationDate",
                            "Date",
                            "date")),
                    GetJsonText(
                        quotation,
                        "DeliveryTime",
                        "deliveryTime",
                        "Delivery",
                        "delivery"),
                    price.HasValue
                        ? FormatMoney(
                            price.Value)
                        : selected.Count == 1
                            ? FormatMoney(
                                item.EstimatedCost)
                            : "—"));
        }

        return result;
    }

    private static decimal?
        GetConsultJsonDecimalV139(
            JsonElement element,
            params string[] names)
    {
        var value =
            GetJsonText(
                element,
                names);

        if (
            string.IsNullOrWhiteSpace(
                value))
        {
            return null;
        }

        if (
            decimal.TryParse(
                value,
                NumberStyles.Any,
                CultureInfo.InvariantCulture,
                out var invariant))
        {
            return invariant;
        }

        if (
            decimal.TryParse(
                value,
                NumberStyles.Any,
                CultureInfo.GetCultureInfo(
                    "es-CO"),
                out var colombian))
        {
            return colombian;
        }

        return null;
    }

    private static string
        FormatConsultJsonDateV139(
            string? value)
    {
        if (
            string.IsNullOrWhiteSpace(
                value))
        {
            return "—";
        }

        if (
            DateTimeOffset.TryParse(
                value,
                CultureInfo.InvariantCulture,
                DateTimeStyles.AssumeUniversal,
                out var offset))
        {
            return offset
                .ToLocalTime()
                .ToString(
                    "dd/MM/yyyy",
                    CultureInfo.InvariantCulture);
        }

        if (
            DateTime.TryParse(
                value,
                CultureInfo.InvariantCulture,
                DateTimeStyles.AssumeLocal,
                out var date))
        {
            return date.ToString(
                "dd/MM/yyyy",
                CultureInfo.InvariantCulture);
        }

        return value;
    }

