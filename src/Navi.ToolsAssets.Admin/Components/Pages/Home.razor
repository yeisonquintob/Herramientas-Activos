            var client = HttpClientFactory.CreateClient("NaviApi");

            dashboard = await client.GetFromJsonAsync<ExecutiveDashboard>("api/dashboard/executive") ?? new ExecutiveDashboard
            {
                GeneratedAt = DateTime.Now
            };

            await LoadDashboardFilterDataAsync(client);
            ApplyLocalDashboardFilters();

            operationCosts = await LoadDashboardOperationCostsAsync(client);
            latestOpenPhysicalCount = await LoadLatestOpenPhysicalCountAsync(client);
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar el dashboard. Valida que la API esté activa en http://localhost:5218. Detalle: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }




    // NAVI DASHBOARD WEB FILTERS START

    private async Task ApplyDashboardFiltersAsync()
    {
        try
        {
            isLoading = true;

            ApplyLocalDashboardFilters();

            var client =
                HttpClientFactory.CreateClient(
                    "NaviApi");

            operationCosts =
                await LoadDashboardOperationCostsAsync(
                    client);
        }
        finally
        {
            isLoading = false;
        }

        StateHasChanged();
