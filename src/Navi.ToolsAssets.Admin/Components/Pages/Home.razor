@page "/"
@page "/dashboard"
@rendermode InteractiveServer

@using System.Globalization
@using System.Net.Http.Json
@using Navi.ToolsAssets.Admin.Components.Shared
@using System.Text.Json
@using System.Text.RegularExpressions
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Dashboard - NAVI</PageTitle>

<PermissionGuard Permission="Dashboard.View" ModuleName="Dashboard">

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (isLoading && dashboard is null)
{
    <div class="alert alert-info" role="status" aria-busy="true">Cargando dashboard...</div>
}
else if (dashboard is not null)
{
    <section class="dash-board navi-dashboard-web-v22">

        <NaviPageHero
            Pill="DASHBOARD"
            Title="Dashboard"
            Description="Vista ejecutiva de inventario, disponibilidad, mantenimiento, documentación y control operativo." />

        @* NAVI DASHBOARD CANONICAL KPI STANDARD V72 START *@

<NaviKpiToolbar
    Class="navi-dashboard-v22-overview
           navi-dashboard-standard-kpi-toolbar"
    Refresh="LoadDashboardAsync"
    IsRefreshing="isLoading"
    RefreshTitle="Actualizar Dashboard"
    RefreshAriaLabel="Actualizar información del Dashboard">

    <NaviKpiGrid
        Columns="6"
        Compact="true"
        Dividers="true"
        Class="navi-dashboard-v22-kpis
               navi-dashboard-standard-kpi-grid">

        <NaviKpiCard
            Title="Inventario"
            Value="@FormatDashboardNumber(dashboard.Summary.TotalTools)"
            Description="Herramientas y activos visibles"
            Tone="neutral"
            Compact="true"
            Class="metric-inventory">

            <IconContent>
                <NaviKpiIcon Name="inventory" />
            </IconContent>

        </NaviKpiCard>

        <NaviKpiCard
            Title="Disponibles"
            Value="@FormatDashboardNumber(dashboard.Summary.AvailableTools)"
            Description="Listas para asignación"
            Tone="positive"
            Compact="true"
            Class="metric-available">

            <IconContent>
                <NaviKpiIcon Name="check" />
            </IconContent>

        </NaviKpiCard>

        <NaviKpiCard
            Title="En uso"
            Value="@FormatDashboardNumber(GetInUseTotal())"
            Description="Asignadas o prestadas"
            Tone="soft"
            Compact="true"
            Class="metric-use">

            <IconContent>
                <NaviKpiIcon Name="transfer" />
            </IconContent>

        </NaviKpiCard>

        <NaviKpiCard
            Title="Mantenimiento"
            Value="@FormatDashboardNumber(dashboard.Summary.InMaintenanceTools)"
            Description="En proceso técnico"
            Tone="warning"
            Compact="true"
            Class="metric-maintenance">

            <IconContent>
                <NaviKpiIcon Name="wrench" />
            </IconContent>

        </NaviKpiCard>

        <NaviKpiCard
            Title="Por validar"
            Value="@FormatDashboardNumber(dashboard.Summary.PendingValidationTools)"
            Description="Pendientes de revisión"
            Tone="warning"
            Compact="true"
            Class="metric-pending">

            <IconContent>
                <NaviKpiIcon Name="clock" />
            </IconContent>

        </NaviKpiCard>

        <NaviKpiCard
            Title="Alertas"
            Value="@FormatDashboardNumber(GetDashboardAttentionTotal())"
            Description="Requieren atención"
            Tone="danger"
            Compact="true"
            Class="metric-alerts">

            <IconContent>
                <NaviKpiIcon Name="alert" />
            </IconContent>

        </NaviKpiCard>

    </NaviKpiGrid>

</NaviKpiToolbar>

@* NAVI DASHBOARD CANONICAL KPI STANDARD V72 END *@

        <section class="navi-dashboard-v22-context"
                 aria-label="Alcance actual del Dashboard">

            <div>
                <span class="navi-dashboard-v22-context-dot"
                      aria-hidden="true">
                </span>

                <div>
                    <strong>@GetDashboardScopeTitle()</strong>
                    <small>@GetDashboardScopeDescription()</small>
                </div>
            </div>

            <span>
                Actualizado:
                @FormatDateTime(dashboard.GeneratedAt)
            </span>
        </section>

        <section class="navi-dashboard-v22-filter-panel"
                 aria-label="Filtros del Dashboard">

            <label class="navi-dashboard-v22-field">
                <span>Sede</span>

                <input list="dashboardBranchOptions"
                       @bind="filterBranchCode"
                       @bind:event="oninput"
                       placeholder="Todas / escribe o selecciona una sede..." name="navi-home-field-001" />

                <datalist id="dashboardBranchOptions">
                    @foreach (var branch in dashboardBranches)
                    {
                        @if (!string.IsNullOrWhiteSpace(branch.Code))
                        {
                            <option value="@branch.Code">
                                @branch.Label
                            </option>
                        }

                        @if (!string.IsNullOrWhiteSpace(branch.Name) &&
                             !string.Equals(
                                 branch.Name,
                                 branch.Code,
                                 StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@branch.Name">
                                @branch.Label
                            </option>
                        }
                    }
                </datalist>
            </label>

            <label class="navi-dashboard-v22-field">
                <span>Estado operativo</span>

                <select @bind="filterOperationalStatus" name="navi-home-field-002">
                    <option value="">Todos los estados</option>

                    @foreach (var item in dashboardStatusFilters)
                    {
                        <option value="@item.Value">
                            @item.Text
                        </option>
                    }
                </select>
            </label>

            <label class="navi-dashboard-v22-field
                          navi-dashboard-v22-search-field">

                <span>Buscar</span>

                <div>
                    <span aria-hidden="true"></span>

                    <input @bind="filterText"
                           @bind:event="oninput"
                           placeholder="Código, serial, activo, responsable..." name="navi-home-field-003" />
                </div>
            </label>

            <div class="navi-dashboard-v22-filter-actions">
                <button type="button"
                        class="navi-dashboard-v22-filter-button"
                        disabled="@isLoading"
                        @onclick="ApplyDashboardFiltersAsync" data-ntx-tone="operation">
                    Filtrar
                </button>

                <button type="button"
                        class="navi-dashboard-v22-clear-button"
                        disabled="@isLoading"
                        @onclick="ClearDashboardFiltersAsync" data-ntx-tone="secondary">
                    Limpiar
                </button>
            </div>
        </section>

        <section class="navi-dashboard-v22-visual-grid"
                 aria-label="Análisis visual del Dashboard">

            <article class="navi-dashboard-v22-card
                            navi-dashboard-v22-branch-card">

                <header class="navi-dashboard-v22-card-header">
                    <div>
                        <span>INVENTARIO POR SEDE</span>
                        <h2>Herramientas por sede</h2>
                        <p>
                            Comparación de inventario total,
                            asignado y disponible.
                        </p>
                    </div>

                    <strong>
                        @dashboard.ToolsByBranch.Count sedes
                    </strong>
                </header>

                @if (dashboard.ToolsByBranch.Count == 0)
                {
                    <div class="navi-dashboard-v22-empty">
                        No hay información por sede para los filtros aplicados.
                    </div>
                }
                else
                {
                    <div class="navi-dashboard-v22-bar-chart">
                        <div class="navi-dashboard-v22-axis">
                            @foreach (var mark in GetBranchAxisLabels())
                            {
                                <span>@mark</span>
                            }
                        </div>

                        <div class="navi-dashboard-v22-bar-scroll">
                            <div class="navi-dashboard-v22-bar-groups"
     style="@GetBranchChartGridStyle()">
                                @foreach (var item in GetBranchChartItems())
                                {
                                    var total = item.Branch.Total;
                                    var assigned = GetBranchAssigned(item.Branch);
                                    var available = GetBranchAvailable(item.Branch);

                                    <div class="navi-dashboard-v22-bar-group"
                                         title="@GetDashboardBranchDisplayName(item.Branch)">

                                        <div class="navi-dashboard-v22-bar-set">
                                            <span class="navi-dashboard-v22-bar total"
                                                  style="@GetBranchTripleBarStyle(total)"
                                                  title="@($"Total: {total}")">
                                                <strong>@total</strong>
                                            </span>

                                            <span class="navi-dashboard-v22-bar assigned"
                                                  style="@GetBranchTripleBarStyle(assigned)"
                                                  title="@($"Asignadas: {assigned}")">
                                                <strong>@assigned</strong>
                                            </span>

                                            <span class="navi-dashboard-v22-bar available"
                                                  style="@GetBranchTripleBarStyle(available)"
                                                  title="@($"Disponibles: {available}")">
                                                <strong>@available</strong>
                                            </span>
                                        </div>

                                        <span>@item.Branch.BranchCode</span>

                                        <small>
                                            @ShortName(item.Branch.BranchName)
                                        </small>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="navi-dashboard-v22-chart-legend">
                        <span>
                            <i class="total"></i>
                            Total
                        </span>

                        <span>
                            <i class="assigned"></i>
                            Asignadas
                        </span>

                        <span>
                            <i class="available"></i>
                            Disponibles
                        </span>
                    </div>
                }
            </article>

            <article class="navi-dashboard-v22-card
                            navi-dashboard-v22-ring-card">

                <header class="navi-dashboard-v22-card-header compact">
                    <div>
                        <span>OPERACIÓN</span>
                        <h2>Estado operativo</h2>
                        <p>Distribución actual del inventario.</p>
                    </div>
                </header>

                <div class="navi-dashboard-v22-ring-layout">
                    <div class="navi-dashboard-v22-ring">
                        <svg viewBox="0 0 42 42"
                             role="img"
                             aria-label="Distribución por estado operativo">

                            <circle class="track"
                                    cx="21"
                                    cy="21"
                                    r="15.9155"
                                    pathLength="100">
                            </circle>

                            <circle class="segment use"
                                    cx="21"
                                    cy="21"
                                    r="15.9155"
                                    pathLength="100"
                                    style="@GetRingSegmentStyle(
                                        GetInUseTotal(),
                                        GetOperationalRingTotal(),
                                        0)">
                            </circle>

                            <circle class="segment available"
                                    cx="21"
                                    cy="21"
                                    r="15.9155"
                                    pathLength="100"
                                    style="@GetRingSegmentStyle(
                                        dashboard.Summary.AvailableTools,
                                        GetOperationalRingTotal(),
                                        GetInUseTotal())">
                            </circle>

                            <circle class="segment maintenance"
                                    cx="21"
                                    cy="21"
                                    r="15.9155"
                                    pathLength="100"
                                    style="@GetRingSegmentStyle(
                                        dashboard.Summary.InMaintenanceTools,
                                        GetOperationalRingTotal(),
                                        GetInUseTotal() +
                                        dashboard.Summary.AvailableTools)">
                            </circle>

                            <circle class="segment risk"
                                    cx="21"
                                    cy="21"
                                    r="15.9155"
                                    pathLength="100"
                                    style="@GetRingSegmentStyle(
                                        GetOperationalAlertTotal(),
                                        GetOperationalRingTotal(),
                                        GetInUseTotal() +
                                        dashboard.Summary.AvailableTools +
                                        dashboard.Summary.InMaintenanceTools)">
                            </circle>

                            <circle class="segment other"
                                    cx="21"
                                    cy="21"
                                    r="15.9155"
                                    pathLength="100"
                                    style="@GetRingSegmentStyle(
                                        GetOperationalOtherTotal(),
                                        GetOperationalRingTotal(),
                                        GetInUseTotal() +
                                        dashboard.Summary.AvailableTools +
                                        dashboard.Summary.InMaintenanceTools +
                                        GetOperationalAlertTotal())">
                            </circle>
                        </svg>

                        <div>
                            <strong>
                                @FormatDashboardNumber(
                                    dashboard.Summary.TotalTools)
                            </strong>

                            <span>activos</span>
                        </div>
                    </div>

                    <div class="navi-dashboard-v22-ring-legend">
                        <div>
                            <i class="use"></i>
                            <span>En uso</span>
                            <strong>@FormatDashboardNumber(GetInUseTotal())</strong>
                        </div>

                        <div>
                            <i class="available"></i>
                            <span>Disponibles</span>
                            <strong>
                                @FormatDashboardNumber(
                                    dashboard.Summary.AvailableTools)
                            </strong>
                        </div>

                        <div>
                            <i class="maintenance"></i>
                            <span>Mantenimiento</span>
                            <strong>
                                @FormatDashboardNumber(
                                    dashboard.Summary.InMaintenanceTools)
                            </strong>
                        </div>

                        <div>
                            <i class="risk"></i>
                            <span>Alertas</span>
                            <strong>
                                @FormatDashboardNumber(
                                    GetOperationalAlertTotal())
                            </strong>
                        </div>
                    </div>
                </div>
            </article>

            <article class="navi-dashboard-v22-card
                            navi-dashboard-v22-ring-card">

                <header class="navi-dashboard-v22-card-header compact">
                    <div>
                        <span>IDENTIFICACIÓN</span>
                        <h2>Código de activo fijo</h2>
                        <p>Cobertura del código contable.</p>
                    </div>
                </header>

                <div class="navi-dashboard-v22-ring-layout">
                    <div class="navi-dashboard-v22-ring">
                        <svg viewBox="0 0 42 42"
                             role="img"
                             aria-label="Cobertura del código de activo fijo">

                            <circle class="track"
                                    cx="21"
                                    cy="21"
                                    r="15.9155"
                                    pathLength="100">
                            </circle>

                            <circle class="segment identified"
                                    cx="21"
                                    cy="21"
                                    r="15.9155"
                                    pathLength="100"
                                    style="@GetRingSegmentStyle(
                                        dashboard.Summary.FixedAssets,
                                        GetAssetIdentificationTotal(),
                                        0)">
                            </circle>

                            <circle class="segment unidentified"
                                    cx="21"
                                    cy="21"
                                    r="15.9155"
                                    pathLength="100"
                                    style="@GetRingSegmentStyle(
                                        dashboard.Summary.ToolsWithoutFixedAssetCode,
                                        GetAssetIdentificationTotal(),
                                        dashboard.Summary.FixedAssets)">
                            </circle>
                        </svg>

                        <div>
                            <strong>
                                @GetRingPercentLabel(
                                    dashboard.Summary.FixedAssets,
                                    GetAssetIdentificationTotal())
                            </strong>

                            <span>identificados</span>
                        </div>
                    </div>

                    <div class="navi-dashboard-v22-ring-legend">
                        <div>
                            <i class="identified"></i>
                            <span>Con código</span>
                            <strong>
                                @FormatDashboardNumber(
                                    dashboard.Summary.FixedAssets)
                            </strong>
                        </div>

                        <div>
                            <i class="unidentified"></i>
                            <span>Sin código</span>
                            <strong>
                                @FormatDashboardNumber(
                                    dashboard.Summary.ToolsWithoutFixedAssetCode)
                            </strong>
                        </div>
                    </div>
                </div>
            </article>

<article class="navi-dashboard-v22-card navi-dashboard-v22-ring-card navi-dashboard-v22-life-card">
                    <header class="navi-dashboard-v22-card-header">
                        <div>
                            <span>DOCUMENTACIÓN</span>
                            <h2>Hojas de vida</h2>
                            <p>
                                Comparación entre hojas de vida completas
                                e incompletas.
                            </p>
                        </div>

                        <strong>
                            @GetDashboardLifeRecordTotal().ToString("N0")
                            total
                        </strong>
                    </header>

                    <div class="navi-dashboard-v22-ring-layout">
                        <div class="navi-dashboard-v22-ring"
                             role="img"
                             aria-label="Hojas de vida completas versus incompletas">

                            <svg viewBox="0 0 100 100"
                                 focusable="false"
                                 aria-hidden="true">

                                <circle class="track"
                                        cx="50"
                                        cy="50"
                                        r="42">
                                </circle>

                                <circle class="segment complete"
                                        cx="50"
                                        cy="50"
                                        r="42"
                                        style="@GetDashboardLifeRingSegmentStyle(GetDashboardCompleteLifeRecords(), 0)">
                                </circle>

                                <circle class="segment incomplete"
                                        cx="50"
                                        cy="50"
                                        r="42"
                                        style="@GetDashboardLifeRingSegmentStyle(GetDashboardIncompleteLifeRecords(), GetDashboardCompleteLifeRecords())">
                                </circle>
                            </svg>

                            <div>
                                <strong>
                                    @GetDashboardLifeCompletionPercentLabel()
                                </strong>

                                <span>completas</span>
                            </div>
                        </div>

                        <div class="navi-dashboard-v22-ring-legend navi-dashboard-v22-life-legend">
                            <div>
                                <i class="complete"></i>

                                <span>
                                    Completas
                                    <small>Información registrada</small>
                                </span>

                                <strong>
                                    @GetDashboardCompleteLifeRecords().ToString("N0")

                                    <small>
                                        @GetDashboardLifePercentLabel(GetDashboardCompleteLifeRecords())
                                    </small>
                                </strong>
                            </div>

                            <div>
                                <i class="incomplete"></i>

                                <span>
                                    Incompletas
                                    <small>Pendientes de completar</small>
                                </span>

                                <strong>
                                    @GetDashboardIncompleteLifeRecords().ToString("N0")

                                    <small>
                                        @GetDashboardLifePercentLabel(GetDashboardIncompleteLifeRecords())
                                    </small>
                                </strong>
                            </div>
                        </div>
                    </div>
                </article>

            <article class="navi-dashboard-v22-card
                            navi-dashboard-v22-cost-card">

                <header class="navi-dashboard-v22-card-header compact">
                    <div>
                        <span>COSTOS OPERATIVOS</span>
                        <h2>Mantenimiento vs compras</h2>
                        <p>Participación sobre el valor consultado.</p>
                    </div>

                    <strong>
                        @FormatDashboardMoneyCompact(
                            GetOperationsCostTotal())
                    </strong>
                </header>

                <div class="navi-dashboard-v22-cost-list">
                    <div class="navi-dashboard-v22-cost-item">
                        <div>
                            <span>Mantenimientos</span>
                            <strong>
                                @FormatDashboardMoney(
                                    operationCosts.MaintenanceCost)
                            </strong>
                        </div>

                        <div class="navi-dashboard-v22-cost-track">
                            <span class="maintenance"
                                  style="@GetCostBarStyle(
                                      operationCosts.MaintenanceCost)">
                            </span>
                        </div>

                        <small>
                            @GetOperationsCostTotalPercentLabel(
                                operationCosts.MaintenanceCost)
                        </small>
                    </div>

                    <div class="navi-dashboard-v22-cost-item">
                        <div>
                            <span>Compras</span>
                            <strong>
                                @FormatDashboardMoney(
                                    operationCosts.PurchaseCost)
                            </strong>
                        </div>

                        <div class="navi-dashboard-v22-cost-track">
                            <span class="purchase"
                                  style="@GetCostBarStyle(
                                      operationCosts.PurchaseCost)">
                            </span>
                        </div>

                        <small>
                            @GetOperationsCostTotalPercentLabel(
                                operationCosts.PurchaseCost)
                        </small>
                    </div>
                </div>

                <div class="navi-dashboard-v22-cost-summary">
                    <span>Total consultado</span>

                    <strong>
                        @FormatDashboardMoney(
                            GetOperationsCostTotal())
                    </strong>
                </div>
            </article>
        </section>

        <section class="navi-dashboard-v22-detail-grid">

            <article class="navi-dashboard-v22-card
                            navi-dashboard-v22-table-card">

                <header class="navi-dashboard-v22-card-header">
                    <div>
                        <span>CONTROL POR SEDE</span>
                        <h2>Resumen por sede</h2>
                        <p>
                            Asignación, pendientes, diferencias,
                            mantenimiento y cobertura.
                        </p>
                    </div>

                    <strong>
                        @dashboard.ToolsByBranch.Count sedes
                    </strong>
                </header>

                @if (dashboard.ToolsByBranch.Count == 0)
                {
                    <div class="navi-dashboard-v22-empty">
                        No hay sedes para los filtros seleccionados.
                    </div>
                }
                else
                {
                    <div class="navi-dashboard-v22-table-scroll">
                        <table>
                            <thead>
                                <tr>
                                    <th>Sede</th>
                                    <th>Total</th>
                                    <th>Asignadas</th>
                                    <th>Disponibles</th>
                                    <th>Pendientes</th>
                                    <th>Diferencias</th>
                                    <th>Mantenimiento</th>
                                    <th>Daños</th>
                                    <th>Cobertura</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in dashboard.ToolsByBranch)
                                {
                                    var assigned = GetBranchAssigned(item);
                                    var available = GetBranchAvailable(item);
                                    var pending = GetBranchPending(item);
                                    var difference = GetBranchDifferences(item);
                                    var maintenance = GetBranchMaintenance(item);
                                    var damaged = GetBranchDamaged(item);
                                    var percent = GetBranchAssignedPercent(item);

                                    <tr>
                                        <td>
                                            <strong class="navi-dashboard-v22-branch-label">@GetDashboardBranchDisplayName(item)</strong>
                                        </td>

                                        <td>@item.Total</td>
                                        <td>@assigned</td>
                                        <td>@available</td>

                                        <td>
                                            <span class="status warning">
                                                @pending
                                            </span>
                                        </td>

                                        <td>
                                            <span class="status neutral">
                                                @difference
                                            </span>
                                        </td>

                                        <td>
                                            <span class="status maintenance">
                                                @maintenance
                                            </span>
                                        </td>

                                        <td>
                                            <span class="status danger">
                                                @damaged
                                            </span>
                                        </td>

                                        <td>
                                            <div class="navi-dashboard-v22-progress">
                                                <span style="@GetProgressStyle(percent)">
                                                </span>
                                            </div>

                                            <small>@percent%</small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </article>

            <div class="navi-dashboard-v22-side-stack">

                <article class="navi-dashboard-v22-card
                                navi-dashboard-v22-maintenance-card">

                    <header class="navi-dashboard-v22-card-header compact">
                        <div>
                            <span>MANTENIMIENTO</span>
                            <h2>Seguimiento técnico</h2>
                            <p>Actividad y necesidades registradas.</p>
                        </div>
                    </header>

                    <div class="navi-dashboard-v22-mini-metrics">
                        <div>
                            <span>Hoy</span>
                            <strong>
                                @FormatDashboardNumber(
                                    dashboard.MaintenanceSummary.Today)
                            </strong>
                        </div>

                        <div>
                            <span>Este mes</span>
                            <strong>
                                @FormatDashboardNumber(
                                    dashboard.MaintenanceSummary.ThisMonth)
                            </strong>
                        </div>

                        <div>
                            <span>Requieren atención</span>
                            <strong>
                                @FormatDashboardNumber(
                                    dashboard.Summary.RequiresMaintenance)
                            </strong>
                        </div>
                    </div>

                    <div class="navi-dashboard-v22-maintenance-progress">
                        <div>
                            <span>Inventario en mantenimiento</span>

                            <strong>
                                @GetRingPercentLabel(
                                    dashboard.Summary.InMaintenanceTools,
                                    dashboard.Summary.TotalTools)
                            </strong>
                        </div>

                        <div>
                            <span style="@GetProgressStyle(
                                (int)GetRingPercentValue(
                                    dashboard.Summary.InMaintenanceTools,
                                    dashboard.Summary.TotalTools))">
                            </span>
                        </div>
                    </div>
                </article>

                <article class="navi-dashboard-v22-card
                                navi-dashboard-v22-physical-card">

                    <header class="navi-dashboard-v22-card-header compact">
                        <div>
                            <span>CONTROL FÍSICO</span>
                            <h2>Toma física</h2>
                            <p>@GetLatestPhysicalCountText()</p>
                        </div>
                    </header>

                    @if (latestOpenPhysicalCount is not null)
                    {
