@page "/login"
@rendermode InteractiveServer

@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Navi.ToolsAssets.Admin.Services.Auth

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject WebAuthSessionService AuthSession
@inject IJSRuntime JS

<PageTitle>Ingreso - Navitrans Herramientas y Activos</PageTitle>

<div class="navi-admin-login-v2">
    <main class="navi-admin-login-v2__access">
        <div class="navi-admin-login-v2__content">
            <header class="navi-admin-login-v2__brand"
                    aria-label="Navitrans 40 años">
                <div class="navi-admin-login-v2__anniversary"
                     aria-hidden="true">
                    <strong>40</strong>

                    <span>años</span>
                </div>

                <span class="navi-admin-login-v2__brand-divider"
                      aria-hidden="true">
                </span>

                <div class="navi-admin-login-v2__brand-name">
                    <strong>Navitrans</strong>
                </div>
            </header>

            <section class="navi-admin-login-v2__form-section"
                     aria-labelledby="navi-admin-login-title">
                <header class="navi-admin-login-v2__heading">
                    <span class="navi-admin-login-v2__eyebrow">
                        HERRAMIENTAS Y ACTIVOS
                    </span>

                    <h1 id="navi-admin-login-title">
                        Bienvenido
                    </h1>

                    <p>
                        Ingresa tus credenciales para acceder a
                        la consola de administración.
                    </p>
                </header>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="@LoginAlertCssClass"
                         role="alert"
                         aria-live="assertive"
                         aria-atomic="true">
                        <div class="navi-admin-login-v2__alert-copy">
                            <strong>@errorTitle</strong>

                            <span>@errorMessage</span>
                        </div>

                        <button type="button"
                                class="navi-admin-login-v2__alert-close"
                                aria-label="Cerrar mensaje"
                                title="Cerrar mensaje"
                                @onclick="DismissLoginAlert">
                            <span aria-hidden="true">×</span>
                        </button>
                    </div>
                }
<EditForm Model="loginModel"
                          OnValidSubmit="LoginAsync">
                    <div class="navi-admin-login-v2__form">
                        <div class="navi-admin-login-v2__field">
                            <label for="naviAdminUser">
                                Documento o usuario
                            </label>

                            <div class="navi-admin-login-v2__input-frame">
                                <InputText id="naviAdminUser"
                                           class="navi-admin-login-v2__input"
                                           @bind-Value="loginModel.UserName"
                                           autocomplete="username"
                                           autocapitalize="none"
                                           spellcheck="false"
                                           placeholder="Número de documento o usuario"
                                           aria-label="Documento o usuario"
                                           autofocus />
                            </div>
                        </div>

                        <div class="navi-admin-login-v2__field">
                            <label for="naviAdminPassword">
                                Contraseña
                            </label>

                            <div class="navi-admin-login-v2__input-frame
                                        navi-admin-login-v2__input-frame--password">
                                <InputText id="naviAdminPassword"
                                           class="navi-admin-login-v2__input"
                                           type="@passwordInputType"
                                           @bind-Value="loginModel.Password"
                                           autocomplete="current-password"
                                           placeholder="Contraseña"
                                           aria-label="Contraseña" />

                                <button type="button"
                                        class="navi-admin-login-v2__password-toggle"
                                        aria-label="@(showPassword
                                            ? "Ocultar contraseña"
                                            : "Mostrar contraseña")"
                                        aria-pressed="@showPassword"
                                        title="@(showPassword
                                            ? "Ocultar contraseña"
                                            : "Mostrar contraseña")"
                                        data-ntx-tone="secondary"
                                        @onclick="TogglePassword">
                                    @if (showPassword)
                                    {
                                        <svg class="navi-admin-login-v2__password-icon"
                                             viewBox="0 0 24 24"
                                             aria-hidden="true"
                                             focusable="false">
                                            <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6S2.5 12 2.5 12Z"></path>
                                            <circle cx="12"
                                                    cy="12"
                                                    r="2.75"></circle>
                                            <path class="navi-admin-login-v2__password-slash"
                                                  d="M4 4l16 16"></path>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg class="navi-admin-login-v2__password-icon"
                                             viewBox="0 0 24 24"
                                             aria-hidden="true"
                                             focusable="false">
                                            <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6S2.5 12 2.5 12Z"></path>
                                            <circle cx="12"
                                                    cy="12"
                                                    r="2.75"></circle>
                                        </svg>
                                    }
                                </button>
                            </div>
                        </div>

                        <label class="navi-admin-login-v2__remember
                                      @(loginModel.RememberCredentials
                                          ? "is-checked"
                                          : string.Empty)"
                               for="rememberCredentials">
                            <InputCheckbox id="rememberCredentials"
                                           class="navi-admin-login-v2__checkbox"
                                           @bind-Value="loginModel.RememberCredentials" />

                            <span class="navi-admin-login-v2__checkbox-visual"
                                  aria-hidden="true">
                                <svg viewBox="0 0 20 20"
                                     focusable="false">
                                    <path d="M4 10.5 8.2 14.5 16 6"></path>
                                </svg>
                            </span>

                            <span class="navi-admin-login-v2__remember-copy">
                                <strong>Recordar acceso</strong>

                                <small>
                                    Guardar las credenciales en este equipo.
                                </small>
                            </span>
                        </label>

                        <button type="submit"
                                class="navi-admin-login-v2__submit"
                                disabled="@isLoading"
                                data-ntx-tone="affirmative">
                            @if (isLoading)
                            {
                                <span class="navi-admin-login-v2__loading"
                                      aria-hidden="true">
                                </span>

                                <span>Ingresando...</span>
                            }
                            else
                            {
                                <span>Ingresar</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </section>

            <footer class="navi-admin-login-v2__footer">
                <div class="navi-admin-login-v2__footer-mark"
                     aria-hidden="true">
                    N
                </div>

                <div>
                    <strong>Navitrans</strong>
                    <span>Herramientas y Activos · Consola de administración</span>
                </div>
            </footer>
        </div>
    </main>

    <aside class="navi-admin-login-v2__media"
           aria-hidden="true">
        <LoginBrandMedia />
    </aside>
</div>

@code {
    private const string StorageKey =
        "navi-auth-session";

    private const string RememberEnabledKey =
        "navi-login-remember-enabled";

    private const string RememberUserNameKey =
        "navi-login-remember-username";

    private const string RememberPasswordKey =
        "navi-login-remember-password";

    private LoginFormModel loginModel = new();

    private bool isLoading;
    private bool showPassword;
    private string? errorMessage;

    private string errorTitle = "No fue posible ingresar";

    private string errorTone = "danger";

    private string LoginAlertCssClass =>
        $"navi-admin-login-v2__alert navi-admin-login-v2__alert--{errorTone}";

    private string passwordInputType =>
        showPassword
            ? "text"
            : "password";

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (AuthSession.IsAuthenticated)
        {
            Navigation.NavigateTo(
                NaviPermissionRouteService.GetStartRoute(
                    AuthSession),
                replace: true);

            return;
        }

        try
        {
            var json =
                await JS.InvokeAsync<string?>(
                    "localStorage.getItem",
                    StorageKey);

            if (!string.IsNullOrWhiteSpace(json))
            {
                var user =
                    JsonSerializer.Deserialize<AuthSessionUser>(
                        json,
                        new JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true
                        });

                if (user is not null &&
                    !string.IsNullOrWhiteSpace(
                        user.UserName))
                {
                    AuthSession.Login(user);

                    Navigation.NavigateTo(
                        NaviPermissionRouteService
                            .GetStartRoute(AuthSession),
                        replace: true);

                    return;
                }
            }

            var rememberEnabled =
                await JS.InvokeAsync<string?>(
                    "localStorage.getItem",
                    RememberEnabledKey);

            if (string.Equals(
                    rememberEnabled,
                    "true",
                    StringComparison.OrdinalIgnoreCase))
            {
                loginModel.RememberCredentials = true;

                loginModel.UserName =
                    await JS.InvokeAsync<string?>(
                        "localStorage.getItem",
                        RememberUserNameKey);

                loginModel.Password =
                    await JS.InvokeAsync<string?>(
                        "localStorage.getItem",
                        RememberPasswordKey);

                StateHasChanged();
            }
        }
        catch
        {
            await JS.InvokeVoidAsync(
                "localStorage.removeItem",
                StorageKey);
        }
    }

    private async Task LoginAsync()
    {
        DismissLoginAlert();

        var normalizedUserName =
            loginModel.UserName?.Trim();

        if (string.IsNullOrWhiteSpace(
                normalizedUserName))
        {
            SetLoginAlert(
                "Completa la información",
                "Ingresa tu documento o nombre de usuario.",
                "warning");

            return;
        }

        if (string.IsNullOrWhiteSpace(
                loginModel.Password))
        {
            SetLoginAlert(
                "Completa la información",
                "Ingresa la contraseña asociada a tu usuario.",
                "warning");

            return;
        }

        isLoading = true;

        try
        {
            var api =
                HttpClientFactory.CreateClient(
                    "NaviApi");

            var response =
                await api.PostAsJsonAsync(
                    "api/auth/login",
                    new
                    {
                        userName =
                            normalizedUserName,

                        password =
                            loginModel.Password
                    });

            if (!response.IsSuccessStatusCode)
            {
                var apiMessage =
                    await ReadLoginErrorAsync(
                        response);

                var alert =
                    BuildLoginError(
                        response.StatusCode,
                        apiMessage);

                SetLoginAlert(
                    alert.Title,
                    alert.Message,
                    alert.Tone);

                loginModel.Password =
                    null;

                return;
            }

            var user =
                await response.Content
                    .ReadFromJsonAsync<
                        AuthSessionUser>();

            if (user is null)
            {
                SetLoginAlert(
                    "Respuesta incompleta",
                    "El servidor validó las credenciales, "
                    + "pero no devolvió la información de la sesión.",
                    "danger");

                return;
            }

            AuthSession.Login(
                user);

            if (loginModel.RememberCredentials)
            {
                await JS.InvokeVoidAsync(
                    "localStorage.setItem",
                    RememberEnabledKey,
                    "true");

                await JS.InvokeVoidAsync(
                    "localStorage.setItem",
                    RememberUserNameKey,
                    normalizedUserName);
            }
            else
            {
                await JS.InvokeVoidAsync(
                    "localStorage.removeItem",
                    RememberEnabledKey);

                await JS.InvokeVoidAsync(
                    "localStorage.removeItem",
                    RememberUserNameKey);
            }

            /*
             * Nunca se conserva la contraseña en localStorage.
             * También se elimina el valor de versiones anteriores.
             */
            await JS.InvokeVoidAsync(
                "localStorage.removeItem",
                "navi-login-remember-password");

            var json =
                JsonSerializer.Serialize(
                    user);

            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                StorageKey,
                json);

            loginModel.Password =
                null;

            Navigation.NavigateTo(
                NaviPermissionRouteService
                    .GetStartRoute(
                        AuthSession),
                replace: true);
        }
        catch (HttpRequestException)
        {
            SetLoginAlert(
                "Servicio no disponible",
                "No fue posible comunicarse con el servicio "
                + "de autenticación. Verifica que la API esté activa.",
                "danger");
        }
        catch (TaskCanceledException)
        {
            SetLoginAlert(
                "La solicitud tardó demasiado",
                "El servicio de autenticación no respondió a tiempo. "
                + "Espera un momento e inténtalo nuevamente.",
                "warning");
        }
        catch
        {
            SetLoginAlert(
                "Ocurrió un error inesperado",
                "No fue posible completar el inicio de sesión. "
                + "Inténtalo nuevamente.",
                "danger");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetLoginAlert(
        string title,
        string message,
        string tone)
    {
        errorTitle =
            string.IsNullOrWhiteSpace(title)
                ? "No fue posible ingresar"
                : title.Trim();

        errorMessage =
            string.IsNullOrWhiteSpace(message)
                ? "Verifica la información e inténtalo nuevamente."
                : message.Trim();

        errorTone =
            string.Equals(
                tone,
                "warning",
                StringComparison.OrdinalIgnoreCase)
                ? "warning"
                : "danger";
    }

    private void DismissLoginAlert()
    {
        errorMessage = null;
        errorTitle = "No fue posible ingresar";
        errorTone = "danger";
    }

    private static async Task<string?>
        ReadLoginErrorAsync(
            HttpResponseMessage response)
    {
        string rawContent;

        try
        {
            rawContent =
                await response.Content
                    .ReadAsStringAsync();
        }
        catch
        {
            return null;
        }

        if (string.IsNullOrWhiteSpace(
                rawContent))
        {
            return null;
        }

        try
        {
            using var document =
                JsonDocument.Parse(
                    rawContent);

            if (
                document.RootElement.ValueKind
                ==
                JsonValueKind.Object
            )
            {
                foreach (
                    var property
                    in document.RootElement
                        .EnumerateObject()
                )
                {
                    if (
                        string.Equals(
                            property.Name,
                            "message",
                            StringComparison
                                .OrdinalIgnoreCase)
                        &&
                        property.Value.ValueKind
                        ==
                        JsonValueKind.String
                    )
                    {
                        return property.Value
                            .GetString()
                            ?.Trim();
                    }
                }
            }
        }
        catch (JsonException)
        {
            /*
             * La respuesta no tenía estructura JSON.
             * No se muestra el contenido técnico al usuario.
             */
        }

        return null;
    }

    private static (
        string Title,
        string Message,
        string Tone)
        BuildLoginError(
            HttpStatusCode statusCode,
            string? apiMessage)
    {
        return statusCode switch
        {
            HttpStatusCode.BadRequest =>
                (
                    "Revisa la información",
                    NormalizeApiMessage(
                        apiMessage)
                    ??
                    "Completa correctamente el usuario "
                    + "y la contraseña.",
                    "warning"
                ),

            HttpStatusCode.Unauthorized =>
                (
                    "Credenciales incorrectas",
                    "El documento, usuario o contraseña "
                    + "no coinciden. Verifica la información "
                    + "e inténtalo nuevamente.",
                    "danger"
                ),

            HttpStatusCode.Forbidden =>
                (
                    "Acceso no autorizado",
                    "Tu usuario no tiene autorización para "
                    + "ingresar a este aplicativo.",
                    "danger"
                ),

            HttpStatusCode.TooManyRequests =>
                (
                    "Demasiados intentos",
                    "Se realizaron varios intentos de ingreso. "
                    + "Espera unos minutos antes de intentarlo nuevamente.",
                    "warning"
                ),

            HttpStatusCode.ServiceUnavailable =>
                (
                    "Servicio no disponible",
                    "El servicio de autenticación está temporalmente "
                    + "fuera de servicio. Inténtalo nuevamente más tarde.",
                    "warning"
                ),

            HttpStatusCode.GatewayTimeout =>
                (
                    "Tiempo de espera agotado",
                    "El servidor tardó demasiado en responder. "
                    + "Inténtalo nuevamente.",
                    "warning"
                ),

            _ =>
                (
                    "No fue posible ingresar",
                    "El servidor no pudo completar el inicio "
                    + "de sesión. Inténtalo nuevamente.",
                    "danger"
                )
        };
    }

    private static string?
        NormalizeApiMessage(
            string? message)
    {
        if (string.IsNullOrWhiteSpace(
                message))
        {
            return null;
        }

        var normalized =
            message.Trim();

        if (
            normalized.Contains(
                "usuario o contraseña",
                StringComparison.OrdinalIgnoreCase)
        )
        {
            return
                "El documento, usuario o contraseña "
                + "no coinciden. Verifica la información "
                + "e inténtalo nuevamente.";
        }

        return normalized;
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private sealed class LoginFormModel
    {
        public string? UserName { get; set; }

        public string? Password { get; set; }

        public bool RememberCredentials { get; set; }
    }
}
