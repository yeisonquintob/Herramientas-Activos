        }

        await LoadDashboardAsync();
    }


    private async Task LoadDashboardAsync()
    {
        /*
         * FASE 1:
         * Se consulta solamente el Dashboard ejecutivo.
         * Esta respuesta ya incluye KPI, sedes, estados,
         * mantenimiento, documentación y actividad.
         */
        try
        {
            isRefreshing = true;
            errorMessage = null;

            dashboard =
                await Api.GetDashboardAsync(
                    forceRefresh: false,
                    branchCode: filterBranchCode,
                    operationalStatus:
                        filterOperationalStatus,
                    q: filterText);

            BuildDashboardBranchOptionsFromSummary();

            /*
             * Se libera inmediatamente el primer render.
             */
            isLoading = false;
            isRefreshing = false;

            await InvokeAsync(
                StateHasChanged);
        }
        catch (Exception ex)
        {
            errorMessage =
                "No se pudo cargar el dashboard móvil. "
                + "Valida que la API esté activa en "
                + "http://localhost:5218. Detalle: "
                + ex.Message;

            isLoading = false;
            isRefreshing = false;
            return;
        }

        /*
         * FASE 2:
         * El inventario detallado carga después.
         * No bloquea KPI, filtros ni gráficas iniciales.
         */
        await LoadDashboardToolDetailsAsync();
    }

    private async Task LoadDashboardToolDetailsAsync()
    {
        try
        {
            tools =
                await Api.GetToolsAsync(
                    forceRefresh: false);

            await InvokeAsync(
                StateHasChanged);
        }
        catch
        {
            /*
             * La vista ejecutiva permanece disponible
             * aunque falle la carga complementaria.
             */
        }
    }

    private void BuildDashboardBranchOptionsFromSummary()
    {
        if (dashboard is null)
        {
            return;
        }

        dashboardBranches =
            dashboard.ToolsByBranch
                .Where(branch =>
                    !string.IsNullOrWhiteSpace(
                        branch.BranchCode)
                    ||
                    !string.IsNullOrWhiteSpace(
                        branch.BranchName))
                .GroupBy(
                    branch =>
                        Normalize(
                            branch.BranchCode
                            ??
                            branch.BranchName),
                    StringComparer.OrdinalIgnoreCase)
                .Select(group =>
                {
                    var branch =
                        group.First();

                    return new DashboardBranchOption
                    {
                        Code =
                            string.IsNullOrWhiteSpace(
                                branch.BranchCode)
                                ? branch.BranchName
                                : branch.BranchCode,

                        Name =
                            string.IsNullOrWhiteSpace(
                                branch.BranchName)
                                ? branch.BranchCode
                                : branch.BranchName,

                        IsActive = true
                    };
                })
                .OrderBy(branch =>
                    branch.Code)
                .ToList();
    }

