/* NAVI ADMIN BADGES STATUS STANDARD 20260702 START */

/* ==========================================================================
   PROMPT 8 - Badges y estados en español

   Objetivo:
   - Unificar badges/chips de estados.
   - Compactar tamaño.
   - Usar colores semánticos.
   - Mantener lectura clara en tablas, KPIs, cards y encabezados.
   ========================================================================== */

:root {
    --navi-status-success-bg: #dcfae6;
    --navi-status-success-border: #abefc6;
    --navi-status-success-text: #067647;

    --navi-status-warning-bg: #fef0c7;
    --navi-status-warning-border: #fedf89;
    --navi-status-warning-text: #93370d;

    --navi-status-danger-bg: #fee4e2;
    --navi-status-danger-border: #fecdca;
    --navi-status-danger-text: #b42318;

    --navi-status-info-bg: #d1e9ff;
    --navi-status-info-border: #b2ddff;
    --navi-status-info-text: #175cd3;

    --navi-status-purple-bg: #f4e8ff;
    --navi-status-purple-border: #dec5ff;
    --navi-status-purple-text: #5c006b;

    --navi-status-muted-bg: #f2f4f7;
    --navi-status-muted-border: #d0d5dd;
    --navi-status-muted-text: #475467;

    --navi-status-neutral-bg: #ffffff;
    --navi-status-neutral-border: #d0d5dd;
    --navi-status-neutral-text: #344054;
}

/* Base universal */
.navi-content :where(
    .badge,
    .status-badge,
    .status-chip,
    .state-chip,
    .status-pill,
    .state-pill,
    .navi-status-badge,
    .pill,
    .tag,
    [class*="badge"],
    [class*="chip"]
) {
    min-height: 20px !important;
    height: auto !important;

    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;

    width: fit-content !important;
    max-width: 100% !important;

    padding: .13rem .48rem !important;
    border-radius: 999px !important;
    border: 1px solid transparent !important;

    font-size: .61rem !important;
    font-weight: 950 !important;
    line-height: 1.05 !important;
    letter-spacing: .005em !important;
    text-align: center !important;
    white-space: nowrap !important;
    text-transform: none !important;
}

/* Éxito / disponible / aprobado */
.navi-content :where(
    .navi-status-success,
    .status-success,
    .badge-success,
    .bg-success,
    .success,
    .available,
    .approved,
    .active,
    .validated,
    .synced,
    .completed,
    .finished,
    .good
) {
    color: var(--navi-status-success-text) !important;
    background: var(--navi-status-success-bg) !important;
    border-color: var(--navi-status-success-border) !important;
}

/* Pendiente / validación */
.navi-content :where(
    .navi-status-warning,
    .status-warning,
    .badge-warning,
    .bg-warning,
    .warning,
    .pending,
    .draft,
    .review,
    .scheduled,
    .validation
) {
    color: var(--navi-status-warning-text) !important;
    background: var(--navi-status-warning-bg) !important;
    border-color: var(--navi-status-warning-border) !important;
}

/* Peligro / rechazo / dañado */
.navi-content :where(
    .navi-status-danger,
    .status-danger,
    .badge-danger,
    .bg-danger,
    .danger,
    .damaged,
    .rejected,
    .canceled,
    .cancelled,
    .not-suitable,
    .out-of-service,
    .bad
) {
    color: var(--navi-status-danger-text) !important;
    background: var(--navi-status-danger-bg) !important;
    border-color: var(--navi-status-danger-border) !important;
}

/* Información / asignado / proceso */
.navi-content :where(
    .navi-status-info,
    .status-info,
    .badge-info,
    .bg-info,
    .info,
    .assigned,
    .loaned,
    .in-use,
    .maintenance,
    .in-progress,
    .execution,
    .reported
) {
    color: var(--navi-status-info-text) !important;
    background: var(--navi-status-info-bg) !important;
    border-color: var(--navi-status-info-border) !important;
}

/* Morado / inconsistente / sincronización parcial */
.navi-content :where(
    .navi-status-purple,
    .status-purple,
    .badge-purple,
    .purple,
    .violet,
    .inconsistent,
    .not-synced,
    .regular
) {
    color: var(--navi-status-purple-text) !important;
    background: var(--navi-status-purple-bg) !important;
    border-color: var(--navi-status-purple-border) !important;
}

/* Gris / baja / no localizado / inactivo */
.navi-content :where(
    .navi-status-muted,
    .status-muted,
    .badge-muted,
    .bg-secondary,
    .bg-dark,
    .muted,
    .gray,
    .inactive,
    .disposed,
    .not-located,
    .lost
) {
    color: var(--navi-status-muted-text) !important;
    background: var(--navi-status-muted-bg) !important;
    border-color: var(--navi-status-muted-border) !important;
}

/* Neutral */
.navi-content :where(
    .navi-status-neutral,
    .status-neutral,
    .badge-neutral,
    .neutral
) {
    color: var(--navi-status-neutral-text) !important;
    background: var(--navi-status-neutral-bg) !important;
    border-color: var(--navi-status-neutral-border) !important;
}

/* Quitar color Bootstrap fuerte cuando se usan badges */
.navi-content :where(
    .badge.bg-success,
    .badge.bg-warning,
    .badge.bg-danger,
    .badge.bg-info,
    .badge.bg-primary,
    .badge.bg-secondary,
    .badge.bg-dark
) {
    box-shadow: none !important;
}

/* Primary Bootstrap en badges lo usamos como info/morado suave */
.navi-content :where(.badge.bg-primary) {
    color: var(--navi-status-purple-text) !important;
    background: var(--navi-status-purple-bg) !important;
    border-color: var(--navi-status-purple-border) !important;
}

/* Badges dentro de tablas */
.navi-content table :where(
    .badge,
    .status-badge,
    .status-chip,
    .state-chip,
    .status-pill,
    .state-pill,
    .navi-status-badge
) {
    min-height: 18px !important;
    padding: .1rem .42rem !important;
    font-size: .57rem !important;
}

/* Badges dentro de encabezados */
.navi-content :where(
    .dash-hero,
    .settings-entity-banner,
    .docs-hero,
    .plans-hero,
    .pc-hero,
    .navi-module-hero,
    .history-hero,
    section[class*="-hero"]
) :where(
    .badge,
    .status-badge,
    .status-chip,
    .state-chip,
    .status-pill,
    .state-pill,
    .navi-status-badge
) {
    min-height: 20px !important;
    padding: .12rem .48rem !important;
    border-color: rgba(255,255,255,.42) !important;
    background: rgba(255,255,255,.12) !important;
    color: #ffffff !important;
}

/* Badges con texto largo */
.navi-content :where(
    .badge,
    .status-badge,
    .status-chip,
    .state-chip,
    .status-pill,
    .state-pill,
    .navi-status-badge
).long,
.navi-content td :where(
    .badge,
    .status-badge,
    .status-chip,
    .state-chip,
    .status-pill,
    .state-pill,
    .navi-status-badge
) {
    max-width: 160px !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}

/* NAVI ADMIN BADGES STATUS STANDARD 20260702 END */

/* NAVI GLOBAL AF BANNER STANDARD 20260702 START */

/* ==========================================================================
   Banner global estilo Disponible y Ubicación

   Objetivo:
   - Todos los banners del Admin Web deben tomar el diseño de .af-banner.
   - Cada pantalla conserva su propio nombre, descripción y botones.
   - El área derecha no debe tener recuadros negros adicionales.
   - Los botones quedan limpios, compactos y con hover blanco.
   ========================================================================== */

:root {
    --navi-global-banner-radius: .95rem;
    --navi-global-banner-min-height: 96px;
    --navi-global-banner-pad-y: 1.05rem;
    --navi-global-banner-pad-x: 1.2rem;
}

/* --------------------------------------------------------------------------
   1. Banners principales de todas las pantallas
   -------------------------------------------------------------------------- */

html body :where(
    .af-banner,
    .dash-hero,
    .inventory-hero-banner,
    .inventory-hero,
    .availability-hero,
    .assignment-hero,
    .history-hero,
    .detail-hero-banner,
    .life-hero-banner,
    .life-record-cover,
    .docs-hero,
    .documents-hero,
    .navi-module-hero,
    .settings-entity-banner,
    .approvals-hero,
    .plans-hero,
    .pc-hero,
    .ri-hero,
    .validation-hero,
    .sync-export-hero,
    .reports-hero,
    .maintenance-hero,
    .maintenance-plan-hero,
    .purchase-hero,
    .tools-hero,
    .catalogs-hero,
    .page-header,
    .navi-page-header
) {
    width: 100% !important;
    min-height: var(--navi-global-banner-min-height) !important;
    height: auto !important;

    margin: 0 0 .9rem 0 !important;
    padding: var(--navi-global-banner-pad-y) var(--navi-global-banner-pad-x) !important;

    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 1rem !important;

    color: #ffffff !important;
    border-radius: var(--navi-global-banner-radius) !important;
    border: 1px solid rgba(255,255,255,.10) !important;

    background:
        radial-gradient(circle at 88% 16%, rgba(175, 0, 210, .34), transparent 32%),
        linear-gradient(135deg, #050008 0%, #100016 36%, #30003c 66%, #76008f 100%) !important;

    box-shadow:
        0 .45rem 1.05rem rgba(75,0,92,.15),
        inset 0 1px 0 rgba(255,255,255,.06) !important;

    overflow: hidden !important;
}

/* --------------------------------------------------------------------------
   2. Bloque izquierdo del banner
   -------------------------------------------------------------------------- */

html body :where(
    .af-banner,
    .dash-hero,
    .inventory-hero-banner,
    .inventory-hero,
    .availability-hero,
    .assignment-hero,
    .history-hero,
    .detail-hero-banner,
    .life-hero-banner,
    .life-record-cover,
    .docs-hero,
