@page "/tools/{ToolId:guid}/life-record"
@page "/tools/{ToolId:guid}/technical-life-record"

@using Navi.ToolsAssets.MobilePwa.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http

@inject NaviMobileApiClient Api
@inject MobileAuthSessionService Auth
@inject NavigationManager Navigation

<PageTitle>Hoja de vida AF - NAVI Herramientas y AF</PageTitle>

<section class="mobile-page mobile-compact-page navi-life-manage-v3 mlife-v45-page mobile-life-record-standard-v91">
    @if (isLoading)
    {
        <div class="mobile-loading" role="status" aria-busy="true">Cargando hoja de vida...</div>
    }
    else if (!Auth.IsAuthenticated)
    {
        <div class="mobile-empty">
            <strong>Sesión requerida</strong>
            <span>Debes iniciar sesión para consultar la hoja de vida.</span>
            <button class="mobile-primary-button" type="button" @onclick="GoLogin" data-ntx-tone="ghost" >Ir al login</button>
        </div>
    }
    else if (!CanViewLifeRecord)
    {
        <div class="mobile-empty">
            <strong>Sin permiso</strong>
            <span>Tu usuario no tiene permiso para consultar hoja de vida.</span>
            <button class="mobile-primary-button" type="button" @onclick="GoBack" data-ntx-tone="warning" >Regresar</button>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(message) && life is null)
    {
        <div class="mobile-alert">@message</div>
        <button class="mobile-primary-button" type="button" @onclick="GoBack" data-ntx-tone="warning" >Regresar</button>
    }
    else if (life is not null)
    {
        <NaviMobileAppBanner Class="navi-mobile-life-edit-app-banner navi-mobile-app-banner--home-only"
                             Pill="ACTIVOS FIJOS · HOJA DE VIDA"
                             Title="@Show(life.EquipmentInformation.Name ?? life.Summary.Name)"
                             Description="@($"{Show(life.EquipmentInformation.InternalCode ?? life.Summary.InternalCode)} · {StatusLabel(life.Summary.OperationalStatus)}")"
                             HomeUrl="/"
                             ShowHomeButton="true"
                             ShowBackButton="false" />

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="mobile-alert">@message</div>
        }

        @* NAVI MOBILE LIFE RECORD KPI V91 START *@

        <NaviMobileKpiOverflow
            PrimaryCount="2"
            OverflowCount="4"
            Class="navi-mobile-kpi-standard-overflow mlife-v91-kpi-overflow"
            ButtonLabel="Mostrar indicadores adicionales"
            PanelLabel="Indicadores adicionales de la hoja de vida">

            <PrimaryContent>

                <NaviMobileKpiGrid
                    Columns="2"
                    Compact="true"
                    Dividers="true"
                    Class="navi-mobile-kpi-standard-grid mlife-v91-kpi-primary">

                    <NaviMobileKpiCard
                        Title="Código"
                        Description="Identificación"
                        IconKey="inventory"
                        Tone="neutral"
                        Compact="true">

                        <ValueContent>
                            @Show(life.Summary.InternalCode)
                        </ValueContent>

                    </NaviMobileKpiCard>

                    <NaviMobileKpiCard
                        Title="Estado"
                        Description="Operativo"
                        IconKey="transfer"
                        Tone="warning"
                        Compact="true">

                        <ValueContent>
                            @StatusLabel(
                                life.Summary.OperationalStatus)
                        </ValueContent>

                    </NaviMobileKpiCard>

                </NaviMobileKpiGrid>

            </PrimaryContent>

            <OverflowContent>

                <NaviMobileKpiGrid
                    Columns="2"
                    Compact="true"
                    Dividers="true"
                    Class="navi-mobile-kpi-standard-grid mlife-v91-kpi-panel">

                    <NaviMobileKpiCard
                        Title="Clasificación"
                        Description="Tipo de activo"
                        IconKey="document"
                        Tone="soft"
                        Compact="true">

                        <ValueContent>
                            @(life.Summary.IsSpecialized
                                ? "Especializada"
                                : "Estándar")
                        </ValueContent>

                    </NaviMobileKpiCard>

                    <NaviMobileKpiCard
                        Title="Vida útil"
                        Description="Consumo estimado"
                        IconKey="progress"
                        Tone="neutral"
                        Compact="true">

                        <ValueContent>
                            @PercentLabel(
                                life.UsefulLife.UsedPercentage)
                        </ValueContent>

                    </NaviMobileKpiCard>

                    <NaviMobileKpiCard
                        Title="Documentos"
                        Description="Archivos"
                        IconKey="document"
                        Tone="soft"
                        Compact="true">

                        <ValueContent>
                            @life.Documents.AllDocuments.Count
                        </ValueContent>

                    </NaviMobileKpiCard>

                    <NaviMobileKpiCard
                        Title="Accesorios"
                        Description="Componentes"
                        IconKey="inventory"
                        Tone="neutral"
                        Compact="true">

                        <ValueContent>
                            @life.Accessories.Count
                        </ValueContent>

                    </NaviMobileKpiCard>

                </NaviMobileKpiGrid>

            </OverflowContent>

        </NaviMobileKpiOverflow>

        <div class="mlife-v91-main-actions">

            <button
                type="button"
                class="mlife-v91-back-button"
                @onclick="GoBack"
                data-ntx-tone="warning">

                <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false">

                    <path d="M19 12H5"></path>
                    <path d="M11 6L5 12L11 18"></path>

                </svg>

                <span>Regresar</span>

            </button>

        </div>

@* NAVI MOBILE LIFE RECORD KPI V91 END *@

@* NAVI MOBILE LIFE RECORD PHOTO V91 START *@

        <section class="mlife-v91-photo-card">

            <div class="mlife-v91-photo-header">

                <div>
                    <small>IMAGEN DEL ACTIVO</small>
                    <strong>Vista del activo</strong>
                </div>

            </div>

            <div class="mlife-v91-photo-frame">

                @if (
                    LifeImageV45 is not null
                    &&
                    !string.IsNullOrWhiteSpace(
                        LifeImageUrlV46))
                {
                    <button
                        type="button"
                        class="mlife-v91-photo-trigger"
                        title="Ampliar imagen"
                        aria-label="Ampliar imagen del activo"
                        data-ntx-tone="consult"
                        @onclick="OpenLifeImagePreviewV49">

                        <img
                            src="@LifeImageUrlV46"
                            alt="Imagen del activo"
                            draggable="false"
                            loading="eager"
                            decoding="auto"
                            fetchpriority="high" />

                        <span
                            class="mlife-v91-photo-zoom"
                            aria-hidden="true">

                            <svg
                                viewBox="0 0 24 24">

                                <circle
                                    cx="11"
                                    cy="11"
                                    r="7">
                                </circle>

                                <path d="M20 20L16.5 16.5"></path>
                                <path d="M11 8V14"></path>
                                <path d="M8 11H14"></path>

                            </svg>

                        </span>

                    </button>
                }
                else
                {
                    <div class="mlife-v91-photo-empty">

                        <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true">

                            <rect
                                x="3"
                                y="5"
                                width="18"
                                height="14"
                                rx="2">
                            </rect>

                            <circle
                                cx="9"
                                cy="10"
                                r="2">
                            </circle>

                            <path d="M4 17L9 13L13 16L16 13L20 17"></path>

                        </svg>

                        <strong>Sin imagen registrada</strong>

                    </div>
                }

            </div>

            @if (CanUploadLifeImageV45)
            {
                <label class="mlife-v91-upload-button">

                    <svg
                        viewBox="0 0 24 24"
                        aria-hidden="true">

                        <path d="M12 16V4"></path>
                        <path d="M7 9L12 4L17 9"></path>
                        <path d="M5 20H19"></path>

                    </svg>

                    <span>
                        @(IsUploadingLifeImageV45
                            ? "Subiendo..."
                            : "Subir imagen")
                    </span>

                    <InputFile
                        id="mobile-life-record-image-upload"
                        name="mobile-life-record-image-upload"
                        class="mlife-v91-upload-input"
                        OnChange="OnLifeImageSelectedV45"
                        accept=".jpg,.jpeg,.png,image/jpeg,image/png"
                        disabled="@IsUploadingLifeImageV45" />

                </label>
            }

            @if (
                !string.IsNullOrWhiteSpace(
                    LifeImageMessageV45))
            {
                <div class="@LifeImageMessageClassV45">
                    @LifeImageMessageV45
                </div>
            }

        </section>

        @if (
            IsLifeImagePreviewOpenV49
            &&
            !string.IsNullOrWhiteSpace(
                LifeImageUrlV46))
        {
            <div
                class="navi-mobile-home-image-preview-v80 mlife-v91-image-preview"
                role="presentation"
                @onclick="CloseLifeImagePreviewV49">

                <section
                    class="navi-mobile-home-image-preview-v80__dialog"
                    role="dialog"
                    aria-modal="true"
                    aria-labelledby="mlife-v91-image-title"
                    @onclick:stopPropagation="true">

                    <header
                        class="navi-mobile-home-image-preview-v80__header">

                        <div
                            class="navi-mobile-home-image-preview-v80__title">

                            <span>
                                @Show(
                                    life.Summary.InternalCode)
                            </span>

                            <strong id="mlife-v91-image-title">
                                @Show(
                                    life.EquipmentInformation.Name
                                    ??
                                    life.Summary.Name)
                            </strong>

                        </div>

                        <div
                            class="navi-mobile-home-image-preview-v80__header-actions">

                            <div
                                class="navi-mobile-home-image-preview-v80__zoom"
                                aria-label="Controles de zoom">

                                <button
                                    type="button"
                                    class="navi-mobile-home-image-preview-v80__zoom-out"
                                    title="Alejar imagen"
                                    aria-label="Alejar imagen"
                                    data-navi-home-image-action="zoom-out">

                                    <span aria-hidden="true">−</span>

                                </button>

                                <button
                                    type="button"
                                    class="navi-mobile-home-image-preview-v80__zoom-value"
                                    title="Restablecer imagen"
                                    aria-label="Restablecer zoom al 100 por ciento"
                                    data-navi-home-image-action="reset">

                                    100%

                                </button>

                                <button
                                    type="button"
                                    class="navi-mobile-home-image-preview-v80__zoom-in"
                                    title="Aumentar imagen"
                                    aria-label="Aumentar imagen"
                                    data-navi-home-image-action="zoom-in">

                                    <span aria-hidden="true">+</span>

                                </button>

                            </div>

                            <button
                                type="button"
                                class="navi-mobile-home-image-preview-v80__close"
                                title="Cerrar"
                                aria-label="Cerrar vista de imagen"
                                data-ntx-tone="danger"
                                @onclick="CloseLifeImagePreviewV49">

                                <svg
                                    viewBox="0 0 24 24"
                                    aria-hidden="true"
                                    focusable="false">

                                    <path d="M6 6L18 18"></path>
                                    <path d="M18 6L6 18"></path>

                                </svg>

                            </button>

                        </div>

                    </header>

                    <div
                        class="navi-mobile-home-image-preview-v80__viewport"
                        data-navi-home-image-viewport
                        tabindex="0"
                        aria-label="Imagen ampliable y desplazable">

                        <img
                            class="navi-mobile-home-image-preview-v80__image"
                            src="@LifeImageUrlV46"
                            alt="Imagen ampliada del activo"
                            draggable="false"
                            loading="eager"
                            decoding="auto"
                            fetchpriority="high"
                            data-navi-home-image />

                    </div>

                    <footer
                        class="navi-mobile-home-image-preview-v80__footer">

                        <em class="mlife-v91-image-status">
                            @StatusLabel(
                                life.Summary.OperationalStatus)
                        </em>

                        <small>
                            Usa + o − para ampliar. Arrastra la imagen
                            con el dedo cuando esté ampliada.
                        </small>

                        <button
                            type="button"
                            class="navi-mobile-home-image-preview-v80__close-secondary"
                            data-ntx-tone="secondary"
                            @onclick="CloseLifeImagePreviewV49">

                            Cerrar

                        </button>

                    </footer>

                </section>

            </div>
        }

@* NAVI MOBILE LIFE RECORD PHOTO V91 END *@

        @if (!CanManageThisTool && HasAnyManagementPermission)
        {
            <section class="mobile-empty compact">
                Tienes permisos de gestión, pero este activo no está dentro de tu sede o alcance operativo.
            </section>
        }

        <details id="info" class="mobile-fold mlife-section" open>
            <summary>
                <span>Información del equipo</span>

                <div class="mlife-summary-actions">
                    @if (CanEditTechnical)
                    {
                        @if (editInfoMode)
                        {
                            <button type="button" class="cancel" @onclick="CancelInfoEdit" @onclick:stopPropagation="true" data-ntx-tone="secondary" >Cancelar</button>
                            <button type="button" class="save" @onclick="SaveTechnicalAsync" @onclick:stopPropagation="true" disabled="@isSaving" data-ntx-tone="affirmative" >
                                @(isSaving ? "Guardando..." : "Guardar")
                            </button>
                        }
                        else
                        {
                            <button type="button" @onclick="BeginInfoEdit" @onclick:stopPropagation="true" data-ntx-tone="affirmative" >Editar</button>
                        }
                    }
                </div>
            </summary>

            @if (!editInfoMode)
            {
                <div class="mobile-info-grid compact">
                    <div><span>Código interno</span><strong>@Show(life.EquipmentInformation.InternalCode)</strong></div>
                    <div><span>Nombre</span><strong>@Show(life.EquipmentInformation.Name)</strong></div>
                    <div><span>Activo fijo</span><strong>@Show(life.EquipmentInformation.FixedAssetCode)</strong></div>
                    <div><span>Código Fenix365</span><strong>@Show(life.EquipmentInformation.FenixCode)</strong></div>
                    <div><span>Marca</span><strong>@Show(life.EquipmentInformation.Brand)</strong></div>
                    <div><span>Modelo</span><strong>@Show(life.EquipmentInformation.Model)</strong></div>
                    <div><span>Serial</span><strong>@Show(life.EquipmentInformation.SerialNumber)</strong></div>
                    <div><span>Sede</span><strong>@JoinCodeName(life.EquipmentInformation.BranchCode, life.EquipmentInformation.BranchName)</strong></div>
                    <div><span>Ubicación</span><strong>@JoinCodeName(life.EquipmentInformation.LocationCode, life.EquipmentInformation.LocationName)</strong></div>
                    <div><span>Responsable</span><strong>@Show(life.EquipmentInformation.ResponsibleName)</strong></div>
                </div>
            }
            else
            {
                <EditForm Model="technicalForm" OnValidSubmit="SaveTechnicalAsync">
                    <div class="mlife-form-grid">
                        <label><span>Marca</span><InputText @bind-Value="technicalForm.Brand" name="navi-mobileliferecord-field-001" /></label>
                        <label><span>Modelo</span><InputText @bind-Value="technicalForm.Model" name="navi-mobileliferecord-field-002" /></label>
                        <label><span>Serial</span><InputText @bind-Value="technicalForm.SerialNumber" name="navi-mobileliferecord-field-003" /></label>
                        <label><span>Activo fijo</span><InputText @bind-Value="technicalForm.FixedAssetCode" name="navi-mobileliferecord-field-004" /></label>
                        <label><span>Código Fenix365</span><InputText @bind-Value="technicalForm.FenixCode" name="navi-mobileliferecord-field-005" /></label>
                        <label><span>Fecha adquisición</span><InputDate @bind-Value="technicalForm.AcquisitionDate" name="navi-mobileliferecord-field-006" /></label>
                    </div>

                    <label class="mlife-full">
                        <span>Observación</span>
                        <InputTextArea @bind-Value="technicalForm.Observation" name="navi-mobileliferecord-field-038" />
                    </label>
                </EditForm>
            }
        </details>


        <details id="technical" class="mobile-fold mlife-section" open>
            <summary>
                <span>Datos técnicos, garantía y vida útil</span>

                <div class="mlife-summary-actions">
                    @if (CanEditTechnical)
                    {
                        @if (editTechnicalMode)
                        {
                            <button type="button" class="cancel" @onclick="CancelTechnicalEdit" @onclick:stopPropagation="true" data-ntx-tone="secondary" >
                                Cancelar
                            </button>

                            <button type="button" class="save" @onclick="SaveTechnicalAsync" @onclick:stopPropagation="true" disabled="@isSaving" data-ntx-tone="affirmative" >
                                @(isSaving ? "Guardando..." : "Guardar")
                            </button>
                        }
                        else
                        {
                            <button type="button" @onclick="BeginTechnicalEdit" @onclick:stopPropagation="true" data-ntx-tone="affirmative" >
                                Editar
                            </button>
                        }
                    }
                </div>
            </summary>

            @if (!editTechnicalMode)
            {
                <div class="mobile-info-grid compact">
                    <div>
                        <span>Voltaje</span>
                        <strong>@Show(life.TechnicalSpecifications.Voltage)</strong>
                    </div>

                    <div>
                        <span>Capacidad</span>
                        <strong>@Show(life.TechnicalSpecifications.LoadCapacity)</strong>
                    </div>

                    <div>
                        <span>Proveedor</span>
                        <strong>@Show(life.TechnicalSpecifications.Provider)</strong>
                    </div>

                    <div>
                        <span>Garantía</span>
                        <strong>@BoolLabel(life.Warranty.HasWarranty)</strong>
                    </div>

                    <div>
                        <span>Tipo garantía</span>
                        <strong>@Show(life.Warranty.WarrantyType)</strong>
                    </div>

                    <div>
                        <span>Vence certificación</span>
                        <strong>@DateLabel(life.TechnicalSpecifications.CertificationExpirationDate)</strong>
                    </div>

                    <div>
                        <span>Inicio vida útil</span>
                        <strong>@DateLabel(life.UsefulLife.StartDate)</strong>
                    </div>

                    <div>
                        <span>Fin estimado</span>
                        <strong>@DateLabel(life.UsefulLife.EndDate)</strong>
                    </div>

                    <div>
                        <span>Vida útil meses</span>
                        <strong>@ValueLabel(life.UsefulLife.UsefulLifeMonths)</strong>
                    </div>

                    <div>
                        <span>Vida útil días</span>
                        <strong>@ValueLabel(life.UsefulLife.UsefulLifeDays)</strong>
                    </div>

                    <div>
                        <span>Último mantenimiento</span>
                        <strong>@DateLabel(life.MaintenancePlan.LastMaintenanceDate)</strong>
                    </div>

                    <div>
                        <span>Próximo mantenimiento</span>
                        <strong>@DateLabel(life.MaintenancePlan.NextMaintenanceDate)</strong>
                    </div>

                    <div>
                        <span>Periodicidad mantenimiento</span>
                        <strong>@ValueLabel(life.MaintenancePlan.MaintenancePeriodMonths)</strong>
                    </div>

                    <div>
                        <span>Requiere mantenimiento</span>
                        <strong>@BoolLabel(life.TechnicalSpecifications.RequiresMaintenance)</strong>
                    </div>

                    <div>
                        <span>Requiere preoperacional</span>
                        <strong>@BoolLabel(life.TechnicalSpecifications.RequiresPreOperationalCheck)</strong>
                    </div>

                    <div>
                        <span>Requiere certificación</span>
                        <strong>@BoolLabel(life.TechnicalSpecifications.RequiresCertification)</strong>
                    </div>
                </div>
            }
            else
            {
                <EditForm Model="technicalForm" OnValidSubmit="SaveTechnicalAsync">
                    <div class="mlife-form-grid">
                        <label>
                            <span>Voltaje</span>
                            <InputText @bind-Value="technicalForm.Voltage" name="navi-mobileliferecord-field-007" />
                        </label>

                        <label>
                            <span>Capacidad carga</span>
                            <InputText @bind-Value="technicalForm.LoadCapacity" name="navi-mobileliferecord-field-008" />
                        </label>

                        <label>
                            <span>Proveedor</span>
                            <InputText @bind-Value="technicalForm.Provider" name="navi-mobileliferecord-field-009" />
                        </label>

                        <label>
                            <span>Tipo garantía</span>
                            <InputText @bind-Value="technicalForm.WarrantyType" name="navi-mobileliferecord-field-010" />
                        </label>

                        <label>
                            <span>Inicio vida útil</span>
                            <InputDate @bind-Value="technicalForm.UsefulLifeStartDate" name="navi-mobileliferecord-field-011" />
                        </label>

                        <label>
                            <span>Vida útil meses</span>
                            <InputNumber @bind-Value="technicalForm.UsefulLifeMonths" name="navi-mobileliferecord-field-012" />
                        </label>

                        <label>
                            <span>Vida útil días</span>
                            <InputNumber @bind-Value="technicalForm.UsefulLifeDays" name="navi-mobileliferecord-field-013" />
                        </label>

                        <label>
                            <span>Último mantenimiento</span>
                            <InputDate @bind-Value="technicalForm.LastMaintenanceDate" name="navi-mobileliferecord-field-014" />
                        </label>

                        <label>
                            <span>Próximo mantenimiento</span>
                            <InputDate @bind-Value="technicalForm.NextMaintenanceDate" name="navi-mobileliferecord-field-015" />
                        </label>

                        <label>
                            <span>Periodicidad meses</span>
                            <InputNumber @bind-Value="technicalForm.MaintenancePeriodMonths" name="navi-mobileliferecord-field-016" />
                        </label>

                        <label>
                            <span>Vence certificación</span>
                            <InputDate @bind-Value="technicalForm.CertificationExpirationDate" name="navi-mobileliferecord-field-017" />
                        </label>
                    </div>

                    <div class="mlife-check-grid">
                        <label>
                            <InputCheckbox @bind-Value="technicalForm.HasWarranty" name="navi-mobileliferecord-field-018" />
                            Garantía
                        </label>

                        <label>
                            <InputCheckbox @bind-Value="technicalForm.RequiresMaintenance" name="navi-mobileliferecord-field-019" />
                            Requiere mantenimiento
                        </label>

                        <label>
                            <InputCheckbox @bind-Value="technicalForm.RequiresPreOperationalCheck" name="navi-mobileliferecord-field-020" />
                            Requiere preoperacional
                        </label>

                        <label>
                            <InputCheckbox @bind-Value="technicalForm.RequiresCertification" name="navi-mobileliferecord-field-021" />
                            Requiere certificación
                        </label>
                    </div>

                    <label class="mlife-full">
                        <span>Observación</span>
                        <InputTextArea @bind-Value="technicalForm.Observation" name="navi-mobileliferecord-field-039" />
                    </label>
                </EditForm>
            }
        </details>


        <details id="accessories" class="mobile-fold mlife-section">
            <summary>
                <span>Accesorios (@accessories.Count)</span>

                <div class="mlife-summary-actions">
                    @if (CanManageAccessories)
                    {
                        @if (editAccessoriesMode)
                        {
                            <button type="button" class="cancel" @onclick="CancelAccessoriesSection" @onclick:stopPropagation="true" data-ntx-tone="secondary" >Cancelar</button>
                            <button type="button" class="save" @onclick="SaveAccessoryAsync" @onclick:stopPropagation="true" disabled="@isSaving" data-ntx-tone="affirmative" >
                                @(isSaving ? "Guardando..." : "Guardar")
                            </button>
                        }
                        else
                        {
                            <button type="button" @onclick="BeginAccessoriesEdit" @onclick:stopPropagation="true" data-ntx-tone="affirmative" >Editar</button>
                        }
                    }
                </div>
            </summary>

            @if (editAccessoriesMode)
            {
                <EditForm Model="accessoryForm" OnValidSubmit="SaveAccessoryAsync">
                    <div class="mlife-form-grid">
                        <label><span>Nombre</span><InputText @bind-Value="accessoryForm.Name" name="navi-mobileliferecord-field-022" /></label>
                        <label><span>Cantidad</span><InputNumber @bind-Value="accessoryForm.Quantity" name="navi-mobileliferecord-field-023" /></label>
                    </div>

                    <div class="mlife-check-grid">
                        <label><InputCheckbox @bind-Value="accessoryForm.RequiresMaintenance" name="navi-mobileliferecord-field-024" /> Requiere mantenimiento</label>
                        <label><InputCheckbox @bind-Value="accessoryForm.IsMeasurementEquipment" name="navi-mobileliferecord-field-025" /> Equipo medición</label>
                    </div>

                    <label class="mlife-full">
                        <span>Observación</span>
                        <InputTextArea @bind-Value="accessoryForm.Observation" name="navi-mobileliferecord-field-040" />
                    </label>
                </EditForm>
            }

            <div class="mobile-mini-list">
                @foreach (var item in accessories)
                {
                    <article>
                        <strong>@Show(item.Name)</strong>
                        <span>Cantidad: @item.Quantity · Mant.: @BoolLabel(item.RequiresMaintenance) · Medición: @BoolLabel(item.IsMeasurementEquipment)</span>
                        <small>@Show(item.Observation)</small>

                        @if (editAccessoriesMode && CanManageAccessories)
                        {
                            <div class="mlife-row-actions">
                                <button type="button" @onclick="() => StartAccessoryEdit(item)" data-ntx-tone="operation" >Editar este</button>
                                <button class="danger" type="button" @onclick="() => DeleteAccessoryAsync(item)" data-ntx-tone="danger" >Desactivar</button>
                            </div>
                        }
                    </article>
                }
            </div>
        </details>

        <details id="documents" class="mobile-fold mlife-section">
            <summary>
                <span>Documentos (@documents.Count)</span>

                <div class="mlife-summary-actions">
                    @if (CanManageDocuments)
                    {
                        @if (editDocumentsMode)
                        {
                            <button type="button" class="cancel" @onclick="CancelDocumentsSection" @onclick:stopPropagation="true" data-ntx-tone="secondary" >Cancelar</button>
                            <button type="button" class="save" @onclick="UploadDocumentAsync" @onclick:stopPropagation="true" disabled="@isSaving" data-ntx-tone="affirmative" >
                                @(isSaving ? "Cargando..." : "Guardar")
                            </button>
                        }
                        else
                        {
                            <button type="button" @onclick="BeginDocumentsEdit" @onclick:stopPropagation="true" data-ntx-tone="affirmative" >Editar</button>
                        }
                    }
                </div>
            </summary>

            @if (editDocumentsMode)
            {
                <div class="mlife-form-grid">
                    <label>
                        <span>Tipo documento</span>
                        <InputSelect @bind-Value="documentForm.DocumentType" name="navi-mobileliferecord-field-026">
                            <option value="TechnicalDocument">Ficha técnica</option>
                            <option value="PhotographicRecord">Registro fotográfico</option>
                            <option value="MaintenanceEvidence">Evidencia mantenimiento</option>
                            <option value="Other">Otro</option>
                        </InputSelect>
                    </label>

                    <label>
                        <span>Archivo</span>
                        <InputFile OnChange="OnFileSelected" name="navi-mobileliferecord-field-027" />
                    </label>
                </div>

                <label class="mlife-full">
                    <span>Descripción</span>
                    <InputTextArea @bind-Value="documentForm.Description" name="navi-mobileliferecord-field-041" />
                </label>

                @if (selectedFile is not null)
                {
                    <div class="mobile-empty compact">Archivo seleccionado: @selectedFile.Name</div>
                }
            }

            <div class="mobile-doc-list">
                @foreach (var item in documents)
                {
                    <article class="mlife-doc-card">
                        <a href="@Api.ToApiUrl(item.DownloadUrl)" target="_blank">
                            <strong>@Show(item.FileName)</strong>
                            <span>@Show(item.DocumentType) · @SizeLabel(item.SizeBytes)</span>
                            <small>@DateLabel(item.UploadedAt) · @Show(item.UploadedBy)</small>
                        </a>

                        @if (editDocumentsMode && CanManageDocuments)
                        {
                            <button class="danger" type="button" @onclick="() => DeleteDocumentAsync(item)" data-ntx-tone="danger" >Desactivar</button>
                        }
                    </article>
                }
            </div>
        </details>

        <details id="maintenance" class="mobile-fold mlife-section" open="@forceOpenMaintenanceSection">
            <summary>
                <span>Cronograma mantenimiento (@maintenance.Count)</span>

                <div class="mlife-summary-actions">
                    @if (CanManageMaintenance)
                    {
                        @if (editMaintenanceMode)
                        {
                            <button type="button" class="cancel" @onclick="CancelMaintenanceSection" @onclick:stopPropagation="true" data-ntx-tone="secondary" >Cancelar</button>
                            <button type="button" class="save" @onclick="SaveMaintenanceAsync" @onclick:stopPropagation="true" disabled="@isSaving" data-ntx-tone="affirmative" >
                                @(isSaving ? "Guardando..." : "Guardar")
                            </button>
                        }
                        else
                        {
                            <button type="button" @onclick="BeginMaintenanceEdit" @onclick:stopPropagation="true" data-ntx-tone="affirmative" >Editar</button>
                        }
                    }
                </div>
            </summary>

            @if (editMaintenanceMode)
            {
                <EditForm Model="maintenanceForm" OnValidSubmit="SaveMaintenanceAsync">
                    <div class="mlife-form-grid">
                        <label><span>Número</span><InputText @bind-Value="maintenanceForm.MaintenanceNumber" name="navi-mobileliferecord-field-028" /></label>
                        <label><span>Fecha programada</span><InputDate @bind-Value="maintenanceForm.ScheduledAt" name="navi-mobileliferecord-field-029" /></label>
                        <label>
                            <span>Tipo</span>
                            <InputSelect @bind-Value="maintenanceForm.Type" name="navi-mobileliferecord-field-030">
                                <option value="Preventive">Preventivo</option>
                                <option value="Corrective">Correctivo</option>
                                <option value="Calibration">Calibración</option>
                                <option value="Inspection">Inspección</option>
                            </InputSelect>
                        </label>
                        <label>
                            <span>Estado</span>
                            <InputSelect @bind-Value="maintenanceForm.Status" name="navi-mobileliferecord-field-031">
                                <option value="Scheduled">Programado</option>
                                <option value="InProgress">En proceso</option>
                                <option value="Completed">Completado</option>
                                <option value="Cancelled">Cancelado</option>
                            </InputSelect>
                        </label>
                        <label><span>Proveedor</span><InputText @bind-Value="maintenanceForm.Provider" name="navi-mobileliferecord-field-032" /></label>
                        <label><span>Técnico</span><InputText @bind-Value="maintenanceForm.Technician" name="navi-mobileliferecord-field-033" /></label>
                        <label><span>Factura</span><InputText @bind-Value="maintenanceForm.InvoiceNumber" name="navi-mobileliferecord-field-034" /></label>
                        <label><span>Costo</span><InputNumber @bind-Value="maintenanceForm.Cost" name="navi-mobileliferecord-field-035" /></label>
                    </div>

                    <label class="mlife-full"><span>Descripción</span><InputTextArea @bind-Value="maintenanceForm.Description" name="navi-mobileliferecord-field-042" /></label>
                    <label class="mlife-full"><span>Actividades</span><InputTextArea @bind-Value="maintenanceForm.MaintenanceActivities" name="navi-mobileliferecord-field-043" /></label>
                    <label class="mlife-full"><span>Resultado</span><InputTextArea @bind-Value="maintenanceForm.Result" name="navi-mobileliferecord-field-044" /></label>
                </EditForm>
            }

            <div class="mobile-mini-list">
                @foreach (var item in maintenance)
                {
                    <article>
                        <strong>@Show(item.MaintenanceNumber) · @Show(item.Status)</strong>
                        <span>@DateLabel(item.ScheduledAt) · @Show(item.Provider) · @Show(item.Technician)</span>
                        <small>@Show(item.Description ?? item.MaintenanceActivities ?? item.Result)</small>

                        @if (editMaintenanceMode && CanManageMaintenance)
                        {
                            <div class="mlife-row-actions">
                                <button type="button" @onclick="() => StartMaintenanceEdit(item)" data-ntx-tone="operation" >Editar este</button>
                                <button class="danger" type="button" @onclick="() => DeleteMaintenanceAsync(item)" data-ntx-tone="danger" >Desactivar</button>
                            </div>
                        }
                    </article>
                }
            </div>
        </details>

        <details id="safe" class="mobile-fold mlife-section">
            <summary>
                <span>Prácticas seguras (@safePractices.Count)</span>

                <div class="mlife-summary-actions">
                    @if (CanManageSafePractices)
                    {
                        @if (editSafePracticesMode)
                        {
                            <button type="button" class="cancel" @onclick="CancelSafePracticesSection" @onclick:stopPropagation="true" data-ntx-tone="secondary" >Cancelar</button>
                            <button type="button" class="save" @onclick="SaveSafePracticeAsync" @onclick:stopPropagation="true" disabled="@isSaving" data-ntx-tone="affirmative" >
                                @(isSaving ? "Guardando..." : "Guardar")
                            </button>
                        }
                        else
                        {
                            <button type="button" @onclick="BeginSafePracticesEdit" @onclick:stopPropagation="true" data-ntx-tone="affirmative" >Editar</button>
                        }
                    }
                </div>
            </summary>

            @if (editSafePracticesMode)
            {
                <EditForm Model="safePracticeForm" OnValidSubmit="SaveSafePracticeAsync">
                    <div class="mlife-form-grid">
                        <label><span>Orden</span><InputNumber @bind-Value="safePracticeForm.SortOrder" name="navi-mobileliferecord-field-036" /></label>
                        <label><span>Práctica</span><InputText @bind-Value="safePracticeForm.PracticeName" name="navi-mobileliferecord-field-037" /></label>
                    </div>

                    <label class="mlife-full">
                        <span>Descripción</span>
                        <InputTextArea @bind-Value="safePracticeForm.Description" name="navi-mobileliferecord-field-045" />
                    </label>

                    <button class="mlife-secondary inline" type="button" @onclick="CreateDefaultSafePracticesAsync" disabled="@isSaving" data-ntx-tone="ghost" >
                        Cargar predeterminadas
                    </button>
                </EditForm>
            }

            <div class="mobile-mini-list">
                @foreach (var item in safePractices)
                {
                    <article>
                        <strong>@item.SortOrder. @Show(item.PracticeName)</strong>
                        <span>@Show(item.Description)</span>

                        @if (editSafePracticesMode && CanManageSafePractices)
                        {
                            <div class="mlife-row-actions">
                                <button type="button" @onclick="() => StartSafePracticeEdit(item)" data-ntx-tone="operation" >Editar este</button>
                                <button class="danger" type="button" @onclick="() => DeleteSafePracticeAsync(item)" data-ntx-tone="danger" >Desactivar</button>
                            </div>
                        }
                    </article>
                }
            </div>
        </details>

        <details class="mobile-fold mlife-section">
            <summary>
                <span>Eventos de hoja de vida (@life.LifeCycleEvents.Count)</span>
            </summary>

            <div class="mobile-timeline compact">
                @foreach (var item in life.LifeCycleEvents.Take(20))
                {
                    <article>
                        <strong>@Show(item.Title)</strong>
                        <span>@Show(item.Description)</span>
                        <small>@DateTimeLabel(item.EventDate) · @Show(item.PerformedBy ?? item.CreatedBy)</small>
                    </article>
                }
            </div>
        </details>
    }
</section>

@code {
    private const long MaxFileSize = 50 * 1024 * 1024;

    [Parameter]
    public Guid ToolId { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    private bool isLoading = true;
    private bool isSaving;
    private string? message;

    private bool editInfoMode;
    private bool editTechnicalMode;
    private bool editAccessoriesMode;
    private bool editDocumentsMode;
    private bool editMaintenanceMode;
    private bool forceOpenMaintenanceSection;
    private bool editSafePracticesMode;

    private MobileTechnicalLifeRecordDto? life;
    private MobileToolDto? tool;

    private TechnicalEditModel technicalForm = new();
    private AccessoryForm accessoryForm = new();
    private DocumentForm documentForm = new() { DocumentType = "TechnicalDocument" };
    private MaintenanceForm maintenanceForm = new()
    {
        Type = "Preventive",
        Status = "Scheduled",
        ScheduledAt = DateTime.Today.AddDays(30),
        IsToolOperational = true
    };
    private SafePracticeForm safePracticeForm = new() { SortOrder = 1 };

    private Guid? editingAccessoryId;
    private Guid? editingMaintenanceId;
    private Guid? editingSafePracticeId;
    private IBrowserFile? selectedFile;

    private List<MobileAccessoryDto> accessories = new();
    private List<MobileDocumentDto> documents = new();
    private List<MobileMaintenanceScheduleDto> maintenance = new();
    private List<MobileSafePracticeDto> safePractices = new();

    private bool CanViewLifeRecord => Auth.HasAnyPermission("TechnicalLifeRecord.View", "ToolDetail.LifeRecord.Open");
    private bool CanEditTechnical => Auth.HasPermission("TechnicalLifeRecord.Edit") && CanManageThisTool;
    private bool CanManageAccessories => Auth.HasAnyPermission("TechnicalLifeRecord.Accessories", "TechnicalLifeRecord.Edit") && CanManageThisTool;
    private bool CanManageDocuments => Auth.HasAnyPermission("TechnicalLifeRecord.Documents", "Documents.Upload", "Documents.View") && CanManageThisTool;
    private bool CanManageMaintenance => Auth.HasAnyPermission("TechnicalLifeRecord.Maintenance", "Maintenance.Execute", "Maintenance.View") && CanManageThisTool;
    private bool CanManageSafePractices => Auth.HasAnyPermission("TechnicalLifeRecord.SafePractices", "SafePractices.Manage", "SafePractices.View") && CanManageThisTool;

    private bool HasAnyManagementPermission =>
        Auth.HasAnyPermission(
            "TechnicalLifeRecord.Edit",
            "TechnicalLifeRecord.Accessories",
            "TechnicalLifeRecord.Documents",
            "TechnicalLifeRecord.Maintenance",
            "TechnicalLifeRecord.SafePractices",
            "Documents.Upload",
            "Maintenance.Execute",
            "SafePractices.Manage");

    private bool CanSeeThisTool => tool is not null && IsToolVisible(tool);
    private bool CanManageThisTool => tool is not null && HasAnyManagementPermission && IsToolVisibleByScopeOnly(tool);

    private string PermissionMode => CanManageThisTool ? "Gestiona" : "Consulta";

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();

        if (!Auth.IsAuthenticated)
        {
            isLoading = false;
            return;
        }

        var refreshedUser = await Api.RefreshCurrentSessionAsync();

        if (refreshedUser is null || !Auth.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        if (!CanViewLifeRecord)
        {
            isLoading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;
            message = null;

            tool = await Api.GetToolByIdAsync(ToolId);
            life = await Api.GetTechnicalLifeRecordAsync(ToolId);

            if (!CanSeeThisTool)
            {
                message = "No tienes permiso para consultar esta hoja de vida por sede, responsable o alcance.";
                life = null;
                return;
            }

            accessories = await Api.GetListJsonAsync<MobileAccessoryDto>($"api/tools/{ToolId}/accessories");
            documents = await Api.GetListJsonAsync<MobileDocumentDto>($"api/tools/{ToolId}/documents");
            maintenance = await Api.GetListJsonAsync<MobileMaintenanceScheduleDto>($"api/tools/{ToolId}/maintenance-schedule");
            safePractices = await Api.GetListJsonAsync<MobileSafePracticeDto>($"api/tools/{ToolId}/safe-practices");

            LoadTechnicalForm();

            if (!safePractices.Any())
            {
                safePracticeForm.SortOrder = 1;
            }
            else if (!editingSafePracticeId.HasValue)
            {
                safePracticeForm.SortOrder = safePractices.Max(x => x.SortOrder) + 1;
            }

            ApplyMaintenanceQueryMode();
        }
        catch (Exception ex)
        {
            message = $"No se pudo cargar la hoja de vida: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }


    private void ApplyMaintenanceQueryMode()
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;

        var shouldOpenMaintenance =
            QueryHas(query, "section", "maintenance") ||
            QueryHas(query, "section", "cronograma") ||
            QueryHas(query, "from", "maintenance-plans");

        var shouldEditMaintenance =
            QueryHas(query, "edit", "maintenance") ||
            QueryHas(query, "mode", "edit") ||
            QueryHas(query, "open", "maintenance-edit");

        if (!shouldOpenMaintenance && !shouldEditMaintenance)
        {
            return;
        }

        forceOpenMaintenanceSection = true;

        if (shouldEditMaintenance && CanManageMaintenance)
        {
            CloseAllEditModes();
            editMaintenanceMode = true;
            CancelMaintenanceEdit(false);
            message = "Cronograma de mantenimiento abierto para edición.";
        }
        else if (shouldEditMaintenance && !CanManageMaintenance)
        {
            message = "Puedes consultar el cronograma, pero no tienes permiso para editarlo.";
        }
    }

    private static bool QueryHas(string? query, string key, string expected)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return false;
        }

        var clean = query.TrimStart('?');

        foreach (var part in clean.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            var currentKey = Uri.UnescapeDataString(pair[0] ?? string.Empty);
            var currentValue = pair.Length > 1 ? Uri.UnescapeDataString(pair[1]) : string.Empty;

            if (string.Equals(currentKey, key, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(currentValue, expected, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }


    private void BeginInfoEdit()
    {
        CloseAllEditModes();
        LoadTechnicalForm();
        editInfoMode = true;
    }

    private void BeginTechnicalEdit()
    {
        CloseAllEditModes();
        LoadTechnicalForm();
        editTechnicalMode = true;
    }

    private void BeginAccessoriesEdit()
    {
        CloseAllEditModes();
        editAccessoriesMode = true;
        CancelAccessoryEdit(false);
    }

    private void BeginDocumentsEdit()
    {
        CloseAllEditModes();
        editDocumentsMode = true;
        selectedFile = null;
        documentForm = new DocumentForm { DocumentType = "TechnicalDocument" };
    }

    private void BeginMaintenanceEdit()
    {
        forceOpenMaintenanceSection = true;
        CloseAllEditModes();
        editMaintenanceMode = true;
        CancelMaintenanceEdit(false);
    }

    private void BeginSafePracticesEdit()
    {
        CloseAllEditModes();
        editSafePracticesMode = true;
        CancelSafePracticeEdit(false);
    }

    private void CloseAllEditModes()
    {
        editInfoMode = false;
        editTechnicalMode = false;
        editAccessoriesMode = false;
        editDocumentsMode = false;
        editMaintenanceMode = false;
        editSafePracticesMode = false;
    }

    private void CancelInfoEdit()
    {
        LoadTechnicalForm();
        editInfoMode = false;
        message = null;
    }

    private void CancelTechnicalEdit()
    {
        LoadTechnicalForm();
        editTechnicalMode = false;
        message = null;
    }

    private void CancelAccessoriesSection()
    {
        editAccessoriesMode = false;
        CancelAccessoryEdit(false);
        message = null;
    }

    private void CancelDocumentsSection()
    {
        editDocumentsMode = false;
        selectedFile = null;
        documentForm = new DocumentForm { DocumentType = "TechnicalDocument" };
        message = null;
    }

    private void CancelMaintenanceSection()
    {
        editMaintenanceMode = false;
        forceOpenMaintenanceSection = true;
        CancelMaintenanceEdit(false);
        message = null;
    }

    private void CancelSafePracticesSection()
    {
        editSafePracticesMode = false;
        CancelSafePracticeEdit(false);
        message = null;
    }

    private void LoadTechnicalForm()
    {
        if (life is null)
        {
            return;
        }

        technicalForm = new TechnicalEditModel
        {
            Brand = life.EquipmentInformation.Brand,
            Model = life.EquipmentInformation.Model,
            SerialNumber = life.EquipmentInformation.SerialNumber,
            FixedAssetCode = life.EquipmentInformation.FixedAssetCode,
            FenixCode = life.EquipmentInformation.FenixCode,
            AcquisitionDate = life.EquipmentInformation.AcquisitionDate?.Date,

            Voltage = life.TechnicalSpecifications.Voltage,
            LoadCapacity = life.TechnicalSpecifications.LoadCapacity,
            Provider = life.TechnicalSpecifications.Provider,
            HasWarranty = life.Warranty.HasWarranty,
            WarrantyType = life.Warranty.WarrantyType,

            UsefulLifeStartDate = life.UsefulLife.StartDate?.Date,
            UsefulLifeMonths = life.UsefulLife.UsefulLifeMonths,
            UsefulLifeDays = life.UsefulLife.UsefulLifeDays,

            LastMaintenanceDate = life.MaintenancePlan.LastMaintenanceDate?.Date,
            NextMaintenanceDate = life.MaintenancePlan.NextMaintenanceDate?.Date,
            MaintenancePeriodMonths = life.MaintenancePlan.MaintenancePeriodMonths,

            RequiresMaintenance = life.TechnicalSpecifications.RequiresMaintenance,
            RequiresPreOperationalCheck = life.TechnicalSpecifications.RequiresPreOperationalCheck,
            RequiresCertification = life.TechnicalSpecifications.RequiresCertification,
            CertificationExpirationDate = life.TechnicalSpecifications.CertificationExpirationDate?.Date,

            UpdatedBy = Auth.CurrentUser?.UserName,
            Observation = "Actualización desde app móvil."
        };
    }

    private async Task SaveTechnicalAsync()
    {
        if (!CanEditTechnical)
        {
            message = "No tienes permiso para editar datos técnicos.";
            return;
        }

        await RunSaveAsync(async () =>
        {
            technicalForm.UpdatedBy = Auth.CurrentUser?.UserName;
            await Api.SendJsonAsync(HttpMethod.Patch, $"api/tools/{ToolId}/technical-data", technicalForm);
            editInfoMode = false;
            editTechnicalMode = false;
            message = "Datos técnicos actualizados correctamente.";
        });
    }

    private async Task SaveAccessoryAsync()
    {
        if (!CanManageAccessories)
        {
            message = "No tienes permiso para gestionar accesorios.";
            return;
        }

        if (string.IsNullOrWhiteSpace(accessoryForm.Name))
        {
            message = "El nombre del accesorio es obligatorio.";
            return;
        }

        await RunSaveAsync(async () =>
        {
            if (editingAccessoryId.HasValue)
            {
                await Api.SendJsonAsync(HttpMethod.Put, $"api/tools/accessories/{editingAccessoryId.Value}", new
                {
                    name = accessoryForm.Name,
                    quantity = accessoryForm.Quantity <= 0 ? 1 : accessoryForm.Quantity,
                    requiresMaintenance = accessoryForm.RequiresMaintenance,
                    isMeasurementEquipment = accessoryForm.IsMeasurementEquipment,
                    observation = accessoryForm.Observation,
                    updatedBy = Auth.CurrentUser?.UserName
                });

                message = "Accesorio actualizado correctamente.";
            }
            else
            {
                await Api.SendJsonAsync(HttpMethod.Post, $"api/tools/{ToolId}/accessories", new
                {
                    name = accessoryForm.Name,
                    quantity = accessoryForm.Quantity <= 0 ? 1 : accessoryForm.Quantity,
                    requiresMaintenance = accessoryForm.RequiresMaintenance,
                    isMeasurementEquipment = accessoryForm.IsMeasurementEquipment,
                    observation = accessoryForm.Observation,
                    createdBy = Auth.CurrentUser?.UserName
                });

                message = "Accesorio creado correctamente.";
            }

            CancelAccessoryEdit(false);
        });
    }

    private void StartAccessoryEdit(MobileAccessoryDto item)
    {
        editAccessoriesMode = true;
        editingAccessoryId = item.Id;

        accessoryForm = new AccessoryForm
        {
            Name = item.Name,
            Quantity = item.Quantity <= 0 ? 1 : item.Quantity,
            RequiresMaintenance = item.RequiresMaintenance,
            IsMeasurementEquipment = item.IsMeasurementEquipment,
            Observation = item.Observation
        };
    }

    private void CancelAccessoryEdit(bool clearMessage = true)
    {
        editingAccessoryId = null;
        accessoryForm = new AccessoryForm { Quantity = 1 };

        if (clearMessage)
        {
            message = null;
        }
    }

    private async Task DeleteAccessoryAsync(MobileAccessoryDto item)
    {
        if (!CanManageAccessories)
        {
            return;
        }

        await RunSaveAsync(async () =>
        {
            await Api.SendJsonAsync(HttpMethod.Delete, $"api/tools/accessories/{item.Id}?deletedBy={Uri.EscapeDataString(Auth.CurrentUser?.UserName ?? "mobile")}");
            message = "Accesorio desactivado correctamente.";
        });
    }

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
        message = null;
    }

    private async Task UploadDocumentAsync()
    {
        if (!CanManageDocuments)
        {
            message = "No tienes permiso para gestionar documentos.";
            return;
        }

        if (selectedFile is null)
        {
            message = "Debe seleccionar un archivo para guardar.";
            return;
        }

        await RunSaveAsync(async () =>
        {
            await Api.UploadToolDocumentAsync(
                ToolId,
                selectedFile,
                documentForm.DocumentType ?? "Other",
                documentForm.Description,
                Auth.CurrentUser?.UserName,
                MaxFileSize);

            selectedFile = null;
            documentForm = new DocumentForm { DocumentType = "TechnicalDocument" };
            editDocumentsMode = false;
            message = "Documento cargado correctamente.";
        });
    }

    private async Task DeleteDocumentAsync(MobileDocumentDto item)
    {
        if (!CanManageDocuments)
        {
            return;
        }

        await RunSaveAsync(async () =>
        {
            await Api.SendJsonAsync(HttpMethod.Delete, $"api/tools/documents/{item.Id}?deletedBy={Uri.EscapeDataString(Auth.CurrentUser?.UserName ?? "mobile")}");
            message = "Documento desactivado correctamente.";
        });
    }

    private async Task SaveMaintenanceAsync()
    {
        if (!CanManageMaintenance)
        {
            message = "No tienes permiso para gestionar mantenimiento.";
            return;
        }

        await RunSaveAsync(async () =>
        {
            var payload = new
            {
                maintenanceNumber = maintenanceForm.MaintenanceNumber,
                type = maintenanceForm.Type,
                status = maintenanceForm.Status,
                scheduledAt = maintenanceForm.ScheduledAt,
                startedAt = maintenanceForm.StartedAt,
                finishedAt = maintenanceForm.FinishedAt,
                provider = maintenanceForm.Provider,
                technician = maintenanceForm.Technician,
                description = maintenanceForm.Description,
                maintenanceActivities = maintenanceForm.MaintenanceActivities,
                executionNotes = maintenanceForm.ExecutionNotes,
                invoiceNumber = maintenanceForm.InvoiceNumber,
                responsibleName = maintenanceForm.ResponsibleName,
                responsiblePosition = maintenanceForm.ResponsiblePosition,
