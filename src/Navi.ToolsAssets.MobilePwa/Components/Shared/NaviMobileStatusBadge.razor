@using System.Collections.Generic
@using Microsoft.AspNetCore.Components

<span @attributes="AdditionalAttributes"
      class="@CssClass"
      aria-label="@ResolvedLabel"
      title="@ResolvedLabel"
      data-ntx-component="mobile-status-badge"
      data-ntx-status="@Status"
      data-ntx-tone="@ResolvedTone"
      data-ntx-size="@NormalizedSize">
    @if (ShowDot)
    {
        <span class="navi-mobile-status-badge__dot"
              aria-hidden="true"></span>
    }

    <span class="navi-mobile-status-badge__label">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @ResolvedLabel
        }
    </span>
</span>

@code {
    /// <summary>
    /// Estado técnico o texto de estado.
    /// Ejemplo: Available, Assigned o PendingValidation.
    /// </summary>
    [Parameter]
    public string? Status { get; set; }

    /// <summary>
    /// Texto visual opcional. Cuando no se define,
    /// el componente traduce el estado al español.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Tamaño normal, small/sm o large/lg.
    /// </summary>
    [Parameter]
    public string Size { get; set; } = "normal";

    /// <summary>
    /// Permite ocultar el indicador circular.
    /// </summary>
    [Parameter]
    public bool ShowDot { get; set; } = true;

    /// <summary>
    /// Clases CSS adicionales.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Contenido personalizado conservando el tono del estado.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>?
        AdditionalAttributes { get; set; }

    private string ResolvedLabel =>
        !string.IsNullOrWhiteSpace(Label)
            ? Label.Trim()
            : NaviMobileStatusLabels.ToSpanish(Status);

    private string ResolvedTone =>
        NaviMobileStatusLabels.Tone(Status);

    private string NormalizedSize =>
        Size?.Trim().ToLowerInvariant() switch
        {
            "small" or "sm" or "compact" => "sm",
            "large" or "lg" => "lg",
            _ => "normal"
        };

    private string CssClass
    {
        get
        {
            var classes = new List<string>
            {
                NaviMobileStatusLabels.BadgeClass(Status)
            };

            if (NormalizedSize is not "normal")
            {
                classes.Add(
                    $"navi-mobile-status-badge--{NormalizedSize}");
            }

            if (!ShowDot)
            {
                classes.Add(
                    "navi-mobile-status-badge--without-dot");
            }

            if (!string.IsNullOrWhiteSpace(Class))
            {
                classes.Add(Class.Trim());
            }

            return string.Join(" ", classes);
        }
    }
}
