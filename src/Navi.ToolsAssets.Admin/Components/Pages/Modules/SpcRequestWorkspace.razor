    private bool IsQuotationLineSelected(
        Guid? lineId)
    {
        var selectedValue =
            quoteForm.LineIdText?.Trim()
            ??
            string.Empty;

        if (!lineId.HasValue)
        {
            return
                CanQuoteWholeRequest
                &&
                string.IsNullOrWhiteSpace(
                    selectedValue);
        }

        return
            Guid.TryParse(
                selectedValue,
                out var selectedId)
            &&
            selectedId
            ==
            lineId.Value;
    }


