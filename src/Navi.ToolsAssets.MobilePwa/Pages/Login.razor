@page "/login"

@inject NaviMobileApiClient Api
@inject MobileAuthSessionService Auth
@inject NavigationManager Navigation

<PageTitle>Ingreso móvil - Navitrans Herramientas y Activos</PageTitle>

<section class="navi-mobile-login-v8">
    <div class="navi-mobile-login-v7 navi-mobile-login-v8__access-panel">
    <main class="navi-mobile-login-v7__container">
        <header class="navi-mobile-login-v7__brand"
                aria-label="40 años Navitrans">
            <div class="navi-mobile-login-v7__anniversary"
                 aria-hidden="true">
                <strong>40</strong>

                <span>años</span>
            </div>

            <span class="navi-mobile-login-v7__divider"
                  aria-hidden="true">
            </span>

            <div class="navi-mobile-login-v7__brand-copy">
                <strong>Navitrans</strong>
            </div>
        </header>

        <section class="navi-mobile-login-v7__access"
                 aria-labelledby="navi-mobile-login-title">
            <header class="navi-mobile-login-v7__heading">
                <span class="navi-mobile-login-v7__eyebrow">
                    HERRAMIENTAS Y ACTIVOS
                </span>

                <h1 id="navi-mobile-login-title">
                    Bienvenido
                </h1>

                <p>
                    Ingresa tus credenciales para continuar.
                </p>
            </header>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="@MobileLoginAlertCssClass"
                     role="alert"
                     aria-live="assertive"
                     aria-atomic="true">
                    <div class="navi-mobile-login-v7__alert-copy">
                        <strong>@messageTitle</strong>

                        <span>@message</span>
                    </div>

                    <button type="button"
                            class="navi-mobile-login-v7__alert-close"
                            aria-label="Cerrar mensaje"
                            title="Cerrar mensaje"
                            @onclick="DismissMobileLoginAlert">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
            }
<EditForm Model="model"
                      OnValidSubmit="LoginAsync">
                <div class="navi-mobile-login-v7__form">
                    <div class="navi-mobile-login-v7__field">
                        <label for="naviMobileLoginUser">
                            Número de documento o usuario
                        </label>

                        <div class="navi-mobile-login-v7__input-frame">
                            <span class="navi-mobile-login-v7__input-code"
                                  aria-hidden="true">
                                ID
                            </span>

                            <InputText id="naviMobileLoginUser"
                                       class="navi-mobile-login-v7__input"
                                       @bind-Value="model.UserName"
                                       autocomplete="username"
                                       autocapitalize="none"
                                       spellcheck="false"
                                       placeholder="Número de documento"
                                       aria-label="Número de documento o usuario"
                                       autofocus />
                        </div>
                    </div>

                    <div class="navi-mobile-login-v7__field">
                        <label for="naviMobileLoginPassword">
                            Contraseña
                        </label>

                        <div class="navi-mobile-login-v7__input-frame
                                    navi-mobile-login-v7__input-frame--password">
                            <span class="navi-mobile-login-v7__input-code"
                                  aria-hidden="true">
                                CL
                            </span>

                            <InputText id="naviMobileLoginPassword"
                                       class="navi-mobile-login-v7__input"
                                       type="@PasswordInputType"
                                       @bind-Value="model.Password"
                                       autocomplete="current-password"
                                       placeholder="Contraseña"
                                       aria-label="Contraseña" />

                            <button type="button"
                                    class="navi-mobile-login-v7__password-toggle"
                                    aria-label="@PasswordToggleLabel"
                                    aria-pressed="@showPassword"
                                    title="@PasswordToggleLabel"
                                    data-ntx-tone="secondary"
                                    @onclick="TogglePasswordVisibility">
                                <svg class="navi-mobile-login-v7__password-icon"
                                     viewBox="0 0 24 24"
                                     aria-hidden="true"
                                     focusable="false">
                                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6S2.5 12 2.5 12Z"></path>
                                    <circle cx="12"
                                            cy="12"
                                            r="2.75"></circle>

                                    @if (showPassword)
                                    {
                                        <path class="navi-mobile-login-v7__password-slash"
                                              d="M4 4l16 16"></path>
                                    }
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="navi-mobile-login-v7__help">
                        <span>
                            Acceso autorizado para usuarios Navitrans.
                        </span>
                    </div>

                    <div class="navi-mobile-login-v7__actions">
                        <NaviMobileActionButton
                            Type="submit"
                            Tone="operation"
                            Class="navi-mobile-login-v7__submit"
                            Disabled="@isLoading"
                            Block="true">
                            @if (isLoading)
                            {
                                <span class="navi-mobile-login-v7__loading"
                                      aria-hidden="true">
                                </span>

                                <span>Ingresando...</span>
                            }
                            else
                            {
                                <span>Ingresar</span>
                            }
                        </NaviMobileActionButton>
                    </div>
                </div>
            </EditForm>
        </section>

        <footer class="navi-mobile-login-v7__footer">
            <div class="navi-mobile-login-v7__footer-mark"
                 aria-hidden="true">
                N
            </div>

            <div>
                <strong>Navitrans</strong>
                <span>Herramientas y Activos · Aplicación móvil</span>
            </div>
        </footer>
    </main>
    </div>

    <MobileLoginBrandMedia />
</section>

@code {
    private LoginForm model = new();

    private bool isLoading;
    private bool showPassword;
    private string? message;
    // NAVI MOBILE LOGIN ALERT STATE START
    private string messageTitle = "No fue posible ingresar";

    private string messageTone = "danger";

    private string MobileLoginAlertCssClass =>
        $"navi-mobile-login-v7__alert navi-mobile-login-v7__alert--compact navi-mobile-login-v7__alert--{messageTone}";
    // NAVI MOBILE LOGIN ALERT STATE END

    private string PasswordInputType =>
        showPassword
            ? "text"
            : "password";

    private string PasswordToggleLabel =>
        showPassword
            ? "Ocultar contraseña"
            : "Mostrar contraseña";

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();

        if (Auth.IsAuthenticated)
        {
            Navigation.NavigateTo(
                "/",
                replace: true);
        }
    }

    private async Task LoginAsync()
    {
        DismissMobileLoginAlert();

        var normalizedUserName =
            model.UserName?.Trim();

        if (string.IsNullOrWhiteSpace(
                normalizedUserName))
        {
            SetMobileLoginAlert(
                "Completa los datos",
                "Ingresa tu documento o usuario.",
                "warning");

            return;
        }

        if (string.IsNullOrWhiteSpace(
                model.Password))
        {
            SetMobileLoginAlert(
                "Completa los datos",
                "Ingresa tu contraseña.",
                "warning");

            return;
        }

        isLoading = true;

        try
        {
            /*
             * El usuario se normaliza, pero la contraseña
             * se envía exactamente como fue escrita.
             */
            await Api.LoginAsync(
                normalizedUserName,
                model.Password);



            model.Password =
                null;

            Navigation.NavigateTo(
                "/",
                replace: true);
        }
        catch (InvalidOperationException ex)
        {
            var alert =
                BuildMobileLoginError(
                    ex.Message);

            SetMobileLoginAlert(
                alert.Title,
                alert.Message,
                alert.Tone);

            /*
             * Se conserva el usuario y solamente se limpia
             * la contraseña incorrecta.
             */
            model.Password =
                null;
        }
        catch (HttpRequestException)
        {
            SetMobileLoginAlert(
                "Servicio no disponible",
                "No se pudo conectar con el servicio de acceso.",
                "danger");
        }
        catch (TaskCanceledException)
        {
            SetMobileLoginAlert(
                "La conexión tardó demasiado",
                "Inténtalo nuevamente en unos segundos.",
                "warning");
        }
        catch
        {
            SetMobileLoginAlert(
                "No fue posible ingresar",
                "Ocurrió un inconveniente. Inténtalo nuevamente.",
                "danger");
        }
        finally
        {
            isLoading = false;
        }
    }

    // NAVI MOBILE LOGIN ALERT HELPERS START
    private void SetMobileLoginAlert(
        string title,
        string text,
        string tone)
    {
        messageTitle =
            string.IsNullOrWhiteSpace(title)
                ? "No fue posible ingresar"
                : title.Trim();

        message =
            string.IsNullOrWhiteSpace(text)
                ? "Verifica los datos e inténtalo nuevamente."
                : text.Trim();

        messageTone =
            string.Equals(
                tone,
                "warning",
                StringComparison.OrdinalIgnoreCase)
                ? "warning"
                : "danger";
    }

    private void DismissMobileLoginAlert()
    {
        message = null;
        messageTitle = "No fue posible ingresar";
        messageTone = "danger";
    }

    private static (
        string Title,
        string Message,
        string Tone)
        BuildMobileLoginError(
            string? rawMessage)
    {
        if (string.IsNullOrWhiteSpace(
                rawMessage))
        {
            return (
                "Credenciales incorrectas",
                "Verifica tu usuario y contraseña.",
                "danger"
            );
        }

        var normalized =
            rawMessage.Trim();

        if (
            normalized.Contains(
                "usuario o contraseña",
                StringComparison.OrdinalIgnoreCase)
            ||
            normalized.Contains(
                "credenciales",
                StringComparison.OrdinalIgnoreCase)
            ||
            normalized.Contains(
                "unauthorized",
                StringComparison.OrdinalIgnoreCase)
        )
        {
            return (
                "Credenciales incorrectas",
                "Verifica tu usuario y contraseña.",
                "danger"
            );
        }

        if (
            normalized.Contains(
                "usuario no tiene una contraseña",
                StringComparison.OrdinalIgnoreCase)
        )
        {
            return (
                "Contraseña no configurada",
                "Solicita al administrador restablecer tu contraseña.",
                "warning"
            );
        }

        if (
            normalized.Contains(
                "usuario inactivo",
                StringComparison.OrdinalIgnoreCase)
            ||
            normalized.Contains(
                "deshabilitado",
                StringComparison.OrdinalIgnoreCase)
        )
        {
            return (
                "Usuario no disponible",
                "Tu usuario está inactivo. Contacta al administrador.",
                "warning"
            );
        }

        if (
            normalized.StartsWith(
                "{",
                StringComparison.Ordinal)
            ||
            normalized.Contains(
                "HttpRequest",
                StringComparison.OrdinalIgnoreCase)
            ||
            normalized.Contains(
                "Exception",
                StringComparison.OrdinalIgnoreCase)
        )
        {
            return (
                "No fue posible ingresar",
                "Verifica los datos e inténtalo nuevamente.",
                "danger"
            );
        }

        return (
            "No fue posible ingresar",
            normalized,
            "danger"
        );
    }
    // NAVI MOBILE LOGIN ALERT HELPERS END

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private sealed class LoginForm
    {
        public string? UserName { get; set; }

        public string? Password { get; set; }

    }
}
