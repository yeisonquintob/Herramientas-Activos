@page "/Error"
@using System.Diagnostics

<PageTitle>Error - NAVI</PageTitle>

<NaviPageHero Pill="SISTEMA"
              Title="Error inesperado"
              Description="No fue posible completar la solicitud actual. Recarga la vista o vuelve al Dashboard.">
    <a class="btn btn-primary" href="/dashboard">Dashboard</a>
</NaviPageHero>

<section class="admin-standard-card error-standard-card">
    <span class="error-standard-pill">Incidente</span>
    <h2>Ocurrió un error procesando la solicitud</h2>

    @if (ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> <code>@RequestId</code>
        </p>
    }
    else
    {
        <p>El sistema no recibió un identificador de solicitud para este evento.</p>
    }

    <div class="error-standard-actions">
        <a class="btn btn-primary" href="/dashboard">Ir al Dashboard</a>
        <a class="btn btn-outline-secondary" href="/tools">Ir a inventario</a>
    </div>
</section>

<style>
    .error-standard-card {
        padding: 1.2rem;
    }

    .error-standard-pill {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        background: #fff1f2;
        color: #b42318;
        border: 1px solid #fecdca;
        padding: .2rem .62rem;
        font-size: .72rem;
        font-weight: 950;
        margin-bottom: .65rem;
    }

    .error-standard-card h2 {
        color: #111827;
        font-size: 1.45rem;
        font-weight: 950;
        margin: 0 0 .45rem;
    }

    .error-standard-card p {
        color: #5f6b7a;
        font-size: .95rem;
        margin: 0 0 1rem;
    }

    .error-standard-card code {
        color: #111827;
        background: #f7f8fb;
        border: 1px solid #d7dde6;
        border-radius: .38rem;
        padding: .1rem .35rem;
    }

    .error-standard-actions {
        display: flex;
        justify-content: flex-end;
        gap: .5rem;
        flex-wrap: wrap;
    }
</style>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
