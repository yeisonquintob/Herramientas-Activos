/* ============================================================
   NAVI MainLayout limpio
   Evita solapes entre barra lateral y contenido
   ============================================================ */

.navi-layout-shell {
    --navi-sidebar-width: 270px;
    --navi-topbar-height: 54px;
    --navi-footer-height: 30px;

    width: 100%;
    min-height: 100vh;
    background: #ffffff;
}

/* Barra lateral fija */
.navi-sidebar-area {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;

    width: var(--navi-sidebar-width);
    min-width: var(--navi-sidebar-width);
    max-width: var(--navi-sidebar-width);
    height: 100vh;

    overflow: hidden;
    z-index: 1000;
    background: #13001c;
}

/* Área principal: arranca exactamente después del menú */
.navi-main-area {
    position: relative;
    margin-left: var(--navi-sidebar-width);
    width: calc(100% - var(--navi-sidebar-width));
    min-height: 100vh;
    background: #ffffff;

    overflow-x: hidden;
    padding-bottom: calc(var(--navi-footer-height) + 1rem);
}

/* Barra superior */
.navi-top-row {
    position: sticky;
    top: 0;
    z-index: 800;

    height: var(--navi-topbar-height);
    min-height: var(--navi-topbar-height);

    display: flex;
    align-items: center;
    justify-content: flex-end;

    padding: 0 1.4rem;
    background: #ffffff;
    border-bottom: 1px solid #dfe3e8;
    box-shadow: 0 .15rem .45rem rgba(0, 0, 0, .04);
}

.navi-top-row span {
    color: #17111c;
    font-size: .82rem;
    font-weight: 950;
}

/* Contenido */
.navi-content {
    width: 100%;
    max-width: 100%;
    padding: 1rem 1.45rem 3.2rem 1.45rem;
    overflow-x: hidden;
    box-sizing: border-box;
}

/* Footer inferior */
.navi-bottom-bar {
    --navi-sidebar-width: 270px;
    --navi-footer-height: 30px;

    position: fixed;
    left: var(--navi-sidebar-width);
    right: 0;
    bottom: 0;

    height: var(--navi-footer-height);
    min-height: var(--navi-footer-height);

    z-index: 900;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: .35rem;

    background: linear-gradient(90deg, #050008 0%, #4b005c 100%);
    color: #ffffff;
    font-size: .72rem;
    font-weight: 850;
    border-top: 1px solid rgba(255,255,255,.12);
}

.navi-bottom-bar .separator {
    opacity: .7;
}

/* Login */
.login-layout-only {
    min-height: 100vh;
}

/* Error Blazor */
#blazor-error-ui {
    background: #fff3cd;
    bottom: 0;
    box-shadow: 0 -1px 2px rgba(0, 0, 0, .2);
    display: none;
    left: 270px;
    padding: .6rem 1.25rem;
    position: fixed;
    width: calc(100% - 270px);
    z-index: 2000;
}

/* Responsive */
@media (max-width: 800px) {
    .navi-layout-shell {
        --navi-sidebar-width: 100%;
    }

    .navi-sidebar-area {
        position: relative;
        width: 100%;
        min-width: 100%;
        max-width: 100%;
        height: auto;
    }

    .navi-main-area {
        margin-left: 0;
        width: 100%;
    }

    .navi-bottom-bar {
        left: 0;
    }

    #blazor-error-ui {
        left: 0;
        width: 100%;
    }
}

