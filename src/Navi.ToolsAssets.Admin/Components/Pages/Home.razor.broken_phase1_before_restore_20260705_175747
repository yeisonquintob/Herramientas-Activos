    private static async Task<decimal> LoadDashboardCostTotalAsync(HttpClient client, string endpoint)
    {
        try
        {
            using var response = await client.GetAsync(endpoint);

            if (!response.IsSuccessStatusCode)
            {
                return 0;
            }

            await using var stream = await response.Content.ReadAsStreamAsync();
            using var document = await JsonDocument.ParseAsync(stream);

            if (document.RootElement.ValueKind != JsonValueKind.Array)
            {
                return 0;
            }

            decimal total = 0;

            foreach (var item in document.RootElement.EnumerateArray())
            {
                var status = GetDashboardJsonString(item, "Status", "status", "State", "state", "StatusText", "statusText");
                var costText = GetDashboardJsonString(
                    item,
                    "EstimatedCostText",
                    "estimatedCostText",
                    "Cost",
                    "cost",
                    "Total",
                    "total",
                    "TotalBeforeTax",
                    "totalBeforeTax",
                    "PriceBeforeVat",
                    "priceBeforeVat");

                var cost = ParseDashboardMoney(costText);

                if (cost > 0 && IsDashboardPositiveCostStatus(status))
                {
                    total += cost;
                }
            }

            return total;
        }
        catch
        {
            return 0;
        }
    }

    private static string? GetDashboardJsonString(JsonElement element, params string[] names)
    {
        if (element.ValueKind != JsonValueKind.Object)
        {
            return null;
        }

        foreach (var name in names)
        {
            if (!element.TryGetProperty(name, out var property))
            {
                continue;
            }

            if (property.ValueKind == JsonValueKind.String)
            {
                return property.GetString();
            }

            if (property.ValueKind == JsonValueKind.Number)
            {
                return property.ToString();
            }
        }

        return null;
    }

    private static bool IsDashboardPositiveCostStatus(string? status)
    {
        var value = NormalizeDashboardStatus(status);

        return value is "Approved"
            or "Scheduled"
            or "InExecution"
            or "Executed"
            or "Completed"
            or "Closed"
            or "Generated"
            or "SentToDynamics";
    }

    private static string NormalizeDashboardStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return string.Empty;
        }

        return status.Trim() switch
        {
            "Aprobado" => "Approved",
            "Aprobada" => "Approved",
            "Programado" => "Scheduled",
            "Programada" => "Scheduled",
            "En ejecución" => "InExecution",
            "Ejecutado" => "Executed",
            "Ejecutada" => "Executed",
            "Completado" => "Completed",
            "Completada" => "Completed",
            "Cerrado" => "Closed",
            "Cerrada" => "Closed",
            "Generado" => "Generated",
            "Generada" => "Generated",
            "Enviado a Dynamics" => "SentToDynamics",
            _ => status.Trim()
        };
    }

    private static decimal ParseDashboardMoney(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return 0;
        }

        var cleaned = Regex.Replace(value, @"[^0-9,\.\-]", string.Empty);

        if (string.IsNullOrWhiteSpace(cleaned))
        {
            return 0;
        }

        var comma = cleaned.LastIndexOf(',');
        var dot = cleaned.LastIndexOf('.');

        if (comma >= 0 && dot >= 0)
        {
            cleaned = comma > dot
                ? cleaned.Replace(".", string.Empty).Replace(",", ".")
                : cleaned.Replace(",", string.Empty);
        }
        else if (dot >= 0)
        {
            var decimals = cleaned.Length - dot - 1;

            if (decimals == 3)
            {
                cleaned = cleaned.Replace(".", string.Empty);
            }
        }
        else if (comma >= 0)
        {
            var decimals = cleaned.Length - comma - 1;

            cleaned = decimals == 3
                ? cleaned.Replace(",", string.Empty)
                : cleaned.Replace(",", ".");
        }

        return decimal.TryParse(cleaned, NumberStyles.Number, CultureInfo.InvariantCulture, out var result)
            ? result
            : 0;
    }

    private string BuildDashboardEndpoint()
    {
        var query = new List<string>();

        AddDashboardQuery(query, "branchCode", filterBranchCode);
        AddDashboardQuery(query, "operationalStatus", filterOperationalStatus);
        AddDashboardQuery(query, "q", filterText);

        return query.Count == 0
            ? "api/dashboard/executive"
            : $"api/dashboard/executive?{string.Join("&", query)}";
    }

    private static void AddDashboardQuery(List<string> query, string key, string? value)
