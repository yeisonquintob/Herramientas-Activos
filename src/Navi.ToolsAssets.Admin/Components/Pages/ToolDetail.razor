@page "/tools/{ToolId:guid}"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.Text.Json
@using Navi.ToolsAssets.Admin.Services.Auth
@using Navi.ToolsAssets.Admin.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject WebAuthSessionService AuthSession

<PageTitle>Detalle herramienta - NAVI Herramientas</PageTitle>



@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @errorMessage
    </div>
}

@if (isLoading && tool is null)
{
    <div class="alert alert-info">
        Cargando detalle de la herramienta...
    </div>
}
else if (tool is not null)
{
    <section class="tool-detail-web-v26 tool-detail-web-v30">

        <NaviPageHero
        Pill="ACTIVOS FIJOS"
        Title="@tool!.Name"
        Description="Consulta visual de datos maestros, ubicación, clasificación, estados y hoja de vida operativa.">
</NaviPageHero>


@* NAVI TOOL DETAIL KPI STANDARD V67 START *@

<div class="tool-detail-standard-row-v67
            navi-inventory-web-v23">

    <NaviKpiToolbar
        Class="tool-detail-standard-toolbar-v67"
        Refresh="LoadAsync"
        IsRefreshing="isLoading"
        RefreshTitle="Actualizar información"
        RefreshAriaLabel="Actualizar información">

        <NaviKpiGrid
            Columns="4"
            Compact="true"
            Dividers="true"
            Class="navi-inventory-v23-kpis
                   tool-detail-standard-kpis-v67">

            <NaviKpiCard
                Title="Código interno"
                Description="Identificación del activo"
                Tone="neutral"
                Compact="true"
                Class="metric-total
                       tool-detail-standard-text-v67">

                <IconContent>

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">

                        <path d="M4 7H20V20H4Z"></path>
                        <path d="M8 7V4H16V7"></path>
                        <path d="M8 11H16"></path>
                        <path d="M8 15H14"></path>

                    </svg>

                </IconContent>

                <ValueContent>
                    @ShowValue(tool.InternalCode)
                </ValueContent>

            </NaviKpiCard>

            <NaviKpiCard
                Title="Estado operativo"
                Description="Situación actual"
                Tone="soft"
                Compact="true"
                Class="metric-in-use
                       tool-detail-standard-status-v67">

                <IconContent>

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">

                        <path d="M7 7H18"></path>
                        <path d="M15 4L18 7L15 10"></path>
                        <path d="M17 17H6"></path>
                        <path d="M9 14L6 17L9 20"></path>

                    </svg>

                </IconContent>

                <ValueContent>
                    @GetStatusLabel(tool.OperationalStatus)
                </ValueContent>

            </NaviKpiCard>

            <NaviKpiCard
                Title="Clasificación"
                Description="Tipo de operación"
                Tone="soft"
                Compact="true"
                Class="metric-validation
                       tool-detail-standard-text-v67">

                <IconContent>

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">

                        <path d="M6 3H15L19 7V21H6Z"></path>
                        <path d="M15 3V8H19"></path>
                        <path d="M9 13H16"></path>
                        <path d="M9 17H13"></path>

                    </svg>

                </IconContent>

                <ValueContent>
                    @(tool.IsSpecialized
                        ? "Especializada"
                        : "No especializada")
                </ValueContent>

            </NaviKpiCard>

            <NaviKpiCard
                Title="Responsable"
                Description="Custodia registrada"
                Tone="neutral"
                Compact="true"
                Class="metric-total
                       tool-detail-standard-text-v67">

                <IconContent>
                    <NaviKpiIcon Name="users" />
                </IconContent>

                <ValueContent>
                    @ShowValue(tool.ResponsiblePersonName)
                </ValueContent>

            </NaviKpiCard>

        </NaviKpiGrid>

    </NaviKpiToolbar>

    <NaviActionButton
        Tone="secondary"
        Size="small"
        Class="tool-detail-standard-back-v67"
        OnClick="GoBack"
        aria-label="Volver al inventario">

        <StartContent>

            <svg viewBox="0 0 24 24"
                 aria-hidden="true"
                 focusable="false">

                <path d="M19 12H5"></path>
                <path d="M11 6L5 12L11 18"></path>

            </svg>

        </StartContent>

        <ChildContent>
            Volver al inventario
        </ChildContent>

    </NaviActionButton>

</div>

@* NAVI TOOL DETAIL KPI STANDARD V67 END *@


<section class="tool-detail-panel
                            tool-admin-control
                            tool-admin-control-v30">

        <header class="tool-admin-control-header-v30">

            <div>
                <span class="tool-detail-section-label-v30">
                    ADMINISTRACIÓN
                </span>

                <h2>Control administrativo del activo</h2>

                <p>
                    Consulta o modifica los datos maestros del activo
                    según los permisos asignados.
                </p>
            </div>
        </header>

        @if (isEditingMasterData)
        {
            <div class="admin-edit-grid
                        admin-edit-grid-v30">

                <div>
                    <label for="tool-edit-internal-code">
                        Código interno
                    </label>

                    <input id="tool-edit-internal-code"
                           name="tool-edit-internal-code"
                           class="form-control"
                           @bind="editModel.InternalCode" />
                </div>

                <div>
                    <label for="tool-edit-name">
                        Nombre
                    </label>

                    <input id="tool-edit-name"
                           name="tool-edit-name"
                           class="form-control"
                           @bind="editModel.Name" />
                </div>

                <div>
                    <label for="tool-edit-serial">
                        Serial
                    </label>

                    <input id="tool-edit-serial"
                           name="tool-edit-serial"
                           class="form-control"
                           @bind="editModel.SerialNumber" />
                </div>

                <div>
                    <label for="tool-edit-fixed-asset">
                        Activo fijo
                    </label>

                    <input id="tool-edit-fixed-asset"
                           name="tool-edit-fixed-asset"
                           class="form-control"
                           @bind="editModel.FixedAssetCode" />
                </div>

                <div>
                    <label for="tool-edit-fenix">
                        Código Fenix365
                    </label>

                    <input id="tool-edit-fenix"
                           name="tool-edit-fenix"
                           class="form-control"
                           @bind="editModel.FenixCode" />
                </div>

                <div>
                    <label for="tool-edit-brand">
                        Marca
                    </label>

                    <input id="tool-edit-brand"
                           name="tool-edit-brand"
                           class="form-control"
                           @bind="editModel.Brand" />
                </div>

                <div>
                    <label for="tool-edit-model">
                        Modelo
                    </label>

                    <input id="tool-edit-model"
                           name="tool-edit-model"
                           class="form-control"
                           @bind="editModel.Model" />
                </div>

                <div>
                    <label for="tool-edit-operational-status">
                        Estado operativo
                    </label>

                    <select id="tool-edit-operational-status"
                            name="tool-edit-operational-status"
                            class="form-select"
                            @bind="editModel.OperationalStatus">

                        <option value="Available">Disponible</option>
                        <option value="Assigned">Asignado</option>
                        <option value="Loaned">Prestado</option>
                        <option value="InMaintenance">En mantenimiento</option>
                        <option value="Damaged">Dañado</option>
                        <option value="NotSuitable">No apto</option>
                        <option value="PendingValidation">Pendiente validación</option>
                        <option value="Inconsistent">Inconsistente</option>
                        <option value="NotLocated">No localizado</option>
                        <option value="PendingDisposal">Pendiente baja</option>
                        <option value="Disposed">Dado de baja</option>
                    </select>
                </div>

                <div>
                    <label for="tool-edit-physical-status">
                        Estado físico
                    </label>

                    <select id="tool-edit-physical-status"
                            name="tool-edit-physical-status"
                            class="form-select"
                            @bind="editModel.PhysicalStatus">

                        <option value="Good">Bueno</option>
                        <option value="Regular">Regular</option>
                        <option value="Damaged">Dañado</option>
                        <option value="Lost">Perdido</option>
                        <option value="Incomplete">Incompleto</option>
                    </select>
                </div>

                <label class="tool-edit-check-v30">

                    <input id="tool-edit-specialized"
                           name="tool-edit-specialized"
                           type="checkbox"
                           @bind="editModel.IsSpecialized"
                           disabled="@(!CanMarkSpecialized)" />

                    <span>Activo especializado</span>
                </label>

                <label class="tool-edit-check-v30">

                    <input id="tool-edit-maintenance"
                           name="tool-edit-maintenance"
                           type="checkbox"
                           @bind="editModel.RequiresMaintenance" />

                    <span>Requiere mantenimiento</span>
                </label>

                <label class="tool-edit-check-v30">

                    <input id="tool-edit-preoperational"
                           name="tool-edit-preoperational"
                           type="checkbox"
                           @bind="editModel.RequiresPreOperationalCheck" />

                    <span>Requiere preoperacional</span>
                </label>

                <label class="tool-edit-check-v30">

                    <input id="tool-edit-certification"
                           name="tool-edit-certification"
                           type="checkbox"
                           @bind="editModel.RequiresCertification" />

                    <span>Requiere certificación</span>
                </label>

                <div>
                    <label for="tool-edit-certification-expiration">
                        Vence certificación
                    </label>

                    <InputDate id="tool-edit-certification-expiration"
                               name="tool-edit-certification-expiration"
                               class="form-control"
                               @bind-Value="editModel.CertificationExpirationDate" />
                </div>

                <div>
                    <label for="tool-edit-maintenance-period">
                        Periodo mantenimiento meses
                    </label>

                    <input id="tool-edit-maintenance-period"
                           name="tool-edit-maintenance-period"
                           type="number"
                           min="0"
                           class="form-control"
                           @bind="editModel.MaintenancePeriodMonths" />
                </div>

                <div class="admin-edit-full">

                    <label for="tool-edit-description">
                        Descripción u observación
                    </label>

                    <textarea id="tool-edit-description"
                              name="tool-edit-description"
                              class="form-control"
                              rows="3"
                              @bind="editModel.Description">
                    </textarea>
                </div>
            </div>
        }
        else
        {
            <div class="admin-readonly-note
                        admin-readonly-note-v30">

                <strong>Modo lectura.</strong>

                Presiona <b>Editar</b> para modificar los datos
                maestros del activo.
            </div>
        }

        <footer class="tool-admin-actions-v30">

            @if (!isEditingMasterData)
            {
@if (CanEditTool)
                {
                    <button type="button"
                            class="tool-admin-button-v30
                                   tool-admin-edit-v30"
                            @onclick="StartMasterDataEdit" data-ntx-tone="operation">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true"
                             focusable="false">

                            <path d="M4 20L8.5 19L19 8.5L15.5 5L5 15.5Z"></path>
                            <path d="M13.5 7L17 10.5"></path>
                        </svg>

                        <span>Editar</span>
                    </button>
                }

                @if (CanOpenLifeRecord)
                {
                    <a class="tool-admin-button-v30
                              tool-admin-life-v30"
                       href="@($"/tools/{ToolId}/technical-life-record-view")">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true"
                             focusable="false">

                            <path d="M6 3H15L19 7V21H6Z"></path>
                            <path d="M15 3V8H19"></path>
                            <path d="M9 12H16"></path>
                            <path d="M9 16H16"></path>
                        </svg>

                        <span>Ver hoja de vida técnica</span>
                    </a>
                }
            }
            else
            {
                <button type="button"
                        class="tool-admin-button-v30
                               tool-admin-cancel-v30"
                        @onclick="CancelMasterDataEdit" data-ntx-tone="secondary">

                    Cancelar
                </button>

                <button type="button"
                        class="tool-admin-button-v30
                               tool-admin-save-v30"
                        @onclick="SaveMasterDataAsync" data-ntx-tone="affirmative">

                    Guardar cambios
                </button>
            }
        </footer>
    </section>


    @if (reportedSource?.HasSource == true)
    {
        <section class="tool-detail-panel tool-source-panel">
            <div class="source-header">
                <div>
                    <span class="source-pill">ORIGEN DEL ACTIVO</span>
                    <h2>Origen desde toma física</h2>
                    <p>Este activo fue creado desde un registro reportado durante una toma física.</p>
                </div>
            </div>

            <div class="source-grid">
                <div>
                    <span>Toma física</span>
                    <strong>@DisplaySourceValue(reportedSource.PhysicalCountNumber)</strong>
                </div>

                <div>
                    <span>Participante / reportante</span>
                    <strong>@DisplaySourceValue(reportedSource.ParticipantName)</strong>
                    <small>@DisplaySourceValue(reportedSource.ParticipantUserName)</small>
                </div>

                <div>
                    <span>Código reportado</span>
                    <strong>@DisplaySourceValue(reportedSource.ReportedCode)</strong>
                </div>

                <div>
                    <span>Nombre reportado</span>
                    <strong>@DisplaySourceValue(reportedSource.ReportedName)</strong>
                </div>

                <div>
                    <span>Ubicación encontrada</span>
                    <strong>@DisplaySourceValue(reportedSource.FoundLocation)</strong>
                </div>

                <div>
                    <span>Estado conciliación</span>
                    <strong>@DisplaySourceValue(reportedSource.ReconciliationStatus)</strong>
                    <small>@DisplaySourceValue(reportedSource.ReconciliationObservation)</small>
                </div>

                <div class="source-full">
                    <span>Observación del reporte</span>
                    <strong>@DisplaySourceValue(reportedSource.Observation)</strong>
                </div>
            </div>
        </section>
    }

<div class="tool-detail-grid"><section class="tool-detail-panel tool-detail-v26-main-data">
            <h2>Datos principales</h2>

            <div class="detail-list">
                <div>
                    <span>Código interno</span>
                    <strong>@tool!.InternalCode</strong>
                </div>

                <div>
                    <span>Serial</span>
                    <strong>@ShowValue(tool!.SerialNumber)</strong>
                </div>

                <div>
                    <span>Activo fijo</span>
                    <strong>@ShowValue(tool!.FixedAssetCode)</strong>
                </div>

                <div>
                    <span>Código Fenix365</span>
                    <strong>@ShowValue(tool!.FenixCode)</strong>
                </div>

                <div>
                    <span>Marca</span>
                    <strong>@ShowValue(tool!.Brand)</strong>
                </div>

                <div>
                    <span>Modelo</span>
                    <strong>@ShowValue(tool!.Model)</strong>
                </div>
            </div>
        </section>

        <section class="tool-detail-panel tool-detail-v26-location">
            <h2>Ubicación y clasificación</h2>

            <div class="detail-list">
                <div>
                    <span>Sede</span>
                    <strong>@ShowValue(tool!.BranchCode) - @ShowValue(tool!.BranchName)</strong>
                </div>

                <div>
                    <span>Ubicación</span>
                    <strong>@ShowValue(tool!.LocationCode) - @ShowValue(tool!.LocationName)</strong>
                </div>

                <div>
                    <span>Responsable</span>
                    <strong>@ShowValue(tool!.ResponsiblePersonName)</strong>
                </div>

                <div>
                    <span>Tipo</span>
                    <strong>@ShowValue(tool!.ToolTypeName)</strong>
                </div>

                <div>
                    <span>Categoría</span>
                    <strong>@ShowValue(tool!.ToolCategoryName)</strong>
                </div>

                <div>
                    <span>Unidad / Cantidad</span>
                    <strong>@ShowValue(tool!.UnitOfMeasure) / @tool!.Quantity</strong>
                </div>
            </div>
        </section>
    </div>


    @if (reportedSource?.HasSource == true)
    {
        <section class="tool-detail-panel tool-source-panel">
            <div class="source-header">
                <div>
                    <span class="source-pill">ORIGEN DEL ACTIVO</span>
                    <h2>Origen desde toma física</h2>
                    <p>Este activo fue creado desde un registro reportado durante una toma física.</p>
                </div>
            </div>

            <div class="source-grid">
                <div>
                    <span>Toma física</span>
                    <strong>@DisplaySourceValue(reportedSource.PhysicalCountNumber)</strong>
                </div>

                <div>
                    <span>Participante / reportante</span>
                    <strong>@DisplaySourceValue(reportedSource.ParticipantName)</strong>
                    <small>@DisplaySourceValue(reportedSource.ParticipantUserName)</small>
                </div>

                <div>
                    <span>Código reportado</span>
                    <strong>@DisplaySourceValue(reportedSource.ReportedCode)</strong>
                </div>

                <div>
                    <span>Nombre reportado</span>
                    <strong>@DisplaySourceValue(reportedSource.ReportedName)</strong>
                </div>

                <div>
                    <span>Ubicación encontrada</span>
                    <strong>@DisplaySourceValue(reportedSource.FoundLocation)</strong>
                </div>

                <div>
                    <span>Estado conciliación</span>
                    <strong>@DisplaySourceValue(reportedSource.ReconciliationStatus)</strong>
                    <small>@DisplaySourceValue(reportedSource.ReconciliationObservation)</small>
                </div>

                <div class="source-full">
                    <span>Observación del reporte</span>
                    <strong>@DisplaySourceValue(reportedSource.Observation)</strong>
                </div>
            </div>
        </section>
    }

@* NAVI TOOL DETAIL IMAGE LAYOUT V64 START *@

<div class="tool-detail-operation-layout-v64">

    <div class="tool-detail-operation-column-v64">

@if (CanUseDetailActions)
    {
<section class="tool-detail-panel
                            tool-detail-v26-quick-actions
                            tool-detail-quick-actions-v30">

            <header class="tool-detail-panel-header-v30">

                <div>
                    <span class="tool-detail-section-label-v30">
                        OPERACIÓN
                    </span>

                    <h2>Acciones rápidas</h2>

                    <p>
                        Actualiza el estado operativo o la clasificación
                        del activo según tus permisos.
                    </p>
                </div>
            </header>

            <div class="quick-actions-v30">

                @if (CanChangeOperationalStatus)
                {
                    <div class="quick-action-field-v30">

                        <label for="tool-detail-operational-status">
                            Estado operativo
                        </label>

                        <select id="tool-detail-operational-status"
                                name="tool-detail-operational-status"
                                class="form-select"
                                @bind="selectedOperationalStatus"
                                disabled="@isSaving">

                            <option value="Available">Disponible</option>
                            <option value="PendingValidation">Pendiente validación</option>
                            <option value="Assigned">Asignada</option>
                            <option value="Loaned">Prestada</option>
                            <option value="InMaintenance">En mantenimiento</option>
                            <option value="Damaged">Dañada</option>
                            <option value="NotSuitable">No apta</option>
                            <option value="Inconsistent">Inconsistente</option>
                            <option value="NotLocated">No localizada</option>
                            <option value="PendingDisposal">Pendiente de baja</option>
                            <option value="Disposed">Dada de baja</option>
                        </select>
                    </div>

                    <div class="quick-action-field-v30">

                        <label for="tool-detail-action-observation">

                            Observación

                            @if (OperationalStatusReasonRequired)
                            {
                                <span class="navi-text-danger">
                                    · Obligatoria
                                </span>
                            }
                        </label>

                        <input id="tool-detail-action-observation"
                               name="tool-detail-action-observation"
                               class="form-control"
                               placeholder="Motivo del cambio..."
                               @bind="actionObservation"
                               @bind:event="oninput"
                               disabled="@isSaving"
                               aria-required="@(OperationalStatusReasonRequired ? "true" : "false")" />

                        <!-- NAVI TOOL DETAIL STATUS REASON V31 START -->

                        @if (OperationalStatusReasonRequired)
                        {
                            <small class="navi-text-danger">
                                Para realizar este cambio debes registrar
                                el motivo en la observación.
                            </small>
                        }

                        <!-- NAVI TOOL DETAIL STATUS REASON V31 END -->
                    </div>

                    <div class="quick-action-save-v30">

                        <button type="button"
                                class="tool-detail-save-status-v30"
                                @onclick="ChangeOperationalStatusAsync"
                                disabled="@isSaving" data-ntx-tone="affirmative">

                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true"
                                 focusable="false">

                                <path d="M5 4H17L20 7V20H5Z"></path>
                                <path d="M8 4V10H16V4"></path>
                                <path d="M8 15H17"></path>
                            </svg>

                            <span>
                                @(isSaving
                                    ? "Guardando..."
                                    : "Guardar estado")
                            </span>
                        </button>
                    </div>
                }

                @if (CanMarkSpecialized)
                {
                    <label class="tool-specialized-control-v30">

                        <input type="checkbox"
                               id="tool-specialized-toggle"
                               name="tool-specialized-toggle"
                               checked="@tool.IsSpecialized"
                               @onchange="OnSpecializedToggleChanged"
                               disabled="@isSaving" />

                        <span class="tool-specialized-track-v30"
                              aria-hidden="true">

                            <span class="tool-specialized-thumb-v30">
                            </span>
                        </span>

                        <span class="tool-specialized-copy-v30">

                            <strong>Herramienta especializada</strong>

                            <small>
                                Activa o desactiva la clasificación especial
                                del activo.
                            </small>
                        </span>

                        <b class="tool-specialized-state-v30">

                            @(tool.IsSpecialized
                                ? "Activa"
                                : "Inactiva")
                        </b>
                    </label>
                }

                @if (!string.IsNullOrWhiteSpace(actionMessage))
                {
                    <div class="alert alert-success
                                quick-action-message-v30">

                        @actionMessage
                    </div>
                }
            </div>
        </section>
    }

<section class="tool-detail-panel tool-detail-v26-rules">
            <h2>Reglas operativas</h2>

            <div class="status-chip-grid">
                <div>
                    <span>Mantenimiento</span>
                    <strong>@BoolLabel(tool!.RequiresMaintenance == true)</strong>
                </div>

                <div>
                    <span>Preoperacional</span>
                    <strong>@BoolLabel(tool!.RequiresPreOperationalCheck == true)</strong>
                </div>

                <div>
                    <span>Certificación</span>
                    <strong>@BoolLabel(tool!.RequiresCertification == true)</strong>
                </div>

                <div>
                    <span>Vence certificación</span>
                    <strong>@FormatDate(tool!.CertificationExpirationDate)</strong>
                </div>
            </div>
        </section>

    </div>

    <div class="tool-detail-visual-column-v64">

<section class="tool-detail-panel tool-detail-v26-states">
            <h2>Estados</h2>

            <div class="status-chip-grid">
                <div>
                    <span>Operativo</span>
                    <strong>@GetStatusLabel(tool!.OperationalStatus)</strong>
                </div>

                <div>
                    <span>Físico</span>
                    <strong>@GetDetailStateLabel(tool!.PhysicalStatus)</strong>
                </div>

                <div>
                    <span>Custodia</span>
                    <strong>@GetDetailStateLabel(tool!.CustodyStatus)</strong>
                </div>

                <div>
                    <span>Conciliación</span>
                    <strong>@GetDetailStateLabel(tool!.ReconciliationStatus)</strong>
                </div>

                <div>
                    <span>Sincronización</span>
                    <strong>@GetDetailStateLabel(tool!.SyncStatus)</strong>
                </div>
            </div>
        </section>

<section class="tool-detail-panel
                tool-detail-image-v64">

    <header class="tool-detail-image-header-v64">

        <div>
            <span class="tool-detail-section-label-v30">
                IMAGEN DEL ACTIVO
            </span>

            <h2>Vista del activo</h2>
