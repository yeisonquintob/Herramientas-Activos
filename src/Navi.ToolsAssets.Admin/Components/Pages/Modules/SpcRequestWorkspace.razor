@code {

    private async Task OnQuoteFormEvidenceChangedAsync(
        InputFileChangeEventArgs args)
    {
        if (!CanQuote)
        {
            return;
        }

        errorMessage = null;
        successMessage = null;

        const long maxEvidenceBytes =
            5L * 1024L * 1024L;

        var file = args.File;

        if (file.Size <= 0)
        {
            errorMessage =
                "La imagen seleccionada está vacía.";

            return;
        }

        if (file.Size > maxEvidenceBytes)
        {
            errorMessage =
                "La imagen supera el tamaño máximo permitido "
                + "de 5 MB.";

            return;
        }

        var extension = System.IO.Path
            .GetExtension(file.Name)
            .ToLowerInvariant();

        var contentType = (
            file.ContentType
            ?? string.Empty
        )
        .Trim()
        .ToLowerInvariant();

        if (string.IsNullOrWhiteSpace(contentType))
        {
            contentType = extension switch
            {
                ".jpg" or ".jpeg" => "image/jpeg",
                ".png" => "image/png",
                ".webp" => "image/webp",
                _ => string.Empty
            };
        }

        var isAllowed =
            contentType == "image/jpeg"
            || contentType == "image/png"
            || contentType == "image/webp";

        if (!isAllowed)
        {
            errorMessage =
                "Solo se permiten imágenes JPG, PNG o WEBP.";

            return;
        }

        try
        {
            await using var stream =
                file.OpenReadStream(
                    maxAllowedSize:
                        maxEvidenceBytes);

            using var memory =
                new System.IO.MemoryStream();

            await stream.CopyToAsync(memory);

            quoteForm.EvidenceId = null;
            quoteForm.EvidencePendingUpload = true;

            quoteForm.EvidenceFileName =
                file.Name;

            quoteForm.EvidenceContentType =
                contentType;

            quoteForm.EvidencePreview =
                $"data:{contentType};base64,"
                + System.Convert.ToBase64String(
                    memory.ToArray());

            successMessage =
                "Imagen preparada para la cotización.";
        }
        catch (Exception ex)
        {
            errorMessage =
                "No fue posible cargar la imagen: "
                + ex.Message;
        }
    }



    private void ClearQuoteFormEvidence()
    {
        quoteForm.EvidenceId = null;
        quoteForm.EvidencePendingUpload = false;
        quoteForm.EvidenceFileName = null;
        quoteForm.EvidenceContentType = null;
        quoteForm.EvidencePreview = null;

        successMessage = null;
        errorMessage = null;
    }


    // NAVI QUOTATION FORM EVIDENCE V115.1


    private const long MaxQuotationEvidenceBytes = 1_200_000;
    private bool showQuotationComparison;
    private Guid? comparisonLineId;

    private readonly Dictionary<Guid, Guid>
        comparisonSelectionsByLine =
            new();

    private RequestLineItem? ComparisonSelectedLine
    {
        get
        {
            if (!comparisonLineId.HasValue)
            {
                return null;
            }

            return currentLines.FirstOrDefault(
                item =>
                    item.Id
                    ==
                    comparisonLineId.Value);
        }
    }

    private List<QuotationItem> ComparisonQuotesForSelectedLine
    {
        get
        {
            if (!comparisonLineId.HasValue)
            {
                return new List<QuotationItem>();
            }

            var selectedLineId =
                comparisonLineId.Value;

            return currentQuotes
                .Where(
                    item =>
                        QuoteBelongsToComparisonLine(
                            item,
                            selectedLineId))
                .OrderBy(
                    item =>
                        item.PriceBeforeVat
                        ??
                        decimal.MaxValue)
                .ThenBy(
                    item =>
                        item.Provider)
                .ToList();
        }
    }

    private Guid? ComparisonActiveSelectionId
    {
        get
        {
            if (!comparisonLineId.HasValue)
            {
                return null;
            }

            return comparisonSelectionsByLine.TryGetValue(
                comparisonLineId.Value,
                out var quotationId)
                    ? quotationId
                    : null;
        }
    }

    private QuotationItem? ComparisonSelectedQuote
    {
        get
        {
            var activeSelectionId =
                ComparisonActiveSelectionId;

            if (!activeSelectionId.HasValue)
            {
                return null;
            }

            return ComparisonQuotesForSelectedLine
                .FirstOrDefault(
                    item =>
                        item.Id
                        ==
                        activeSelectionId.Value);
        }
    }

    private List<QuotationItem> ComparisonSelectedQuotes
    {
        get
        {
            if (!comparisonSelectionsByLine.Any())
            {
                return new List<QuotationItem>();
            }

            var selectedIds =
                comparisonSelectionsByLine
                    .Values
                    .ToHashSet();

            return currentQuotes
                .Where(
                    item =>
                        selectedIds.Contains(
                            item.Id))
                .ToList();
        }
    }



    

