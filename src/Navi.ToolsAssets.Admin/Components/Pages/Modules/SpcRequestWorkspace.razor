    protected override async Task OnInitializedAsync()
    {
        ResetHeaderDefaults();

        /*
         * Las sedes y las solicitudes no dependen entre sí.
         * Se cargan al mismo tiempo para evitar dos esperas
         * consecutivas al ingresar al módulo.
         */
        var branchesTask =
            LoadBranchesAsync();

        var requestsTask =
            LoadGeneratedRequestsAsync(
                showBlockingLoader: true);

        await Task.WhenAll(
            branchesTask,
            requestsTask);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
