@rendermode InteractiveServer
@using Navi.ToolsAssets.Admin.Services.Auth
@using Navi.ToolsAssets.Admin.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject WebAuthSessionService AuthSession

@* NAVI SETTINGS INTERNAL STANDARD V225.1 *@
<NaviPageHero
    Pill="CONFIGURACIÓN"
    Title="@Title"
    Description="@Description" />

<div class="settings-v2251-toolbar">

    <a href="/settings"
       class="settings-v2251-back">
        ← Volver a configuración
    </a>

    @if (CanManageSettings)
    {
        <button type="button"
                class="settings-v2251-new"
                @onclick="OpenSettingsV2251NewModal"
                data-ntx-tone="affirmative">
            @SettingsV2251NewButtonLabel
        </button>
    }

    <NaviRefreshButton
        OnClick="LoadAsync"
        Loading="isLoading"
        Title="Actualizar"
        AriaLabel=@($"Actualizar {Title}") />
</div>

@if (!showSettingsV2251Modal &&
     !string.IsNullOrWhiteSpace(message))
{
    <div class="@messageClass"
         role="status">
        @message
    </div>
}

<div class="settings-crud-table settings-v2251-list">
        <div class="settings-table-header">
            <h2>@Title registrados</h2>

        </div>

        @if (isLoading)
        {
            <p role="status" aria-busy="true">Cargando...</p>
        }
        else if (items.Count == 0)
        {
            <div class="alert alert-info">No hay registros configurados para este catálogo.</div>
        }
        else if (items.Count == 0)
        {
            <div class="alert alert-info">No hay registros configurados para este catálogo.</div>
        }
        else
        {
            <div class="ntx-table-scroll">
                <table class="table table-hover align-middle settings-v2251-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td><strong>@item.Code</strong></td>
                            <td>@item.Name</td>
                            <td>
                                <span class="settings-description-cell">@item.Description</span>
                            </td>
                            <td>
                                <span class="badge @(item.IsActive ? "navi-bg-affirmative" : "bg-secondary")">
                                    @(item.IsActive ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end">
                                @if (CanManageSettings)
                                    {
                                        <button class="btn btn-sm ntx-btn--operation" @onclick="() => OpenSettingsV2251EditModal(item)" data-ntx-tone="operation" >Editar</button>
                                    }
                                @if (CanManageSettings)
                                    {
                                        <button class="btn btn-sm ntx-btn--danger" @onclick="() => DeleteAsync(item.Id)" data-ntx-tone="danger" >Eliminar</button>
                                    }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>

<NaviModal
    IsOpen="showSettingsV2251Modal"
    Title="@SettingsV2251ModalTitle"
    Description="Crea o actualiza el registro sin salir del listado."
    OnClose="CloseSettingsV2251Modal"
    Class="settings-v2251-modal">

    <EditForm Model="formModel" OnValidSubmit="SaveAsync" class="settings-v2251-modal-form">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="navi-settingscatalogcrud-control-001">Código</label>
                    <InputText class="form-control" @bind-Value="formModel.Code" disabled="@(!CanManageSettings)" id="navi-settingscatalogcrud-control-001" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="navi-settingscatalogcrud-control-002">Nombre</label>
                    <InputText class="form-control" @bind-Value="formModel.Name" disabled="@(!CanManageSettings)" id="navi-settingscatalogcrud-control-002" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="navi-settingscatalogcrud-control-003">Descripción</label>
                    <InputTextArea class="form-control" @bind-Value="formModel.Description" rows="3" disabled="@(!CanManageSettings)" id="navi-settingscatalogcrud-control-003" />
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" @bind-Value="formModel.IsActive" disabled="@(!CanManageSettings)" name="navi-settingscatalogcrud-field-001" id="navi-settingscatalogcrud-control-004" />
                    <label class="form-check-label" for="navi-settingscatalogcrud-control-004">Activo</label>
                </div>

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <div class="@messageClass">@message</div>
                }

                <div class="settings-crud-actions">
                    @if (CanManageSettings)
                    {
                        <button class="btn ntx-btn--operation" type="submit" data-ntx-tone="affirmative" >Guardar</button>
                    }
                    else
                    {
                        <span class="permission-action-denied">Solo consulta</span>
                    }
                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearSettingsV2251ModalForm" data-ntx-tone="secondary" >Limpiar</button>

    <button class="btn ntx-btn--danger"
            type="button"
            @onclick="CloseSettingsV2251Modal"
            data-ntx-tone="danger">
        Cerrar
    </button>
    </div>
            </EditForm>
</NaviModal>

@code {

// NAVI SETTINGS INTERNAL STANDARD V225.1
private bool showSettingsV2251Modal;

private string SettingsV2251NewButtonLabel =>
    Title switch
    {
        "Tipos de activo" => "+ Nuevo tipo de activo",
        "Categorías" => "+ Nueva categoría",
        "Estados" => "+ Nuevo estado",
        "Tipos de documento" => "+ Nuevo tipo de documento",
        "Tipos de mantenimiento" => "+ Nuevo tipo de mantenimiento",
        "Planes de mantenimiento" => "+ Nuevo plan de mantenimiento",
        "Causales" => "+ Nueva causal",
        "Parámetros" => "+ Nuevo parámetro",
        _ => "+ Nuevo registro"
    };

private string SettingsV2251ModalTitle =>
    editingId is null
        ? Title switch
        {
            "Tipos de activo" => "Nuevo tipo de activo",
            "Categorías" => "Nueva categoría",
            "Estados" => "Nuevo estado",
            "Tipos de documento" => "Nuevo tipo de documento",
            "Tipos de mantenimiento" => "Nuevo tipo de mantenimiento",
            "Planes de mantenimiento" => "Nuevo plan de mantenimiento",
            "Causales" => "Nueva causal",
            "Parámetros" => "Nuevo parámetro",
            _ => "Nuevo registro"
        }
        : $"Editar {Title.ToLowerInvariant()}";

private void OpenSettingsV2251NewModal()
{
    if (!CanManageSettings)
    {
        return;
    }

    ClearForm();
    message = string.Empty;
    showSettingsV2251Modal = true;
}

private void OpenSettingsV2251EditModal(
    CatalogDto item)
{
    if (!CanManageSettings)
    {
        return;
    }

    Edit(item);
    message = string.Empty;
    showSettingsV2251Modal = true;
}

private void ClearSettingsV2251ModalForm()
{
    ClearForm();
    message = string.Empty;
}

private void CloseSettingsV2251Modal()
{
    showSettingsV2251Modal = false;
    ClearForm();
    message = string.Empty;
}


    private bool IsAdmin =>
        string.Equals(AuthSession.RoleCode, "ADMIN", StringComparison.OrdinalIgnoreCase)
        || string.Equals(AuthSession.RoleCode, "SUPERADMIN", StringComparison.OrdinalIgnoreCase);

    private bool CanManageSettings => IsAdmin || AuthSession.HasPermission("Settings.Manage");

    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Pill { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string CountLabel { get; set; } = string.Empty;
    [Parameter] public string Endpoint { get; set; } = string.Empty;

    private HttpClient Api => HttpClientFactory.CreateClient("NaviApi");

    private List<CatalogDto> items = new();
    private CatalogFormModel formModel = new();
    private Guid? editingId;
    private bool isLoading;
    private string message = string.Empty;
    private string messageClass = "alert alert-info";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        message = string.Empty;

        try
        {
            items = await Api.GetFromJsonAsync<List<CatalogDto>>(Endpoint) ?? new();
        }
        catch (Exception ex)
        {
            ShowError($"No se pudieron cargar los datos: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (!CanManageSettings)
        {
            ShowError("No tienes permiso para modificar configuración.");
            return;
        }

        if (string.IsNullOrWhiteSpace(formModel.Code) ||
            string.IsNullOrWhiteSpace(formModel.Name))
        {
            ShowError("Código y nombre son obligatorios.");
            return;
        }

        var request = new
        {
            code = formModel.Code,
            name = formModel.Name,
            description = formModel.Description,
            isActive = formModel.IsActive,
            changedBy = "admin-web"
        };

        try
        {
            HttpResponseMessage response = editingId is null
                ? await Api.PostAsJsonAsync(Endpoint, request)
                : await Api.PutAsJsonAsync($"{Endpoint}/{editingId}", request);

            if (!response.IsSuccessStatusCode)
            {
                ShowError(await response.Content.ReadAsStringAsync());
                return;
            }

            ShowSuccess(editingId is null ? "Registro creado correctamente." : "Registro actualizado correctamente.");
            ClearForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowError($"Error guardando registro: {ex.Message}");
        }
    }

    private void Edit(CatalogDto item)
    {
        if (!CanManageSettings)
        {
            ShowError("No tienes permiso para editar configuración.");
            return;
        }

        editingId = item.Id;

        formModel = new CatalogFormModel
        {
            Code = item.Code,
            Name = item.Name,
            Description = item.Description,
            IsActive = item.IsActive
        };
    }

    private async Task DeleteAsync(Guid id)
    {
        if (!CanManageSettings)
        {
            ShowError("No tienes permiso para eliminar configuración.");
            return;
        }

        try
        {
            var response = await Api.DeleteAsync($"{Endpoint}/{id}?changedBy=admin-web");

            if (!response.IsSuccessStatusCode)
            {
                ShowError(await response.Content.ReadAsStringAsync());
                return;
            }

            ShowSuccess("Registro eliminado correctamente.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowError($"Error eliminando registro: {ex.Message}");
        }
    }

    private void ClearForm()
    {
        editingId = null;
        formModel = new CatalogFormModel();
    }

    private void ShowSuccess(string value)
    {
        message = value;
        messageClass = "alert alert-success";
    }

    private void ShowError(string value)
    {
        message = value;
        messageClass = "alert alert-danger";
    }

    private sealed class CatalogDto
    {
        public Guid Id { get; set; }
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool IsActive { get; set; }
    }

    private sealed class CatalogFormModel
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
