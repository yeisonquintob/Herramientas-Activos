@*
    NAVI - SOLICITUD DE COMPRA HERRAMIENTAS Y AF

    Recreada desde:
    PROYECTO_CODIGO_COMPLETO_20260716_005307

    La pantalla renderiza inmediatamente.
    La información remota se actualiza en segundo plano.

    La seguridad se conserva mediante:
    - validación global de la ruta Purchases.Request;
    - permisos internos de las operaciones.
*@

@implements IDisposable
@using System.Text
@using System.Text.Json
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Navi.ToolsAssets.Admin.Components.Security
@using Navi.ToolsAssets.Admin.Components.Shared
@using Navi.ToolsAssets.Admin.Services.Auth
@inject WebAuthSessionService AuthSession
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@* NAVI PURCHASE KPI CANONICAL STANDARD V77 START *@

<NaviPageHero
    Class="navi-reference-toolbar__actions"
    Pill="@HeroPill"
    Title="@PageTitleText"
    Description="@PageSubtitle" />

<NaviKpiToolbar
    Class="spc-purchase-kpi-toolbar-v77"
    Refresh="LoadAsync"
    IsRefreshing="isLoading"
    RefreshTitle="Actualizar solicitudes"
    RefreshAriaLabel="Actualizar indicadores y solicitudes">

    <NaviKpiGrid
        Columns="6"
        Compact="true"
        Dividers="true"
        Class="spc-purchase-kpi-grid-v77"
        aria-label="Indicadores de solicitudes de compra">

        <NaviKpiCard
            Title="Pendientes"
            Value="@HeroPendingRequests.ToString()"
            Description="Borrador / confirmadas"
            Tone="warning"
            Compact="true"
            Class="spc-purchase-kpi-pending-v77">

            <IconContent>
                <NaviKpiIcon Name="clock" />
            </IconContent>

        </NaviKpiCard>

        <NaviKpiCard
            Title="En cotización"
            Value="@HeroQuotingRequests.ToString()"
            Description="Pendientes por cotizar"
            Tone="soft"
            Compact="true"
            Class="spc-purchase-kpi-quotation-v77">

            <IconContent>
                <NaviKpiIcon Name="cart" />
            </IconContent>

        </NaviKpiCard>

        <NaviKpiCard
            Title="En revisión"
            Value="@HeroInReviewRequests.ToString()"
            Description="Generadas para aprobación"
            Tone="warning"
            Compact="true"
            Class="spc-purchase-kpi-review-v77">

            <IconContent>
                <NaviKpiIcon Name="progress" />
            </IconContent>

        </NaviKpiCard>

        <NaviKpiCard
            Title="Aprobadas"
            Value="@HeroApprovedRequests.ToString()"
            Description="Aprobadas / ejecución"
            Tone="positive"
            Compact="true"
            Class="spc-purchase-kpi-approved-v77">

            <IconContent>
                <NaviKpiIcon Name="check" />
            </IconContent>

        </NaviKpiCard>

        <NaviKpiCard
            Title="Cerradas"
            Value="@HeroClosedRequests.ToString()"
            Description="Finalizadas"
            Tone="neutral"
            Compact="true"
            Class="spc-purchase-kpi-closed-v77">

            <IconContent>
                <NaviKpiIcon Name="document" />
            </IconContent>

        </NaviKpiCard>

        <NaviKpiCard
            Title="Rechazadas"
            Value="@HeroRejectedRequests.ToString()"
            Description="No continúan"
            Tone="danger"
            Compact="true"
            Class="spc-purchase-kpi-rejected-v77">

            <IconContent>
                <NaviKpiIcon Name="alert" />
            </IconContent>

        </NaviKpiCard>

    </NaviKpiGrid>

</NaviKpiToolbar>

@* NAVI PURCHASE KPI CANONICAL STANDARD V77 END *@

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<section class="spc-shell">
    <div class="spc-column">
        <article class="spc-card">
            <div class="spc-card-title">
                <div>
                    <h3>@HeaderTitle</h3>
                    <p>@HeaderSubtitle</p>
                </div>
            </div>

            <div class="spc-grid two">
                <div class="form-group">
                    <label for="navi-spcrequestworkspace-control-001">Nombre de la solicitud</label>
                    <InputText class="form-control" @bind-Value="header.RequestName" disabled="@(!CanEditRequest)" id="navi-spcrequestworkspace-control-001" />
                </div>

                <div class="form-group">
                    <label for="navi-spcrequestworkspace-control-002">Sede</label>
                    <InputSelect class="form-select" @bind-Value="header.BranchIdText" disabled="@(!CanEditRequest)" id="navi-spcrequestworkspace-control-002">
                        <option value="">Seleccione sede</option>
                        @foreach (var branch in branches)
                        {
                            <option value="@branch.Id">@branch.Code - @branch.Name</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-group">
                    <label for="navi-spcrequestworkspace-control-003">Solicitante</label>
                    <InputText class="form-control" @bind-Value="header.RequestedBy" readonly id="navi-spcrequestworkspace-control-003" />
                </div>

                <div class="form-group">
                    <label for="navi-spcrequestworkspace-control-004">Responsable que aprueba</label>
                    <InputText class="form-control" @bind-Value="header.Approver" disabled="@(!CanEditRequest)" id="navi-spcrequestworkspace-control-004" />
                </div>

                @if (IsMaintenance)
                {
                    <div class="form-group">
                        <label for="navi-spcrequestworkspace-control-005">Tipo mantenimiento</label>
                        <InputSelect class="form-select" @bind-Value="header.RequestType" disabled="@(!CanEditRequest)" id="navi-spcrequestworkspace-control-005">
                            <option value="Correctivo">Correctivo</option>
                            <option value="Preventivo">Preventivo</option>
                            <option value="Calibración">Calibración</option>
                            <option value="Garantía">Garantía</option>
                            <option value="Seguridad/SSTA">Seguridad/SSTA</option>
                        </InputSelect>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label for="navi-spcrequestworkspace-control-006">Tipo solicitud</label>
                        <InputSelect class="form-select" @bind-Value="header.RequestType" disabled="@(!CanEditRequest)" id="navi-spcrequestworkspace-control-006">
                            <option value="SPC">SPC</option>
                            <option value="Activo fijo">Activo fijo</option>
                            <option value="Herramienta">Herramienta</option>
                            <option value="Equipo">Equipo</option>
                            <option value="Kit de herramientas">Kit de herramientas</option>
                        </InputSelect>
                    </div>
                }

                <div class="form-group">
                    <label for="navi-spcrequestworkspace-control-007">Prioridad</label>
                    <InputSelect class="form-select" @bind-Value="header.Priority" disabled="@(!CanEditRequest)" id="navi-spcrequestworkspace-control-007">
                        <option value="Baja">Baja</option>
                        <option value="Media">Media</option>
                        <option value="Alta">Alta</option>
                        <option value="Crítica">Crítica</option>
                    </InputSelect>
                </div>

                <div class="form-group">
                    <label for="navi-spcrequestworkspace-control-008">Fecha requerida</label>
                    <InputDate class="form-control" @bind-Value="header.RequiredAt" disabled="@(!CanEditRequest)" id="navi-spcrequestworkspace-control-008" />
                </div>

                <div class="form-group">
                    <label for="navi-spcrequestworkspace-control-009">Ubicación / área</label>
                    <InputText class="form-control" @bind-Value="header.Location" disabled="@(!CanEditRequest)" id="navi-spcrequestworkspace-control-009" />
                </div>

                <div class="form-group full">
                    <label for="navi-spcrequestworkspace-control-020">Descripción general de la necesidad</label>
                    <InputTextArea class="form-control" @bind-Value="header.NeedDescription" rows="2" disabled="@(!CanEditRequest)" id="navi-spcrequestworkspace-control-020" />
                </div>
            </div>
        </article>

        <article class="spc-card">
            <div class="spc-card-title">
                <div>
                    <h3>@LinesTitle</h3>
                    <p>Agrega una herramienta principal o varias herramientas que hagan parte del kit solicitado.</p>
                </div>
            </div>

            <div class="spc-grid two">
                <div class="form-group">
                    <label for="navi-spcrequestworkspace-control-010">Foto / evidencia</label>
                    <InputFile class="form-control" OnChange="OnImageSelected" accept="image/*" disabled="@(!CanEditRequest)" id="navi-spcrequestworkspace-control-010" />
                    @if (!string.IsNullOrWhiteSpace(lineForm.ImageReference))
                    {
                        <small class="photo-file-name">@lineForm.ImageReference</small>
                    }
                    @if (!string.IsNullOrWhiteSpace(lineForm.ImagePreview))
                    {
                        <img class="photo-preview" src="@lineForm.ImagePreview" alt="Vista previa" />
                    }
                </div>

                <div class="form-group">
                    <label for="navi-spcrequestworkspace-control-011">Información técnica / serial</label>
                    <InputText class="form-control" @bind-Value="lineForm.TechnicalOrSerial" disabled="@(!CanEditRequest)" id="navi-spcrequestworkspace-control-011" />
                </div>

                <div class="form-group">
                    <label for="navi-spcrequestworkspace-control-012">Nombre herramienta / equipo</label>
                    <InputText class="form-control" @bind-Value="lineForm.ToolName" disabled="@(!CanEditRequest)" id="navi-spcrequestworkspace-control-012" />
                </div>

                @if (IsMaintenance)
                {
                    <div class="form-group">
                        <label for="navi-spcrequestworkspace-control-013">Estado / criticidad</label>
                        <InputSelect class="form-select" @bind-Value="lineForm.Criticality" disabled="@(!CanEditRequest)" id="navi-spcrequestworkspace-control-013">
                            <option value="Normal">Normal</option>
                            <option value="Alta">Alta</option>
                            <option value="Crítica">Crítica</option>
                        </InputSelect>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label for="navi-spcrequestworkspace-control-014">Cantidad</label>
                        <InputNumber class="form-control" @bind-Value="lineForm.Quantity" disabled="@(!CanEditRequest)" id="navi-spcrequestworkspace-control-014" />
                    </div>
                }

                <div class="form-group full">
                    <label for="navi-spcrequestworkspace-control-021">Detalles</label>
                    <InputTextArea class="form-control" @bind-Value="lineForm.Details" rows="2" disabled="@(!CanEditRequest)" id="navi-spcrequestworkspace-control-021" />
                </div>

                <div class="form-group full">
                    <label for="navi-spcrequestworkspace-control-022">Novedades / falla / observación</label>
                    <InputTextArea class="form-control" @bind-Value="lineForm.Novelty" rows="2" disabled="@(!CanEditRequest)" id="navi-spcrequestworkspace-control-022" />
                </div>
            </div>

            <div class="spc-actions">
                <button type="button" class="btn ntx-btn--operation" @onclick="AddLine" disabled="@(!CanCreateOrConfirmRequest)" data-ntx-tone="refresh" >
                    @(editingLineId.HasValue ? "Actualizar herramienta" : "Agregar herramienta")
                </button>

                <button type="button" class="btn btn-outline-secondary" @onclick="ClearLine" data-ntx-tone="secondary" >
                    Limpiar línea
                </button>
            </div>

            @if (!currentLines.Any())
            {
                <div class="spc-empty">No hay herramientas agregadas.</div>
            }
            else
            {
                <div class="spc-table-wrap">
                    <div class="ntx-table-scroll">
                        <table class="spc-table">
                        <thead>
                            <tr>
                                <th>Usar</th>
                                <th>Herramienta</th>
                                <th>Técnico / serial</th>
                                <th>@(IsMaintenance ? "Criticidad" : "Cant.")</th>
                                <th>Detalles / novedades</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in currentLines)
                            {
                                <tr>
                                    <td><InputCheckbox @bind-Value="item.Selected" disabled="@(!CanEditRequest)" name="navi-spcrequestworkspace-field-001" /></td>
                                    <td>
                                        <strong>@item.ToolName</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.ImagePreview))
                                        {
                                            <img class="photo-thumb" src="@item.ImagePreview" alt="Foto herramienta" />
                                        }
                                        <small>@item.ImageReference</small>
                                    </td>
                                    <td>@item.TechnicalOrSerial</td>
                                    <td>@(IsMaintenance ? item.Criticality : item.Quantity)</td>
                                    <td>
                                        <small>@item.Details</small>
                                        <small>@item.Novelty</small>
                                    </td>
                                    <td>
                                        <div class="row-actions">
                                            <button type="button" class="btn btn-sm ntx-btn--operation" @onclick="() => EditLine(item.Id)" data-ntx-tone="operation" >Editar</button>
                                            <button type="button" class="btn btn-sm ntx-btn--danger" @onclick="() => RemoveLine(item.Id)" data-ntx-tone="danger" >Quitar</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            }
        </article>

        <article class="spc-card spc-request-state-card">
            <div class="spc-card-title">
                <div>
                    <h3>Estado de la solicitud</h3>
                    <p>Guarda el borrador o confirma la solicitud. Al guardar se limpia el formulario y queda abajo en solicitudes registradas.</p>
                </div>
            </div>

            <div class="spc-state-box">
                <span>Estado actual</span>
                <strong>@RequestVisualState</strong>
            </div>

            <div class="spc-actions">
                <button type="button" class="btn ntx-btn--operation" @onclick="SaveDraftAsync" data-ntx-tone="affirmative" >
                    Guardar como borrador
                </button>

                <button type="button" class="btn ntx-btn--operation" @onclick="ConfirmRequestAsync" disabled="@(!CanCreateOrConfirmRequest)" data-ntx-tone="affirmative" >
                    Confirmar solicitud
                </button>
            </div>
        </article>
    </div>

    <div class="spc-column">
        <article class="spc-card">
            <div class="spc-card-title">
                <div>
                    <h3>@QuotationTitle</h3>
                    <p>Solo se habilita cuando una solicitud confirmada entra a Realizar cotización.</p>
                </div>
            </div>

            @if (!CanQuote)
            {
                <div class="spc-locked">
                    Selecciona una solicitud confirmada en la parte inferior y presiona <strong>Realizar cotización</strong>.
                </div>
            }

            <div class="quote-header-box">
                <div>
                    <span>Solicitud</span>
                    <strong>@Display(header.RequestName)</strong>
                </div>
                <div>
                    <span>Sede</span>
                    <strong>@SelectedBranchLabel</strong>
                </div>
                <div>
                    <span>Estado</span>
                    <strong>@RequestVisualState</strong>
                </div>
            </div>

            <div class="spc-grid two">
                <div class="form-group">
                    <label for="navi-spcrequestworkspace-control-015">Proveedor</label>
                    <InputText class="form-control" @bind-Value="quoteForm.Provider" disabled="@(!CanQuote)" id="navi-spcrequestworkspace-control-015" />
                </div>

                <div class="form-group">
                    <label for="navi-spcrequestworkspace-control-016">Herramienta cotizada</label>
                    <select class="form-select" @bind="quoteForm.LineIdText" disabled="@(!CanQuote)" id="navi-spcrequestworkspace-control-016">
                        <option value="">Toda la solicitud / kit</option>
                        @foreach (var line in currentLines)
                        {
                            <option value="@line.Id">@line.ToolName</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="navi-spcrequestworkspace-control-017">Fecha cotización</label>
                    <InputDate class="form-control" @bind-Value="quoteForm.QuotationDate" disabled="@(!CanQuote)" id="navi-spcrequestworkspace-control-017" />
                </div>

                <div class="form-group">
                    <label for="navi-spcrequestworkspace-control-018">Tiempo entrega / reparación</label>
                    <InputText class="form-control" @bind-Value="quoteForm.DeliveryTime" disabled="@(!CanQuote)" id="navi-spcrequestworkspace-control-018" />
                </div>

                <div class="form-group">
                    <label for="navi-spcrequestworkspace-control-019">Precio antes de IVA</label>
                    <InputNumber class="form-control" @bind-Value="quoteForm.PriceBeforeVat" disabled="@(!CanQuote)" id="navi-spcrequestworkspace-control-019" />
                </div>

                <div class="form-group full">
                    <label for="navi-spcrequestworkspace-control-023">Detalles adicionales de cotización</label>
                    <InputTextArea class="form-control" @bind-Value="quoteForm.AdditionalDetails" rows="2" disabled="@(!CanQuote)" id="navi-spcrequestworkspace-control-023" />
                </div>
            </div>

            <div class="spc-actions">
                <button type="button" class="btn ntx-btn--operation" @onclick="AddQuotationAsync" disabled="@(!CanRegisterQuotation)" data-ntx-tone="refresh" >
                    @(editingQuoteId.HasValue ? "Actualizar cotización" : "Agregar cotización")
                </button>

                <button type="button" class="btn btn-outline-secondary" @onclick="ClearQuotation" data-ntx-tone="secondary" >
                    Limpiar cotización
                </button>
            </div>

            @if (!currentQuotes.Any())
            {
                <div class="spc-empty">No hay cotizaciones agregadas.</div>
            }
            else
            {
                <div class="spc-table-wrap">
                    <div class="ntx-table-scroll">
                        <table class="spc-table">
                        <thead>
                            <tr>
                                <th>Usar</th>
                                <th>Proveedor</th>
                                <th>Herramienta</th>
                                <th>Fecha</th>
                                <th>Entrega</th>
                                <th>Precio sin IVA</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var quote in currentQuotes)
                            {
                                <tr>
                                    <td><InputCheckbox @bind-Value="quote.Selected" disabled="@(!CanQuote)" name="navi-spcrequestworkspace-field-002" /></td>
                                    <td>
                                        <strong>@quote.Provider</strong>
                                        <small>@quote.AdditionalDetails</small>
                                    </td>
                                    <td>@GetLineName(quote.LineId)</td>
                                    <td>@FormatDate(quote.QuotationDate)</td>
                                    <td>@quote.DeliveryTime</td>
                                    <td>@FormatMoney(quote.PriceBeforeVat)</td>
                                    <td>
                                        <div class="row-actions">
                                            <button type="button" class="btn btn-sm ntx-btn--operation" @onclick="() => EditQuotation(quote.Id)" data-ntx-tone="operation" >Editar</button>
                                            <button type="button" class="btn btn-sm ntx-btn--danger" @onclick="() => RemoveQuotationAsync(quote.Id)" data-ntx-tone="danger" >Quitar</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            }
        </article>

        <article class="spc-card spc-final-card">
            <h3>@GenerateTitle</h3>
            <p>Solo se habilita cuando la solicitud está en cotización y tiene mínimo una cotización seleccionada.</p>

            <NaviKpiGrid Columns="3" Class="spc-summary-grid">
                <NaviKpiCard>
                    <span>Herramientas seleccionadas</span>
                    <strong>@SelectedLines.Count()</strong>
                </NaviKpiCard>
                <NaviKpiCard>
                    <span>Cotizaciones seleccionadas</span>
                    <strong>@SelectedQuotes.Count()</strong>
                </NaviKpiCard>
                <NaviKpiCard>
                    <span>Total antes de IVA</span>
                    <strong>@FormatMoney(SelectedQuotes.Sum(x => x.PriceBeforeVat ?? 0))</strong>
                </NaviKpiCard>
            </NaviKpiGrid>

            <div class="spc-actions vertical">
                <button type="button" class="btn ntx-btn--affirmative" @onclick="GenerateAsync" disabled="@(!CanGenerateFinalRequest)" data-ntx-tone="ghost" >
                    @(isSaving ? "Generando..." : GenerateButtonText)
                </button>

                @if (CanQuote && !SelectedQuotes.Any())
                {
                    <div class="spc-generate-warning">
                        Agrega y selecciona al menos una cotización para generar la solicitud.
                    </div>
                }
            </div>
        </article>
    </div>
</section>

<section class="spc-card spc-registered">
    <div class="spc-card-title">
        <div>
            <h3>Solicitudes registradas</h3>
            <p>Borradores, solicitudes confirmadas pendientes por cotizar y solicitudes generadas.</p>
        </div>
        <button type="button" class="btn ntx-btn--operation btn-sm" @onclick="LoadAsync" data-ntx-tone="refresh" >Actualizar</button>
    </div>

    @if (isLoading)
    {
        <div class="spc-empty" role="status" aria-busy="true">Cargando solicitudes...</div>
    }
    else if (!storedRequests.Any() && !registeredItems.Any())
    {
        <div class="spc-empty">No hay solicitudes registradas.</div>
    }
    else
    {
        <div class="spc-table-wrap">
            <div class="ntx-table-scroll">
                <table class="spc-table">
                <thead>
                    <tr>
                        <th>Solicitud</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Prioridad</th>
                        <th>Estado</th>
                        <th>Herramientas</th>
                        <th>Cotizaciones</th>
                        <th>Actualización</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in storedRequests.OrderByDescending(x => x.UpdatedAt))
                    {
                        <tr class="@GetStoredRowClass(item)">
                            <td><strong>@item.LocalNumber</strong></td>
                            <td>@Display(item.Header.RequestName)</td>
                            <td>@Display(item.Header.RequestType)</td>
                            <td>@Display(item.Header.Priority)</td>
                            <td><span class="@GetStoredStatusClass(item.Status)">@GetStoredStatusLabel(item.Status)</span></td>
                            <td>@item.Lines.Count</td>
                            <td>@item.Quotations.Count</td>
                            <td>@FormatDateTime(item.UpdatedAt)</td>
                            <td>
                                <div class="row-actions">
                                    @if (item.Status == LocalStatusDraft)
                                    {
                                        <button type="button" class="btn btn-sm ntx-btn--operation" @onclick="() => LoadDraftForEdit(item.Id)" data-ntx-tone="operation" >Editar</button>
                                        <button type="button" class="btn btn-sm ntx-btn--operation" @onclick="() => ConfirmStoredRequestAsync(item.Id)" data-ntx-tone="affirmative" >Confirmar</button>
                                    }
                                    else if (item.Status == LocalStatusConfirmed)
                                    {
                                        <button type="button" class="btn btn-sm ntx-btn--warning" disabled="@(!CanRegisterQuotation)" @onclick="() => StartQuotationAsync(item.Id)" data-ntx-tone="operation" >Realizar cotización</button>
                                    }
                                    else if (item.Status == LocalStatusQuoting)
                                    {
                                        <button type="button" class="btn btn-sm ntx-btn--warning" disabled="@(!CanRegisterQuotation)" @onclick="() => ContinueQuotation(item.Id)" data-ntx-tone="operation" >Continuar cotización</button>
                                    }

                                    <button type="button" class="btn btn-sm ntx-btn--danger" @onclick="() => DeleteLocalRequestAsync(item.Id)" data-ntx-tone="danger" >Eliminar</button>
                                </div>
                            </td>
                        </tr>
                    }

                    @foreach (var item in registeredItems.OrderByDescending(x => x.CreatedAt).Take(20))
                    {
                        <tr>
                            <td><strong>@item.RequestNumber</strong></td>
                            <td>@item.Title</td>
                            <td>@item.Type</td>
                            <td>@item.Priority</td>
                            <td><span class="status-pill">@GetStatusLabel(item.Status)</span></td>
                            <td>—</td>
                            <td>—</td>
                            <td>@FormatDateTime(item.CreatedAt)</td>
                            <td><span class="text-muted">Generada</span></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }
</section>

@code {

    private int HeroPendingRequests =>
