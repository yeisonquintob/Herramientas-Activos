        var selected = string.Equals(statusFilter ?? "all", value, StringComparison.OrdinalIgnoreCase)
            ? " active"
            : string.Empty;

        var css = value switch
        {
            "all" => "all",
            "InReview" => "review",
            "Approved" => "approved",
            "Scheduled" => "scheduled",
            "InExecution" => "execution",
            "Closed" => "closed",
            "Rejected" => "rejected",
            "Canceled" => "canceled",
            _ => "other"
        };

        return $"consult-status-filter-chip consult-status-{css}{selected}";
    }

    private void ApplyFilters()
    {
        StatusMessage = null;
        ErrorMessage = null;
    }

