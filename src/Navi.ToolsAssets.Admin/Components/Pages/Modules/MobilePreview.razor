@page "/mobile-preview"

<PageTitle>PWA móvil</PageTitle>

<NaviPageHero
    Pill="MÓVIL"
    Title="PWA móvil"
    Description="Vista de control de funcionalidades móviles: QR, préstamos, devoluciones, daños, preoperacionales y modo offline." />

<section class="module-placeholder">
    <div class="module-placeholder-badge">Móvil</div>

    <h2>Módulo en construcción</h2>

    <p>
        Esta pantalla queda creada como punto de navegación del módulo <strong>PWA móvil</strong>.
        El siguiente paso será conectar esta vista con API, reglas de negocio, permisos, reportes y flujos operativos.
    </p>

    <div class="module-placeholder-grid">
        <div>
            <span>Estado</span>
            <strong>Pendiente desarrollo funcional</strong>
        </div>

        <div>
            <span>Aplicación</span>
            <strong>Web administrativa</strong>
        </div>

        <div>
            <span>Orientación</span>
            <strong>Administración de activos y herramientas</strong>
        </div>
    </div>

    <div class="module-placeholder-actions">
        <a class="btn btn-outline-primary" href="/tools">Ir a inventario</a>
        <a class="btn btn-outline-secondary" href="/">Ir a Dashboard</a>
    </div>
</section>
