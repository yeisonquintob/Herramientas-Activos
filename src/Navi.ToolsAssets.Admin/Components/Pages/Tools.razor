    private async Task LoadToolsAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var client =
                HttpClientFactory.CreateClient(
                    "NaviApi");

            tools =
                await client.GetFromJsonAsync<
                    List<ToolListItem>>(
                    "api/tools")
                ??
                new();

            lastUpdatedAt =
                DateTime.Now;
        }
        catch (Exception ex)
        {
            errorMessage =
                "Valida que la API esté activa en "
                + "http://localhost:5218. Detalle: "
                + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

