/* ============================================================
   NAVI SIDEBAR INVERTIDA BLANCO / NEGRO
   FASE 4.23 - 20260706

   Objetivo:
   - Barra lateral izquierda completamente blanca.
   - Desde arriba hasta abajo.
   - Letras negras.
   - Opción activa en gris claro.
   - Sin morado ni negro como fondo.
   - Mantener menú compacto.
   ============================================================ */


/* Contenedor total de la barra lateral */
.navi-sidebar-shell {
    width: 100% !important;
    height: 100vh !important;
    max-height: 100vh !important;

    display: flex !important;
    flex-direction: column !important;

    overflow: hidden !important;

    background: #ffffff !important;
    background-color: #ffffff !important;
    background-image: none !important;

    color: #000000 !important;

    border-right: 1px solid #d9dee7 !important;

    box-shadow: none !important;
}


/* Marca superior */
.navi-brand {
    min-height: 60px !important;
    height: 60px !important;

    display: flex !important;
    align-items: center !important;

    gap: .54rem !important;

    padding: .50rem .68rem !important;

    background: #ffffff !important;
    background-color: #ffffff !important;
    background-image: none !important;

    border-bottom: 1px solid #e5e7eb !important;

    box-shadow: none !important;
}

.navi-logo {
    width: 34px !important;
    height: 34px !important;
    min-width: 34px !important;

    display: grid !important;
    place-items: center !important;

    border-radius: .68rem !important;

    background: #d20a11 !important;
    background-color: #d20a11 !important;
    background-image: none !important;

    color: #ffffff !important;

    font-size: .90rem !important;
    font-weight: 950 !important;

    box-shadow: 0 .22rem .50rem rgba(210, 10, 17, .16) !important;
}

.navi-brand-text {
    min-width: 0 !important;
}

.navi-brand-text strong {
    display: block !important;

    color: #000000 !important;

    font-size: .72rem !important;
    font-weight: 950 !important;
    line-height: 1.05 !important;

    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}

.navi-brand-text span {
    display: block !important;

    margin-top: .05rem !important;

    color: #4b5563 !important;

    font-size: .55rem !important;
    font-weight: 750 !important;
    line-height: 1.05 !important;

    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}


/* Tarjeta de usuario */
.nav-user-card {
    min-height: 44px !important;

    display: grid !important;
    grid-template-columns: 30px minmax(0, 1fr) auto !important;
    align-items: center !important;

    gap: .40rem !important;

    margin: .50rem .55rem .42rem !important;
    padding: .40rem .46rem !important;

    border-radius: .72rem !important;
    border: 1px solid #d9dee7 !important;

    background: #ffffff !important;
    background-color: #ffffff !important;
    background-image: none !important;

    box-shadow: none !important;
}

.nav-user-avatar {
    width: 30px !important;
    height: 30px !important;
    min-width: 30px !important;

    display: grid !important;
    place-items: center !important;

    border-radius: 999px !important;
    border: 1px solid #cfd6df !important;

    background: #f3f4f6 !important;
    background-color: #f3f4f6 !important;
    background-image: none !important;

    color: #000000 !important;

    font-size: .60rem !important;
    font-weight: 950 !important;
}

.nav-user-info {
    min-width: 0 !important;
}

.nav-user-info strong {
    display: block !important;

    color: #000000 !important;

    font-size: .60rem !important;
    font-weight: 900 !important;
    line-height: 1.05 !important;

    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}

.nav-user-info span {
    display: block !important;

    margin-top: .04rem !important;

    color: #4b5563 !important;

    font-size: .50rem !important;
    font-weight: 700 !important;
    line-height: 1.05 !important;

    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}

.nav-logout-btn {
    height: 24px !important;
    min-width: 38px !important;

    padding: 0 .38rem !important;

    border-radius: .55rem !important;
    border: 1px solid #cfd6df !important;

    background: #ffffff !important;
    background-color: #ffffff !important;
    background-image: none !important;

    color: #000000 !important;

    font-size: .54rem !important;
    font-weight: 850 !important;

    box-shadow: none !important;
}

.nav-logout-btn:hover {
    background: #f3f4f6 !important;
    color: #000000 !important;
}


/* Mensaje de sesión */
.nav-auth-required {
    margin: .52rem .55rem .42rem !important;
    padding: .46rem .5rem !important;

    border-radius: .72rem !important;
    border: 1px solid #d9dee7 !important;

    background: #ffffff !important;
    background-color: #ffffff !important;
    background-image: none !important;

    color: #000000 !important;
}

.nav-auth-required strong {
    display: block !important;

    color: #000000 !important;

    font-size: .64rem !important;
    font-weight: 900 !important;
}

.nav-auth-required span {
    display: block !important;

    color: #4b5563 !important;

    font-size: .54rem !important;
    font-weight: 700 !important;
}


/* Área scroll del menú */
.nav-scrollable {
    flex: 1 1 auto !important;
    min-height: 0 !important;

    overflow-y: auto !important;
    overflow-x: hidden !important;

    padding: .05rem .36rem 1.15rem !important;

    background: #ffffff !important;
    background-color: #ffffff !important;
    background-image: none !important;

    scrollbar-width: thin !important;
    scrollbar-color: #cfd6df transparent !important;
}

.nav-scrollable::-webkit-scrollbar {
    width: 6px !important;
}

.nav-scrollable::-webkit-scrollbar-track {
    background: transparent !important;
}

.nav-scrollable::-webkit-scrollbar-thumb {
    border-radius: 999px !important;
    background: #cfd6df !important;
}

.nav-scrollable::-webkit-scrollbar-thumb:hover {
    background: #9ca3af !important;
}

.nav-menu-list {
    display: flex !important;
    flex-direction: column !important;

    padding-bottom: 1rem !important;
}


/* Títulos de sección */
.nav-section-title {
    margin: .34rem .24rem .14rem !important;

    color: #111827 !important;

    font-size: .52rem !important;
    font-weight: 950 !important;
    line-height: 1 !important;
    letter-spacing: .06rem !important;
    text-transform: uppercase !important;
}

.nav-section-title::after {
    content: "" !important;

    display: block !important;

    width: 20px !important;
    height: 2px !important;

    margin-top: .13rem !important;

    border-radius: 999px !important;

    background: #cfd6df !important;
    background-color: #cfd6df !important;
    background-image: none !important;
}


/* Items */
.nav-item {
    margin-bottom: .06rem !important;
}


/* NavLink en CSS aislado */
.nav-item ::deep .nav-link {
    position: relative !important;

    min-height: 32px !important;
    height: 32px !important;

    display: flex !important;
    align-items: center !important;

    gap: .44rem !important;

    padding: .34rem .44rem !important;

    border-radius: .60rem !important;
    border: 1px solid transparent !important;

    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;

    color: #000000 !important;
    text-decoration: none !important;

    box-shadow: none !important;
    text-shadow: none !important;
}

.nav-item ::deep .nav-link:hover {
    background: #f3f4f6 !important;
    background-color: #f3f4f6 !important;
    background-image: none !important;

    color: #000000 !important;

    border-color: #e5e7eb !important;

    box-shadow: none !important;
}

.nav-item ::deep .nav-link.active {
    background: #e5e7eb !important;
    background-color: #e5e7eb !important;
    background-image: none !important;

    color: #000000 !important;

    border-color: #cfd6df !important;

    box-shadow: inset 3px 0 0 #000000 !important;
}


/* Íconos */
.nav-icon,
.nav-item ::deep .nav-link .nav-icon {
    width: 18px !important;
    min-width: 18px !important;
    height: 18px !important;

    display: inline-grid !important;
    place-items: center !important;

    border-radius: .42rem !important;
    border: 1px solid #d9dee7 !important;

    background: #f3f4f6 !important;
    background-color: #f3f4f6 !important;
    background-image: none !important;

    color: #000000 !important;

    font-size: .60rem !important;
    line-height: 1 !important;

    box-shadow: none !important;
}

.nav-item ::deep .nav-link:hover .nav-icon,
.nav-item ::deep .nav-link.active .nav-icon {
    background: #ffffff !important;
    background-color: #ffffff !important;
    background-image: none !important;

    color: #000000 !important;

    border-color: #cfd6df !important;
}


/* Texto */
.nav-text,
.nav-item ::deep .nav-link .nav-text {
    min-width: 0 !important;

    color: #000000 !important;

    font-size: .64rem !important;
    font-weight: 850 !important;
    line-height: 1.05 !important;

    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}


/* Eliminar adornos antiguos */
.navi-sidebar-shell::before,
.navi-sidebar-shell::after,
.nav-item ::deep .nav-link::before,
.nav-item ::deep .nav-link::after {
    display: none !important;
    content: none !important;

    background: transparent !important;
    background-image: none !important;
    box-shadow: none !important;
}


/* Responsive */
@media (max-width: 640.98px) {
    .navi-sidebar-shell {
        height: auto !important;
        max-height: none !important;

        background: #ffffff !important;
        background-color: #ffffff !important;
        background-image: none !important;

        border-right: 0 !important;
        border-bottom: 1px solid #d9dee7 !important;
    }

    .nav-scrollable {
        max-height: none !important;
    }
}
