    private static async Task<List<T>> SafeLoadListAsync<T>(
        Func<Task<List<T>>> loader,
        List<T>? fallback,
        int timeoutMs,
        string sourceName)
    {
        try
        {
            return await WithTimeoutAsync(
                loader(),
                fallback ?? new List<T>(),
                timeoutMs);
        }
        catch
        {
            return fallback ?? new List<T>();
        }
    }

    private static async Task<T> WithTimeoutAsync<T>(
        Task<T> task,
        T fallback,
        int timeoutMs)
    {
        var completed = await Task.WhenAny(task, Task.Delay(timeoutMs));

        if (completed == task)
        {
            return await task;
        }

        return fallback;
    }

