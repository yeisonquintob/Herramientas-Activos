@using System.Collections.Generic
@using Microsoft.AspNetCore.Components

<section @attributes="AdditionalAttributes"
         class="@CssClass"
         data-ntx-component="card-grid"
         data-ntx-columns="@NormalizedColumns">
    @ChildContent
</section>

@code {
    [Parameter]
    public int Columns { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public bool EqualHeight { get; set; } = true;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>?
        AdditionalAttributes { get; set; }

    private string NormalizedColumns =>
        Columns switch
        {
            1 => "1",
            2 => "2",
            3 => "3",
            4 => "4",
            _ => "auto"
        };

    private string CssClass
    {
        get
        {
            var classes = new List<string>
            {
                "navi-card-grid",
                $"navi-card-grid--{NormalizedColumns}"
            };

            if (Compact)
            {
                classes.Add("navi-card-grid--compact");
            }

            if (EqualHeight)
            {
                classes.Add("navi-card-grid--equal");
            }

            if (!string.IsNullOrWhiteSpace(Class))
            {
                classes.Add(Class.Trim());
            }

            return string.Join(" ", classes);
        }
    }
}
