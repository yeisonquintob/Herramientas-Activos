    private string GetDashboardBranchDisplayName(
        BranchItem item)
    {
        var configuredBranch = dashboardBranches
            .FirstOrDefault(branch =>
                SameDashboardWebFilterText(
                    branch.Code,
                    item.BranchCode)
                ||
                SameDashboardWebFilterText(
                    branch.Name,
                    item.BranchName));

        var code = configuredBranch?.Code;

        if (string.IsNullOrWhiteSpace(code))
        {
            code = item.BranchCode;
        }

        var name = configuredBranch?.Name;

        if (string.IsNullOrWhiteSpace(name))
        {
            name = item.BranchName;
        }

        code = string.IsNullOrWhiteSpace(code)
            ? "-"
            : code.Trim();

        name = string.IsNullOrWhiteSpace(name)
            ? code
            : name.Trim();

        if (string.Equals(
            name,
            code,
            StringComparison.OrdinalIgnoreCase))
        {
            return name;
        }

        return name + " - " + code;
    }

    private int GetDashboardLifeRecordTotal()
    {
        return Math.Max(
            0,
            dashboard?.Summary.TotalTools ?? 0);
    }

    private int GetDashboardCompleteLifeRecords()
    {
        if (dashboard is null)
        {
            return 0;
        }

        var total =
            GetDashboardLifeRecordTotal();

        var withLifeRecord = Math.Clamp(
            dashboard.Summary.WithLifeRecord,
            0,
            total);

        var missingTechnicalData = Math.Clamp(
            dashboard.LifeRecordCoverage.MissingTechnicalData,
            0,
            total);

        return Math.Clamp(
            withLifeRecord - missingTechnicalData,
            0,
            total);
    }

    private int GetDashboardIncompleteLifeRecords()
    {
        var total =
            GetDashboardLifeRecordTotal();

        var complete =
            GetDashboardCompleteLifeRecords();

        return Math.Max(
            0,
            total - complete);
    }

    private string GetDashboardLifeCompletionPercentLabel()
    {
