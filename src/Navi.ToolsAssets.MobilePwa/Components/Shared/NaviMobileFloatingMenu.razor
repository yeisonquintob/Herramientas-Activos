        }

        if (path == "mobile/reports")
        {
            return new(
                "Reportes",
                "Indicadores ejecutivos y operativos.");
        }

        if (path == "mobile/settings")
        {
            return new(
                "Configuración",
                "Información y parámetros personales.");
        }

        if (path.StartsWith(
                "report-damage",
                StringComparison.OrdinalIgnoreCase))
        {
            return new(
                "Reportar novedad",
                "Daño, falla o condición insegura.");
        }

        if (path.StartsWith(
                "tools/",
                StringComparison.OrdinalIgnoreCase))
