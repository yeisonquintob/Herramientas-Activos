                tool.Model,
                value)
            ||
            Contains(
                tool.SerialNumber,
                value)
            ||
            Contains(
                tool.FixedAssetCode,
                value)
            ||
            Contains(
                tool.FenixCode,
                value)
            ||
            Contains(
                tool.BranchCode,
                value)
            ||
            Contains(
                tool.BranchName,
                value)
            ||
            Contains(
                tool.LocationCode,
                value)
            ||
            Contains(
                tool.LocationName,
                value)
            ||
            Contains(
                tool.ShelfLocation,
                value)
            ||
            Contains(
                tool.ResponsiblePersonName,
                value)
            ||
            Contains(
                tool.ToolTypeCode,
                value)
            ||
            Contains(
                tool.ToolTypeName,
                value)
            ||
            Contains(
                tool.ToolCategoryCode,
