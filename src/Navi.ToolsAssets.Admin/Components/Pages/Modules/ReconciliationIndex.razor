@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "physicalCountId")]
    public Guid? PhysicalCountId { get; set; }

    private bool IsAdmin =>
        string.Equals(AuthSession.RoleCode, "ADMIN", StringComparison.OrdinalIgnoreCase)
        || string.Equals(AuthSession.RoleCode, "SUPERADMIN", StringComparison.OrdinalIgnoreCase)
        || string.Equals(AuthSession.RoleName, "Administrador", StringComparison.OrdinalIgnoreCase)
        || string.Equals(AuthSession.RoleName, "Administrador NAVI", StringComparison.OrdinalIgnoreCase);

    private bool CanClarifyReconciliation => HasPermission("Reconciliation.Clarify");
    private bool CanApproveCreationReconciliation => HasPermission("Reconciliation.ApproveCreation");
    private bool CanManageReconciliation => HasPermission("Reconciliation.Manage");

    private bool CanSeeAllReconciliation =>
        IsAdmin || CanClarifyReconciliation || CanApproveCreationReconciliation || CanManageReconciliation;

    private bool HasPermission(string permission)
    {
        return AuthSession.Permissions?.Contains(permission, StringComparer.OrdinalIgnoreCase) == true
            || string.Equals(AuthSession.RoleCode, "ADMIN", StringComparison.OrdinalIgnoreCase)
            || string.Equals(AuthSession.RoleCode, "SUPERADMIN", StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<ReportedItem> VisibleItems =>
        AllItems.Where(CanSeeReportedItem);

    private bool CanSeeReportedItem(ReportedItem item)
    {
        if (CanSeeAllReconciliation)
        {
            return true;
        }

        return IsOwnReportedItem(item);
    }

    private bool IsOwnReportedItem(ReportedItem item)
    {
        var userName = AuthSession.UserName ?? string.Empty;
        var displayName = AuthSession.DisplayName ?? AuthSession.UserName ?? string.Empty;

        return SameUser(item.ParticipantUserName, userName)
            || SameUser(item.ReportedBy, userName)
            || SameUser(item.ParticipantName, displayName)
            || SameUser(item.ResponsibleName, displayName)
            || SameUser(item.ResponsibleName, userName);
    }

    private static bool SameUser(string? left, string? right)
    {
        return !string.IsNullOrWhiteSpace(left)
            && !string.IsNullOrWhiteSpace(right)
            && left.Trim().Equals(right.Trim(), StringComparison.OrdinalIgnoreCase);
    }


    private bool isLoading;
    private string? errorMessage;
    private string? successMessage;

    private List<PhysicalCountListItem> physicalCounts = new();
    private ReportedItemsBoard? board;

    
    // NAVI RECONCILIATION DETAIL MODAL V162 CORR1
    private ReportedItem? detailItem;
private string? selectedCountIdText;
    private string? filterBranch;
    private string? filterParticipant;
    private string? filterReportType;
    private string? filterReconciliationStatus;
    private string? filterMinimumData;
    private string? filterFromDateText;
    private string? filterToDateText;
    private string? searchText;
    private bool onlyPending = true;

    private Guid? SelectedCountId =>
        Guid.TryParse(selectedCountIdText, out var id)
            ? id
            : null;

    private IEnumerable<ReportedItem> AllItems =>
        board?.Items ?? Enumerable.Empty<ReportedItem>();

    private IEnumerable<string> BranchOptions =>
        VisibleItems
            .Select(x => (x.BranchCode ?? board?.BranchCode) ?? string.Empty)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x);

    private IEnumerable<string> ParticipantOptions =>
        VisibleItems
            .Select(x => (x.ParticipantName ?? x.ResponsibleName) ?? string.Empty)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x);

    private IEnumerable<ReportedItem> FilteredItems =>
        VisibleItems
            .Where(MatchesBranch)
            .Where(MatchesParticipant)
            .Where(MatchesReportType)
            .Where(MatchesReconciliationStatus)
            .Where(MatchesMinimumData)
            .Where(MatchesDateRange)
            .Where(MatchesPending)
            .Where(MatchesSearch)
            .OrderBy(x => GetPriority(x))
            .ThenByDescending(x => x.ReportedAt);

    protected override async Task OnInitializedAsync()
    {
        if (!CanSeeAllReconciliation)
        {
            onlyPending = false;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var api = CreateApiClient();

            physicalCounts = await api.GetFromJsonAsync<List<PhysicalCountListItem>>("api/physical-counts") ?? new();

            physicalCounts = physicalCounts
                .OrderByDescending(x => x.StartedAt ?? x.CreatedAt)
                .ThenByDescending(x => x.CountNumber)
                .ToList();

            if (PhysicalCountId.HasValue && physicalCounts.Any(x => x.Id == PhysicalCountId.Value))
            {
                selectedCountIdText = PhysicalCountId.Value.ToString();
            }
            else if (string.IsNullOrWhiteSpace(selectedCountIdText) && physicalCounts.Any())
            {
                selectedCountIdText = physicalCounts.First().Id.ToString();
            }

            await LoadBoardAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error cargando conciliación: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnSelectedCountChangedAsync()
    {
        board = null;
        errorMessage = null;
        successMessage = null;
        await LoadBoardAsync();
    }
private async Task LoadBoardAsync()
    {
        if (!SelectedCountId.HasValue)
        {
            board = null;
            return;
        }

        var api = CreateApiClient();
        board = await api.GetFromJsonAsync<ReportedItemsBoard>($"api/physical-counts/{SelectedCountId.Value}/reported-items-board");

        if (board is not null && !CanSeeAllReconciliation)
        {
            board.Items = board.Items
                .Where(IsOwnReportedItem)
                .ToList();
        }
    }


    private HttpClient CreateApiClient()
    {
        return HttpClientFactory.CreateClient("NaviApi");
    }

// NAVI RECONCILIATION EVIDENCE CODE V170 START

    private List<ReconciliationEvidenceFile>
        detailEvidences = new();

    private bool isLoadingDetailEvidences;

    private string? detailEvidenceError;

    // NAVI V171: evidencia seleccionada para el visor emergente.
    private ReconciliationEvidenceFile? previewEvidence;

    private const long MaxEvidencePreviewBytes =
        20L * 1024L * 1024L;


    private async Task OpenDetailWithEvidenceAsync(
        ReportedItem item)
    {
        detailItem = item;
        previewEvidence = null;

        detailEvidences = new();
        detailEvidenceError = null;
        isLoadingDetailEvidences = true;

        try
        {
            var api = CreateApiClient();

            var loadedEvidences =
                new List<ReconciliationEvidenceFile>();

            var sourceErrors = new List<string>();

            await LoadReportedItemEvidencesAsync(
                api,
                item.Id,
                loadedEvidences,
                sourceErrors);

            foreach (
                var toolAssetId
                in GetEvidenceToolIds(item))
            {
                await LoadToolPhysicalCountEvidencesAsync(
                    api,
                    toolAssetId,
                    loadedEvidences,
                    sourceErrors);
            }

            detailEvidences = loadedEvidences
                .GroupBy(
                    BuildEvidenceIdentity,
                    StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .OrderByDescending(
                    evidence => evidence.UploadedAt)
                .ThenBy(
                    evidence => evidence.FileName)
                .ToList();

            await LoadEvidencePreviewsAsync(api);

            if (detailEvidences.Count == 0 &&
                sourceErrors.Count > 0)
            {
                detailEvidenceError = string.Join(
                    " ",
                    sourceErrors.Distinct(
                        StringComparer.OrdinalIgnoreCase));
            }
        }
        catch (Exception ex)
        {
            detailEvidenceError =
                "No se pudieron cargar las evidencias: "
                + ex.Message;
        }
        finally
        {
            isLoadingDetailEvidences = false;
        }
    }


    private static List<Guid> GetEvidenceToolIds(
        ReportedItem item)
    {
        return new Guid?[]
            {
                item.ToolAssetId,
                item.MatchedToolAssetId,
                item.CreatedToolAssetId
            }
            .Where(
                id =>
                    id.HasValue &&
                    id.Value != Guid.Empty)
            .Select(id => id!.Value)
            .Distinct()
            .ToList();
    }


    private async Task LoadReportedItemEvidencesAsync(
        HttpClient api,
        Guid reportedItemId,
        List<ReconciliationEvidenceFile> target,
        List<string> sourceErrors)
    {
        var endpoint =
            $"api/physical-counts/"
            + $"reported-items/"
            + $"{reportedItemId}/evidences";

        try
        {
            using var response =
                await api.GetAsync(endpoint);

            if (!response.IsSuccessStatusCode)
            {
                sourceErrors.Add(
                    "No se pudieron consultar las "
                    + "evidencias vinculadas directamente "
                    + "al registro. Código HTTP: "
                    + $"{(int)response.StatusCode}.");

                return;
            }

            var evidences =
                await response.Content
                    .ReadFromJsonAsync<
                        List<ReconciliationEvidenceFile>>()
                ?? new();

            foreach (var evidence in evidences)
            {
                evidence.SourceKey =
                    "ReportedItem";

                evidence.SourceLabel =
                    "Evidencia del registro";

                target.Add(evidence);
            }
        }
        catch (Exception ex)
        {
            sourceErrors.Add(
                "Error consultando evidencias "
                + "del registro: "
                + ex.Message);
        }
    }


    private async Task LoadToolPhysicalCountEvidencesAsync(
        HttpClient api,
        Guid toolAssetId,
        List<ReconciliationEvidenceFile> target,
        List<string> sourceErrors)
    {
        var endpoint =
            $"api/tools/{toolAssetId}/documents";

        try
        {
            using var response =
                await api.GetAsync(endpoint);

            if (!response.IsSuccessStatusCode)
            {
                sourceErrors.Add(
                    "No se pudieron consultar las "
                    + "fotografías guardadas en la "
                    + "herramienta. Código HTTP: "
                    + $"{(int)response.StatusCode}.");

                return;
            }

            var documents =
                await response.Content
                    .ReadFromJsonAsync<
                        List<ToolEvidenceDocument>>()
                ?? new();

            foreach (
                var document
                in documents.Where(
                    IsPhysicalCountToolEvidence))
            {
                target.Add(
                    new ReconciliationEvidenceFile
                    {
                        Id = document.Id,
                        FileName =
                            document.FileName,
                        ContentType =
                            document.ContentType,
                        SizeBytes =
                            document.SizeBytes,
                        Description =
                            document.Description,
                        UploadedBy =
                            document.UploadedBy,
                        UploadedAt =
                            document.UploadedAt,
                        DownloadUrl =
                            document.DownloadUrl,
                        SourceKey =
                            "ToolDocument",
                        SourceLabel =
                            "Evidencia guardada "
                            + "en la herramienta"
                    });
            }
        }
        catch (Exception ex)
        {
            sourceErrors.Add(
                "Error consultando fotografías "
                + "de la herramienta: "
                + ex.Message);
        }
    }


    private static bool IsPhysicalCountToolEvidence(
        ToolEvidenceDocument document)
    {
        return string.Equals(
                   document.DocumentType,
                   "PhysicalCountEvidence",
                   StringComparison.OrdinalIgnoreCase)
               ||
               string.Equals(
                   document.DocumentType,
                   "PhotoEvidence",
                   StringComparison.OrdinalIgnoreCase);
    }


    private static string BuildEvidenceIdentity(
        ReconciliationEvidenceFile evidence)
    {
        if (!string.IsNullOrWhiteSpace(
                evidence.DownloadUrl))
        {
            return evidence.DownloadUrl.Trim();
        }

        var uploadedAt =
            evidence.UploadedAt?.ToString("O")
            ?? string.Empty;

        return
            $"{evidence.SourceKey}:"
            + $"{evidence.Id:N}:"
            + $"{evidence.FileName}:"
            + $"{evidence.SizeBytes}:"
            + uploadedAt;
    }


    private async Task LoadEvidencePreviewsAsync(
        HttpClient api)
    {
        foreach (var evidence in detailEvidences)
        {
            if (string.IsNullOrWhiteSpace(
                    evidence.DownloadUrl))
            {
                evidence.PreviewError =
                    "No se recibió una ruta de descarga.";

                continue;
            }

            if (evidence.SizeBytes >
                MaxEvidencePreviewBytes)
            {
                evidence.PreviewError =
                    "El archivo supera 20 MB. "
                    + "No se genera vista previa.";

                continue;
            }

            try
            {
                using var fileResponse =
                    await api.GetAsync(
                        evidence.DownloadUrl);

                if (!fileResponse.IsSuccessStatusCode)
                {
                    evidence.PreviewError =
                        "No se pudo cargar el archivo. "
                        + "Código HTTP: "
                        + $"{(int)fileResponse.StatusCode}.";

                    continue;
                }

                var bytes =
                    await fileResponse.Content
                        .ReadAsByteArrayAsync();

                if (bytes.Length == 0)
                {
                    evidence.PreviewError =
                        "La evidencia está vacía.";

                    continue;
                }

                var contentType =
                    fileResponse.Content.Headers
                        .ContentType
                        ?.MediaType
                    ?? evidence.ContentType
                    ?? "application/octet-stream";

                evidence.ResolvedContentType =
                    contentType;

                evidence.DataUrl =
                    $"data:{contentType};base64,"
                    + Convert.ToBase64String(bytes);
            }
            catch (Exception ex)
            {
                evidence.PreviewError =
                    "No se pudo cargar la vista previa: "
                    + ex.Message;
            }
        }
    }


    private void OpenEvidencePreview(
        ReconciliationEvidenceFile evidence)
    {
        if (string.IsNullOrWhiteSpace(
                evidence.DataUrl))
        {
            return;
        }

        previewEvidence = evidence;
    }


    private void CloseEvidencePreview()
    {
        previewEvidence = null;
    }


    private void CloseDetail()
    {
        previewEvidence = null;
        detailItem = null;

        detailEvidences = new();
        detailEvidenceError = null;
        isLoadingDetailEvidences = false;
    }


    private static bool IsImageEvidence(
        ReconciliationEvidenceFile evidence)
    {
        var contentType =
            evidence.ResolvedContentType
            ?? evidence.ContentType;

        return contentType?.StartsWith(
            "image/",
            StringComparison.OrdinalIgnoreCase)
            == true;
    }


    private static bool IsPdfEvidence(
        ReconciliationEvidenceFile evidence)
    {
        var contentType =
            evidence.ResolvedContentType
            ?? evidence.ContentType;

        return string.Equals(
            contentType,
            "application/pdf",
            StringComparison.OrdinalIgnoreCase);
    }


    private static string FormatEvidenceSize(
        long bytes)
    {
        if (bytes < 1024L)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024L * 1024L)
        {
            return $"{bytes / 1024d:0.0} KB";
        }

        return
            $"{bytes / 1024d / 1024d:0.0} MB";
    }


