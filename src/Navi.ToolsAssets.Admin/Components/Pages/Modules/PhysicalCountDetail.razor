    private string GetParticipantStatusFilterChipClass(string? status)
    {
        var value = status ?? string.Empty;

        var selected = string.Equals(
            selectedParticipantStatus ?? string.Empty,
            value,
            StringComparison.OrdinalIgnoreCase)
            ? " active"
            : string.Empty;

        var css = string.IsNullOrWhiteSpace(value)
            ? "all"
            : value switch
            {
                "NotStarted" => "not-started",
                "InProgress" => "in-progress",
                "Finished" => "finished",
                "FinishedWithDifferences" => "differences",
                "Expired" => "expired",
                _ => "other"
            };

        return $"pc-status-filter-chip pc-status-filter-{css}{selected}";
    }

    private static bool IsParticipantInProgress(ParticipantItem participant)
    {
        return string.Equals(participant.Status, "InProgress", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(participant.StatusLabel, "En proceso", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsParticipantFinished(ParticipantItem participant)
    {
        return string.Equals(participant.Status, "Finished", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(participant.Status, "FinishedWithDifferences", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(participant.StatusLabel, "Finalizada", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(participant.StatusLabel, "Finalizada con diferencias", StringComparison.OrdinalIgnoreCase);
    }

    private static int GetParticipantDifferenceCount(ParticipantItem participant)
    {
        return participant.DifferentItems +
               participant.MissingItems +
               participant.DamagedItems +
               participant.ExtraItems;
    }

    private decimal GetFilteredParticipantsProgress()
    {
        var expected = FilteredParticipants.Sum(x => x.ExpectedItems);

        if (expected <= 0)
        {
            return 0;
        }

        var counted = FilteredParticipants.Sum(GetParticipantReportedCount);

        return Math.Round((decimal)counted * 100 / expected, 2);
    }

    private IEnumerable<ParticipantItem> PhysicalCountBaseFilteredParticipants =>
        VisibleParticipants
