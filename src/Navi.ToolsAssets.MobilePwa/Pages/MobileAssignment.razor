@page "/mobile/assignment"

@using Microsoft.AspNetCore.Components
@using Navi.ToolsAssets.MobilePwa.Models

@inject NaviMobileApiClient Api
@inject MobileAuthSessionService Auth
@inject NavigationManager Navigation
@inject NaviMobileNotificationState NotificationState

<PageTitle>Asignar Herramientas y AF - NAVI</PageTitle>

<section class="mobile-page mobile-assignment-page mobile-assignment-page-v25">

    @*
        Publica el encabezado estándar del MainLayout.
        Permanece montado aunque se abran o cierren paneles.
    *@
    <NaviMobileAppBanner
        Class="mobile-assignment-v25-header-publisher"
        Pill="ACTIVOS FIJOS"
        Title="Asignar Herramientas y AF"
        Description="Solicitudes, asignaciones y regresos."
        HomeUrl="/"
        ShowHomeButton="false"
        ShowBackButton="false" />



    @*
        Publica el título en el encabezado estándar del
        MainLayout móvil.

        Está fuera de todos los bloques condicionales para
        que nunca desaparezca al expandir, ocultar o actualizar.
    *@
@*
        Publica la información en el encabezado estándar
        permanente del MainLayout móvil.

        Se mantiene fuera de los estados de carga,
        autenticación, permisos y contenido.
    *@
@*
        Este componente publica el título y la descripción
        en el encabezado estándar del MainLayout.

        Permanece montado durante carga, actualización,
        errores y cambios internos de la vista.
    *@
@if (isLoading)
    {
        <div class="mobile-loading mobile-assignment-loading-fast">Cargando herramientas visibles...</div>
    }
    else if (!Auth.IsAuthenticated)
    {
        <div class="mobile-empty">
            <strong>Sesión requerida</strong>
            <span>Debes iniciar sesión para usar asignaciones móviles.</span>
            <button class="mobile-primary-button" type="button" @onclick="GoLogin" data-ntx-tone="ghost" >Ir al login</button>
        </div>
    }
    else if (!CanUseAssignmentModule)
    {
        <div class="mobile-empty">
            <strong>Sin permiso</strong>
            <span>Tu usuario no tiene permisos de asignación, devolución, aprobación ni historial.</span>
            <button class="mobile-primary-button" type="button" @onclick="GoHome" data-ntx-tone="secondary" >Volver</button>
        </div>
    }
    else
    {
@if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="@messageClass">@message</div>
        }


<NaviMobileKpiOverflow
    PrimaryCount="3"
    OverflowCount="2"
    Class="navi-mobile-kpi-standard-overflow navi-mobile-assignment-kpi-standard"
    ButtonLabel="Mostrar indicadores adicionales">

    <PrimaryContent>

        <NaviMobileKpiGrid
            Columns="3"
            Compact="true"
            Dividers="true"
            Class="navi-mobile-kpi-standard-grid">

            <NaviMobileKpiCard
                Title="Activos"
                Description="Visibles"
                IconKey="inventory"
                Tone="neutral">

                <ValueContent>
                    @FilteredTools.Count()
                </ValueContent>

            </NaviMobileKpiCard>

            <NaviMobileKpiCard
                Title="Disponibles"
                Description="Para asignar"
                IconKey="check"
                Tone="positive">

                <ValueContent>
                    @(FilteredTools.Count(tool =>
                        string.Equals(
                            tool.OperationalStatus,
                            "Available",
                            StringComparison.OrdinalIgnoreCase)))
                </ValueContent>

            </NaviMobileKpiCard>

            <NaviMobileKpiCard
                Title="Solicitudes"
                Description="Pendientes"
                IconKey="document"
                Tone="warning">

                <ValueContent>
                    @PendingRequests.Count()
                </ValueContent>

            </NaviMobileKpiCard>

        </NaviMobileKpiGrid>

    </PrimaryContent>

    <OverflowContent>

        <NaviMobileKpiGrid
            Columns="2"
            Compact="true"
            Dividers="true"
            Class="navi-mobile-kpi-standard-grid navi-mobile-assignment-kpi-overflow-grid">

            <NaviMobileKpiCard
                Title="En uso"
                Description="Asignados"
                IconKey="transfer"
                Tone="soft">

                <ValueContent>
                    @(FilteredTools.Count(tool =>
                        string.Equals(
                            tool.OperationalStatus,
                            "Assigned",
                            StringComparison.OrdinalIgnoreCase)
                        ||
                        string.Equals(
                            tool.OperationalStatus,
                            "Loaned",
                            StringComparison.OrdinalIgnoreCase)))
                </ValueContent>

            </NaviMobileKpiCard>

            <NaviMobileKpiCard
                Title="Sin responsable"
                Description="Por asignar"
                IconKey="users"
                Tone="danger">

                <ValueContent>
                    @(FilteredTools.Count(tool =>
                        tool.ResponsiblePersonId is null))
                </ValueContent>

            </NaviMobileKpiCard>

        </NaviMobileKpiGrid>

    </OverflowContent>

</NaviMobileKpiOverflow>

        @if (CanApproveAssignmentRequest || CanDenyAssignmentRequest)
        {
            <section id="solicitudes-pendientes" class="mobile-assignment-card mobile-assignment-pending-v25">
                <div class="mobile-assignment-card-head">
                    <div>
                        <strong>Solicitudes pendientes</strong>
                        <span>Solicitudes que requieren una decisión.</span>
                    </div>

                    <strong class="mobile-assignment-pending-count-v25">
                        @PendingRequests.Count()
                    </strong>
                </div>

                @if (!PendingRequests.Any())
                {
                    <div class="mobile-assignment-empty">No hay solicitudes pendientes visibles.</div>
                }
                else
                {
                    <div class="mobile-approval-list">
                        @foreach (var request in PendingRequests.Take(10))
                        {
                            var item = request.Items.FirstOrDefault();

                            <article>
                                <div class="mobile-approval-info">
                                    <span>@request.LoanNumber</span>
                                    <strong>@Display(item?.ToolInternalCode) - @Display(item?.ToolName)</strong>
                                    <small>Solicita: @Display(GetRequesterName(request)) · @ShowDate(request.RequestedAt)</small>
                                </div>

                                <div class="mobile-approval-actions mobile-approval-actions-top">
                                    @if (CanApproveAssignmentRequest)
                                    {
                                        <button class="approve mass-approve-button-v4 mobile-assignment-approve-v25" type="button" disabled="@isSaving" @onclick="() => ApproveAsync(request)" data-ntx-tone="affirmative" >
                                            Aprobar
                                        </button>
                                    }

                                    @if (CanDenyAssignmentRequest)
                                    {
                                        <button class="deny mass-deny-button-v4 mobile-assignment-deny-v25" type="button" disabled="@isSaving" @onclick="() => DenyAsync(request)" data-ntx-tone="danger" >
                                            Denegar
                                        </button>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        }

        @if (CanDirectAssign || CanReturnAssignment)
        {
            <section class="mobile-assignment-card mobile-assignment-collapsible-v27 @(showNewAssignment ? "is-open" : "is-collapsed")">
                <div class="mobile-collapse-head">
                    <div>
                        <strong>Nueva asignación / regreso</strong>
                        <span>Solo roles con permiso de asignar o devolver</span>
                    </div>

                    <button type="button"
                            class="mass-toggle-button-v4
                                   mass-toggle-new-assignment-v4
                                   mobile-assignment-toggle-v27"
                            title="@(showNewAssignment
                                ? "Ocultar nueva asignación o regreso"
                                : "Expandir nueva asignación o regreso")"
                            aria-label="@(showNewAssignment
                                ? "Ocultar nueva asignación o regreso"
                                : "Expandir nueva asignación o regreso")"
                            aria-expanded="@showNewAssignment"
                            @onclick="ToggleNewAssignment"
                            data-ntx-tone="expand">
                        @(showNewAssignment ? "Ocultar" : "Expandir")
                    </button>
                </div>

                @if (showNewAssignment)
                {
                    <label class="mobile-field">
                        <span>Buscar activo</span>
                        <input value="@assignmentSearch"
                               @oninput="OnAssignmentSearchChanged"
                               placeholder="Código, nombre, serial o sede..." />
                    </label>

                    @if (ShowAssignmentSearchResults)
                    {
                        <div class="mobile-request-results">
                            @if (!AssignmentTools.Any())
                            {
                                <div class="mobile-assignment-empty">No se encontraron activos.</div>
                            }
                            else
                            {
                                @foreach (var tool in AssignmentTools.Take(8))
                                {
                                    var selected = assignmentForm.ToolId == tool.Id;

                                    <button type="button"
                                            class="mobile-request-result @(selected ? "selected" : "")"
                                            @onclick="() => SelectAssignmentTool(tool)" data-ntx-tone="ghost" >
                                        <span>
                                            <strong>@tool.InternalCode</strong>
                                            <small>@tool.Name</small>
                                            <small>@Display(tool.BranchCode) · @Display(tool.LocationName)</small>
                                        </span>

                                        <em class="@GetToolStateClass(tool)">
                                            @GetStatusLabel(tool.OperationalStatus)
                                        </em>
                                    </button>
                                }
                            }
                        </div>
                    }

                    @if (selectedAssignmentTool is not null)
                    {
                        <div class="mobile-assignment-selected">
                            <span>@selectedAssignmentTool.InternalCode</span>
                            <strong>@selectedAssignmentTool.Name</strong>
                            <small>@Display(selectedAssignmentTool.BranchCode) · @Display(selectedAssignmentTool.LocationName)</small>
                        </div>
                    }

                    <label class="mobile-field">
                        <span>Tipo de movimiento</span>
                        <select value="@assignmentForm.AssignmentType" @onchange="OnAssignmentTypeChanged">
                            @if (CanDirectAssign)
                            {
                                <option value="Responsible">Asignar a usuario/responsable</option>
                            }

                            @if (CanReturnAssignment)
                            {
                                <option value="Warehouse">Regresar a almacén/taller</option>
                            }
                        </select>
                    </label>

                    @if (assignmentForm.AssignmentType == "Responsible" && CanDirectAssign)
                    {
                        <label class="mobile-field">
                            <span>Usuario / Responsable</span>
                            <select value="@AssignmentResponsibleText" @onchange="OnAssignmentResponsibleChanged">
                                <option value="">Seleccione responsable</option>
                                @foreach (var responsible in responsibles.OrderBy(x => x.FullName))
                                {
                                    <option value="@responsible.Id">@responsible.FullName - @Display(responsible.Position)</option>
                                }
                            </select>
                        </label>
                    }

                    @if (assignmentForm.AssignmentType == "Warehouse" && CanReturnAssignment)
                    {
                        <label class="mobile-field">
                            <span>Sede destino</span>
                            <select value="@AssignmentBranchText" @onchange="OnAssignmentBranchChanged" disabled="@(!UserCanSeeAllBranches())">
                                <option value="">Seleccione sede</option>
                                @foreach (var branch in branches.OrderBy(x => x.Code))
                                {
                                    <option value="@branch.Id">@branch.Code - @branch.Name</option>
                                }
                            </select>
                        </label>

                        <label class="mobile-field">
                            <span>Almacén / taller destino</span>
                            <select value="@AssignmentLocationText" @onchange="OnAssignmentLocationChanged">
                                <option value="">Seleccione almacén/taller</option>
                                @foreach (var location in AvailableAssignmentLocations.OrderBy(x => x.Code))
                                {
                                    <option value="@location.Id">@location.Code - @location.Name</option>
                                }
                            </select>
                        </label>
                    }

                    <label class="mobile-field">
                        <span>@(assignmentForm.AssignmentType == "Warehouse" ? "Fecha de regreso" : "Fecha de asignación")</span>
                        <input type="date"
                               value="@FormatDateInput(assignmentForm.AssignmentDate)"
                               @onchange="OnAssignmentDateChanged" />
                    </label>

                    <label class="mobile-field">
                        <span>Observación</span>
                        <textarea rows="2"
                                  value="@assignmentForm.Observation"
                                  @oninput="OnAssignmentObservationChanged"
                                  placeholder="Observación del movimiento..."></textarea>
                    </label>

                    <button class="mobile-assignment-main-button mobile-assignment-confirm-v25" type="button" disabled="@isSaving" @onclick="SaveDirectAssignmentAsync" data-ntx-tone="affirmative" >
                        @(isSaving ? "Guardando..." : assignmentForm.AssignmentType == "Warehouse" ? "Confirmar regreso" : "Confirmar asignación")
                    </button>
                }
            </section>
        }

        @if (CanViewAssignmentHistory)
        {
            <details class="mobile-assignment-card
                            mobile-assignment-history-v28">

                <summary class="mobile-collapse-head
                                mobile-assignment-history-summary-v28">

                    <div>
                        <strong>Historial</strong>

                        <span>
                            Movimientos visibles según sede y permisos.
                        </span>
                    </div>

                    <span class="mobile-assignment-history-toggle-v28"
                          aria-hidden="true">

                        <span class="mobile-assignment-history-expand-v28">
                            Expandir
                        </span>

                        <span class="mobile-assignment-history-hide-v28">
                            Ocultar
                        </span>
                    </span>
                </summary>

                <div class="mobile-assignment-history-body-v28">

                    <label class="mobile-field
                                  mobile-assignment-history-search-v28">

                        <span>Buscar movimiento</span>

                        <input id="mobile-assignment-history-search"
                               name="mobile-assignment-history-search"
                               type="search"
                               autocomplete="off"
                               value="@historySearch"
                               @oninput="OnHistorySearchChanged"
                               placeholder="Préstamo, activo, código o usuario..." />
                    </label>

                    @if (!FilteredHistory.Any())
                    {
                        <div class="mobile-assignment-empty">

                            No hay movimientos para los filtros
                            seleccionados.
                        </div>
                    }
                    else
                    {
                        <div class="mobile-history-list">

                            @foreach (var request in FilteredHistory.Take(12))
                            {
                                var item =
                                    request.Items.FirstOrDefault();

                                <article>

                                    <div>
                                        <span>
                                            @request.LoanNumber
                                        </span>

                                        <strong>
                                            @Display(item?.ToolInternalCode)
                                            -
                                            @Display(item?.ToolName)
                                        </strong>

                                        <small>
                                            @GetLoanStatusLabel(request.Status)
                                            ·
                                            @ShowDate(request.CreatedAt)
                                        </small>

                                        <small>
                                            Usuario:
                                            @Display(GetRequesterName(request))
                                        </small>
                                    </div>

                                    <em class="@GetLoanStatusClass(
                                        request.Status)">

                                        @GetLoanStatusLabel(
                                            request.Status)
                                    </em>
                                </article>
                            }
                        </div>
                    }
                </div>
            </details>
        }

        <section class="mobile-assignment-card mobile-assignment-visible-tools-v28">

            <div class="mobile-assignment-card-head mobile-assignment-visible-tools-head-v28">

                <div>
                    <strong>Herramientas / activos visibles</strong>

                    <span>
                        Consulta por estado y selecciona un activo para asignar o regresar.
                    </span>
                </div>
            </div>

            <div class="mobile-assignment-visible-tools-content-v28">
<div class="mobile-assignment-filters mobile-assignment-tools-filter-v2">
                <input id="mobile-assignment-tool-search"
                       name="mobile-assignment-tool-search"
                       type="search"
                       autocomplete="off" @bind="toolSearch"
                       @bind:event="oninput"
                       placeholder="Buscar código, nombre, serial, sede o ubicación..." />

                <label class="mobile-assignment-status-field-v28"
                       for="mobile-assignment-tool-status">

                    <span>Estado</span>

                    <select id="mobile-assignment-tool-status"
                            name="mobile-assignment-tool-status"
                            aria-label="Estado del activo"
                            @bind="SelectedToolStatusValue">

                        <option value="">
                            Todos los estados (@ToolsBaseFiltered.Count())
                        </option>

                        @foreach (var status in ToolStatusFilterOptions)
                        {
                            <option value="@status.Value">
                                @status.Text (@CountToolsByStatus(status.Value))
                            </option>
                        }
                    </select>
                </label>
            </div>

            @if (!FilteredTools.Any())
            {
                <div class="mobile-assignment-empty">No hay activos para mostrar.</div>
            }
            else
            {
                <div class="mobile-assignment-tools">
                    @foreach (var tool in FilteredTools.Take(40))
                    {
                        <article>
                            <div class="mobile-assignment-tool-head">
                                <div>
                                    <span>@tool.InternalCode</span>
                                    <strong>@tool.Name</strong>
                                </div>

                                <em class="@GetToolStateClass(tool)">
                                    @GetStatusLabel(tool.OperationalStatus)
                                </em>
                            </div>

                            <div class="mobile-assignment-tool-grid">
                                <div>
                                    <span>Sede</span>
                                    <strong>@Display(tool.BranchCode)</strong>
                                </div>

                                <div>
                                    <span>Ubicación</span>
                                    <strong>@Display(tool.LocationName)</strong>
                                </div>

                                <div>
                                    <span>Responsable</span>
                                    <strong>@Display(tool.ResponsiblePersonName)</strong>
                                </div>

                                <div>
                                    <span>Físico</span>
                                    <strong>@Display(tool.PhysicalStatus)</strong>
                                </div>
                            </div>

                            <div class="mobile-assignment-tool-actions mobile-assignment-tool-actions-v4">

                                <button type="button"
                                        class="mass-tool-assign-button-v4 mobile-assignment-tool-assign-v25"
                                        title="Asignar activo"
                                        aria-label="@($"Asignar {tool.InternalCode}")"
                                        disabled="@(!CanDirectAssign)"
                                        @onclick="() => SelectAssignmentTool(tool)"
                                        data-ntx-tone="operation">

                                    Asignar
                                </button>

                                <button type="button"
                                        class="mobile-assignment-tool-return-v26"
                                        title="Regresar activo al almacén"
                                        aria-label="@($"Regresar {tool.InternalCode} al almacén")"
                                        disabled="@(!CanReturnAssignment || !CanReturnTool(tool))"
                                        @onclick="() => SelectReturnTool(tool)"
                                        data-ntx-tone="warning">

                                    Regresar
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
            </div>
        </section>
    }
</section>

@code {
    private bool isLoading = true;
    private bool isSaving;
    private bool isSecondaryLoading;
    private bool showNewAssignment = false;
private bool showSecondaryKpis;
    private string? message;
    private string messageClass = "mobile-alert";

    private string loanSearch = string.Empty;
    private string assignmentSearch = string.Empty;
    private string historySearch = string.Empty;
    private string toolSearch = string.Empty;
    private string toolStatus = string.Empty;
    private HashSet<string> selectedToolStatuses = new(StringComparer.OrdinalIgnoreCase);

    private readonly (string Value, string Text)[] ToolStatusFilterOptions =
    {
        ("Available", "Disponible"),
        ("Assigned", "Asignada"),
        ("Loaned", "Prestada"),
        ("InMaintenance", "Mantenimiento"),
        ("Damaged", "Dañada"),
        ("NotSuitable", "No apta"),
        ("PendingValidation", "Pendiente validación"),
        ("NotLocated", "No localizada"),
        ("Disposed", "Baja")
    };

    private List<MobileAvailabilityToolDto> tools = new();
    private List<MobileLoanRequestDto> loanRequests = new();
    private List<MobileResponsibleDto> responsibles = new();
    private List<MobileBranchDto> branches = new();
    private List<MobileLocationDto> locations = new();

    private MobileLoanRequestForm loanForm = new();
    private MobileDirectAssignmentForm assignmentForm = new();

    private bool CanRequestLoan => HasAny("Mobile.Loans.Request", "AssetAssignment.Request");
    private bool CanDirectAssign => HasPermission("AssetAssignment.Assign");
    private bool CanReturnAssignment => HasPermission("AssetAssignment.Return");
    private bool CanApproveAssignmentRequest => HasPermission("AssetAssignment.Approve");
    private bool CanDenyAssignmentRequest => HasPermission("AssetAssignment.Deny");
    private bool CanViewAssignmentHistory => HasPermission("AssetAssignment.History");
    private bool CanViewToolDetail => HasAny("ToolDetail.View", "Tools.View", "Mobile.Tools.View");
    private bool CanViewLifeRecord => HasAny("TechnicalLifeRecord.View", "ToolDetail.LifeRecord.Open");
    private bool CanReportDamage => HasAny("Mobile.Damage.Report", "Damages.Create");

    private bool CanUseAssignmentModule =>
        HasPermission("AssetAssignment.View") ||
        CanDirectAssign ||
        CanReturnAssignment ||
        CanApproveAssignmentRequest ||
        CanDenyAssignmentRequest ||
        CanViewAssignmentHistory;

    private string CurrentResponsibleLabel =>
        !string.IsNullOrWhiteSpace(Auth.CurrentUser?.ResponsiblePersonName)
            ? Auth.CurrentUser!.ResponsiblePersonName!
            : Auth.CurrentUser?.DisplayName ?? Auth.CurrentUser?.UserName ?? "Usuario móvil";

    private string AssignmentResponsibleText => assignmentForm.ResponsiblePersonId?.ToString() ?? string.Empty;
    private string AssignmentBranchText => assignmentForm.BranchId?.ToString() ?? string.Empty;
    private string AssignmentLocationText => assignmentForm.LocationId?.ToString() ?? string.Empty;

    private IEnumerable<MobileAvailabilityToolDto> ScopedTools =>
        tools
            .Where(IsSameBranch)
            .OrderBy(x => x.BranchCode)
            .ThenBy(x => x.InternalCode);

    private MobileAvailabilityToolDto? selectedLoanTool =>
        loanForm.ToolId.HasValue
            ? ScopedTools.FirstOrDefault(x => x.Id == loanForm.ToolId.Value)
            : null;

    private MobileAvailabilityToolDto? selectedAssignmentTool =>
        assignmentForm.ToolId.HasValue
            ? ScopedTools.FirstOrDefault(x => x.Id == assignmentForm.ToolId.Value)
            : null;

    private bool ShowLoanSearchResults =>
        CanRequestLoan &&
        !string.IsNullOrWhiteSpace(loanSearch) &&
        selectedLoanTool is null;

    private bool ShowAssignmentSearchResults =>
        (CanDirectAssign || CanReturnAssignment) &&
        !string.IsNullOrWhiteSpace(assignmentSearch) &&
        selectedAssignmentTool is null;

    private IEnumerable<MobileAvailabilityToolDto> LoanRequestTools =>
        ScopedTools
            .Where(IsToolAvailableForLoan)
            .Where(x => string.IsNullOrWhiteSpace(loanSearch) ||
                        ContainsText(x.InternalCode, loanSearch) ||
                        ContainsText(x.Name, loanSearch) ||
                        ContainsText(x.SerialNumber, loanSearch) ||
                        ContainsText(x.BranchCode, loanSearch) ||
                        ContainsText(x.LocationName, loanSearch))
            .OrderByDescending(x => ContainsStatus(x.OperationalStatus, "Available"))
            .ThenBy(x => x.InternalCode);

    private IEnumerable<MobileAvailabilityToolDto> AssignmentTools =>
        ScopedTools
            .Where(x => string.IsNullOrWhiteSpace(assignmentSearch) ||
                        ContainsText(x.InternalCode, assignmentSearch) ||
                        ContainsText(x.Name, assignmentSearch) ||
                        ContainsText(x.SerialNumber, assignmentSearch) ||
                        ContainsText(x.BranchCode, assignmentSearch) ||
                        ContainsText(x.LocationName, assignmentSearch))
            .OrderByDescending(x => ContainsStatus(x.OperationalStatus, "Available"))
            .ThenBy(x => x.InternalCode);

    private IEnumerable<MobileLocationDto> AvailableAssignmentLocations =>
        assignmentForm.BranchId.HasValue
            ? locations.Where(x => x.BranchId == assignmentForm.BranchId.Value)
            : locations;

    private IEnumerable<MobileLoanRequestDto> PendingRequests =>
        loanRequests
            .Where(x => CanApproveAssignmentRequest || CanDenyAssignmentRequest)
            .Where(x => IsPendingStatus(x.Status))
            .Where(x => x.Items.Any(i => !i.Returned))
            .Where(RequestInVisibleScope)
            .OrderByDescending(x => x.CreatedAt);

    private int ApprovedOrDeliveredCount =>
        loanRequests.Count(x =>
            RequestInVisibleScope(x) &&
            (
                x.Status.Equals("Approved", StringComparison.OrdinalIgnoreCase) ||
                x.Status.Equals("Delivered", StringComparison.OrdinalIgnoreCase)
            ));

    private int VisibleHistoryTotal =>
        loanRequests
            .Where(x => CanViewAssignmentHistory)
            .Where(x => !IsPendingStatus(x.Status))
            .Where(RequestInVisibleScope)
            .Count();

    private IEnumerable<MobileLoanRequestDto> FilteredHistory =>
        loanRequests
            .Where(x => CanViewAssignmentHistory)
            .Where(x => !IsPendingStatus(x.Status))
            .Where(RequestInVisibleScope)
            .Where(x => string.IsNullOrWhiteSpace(historySearch) ||
                        ContainsText(x.LoanNumber, historySearch) ||
                        ContainsText(x.CreatedBy, historySearch) ||
                        x.Items.Any(i => ContainsText(i.ToolInternalCode, historySearch) || ContainsText(i.ToolName, historySearch)))
            .OrderByDescending(x => x.CreatedAt);

    private IEnumerable<MobileAvailabilityToolDto> ToolsBaseFiltered =>
        ScopedTools
            .Where(MatchesToolSearch)
            .OrderByDescending(x => ContainsStatus(x.OperationalStatus, "Available"))
            .ThenBy(x => x.BranchCode)
            .ThenBy(x => x.InternalCode);

    private IEnumerable<MobileAvailabilityToolDto> FilteredTools =>
        ToolsBaseFiltered
            .Where(MatchesSelectedToolStatuses)
            .OrderByDescending(x => ContainsStatus(x.OperationalStatus, "Available"))
            .ThenBy(x => x.BranchCode)
            .ThenBy(x => x.InternalCode);

    private bool MatchesToolSearch(MobileAvailabilityToolDto tool)
    {
        if (string.IsNullOrWhiteSpace(toolSearch))
        {
            return true;
        }

        return ContainsText(tool.InternalCode, toolSearch)
            || ContainsText(tool.Name, toolSearch)
            || ContainsText(tool.SerialNumber, toolSearch)
            || ContainsText(tool.BranchCode, toolSearch)
            || ContainsText(tool.BranchName, toolSearch)
            || ContainsText(tool.LocationName, toolSearch)
            || ContainsText(tool.ResponsiblePersonName, toolSearch)
            || ContainsText(tool.PhysicalStatus, toolSearch)
            || ContainsText(tool.OperationalStatus, toolSearch)
            || ContainsText(GetStatusLabel(tool.OperationalStatus), toolSearch);
    }

    private bool MatchesSelectedToolStatuses(MobileAvailabilityToolDto tool)
    {
        return selectedToolStatuses.Count == 0 ||
               selectedToolStatuses.Contains(tool.OperationalStatus ?? string.Empty);
    }

    private int CountToolsByStatus(string status)
    {
        return ToolsBaseFiltered.Count(x => SameToolStatus(x.OperationalStatus, status));
    }

    private string GetToolStatusFilterChipClass(string status, bool selected)
    {
        var active = selected ? " active" : string.Empty;
        return $"mobile-assignment-status-chip-v2 {NormalizeToolStatusCss(status)}{active}";
    }

    private static bool SameToolStatus(string? left, string? right)
    {
        return !string.IsNullOrWhiteSpace(left) &&
               !string.IsNullOrWhiteSpace(right) &&
               string.Equals(left.Trim(), right.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizeToolStatusCss(string? status)
    {
        return status switch
        {
            "Available" => "available",
            "Assigned" => "assigned",
            "Loaned" => "loaned",
            "InMaintenance" => "maintenance",
            "Damaged" => "damaged",
            "NotSuitable" => "not-suitable",
            "PendingValidation" => "pending",
            "NotLocated" => "not-located",
            "Disposed" => "disposed",
            _ => "other"
        };
    }

