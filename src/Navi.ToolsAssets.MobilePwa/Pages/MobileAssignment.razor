        if (!string.IsNullOrWhiteSpace(
                tool.ResponsiblePersonName))
        {
            return true;
        }

        return string.Equals(
                   tool.OperationalStatus,
                   "Assigned",
                   StringComparison.OrdinalIgnoreCase)
               ||
               string.Equals(
                   tool.OperationalStatus,
                   "Loaned",
                   StringComparison.OrdinalIgnoreCase);
    }

