@using Microsoft.AspNetCore.Components

<section @attributes="AdditionalAttributes" class="@CssClass">
    @if (!string.IsNullOrWhiteSpace(Pill))
    {
        <span class="navi-mobile-empty__pill">@Pill</span>
    }

    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <strong>@Title</strong>
    }

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <span>@Description</span>
    }

    @if (ChildContent is not null)
    {
        <div class="navi-mobile-empty__actions">
            @ChildContent
        </div>
    }
</section>

@code {
    [Parameter] public string? Pill { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => string.IsNullOrWhiteSpace(Class)
        ? "navi-mobile-empty"
        : $"navi-mobile-empty {Class}";
}
