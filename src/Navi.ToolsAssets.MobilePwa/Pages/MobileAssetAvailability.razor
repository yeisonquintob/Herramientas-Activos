    private string GetAvailabilityStatusFilterChipClass(string? status)
    {
        var value = status ?? string.Empty;

        var selected = SameNormalized(selectedStatus, value)
            ? " active"
            : string.Empty;

        var statusClass = string.IsNullOrWhiteSpace(value)
            ? "all"
            : NormalizeStatusCss(value);

        return $"mobile-av-status-chip mobile-av-status-chip-{statusClass}{selected}";
    }

    private string GetStatusClass(string? status)
    {
        return $"mobile-av-status-badge mobile-av-status-{NormalizeStatusCss(status)}";
    }

    private static string NormalizeStatusCss(string? status)
    {
        return status switch
        {
            "Available" => "available",
            "Assigned" => "assigned",
            "Loaned" => "loaned",
            "InMaintenance" => "maintenance",
            "Damaged" => "damaged",
            "NotSuitable" => "not-suitable",
            "PendingValidation" => "pending",
            "NotLocated" => "not-located",
            "PendingDisposal" => "disposal",
            "Disposed" => "disposed",
            _ => "other"
        };
    }

    private static string StatusLabel(string? status)
    {
        return status switch
        {
            "Available" => "Disponible",
            "Assigned" => "Asignada",
            "Loaned" => "Prestada",
            "InMaintenance" => "En mantenimiento",
            "Damaged" => "Dañada",
            "NotSuitable" => "No apta",
            "PendingValidation" => "Pendiente validación",
            "NotLocated" => "No localizada",
            "PendingDisposal" => "Pendiente baja",
            "Disposed" => "Dada de baja",
            _ => string.IsNullOrWhiteSpace(status) ? "Sin estado" : status
        };
    }

    private static bool IsAvailable(MobileAvailabilityToolDto tool) =>
        SameNormalized(tool.OperationalStatus, "Available");

    private static bool IsAssignedOrLoaned(MobileAvailabilityToolDto tool) =>
        SameNormalized(tool.OperationalStatus, "Assigned") ||
        SameNormalized(tool.OperationalStatus, "Loaned");

    private static bool IsInMaintenance(MobileAvailabilityToolDto tool) =>
        SameNormalized(tool.OperationalStatus, "InMaintenance");

    private static bool IsWithoutLocation(MobileAvailabilityToolDto tool) =>
        string.IsNullOrWhiteSpace(tool.LocationName);

    private bool HasAny(params string[] permissions)
    {
        return permissions.Any(HasPermission);
    }

    private bool HasPermission(string permission)
    {
        return Auth.HasPermission(permission);
    }

    private static bool Contains(string? value, string? query)
    {
        if (string.IsNullOrWhiteSpace(value) || string.IsNullOrWhiteSpace(query))
        {
            return false;
        }

        return Normalize(value).Contains(Normalize(query), StringComparison.OrdinalIgnoreCase);
    }

    private static bool SameNormalized(string? left, string? right)
    {
        var a = Normalize(left);
        var b = Normalize(right);

        return !string.IsNullOrWhiteSpace(a)
            && !string.IsNullOrWhiteSpace(b)
            && string.Equals(a, b, StringComparison.OrdinalIgnoreCase);
    }

    private static string Normalize(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value
            .Trim()
            .ToUpperInvariant()
            .Replace("Á", "A")
            .Replace("É", "E")
            .Replace("Í", "I")
            .Replace("Ó", "O")
            .Replace("Ú", "U")
            .Replace("Ü", "U")
            .Replace("Ñ", "N");
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "—" : value;
    }


