    private static bool IsDataImage(string? value)
    {
        return !string.IsNullOrWhiteSpace(value) &&
            value.StartsWith(
                "data:image/",
                StringComparison.OrdinalIgnoreCase);
    }

    private async Task<PersistentEvidenceItem?> UploadWorkspaceEvidenceAsync(
        Guid workspaceId,
        Guid referenceId,
        string evidenceType,
        string? referenceName,
        string? fileName,
        string? contentType,
        string? dataUrl)
    {
        if (!TryDecodeDataImage(
                dataUrl,
                out var bytes,
                out var detectedContentType))
        {
            errorMessage =
                "No fue posible preparar la imagen para guardarla.";
            return null;
        }

        var finalContentType = string.IsNullOrWhiteSpace(contentType)
            ? detectedContentType
            : contentType.Trim().ToLowerInvariant();

        if (finalContentType is not
            ("image/jpeg" or "image/png" or "image/webp"))
        {
            finalContentType = detectedContentType;
        }

        var finalFileName = string.IsNullOrWhiteSpace(fileName)
            ? $"evidencia-{referenceId:N}{GetImageExtension(finalContentType)}"
            : Path.GetFileName(fileName);

        try
        {
            var api = CreateApiClient();

            using var form = new MultipartFormDataContent();
            using var fileContent = new ByteArrayContent(bytes);

            fileContent.Headers.ContentType =
                System.Net.Http.Headers.MediaTypeHeaderValue.Parse(
                    finalContentType);

            form.Add(fileContent, "file", finalFileName);
            form.Add(
                new StringContent(referenceId.ToString()),
                "referenceId");
            form.Add(
                new StringContent(evidenceType),
                "evidenceType");
            form.Add(
                new StringContent(referenceName ?? string.Empty),
                "referenceName");

            using var response = await api.PostAsync(
                $"api/purchase-requests/workspaces/{workspaceId}/evidences",
                form);

            if (!response.IsSuccessStatusCode)
            {
                var apiError =
                    await response.Content.ReadFromJsonAsync<ApiError>();

                errorMessage =
                    apiError?.Message
                    ?? "No fue posible guardar permanentemente la imagen.";

                return null;
            }

            return await response.Content
                .ReadFromJsonAsync<PersistentEvidenceItem>();
        }
        catch (Exception ex)
        {
            errorMessage =
                "No fue posible guardar permanentemente la imagen: "
                + ex.Message;

            return null;
        }
    }

    private async Task RehydrateStoredEvidencePreviewsAsync()
    {
        if (!IsPurchase || storedRequests.Count == 0)
        {
            return;
        }

        try
        {
            var api = CreateApiClient();
            using var timeout = new CancellationTokenSource(
                TimeSpan.FromSeconds(25));

            foreach (var request in storedRequests)
            {
                foreach (var line in request.Lines)
                {
                    if (line.EvidenceId.HasValue &&
                        string.IsNullOrWhiteSpace(line.ImagePreview))
                    {
                        line.ImagePreview = await DownloadEvidencePreviewAsync(
                            api,
                            line.EvidenceId.Value,
                            line.EvidenceContentType,
                            timeout.Token);
                    }
                }

                foreach (var quote in request.Quotations)
                {
                    if (quote.EvidenceId.HasValue &&
                        string.IsNullOrWhiteSpace(quote.EvidencePreview))
                    {
                        quote.EvidencePreview = await DownloadEvidencePreviewAsync(
                            api,
                            quote.EvidenceId.Value,
                            quote.EvidenceContentType,
                            timeout.Token);
                    }
                }
            }
        }
        catch
        {
            // Los borradores siguen disponibles aunque MinIO o la API estén fuera de línea.
        }
    }

