@using Microsoft.AspNetCore.Components

<label class="@CssClass">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <span class="navi-select__label">@Label</span>
    }

    <select @attributes="AdditionalAttributes"
            value="@Value"
            disabled="@Disabled"
            aria-label="@ResolvedAriaLabel"
            @onchange="HandleChangeAsync">
        @Options
    </select>
</label>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Options { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ResolvedAriaLabel =>
        AriaLabel ?? Label ?? "Seleccionar opción";

    private string CssClass =>
        string.IsNullOrWhiteSpace(Class)
            ? "navi-select"
            : $"navi-select {Class.Trim()}";

    private Task HandleChangeAsync(ChangeEventArgs args) =>
        ValueChanged.InvokeAsync(args.Value?.ToString());
}
