@page "/asset-availability"
@rendermode InteractiveServer
@using Navi.ToolsAssets.Admin.Services.Auth
@using System.Net.Http.Json
@using Navi.ToolsAssets.Admin.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject NaviAccessScopeService AccessScope
@inject WebAuthSessionService AuthSession

<PageTitle>Disponible y Ubicación de Herramientas - NAVI</PageTitle>

<PermissionGuard Permission="AssetAvailability.View" ModuleName="Disponible y Ubicación de Herramientas">

<NaviPageHero
    Pill="ACTIVOS FIJOS"
    Title="Disponible y Ubicación de Herramientas"
    Description="Gestiona disponibilidad, sede, almacén, taller o ubicación interna de las herramientas.">

    <button type="button" @onclick="LoadAsync">
        Actualizar
    </button>

</NaviPageHero>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="@messageClass">@message</div>
}


<section class="availability-kpi-grid">
    <article class="availability-kpi total">
        <span>Total herramientas</span>
        <strong>@FilteredTools.Count()</strong>
        <small>Visibles por alcance</small>
    </article>

    <article class="availability-kpi success">
        <span>Disponibles</span>
        <strong>@FilteredTools.Count(x => string.Equals(x.OperationalStatus, "Available", StringComparison.OrdinalIgnoreCase))</strong>
        <small>Listas para uso</small>
    </article>

    <article class="availability-kpi blue">
        <span>Asignadas / prestadas</span>
        <strong>@FilteredTools.Count(x => string.Equals(x.OperationalStatus, "Assigned", StringComparison.OrdinalIgnoreCase) || string.Equals(x.OperationalStatus, "Loaned", StringComparison.OrdinalIgnoreCase))</strong>
        <small>Con responsable</small>
    </article>

    <article class="availability-kpi warning">
        <span>En mantenimiento</span>
        <strong>@FilteredTools.Count(x => string.Equals(x.OperationalStatus, "InMaintenance", StringComparison.OrdinalIgnoreCase))</strong>
        <small>Fuera de operación</small>
    </article>

    <article class="availability-kpi danger">
        <span>Sin ubicación</span>
        <strong>@FilteredTools.Count(x => string.IsNullOrWhiteSpace(x.LocationName))</strong>
        <small>Requieren revisión</small>
    </article>
</section>

<section class="availability-status-filters availability-status-filters-modern" aria-label="Estados de disponibilidad">
    <button type="button"
            class="@GetAvailabilityStatusFilterChipClass(string.Empty)"
            @onclick="@(() => SelectAvailabilityStatus(string.Empty))">
        Todos
        <span>@AvailabilityBaseFilteredTools.Count()</span>
    </button>

    @foreach (var option in AvailabilityStatusFilterOptions)
    {
        <button type="button"
                class="@GetAvailabilityStatusFilterChipClass(option.Value)"
                @onclick="@(() => SelectAvailabilityStatus(option.Value))">
            @option.Label
            <span>@option.Count</span>
        </button>
    }
</section>

<section class="availability-page-filters" aria-label="Filtros de disponibilidad y ubicación">
    <input class="form-control form-control-sm"
           placeholder="Buscar por código, nombre, serial, sede, ubicación o responsable..."
           @bind="search"
           @bind:event="oninput" />

    <select class="form-select form-select-sm availability-branch-filter" @bind="selectedBranchCode">
        <option value="">@(AccessScope.IsAllBranchScope() ? "Todas las sedes" : AccessScope.GetDefaultBranchFilterText())</option>
        @foreach (var branch in ScopedTools
            .Select(x => x.BranchCode)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x))
        {
            <option value="@branch">@branch</option>
        }
    </select>
</section>

<section class="af-grid">
    <aside class="af-card">
        <h3>Gestionar ubicación</h3>

        <div class="mb-2 navi-search-field">
            <label class="form-label">Herramienta</label>
            <input class="form-control"
                   list="availability-tools-list"
                   value="@toolSearchText"
                   @oninput="OnToolSearchInput"
                   placeholder="Escriba código, nombre o serial..." />

            <datalist id="availability-tools-list">
                @foreach (var tool in ScopedTools.OrderBy(x => x.InternalCode))
                {
                    <option value="@FormatToolOption(tool)"></option>
                }
            </datalist>

            <small class="@GetToolSearchHintClass()">@GetToolSearchHint()</small>
        </div>

        <div class="mb-2 navi-search-field">
            <label class="form-label">Sede</label>
            <input class="form-control"
                   list="availability-branches-list"
                   value="@branchSearchText"
                   @oninput="OnBranchSearchInput"
                   placeholder="Escriba código o nombre de sede..." / disabled="@(!CanChangeAvailabilityLocation)">

            <datalist id="availability-branches-list">
                @foreach (var branch in branches.OrderBy(x => x.Code))
                {
                    <option value="@FormatBranchOption(branch)"></option>
                }
            </datalist>

            <small class="@GetBranchSearchHintClass()">@GetBranchSearchHint()</small>
        </div>

        <div class="mb-2 navi-search-field">
            <label class="form-label">Almacén / Taller / Ubicación</label>
            <input class="form-control"
                   list="availability-locations-list"
                   value="@locationSearchText"
                   @oninput="OnLocationSearchInput"
                   placeholder="Escriba almacén, taller o ubicación..." / disabled="@(!CanChangeAvailabilityLocation)">

            <datalist id="availability-locations-list">
                @foreach (var location in AvailableLocations.OrderBy(x => x.Code))
                {
                    <option value="@FormatLocationOption(location)"></option>
                }
            </datalist>

            <small class="@GetLocationSearchHintClass()">@GetLocationSearchHint()</small>
        </div>


        <div class="mb-2">
            <label class="form-label">Estantería / ubicación exacta</label>
            <InputText class="form-control"
                       @bind-Value="form.ShelfLocation"
                       placeholder="Ej: EST-A1, RACK-3, CAJÓN 2"
                       disabled="@(!CanChangeAvailabilityLocation)" />
            <small class="navi-search-hint ok">Punto exacto dentro del almacén, taller o ubicación seleccionada.</small>
        </div>

        <div class="mb-2">
            <label class="form-label">Estado operativo</label>
            <InputSelect class="form-select" @bind-Value="form.OperationalStatus" disabled="@(!CanChangeAvailabilityStatus)">
                <option value="Available">Disponible</option>
                <option value="Assigned">Asignada</option>
                <option value="Loaned">Prestada</option>
                <option value="InMaintenance">En mantenimiento</option>
                <option value="Damaged">Dañada</option>
                <option value="NotSuitable">No apta</option>
                <option value="PendingValidation">Pendiente validación</option>
                <option value="NotLocated">No localizada</option>
                <option value="PendingDisposal">Pendiente baja</option>
                <option value="Disposed">Dada de baja</option>
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Observación</label>
            <InputTextArea class="form-control" @bind-Value="form.Observation" rows="3" />
        </div>

        <div class="d-grid gap-2">
            @if (!CanChangeAvailabilityLocation || !CanChangeAvailabilityStatus)
        {
            <div class="availability-permission-note">
                @if (!CanChangeAvailabilityLocation)
                {
                    <span>Ubicación bloqueada</span>
                }

                @if (!CanChangeAvailabilityStatus)
                {
                    <span>Estado bloqueado</span>
                }
            </div>
        }

        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@(isSaving || !CanSaveAvailability || !form.ToolId.HasValue)">
                @(isSaving ? "Guardando..." : "Guardar cambios")
            </button>

            <button class="btn btn-outline-secondary" @onclick="ClearForm">
                Limpiar
            </button>
        </div>
    </aside>

    <section class="af-card">
        <div class="af-table-header">
            <div>
                <h3>Herramientas por disponibilidad</h3>
                <p>Selecciona una herramienta para modificar su ubicación.</p>
            </div>
</div>

        @if (isLoading)
        {
            <p>Cargando herramientas...</p>
        }
        else
        {
            <table class="table table-hover align-middle af-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Activo</th>
                        <th>Sede</th>
                        <th>Ubicación</th>
                        <th>Estantería</th>
                        <th>Responsable</th>
                        <th>Estado</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tool in FilteredTools)
                    {
                        <tr>
                            <td><strong>@tool.InternalCode</strong></td>
                            <td>
                                <div>@tool.Name</div>
                                <small class="text-muted">@tool.SerialNumber</small>
                            </td>
                            <td>@Show(tool.BranchCode)</td>
                            <td>@Show(tool.LocationName)</td>
                            <td><span class="availability-shelf-pill">@Show(tool.ShelfLocation)</span></td>
                            <td>@Show(tool.ResponsiblePersonName)</td>
                            <td><span class="@GetStatusBadge(tool.OperationalStatus)">@GetStatusLabel(tool.OperationalStatus)</span></td>
                            <td class="text-end">
                                <button class="avail-action avail-action-primary" @onclick="() => SelectTool(tool)">
                                    Gestionar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</section>

</PermissionGuard>

