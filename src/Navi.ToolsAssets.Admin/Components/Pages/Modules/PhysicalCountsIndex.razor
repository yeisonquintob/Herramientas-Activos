@page "/physical-counts"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Navi.ToolsAssets.Admin.Components.Security
@using Navi.ToolsAssets.Admin.Components.Shared
@using Navi.ToolsAssets.Admin.Services.Auth
@inject IHttpClientFactory HttpClientFactory
@inject WebAuthSessionService AuthSession
@inject NavigationManager NavigationManager

<PageTitle>Tomas Físicas</PageTitle>

<PermissionGuard Permission="PhysicalCounts.View" ModuleName="Tomas Físicas">

<NaviPageHero
    Pill="CONTROL"
    Title="Tomas físicas"
    Description="Programa campañas, habilita inventario por sede y controla el avance por usuario desde escritorio y móvil.">

    <button type="button" @onclick="LoadAsync" data-ntx-tone="primary" >
        Actualizar
    </button>

</NaviPageHero>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<section class="tf-layout">
    @if (CanCreatePhysicalCount)
    {
        <article class="tf-form-card">
                <h3>Programar toma física</h3>
                <p>Crea una campaña por sede. Luego, en el detalle, generas participantes y activas la toma.</p>

                <div class="form-grid">
                    <div class="form-group">
                        <label>Sede</label>
                        <select class="form-select" @bind="newCount.BranchCode">
                            <option value="">Seleccione...</option>
                            @foreach (var branch in branches)
                            {
                                <option value="@branch.Code">@branch.Code - @branch.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Responsable / creador</label>
                        <input class="form-control" @bind="newCount.ResponsibleBy" />
                    </div>

                    <div class="form-group full">
                        <label>Notas / alcance</label>
                        <textarea class="form-control" rows="3" @bind="newCount.Notes"></textarea>
                    </div>
                </div>

                <button class="btn btn-success w-100 mt-2" @onclick="CreateAsync" data-ntx-tone="primary" >
                    Crear toma física
                </button>
            </article>
    }
    else
    {
        <article class="tf-form-card">
            <h3>Programar toma física</h3>
            <p>Tu rol no tiene permiso para crear campañas. Solo puedes consultar tus tomas y tus pendientes.</p>
            <div class="tf-empty">Permiso requerido para crear: PhysicalCounts.Create</div>
        </article>
    }

    <article class="tf-list-card">
        <div class="tf-card-title">
            <div>
                <h3>Campañas registradas</h3>
                <p>Ingresa a cada toma para ver usuarios, avance, pendientes y conciliación.</p>
            </div>

            <input class="form-control tf-search"
                   placeholder="Buscar toma, sede, responsable..."
                   @bind="searchText"
                   @bind:event="oninput" />
        </div>

        @if (isLoading)
        {
            <div class="tf-empty">Cargando tomas físicas...</div>
        }
        else if (!FilteredCounts.Any())
        {
            <div class="tf-empty">No hay tomas físicas registradas.</div>
        }
        else
        {
            <div class="tf-table-wrapper">
                <table class="tf-table">
                    <thead>
                        <tr>
                            <th>Toma</th>
                            <th>Sede</th>
                            <th>Estado</th>
                            <th>Fecha inicio</th>
                            <th>Fecha cierre</th>
                            <th>Responsable</th>
                            <th>Herramientas</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredCounts)
                        {
                            <tr>
                                <td>
                                    <strong>@item.CountNumber</strong>
                                    <small>@item.Notes</small>
                                </td>

                                <td>
                                    <strong>@item.BranchCode</strong>
                                    <small>@item.BranchName</small>
                                </td>

                                <td>
                                    <span class="@GetStatusClass(item.Status)">
                                        @item.StatusLabel
                                    </span>
                                </td>

                                <td>@FormatDate(item.StartedAt)</td>
                                <td>@FormatDate(item.FinishedAt)</td>
                                <td>@item.ResponsibleBy</td>

                                <td>
                                    <small>Total: @item.TotalItems</small>
                                    <small>Encontradas: @item.FoundItems</small>
                                    <small>Faltantes: @item.MissingItems</small>
                                </td>

                                <td>
                                    <div class="row-actions">
                                        <a class="tf-action tf-action-primary" href="@($"/physical-counts/{item.Id}")" data-ntx-tone="primary" >
                                            Detalle
                                        </a>

                                        <button class="tf-action tf-action-success" disabled="@(!CanStartPhysicalCount)" @onclick="() => StartAsync(item.Id)" data-ntx-tone="positive" >
                                            Iniciar
                                        </button>

                                        <button class="tf-action tf-action-neutral" disabled="@(!CanClosePhysicalCount)" @onclick="() => CompleteAsync(item.Id)" data-ntx-tone="positive" >
                                            Cerrar
                                        </button>

                                        <button class="tf-action tf-action-danger" disabled="@(!CanCancelPhysicalCount)" @onclick="() => CancelAsync(item.Id)" data-ntx-tone="secondary" >
                                            Cancelar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </article>
</section>

</PermissionGuard>



@code {

    private bool IsAdmin =>
        string.Equals(AuthSession.RoleCode, "ADMIN", StringComparison.OrdinalIgnoreCase)
        || string.Equals(AuthSession.RoleCode, "SUPERADMIN", StringComparison.OrdinalIgnoreCase)
        || string.Equals(AuthSession.RoleName, "Administrador", StringComparison.OrdinalIgnoreCase)
        || string.Equals(AuthSession.RoleName, "Administrador NAVI", StringComparison.OrdinalIgnoreCase);

    private bool CanCreatePhysicalCount => HasPermission("PhysicalCounts.Create");
    private bool CanStartPhysicalCount => HasPermission("PhysicalCounts.Start");
    private bool CanClosePhysicalCount => HasPermission("PhysicalCounts.Close");
    private bool CanCancelPhysicalCount => HasPermission("PhysicalCounts.Cancel");
    private bool CanReportPhysicalCount => HasPermission("PhysicalCounts.Report");

    private bool CanSeeAllPhysicalCounts => IsAdmin || CanCreatePhysicalCount;

    private bool HasPermission(string permission)
    {
        return AuthSession.Permissions?.Contains(permission, StringComparer.OrdinalIgnoreCase) == true
            || string.Equals(AuthSession.RoleCode, "ADMIN", StringComparison.OrdinalIgnoreCase)
            || string.Equals(AuthSession.RoleCode, "SUPERADMIN", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsOwnPhysicalCount(PhysicalCountItem item)
    {
        if (CanSeeAllPhysicalCounts)
        {
            return true;
        }

        var userName = AuthSession.UserName ?? string.Empty;
        var displayName = AuthSession.DisplayName ?? AuthSession.UserName ?? string.Empty;

        return SameUser(item.ResponsibleBy, userName)
            || SameUser(item.ResponsibleBy, displayName)
            || ContainsUser(item.Notes, userName)
            || ContainsUser(item.Notes, displayName);
    }

    private static bool SameUser(string? left, string? right)
    {
        return !string.IsNullOrWhiteSpace(left)
            && !string.IsNullOrWhiteSpace(right)
            && left.Trim().Equals(right.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private static bool ContainsUser(string? text, string? user)
    {
        return !string.IsNullOrWhiteSpace(text)
            && !string.IsNullOrWhiteSpace(user)
            && text.Contains(user.Trim(), StringComparison.OrdinalIgnoreCase);
    }


    private List<PhysicalCountItem> counts = new();
    private List<BranchOption> branches = new();
    private CreatePhysicalCountRequest newCount = new();
    private bool isLoading;
    private string searchText = string.Empty;
    private string? successMessage;
    private string? errorMessage;

    private IEnumerable<PhysicalCountItem> FilteredCounts =>
        counts.Where(x => string.IsNullOrWhiteSpace(searchText) ||
                        Contains(x.CountNumber, searchText) ||
                        Contains(x.BranchCode, searchText) ||
                        Contains(x.BranchName, searchText) ||
                        Contains(x.ResponsibleBy, searchText));

    protected override async Task OnInitializedAsync()
    {
        newCount.ResponsibleBy = string.IsNullOrWhiteSpace(AuthSession.UserName) ? "admin" : AuthSession.UserName;
        await LoadBranchesAsync();
        await LoadAsync();
    }

    private HttpClient CreateApiClient()
    {
        var api = HttpClientFactory.CreateClient("NaviApi");

        api.DefaultRequestHeaders.Remove("X-Navi-User");
        api.DefaultRequestHeaders.Remove("X-Navi-Role");
        api.DefaultRequestHeaders.Remove("X-Navi-Role-Code");
        api.DefaultRequestHeaders.Remove("X-Navi-Permissions");

        api.DefaultRequestHeaders.Add("X-Navi-User", string.IsNullOrWhiteSpace(AuthSession.UserName) ? "admin" : AuthSession.UserName);
        api.DefaultRequestHeaders.Add("X-Navi-Role", string.IsNullOrWhiteSpace(AuthSession.RoleName) ? "Administrador" : AuthSession.RoleName);
        api.DefaultRequestHeaders.Add("X-Navi-Role-Code", string.IsNullOrWhiteSpace(AuthSession.RoleCode) ? "ADMIN" : AuthSession.RoleCode);
        api.DefaultRequestHeaders.Add("X-Navi-Permissions", string.Join(";", AuthSession.Permissions ?? new List<string>()));

        return api;
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            var api = CreateApiClient();
            branches = await api.GetFromJsonAsync<List<BranchOption>>("api/settings/branches") ?? new();
        }
        catch
        {
            branches = new();
        }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var api = CreateApiClient();
            counts = await api.GetFromJsonAsync<List<PhysicalCountItem>>("api/physical-counts") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudieron cargar las tomas físicas: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
private async Task CreateAsync()
    {
        successMessage = null;
        errorMessage = null;

        if (!CanCreatePhysicalCount)
        {
            errorMessage = "No tienes permiso para crear tomas físicas.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newCount.BranchCode))
        {
            errorMessage = "Seleccione una sede.";
            return;
        }

        try
        {
            var api = CreateApiClient();
            var response = await api.PostAsJsonAsync("api/physical-counts", newCount);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            successMessage = "Toma física creada correctamente.";
            newCount = new CreatePhysicalCountRequest
            {
                ResponsibleBy = string.IsNullOrWhiteSpace(AuthSession.UserName) ? "admin" : AuthSession.UserName
            };

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
private async Task StartAsync(Guid id)
    {
        if (!CanStartPhysicalCount)
        {
            errorMessage = "No tienes permiso para iniciar tomas físicas.";
            return;
        }

        await PatchAsync($"api/physical-counts/{id}/start", "Toma física iniciada.");
    }
private async Task CompleteAsync(Guid id)
    {
        if (!CanClosePhysicalCount)
        {
            errorMessage = "No tienes permiso para cerrar tomas físicas.";
            return;
        }

        await PatchAsync($"api/physical-counts/{id}/complete", "Toma física cerrada.");
    }
private async Task CancelAsync(Guid id)
    {
        if (!CanCancelPhysicalCount)
        {
            errorMessage = "No tienes permiso para cancelar tomas físicas.";
            return;
        }

        await PatchAsync($"api/physical-counts/{id}/cancel", "Toma física cancelada.");
    }



    private async Task PatchAsync(string endpoint, string success)
    {
        successMessage = null;
        errorMessage = null;

        try
        {
            var api = CreateApiClient();
            var response = await api.PatchAsJsonAsync(endpoint, new
            {
                ActionBy = AuthSession.UserName ?? "admin",
                Notes = success
            });

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            successMessage = success;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private static bool Contains(string? value, string search) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase);

    private static string FormatDate(DateTime? value) =>
        value.HasValue ? value.Value.ToString("dd/MM/yyyy HH:mm") : "—";

    private static string GetStatusClass(string status) => status switch
    {
        "Draft" => "tf-status draft",
        "InProgress" => "tf-status progress",
        "Completed" => "tf-status completed",
        "Reconciled" => "tf-status completed",
        "Cancelled" => "tf-status cancelled",
        _ => "tf-status draft"
    };

    private sealed class PhysicalCountItem
    {
        public Guid Id { get; set; }
        public string CountNumber { get; set; } = string.Empty;
        public Guid BranchId { get; set; }
        public string? BranchCode { get; set; }
        public string? BranchName { get; set; }
        public string Status { get; set; } = string.Empty;
        public string StatusLabel { get; set; } = string.Empty;
        public DateTime StartedAt { get; set; }
        public DateTime? FinishedAt { get; set; }
        public string? ResponsibleBy { get; set; }
        public string? Notes { get; set; }
        public int TotalItems { get; set; }
        public int FoundItems { get; set; }
        public int MissingItems { get; set; }
    }

    private sealed class BranchOption
    {
        public Guid Id { get; set; }
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
    }

    private sealed class CreatePhysicalCountRequest
    {
        public string? BranchCode { get; set; }
        public string? ResponsibleBy { get; set; }
        public string? Notes { get; set; }
    }
}
