    private async Task LoadBranchesAsync()
    {
        try
        {
            var api =
                CreateApiClient();

            using var timeout =
                new CancellationTokenSource(
                    TimeSpan.FromSeconds(5));

            var loadedBranches =
                await api.GetFromJsonAsync<List<BranchOption>>(
                    "api/organization/branches",
                    timeout.Token)
                ?? new();

            /*
             * Solo se sustituye la lista cuando la consulta
             * finaliza correctamente.
             */
            branches = loadedBranches;
        }
        catch
        {
            /*
             * Se conserva la sede predeterminada y cualquier
             * información previamente cargada.
             */
        }
    }

    private Task LoadAsync()
    {
        /*
         * Cuando ya existe información, Actualizar no oculta
         * ni reemplaza la lista por el mensaje de carga.
         */
        var showBlockingLoader =
            registeredItems.Count == 0;

        return LoadGeneratedRequestsAsync(
            showBlockingLoader);
    }

    private async Task LoadGeneratedRequestsAsync(
        bool showBlockingLoader)
    {
        /*
         * Evita múltiples llamadas simultáneas cuando se
         * presiona varias veces el botón Actualizar.
         */
        if (generatedRequestsLoading)
        {
            return;
        }

        generatedRequestsLoading = true;

        var mustShowLoader =
            showBlockingLoader &&
            registeredItems.Count == 0;

        if (mustShowLoader)
        {
            isLoading = true;
        }

        errorMessage = null;

        try
        {
            var api =
                CreateApiClient();

            using var timeout =
                new CancellationTokenSource(
                    TimeSpan.FromSeconds(8));

            if (IsPurchase)
            {
                var data =
                    await api.GetFromJsonAsync<
                        List<PurchaseRequestItem>>(
                        "api/purchase-requests",
                        timeout.Token)
                    ?? new();

                registeredItems =
                    data.Select(
                        item =>
                            new ApiRegisteredItem
                            {
                                Id =
                                    item.Id,

                                RequestNumber =
                                    item.RequestNumber,

                                Title =
                                    item.ItemName,

                                Type =
                                    "Compra",

                                Priority =
                                    item.Priority,

                                Status =
                                    item.Status,

                                CreatedAt =
                                    item.CreatedAt
                            })
                        .ToList();
            }
            else
            {
                var data =
                    await api.GetFromJsonAsync<
                        List<MaintenanceRequestItem>>(
                        "api/maintenance-requests",
                        timeout.Token)
                    ?? new();

                registeredItems =
                    data.Select(
                        item =>
                            new ApiRegisteredItem
                            {
                                Id =
                                    item.Id,

                                RequestNumber =
                                    item.RequestNumber,

                                Title =
                                    item.Title,

                                Type =
                                    item.RequestType,

                                Priority =
                                    item.Priority,

                                Status =
                                    item.Status,

                                CreatedAt =
                                    item.CreatedAt
                            })
                        .ToList();
            }
        }
        catch (OperationCanceledException)
        {
            /*
             * La lista anterior permanece visible si la API
             * tarda más de lo permitido.
             */
            if (registeredItems.Count == 0)
            {
                errorMessage =
                    "La consulta está tardando más de lo esperado. " +
                    "Puedes continuar usando el formulario y volver " +
                    "a actualizar la lista.";
            }
        }
        catch (Exception ex)
        {
            /*
             * Si había información, se conserva en pantalla.
             */
            if (registeredItems.Count == 0)
            {
                errorMessage =
                    $"No se pudieron cargar las solicitudes " +
                    $"generadas: {ex.Message}";
            }
        }
        finally
        {
            isLoading = false;
            generatedRequestsLoading = false;

            await InvokeAsync(
                StateHasChanged);
        }
    }

    private HttpClient CreateApiClient()
    {
        return HttpClientFactory.CreateClient("NaviApi");
    }

    private async Task LoadLocalStateAsync()
    {
        string? readToken = null;

        try
        {
            /*
             * El navegador depura primero el JSON y retorna
             * únicamente información pequeña de preparación.
             */
            var preparation =
                await JS.InvokeAsync<StorageReadPreparation>(
                    "naviSpcStorage.prepareRead",
                    StorageKey,
                    LocalStorageChunkSize);

            readToken =
                preparation.Token;

            if (preparation.Reset)
            {
                storedRequests = new();

                if (
                    !string.IsNullOrWhiteSpace(
                        preparation.Message)
                )
                {
                    errorMessage =
                        preparation.Message;
                }

                return;
            }

            if (
                preparation.ChunkCount <= 0
                ||
                string.IsNullOrWhiteSpace(
                    readToken)
            )
            {
                storedRequests = new();

                return;
            }

            var expectedLength =
                preparation.FinalLength > 0
                    ? preparation.FinalLength
                    : LocalStorageChunkSize;

            var jsonBuilder =
                new StringBuilder(
                    expectedLength);

            /*
             * Cada fragmento tiene aproximadamente 12 KB.
             * Nunca se retorna todo el almacenamiento en una
             * sola llamada de JavaScript hacia Blazor.
             */
            for (
                var index = 0;
                index < preparation.ChunkCount;
                index++)
            {
                var chunk =
                    await JS.InvokeAsync<string>(
                        "naviSpcStorage.readChunk",
                        readToken,
                        index,
                        LocalStorageChunkSize);

                jsonBuilder.Append(
                    chunk);
            }

            var json =
                jsonBuilder.ToString();

            if (
                string.IsNullOrWhiteSpace(
                    json)
            )
            {
                storedRequests = new();

                return;
            }

            storedRequests =
                JsonSerializer.Deserialize<
                    List<StoredRequest>>(
                        json,
                        jsonOptions)
                ?? new();

            await RehydrateStoredEvidencePreviewsAsync();
        }
        catch (Exception ex)
        {
            /*
             * Un problema local no debe cerrar el circuito ni
             * impedir que la pantalla continúe funcionando.
             */
            storedRequests = new();

            errorMessage =
                "No fue posible recuperar los borradores " +
                $"locales: {ex.Message}";
        }
        finally
        {
            if (
                !string.IsNullOrWhiteSpace(
                    readToken)
            )
            {
                try
                {
                    await JS.InvokeVoidAsync(
                        "naviSpcStorage.releaseRead",
                        readToken);
                }
                catch
                {
                    /*
                     * El buffer también expira al recargar
                     * la página. No es necesario propagarlo.
                     */
                }
            }
        }
    }

    private async Task SaveLocalStateAsync()
    {
        /*
         * ImagePreview se conserva en memoria mientras la
         * pantalla está abierta, pero no se almacena como
         * Base64 dentro del navegador.
         */
        var json =
            SerializeLocalStateWithoutImagePreviews();

        var result =
            await JS.InvokeAsync<StorageWriteResult>(
                "naviSpcStorage.write",
                StorageKey,
                json);

        if (!result.Saved)
        {
            throw new InvalidOperationException(
                string.IsNullOrWhiteSpace(
                    result.Message)
                    ? "No fue posible guardar el borrador local."
                    : result.Message);
        }
    }

    private string SerializeLocalStateWithoutImagePreviews()
    {
        var root =
            JsonSerializer.SerializeToNode(
                storedRequests,
                jsonOptions);

        RemoveImagePreviewNodes(
            root);

        return root?.ToJsonString(
            jsonOptions)
            ?? "[]";
    }

    private static void RemoveImagePreviewNodes(
        JsonNode? node)
    {
        switch (node)
        {
            case JsonObject jsonObject:
            {
                var hasPersistentEvidence =
                    jsonObject.Any(property =>
                        property.Key.Equals(
                            "evidenceId",
                            StringComparison.OrdinalIgnoreCase) &&
                        property.Value is JsonValue value &&
                        value.TryGetValue<string>(out var evidenceId) &&
                        !string.IsNullOrWhiteSpace(evidenceId));

                foreach (
                    var property
                    in jsonObject.ToList())
                {
                    var isImagePreview =
                        property.Key.Equals(
                            "imagePreview",
                            StringComparison.OrdinalIgnoreCase);

                    var isPersistentEvidencePreview =
                        hasPersistentEvidence &&
                        property.Key.Equals(
                            "evidencePreview",
                            StringComparison.OrdinalIgnoreCase);

                    if (isImagePreview || isPersistentEvidencePreview)
                    {
                        if (property.Value is JsonValue previewNode &&
                            previewNode.TryGetValue<string>(out var previewValue) &&
                            previewValue.StartsWith(
                                "data:image/",
                                StringComparison.OrdinalIgnoreCase))
                        {
                            jsonObject[property.Key] =
                                string.Empty;
                        }

                        continue;
                    }

                    RemoveImagePreviewNodes(
                        property.Value);
                }

                break;
            }

            case JsonArray jsonArray:
            {
                foreach (
                    var item
                    in jsonArray)
                {
                    RemoveImagePreviewNodes(
                        item);
                }

                break;
            }
        }
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;

        var file = e.File;

        if (file is null)
        {
            return;
        }

        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Solo se permiten archivos de imagen.";
            return;
        }

        const long maxFileSize = 2 * 1024 * 1024;

        if (file.Size > maxFileSize)
        {
            errorMessage = "La imagen no puede superar 2 MB.";
            return;
        }

        await using var stream = file.OpenReadStream(maxFileSize);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);

        lineForm.EvidenceId = null;
        lineForm.EvidencePendingUpload = true;
        lineForm.EvidenceContentType = file.ContentType;
        lineForm.ImageReference = file.Name;
        lineForm.ImagePreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";
    }

    private async Task AddLine()
    {

        if (!CanCreateOrConfirmRequest)
        {
            return;
        }

        errorMessage = null;

        if (!CanEditRequest)
        {
            errorMessage = "Solo puedes modificar herramientas cuando la solicitud está nueva o en borrador.";
            return;
        }

        if (string.IsNullOrWhiteSpace(lineForm.ToolName))
        {
            errorMessage = "Debes indicar el nombre de la herramienta o equipo.";
            return;
        }

        var lineId = editingLineId ?? Guid.NewGuid();
        var evidenceId = lineForm.EvidenceId;
        var imageReference = lineForm.ImageReference?.Trim();
        var imagePreview = lineForm.ImagePreview;
        var evidenceContentType = lineForm.EvidenceContentType;

        if (IsPurchase &&
            lineForm.EvidencePendingUpload &&
            IsDataImage(imagePreview))
        {
            activeStoredRequestId ??= Guid.NewGuid();

            var uploaded = await UploadWorkspaceEvidenceAsync(
                activeStoredRequestId.Value,
                lineId,
                "ToolImage",
                lineForm.ToolName.Trim(),
                imageReference,
                evidenceContentType,
                imagePreview);

            if (uploaded is null)
            {
                return;
            }

            evidenceId = uploaded.Id;
            imageReference = uploaded.FileName;
            evidenceContentType = uploaded.ContentType;
        }

        if (editingLineId.HasValue)
        {
            var existing = currentLines.FirstOrDefault(x => x.Id == editingLineId.Value);

            if (existing is not null)
            {
                existing.EvidenceId = evidenceId;
                existing.EvidenceContentType = evidenceContentType;
                existing.ImageReference = imageReference;
                existing.ImagePreview = imagePreview;
                existing.TechnicalOrSerial = lineForm.TechnicalOrSerial?.Trim();
                existing.ToolName = lineForm.ToolName.Trim();
                existing.Quantity = lineForm.Quantity <= 0 ? 1 : lineForm.Quantity;
                existing.Criticality = string.IsNullOrWhiteSpace(lineForm.Criticality) ? "Normal" : lineForm.Criticality;
                existing.Details = lineForm.Details?.Trim();
                existing.Novelty = lineForm.Novelty?.Trim();
            }
        }
        else
        {
            currentLines.Add(new RequestLineItem
            {
                Id = lineId,
                Selected = true,
                EvidenceId = evidenceId,
                EvidenceContentType = evidenceContentType,
                ImageReference = imageReference,
                ImagePreview = imagePreview,
                TechnicalOrSerial = lineForm.TechnicalOrSerial?.Trim(),
                ToolName = lineForm.ToolName.Trim(),
                Quantity = lineForm.Quantity <= 0 ? 1 : lineForm.Quantity,
                Criticality = string.IsNullOrWhiteSpace(lineForm.Criticality) ? "Normal" : lineForm.Criticality,
                Details = lineForm.Details?.Trim(),
                Novelty = lineForm.Novelty?.Trim()
            });
        }

        ClearLine();
    }

    private void EditLine(Guid id)
    {
        if (!CanEditRequest)
        {
            errorMessage = "La solicitud confirmada no permite editar encabezado ni herramientas.";
            return;
        }

        var item = currentLines.FirstOrDefault(x => x.Id == id);

        if (item is null)
        {
            return;
        }

        editingLineId = item.Id;
        lineForm.EvidenceId = item.EvidenceId;
        lineForm.EvidencePendingUpload =
            !item.EvidenceId.HasValue &&
            IsDataImage(item.ImagePreview);
        lineForm.EvidenceContentType = item.EvidenceContentType;
        lineForm.ImageReference = item.ImageReference;
        lineForm.ImagePreview = item.ImagePreview;
        lineForm.TechnicalOrSerial = item.TechnicalOrSerial;
        lineForm.ToolName = item.ToolName;
        lineForm.Quantity = item.Quantity;
        lineForm.Criticality = item.Criticality;
        lineForm.Details = item.Details;
        lineForm.Novelty = item.Novelty;
    }

    private void RemoveLine(Guid id)
    {
        if (!CanEditRequest)
        {
            return;
        }

        currentLines.RemoveAll(x => x.Id == id);
        currentQuotes.RemoveAll(x => x.LineId == id);
    }

    private void ClearLine()
    {
        editingLineId = null;
        lineForm.EvidenceId = null;
        lineForm.EvidencePendingUpload = false;
        lineForm.EvidenceContentType = null;
        lineForm.ImageReference = string.Empty;
        lineForm.ImagePreview = string.Empty;
        lineForm.TechnicalOrSerial = string.Empty;
        lineForm.ToolName = string.Empty;
        lineForm.Quantity = 1;
