    private static bool Contains(
        string? source,
        string value)
    {
        return
            !string.IsNullOrWhiteSpace(source)
            &&
            source.Contains(
                value,
                StringComparison.OrdinalIgnoreCase);
    }

    private static bool StatusIs(
        ToolListItem tool,
        string status)
    {
        return string.Equals(
            tool.OperationalStatus,
            status,
            StringComparison.OrdinalIgnoreCase);
    }

    private int GetInUseCount()
    {
        return InventorySummaryTools.Count(
