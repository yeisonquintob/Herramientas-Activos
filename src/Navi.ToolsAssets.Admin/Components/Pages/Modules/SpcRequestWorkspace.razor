    private bool QuoteBelongsToComparisonLine(
        QuotationItem quotation,
        Guid lineId)
    {
        if (quotation.LineId.HasValue)
        {
            return quotation.LineId.Value == lineId;
        }

        return currentLines.Count == 1;
    }


    private Guid? ResolveComparisonLineId(
        QuotationItem quotation)
    {
        if (
            quotation.LineId.HasValue
            &&
            currentLines.Any(
                item =>
                    item.Id
                    ==
                    quotation.LineId.Value)
        )
        {
            return quotation.LineId.Value;
        }

        if (currentLines.Count == 1)
        {
            return currentLines[0].Id;
        }

        return null;
    }


    private int GetComparisonProposalCount(
        Guid lineId)
    {
        return currentQuotes.Count(
            item =>
                QuoteBelongsToComparisonLine(
                    item,
                    lineId));
    }


    private bool HasComparisonSelection(
        Guid lineId)
    {
        if (
            !comparisonSelectionsByLine.TryGetValue(
                lineId,
                out var quotationId)
        )
        {
            return false;
        }

        return currentQuotes.Any(
            item =>
                item.Id
                ==
                quotationId
                &&
                QuoteBelongsToComparisonLine(
                    item,
                    lineId));
    }


    private void OpenQuotationComparison()
    {
        errorMessage = null;

        if (!currentQuotes.Any())
        {
            errorMessage =
                "Agrega al menos una cotización para comparar.";

            return;
        }

        if (!currentLines.Any())
        {
            errorMessage =
                "La solicitud no tiene herramientas asociadas.";

            return;
        }

        comparisonSelectionsByLine.Clear();

        /*
         * Recupera las cotizaciones que ya estaban guardadas
         * y las organiza por la herramienta correspondiente.
         */
        foreach (
            var selectedQuote
            in currentQuotes.Where(
                item => item.Selected))
        {
            var resolvedLineId =
                ResolveComparisonLineId(
                    selectedQuote);

            if (!resolvedLineId.HasValue)
            {
                continue;
            }

            comparisonSelectionsByLine[
                resolvedLineId.Value
            ] = selectedQuote.Id;
        }

        var initialLine =
            currentLines.FirstOrDefault(
                item =>
                    comparisonSelectionsByLine.ContainsKey(
                        item.Id));

        initialLine ??=
            currentLines.FirstOrDefault(
                item =>
                    GetComparisonProposalCount(
                        item.Id)
                    >
                    0);

        initialLine ??=
            currentLines.FirstOrDefault();

        if (initialLine is null)
        {
            errorMessage =
                "No fue posible identificar una herramienta "
                + "para comparar.";

            return;
        }

        comparisonLineId =
            initialLine.Id;

        showQuotationComparison = true;
    }


    private void SelectComparisonLine(
        Guid lineId)
    {
        var lineExists =
            currentLines.Any(
                item =>
                    item.Id
                    ==
                    lineId);

        if (!lineExists)
        {
            errorMessage =
                "No se encontró la herramienta seleccionada.";

            return;
        }

        errorMessage = null;

        /*
         * Cambia únicamente la herramienta visible.
         * No borra las selecciones de las otras herramientas.
         */
        comparisonLineId =
            lineId;
    }


    // NAVI QUOTATION TOGGLE SELECTION V127.3
    private void ToggleQuotationSelection(
        Guid quotationId)
    {
        if (!CanQuote)
        {
            return;
        }

        if (!comparisonLineId.HasValue)
        {
            errorMessage =
                "Selecciona primero una herramienta.";

            return;
        }

        var activeLineId =
            comparisonLineId.Value;

        var quotationExists =
            currentQuotes.Any(
                item =>
                    item.Id
                    ==
                    quotationId
                    &&
                    QuoteBelongsToComparisonLine(
                        item,
                        activeLineId));

        if (!quotationExists)
        {
            errorMessage =
                "La cotización no pertenece a la "
                + "herramienta seleccionada.";

            return;
        }

        errorMessage = null;

        /*
         * Si la cotización ya estaba marcada para esta
         * herramienta, un segundo clic la deselecciona.
         */
        if (
            comparisonSelectionsByLine.TryGetValue(
                activeLineId,
                out var currentQuotationId)
            &&
            currentQuotationId
            ==
            quotationId
        )
        {
            comparisonSelectionsByLine.Remove(
                activeLineId);

            return;
        }

        /*
         * Si se selecciona una cotización diferente,
         * reemplaza únicamente la elección de la herramienta
         * activa. Las demás herramientas no se modifican.
         */
        comparisonSelectionsByLine[
            activeLineId
        ] = quotationId;
    }


    private void CloseQuotationComparison()
    {
        showQuotationComparison = false;
        comparisonLineId = null;

        /*
         * Cancelar descarta las selecciones provisionales.
         * Las selecciones ya persistidas permanecen intactas.
         */
        comparisonSelectionsByLine.Clear();
    }


    private async Task AcceptQuotationComparisonAsync()
    {
        if (!CanQuote)
        {
            return;
        }

        errorMessage = null;
        successMessage = null;

        if (!comparisonSelectionsByLine.Any())
        {
            errorMessage =
                "Selecciona al menos una cotización "
                + "antes de aceptar.";

            return;
        }

        var selectedQuoteIds =
            new HashSet<Guid>();

        foreach (
            var selection
            in comparisonSelectionsByLine)
        {
            var lineId =
                selection.Key;

            var quotationId =
                selection.Value;

            var lineExists =
                currentLines.Any(
                    item =>
                        item.Id
                        ==
                        lineId);

            if (!lineExists)
            {
                errorMessage =
                    "Una de las herramientas seleccionadas "
                    + "ya no está disponible.";

                return;
            }

            var selectedQuote =
                currentQuotes.FirstOrDefault(
                    item =>
                        item.Id
                        ==
                        quotationId
                        &&
                        QuoteBelongsToComparisonLine(
                            item,
                            lineId));

            if (selectedQuote is null)
            {
                errorMessage =
                    "Una de las cotizaciones seleccionadas "
                    + "ya no está disponible.";

                return;
            }

            selectedQuoteIds.Add(
                selectedQuote.Id);
        }

        if (!selectedQuoteIds.Any())
        {
            errorMessage =
                "No se encontraron cotizaciones válidas "
                + "para guardar.";

            return;
        }

        /*
         * Marca todas las cotizaciones aceptadas:
         * máximo una por herramienta.
         * Todas las demás quedan sin check.
         */
        foreach (var quote in currentQuotes)
        {
            quote.Selected =
                selectedQuoteIds.Contains(
                    quote.Id);
        }

        await PersistActiveQuotationStateAsync();

        var selectedCount =
            selectedQuoteIds.Count;

        var selectedTotal =
            currentQuotes
                .Where(
                    item =>
                        selectedQuoteIds.Contains(
                            item.Id))
                .Sum(
                    item =>
                        item.PriceBeforeVat
                        ??
                        0);

        showQuotationComparison = false;
        comparisonLineId = null;
        comparisonSelectionsByLine.Clear();

        successMessage =
            selectedCount == 1
                ? $"1 cotización seleccionada por "
                  + $"{FormatMoney(selectedTotal)}."
                : $"{selectedCount} cotizaciones seleccionadas "
                  + $"por un total de "
                  + $"{FormatMoney(selectedTotal)}.";
    }


    private async Task OnQuotationEvidenceChangedAsync(
        Guid quotationId,
        InputFileChangeEventArgs args)
    {
        if (!CanQuote)
        {
            return;
        }

        errorMessage = null;
        successMessage = null;

        var quote = currentQuotes.FirstOrDefault(
            item => item.Id == quotationId);

        if (quote is null)
        {
            errorMessage =
                "No se encontró la cotización seleccionada.";

            return;
        }

        var prepared = await ReadImageAsDataUrlAsync(
            args.File,
            MaxQuotationEvidenceBytes);

        if (prepared is null)
        {
            return;
        }

        if (!IsPurchase)
        {
            quote.EvidenceFileName = prepared.FileName;
            quote.EvidenceContentType = prepared.ContentType;
            quote.EvidencePreview = prepared.DataUrl;

            await PersistActiveQuotationStateAsync();

            successMessage =
                $"Imagen adjuntada a la cotización de "
                + $"{quote.Provider}.";

            return;
        }

        if (!activeStoredRequestId.HasValue)
        {
            errorMessage =
                "No se encontró la solicitud local asociada a la cotización.";
            return;
        }

        var uploaded = await UploadWorkspaceEvidenceAsync(
            activeStoredRequestId.Value,
            quote.Id,
            "QuotationImage",
            quote.Provider,
            prepared.FileName,
            prepared.ContentType,
            prepared.DataUrl);

        if (uploaded is null)
        {
            return;
        }

        quote.EvidenceId = uploaded.Id;
        quote.EvidenceFileName = uploaded.FileName;
        quote.EvidenceContentType = uploaded.ContentType;
        quote.EvidencePreview = prepared.DataUrl;

        await PersistActiveQuotationStateAsync();

        successMessage =
            $"Imagen adjuntada a la cotización de "
            + $"{quote.Provider}.";
    }

