@page "/all-tools"
@page "/my-tools"

@inject NaviMobileApiClient Api
@inject MobileAuthSessionService Auth
@inject NavigationManager Navigation

<PageTitle>@PageTitle - NAVI Herramientas y AF</PageTitle>

<section class="mobile-page mobile-inv-page">
    @if (isLoading)
    {
        <div class="mobile-loading">Cargando activos...</div>
    }
    else if (!Auth.IsAuthenticated)
    {
        <div class="mobile-empty">
            <strong>Sesión requerida</strong>
            <span>Debes iniciar sesión para consultar el inventario móvil.</span>
            <button class="mobile-primary-button" type="button" @onclick="GoLogin" data-ntx-tone="secondary" >Ir al login</button>
        </div>
    }
    else if (!CanViewInventoryPage)
    {
        <div class="mobile-empty">
            <strong>Sin permiso</strong>
            <span>Tu usuario no tiene permiso para visualizar el inventario móvil.</span>
            <button class="mobile-primary-button" type="button" @onclick="GoHome" data-ntx-tone="secondary" >Volver al inicio</button>
        </div>
    }
    else
    {
        <NaviMobileAppBanner Class="navi-mobile-inventory-app-banner navi-mobile-app-banner--module"
                             Pill="@HeaderCode"
                             Title="@PageTitle"
                             Description="@PageSubtitle"
                             HomeUrl="/"
                             ShowHomeButton="true"
                             ShowBackButton="false" />

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="mobile-alert">@message</div>
        }
        <section class="mobile-inv-search-card mobile-inv-search-card-filters-v3">
            <div class="mobile-inv-counters">
                <div>
                    <strong>@filteredTools.Count</strong>
                    <span>Mostrados</span>
                </div>

                <div>
                    <strong>@allTools.Count</strong>
                    <span>Total cargados</span>
                </div>

                <div>
                    <strong>@availableCount</strong>
                    <span>Disponibles</span>
                </div>
            </div>

            <div class="mobile-inv-filter-grid mobile-inv-filter-grid-v3">
                <label>
                    <span>Sede</span>
                    <select value="@selectedBranchFilter"
                            @onchange="OnBranchFilterChanged"
                            disabled="@(!UserCanSeeAllBranches())">
                        @foreach (var option in BranchOptions)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                </label>

                <label>
                    <span>Estado</span>
                    <select value="@selectedStatusFilter"
                            @onchange="OnStatusFilterChanged">
                        @foreach (var option in StatusOptions)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                </label>
            </div>

            <input
                value="@searchTerm"
                @oninput="OnSearchChanged"
                placeholder="Buscar por código, nombre, ubicación, responsable o estado..." />
        </section>

        @if (!filteredTools.Any())
        {
            <section class="mobile-empty mobile-inv-empty">
                <strong>Sin activos</strong>
                <span>No se encontraron herramientas con el filtro aplicado.</span>
            </section>
        }
        else
        {
            <section class="mobile-inv-list">
                @foreach (var tool in filteredTools)
                {
                    <article class="mobile-inv-card">
                        <div class="mobile-inv-card-main">
                            <div>
                                <span class="mobile-inv-code">@Display(tool.InternalCode)</span>
                                <strong>@Display(tool.Name)</strong>
                            </div>

                            <span class="@GetStatusClass(tool.OperationalStatus)">
                                @Display(tool.OperationalStatus)
                            </span>
                        </div>

                        <div class="mobile-inv-meta">
                            <div>
                                <span>Sede</span>
                                <strong>@DisplayBranch(tool)</strong>
                            </div>

                            <div>
                                <span>Ubicación</span>
                                <strong>@Display(tool.LocationName)</strong>
                            </div>

                            <div>
                                <span>Responsable</span>
                                <strong>@Display(tool.ResponsiblePersonName)</strong>
                            </div>

                            <div>
                                <span>Estado físico</span>
                                <strong>@Display(tool.PhysicalStatus)</strong>
                            </div>
                        </div>

                        <div class="mobile-inv-actions">
                            @if (CanViewToolDetail)
                            {
                                <a href="@GetDetailUrl(tool.Id)">Ver detalle</a>
                            }

                            @if (CanViewLifeRecord)
                            {
                                <a href="@GetLifeRecordUrl(tool.Id)">Hoja de vida</a>
                            }

                            @if (CanReportDamage)
                            {
                                <a class="danger" href="@GetReportUrl(tool.Id)">Reportar</a>
                            }
                        </div>
                    </article>
                }
            </section>
        }
    }
</section>

@code {
    private bool isLoading = true;

    private bool CanViewInventoryPage => IsMyToolsPage || Auth.HasPermission("Tools.View");
    private string? message;
    private string searchTerm = string.Empty;
    private string selectedBranchFilter = string.Empty;
    private string selectedStatusFilter = string.Empty;

    private List<MobileToolDto> allTools = new();
    private List<MobileToolDto> filteredTools = new();

    private bool IsMyToolsPage =>
        new Uri(Navigation.Uri).AbsolutePath.Equals("/my-tools", StringComparison.OrdinalIgnoreCase);

    private string PageTitle => IsMyToolsPage ? "Mis activos asignados" : "Inventario AF, herramientas y AF";

    private string HeaderCode => IsMyToolsPage ? "ACTIVOS FIJOS · MIS ACTIVOS" : "ACTIVOS FIJOS · INVENTARIO AF";

    private string PageSubtitle => IsMyToolsPage
        ? "Consulta únicamente activos relacionados con tu usuario."
        : "Consulta activos según tu alcance: propios, sede o todas las sedes si eres administrador.";

    private int availableCount => filteredTools.Count(x => Contains(x.OperationalStatus, "Available") || Contains(x.OperationalStatus, "Disponible"));

    private bool CanViewToolDetail => HasAny("ToolDetail.View", "Tools.View", "Mobile.Tools.View");
    private bool CanViewLifeRecord => HasAny("TechnicalLifeRecord.View", "ToolDetail.LifeRecord.Open");
    private bool CanReportDamage => HasPermission("Mobile.Damage.Report");

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();

        if (!Auth.IsAuthenticated)
        {
            isLoading = false;
            return;
        }

        if (!CanViewInventoryPage)
        {
            isLoading = false;
            return;
        }

        await LoadAsync(false);
    }

    private async Task LoadAsync(bool forceRefresh)
    {
        try
        {
            message = null;

            var tools = await Api.GetToolsAsync(forceRefresh);

            allTools = IsMyToolsPage
                ? tools.Where(IsAssignedToCurrentUser).OrderBy(x => x.InternalCode).ThenBy(x => x.Name).ToList()
                : FilterInventoryScope(tools).ToList();

            EnsureValidFilters();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            allTools = new();
            filteredTools = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSearchChanged(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void OnBranchFilterChanged(ChangeEventArgs args)
    {
        selectedBranchFilter = args.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void OnStatusFilterChanged(ChangeEventArgs args)
    {
        selectedStatusFilter = args.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var query = Normalize(searchTerm);
        var branchFilter = selectedBranchFilter;
        var statusFilter = selectedStatusFilter;

        IEnumerable<MobileToolDto> queryable = allTools;

        if (!string.IsNullOrWhiteSpace(branchFilter))
        {
            queryable = queryable.Where(tool => SameNormalized(GetBranchFilterKey(tool), branchFilter));
        }

        if (!string.IsNullOrWhiteSpace(statusFilter))
        {
            queryable = queryable.Where(tool => SameNormalized(tool.OperationalStatus, statusFilter));
        }

        if (!string.IsNullOrWhiteSpace(query))
        {
            queryable = queryable.Where(tool =>
                ContainsNormalized(tool.InternalCode, query) ||
                ContainsNormalized(tool.Name, query) ||
                ContainsNormalized(tool.BranchCode, query) ||
                ContainsNormalized(tool.BranchName, query) ||
                ContainsNormalized(tool.LocationName, query) ||
                ContainsNormalized(tool.ResponsiblePersonName, query) ||
                ContainsNormalized(tool.OperationalStatus, query) ||
                ContainsNormalized(tool.PhysicalStatus, query));
        }

        filteredTools = queryable
            .OrderBy(x => x.InternalCode)
            .ThenBy(x => x.Name)
            .ToList();
    }

    private void EnsureValidFilters()
    {
        var branchOptions = BranchOptions;

        if (!UserCanSeeAllBranches() && branchOptions.Count > 0)
        {
            selectedBranchFilter = branchOptions[0].Value;
        }
        else if (!string.IsNullOrWhiteSpace(selectedBranchFilter) &&
                 !branchOptions.Any(option => SameNormalized(option.Value, selectedBranchFilter)))
        {
            selectedBranchFilter = string.Empty;
        }

        var statusOptions = StatusOptions;

        if (!string.IsNullOrWhiteSpace(selectedStatusFilter) &&
            !statusOptions.Any(option => SameNormalized(option.Value, selectedStatusFilter)))
        {
            selectedStatusFilter = string.Empty;
        }
    }

    private IReadOnlyList<FilterOption> BranchOptions
    {
        get
        {
            var options = new List<FilterOption>();
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            if (UserCanSeeAllBranches())
            {
                options.Add(new FilterOption(string.Empty, "Todas las sedes"));
            }

            foreach (var tool in allTools)
            {
                var value = GetBranchFilterKey(tool);

                if (string.IsNullOrWhiteSpace(value))
                {
                    continue;
                }

                var normalized = Normalize(value);

                if (seen.Add(normalized))
                {
                    options.Add(new FilterOption(value, GetBranchFilterLabel(tool)));
                }
            }

            if (!UserCanSeeAllBranches() && options.Count == 0)
            {
                var user = Auth.CurrentUser;
                var value = !string.IsNullOrWhiteSpace(user?.BranchCode)
                    ? user!.BranchCode!
                    : user?.BranchName ?? string.Empty;

                if (!string.IsNullOrWhiteSpace(value))
                {
                    options.Add(new FilterOption(value, Display(value)));
                }
            }

            return options;
        }
    }

    private IReadOnlyList<FilterOption> StatusOptions
    {
        get
        {
            var options = new List<FilterOption>
            {
                new(string.Empty, "Todos los estados")
            };

            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var status in allTools
                .Select(tool => tool.OperationalStatus)
                .Where(status => !string.IsNullOrWhiteSpace(status))
                .OrderBy(status => status))
            {
                var value = status ?? string.Empty;
                var normalized = Normalize(value);

                if (seen.Add(normalized))
                {
                    options.Add(new FilterOption(value, Display(value)));
                }
            }

            return options;
        }
    }

    private static string GetBranchFilterKey(MobileToolDto tool)
    {
        if (!string.IsNullOrWhiteSpace(tool.BranchCode))
        {
            return tool.BranchCode;
        }

        return tool.BranchName ?? string.Empty;
    }

    private static string GetBranchFilterLabel(MobileToolDto tool)
    {
        if (!string.IsNullOrWhiteSpace(tool.BranchCode) && !string.IsNullOrWhiteSpace(tool.BranchName))
        {
            return $"{tool.BranchCode} · {tool.BranchName}";
        }

        return Display(tool.BranchName ?? tool.BranchCode);
    }

    private IEnumerable<MobileToolDto> FilterInventoryScope(IEnumerable<MobileToolDto> source)
    {
        var user = Auth.CurrentUser;

        if (user is null || !HasAny("Tools.View", "Mobile.Tools.View"))
        {
            return Enumerable.Empty<MobileToolDto>();
        }

        if (UserCanSeeAllBranches())
        {
            return source
                .OrderBy(x => x.BranchCode)
                .ThenBy(x => x.InternalCode)
                .ThenBy(x => x.Name);
        }

        return source
            .Where(IsSameBranch)
            .OrderBy(x => x.InternalCode)
            .ThenBy(x => x.Name);
    }

    private bool IsAssignedToCurrentUser(MobileToolDto tool)
    {
        var user = Auth.CurrentUser;

        if (user is null)
        {
            return false;
        }

        if (user.ResponsiblePersonId.HasValue && tool.ResponsiblePersonId == user.ResponsiblePersonId.Value)
        {
            return true;
        }

        if (string.IsNullOrWhiteSpace(tool.ResponsiblePersonName))
        {
            return false;
        }

        return SameNormalized(tool.ResponsiblePersonName, user.ResponsiblePersonName)
            || SameNormalized(tool.ResponsiblePersonName, user.DisplayName)
            || SameNormalized(tool.ResponsiblePersonName, user.UserName);
    }

    private bool IsSameBranch(MobileToolDto tool)
    {
        var user = Auth.CurrentUser;

        if (user is null)
        {
            return false;
        }

        if (UserCanSeeAllBranches())
        {
            return true;
        }

        return SameNormalized(tool.BranchCode, user.BranchCode)
            || SameNormalized(tool.BranchName, user.BranchName)
            || SameNormalized(tool.BranchCode, user.BranchName)
            || SameNormalized(tool.BranchName, user.BranchCode);
    }

    private bool UserCanSeeAllBranches()
    {
        var user = Auth.CurrentUser;

        if (user is null)
        {
            return false;
        }

        return string.IsNullOrWhiteSpace(user.BranchCode)
            || SameNormalized(user.BranchCode, "TODAS")
            || SameNormalized(user.BranchCode, "ALL")
            || SameNormalized(user.BranchName, "Todas las sedes")
            || SameNormalized(user.BranchName, "TODAS")
            || SameNormalized(user.BranchName, "ALL");
    }

    private bool HasAny(params string[] permissions)
    {
        return permissions.Any(HasPermission);
    }

    private bool HasPermission(string permission)
    {
        return Auth.HasPermission(permission);
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }

    private void GoLogin()
    {
        Navigation.NavigateTo("/login", replace: true);
    }

    private string GetDetailUrl(Guid id)
    {
        if (IsMyToolsPage)
        {
            return "/tools/" + id;
        }

        return "/tools/" + id + "?returnUrl=" + Uri.EscapeDataString("/all-tools");
    }

    private string GetLifeRecordUrl(Guid id)
    {
        var returnUrl = IsMyToolsPage ? "/my-tools" : "/all-tools";
        return "/tools/" + id + "/life-record?returnUrl=" + Uri.EscapeDataString(returnUrl);
    }

    private static string GetReportUrl(Guid id)
    {
        return "/report-damage/" + id;
    }

    private static string DisplayBranch(MobileToolDto tool)
    {
        if (!string.IsNullOrWhiteSpace(tool.BranchCode) && !string.IsNullOrWhiteSpace(tool.BranchName))
        {
            return $"{tool.BranchCode} · {tool.BranchName}";
        }

        return Display(tool.BranchName ?? tool.BranchCode);
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Sin dato" : value;
    }

    private static bool Contains(string? value, string expected)
    {
        return !string.IsNullOrWhiteSpace(value) &&
               value.Contains(expected, StringComparison.OrdinalIgnoreCase);
    }

    private static bool ContainsNormalized(string? value, string normalizedQuery)
    {
        return Normalize(value).Contains(normalizedQuery, StringComparison.OrdinalIgnoreCase);
    }

    private static bool SameNormalized(string? left, string? right)
    {
        var a = Normalize(left);
        var b = Normalize(right);

        return !string.IsNullOrWhiteSpace(a)
            && !string.IsNullOrWhiteSpace(b)
            && string.Equals(a, b, StringComparison.OrdinalIgnoreCase);
    }

    private static string Normalize(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value
            .Trim()
            .ToUpperInvariant()
            .Replace("Á", "A")
            .Replace("É", "E")
            .Replace("Í", "I")
            .Replace("Ó", "O")
            .Replace("Ú", "U")
            .Replace("Ü", "U")
            .Replace("Ñ", "N");
    }

    private static string GetStatusClass(string? status)
    {
        if (Contains(status, "Available") || Contains(status, "Disponible"))
        {
            return "mobile-inv-status ok";
        }

        if (Contains(status, "Maintenance") || Contains(status, "Mantenimiento"))
        {
            return "mobile-inv-status warning";
        }

        if (Contains(status, "Damaged") || Contains(status, "No apt") || Contains(status, "Dañ"))
        {
            return "mobile-inv-status danger";
        }

        return "mobile-inv-status neutral";
    }

    private sealed record FilterOption(string Value, string Label);
}
