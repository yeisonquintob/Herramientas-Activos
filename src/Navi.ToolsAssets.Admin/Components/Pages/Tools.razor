    }

    private string
        GetStatusFilterChipClass(
            string? status)
    {
        var normalizedStatus =
            status ?? string.Empty;

        var isActive =
            string.Equals(
                selectedStatus,
                normalizedStatus,
                StringComparison.OrdinalIgnoreCase);

        var classes =
            string.IsNullOrWhiteSpace(
                normalizedStatus)
                ? "navi-inventory-v23-status-chip is-all"
                : "navi-inventory-v23-status-chip "
                  + NaviStatusLabels.BadgeClass(
                      normalizedStatus);

        if (isActive)
        {
            classes += " is-active";
        }

        return classes;
    }

