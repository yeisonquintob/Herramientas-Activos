    protected override void OnInitialized()
    {
        /*
         * La pantalla utiliza la sesión que ya tiene el sistema.
         * No ejecuta una nueva validación.
         */
        AuthSession.OnChange += HandleAuthSessionChanged;

        ResetHeaderDefaults();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (
            !firstRender
            ||
            purchaseInitializationStarted
            ||
            disposed
        )
        {
            return Task.CompletedTask;
        }

        purchaseInitializationStarted = true;

        /*
         * El primer render termina inmediatamente.
         * Los datos se recuperan después sin bloquear
         * la navegación hacia la página.
         */
        _ = InitializePurchaseWorkspaceAsync();

        return Task.CompletedTask;
    }

    private async Task InitializePurchaseWorkspaceAsync()
    {
        try
        {
            /*
             * Borradores, sedes y solicitudes se procesan
             * independientemente y no bloquean la apertura.
             */
            var localStateTask =
                LoadLocalStateAsync();

            var branchesTask =
                LoadBranchesAsync();

            var requestsTask =
                RefreshPurchaseDataAsync();

            await localStateTask;


            if (!disposed)
            {
                await InvokeAsync(
                    StateHasChanged);
            }

            await Task.WhenAll(
                branchesTask,
                requestsTask);
        }
        catch
        {
            /*
             * La vista permanece disponible aunque alguna
             * fuente de datos temporalmente no responda.
             */
        }
        finally
        {
            if (!disposed)
            {
                await InvokeAsync(
                    StateHasChanged);
            }
        }
    }

