@code {
    private bool isOpen;

    private bool CanShowMenu
    {
        get
        {
            if (!Auth.IsAuthenticated)
            {
                return false;
            }

            var path = GetCurrentPath();

            return !string.Equals(path, "login", StringComparison.OrdinalIgnoreCase) &&
                   !string.Equals(path, "logout", StringComparison.OrdinalIgnoreCase);
        }
    }

    private List<FloatingMenuGroup> MenuGroups
    {
        get
        {
            var groups = new List<FloatingMenuGroup>();

            AddGroup(groups, "PRINCIPAL", BuildPrincipalGroup());
            AddGroup(groups, "ACTIVOS FIJOS", BuildAssetsGroup());
            AddGroup(groups, "OPERACIONES", BuildOperationsGroup());
            AddGroup(groups, "CONTROL", BuildControlGroup());
            AddGroup(groups, "CONFIGURACIÓN", BuildAdministrationGroup());

            return groups;
        }
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void ToggleMenu()
    {
        isOpen = !isOpen;
    }

    private void CloseMenu()
    {
        isOpen = false;
    }

    private void NavigateTo(string url)
    {
        isOpen = false;
        Navigation.NavigateTo(url);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (isOpen)
        {
            isOpen = false;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private List<FloatingMenuItem> BuildPrincipalGroup()
    {
        var items = new List<FloatingMenuItem>();

        if (HasPermission("Dashboard.View"))
        {
            items.Add(new FloatingMenuItem("dashboard", "Dashboard", "/mobile/dashboard", "Indicadores"));
        }

        return items;
    }

    private List<FloatingMenuItem> BuildAssetsGroup()
    {
        var items = new List<FloatingMenuItem>();

        if (HasPermission("Tools.View"))
        {
            items.Add(new FloatingMenuItem("inventory", "Inventario de Herramientas y AF", "/all-tools", "Activos"));
        }

        if (HasAny("AssetAvailability.View", "AssetAvailability.Edit", "AssetAvailability.Status.Change"))
        {
            items.Add(new FloatingMenuItem("location", "Disponible y Ubicación", "/mobile/availability", "Ubicación"));
        }

        if (HasAny("AssetAssignment.View", "AssetAssignment.Request", "Mobile.Loans.Request", "AssetAssignment.Assign", "AssetAssignment.Return", "AssetAssignment.Approve", "AssetAssignment.Deny", "AssetAssignment.History"))
        {
            items.Add(new FloatingMenuItem("assign", "Asignar Herramientas y AF", "/mobile/assignment", "Préstamos"));
        }

        if (HasPermission("AssetAssignment.History"))
        {
            items.Add(new FloatingMenuItem("history", "Historial de asignaciones", "/mobile/history", "Movimientos"));
        }

        if (HasAny("TechnicalLifeRecord.View", "ToolDetail.LifeRecord.Open"))
        {
            items.Add(new FloatingMenuItem("life", "Hoja de Vida de Herramientas", "/mobile/life-records", "Técnica"));
        }

        return items;
    }

    private List<FloatingMenuItem> BuildOperationsGroup()
    {
        var items = new List<FloatingMenuItem>();

        if (HasAny("Purchases.View", "Purchases.Request", "Purchases.Quote", "Purchases.Generate", "Purchases.Approve", "Purchases.Reject"))
        {
            items.Add(new FloatingMenuItem("purchase", "Solicitar Compra Herr. y AF", "/mobile/purchases", "Solicitud"));
        }

        if (HasAny("Maintenance.View", "Maintenance.Request", "Maintenance.Quote", "Maintenance.Generate", "Maintenance.Execute", "Maintenance.Close", "Maintenance.Reject"))
        {
            items.Add(new FloatingMenuItem("maintenance", "Solicitar Mantenimiento", "/mobile/maintenance-request", "Servicio"));
        }

        if (HasAny("Purchases.View", "Maintenance.View"))
        {
            items.Add(new FloatingMenuItem("consult", "Consulta Compras y Mtto.", "/mobile/maintenance", "Consulta"));
        }

        if (HasAny("MaintenancePlans.View", "MaintenancePlans.Create", "MaintenancePlans.Edit", "MaintenancePlans.Delete"))
        {
            items.Add(new FloatingMenuItem("calendar", "Planes de Mantenimiento", "/mobile/maintenance-plans", "Planes"));
        }

        return items;
    }

    private List<FloatingMenuItem> BuildControlGroup()
    {
        var items = new List<FloatingMenuItem>();

        if (HasAny("PhysicalCounts.View", "PhysicalCounts.Create", "PhysicalCounts.Start", "PhysicalCounts.Close", "PhysicalCounts.Report", "PhysicalCounts.Evidence.Upload"))
        {
            items.Add(new FloatingMenuItem("physical", "Tomas Físicas", "/mobile/physical-counts", "Conteos"));
        }

        if (HasAny("Reconciliation.View", "Reconciliation.Clarify", "Reconciliation.ApproveCreation", "Reconciliation.Manage"))
        {
            items.Add(new FloatingMenuItem("reconcile", "Conciliación", "/mobile/reconciliation", "Validación"));
        }

        if (HasAny("Documents.View", "Documents.Upload", "Documents.Download", "Documents.Delete"))
        {
            items.Add(new FloatingMenuItem("document", "Documentos", "/mobile/documents", "Evidencias"));
        }

        if (HasAny("Reports.View", "Reports.Export"))
        {
            items.Add(new FloatingMenuItem("reports", "Reportes", "/mobile/reports", "Indicadores"));
        }

        return items;
    }

    private List<FloatingMenuItem> BuildAdministrationGroup()
    {
        var items = new List<FloatingMenuItem>();

        if (HasAny("Mobile.Access", "Settings.View", "Settings.Manage", "Security.Users", "Security.Roles"))
        {
            items.Add(new FloatingMenuItem("settings", "Configuración", "/mobile/settings", "Parámetros"));
        }

        return items;
    }

    private static void AddGroup(List<FloatingMenuGroup> groups, string title, List<FloatingMenuItem> items)
    {
        if (items.Count > 0)
        {
            groups.Add(new FloatingMenuGroup(title, items));
        }
    }

    private bool IsActive(string url)
    {
        var current = "/" + GetCurrentPath();
        var target = "/" + (url ?? "/").Trim('/');

        if (target == "/")
        {
            return current == "/" || string.IsNullOrWhiteSpace(current.Trim('/'));
        }

        return current.Equals(target, StringComparison.OrdinalIgnoreCase) ||
               current.StartsWith(target + "/", StringComparison.OrdinalIgnoreCase);
    }

    private string GetCurrentPath()
    {
        return Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split('?', '#')[0]
            .Trim('/')
            .ToLowerInvariant();
    }

    private string GetItemClass(string iconKey, bool active)
    {
        var classes = new List<string> { "navi-mobile-floating-menu-item", $"item-{iconKey}" };

        if (active)
        {
            classes.Add("active");
        }

        return string.Join(" ", classes);
    }

    private string GetIconClass(string iconKey)
    {
        return $"navi-mobile-floating-menu-icon icon-{iconKey}";
    }

    private bool HasPermission(string permission)
    {
        return Auth.HasPermission(permission);
    }

    private bool HasAny(params string[] permissions)
    {
        return Auth.HasAnyPermission(permissions);
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "NAVI"
            : value;
    }

    private static string GetMenuSymbol(string iconKey)
    {
        return iconKey switch
        {
            "dashboard" => "📊",
            "inventory" => "🧰",
            "location" => "📍",
            "assign" => "🔁",
            "history" => "🕘",
            "life" => "📋",
            "purchase" => "🛒",
            "maintenance" => "🛠",
            "consult" => "🔎",
            "calendar" => "🗓",
            "physical" => "📦",
            "reconcile" => "⚖",
            "document" => "📄",
            "reports" => "📈",
            "settings" => "⚙",
            _ => "•"
        };
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private sealed record FloatingMenuGroup(
        string Title,
        List<FloatingMenuItem> Items);

    private sealed record FloatingMenuItem(
        string IconKey,
        string Title,
        string Url,
        string Description);
}
