@page "/all-tools"
@page "/my-tools"

@inject NaviMobileApiClient Api
@inject MobileAuthSessionService Auth
@inject NavigationManager Navigation

<PageTitle>@CurrentPageTitle - NAVI Herramientas y AF</PageTitle>

<section class="mobile-page mobile-inventory-v23">

<NaviMobileAppBanner
    Class="mobile-inventory-header-publisher"
    Pill="ACTIVOS FIJOS"
    Title="@CurrentPageTitle"
    Description="Consulta herramientas y activos visibles según tu alcance."
    HomeUrl="/"
    ShowHomeButton="false"
    ShowBackButton="false" />


    @if (isLoading)
    {
        <section class="mobile-inventory-v23-loading"
                 aria-live="polite">

            <span aria-hidden="true">
                <svg viewBox="0 0 24 24"
                     focusable="false">

                    <path d="M20 12a8 8 0 1 1-2.35-5.65"></path>
                    <path d="M20 4v6h-6"></path>
                </svg>
            </span>

            <div>
                <strong>Cargando inventario</strong>

                <small>
                    Consultando herramientas y activos visibles.
                </small>
            </div>
        </section>
    }
    else if (!Auth.IsAuthenticated)
    {
        <section class="mobile-inventory-v23-empty">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true"
                 focusable="false">

                <path d="M7 11V8A5 5 0 0 1 17 8V11"></path>

                <rect x="5"
                      y="11"
                      width="14"
                      height="10"
                      rx="2">
                </rect>
            </svg>

            <strong>Sesión requerida</strong>

            <span>
                Debes iniciar sesión para consultar el inventario.
            </span>

            <button type="button"
                    class="mobile-inventory-v23-secondary"
                    @onclick="GoLogin" data-ntx-tone="consult">

                Ir al login
            </button>
        </section>
    }
    else if (!CanViewInventoryPage)
    {
        <section class="mobile-inventory-v23-empty">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true"
                 focusable="false">

                <circle cx="12"
                        cy="12"
                        r="9">
                </circle>

                <path d="M8 8L16 16"></path>
            </svg>

            <strong>Sin permiso</strong>

            <span>
                Tu usuario no tiene permiso para consultar este inventario.
            </span>

            <button type="button"
                    class="mobile-inventory-v23-secondary"
                    @onclick="GoHome" data-ntx-tone="secondary">

                Volver al inicio
            </button>
        </section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <section class="mobile-inventory-v23-message"
                     role="alert">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true"
                     focusable="false">

                    <path d="M12 4L21 19H3Z"></path>
                    <path d="M12 9V14"></path>
                    <path d="M12 17H12.01"></path>
                </svg>

                <span>@message</span>
            </section>
        }


<NaviMobileKpiOverflow
    PrimaryCount="3"
    OverflowCount="3"
    Class="navi-mobile-kpi-standard-overflow navi-mobile-inventory-kpi-standard"
    ButtonLabel="Mostrar indicadores adicionales">

    <PrimaryContent>

        <NaviMobileKpiGrid
            Columns="3"
            Compact="true"
            Dividers="true"
            Class="navi-mobile-kpi-standard-grid">

            <NaviMobileKpiCard
                Title="Inventario"
                Description="Activos visibles"
                Value="@FormatNumber(summaryTools.Count)"
                IconKey="inventory"
                Tone="neutral" />

            <NaviMobileKpiCard
                Title="Disponibles"
                Description="Para asignación"
                Value="@FormatNumber(AvailableCount)"
                IconKey="check"
                Tone="positive" />

            <NaviMobileKpiCard
                Title="En uso"
                Description="Asignadas"
                Value="@FormatNumber(InUseCount)"
                IconKey="transfer"
                Tone="soft" />

        </NaviMobileKpiGrid>

    </PrimaryContent>

    <OverflowContent>

        <NaviMobileKpiGrid
            Columns="3"
            Compact="true"
            Dividers="true"
            Class="navi-mobile-kpi-standard-grid navi-mobile-kpi-standard-grid--overflow">

            <NaviMobileKpiCard
                Title="Mantenimiento"
                Description="Proceso técnico"
                Value="@FormatNumber(MaintenanceCount)"
                IconKey="wrench"
                Tone="warning" />

            <NaviMobileKpiCard
                Title="Por validar"
                Description="Pendientes"
                Value="@FormatNumber(PendingValidationCount)"
                IconKey="clock"
                Tone="warning" />

            <NaviMobileKpiCard
                Title="Alertas"
                Description="Requieren atención"
                Value="@FormatNumber(AlertCount)"
                IconKey="alert"
                Tone="danger" />

        </NaviMobileKpiGrid>

    </OverflowContent>

</NaviMobileKpiOverflow>

        <section class="mobile-inventory-v23-filter-card"
                 aria-label="Filtros del inventario">

            <div class="mobile-inventory-v23-filter-grid">

                <label>
                    <span>Sede</span>

                    <select id="mobile-inventory-branch-filter"
                            name="mobile-inventory-branch-filter"
                            value="@selectedBranchFilter"
                            @onchange="OnBranchFilterChanged"
                            disabled="@(!UserCanSeeAllBranches())">

                        @foreach (var option in BranchOptions)
                        {
                            <option value="@option.Value">
                                @option.Label
                            </option>
                        }
                    </select>
                </label>

                <label>
                    <span>Estado</span>

                    <select id="mobile-inventory-status-filter"
                            name="mobile-inventory-status-filter"
                            value="@selectedStatusFilter"
                            @onchange="OnStatusFilterChanged">

                        @foreach (var option in StatusOptions)
                        {
                            <option value="@option.Value">
                                @option.Label
                            </option>
                        }
                    </select>
                </label>

            </div>

            <label class="mobile-inventory-v23-search">
                <span>Buscar activo</span>

                <div>
                    <svg viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">

                        <circle cx="10.5"
                                cy="10.5"
                                r="6.5">
                        </circle>

                        <path d="M15.5 15.5L21 21"></path>
                    </svg>

                    <input id="mobile-inventory-search"
                           name="mobile-inventory-search"
                           value="@searchTerm"
                           @oninput="OnSearchChanged"
                           placeholder="Código, nombre, ubicación, responsable o estado..." />
                </div>
            </label>

            @if (HasActiveFilters)
            {
                <button type="button"
                        class="mobile-inventory-v23-clear"
                        @onclick="ClearFilters" data-ntx-tone="secondary">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">

                        <path d="M5 5L19 19"></path>
                        <path d="M19 5L5 19"></path>
                    </svg>

                    <span>Limpiar filtros</span>
                </button>
            }
        </section>

        <section class="mobile-inventory-v23-results-header">

            <div>
                <span>INVENTARIO</span>

                <strong>@CurrentPageTitle</strong>

                <small>
                    @filteredTools.Count de @summaryTools.Count registros
                </small>
            </div>

            <b>@filteredTools.Count</b>
        </section>

        @if (!filteredTools.Any())
        {
            <section class="mobile-inventory-v23-empty">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true"
                     focusable="false">

                    <path d="M4 7H20V20H4Z"></path>
                    <path d="M8 7V4H16V7"></path>
                    <path d="M8 12H16"></path>
                </svg>

                <strong>Sin activos</strong>

                <span>
                    No se encontraron herramientas o activos
                    con los filtros aplicados.
                </span>

                @if (HasActiveFilters)
                {
                    <button type="button"
                            class="mobile-inventory-v23-secondary"
                            @onclick="ClearFilters" data-ntx-tone="secondary">

                        Limpiar filtros
                    </button>
                }
            </section>
        }
        else
        {
            <section class="mobile-inventory-v23-list">

                @foreach (var tool in filteredTools)
                {
                    <article class="mobile-inventory-v23-card">

                        <header>
                            <div>
                                <span class="mobile-inventory-v23-code">
                                    @Display(tool.InternalCode)
                                </span>

                                <strong>
                                    @Display(tool.Name)
                                </strong>
                            </div>

                            @* NAVI MOBILE INVENTORY IMAGE ACTION V54 START *@

                                                        <div class="mobile-inventory-v54-status-actions">

                                                            <span class="@GetStatusClass(tool.OperationalStatus)">
                                                                <i aria-hidden="true"></i>

                                                                @GetStatusLabel(
                                                                    tool.OperationalStatus)
                                                            </span>

                                                            <button
                                                                type="button"
                                                                class="mobile-inventory-v54-preview-button"
                                                                title="Visualizar imagen"
                                                                aria-label="@($"Visualizar imagen de {tool.Name}")"
                                                                data-ntx-tone="consult"
                                                                @onclick="() => OpenInventoryImagePreviewV54(tool)"
                                                                @onclick:stopPropagation="true">

                                                                <svg
                                                                    viewBox="0 0 24 24"
                                                                    aria-hidden="true"
                                                                    focusable="false">

                                                                    <circle
                                                                        cx="10.5"
                                                                        cy="10.5"
                                                                        r="6.5">
                                                                    </circle>

                                                                    <path d="M15.5 15.5L21 21"></path>

                                                                </svg>

                                                            </button>

                                                        </div>

                            @* NAVI MOBILE INVENTORY IMAGE ACTION V54 END *@
                        </header>

                        <section class="mobile-inventory-v23-card-location">

                            <div>
                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true"
                                     focusable="false">

                                    <path d="M12 21S18 15.5 18 10A6 6 0 1 0 6 10C6 15.5 12 21 12 21Z"></path>

                                    <circle cx="12"
                                            cy="10"
                                            r="2">
                                    </circle>
                                </svg>

                                <span>
                                    <small>Sede</small>

                                    <strong>
                                        @DisplayBranch(tool)
                                    </strong>
                                </span>
                            </div>

                            <div>
                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true"
                                     focusable="false">

                                    <path d="M4 7H20V20H4Z"></path>
                                    <path d="M8 7V4H16V7"></path>
                                </svg>

                                <span>
                                    <small>Ubicación</small>

                                    <strong>
                                        @Display(tool.LocationName)
                                    </strong>
                                </span>
                            </div>

                        </section>

                        <section class="mobile-inventory-v23-card-meta">

                            <div>
                                <span>Responsable</span>

                                <strong>
                                    @Display(
                                        tool.ResponsiblePersonName)
                                </strong>
                            </div>

                            <div>
                                <span>Estado físico</span>

                                <strong>
                                    @GetPhysicalStatusLabel(
                                        tool.PhysicalStatus)
                                </strong>
                            </div>

                        </section>

                        <footer>
                            @if (CanViewToolDetail)
                            {
                                <a href="@GetDetailUrl(tool.Id)"
                                   class="mobile-inventory-v23-detail-primary">

                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true"
                                         focusable="false">

                                        <path d="M3 12S6.5 6.5 12 6.5S21 12 21 12S17.5 17.5 12 17.5S3 12 3 12Z"></path>

                                        <circle cx="12"
                                                cy="12"
                                                r="2.5">
                                        </circle>
                                    </svg>

                                    <span>Detalle</span>
                                </a>
                            }
                            else
                            {
                                <span class="mobile-inventory-v23-no-action">
                                    Sin permiso para consultar el detalle
                                </span>
                            }
                        </footer>

                    </article>
                }

            </section>
        }
    }

</section>

@* NAVI MOBILE INVENTORY IMAGE MODAL V54 START *@

@if (
    IsInventoryImagePreviewOpenV54
    &&
    InventoryPreviewToolV54 is not null)
{
    <div
        class="mobile-inventory-v54-overlay"
        role="presentation"
        @onclick="CloseInventoryImagePreviewV54">

        <section
            class="mobile-inventory-v54-dialog"
            role="dialog"
            aria-modal="true"
            aria-label="Vista de la imagen del activo"
            @onclick:stopPropagation="true">

            <header class="mobile-inventory-v54-dialog-header">

                <div>
                    <span>
                        @Display(
                            InventoryPreviewToolV54.InternalCode)
                    </span>

                    <strong>
                        @Display(
                            InventoryPreviewToolV54.Name)
                    </strong>
                </div>

                <button
                    type="button"
                    class="mobile-inventory-v54-close"
                    title="Cerrar"
                    aria-label="Cerrar vista de imagen"
                    data-ntx-tone="secondary"
                    @onclick="CloseInventoryImagePreviewV54">

                    <svg
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                        focusable="false">

                        <path d="M6 6L18 18"></path>
                        <path d="M18 6L6 18"></path>

                    </svg>

                </button>

            </header>

            <div class="mobile-inventory-v54-dialog-content">

                @if (IsInventoryImageLoadingV54)
                {
                    <div class="mobile-inventory-v54-loading">

                        <span
                            class="mobile-inventory-v54-spinner"
                            aria-hidden="true">
                        </span>

                        <strong>
                            Cargando imagen...
                        </strong>

                    </div>
                }
                else if (
                    !string.IsNullOrWhiteSpace(
                        InventoryImageErrorV54))
                {
                    <div class="mobile-inventory-v54-empty">

                        <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            focusable="false">

                            <rect
                                x="3"
                                y="5"
                                width="18"
                                height="14"
                                rx="2">
                            </rect>

                            <circle
                                cx="9"
                                cy="10"
                                r="2">
                            </circle>

                            <path d="M4 17L9 13L13 16L16 13L20 17"></path>

                        </svg>

                        <strong>
                            @InventoryImageErrorV54
                        </strong>

                    </div>
                }
                else if (
                    !string.IsNullOrWhiteSpace(
                        InventoryImageUrlV54))
                {
                    <img
                        src="@InventoryImageUrlV54"
                        alt="@($"Imagen de {InventoryPreviewToolV54.Name}")" />
                }
                else
                {
                    <div class="mobile-inventory-v54-empty">

                        <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            focusable="false">

                            <rect
                                x="3"
                                y="5"
                                width="18"
                                height="14"
                                rx="2">
                            </rect>

                            <circle
                                cx="9"
                                cy="10"
                                r="2">
                            </circle>

                            <path d="M4 17L9 13L13 16L16 13L20 17"></path>

                        </svg>

                        <strong>
                            Sin imagen registrada
                        </strong>

                    </div>
                }

            </div>

            <footer class="mobile-inventory-v54-dialog-footer">

                <span class="@GetStatusClass(
                    InventoryPreviewToolV54.OperationalStatus)">

                    <i aria-hidden="true"></i>

                    @GetStatusLabel(
                        InventoryPreviewToolV54.OperationalStatus)

                </span>

                <button
                    type="button"
                    class="mobile-inventory-v54-close-secondary"
                    @onclick="CloseInventoryImagePreviewV54"
                    data-ntx-tone="secondary">

                    Cerrar

                </button>

            </footer>

        </section>

    </div>
}

@* NAVI MOBILE INVENTORY IMAGE MODAL V54 END *@

@code {
    private bool isLoading = true;

    private bool showSecondaryKpis;

    private string? message;

    private string searchTerm =
        string.Empty;

    private string selectedBranchFilter =
        string.Empty;

    private string selectedStatusFilter =
        string.Empty;

    private List<MobileToolDto> allTools =
        new();

    private List<MobileToolDto> summaryTools =
        new();

    private List<MobileToolDto> filteredTools =
        new();

    private bool IsMyToolsPage =>
        new Uri(Navigation.Uri)
            .AbsolutePath
            .Equals(
                "/my-tools",
                StringComparison.OrdinalIgnoreCase);

    private string CurrentPageTitle =>
        IsMyToolsPage
            ? "Mis activos asignados"
            : "Inventario de Herramientas y AF";

    private bool CanViewInventoryPage =>
        IsMyToolsPage
        ||
        Auth.HasPermission(
            "Tools.View")
        ||
        Auth.HasPermission(
            "Mobile.Tools.View");

    private bool CanViewToolDetail =>
        HasAny(
            "ToolDetail.View",
            "Tools.View",
            "Mobile.Tools.View");

    private int AvailableCount =>
        summaryTools.Count(tool =>
            IsStatus(
                tool,
                "Available",
                "Disponible"));

    private int InUseCount =>
        summaryTools.Count(tool =>
            IsStatus(
                tool,
                "Assigned",
                "Loaned",
                "InUse",
                "Asignado",
                "Asignada",
                "Prestado",
                "Prestada",
                "En uso"));

    private int MaintenanceCount =>
        summaryTools.Count(tool =>
            IsStatus(
                tool,
                "InMaintenance",
                "Maintenance",
                "Mantenimiento",
                "En mantenimiento"));

    private int PendingValidationCount =>
        summaryTools.Count(tool =>
            IsStatus(
                tool,
                "PendingValidation",
                "Pending",
                "Pendiente",
                "Pendiente validación"));

    private int AlertCount =>
        summaryTools.Count(
            IsBlocked);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(
            searchTerm)
        ||
        !string.IsNullOrWhiteSpace(
            selectedStatusFilter)
        ||
        (
            UserCanSeeAllBranches()
            &&
            !string.IsNullOrWhiteSpace(
                selectedBranchFilter)
        );

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();

        if (!Auth.IsAuthenticated)
        {
            isLoading = false;
            return;
        }

        if (!CanViewInventoryPage)
        {
            isLoading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;
            message = null;

            var tools =
                await Api.GetToolsAsync(
                    forceRefresh: false);

            allTools =
                IsMyToolsPage
                    ? tools
                        .Where(
                            IsAssignedToCurrentUser)
                        .OrderBy(tool =>
                            tool.InternalCode)
                        .ThenBy(tool =>
                            tool.Name)
                        .ToList()

                    : FilterInventoryScope(
                            tools)
                        .ToList();

            EnsureValidFilters();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            message =
                "No se pudo cargar el inventario. "
                + ex.Message;

            allTools =
                new();

            summaryTools =
                new();

            filteredTools =
                new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleSecondaryKpis()
    {
        showSecondaryKpis =
            !showSecondaryKpis;
    }

    private void CloseSecondaryKpis()
    {
        showSecondaryKpis = false;
    }

    private void OnSearchChanged(
        ChangeEventArgs args)
    {
        searchTerm =
            args.Value?.ToString()
            ??
            string.Empty;

        ApplyFilter();
    }

    private void OnBranchFilterChanged(
        ChangeEventArgs args)
    {
        selectedBranchFilter =
            args.Value?.ToString()
            ??
            string.Empty;

        ApplyFilter();
    }

    private void OnStatusFilterChanged(
        ChangeEventArgs args)
    {
        selectedStatusFilter =
            args.Value?.ToString()
            ??
            string.Empty;

        ApplyFilter();
    }

    private void ClearFilters()
    {
        searchTerm =
            string.Empty;

        selectedStatusFilter =
            string.Empty;

        if (UserCanSeeAllBranches())
        {
            selectedBranchFilter =
                string.Empty;
        }

        EnsureValidFilters();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var normalizedSearch =
            Normalize(searchTerm);

        IEnumerable<MobileToolDto> query =
            allTools;

        if (!string.IsNullOrWhiteSpace(
                selectedBranchFilter))
        {
            query = query.Where(tool =>
                SameNormalized(
                    GetBranchFilterKey(tool),
                    selectedBranchFilter));
        }

        if (!string.IsNullOrWhiteSpace(
                normalizedSearch))
        {
            query = query.Where(tool =>
                ContainsNormalized(
                    tool.InternalCode,
                    normalizedSearch)
                ||
                ContainsNormalized(
                    tool.Name,
                    normalizedSearch)
                ||
                ContainsNormalized(
                    tool.BranchCode,
                    normalizedSearch)
                ||
                ContainsNormalized(
                    tool.BranchName,
                    normalizedSearch)
                ||
                ContainsNormalized(
                    tool.LocationName,
                    normalizedSearch)
                ||
                ContainsNormalized(
                    tool.ResponsiblePersonName,
                    normalizedSearch)
                ||
                ContainsNormalized(
                    tool.OperationalStatus,
                    normalizedSearch)
                ||
                ContainsNormalized(
                    tool.PhysicalStatus,
                    normalizedSearch));
        }

        summaryTools =
            query
                .OrderBy(tool =>
                    tool.InternalCode)
                .ThenBy(tool =>
                    tool.Name)
                .ToList();

        if (!string.IsNullOrWhiteSpace(
                selectedStatusFilter))
        {
            query = query.Where(tool =>
                SameNormalized(
                    tool.OperationalStatus,
                    selectedStatusFilter));
        }

        filteredTools =
            query
                .OrderBy(tool =>
                    tool.InternalCode)
                .ThenBy(tool =>
                    tool.Name)
                .ToList();
    }

    private void EnsureValidFilters()
    {
        var branchOptions =
            BranchOptions;

        if (!UserCanSeeAllBranches() &&
            branchOptions.Count > 0)
        {
            selectedBranchFilter =
                branchOptions[0].Value;
        }
        else if (
            !string.IsNullOrWhiteSpace(
                selectedBranchFilter)
            &&
            !branchOptions.Any(option =>
                SameNormalized(
                    option.Value,
                    selectedBranchFilter)))
        {
            selectedBranchFilter =
                string.Empty;
        }

        var statusOptions =
            StatusOptions;

        if (
            !string.IsNullOrWhiteSpace(
                selectedStatusFilter)
            &&
            !statusOptions.Any(option =>
                SameNormalized(
                    option.Value,
                    selectedStatusFilter)))
        {
            selectedStatusFilter =
                string.Empty;
        }
    }

    private IReadOnlyList<FilterOption>
        BranchOptions
    {
        get
        {
            var options =
                new List<FilterOption>();

            var seen =
                new HashSet<string>(
                    StringComparer.OrdinalIgnoreCase);

            if (UserCanSeeAllBranches())
            {
                options.Add(
                    new FilterOption(
                        string.Empty,
                        "Todas las sedes"));
            }

            foreach (var tool in allTools)
            {
                var value =
                    GetBranchFilterKey(tool);

                if (string.IsNullOrWhiteSpace(
                        value))
                {
                    continue;
                }

                var normalized =
                    Normalize(value);

                if (seen.Add(normalized))
                {
                    options.Add(
                        new FilterOption(
                            value,
                            GetBranchFilterLabel(tool)));
                }
            }

            if (!UserCanSeeAllBranches() &&
                options.Count == 0)
            {
                var user =
                    Auth.CurrentUser;

                var value =
                    !string.IsNullOrWhiteSpace(
                        user?.BranchCode)
                        ? user!.BranchCode!
                        : user?.BranchName
                          ??
                          string.Empty;

                if (!string.IsNullOrWhiteSpace(value))
                {
                    options.Add(
                        new FilterOption(
                            value,
                            Display(value)));
                }
            }

            return options;
        }
    }

    private IReadOnlyList<FilterOption>
        StatusOptions
    {
        get
        {
            var options =
                new List<FilterOption>
                {
                    new(
                        string.Empty,
                        "Todos los estados")
                };

            var seen =
                new HashSet<string>(
                    StringComparer.OrdinalIgnoreCase);

            foreach (
                var status in allTools
                    .Select(tool =>
                        tool.OperationalStatus)
                    .Where(status =>
                        !string.IsNullOrWhiteSpace(
                            status))
                    .OrderBy(status =>
                        GetStatusLabel(status)))
            {
                var value =
                    status
                    ??
                    string.Empty;

                var normalized =
                    Normalize(value);

                if (seen.Add(normalized))
                {
                    options.Add(
                        new FilterOption(
                            value,
                            GetStatusLabel(value)));
                }
            }

            return options;
        }
    }

    private IEnumerable<MobileToolDto>
        FilterInventoryScope(
            IEnumerable<MobileToolDto> source)
    {
        if (Auth.CurrentUser is null)
        {
            return Enumerable.Empty<
                MobileToolDto>();
        }

        if (!CanViewInventoryPage)
        {
            return Enumerable.Empty<
                MobileToolDto>();
        }

        if (UserCanSeeAllBranches())
        {
            return source
                .OrderBy(tool =>
                    tool.BranchCode)
                .ThenBy(tool =>
                    tool.InternalCode)
                .ThenBy(tool =>
                    tool.Name);
        }

        return source
            .Where(IsSameBranch)
            .OrderBy(tool =>
                tool.InternalCode)
            .ThenBy(tool =>
                tool.Name);
    }

    private bool IsAssignedToCurrentUser(
        MobileToolDto tool)
    {
        var user =
            Auth.CurrentUser;

        if (user is null)
        {
            return false;
        }

        if (
            user.ResponsiblePersonId.HasValue
            &&
            tool.ResponsiblePersonId
            ==
            user.ResponsiblePersonId.Value)
        {
            return true;
        }

        if (string.IsNullOrWhiteSpace(
                tool.ResponsiblePersonName))
        {
            return false;
        }

        return
            SameNormalized(
                tool.ResponsiblePersonName,
                user.ResponsiblePersonName)
            ||
            SameNormalized(
                tool.ResponsiblePersonName,
                user.DisplayName)
            ||
            SameNormalized(
                tool.ResponsiblePersonName,
                user.UserName);
    }

    private bool IsSameBranch(
        MobileToolDto tool)
    {
        var user =
            Auth.CurrentUser;

        if (user is null)
        {
            return false;
        }

        return
            SameNormalized(
                tool.BranchCode,
                user.BranchCode)
            ||
            SameNormalized(
                tool.BranchName,
                user.BranchName)
            ||
            SameNormalized(
                tool.BranchCode,
                user.BranchName)
            ||
            SameNormalized(
                tool.BranchName,
                user.BranchCode);
    }

    private bool UserCanSeeAllBranches()
    {
        var user =
            Auth.CurrentUser;

        if (user is null)
        {
            return false;
        }

        return
            Auth.IsAdmin()
            ||
            SameNormalized(
                user.BranchCode,
                "TODAS")
            ||
            SameNormalized(
                user.BranchCode,
                "ALL")
            ||
            SameNormalized(
                user.BranchName,
                "Todas las sedes")
            ||
            SameNormalized(
                user.BranchName,
                "TODAS")
            ||
            SameNormalized(
                user.BranchName,
                "ALL");
    }

    private bool HasAny(
        params string[] permissions)
    {
        return permissions.Any(
            permission =>
                Auth.HasPermission(permission));
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }

    private void GoLogin()
    {
        Navigation.NavigateTo(
            "/login",
            replace: true);
    }

    private string GetDetailUrl(
        Guid id)
    {
        if (IsMyToolsPage)
        {
            return "/tools/" + id;
        }

        return
            "/tools/"
            + id
            + "?returnUrl="
            + Uri.EscapeDataString(
                "/all-tools");
    }

    private static string
        GetBranchFilterKey(
            MobileToolDto tool)
    {
        return
            !string.IsNullOrWhiteSpace(
                tool.BranchCode)
                ? tool.BranchCode
                : tool.BranchName
                  ??
                  string.Empty;
    }

    private static string
        GetBranchFilterLabel(
            MobileToolDto tool)
    {
        if (
            !string.IsNullOrWhiteSpace(
                tool.BranchName)
            &&
            !string.IsNullOrWhiteSpace(
                tool.BranchCode))
        {
            return
                tool.BranchName
                + " - "
                + tool.BranchCode;
        }

        return Display(
            tool.BranchName
            ??
            tool.BranchCode);
    }

    private static string DisplayBranch(
        MobileToolDto tool)
    {
        if (
            !string.IsNullOrWhiteSpace(
                tool.BranchName)
            &&
            !string.IsNullOrWhiteSpace(
                tool.BranchCode))
        {
            return
                tool.BranchName
                + " - "
                + tool.BranchCode;
        }

        return Display(
            tool.BranchName
            ??
            tool.BranchCode);
    }

    private static string Display(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Sin dato"
            : value.Trim();
    }

    private static string FormatNumber(
        int value)
    {
        return Math.Max(
                0,
                value)
            .ToString(
                "N0",
                System.Globalization
                    .CultureInfo
                    .GetCultureInfo("es-CO"));
    }

    private static bool IsStatus(
        MobileToolDto tool,
        params string[] statuses)
    {
        return statuses.Any(status =>
            SameNormalized(
                tool.OperationalStatus,
                status));
    }

    private static bool IsBlocked(
        MobileToolDto tool)
    {
        var status =
            Normalize(
                tool.OperationalStatus);

        return status is
            "DAMAGED"
            or "DANADO"
            or "DANADA"
            or "NOTSUITABLE"
            or "NOAPTO"
            or "NOAPTA"
            or "NOTLOCATED"
            or "NOLOCALIZADO"
            or "NOLOCALIZADA"
            or "INCONSISTENT"
            or "INCONSISTENTE"
            or "PENDINGDISPOSAL"
            or "PENDIENTEDEBAJA"
            or "DISPOSED"
            or "DADADEBAJA";
    }

    private static bool ContainsNormalized(
        string? value,
        string query)
    {
        return Normalize(value)
            .Contains(
                query,
                StringComparison.OrdinalIgnoreCase);
    }

    private static bool SameNormalized(
        string? left,
        string? right)
    {
        var a =
            Normalize(left);

        var b =
            Normalize(right);

        return
            !string.IsNullOrWhiteSpace(a)
            &&
            !string.IsNullOrWhiteSpace(b)
            &&
            string.Equals(
                a,
                b,
                StringComparison.OrdinalIgnoreCase);
    }

    private static string Normalize(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value
            .Trim()
            .ToUpperInvariant()
            .Replace("Á", "A")
            .Replace("É", "E")
            .Replace("Í", "I")
            .Replace("Ó", "O")
            .Replace("Ú", "U")
            .Replace("Ü", "U")
            .Replace("Ñ", "N")
            .Replace(" ", string.Empty)
            .Replace("-", string.Empty)
            .Replace("_", string.Empty);
    }

    private static string GetStatusLabel(
        string? status)
    {
        return Normalize(status) switch
        {
            "AVAILABLE"
                or "DISPONIBLE"
                => "Disponible",

            "ASSIGNED"
                or "ASSIGNEDTORESPONSIBLE"
                or "ASIGNADO"
                or "ASIGNADA"
                => "Asignada",

            "LOANED"
                or "PRESTADO"
                or "PRESTADA"
                or "INUSE"
                or "ENUSO"
                => "Prestada",

            "INMAINTENANCE"
                or "MAINTENANCE"
                or "MANTENIMIENTO"
                or "ENMANTENIMIENTO"
                => "En mantenimiento",

            "PENDINGVALIDATION"
                or "PENDING"
                or "PENDIENTE"
                => "Pendiente validación",

            "DAMAGED"
                or "DANADO"
                or "DANADA"
                => "Dañada",

            "NOTSUITABLE"
                or "NOAPTO"
                or "NOAPTA"
                => "No apta",

            "NOTLOCATED"
                or "NOLOCALIZADO"
                or "NOLOCALIZADA"
                => "No localizada",

            "INCONSISTENT"
                or "INCONSISTENTE"
                => "Inconsistente",

            "PENDINGDISPOSAL"
                or "PENDIENTEDEBAJA"
                => "Pendiente de baja",

            "DISPOSED"
                or "DADADEBAJA"
                => "Dada de baja",

            _ => Display(status)
        };
    }

    private static string
        GetPhysicalStatusLabel(
            string? status)
    {
        return Normalize(status) switch
        {
            "GOOD"
                or "BUENO"
                or "BUENA"
                => "Bueno",

            "REGULAR"
                => "Regular",

            "DAMAGED"
                or "DANADO"
                or "DANADA"
                => "Dañado",

            "NOTSUITABLE"
                or "NOAPTO"
                or "NOAPTA"
                => "No apto",

            _ => Display(status)
        };
    }

    private static string GetStatusClass(
        string? status)
    {
        var normalized =
            Normalize(status);

        if (normalized is
            "AVAILABLE"
            or "DISPONIBLE")
        {
            return
                "mobile-inventory-v23-status "
                + "is-available";
        }

        if (normalized is
            "ASSIGNED"
            or "ASSIGNEDTORESPONSIBLE"
            or "ASIGNADO"
            or "ASIGNADA"
            or "LOANED"
            or "PRESTADO"
            or "PRESTADA"
            or "INUSE"
            or "ENUSO")
        {
            return
                "mobile-inventory-v23-status "
                + "is-in-use";
        }

        if (normalized is
            "INMAINTENANCE"
            or "MAINTENANCE"
            or "MANTENIMIENTO"
            or "ENMANTENIMIENTO"
            or "PENDINGVALIDATION"
            or "PENDING"
            or "PENDIENTE")
        {
            return
                "mobile-inventory-v23-status "
                + "is-warning";
        }

        if (IsDangerStatus(normalized))
        {
            return
                "mobile-inventory-v23-status "
                + "is-danger";
        }

        return
            "mobile-inventory-v23-status "
            + "is-neutral";
    }

    private static bool IsDangerStatus(
        string status)
    {
        return status is
            "DAMAGED"
            or "DANADO"
            or "DANADA"
            or "NOTSUITABLE"
            or "NOAPTO"
            or "NOAPTA"
            or "NOTLOCATED"
            or "NOLOCALIZADO"
            or "NOLOCALIZADA"
            or "INCONSISTENT"
            or "INCONSISTENTE"
            or "PENDINGDISPOSAL"
            or "PENDIENTEDEBAJA"
            or "DISPOSED"
            or "DADADEBAJA";
    }

    private sealed record FilterOption(
        string Value,
        string Label);
}
