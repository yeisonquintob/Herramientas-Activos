/* NAVI ADMIN BUTTONS STANDARD 20260702 START */

/* ==========================================================================
   PROMPT 4 - Estándar global de botones Admin Web

   Objetivo:
   - Botones compactos.
   - Misma altura, radio, peso visual y comportamiento.
   - Colores por tipo de acción.
   - Botones de tabla más pequeños.
   - Botones de formularios alineados y consistentes.
   - Botones del encabezado respetan el estándar del Prompt 3.
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. Variables específicas de botones
   -------------------------------------------------------------------------- */

:root {
    --navi-btn-h: 30px;
    --navi-btn-h-sm: 27px;
    --navi-btn-h-xs: 24px;

    --navi-btn-radius: .48rem;
    --navi-btn-radius-sm: .42rem;

    --navi-btn-font: .74rem;
    --navi-btn-font-sm: .68rem;
    --navi-btn-font-xs: .62rem;

    --navi-btn-pad-x: .72rem;
    --navi-btn-pad-x-sm: .55rem;

    --navi-btn-purple: #76008f;
    --navi-btn-purple-dark: #4b005c;
    --navi-btn-purple-soft: #fbf2ff;

    --navi-btn-blue: #0d6efd;
    --navi-btn-blue-dark: #084ec1;
    --navi-btn-blue-soft: #eff6ff;

    --navi-btn-green: #198754;
    --navi-btn-green-dark: #0f6b3e;
    --navi-btn-green-soft: #ecfdf3;

    --navi-btn-red: #dc3545;
    --navi-btn-red-dark: #b42318;
    --navi-btn-red-soft: #fff1f2;

    --navi-btn-yellow: #f59e0b;
    --navi-btn-yellow-dark: #b45309;
    --navi-btn-yellow-soft: #fff8df;

    --navi-btn-gray: #6b7280;
    --navi-btn-gray-dark: #374151;
    --navi-btn-gray-soft: #f8fafc;
}

/* --------------------------------------------------------------------------
   2. Base universal de botones
   -------------------------------------------------------------------------- */

.btn,
button.btn,
a.btn,
input[type="button"].btn,
input[type="submit"].btn,
input[type="reset"].btn {
    min-height: var(--navi-btn-h) !important;
    height: var(--navi-btn-h) !important;

    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: .28rem !important;

    padding: 0 var(--navi-btn-pad-x) !important;

    border-radius: var(--navi-btn-radius) !important;
    border-width: 1px !important;

    font-family: var(--navi-font, 'Poppins', system-ui, sans-serif) !important;
    font-size: var(--navi-btn-font) !important;
    font-weight: 900 !important;
    line-height: 1 !important;
    letter-spacing: -.012em !important;
    text-align: center !important;
    text-decoration: none !important;
    white-space: nowrap !important;

    box-shadow: none !important;
    cursor: pointer !important;

    transition:
        background-color .14s ease,
        border-color .14s ease,
        color .14s ease,
        transform .12s ease,
        box-shadow .12s ease,
        opacity .12s ease !important;
}

.btn:hover,
button.btn:hover,
a.btn:hover {
    transform: translateY(-1px) !important;
    text-decoration: none !important;
}

.btn:active,
button.btn:active,
a.btn:active {
    transform: translateY(0) !important;
}

.btn:focus,
button.btn:focus,
a.btn:focus {
    box-shadow: 0 0 0 .14rem rgba(118, 0, 143, .16) !important;
}

.btn:disabled,
.btn.disabled,
button:disabled,
button.btn:disabled {
    opacity: .54 !important;
    cursor: not-allowed !important;
    transform: none !important;
}

/* --------------------------------------------------------------------------
   3. Tamaños
   -------------------------------------------------------------------------- */

.btn-sm,
button.btn-sm,
a.btn-sm,
.navi-btn-sm {
    min-height: var(--navi-btn-h-sm) !important;
    height: var(--navi-btn-h-sm) !important;
    padding: 0 var(--navi-btn-pad-x-sm) !important;
    border-radius: var(--navi-btn-radius-sm) !important;
    font-size: var(--navi-btn-font-sm) !important;
}

.btn-xs,
.navi-btn-xs {
    min-height: var(--navi-btn-h-xs) !important;
    height: var(--navi-btn-h-xs) !important;
    padding: 0 .46rem !important;
    border-radius: .38rem !important;
    font-size: var(--navi-btn-font-xs) !important;
}

/* --------------------------------------------------------------------------
   4. Botón primario NAVI: morado
   Uso: Guardar, Confirmar, Ver detalle, Ver hoja de vida, Gestionar principal.
   -------------------------------------------------------------------------- */

.btn-primary,
.navi-btn-primary,
button[class*="primary"],
a[class*="primary"] {
    color: #ffffff !important;
    border-color: var(--navi-btn-purple) !important;
    background: linear-gradient(135deg, var(--navi-btn-purple-dark), var(--navi-btn-purple)) !important;
}

.btn-primary:hover,
.navi-btn-primary:hover {
    color: #ffffff !important;
    border-color: var(--navi-btn-purple-dark) !important;
    background: linear-gradient(135deg, #380043, #67007f) !important;
    box-shadow: 0 .28rem .62rem rgba(118, 0, 143, .18) !important;
}

/* --------------------------------------------------------------------------
   5. Botón secundario: blanco con borde azul/morado
   Uso: Volver, Recargar, Limpiar, Ver, Cronograma, acciones no destructivas.
   -------------------------------------------------------------------------- */

.btn-outline-primary,
.navi-btn-secondary,
.navi-btn-outline,
.btn-outline-secondary {
    color: var(--navi-btn-blue) !important;
    border-color: var(--navi-btn-blue) !important;
    background: #ffffff !important;
}

.btn-outline-primary:hover,
.navi-btn-secondary:hover,
.navi-btn-outline:hover,
.btn-outline-secondary:hover {
    color: #ffffff !important;
    border-color: var(--navi-btn-blue) !important;
    background: var(--navi-btn-blue) !important;
}

/* Secundario neutro */

.btn-secondary {
    color: #ffffff !important;
    border-color: var(--navi-btn-gray) !important;
    background: var(--navi-btn-gray) !important;
}

.btn-secondary:hover {
    color: #ffffff !important;
    border-color: var(--navi-btn-gray-dark) !important;
    background: var(--navi-btn-gray-dark) !important;
}

/* --------------------------------------------------------------------------
   6. Éxito: verde
   Uso: Aprobar, Iniciar, Activar, Crear toma, Generar cuando representa cierre positivo.
   -------------------------------------------------------------------------- */

.btn-success,
.navi-btn-success {
    color: #ffffff !important;
    border-color: var(--navi-btn-green) !important;
    background: var(--navi-btn-green) !important;
