@page "/Error"
@using System.Diagnostics

<PageTitle>Error - NAVI</PageTitle>

<NaviPageHero Pill="SISTEMA"
              Title="Error inesperado"
              Description="No fue posible completar la solicitud actual. Recarga la vista o vuelve al Dashboard.">
    <a class="btn btn-primary" href="/dashboard" data-ntx-tone="ghost" >Dashboard</a>
</NaviPageHero>

<section class="admin-standard-card error-standard-card">
    <span class="error-standard-pill">Incidente</span>
    <h2>Ocurrió un error procesando la solicitud</h2>

    @if (ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> <code>@RequestId</code>
        </p>
    }
    else
    {
        <p>El sistema no recibió un identificador de solicitud para este evento.</p>
    }

    <div class="error-standard-actions">
        <a class="btn btn-primary" href="/dashboard" data-ntx-tone="secondary" >Ir al Dashboard</a>
        <a class="btn btn-outline-secondary" href="/tools" data-ntx-tone="secondary" >Ir a inventario</a>
    </div>
</section>



@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
