@page "/settings"
@rendermode InteractiveServer
@using Navi.ToolsAssets.Admin.Services.Auth
@using Navi.ToolsAssets.Admin.Components.Shared
@inject WebAuthSessionService AuthSession

<PageTitle>Configuración - NAVI Herramientas</PageTitle>

<PermissionGuard Permission="Settings.View" ModuleName="Configuración">
    <NaviPageHero
        Pill="CONFIGURACIÓN"
        Title="Configuración"
        Description="Administra sedes, zonas, talleres, ubicaciones, responsables, tipos de activos, documentos, mantenimientos, causales y parámetros base.">

        <button type="button" onclick="window.location.reload()">
            Actualizar
        </button>

    </NaviPageHero>

    <section class="settings-tech-grid">

        @foreach (var item in VisibleOptions)
        {
            <article class="settings-tech-card">
                <span>@item.Group</span>
                <h3>@item.Title</h3>
                <p>@item.Description</p>

                @if (CanOpenOption(item))
                {
                    <a class="btn btn-outline-primary w-100" href="@item.Url">
                        @(CanManageOption(item) ? "Gestionar" : "Consultar")
                    </a>
                }
                else
                {
                    <button class="btn btn-outline-secondary w-100" type="button" disabled>
                        Sin permiso
                    </button>
                }
            </article>
        }

    </section>
</PermissionGuard>

<style>
    .settings-tech-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(180px, 1fr));
        gap: 0.75rem;
        align-items: stretch;
        margin-top: 1rem;
    }

    .settings-tech-card {
        background: #ffffff;
        border: 1px solid #dfe3e8;
        border-radius: 0.75rem;
        padding: 0.85rem;
        min-height: 132px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 0.3rem 0.75rem rgba(0, 0, 0, 0.045);
    }

    .settings-tech-card:hover {
        border-color: #4b005c;
        box-shadow: 0 0.5rem 1.1rem rgba(75, 0, 92, 0.12);
        transform: translateY(-1px);
        transition: all 0.15s ease;
    }

    .settings-tech-card span {
        display: block;
        color: #637083;
        font-size: 0.68rem;
        font-weight: 950;
        letter-spacing: 0.05rem;
        text-transform: uppercase;
        margin-bottom: 0.45rem;
    }

    .settings-tech-card h3 {
        color: #111827;
        font-size: 0.98rem;
        font-weight: 950;
        margin: 0 0 0.3rem 0;
    }

    .settings-tech-card p {
        color: #5f5963;
        font-size: 0.78rem;
        line-height: 1.3;
        margin: 0 0 0.85rem 0;
    }

    .settings-tech-card .btn {
        height: 30px;
        padding: 0.25rem 0.6rem;
        font-size: 0.78rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 850;
    }

    @@media (max-width: 1500px) {
        .settings-tech-grid {
            grid-template-columns: repeat(4, minmax(180px, 1fr));
        }
    }

    @@media (max-width: 1100px) {
        .settings-tech-grid {
            grid-template-columns: repeat(2, minmax(180px, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .settings-tech-grid {
            grid-template-columns: 1fr;
        }
    }

/* NAVI PROMPTS 29 30 31 DOCUMENTS REPORTS SETTINGS STANDARD 20260705 START */

/* ==========================================================================
