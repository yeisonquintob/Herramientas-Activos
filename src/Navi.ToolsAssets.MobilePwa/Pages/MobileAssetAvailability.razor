    private void SyncFormTexts()
    {
        if (SelectedAvailabilityTool is not null)
        {
            SelectTool(SelectedAvailabilityTool);
            return;
        }

        if (!UserCanSeeAllBranches())
        {
            var currentBranch = branches.FirstOrDefault(x =>
                SameNormalized(x.Code, Auth.CurrentUser?.BranchCode) ||
                SameNormalized(x.Name, Auth.CurrentUser?.BranchName));

            if (currentBranch is not null)
            {
                form.BranchId = currentBranch.Id;
                branchSearchText = FormatBranchOption(currentBranch);
            }
        }
    }

    private bool MatchesAvailabilitySearch(MobileAvailabilityToolDto tool)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return true;
        }

        return Contains(tool.InternalCode, search)
            || Contains(tool.Name, search)
            || Contains(tool.SerialNumber, search)
            || Contains(tool.FixedAssetCode, search)
            || Contains(tool.FenixCode, search)
            || Contains(tool.BranchCode, search)
            || Contains(tool.BranchName, search)
            || Contains(tool.LocationCode, search)
            || Contains(tool.LocationName, search)
            || Contains(tool.ResponsiblePersonName, search)
            || Contains(tool.PhysicalStatus, search)
            || Contains(tool.OperationalStatus, search)
            || Contains(StatusLabel(tool.OperationalStatus), search);
    }

    private bool MatchesAvailabilityBranch(MobileAvailabilityToolDto tool)
    {
        if (string.IsNullOrWhiteSpace(selectedBranchCode))
        {
            return true;
        }

        return Contains(tool.BranchCode, selectedBranchCode)
            || Contains(tool.BranchName, selectedBranchCode);
    }

    private bool MatchesAvailabilityStatus(MobileAvailabilityToolDto tool)
    {
        if (string.IsNullOrWhiteSpace(selectedStatus))
        {
            return true;
        }

        return SameNormalized(tool.OperationalStatus, selectedStatus);
    }
    private bool IsSameBranch(MobileAvailabilityToolDto tool)
    {
        if (UserCanSeeAllBranches())
        {
            return true;
        }

        var user = Auth.CurrentUser;

        if (user is null)
        {
            return false;
        }

        if (user.BranchId.HasValue && tool.BranchId.HasValue && user.BranchId.Value == tool.BranchId.Value)
        {
            return true;
        }

        return SameNormalized(tool.BranchCode, user.BranchCode)
            || SameNormalized(tool.BranchName, user.BranchName)
            || SameNormalized(tool.BranchCode, user.BranchName)
            || SameNormalized(tool.BranchName, user.BranchCode);
    }
    private bool IsVisibleBranch(MobileBranchDto branch)
    {
        if (UserCanSeeAllBranches())
        {
            return true;
        }

        var user = Auth.CurrentUser;

        if (user is null)
        {
            return false;
        }

        if (user.BranchId.HasValue && branch.Id == user.BranchId.Value)
        {
            return true;
        }

        return SameNormalized(branch.Code, user.BranchCode)
            || SameNormalized(branch.Name, user.BranchName)
            || SameNormalized(branch.Code, user.BranchName)
            || SameNormalized(branch.Name, user.BranchCode);
    }
    private bool IsVisibleLocation(MobileLocationDto location)
    {
        if (UserCanSeeAllBranches())
        {
            return true;
        }

        var user = Auth.CurrentUser;

        if (user is null)
        {
            return false;
        }

        if (user.BranchId.HasValue && location.BranchId.HasValue && user.BranchId.Value == location.BranchId.Value)
        {
            return true;
        }

        return SameNormalized(location.BranchCode, user.BranchCode)
            || SameNormalized(location.BranchName, user.BranchName)
            || SameNormalized(location.BranchCode, user.BranchName)
            || SameNormalized(location.BranchName, user.BranchCode);
    }

    private bool UserCanSeeAllBranches()
    {
        var user = Auth.CurrentUser;

        if (user is null)
        {
            return false;
        }

        return Auth.IsAdmin()
            || SameNormalized(user.BranchCode, "TODAS")
            || SameNormalized(user.BranchCode, "ALL")
            || SameNormalized(user.BranchName, "Todas las sedes")
            || SameNormalized(user.BranchName, "TODAS")
            || SameNormalized(user.BranchName, "ALL");
    }



    private MobileAvailabilityToolDto? ResolveTool(string value)
    {
        return ScopedTools.FirstOrDefault(x =>
            SameNormalized(FormatToolOption(x), value) ||
            SameNormalized($"{x.InternalCode} - {x.Name}", value) ||
            SameNormalized(x.InternalCode, value) ||
            SameNormalized(x.Name, value) ||
            SameNormalized(x.SerialNumber, value) ||
            SameNormalized(x.FixedAssetCode, value) ||
            SameNormalized(x.FenixCode, value));
    }

    private MobileBranchDto? ResolveBranch(string value)
    {
        return branches.FirstOrDefault(x =>
            SameNormalized(FormatBranchOption(x), value) ||
            SameNormalized(x.Code, value) ||
            SameNormalized(x.Name, value));
    }

    private MobileLocationDto? ResolveLocation(string value)
    {
        return AvailableLocations.FirstOrDefault(x =>
            SameNormalized(FormatLocationOption(x), value) ||
            SameNormalized(x.Code, value) ||
            SameNormalized(x.Name, value));
    }

    private static string FormatToolOption(MobileAvailabilityToolDto tool)
    {
        var serial = string.IsNullOrWhiteSpace(tool.SerialNumber) ? "Sin serial" : tool.SerialNumber;
        var branch = string.IsNullOrWhiteSpace(tool.BranchCode) ? "Sin sede" : tool.BranchCode;

        return $"{tool.InternalCode} - {tool.Name} · {branch} · {serial}";
    }

    private static string FormatBranchOption(MobileBranchDto branch)
    {
        return $"{branch.Code} - {branch.Name}";
    }

    private static string FormatLocationOption(MobileLocationDto location)
    {
        return $"{location.Code} - {location.Name}";
    }

