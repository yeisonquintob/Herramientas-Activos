    private async Task SaveDraftAsync()
    {
        await SaveOrUpdateStoredRequestAsync(LocalStatusDraft);
        successMessage = "Borrador guardado. La solicitud quedó registrada abajo para editar o confirmar.";
        ClearWorkspace();
    }

    private async Task ConfirmRequestAsync()
    {

        if (!CanCreateOrConfirmRequest)
        {
            return;
        }

        await SaveOrUpdateStoredRequestAsync(LocalStatusConfirmed);
        successMessage = "Solicitud confirmada. Quedó registrada abajo como pendiente por cotizar.";
        ClearWorkspace();
    }

    private async Task SaveOrUpdateStoredRequestAsync(string status)
    {
        if (!SelectedLines.Any())
        {
            errorMessage = "Debes agregar y seleccionar al menos una herramienta.";
            return;
        }

        var now = DateTime.Now;
        var id = activeStoredRequestId ?? Guid.NewGuid();

        var item = storedRequests.FirstOrDefault(x => x.Id == id);

        if (item is null)
        {
            item = new StoredRequest
            {
                Id = id,
                CreatedAt = now,
                LocalNumber = BuildLocalNumber(status, now)
            };

            storedRequests.Add(item);
        }

        item.Status = status;
        item.Header = header.Clone();
        item.Lines = currentLines.Select(x => x.Clone()).ToList();
        item.Quotations = currentQuotes.Select(x => x.Clone()).ToList();
        item.UpdatedAt = now;

        await SaveLocalStateAsync();
    }

    private void LoadDraftForEdit(Guid id)
    {
        var item = storedRequests.FirstOrDefault(x => x.Id == id && x.Status == LocalStatusDraft);

        if (item is null)
        {
            return;
        }

        LoadStoredRequestToWorkspace(item);
        currentStatus = LocalStatusDraft;
        successMessage = "Borrador cargado para edición.";
    }

    private async Task ConfirmStoredRequestAsync(Guid id)
    {
        var item = storedRequests.FirstOrDefault(x => x.Id == id && x.Status == LocalStatusDraft);

        if (item is null)
        {
            return;
        }

        item.Status = LocalStatusConfirmed;
        item.UpdatedAt = DateTime.Now;
        await SaveLocalStateAsync();

        if (activeStoredRequestId == id)
        {
            ClearWorkspace();
        }

        successMessage = "Borrador confirmado. Ahora puedes realizar cotización.";
    }

    private async Task StartQuotationAsync(Guid id)
    {

        if (!CanRegisterQuotation)
        {
            return;
        }

        var item = storedRequests.FirstOrDefault(x => x.Id == id && x.Status == LocalStatusConfirmed);

        if (item is null)
        {
            return;
        }

        item.Status = LocalStatusQuoting;
        item.UpdatedAt = DateTime.Now;
        await SaveLocalStateAsync();

        LoadStoredRequestToWorkspace(item);
        currentStatus = LocalStatusQuoting;
        successMessage = "Cotización habilitada. Agrega las cotizaciones y luego genera la solicitud.";
    }

    private void ContinueQuotation(Guid id)
    {

        if (!CanRegisterQuotation)
        {
            return;
        }

        var item = storedRequests.FirstOrDefault(x => x.Id == id && x.Status == LocalStatusQuoting);

        if (item is null)
        {
            return;
        }

        LoadStoredRequestToWorkspace(item);
        currentStatus = LocalStatusQuoting;
        successMessage = "Cotización cargada para continuar.";
    }

    private void LoadStoredRequestToWorkspace(StoredRequest item)
    {
        activeStoredRequestId = item.Id;
        header.CopyFrom(item.Header);
        currentLines = item.Lines.Select(x => x.Clone()).ToList();
        currentQuotes = item.Quotations.Select(x => x.Clone()).ToList();
        ClearLine();
        ClearQuotation();
    }

    private async Task AddQuotationAsync()
    {

        if (!CanRegisterQuotation)
        {
            return;
        }

        errorMessage = null;

        if (!CanQuote)
        {
            errorMessage = "Primero debes seleccionar una solicitud confirmada y presionar Realizar cotización.";
            return;
        }

        if (string.IsNullOrWhiteSpace(quoteForm.Provider))
        {
            errorMessage = "Debes indicar el proveedor.";
            return;
        }

        if (editingQuoteId.HasValue)
        {
            var existing = currentQuotes.FirstOrDefault(x => x.Id == editingQuoteId.Value);

            if (existing is not null)
            {
                existing.Provider = quoteForm.Provider.Trim();
                existing.LineId = TryGuid(quoteForm.LineIdText);
                existing.QuotationDate = quoteForm.QuotationDate;
                existing.DeliveryTime = quoteForm.DeliveryTime?.Trim();
                existing.PriceBeforeVat = quoteForm.PriceBeforeVat;
                existing.AdditionalDetails = quoteForm.AdditionalDetails?.Trim();
            }
        }
        else
        {
            currentQuotes.Add(new QuotationItem
            {
                Id = Guid.NewGuid(),
                Selected = true,
                Provider = quoteForm.Provider.Trim(),
                LineId = TryGuid(quoteForm.LineIdText),
                QuotationDate = quoteForm.QuotationDate,
                DeliveryTime = quoteForm.DeliveryTime?.Trim(),
                PriceBeforeVat = quoteForm.PriceBeforeVat,
                AdditionalDetails = quoteForm.AdditionalDetails?.Trim()
            });
        }

        await PersistActiveQuotationStateAsync();
        ClearQuotation();
    }

    private void EditQuotation(Guid id)
    {

        if (!CanRegisterQuotation)
        {
            return;
        }

        if (!CanQuote)
        {
            return;
        }

        var quote = currentQuotes.FirstOrDefault(x => x.Id == id);

        if (quote is null)
        {
            return;
        }

        editingQuoteId = quote.Id;
        quoteForm.Provider = quote.Provider;
        quoteForm.LineIdText = quote.LineId?.ToString();
        quoteForm.QuotationDate = quote.QuotationDate;
        quoteForm.DeliveryTime = quote.DeliveryTime;
        quoteForm.PriceBeforeVat = quote.PriceBeforeVat;
        quoteForm.AdditionalDetails = quote.AdditionalDetails;
    }

    private async Task RemoveQuotationAsync(Guid id)
    {

        if (!CanRegisterQuotation)
        {
            return;
        }

        if (!CanQuote)
        {
            return;
        }

        currentQuotes.RemoveAll(x => x.Id == id);
        await PersistActiveQuotationStateAsync();
    }

    private async Task PersistActiveQuotationStateAsync()
    {

        if (!CanRegisterQuotation)
        {
            return;
        }

        if (!activeStoredRequestId.HasValue)
        {
            return;
        }

        var item = storedRequests.FirstOrDefault(x => x.Id == activeStoredRequestId.Value);

        if (item is null)
        {
            return;
        }

        item.Status = LocalStatusQuoting;
        item.Header = header.Clone();
        item.Lines = currentLines.Select(x => x.Clone()).ToList();
        item.Quotations = currentQuotes.Select(x => x.Clone()).ToList();
        item.UpdatedAt = DateTime.Now;

        await SaveLocalStateAsync();
    }

    private void ClearQuotation()
    {

        if (!CanRegisterQuotation)
        {
            return;
        }

        editingQuoteId = null;
        quoteForm.Provider = string.Empty;
        quoteForm.LineIdText = string.Empty;
        quoteForm.QuotationDate = null;
        quoteForm.DeliveryTime = string.Empty;
        quoteForm.PriceBeforeVat = null;
        quoteForm.AdditionalDetails = string.Empty;
    }

    private async Task DeleteLocalRequestAsync(Guid id)
    {
        storedRequests.RemoveAll(x => x.Id == id);
        await SaveLocalStateAsync();

        if (activeStoredRequestId == id)
        {
            ClearWorkspace();
        }

        successMessage = "Solicitud local eliminada.";
    }

    private async Task GenerateAsync()
    {

        if (!CanGenerateFinalRequest)
        {
            return;
        }

        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (!CanGenerateRequest)
            {
                errorMessage = "Debes tener la solicitud en cotización y mínimo una cotización seleccionada.";
                return;
            }

            var selectedLines = SelectedLines.ToList();
            var selectedQuotes = SelectedQuotes.ToList();

            if (IsPurchase)
            {
                await GeneratePurchaseAsync(selectedLines, selectedQuotes);
            }
            else
            {
                await GenerateMaintenanceAsync(selectedLines, selectedQuotes);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error generando solicitud: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task GeneratePurchaseAsync(List<RequestLineItem> selectedLines, List<QuotationItem> selectedQuotes)
    {

        if (!CanGenerateFinalRequest)
        {
            return;
        }

        var summary = BuildSummary(selectedLines, selectedQuotes);
        var total = selectedQuotes.Sum(x => x.PriceBeforeVat ?? 0);
        var firstLine = selectedLines.First();

        var request = new CreatePurchaseRequestRequest
        {
            ItemCode = firstLine.TechnicalOrSerial,
            ItemName = string.IsNullOrWhiteSpace(header.RequestName) ? $"SPC - {firstLine.ToolName}" : header.RequestName.Trim(),
            ItemDescription = summary,
            Quantity = selectedLines.Sum(x => x.Quantity),
            Unit = "Und",
            PurchasePurpose = header.RequestType,
            Justification = string.IsNullOrWhiteSpace(header.NeedDescription) ? summary : header.NeedDescription,
            Priority = header.Priority,
            BranchId = TryGuid(header.BranchIdText),
            RequiredAt = header.RequiredAt,
            ProjectId = "SPC-MRO",
            VendorSuggestion = string.Join(" | ", selectedQuotes.Select(x => x.Provider).Distinct()),
            EstimatedCostText = total > 0 ? total.ToString("N0") : null,
            Notes = summary,
            SendToReview = true
        };

        var api = CreateApiClient();
        var response = await api.PostAsJsonAsync("api/purchase-requests", request);

        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadFromJsonAsync<ApiError>();
            errorMessage = error?.Message ?? "No se pudo generar la solicitud de compra.";
            return;
        }

        await RemoveActiveAfterGeneratedAsync();
        successMessage = "Solicitud de compra generada correctamente.";
        await LoadAsync();
    }

    private async Task GenerateMaintenanceAsync(List<RequestLineItem> selectedLines, List<QuotationItem> selectedQuotes)
    {

        if (!CanGenerateFinalRequest)
        {
            return;
        }

        var summary = BuildSummary(selectedLines, selectedQuotes);
        var total = selectedQuotes.Sum(x => x.PriceBeforeVat ?? 0);
        var firstLine = selectedLines.First();

        var request = new CreateMaintenanceRequestRequest
        {
            BranchId = TryGuid(header.BranchIdText),
            RequestType = header.RequestType,
            Priority = header.Priority,
            Title = string.IsNullOrWhiteSpace(header.RequestName) ? $"Mantenimiento - {firstLine.ToolName}" : header.RequestName.Trim(),
            ProblemDescription = summary,
            WorkDescription = header.NeedDescription,
            FailureCause = string.Join(" | ", selectedLines.Select(x => x.Novelty).Where(x => !string.IsNullOrWhiteSpace(x))),
            RequiresStop = selectedLines.Any(x => x.Criticality == "Crítica"),
            IsSafetyRisk = selectedLines.Any(x => x.Criticality == "Crítica"),
            EstimatedCostText = total > 0 ? total.ToString("N0") : null,
            VendorSuggestion = string.Join(" | ", selectedQuotes.Select(x => x.Provider).Distinct()),
            Notes = summary,
            SendToReview = true
        };

        var api = CreateApiClient();
        var response = await api.PostAsJsonAsync("api/maintenance-requests", request);

        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadFromJsonAsync<ApiError>();
            errorMessage = error?.Message ?? "No se pudo generar la solicitud de mantenimiento.";
            return;
        }

        await RemoveActiveAfterGeneratedAsync();
        successMessage = "Solicitud de mantenimiento generada correctamente.";
        await LoadAsync();
    }

    private async Task RemoveActiveAfterGeneratedAsync()
    {

        if (!CanGenerateFinalRequest)
        {
            return;
        }

        if (activeStoredRequestId.HasValue)
        {
            storedRequests.RemoveAll(x => x.Id == activeStoredRequestId.Value);
            await SaveLocalStateAsync();
        }

        ClearWorkspace();
    }

    private string BuildSummary(List<RequestLineItem> lines, List<QuotationItem> quotes)
    {
        var sb = new StringBuilder();

        sb.AppendLine("ENCABEZADO");
        sb.AppendLine($"Solicitud: {Display(header.RequestName)}");
        sb.AppendLine($"Tipo: {Display(header.RequestType)}");
        sb.AppendLine($"Sede: {SelectedBranchLabel}");
        sb.AppendLine($"Solicitante: {Display(header.RequestedBy)}");
        sb.AppendLine($"Responsable aprueba: {Display(header.Approver)}");
        sb.AppendLine($"Prioridad: {Display(header.Priority)}");
        sb.AppendLine($"Fecha requerida: {FormatDate(header.RequiredAt)}");
        sb.AppendLine($"Ubicación/área: {Display(header.Location)}");
        sb.AppendLine($"Necesidad: {Display(header.NeedDescription)}");
        sb.AppendLine();

        sb.AppendLine("HERRAMIENTAS / KIT");
        foreach (var line in lines)
        {
            sb.AppendLine($"- {line.ToolName} | Cantidad: {line.Quantity} | Técnico/Serial: {Display(line.TechnicalOrSerial)} | Criticidad: {Display(line.Criticality)}");
            sb.AppendLine($"  Foto/evidencia: {Display(line.ImageReference)}");
            sb.AppendLine($"  Detalles: {Display(line.Details)}");
            sb.AppendLine($"  Novedades: {Display(line.Novelty)}");
        }

        sb.AppendLine();
        sb.AppendLine("COTIZACIONES");
        foreach (var quote in quotes)
        {
            sb.AppendLine($"- Proveedor: {quote.Provider} | Herramienta: {GetLineName(quote.LineId)} | Fecha: {FormatDate(quote.QuotationDate)} | Entrega: {Display(quote.DeliveryTime)} | Precio sin IVA: {FormatMoney(quote.PriceBeforeVat)}");
            sb.AppendLine($"  Detalles: {Display(quote.AdditionalDetails)}");
        }

        return sb.ToString();
    }

    private void ClearWorkspace()
    {
        activeStoredRequestId = null;
        editingLineId = null;
        editingQuoteId = null;
        currentStatus = "New";
        currentLines = new();
        currentQuotes = new();
        ClearLine();
        ClearQuotation();

        var currentRequester = header.RequestedBy;
        var currentBranch = header.BranchIdText;

        header.Clear();
        ResetHeaderDefaults();

        if (!string.IsNullOrWhiteSpace(currentRequester))
        {
            header.RequestedBy = currentRequester;
        }

        if (!string.IsNullOrWhiteSpace(currentBranch))
        {
            header.BranchIdText = currentBranch;
        }
    }

    private string GetLineName(Guid? id)
    {
        if (!id.HasValue)
        {
            return "Toda la solicitud / kit";
        }

        return currentLines.FirstOrDefault(x => x.Id == id.Value)?.ToolName ?? "Herramienta no encontrada";
    }

    private string BuildLocalNumber(string status, DateTime date)
    {
        var prefix = IsPurchase ? "BOR-COMP" : "BOR-MANT";
        var suffix = status == LocalStatusConfirmed ? "CONF" : "DRAFT";
        return $"{prefix}-{suffix}-{date:yyyyMMddHHmmss}";
    }

    private string GetStoredStatusLabel(string status)
    {
        return status switch
        {
            LocalStatusDraft => "Borrador",
            LocalStatusConfirmed => "Confirmada / pendiente por cotizar",
            LocalStatusQuoting => "Cotizando",
            _ => NaviStatusLabels.ToSpanish(status)
        };
    }

    private string GetStoredStatusClass(string status)
    {
        return status switch
        {
            LocalStatusDraft => "status-pill draft",
            LocalStatusConfirmed => "status-pill confirmed",
            LocalStatusQuoting => "status-pill quoting",
            _ => "status-pill"
        };
    }

    private string GetStoredRowClass(StoredRequest item)
    {
        return item.Status switch
        {
            LocalStatusDraft => "draft-row",
            LocalStatusConfirmed => "confirmed-row",
            LocalStatusQuoting => "quoting-row",
            _ => string.Empty
        };
    }

    private static Guid? TryGuid(string? value)
    {
        return Guid.TryParse(value, out var id) ? id : null;
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "—" : value;
    }

    private static string FormatDate(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "—";
    }

    private static string FormatDateTime(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("dd/MM/yyyy HH:mm") : "—";
    }

    private static string FormatMoney(decimal? value)
    {
        return value.HasValue ? $"${value.Value:N0}" : "—";
    }

    private static string GetStatusLabel(string status)
    {
        return status switch
        {
            "Draft" => "Borrador",
            "InReview" => "En revisión",
            "Approved" => "Aprobado",
            "Scheduled" => "Programado",
            "InExecution" => "En ejecución",
            "Closed" => "Cerrado",
            "Rejected" => "Rechazado",
            "Canceled" => "Cancelado",
            _ => NaviStatusLabels.ToSpanish(status)
        };
    }

    private void HandleAuthSessionChanged()
    {
        if (disposed)
        {
            return;
        }

        /*
         * La sesión ya fue validada por el aplicativo.
         * Solo se actualiza la representación visual.
         */
        if (AuthSession.IsAuthenticated)
        {
            header.RequestedBy =
                string.IsNullOrWhiteSpace(
                    AuthSession.UserName)
                    ? "admin"
                    : AuthSession.UserName;

            if (
                string.IsNullOrWhiteSpace(
                    header.BranchIdText)
                &&
                AuthSession.BranchId.HasValue
            )
            {
                header.BranchIdText =
                    AuthSession.BranchId
                        .Value
                        .ToString();
            }
        }

        _ = InvokeAsync(
            StateHasChanged);
    }

    public void Dispose()
    {
        disposed = true;

        AuthSession.OnChange -=
            HandleAuthSessionChanged;
    }

