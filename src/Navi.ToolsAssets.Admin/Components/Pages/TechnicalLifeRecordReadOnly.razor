        <section class="life-record-section">
            <div class="section-title">
                <span>2</span>
                <h2>Especificaciones técnicas</h2>
            </div>

            <div class="excel-grid two-columns">
                <div><span class="navi-data-label">Voltaje</span><strong>@Show(Text("TechnicalSpecifications", "Voltage"))</strong></div>
                <div><span class="navi-data-label">Capacidad de carga</span><strong>@Show(Text("TechnicalSpecifications", "LoadCapacity"))</strong></div>
                <div><span class="navi-data-label">Proveedor</span><strong>@Show(Text("TechnicalSpecifications", "Provider"))</strong></div>
                <div><span class="navi-data-label">Requiere mantenimiento</span><strong>@BoolText(Text("TechnicalSpecifications", "RequiresMaintenance"))</strong></div>
                <div><span class="navi-data-label">Requiere preoperacional</span><strong>@BoolText(Text("TechnicalSpecifications", "RequiresPreOperationalCheck"))</strong></div>
                <div><span class="navi-data-label">Requiere certificación</span><strong>@BoolText(Text("TechnicalSpecifications", "RequiresCertification"))</strong></div>
                <div><span class="navi-data-label">Vence certificación</span><strong>@ShowDate(Text("TechnicalSpecifications", "CertificationExpirationDate"))</strong></div>
                <div><span class="navi-data-label">Garantía</span><strong>@BoolText(Text("Warranty", "HasWarranty"))</strong></div>
                <div><span class="navi-data-label">Tipo garantía</span><strong>@Show(Text("Warranty", "WarrantyType"))</strong></div>
            </div>
        </section>
    </div>

    <div class="life-record-grid">
        <section class="life-record-section">
            <div class="section-title">
                <span>3</span>
                <h2>Vida útil</h2>
            </div>

            <div class="excel-grid two-columns">
                <div><span class="navi-data-label">Fecha inicial vida útil</span><strong>@ShowDate(Text("UsefulLife", "StartDate"))</strong></div>
                <div><span class="navi-data-label">Fecha final vida útil</span><strong>@ShowDate(Text("UsefulLife", "EndDate"))</strong></div>
                <div><span class="navi-data-label">Vida útil meses</span><strong>@Show(Text("UsefulLife", "UsefulLifeMonths"))</strong></div>
                <div><span class="navi-data-label">Vida útil días</span><strong>@Show(Text("UsefulLife", "UsefulLifeDays"))</strong></div>
                <div><span class="navi-data-label">Días transcurridos</span><strong>@Show(Text("UsefulLife", "ElapsedDays"))</strong></div>
                <div><span class="navi-data-label">Días restantes</span><strong>@Show(Text("UsefulLife", "RemainingDays"))</strong></div>
            </div>

            <div class="life-progress mt-3">
                <div class="life-progress-header">
                    <span>Uso de vida útil</span>
                    <strong>@Show(Text("UsefulLife", "UsedPercentage"))%</strong>
                </div>
                <div class="bar-track">
                    <div class="bar-fill" style="width:@GetPercent(Text("UsefulLife", "UsedPercentage"))%"></div>
                </div>
            </div>
        </section>

        <section class="life-record-section">
            <div class="section-title">
                <span>4</span>
                <h2>Plan de mantenimiento</h2>
            </div>

            <div class="excel-grid two-columns">
                <div><span class="navi-data-label">Último mantenimiento</span><strong>@ShowDate(Text("MaintenancePlan", "LastMaintenanceDate"))</strong></div>
                <div><span class="navi-data-label">Próximo mantenimiento</span><strong>@ShowDate(Text("MaintenancePlan", "NextMaintenanceDate"))</strong></div>
                <div><span class="navi-data-label">Periodicidad meses</span><strong>@Show(Text("MaintenancePlan", "MaintenancePeriodMonths"))</strong></div>
                <div><span class="navi-data-label">Total mantenimientos</span><strong>@Show(Text("MaintenancePlan", "TotalMaintenanceRecords"))</strong></div>
                <div><span class="navi-data-label">Completados</span><strong>@Show(Text("MaintenancePlan", "CompletedMaintenanceRecords"))</strong></div>
                <div><span class="navi-data-label">Pendientes</span><strong>@Show(Text("MaintenancePlan", "PendingMaintenanceRecords"))</strong></div>
            </div>
