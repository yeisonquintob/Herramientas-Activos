    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <!--
        1. Proveedor externo.
        Bootstrap debe cargarse primero para que NAVI pueda
        reemplazar posteriormente sus estilos predeterminados.
    -->
    <link rel="stylesheet"
          href="bootstrap/bootstrap.min.css?v=20260711_13" />

    <!--
        2. Variables centrales.
        Deben estar disponibles antes de todas las hojas NAVI.
    -->
    <link rel="stylesheet"
          href="css/ntx/tokens.css?v=20260719_01" />

    <!--
        3. Normalización general del documento.
    -->
    <link rel="stylesheet"
          href="css/ntx/base.css?v=20260713_05" />

    <!--
        4. Estilos exclusivos del host.
        Actualmente funciona como punto reservado y no debe
        tener prioridad sobre el sistema visual canónico.
    -->
    <link rel="stylesheet"
          href="app.css?v=20260713_05" />
    <link rel="stylesheet" href="css/ntx/theme-admin-cold.css?v=20260713_05" />

    <!--
        5. CSS aislado generado desde archivos .razor.css.
        Se carga antes de las capas canónicas para que los
        componentes generales puedan corregir estilos heredados.
    -->
    <link rel="stylesheet"
          href="Navi.ToolsAssets.Admin.styles.css?v=20260719_01" />

    <!--
        6. Estructura general del Admin Web.
    -->
    <link rel="stylesheet"
          href="css/ntx/layouts-admin.css?v=20260713_05" />

    <!--
        7. Componentes compartidos:
        botones, encabezados, KPI, estados, tablas,
        formularios, tarjetas y alertas.
    -->
    <link rel="stylesheet"
          href="css/ntx/components.css?v=20260713_05" />

    <!--
        8. Utilidades intencionales.
        Deben cargarse al final para resolver ajustes puntuales
        de presentación sin alterar la lógica funcional.
    -->
    <link rel="stylesheet"
          href="css/ntx/utilities.css?v=20260713_05" />

    <link rel="icon"
          type="image/png"
          href="favicon.png" />

    <HeadOutlet />
    <link rel="stylesheet" href="css/ntx/kpi-standard.css?v=20260713_05" />
