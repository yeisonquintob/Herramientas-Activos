@page "/mobile/dashboard"

@using Navi.ToolsAssets.MobilePwa.Models

@inject NaviMobileApiClient Api
@inject MobileAuthSessionService Auth
@inject NavigationManager Navigation

<PageTitle>Dashboard móvil - NAVI Herramientas y AF</PageTitle>

<section class="mobile-page mobile-page-compact navi-mobile-dashboard-v6">

<NaviMobileAppBanner
    Class="mobile-dashboard-header-publisher"
    Pill="INICIO"
    Title="Dashboard móvil"
    Description="Resumen ejecutivo de herramientas y activos."
    HomeUrl="/"
    ShowHomeButton="false"
    ShowBackButton="false" />

    @if (isLoading)
    {
        <div class="mobile-loading" role="status" aria-busy="true">Cargando dashboard móvil...</div>
    }
    else if (!Auth.IsAuthenticated)
    {
        <div class="mobile-empty">
            <strong>Sesión requerida</strong>
            <span>Debes iniciar sesión para consultar el dashboard.</span>
            <button class="mobile-primary-button" type="button" @onclick="GoLogin" data-ntx-tone="ghost" >Ir al login</button>
        </div>
    }
    else if (!CanViewDashboard)
    {
        <div class="mobile-empty">
            <strong>Sin permiso</strong>
            <span>Tu usuario no tiene permiso para visualizar el dashboard móvil.</span>
            <button class="mobile-primary-button" type="button" @onclick="GoHome" data-ntx-tone="secondary" >Volver al inicio</button>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="mobile-alert error">@errorMessage</div>

        <button class="mdash-refresh-full" type="button" @onclick="LoadDashboardAsync" data-ntx-tone="refresh" >
            Reintentar
        </button>
    }
    else if (dashboard is not null)
    {
        <section class="mdash-board navi-mobile-dashboard-v22">


<NaviMobileKpiOverflow PrimaryCount="3"
                       OverflowCount="3"
                       Class="navi-mobile-dashboard-kpi-overflow-home"
                       ButtonLabel="Mostrar indicadores adicionales">
    <PrimaryContent>
        <NaviMobileKpiGrid
            Columns="3"
            Dividers="true"
            Class="navi-mobile-home-kpis-one-line">
            <NaviMobileKpiCard Title="Inventario" Description="Activos visibles" Value="@FormatDashboardNumber(DashboardTotalTools)" IconKey="inventory" Tone="neutral" />
            <NaviMobileKpiCard Title="En uso" Description="Asignadas o prestadas" Value="@FormatDashboardNumber(GetDashboardInUseTotal())" IconKey="transfer" Tone="soft" />
            <NaviMobileKpiCard Title="Disponibles" Description="Para asignación" Value="@FormatDashboardNumber(DashboardAvailableTools)" IconKey="check" Tone="positive" />
        </NaviMobileKpiGrid>
    </PrimaryContent>
    <OverflowContent>
        <NaviMobileKpiGrid
            Columns="3"
            Dividers="true"
            Class="navi-mobile-home-kpis-one-line">
            <NaviMobileKpiCard Title="Mantenimiento" Description="Proceso técnico" Value="@FormatDashboardNumber(DashboardInMaintenanceTools)" IconKey="wrench" Tone="warning" />
            <NaviMobileKpiCard Title="Alertas" Description="Requieren atención" Value="@FormatDashboardNumber(GetDashboardAlertTotal())" IconKey="alert" Tone="danger" />
            <NaviMobileKpiCard Title="Cobertura" Description="Hojas completas" Value="@GetDashboardLifeCompletionPercentLabel()" IconKey="document" Tone="positive" />
        </NaviMobileKpiGrid>
    </OverflowContent>
</NaviMobileKpiOverflow>

            <section class="md22-context">
                <span aria-hidden="true"></span>

                <div>
                    <strong>@GetDashboardScopeTitle()</strong>
                    <small>@GetDashboardScopeDescription()</small>
                </div>

                <time>
                    @FormatDateTime(dashboard.GeneratedAt)
                </time>
            </section>

            <section class="md22-filter-card">
                <label>
                    <span>Sede</span>

                    <select @bind="filterBranchCode" name="navi-mobiledashboard-field-001">
                        <option value="">Todas las sedes</option>

                        @foreach (var branch in DashboardBranchFilterOptions)
                        {
                            <option value="@branch.Code">
                                @GetDashboardBranchOptionLabel(branch)
                            </option>
                        }
                    </select>
                </label>

                <label>
                    <span>Estado operativo</span>

                    <select @bind="filterOperationalStatus" name="navi-mobiledashboard-field-002">
                        <option value="">Todos los estados</option>

                        @foreach (var item in dashboardStatusFilters)
                        {
                            <option value="@item.Value">
                                @item.Text
                            </option>
                        }
                    </select>
                </label>

                <label class="wide">
                    <span>Buscar</span>

                    <div class="md22-search">
                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <circle cx="10.5"
                                    cy="10.5"
                                    r="6.5" />

                            <path d="M15.5 15.5L21 21" />
                        </svg>

                        <input @bind="filterText"
                               @bind:event="oninput"
                               placeholder="Código, serial, activo o responsable..." name="navi-mobiledashboard-field-003" />
                    </div>
                </label>

                <div class="md22-filter-actions">
                    <button type="button"
                            class="primary"
                            disabled="@isRefreshing"
                            @onclick="ApplyDashboardFiltersAsync" data-ntx-tone="operation">
                        Filtrar
                    </button>

                    <button type="button"
                            class="secondary"
                            disabled="@isRefreshing"
                            @onclick="ClearDashboardFiltersAsync" data-ntx-tone="secondary">
                        Limpiar
                    </button>
                </div>
            </section>

            <section class="md22-card md22-branch-card">
                <header class="md22-card-header">
                    <div>
                        <span>INVENTARIO POR SEDE</span>
                        <h2>Herramientas por sede</h2>
                        <p>Total, en uso y disponibles en el alcance actual.</p>
                    </div>

                    <strong>@DashboardToolsByBranch.Count sedes</strong>
                </header>

                @if (!DashboardToolsByBranch.Any())
                {
                    <div class="md22-empty">
                        No hay sedes para los filtros seleccionados.
                    </div>
                }
                else
                {
                    <div class="md22-chart-scroll">
                        <div class="md22-branch-chart">
                            @foreach (var item in DashboardToolsByBranch)
                            {
                                <article class="md22-branch-column">
                                    <div class="md22-branch-bars">
                                        <span class="total"
                                              style="@GetDashboardBranchBarStyle(item.Total)">
                                            <b>@item.Total</b>
                                        </span>

                                        <span class="use"
                                              style="@GetDashboardBranchBarStyle(GetDashboardBranchInUse(item))">
                                            <b>@GetDashboardBranchInUse(item)</b>
                                        </span>

                                        <span class="available"
                                              style="@GetDashboardBranchBarStyle(GetDashboardBranchAvailable(item))">
                                            <b>@GetDashboardBranchAvailable(item)</b>
                                        </span>
                                    </div>

                                    <strong>@item.BranchCode</strong>
                                    <small>@item.BranchName</small>
                                </article>
                            }
                        </div>
                    </div>

                    <div class="md22-chart-legend">
                        <span><i class="total"></i>Total</span>
                        <span><i class="use"></i>En uso</span>
                        <span><i class="available"></i>Disponibles</span>
                    </div>
                }
            </section>

            <section class="md22-ring-grid">
                <article class="md22-card md22-ring-card">
                    <header class="md22-card-header compact">
                        <div>
                            <span>OPERACIÓN</span>
                            <h2>Estado operativo</h2>
                            <p>Distribución del inventario.</p>
                        </div>
                    </header>

                    <div class="md22-ring-layout">
                        <div class="md22-ring"
                             role="img"
                             aria-label="Distribución por estado operativo">

                            <svg viewBox="0 0 100 100"
                                 aria-hidden="true">

                                <circle class="track"
                                        cx="50"
                                        cy="50"
                                        r="42"
                                        pathLength="100">
                                </circle>

                                <circle class="segment use"
                                        cx="50"
                                        cy="50"
                                        r="42"
                                        pathLength="100"
                                        style="@GetDashboardRingSegmentStyle(GetDashboardInUseTotal(), DashboardTotalTools, 0)">
                                </circle>

                                <circle class="segment available"
                                        cx="50"
                                        cy="50"
                                        r="42"
                                        pathLength="100"
                                        style="@GetDashboardRingSegmentStyle(DashboardAvailableTools, DashboardTotalTools, GetDashboardInUseTotal())">
                                </circle>

                                <circle class="segment maintenance"
                                        cx="50"
                                        cy="50"
                                        r="42"
                                        pathLength="100"
                                        style="@GetDashboardRingSegmentStyle(DashboardInMaintenanceTools, DashboardTotalTools, GetDashboardInUseTotal() + DashboardAvailableTools)">
                                </circle>

                                <circle class="segment risk"
                                        cx="50"
                                        cy="50"
                                        r="42"
                                        pathLength="100"
                                        style="@GetDashboardRingSegmentStyle(GetDashboardAlertTotal(), DashboardTotalTools, GetDashboardInUseTotal() + DashboardAvailableTools + DashboardInMaintenanceTools)">
                                </circle>
                            </svg>

                            <div>
                                <strong>@FormatDashboardNumber(DashboardTotalTools)</strong>
                                <span>activos</span>
                            </div>
                        </div>

                        <div class="md22-ring-legend">
                            <div>
                                <i class="use"></i>
                                <span>En uso</span>
                                <strong>@GetDashboardInUseTotal()</strong>
                            </div>

                            <div>
                                <i class="available"></i>
                                <span>Disponibles</span>
                                <strong>@DashboardAvailableTools</strong>
                            </div>

                            <div>
                                <i class="maintenance"></i>
                                <span>Mantenimiento</span>
                                <strong>@DashboardInMaintenanceTools</strong>
                            </div>

                            <div>
                                <i class="risk"></i>
                                <span>Alertas</span>
                                <strong>@GetDashboardAlertTotal()</strong>
                            </div>
                        </div>
                    </div>
                </article>

                <article class="md22-card md22-ring-card">
                    <header class="md22-card-header compact">
                        <div>
                            <span>IDENTIFICACIÓN</span>
                            <h2>Código de activo fijo</h2>
                            <p>Cobertura de identificación.</p>
                        </div>
                    </header>

                    <div class="md22-ring-layout">
                        <div class="md22-ring"
                             role="img"
                             aria-label="Activos con y sin código de activo fijo">

                            <svg viewBox="0 0 100 100"
                                 aria-hidden="true">

                                <circle class="track"
                                        cx="50"
                                        cy="50"
                                        r="42"
                                        pathLength="100">
                                </circle>

                                <circle class="segment identified"
                                        cx="50"
                                        cy="50"
                                        r="42"
                                        pathLength="100"
                                        style="@GetDashboardRingSegmentStyle(DashboardFixedAssets, DashboardTotalTools, 0)">
                                </circle>

                                <circle class="segment unidentified"
                                        cx="50"
                                        cy="50"
                                        r="42"
                                        pathLength="100"
                                        style="@GetDashboardRingSegmentStyle(DashboardToolsWithoutFixedAssetCode, DashboardTotalTools, DashboardFixedAssets)">
                                </circle>
                            </svg>

                            <div>
                                <strong>@GetDashboardFixedAssetPercentLabel()</strong>
                                <span>identificados</span>
                            </div>
                        </div>

                        <div class="md22-ring-legend">
                            <div>
                                <i class="identified"></i>
                                <span>Con código</span>
                                <strong>@DashboardFixedAssets</strong>
                            </div>

                            <div>
                                <i class="unidentified"></i>
                                <span>Sin código</span>
                                <strong>@DashboardToolsWithoutFixedAssetCode</strong>
                            </div>
                        </div>
                    </div>
                </article>

                <article class="md22-card md22-ring-card">
                    <header class="md22-card-header compact">
                        <div>
                            <span>DOCUMENTACIÓN</span>
                            <h2>Hojas de vida</h2>
                            <p>Completas versus incompletas.</p>
                        </div>
                    </header>

                    <div class="md22-ring-layout">
                        <div class="md22-ring"
                             role="img"
                             aria-label="Hojas de vida completas e incompletas">

                            <svg viewBox="0 0 100 100"
                                 aria-hidden="true">

                                <circle class="track"
                                        cx="50"
                                        cy="50"
                                        r="42"
                                        pathLength="100">
                                </circle>

                                <circle class="segment complete"
                                        cx="50"
                                        cy="50"
                                        r="42"
                                        pathLength="100"
                                        style="@GetDashboardRingSegmentStyle(GetDashboardCompleteLifeRecords(), DashboardTotalTools, 0)">
                                </circle>

                                <circle class="segment incomplete"
                                        cx="50"
                                        cy="50"
                                        r="42"
                                        pathLength="100"
                                        style="@GetDashboardRingSegmentStyle(GetDashboardIncompleteLifeRecords(), DashboardTotalTools, GetDashboardCompleteLifeRecords())">
                                </circle>
                            </svg>

                            <div>
                                <strong>@GetDashboardLifeCompletionPercentLabel()</strong>
                                <span>completas</span>
                            </div>
                        </div>

                        <div class="md22-ring-legend">
                            <div>
                                <i class="complete"></i>
                                <span>Completas</span>

                                <strong>
                                    @GetDashboardCompleteLifeRecords()
                                    <small>@GetDashboardPercentLabel(GetDashboardCompleteLifeRecords(), DashboardTotalTools)</small>
                                </strong>
                            </div>

                            <div>
                                <i class="incomplete"></i>
                                <span>Incompletas</span>

                                <strong>
                                    @GetDashboardIncompleteLifeRecords()
                                    <small>@GetDashboardPercentLabel(GetDashboardIncompleteLifeRecords(), DashboardTotalTools)</small>
                                </strong>
                            </div>
                        </div>
                    </div>
                </article>
            </section>

            <section class="md22-card">
                <header class="md22-card-header">
                    <div>
                        <span>CONTROL POR SEDE</span>
                        <h2>Resumen por sede</h2>
                        <p>Inventario y estado operativo por sede.</p>
                    </div>

                    <strong>@DashboardToolsByBranch.Count sedes</strong>
                </header>

                <div class="md22-branch-summary">
                    @foreach (var item in DashboardToolsByBranch)
                    {
                        <article>
                            <header>
                                <strong>@GetDashboardBranchDisplayName(item)</strong>

                                <span>
                                    @GetDashboardBranchPercentLabel(item)
                                </span>
                            </header>

                            <div class="md22-branch-summary-metrics">
                                <div>
                                    <small>Total</small>
                                    <b>@item.Total</b>
                                </div>

                                <div>
                                    <small>En uso</small>
                                    <b>@GetDashboardBranchInUse(item)</b>
                                </div>

                                <div>
                                    <small>Disponibles</small>
                                    <b>@GetDashboardBranchAvailable(item)</b>
                                </div>

                                <div>
                                    <small>Mtto.</small>
                                    <b>@GetDashboardBranchMaintenance(item)</b>
                                </div>

                                <div>
                                    <small>Alertas</small>
                                    <b class="risk">@GetDashboardBranchAlerts(item)</b>
                                </div>
                            </div>

                            <div class="md22-progress-row">
                                <div>
                                    <span style="@GetDashboardBranchProgressStyle(item)"></span>
                                </div>

                                <small>
                                    @GetDashboardBranchInUse(item) de @item.Total en uso
                                </small>
                            </div>
                        </article>
                    }
                </div>
            </section>

            <section class="md22-card md22-maintenance-card">
                <header class="md22-card-header">
                    <div>
                        <span>MANTENIMIENTO</span>
                        <h2>Seguimiento técnico</h2>
                        <p>Actividad y necesidades registradas.</p>
                    </div>
                </header>

                <div class="md22-maintenance-metrics">
                    <article>
                        <span>Hoy</span>
                        <strong>@dashboard.MaintenanceSummary.Today</strong>
                    </article>

                    <article>
                        <span>Este mes</span>
                        <strong>@dashboard.MaintenanceSummary.ThisMonth</strong>
                    </article>

                    <article>
                        <span>Requieren atención</span>
                        <strong>@DashboardRequiresMaintenance</strong>
                    </article>
                </div>

                <div class="md22-maintenance-progress">
                    <span>
                        Inventario en mantenimiento
                    </span>

                    <strong>
                        @GetDashboardPercentLabel(
                            DashboardInMaintenanceTools,
                            DashboardTotalTools)
                    </strong>

                    <div>
                        <b style="@GetDashboardMaintenanceProgressStyle()"></b>
                    </div>
                </div>
            </section>

            <section class="md22-card md22-physical-card">
                <header class="md22-card-header">
                    <div>
                        <span>CONTROL FÍSICO</span>
                        <h2>Toma física</h2>
                        <p>Consulta las campañas y la conciliación.</p>
                    </div>
                </header>

                <div class="md22-physical-actions">
                    <a href="/mobile/physical-counts">
                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M7 4H17V7H20V21H4V7H7Z" />
                            <path d="M7 4V8H17V4" />
                            <path d="M8 13L10.5 15.5L16 10" />
                        </svg>

                        <span>Ver tomas</span>
                    </a>

                    <a href="/mobile/physical-counts">
                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <circle cx="9" cy="9" r="3" />
                            <circle cx="17" cy="10" r="2.5" />
                            <path d="M3.5 20C4 16.5 6 15 9 15C12 15 14 16.5 14.5 20" />
                            <path d="M14 16C15 15.2 16 15 17.2 15C19.3 15 20.5 16.5 20.8 19" />
                        </svg>

                        <span>Participantes</span>
                    </a>

                    <a href="/mobile/reconciliation">
                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M5 7H19" />
                            <path d="M8 4L5 7L8 10" />
                            <path d="M19 17H5" />
                            <path d="M16 14L19 17L16 20" />
                            <path d="M12 9V15" />
                        </svg>

                        <span>Conciliación</span>
                    </a>
                </div>
            </section>

            <section class="md22-card md22-activity-card">
                <header class="md22-card-header">
                    <div>
                        <span>TRAZABILIDAD</span>
                        <h2>Actividad reciente</h2>
                        <p>Últimos movimientos visibles.</p>
                    </div>

                    <strong>
                        @dashboard.RecentActivity.Count eventos
                    </strong>
                </header>

                @if (!dashboard.RecentActivity.Any())
                {
                    <div class="md22-empty">
                        No hay actividad reciente disponible.
                    </div>
                }
                else
                {
                    <div class="md22-activity-list">
                        @foreach (var item in dashboard.RecentActivity
                            .OrderByDescending(x => x.RegisteredAt)
                            .Take(8))
                        {
                            <article>
                                <span class="md22-activity-icon"
                                      aria-hidden="true">

                                    <svg viewBox="0 0 24 24">
                                        <circle cx="12"
                                                cy="12"
                                                r="8" />

                                        <path d="M12 8V12L15 14" />
                                    </svg>
                                </span>

                                <div>
                                    <header>
                                        <strong>@item.Title</strong>

                                        <time>
                                            @FormatDateTime(item.RegisteredAt)
                                        </time>
                                    </header>

                                    <p>@Display(item.Description)</p>

                                    <small>
                                        @Display(item.ToolInternalCode)
                                        ·
                                        @Display(item.User)
                                    </small>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </section>
    }
</section>

@code {
    private bool isLoading = true;

    private bool CanViewDashboard => Auth.HasPermission("Dashboard.View");
    private bool isRefreshing;

    private bool showDashboardSecondaryKpis;
    private string? errorMessage;
    private string? filterBranchCode;
    private string? filterOperationalStatus;
    private string? filterText;
    private MobileExecutiveDashboard? dashboard;

    private readonly (string Value, string Text)[] dashboardStatusFilters =
    {
        ("Available", "Disponible"),
        ("Assigned", "Asignada"),
        ("Loaned", "Prestada"),
        ("InMaintenance", "En mantenimiento"),
        ("Damaged", "Dañada"),
        ("NotSuitable", "No apta"),
        ("PendingValidation", "Pendiente de validación"),
        ("NotLocated", "No localizada"),
        ("Disposed", "Dada de baja")
    };
    private List<MobileToolDto> tools = new();
    private List<DashboardBranchOption> dashboardBranches = new();

    private bool CanViewInventory => Auth.HasPermission("Tools.View");

    // NAVI DASHBOARD LOCAL FILTERED METRICS START
    private List<MobileToolDto> DashboardFilteredTools =>
        FilterByOperationalScope(tools)
            .Where(MatchesDashboardToolFilters)
            .OrderBy(x => x.BranchCode)
            .ThenBy(x => x.InternalCode)
            .ThenBy(x => x.SerialNumber)
            .ToList();
    private List<MobileBranchItem>
        DashboardToolsByBranch
    {
        get
        {
            /*
             * Cuando el inventario detallado ya llegó,
             * se mantiene el cálculo completo existente.
             */
            if (tools.Count > 0)
            {
                return DashboardFilteredTools
                    .GroupBy(tool => new
                    {
                        Code = string.IsNullOrWhiteSpace(
                            tool.BranchCode)
                                ? "-"
                                : tool.BranchCode.Trim(),

                        Name = string.IsNullOrWhiteSpace(
                            tool.BranchName)
                                ? (
                                    string.IsNullOrWhiteSpace(
                                        tool.BranchCode)
                                        ? "-"
                                        : tool.BranchCode.Trim())
                                : tool.BranchName.Trim()
                    })
                    .Select(group =>
                        new MobileBranchItem
                        {
                            BranchCode =
                                group.Key.Code,

                            BranchName =
                                group.Key.Name,

                            Total =
                                group.Count()
                        })
                    .OrderByDescending(item =>
                        item.Total)
                    .ThenBy(item =>
                        item.BranchCode)
                    .ToList();
            }

            /*
             * Durante el primer render se utiliza la
             * agrupación que ya viene en el Dashboard.
             */
            IEnumerable<MobileBranchItem> source =
                dashboard?.ToolsByBranch
                ??
                Enumerable.Empty<MobileBranchItem>();

            if (!string.IsNullOrWhiteSpace(
                    filterBranchCode))
            {
                source = source.Where(item =>
                    ContainsText(
                        item.BranchCode,
                        filterBranchCode)
                    ||
                    ContainsText(
                        item.BranchName,
                        filterBranchCode));
            }

            return source
                .OrderByDescending(item =>
                    item.Total)
                .ThenBy(item =>
                    item.BranchCode)
                .ToList();
        }
    }
    private bool HasDashboardToolDetails =>
        tools.Count > 0;

    private int DashboardTotalTools =>
        HasDashboardToolDetails
            ? DashboardFilteredTools.Count
            : dashboard?.Summary.TotalTools
              ??
              0;

    private int DashboardAvailableTools =>
        HasDashboardToolDetails
            ? CountDashboardStatus("Available")
            : dashboard?.Summary.AvailableTools
              ??
              0;

    private int DashboardAssignedTools =>
        HasDashboardToolDetails
            ? CountDashboardStatus("Assigned")
            : dashboard?.Summary.AssignedTools
              ??
              0;

    private int DashboardLoanedTools =>
        HasDashboardToolDetails
            ? CountDashboardStatus("Loaned")
            : dashboard?.Summary.LoanedTools
              ??
              0;

    private int DashboardInMaintenanceTools =>
        HasDashboardToolDetails
            ? CountDashboardStatus("InMaintenance")
            : dashboard?.Summary.InMaintenanceTools
              ??
              0;

    private int DashboardDamagedTools =>
        HasDashboardToolDetails
            ? CountDashboardStatus("Damaged")
            : dashboard?.Summary.DamagedTools
              ??
              0;

    private int DashboardNotLocatedTools =>
        HasDashboardToolDetails
            ? CountDashboardStatus("NotLocated")
            : dashboard?.Summary.NotLocatedTools
              ??
              0;

    private int DashboardPendingValidationTools =>
        HasDashboardToolDetails
            ? CountDashboardStatus("PendingValidation")
            : dashboard?.Summary.PendingValidationTools
              ??
              0;

    private int DashboardDisposedTools =>
        HasDashboardToolDetails
