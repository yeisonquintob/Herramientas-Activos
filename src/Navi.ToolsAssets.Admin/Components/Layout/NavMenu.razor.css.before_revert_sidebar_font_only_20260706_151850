/* ============================================================
   NAVI SIDEBAR BLANCA COMPACTA FINAL
   FASE 4.22 - 20260706

   Archivo reconstruido para eliminar conflictos anteriores:
   - Sin fondo morado.
   - Sin fondo negro.
   - Menú compacto.
   - Texto visible.
   - Opción activa gris claro.
   - Íconos compactos.
   ============================================================ */

.navi-sidebar-shell {
    width: 100% !important;
    height: 100vh !important;
    max-height: 100vh !important;

    display: flex !important;
    flex-direction: column !important;

    overflow: hidden !important;

    background: #ffffff !important;
    background-color: #ffffff !important;
    background-image: none !important;

    color: #101828 !important;

    border-right: 1px solid #dfe3e8 !important;

    box-shadow: none !important;
}

/* Marca */
.navi-brand {
    min-height: 60px !important;
    height: 60px !important;

    display: flex !important;
    align-items: center !important;

    gap: .54rem !important;

    padding: .50rem .68rem !important;

    background: #ffffff !important;
    background-color: #ffffff !important;
    background-image: none !important;

    border-bottom: 1px solid #eaecf0 !important;

    box-shadow: none !important;
}

.navi-logo {
    width: 34px !important;
    height: 34px !important;
    min-width: 34px !important;

    display: grid !important;
    place-items: center !important;

    border-radius: .68rem !important;

    background: linear-gradient(135deg, #d20a11 0%, #ff3d45 100%) !important;
    color: #ffffff !important;

    font-size: .90rem !important;
    font-weight: 950 !important;

    box-shadow: 0 .25rem .55rem rgba(210, 10, 17, .18) !important;
}

.navi-brand-text {
    min-width: 0 !important;
}

.navi-brand-text strong {
    display: block !important;

    color: #101828 !important;

    font-size: .72rem !important;
    font-weight: 950 !important;
    line-height: 1.05 !important;

    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}

.navi-brand-text span {
    display: block !important;

    margin-top: .05rem !important;

    color: #667085 !important;

    font-size: .55rem !important;
    font-weight: 750 !important;
    line-height: 1.05 !important;

    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}

/* Sesión / usuario */
.nav-auth-required {
    margin: .52rem .55rem .42rem !important;
    padding: .46rem .5rem !important;

    border-radius: .72rem !important;
    border: 1px solid #dfe3e8 !important;

    background: #f8fafc !important;
    color: #344054 !important;
}

.nav-auth-required strong {
    display: block !important;

    color: #101828 !important;

    font-size: .64rem !important;
    font-weight: 900 !important;
}

.nav-auth-required span {
    display: block !important;

    color: #667085 !important;

    font-size: .54rem !important;
    font-weight: 700 !important;
}

.nav-user-card {
    min-height: 44px !important;

    display: grid !important;
    grid-template-columns: 30px minmax(0, 1fr) auto !important;
    align-items: center !important;

    gap: .40rem !important;

    margin: .50rem .55rem .42rem !important;
    padding: .40rem .46rem !important;

    border-radius: .72rem !important;
    border: 1px solid #dfe3e8 !important;

    background: #f8fafc !important;
    background-color: #f8fafc !important;
    background-image: none !important;

    box-shadow: none !important;
}

.nav-user-avatar {
    width: 30px !important;
    height: 30px !important;
    min-width: 30px !important;

    display: grid !important;
    place-items: center !important;

    border-radius: 999px !important;
    border: 1px solid #d0d5dd !important;

    background: #ffffff !important;
    color: #101828 !important;

    font-size: .60rem !important;
    font-weight: 950 !important;
}

.nav-user-info {
    min-width: 0 !important;
}

.nav-user-info strong {
    display: block !important;

    color: #101828 !important;

    font-size: .60rem !important;
    font-weight: 900 !important;
    line-height: 1.05 !important;

    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}

.nav-user-info span {
    display: block !important;

    margin-top: .04rem !important;

    color: #667085 !important;

    font-size: .50rem !important;
    font-weight: 700 !important;
    line-height: 1.05 !important;

    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}

.nav-logout-btn {
    height: 24px !important;
    min-width: 38px !important;

    padding: 0 .38rem !important;

    border-radius: .55rem !important;
    border: 1px solid #d0d5dd !important;

    background: #ffffff !important;
    color: #344054 !important;

    font-size: .54rem !important;
    font-weight: 850 !important;

    box-shadow: none !important;
}

.nav-logout-btn:hover {
    background: #f2f4f7 !important;
    color: #101828 !important;
}

/* Scroll */
.nav-scrollable {
    flex: 1 1 auto !important;
    min-height: 0 !important;

    overflow-y: auto !important;
    overflow-x: hidden !important;

    padding: .05rem .36rem 1.15rem !important;

    background: #ffffff !important;
    background-color: #ffffff !important;
    background-image: none !important;

    scrollbar-width: thin !important;
    scrollbar-color: #cfd6df transparent !important;
}

.nav-scrollable::-webkit-scrollbar {
    width: 6px !important;
}

.nav-scrollable::-webkit-scrollbar-track {
    background: transparent !important;
}

.nav-scrollable::-webkit-scrollbar-thumb {
    border-radius: 999px !important;
    background: #cfd6df !important;
}

.nav-scrollable::-webkit-scrollbar-thumb:hover {
    background: #98a2b3 !important;
}

.nav-menu-list {
    display: flex !important;
    flex-direction: column !important;

    padding-bottom: 1rem !important;
}

/* Secciones */
.nav-section-title {
    margin: .34rem .24rem .14rem !important;

    color: #667085 !important;

    font-size: .52rem !important;
    font-weight: 950 !important;
    line-height: 1 !important;
    letter-spacing: .06rem !important;
    text-transform: uppercase !important;
}

.nav-section-title::after {
    content: "" !important;

    display: block !important;

    width: 20px !important;
    height: 2px !important;

    margin-top: .13rem !important;

    border-radius: 999px !important;

    background: #d0d5dd !important;
    background-color: #d0d5dd !important;
    background-image: none !important;
}

/* Items */
.nav-item {
    margin-bottom: .06rem !important;
}

/* NavLink renderiza <a>, por eso usamos ::deep */
.nav-item ::deep .nav-link {
    position: relative !important;

    min-height: 32px !important;
    height: 32px !important;

    display: flex !important;
    align-items: center !important;

    gap: .44rem !important;

    padding: .34rem .44rem !important;

    border-radius: .60rem !important;
    border: 1px solid transparent !important;

    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;

    color: #344054 !important;
    text-decoration: none !important;

    box-shadow: none !important;
    text-shadow: none !important;
}

.nav-item ::deep .nav-link:hover {
    background: #f2f4f7 !important;
    background-color: #f2f4f7 !important;
    background-image: none !important;

    color: #101828 !important;

    border-color: #eaecf0 !important;

    box-shadow: none !important;
}

.nav-item ::deep .nav-link.active {
    background: #eef2f6 !important;
    background-color: #eef2f6 !important;
    background-image: none !important;

    color: #101828 !important;

    border-color: #cfd6df !important;

    box-shadow: inset 3px 0 0 #101828 !important;
}

/* Íconos */
.nav-icon,
.nav-item ::deep .nav-link .nav-icon {
    width: 18px !important;
    min-width: 18px !important;
    height: 18px !important;

    display: inline-grid !important;
    place-items: center !important;

    border-radius: .42rem !important;
    border: 1px solid #dfe3e8 !important;

    background: #f2f4f7 !important;
    background-color: #f2f4f7 !important;
    background-image: none !important;

    color: #344054 !important;

    font-size: .60rem !important;
    line-height: 1 !important;

    box-shadow: none !important;
}

.nav-item ::deep .nav-link:hover .nav-icon,
.nav-item ::deep .nav-link.active .nav-icon {
    background: #ffffff !important;
    background-color: #ffffff !important;
    background-image: none !important;

    color: #101828 !important;

    border-color: #cfd6df !important;
}

/* Texto */
.nav-text,
.nav-item ::deep .nav-link .nav-text {
    min-width: 0 !important;

    color: inherit !important;

    font-size: .64rem !important;
    font-weight: 850 !important;
    line-height: 1.05 !important;

    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}

/* Eliminar adornos antiguos */
.navi-sidebar-shell::before,
.navi-sidebar-shell::after,
.nav-item ::deep .nav-link::before,
.nav-item ::deep .nav-link::after {
    display: none !important;
    content: none !important;

    background: transparent !important;
    background-image: none !important;
    box-shadow: none !important;
}

/* Responsive */
@media (max-width: 640.98px) {
    .navi-sidebar-shell {
        height: auto !important;
        max-height: none !important;

        border-right: 0 !important;
        border-bottom: 1px solid #dfe3e8 !important;
    }

    .nav-scrollable {
        max-height: none !important;
    }
}





/* NAVI SIDEBAR FONT ONLY START */

/* ============================================================
   SOLO TIPOGRAFÍA SIDEBAR

   Objetivo:
   - Aumentar tamaño de letra.
   - No cambiar tamaño de ningún componente.
   - No tocar alturas, anchos, paddings, márgenes ni layout.
   ============================================================ */


/* Marca superior */
.navi-brand-text strong {
    font-size: calc(.72rem * 1.05) !important;
}

.navi-brand-text span {
    font-size: calc(.55rem * 1.05) !important;
}


/* Títulos de sección */
.nav-section-title {
    font-size: calc(.52rem * 1.05) !important;
}


/* Opciones del menú */
.nav-text,
.nav-item ::deep .nav-link .nav-text {
    font-size: calc(.64rem * 1.05) !important;
}


/* Usuario */
.nav-user-info strong {
    font-size: calc(.60rem * 1.05) !important;
}

.nav-user-info span {
    font-size: calc(.50rem * 1.05) !important;
}


/* Botón salir: solo letra */
.nav-logout-btn {
    font-size: calc(.54rem * 1.05) !important;
}


/* Avatar: solo letra interna */
.nav-avatar,
.nav-user-avatar {
    font-size: calc(.60rem * 1.05) !important;
}


/* Seguridad: no permitir que textos agranden el ancho */
.navi-brand-text strong,
.navi-brand-text span,
.nav-text,
.nav-item ::deep .nav-link .nav-text,
.nav-user-info strong,
.nav-user-info span {
    min-width: 0 !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}

/* NAVI SIDEBAR FONT ONLY END */
