@page "/mobile/history"

@using Navi.ToolsAssets.MobilePwa.Models

@inject NaviMobileApiClient Api
@inject MobileAuthSessionService Auth
@inject NavigationManager Navigation

<PageTitle>Historial de asignaciones - NAVI Herramientas y AF</PageTitle>

<section class="mobile-page mobile-page-compact mobile-assignment-history-v25">

    @*
        El banner publica el título y la descripción en el
        encabezado estándar del MainLayout.

        No se crea un segundo encabezado dentro de la página.
    *@
    <NaviMobileAppBanner
        Class="mobile-history-v25-header-publisher"
        Pill="ACTIVOS FIJOS"
        Title="Historial de asignaciones"
        Description="Consulta préstamos, asignaciones, devoluciones y movimientos según tu alcance."
        HomeUrl="/"
        ShowHomeButton="false"
        ShowBackButton="false" />

    @if (isLoading)
    {
        <section class="mobile-history-v25-loading"
                 aria-live="polite">

            <span aria-hidden="true">

                <svg viewBox="0 0 24 24"
                     focusable="false">

                    <path d="M20 12a8 8 0 1 1-2.35-5.65"></path>
                    <path d="M20 4V10H14"></path>
                </svg>
            </span>

            <div>
                <strong>Cargando historial</strong>

                <small>
                    Consultando movimientos visibles para tu usuario.
                </small>
            </div>
        </section>
    }
    else if (!Auth.IsAuthenticated)
    {
        <section class="mobile-history-v25-empty">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true"
                 focusable="false">

                <path d="M7 11V8A5 5 0 0 1 17 8V11"></path>

                <rect x="5"
                      y="11"
                      width="14"
                      height="10"
                      rx="2">
                </rect>
            </svg>

            <strong>Sesión requerida</strong>

            <span>
                Debes iniciar sesión para consultar el historial.
            </span>

            <button type="button"
                    class="mobile-history-v25-secondary"
                    @onclick="GoLogin" data-ntx-tone="consult">

                Ir al login
            </button>
        </section>
    }
    else if (!CanViewHistory)
    {
        <section class="mobile-history-v25-empty">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true"
                 focusable="false">

                <circle cx="12"
                        cy="12"
                        r="9">
                </circle>

                <path d="M8 8L16 16"></path>
            </svg>

            <strong>Sin permiso</strong>

            <span>
                Tu usuario no tiene permiso para consultar
                el historial de asignaciones.
            </span>

            <button type="button"
                    class="mobile-history-v25-secondary"
                    @onclick="GoHome" data-ntx-tone="secondary">

                Volver al inicio
            </button>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <section class="mobile-history-v25-error"
                 role="alert">

            <strong>No se pudo cargar el historial</strong>

            <span>@errorMessage</span>

            <button type="button"
                    class="mobile-history-v25-secondary"
                    @onclick="LoadAsync" data-ntx-tone="refresh">

                Reintentar
            </button>
        </section>
    }
    else
    {

<NaviMobileKpiOverflow
    PrimaryCount="3"
    OverflowCount="2"
    Class="navi-mobile-kpi-standard-overflow navi-mobile-history-kpi-standard"
    ButtonLabel="Mostrar indicadores adicionales">

    <PrimaryContent>

        <NaviMobileKpiGrid
            Columns="3"
            Compact="true"
            Dividers="true"
            Class="navi-mobile-kpi-standard-grid">

            <NaviMobileKpiCard
                Title="Movimientos"
                Description="Según filtros"
                IconKey="document"
                Tone="neutral">

                <ValueContent>
                    @HistoryMovementCount
                </ValueContent>

            </NaviMobileKpiCard>

            <NaviMobileKpiCard
                Title="En curso"
                Description="Activas"
                IconKey="transfer"
                Tone="soft">

                <ValueContent>
                    @HistoryInProgressCount
                </ValueContent>

            </NaviMobileKpiCard>

            <NaviMobileKpiCard
                Title="Regresos"
                Description="Devueltas"
                IconKey="check"
                Tone="positive">

                <ValueContent>
                    @HistoryReturnedCount
                </ValueContent>

            </NaviMobileKpiCard>

        </NaviMobileKpiGrid>

    </PrimaryContent>

    <OverflowContent>

        <NaviMobileKpiGrid
            Columns="2"
            Compact="true"
            Dividers="true"
            Class="navi-mobile-kpi-standard-grid navi-mobile-history-kpi-overflow-grid">

            <NaviMobileKpiCard
                Title="Sedes"
                Description="En el alcance"
                IconKey="location"
                Tone="warning">

                <ValueContent>
                    @VisibleBranchCount
                </ValueContent>

            </NaviMobileKpiCard>

            <NaviMobileKpiCard
                Title="Responsables"
                Description="Usuarios visibles"
                IconKey="users"
                Tone="neutral">

                <ValueContent>
                    @HistoryResponsibleCount
                </ValueContent>

            </NaviMobileKpiCard>

        </NaviMobileKpiGrid>

    </OverflowContent>

</NaviMobileKpiOverflow>

        <section class="mobile-history-v25-filter-card mobile-history-v27-filters"
                 aria-label="Filtros del historial">

            <div class="mobile-history-v27-filter-title">

                <strong>Filtrar historial</strong>

                <button type="button"
                        class="mobile-history-v27-clear"
                        title="Limpiar filtros"
                        aria-label="Limpiar filtros"
                        @onclick="ClearHistoryFilters" data-ntx-tone="secondary">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">

                        <path d="M5 5L19 19"></path>
                        <path d="M19 5L5 19"></path>
                    </svg>

                    <span>Limpiar</span>
                </button>
            </div>

            <label class="mobile-history-v25-field
                          mobile-history-v25-search
                          mobile-history-v27-search">

                <span>Buscar</span>

                <div>
                    <svg viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">

                        <circle cx="10.5"
                                cy="10.5"
                                r="6.5">
                        </circle>

                        <path d="M15.5 15.5L21 21"></path>
                    </svg>

                    <input id="mobile-history-search"
                           name="mobile-history-search"
                           type="search"
                           autocomplete="off"
                           @bind="searchText"
                           @bind:event="oninput"
                           placeholder="Préstamo, activo, código, usuario o sede..." />
                </div>
            </label>

            <div class="mobile-history-v27-filter-row">

                <label class="mobile-history-v25-field">

                    <span>Responsable</span>

                    <select id="mobile-history-responsible"
                            name="mobile-history-responsible"
                            aria-label="Responsable"
                            @bind="selectedResponsibleId"
                            disabled="@ShouldForceOwnHistory">

                        <option value="">
                            @(ShouldForceOwnHistory
                                ? SelectedResponsibleLabel
                                : "Todos los usuarios")
                        </option>

                        @if (!ShouldForceOwnHistory)
                        {
                            @foreach (var responsible in VisibleResponsibles)
                            {
                                <option value="@responsible.Id">
                                    @responsible.FullName
                                </option>
                            }
                        }
                    </select>
                </label>

                @if (UserCanSeeAllBranches())
                {
                    <label class="mobile-history-v25-field">

                        <span>Sede</span>

                        <select id="mobile-history-branch"
                                name="mobile-history-branch"
                                aria-label="Sede"
                                @bind="selectedBranchCode">

                            <option value="">
                                Todas las sedes
                            </option>

                            @foreach (var branch in BranchOptions)
                            {
                                <option value="@branch.Code">
                                    @branch.Code - @branch.Name
                                </option>
                            }
                        </select>
                    </label>
                }
                else
                {
                    <label class="mobile-history-v25-field">

                        <span>Sede</span>

                        <input id="mobile-history-branch"
                               name="mobile-history-branch"
                               aria-label="Sede asignada"
                               value="@ScopeLabel"
                               disabled />
                    </label>
                }

            </div>

            <label class="mobile-history-v25-field
                          mobile-history-v27-status">

                <span>Estado</span>

                <select id="mobile-history-status"
                        name="mobile-history-status"
                        aria-label="Estado"
                        @bind="SelectedStatusValue">

                    <option value="">
                        Todos (@HistoryBaseFilterCount)
                    </option>

                    @foreach (var status in StatusOptions)
                    {
                        <option value="@status.Value">
                            @status.Text (@CountHistoryStatus(status.Value))
                        </option>
                    }
                </select>
            </label>

        </section>

        <section class="mobile-history-v25-results-header">

            <div>
                <span>TRAZABILIDAD DE ACTIVOS</span>

                <strong>Resultado del historial</strong>

                <small>
                    @ScopeLabel · @SelectedResponsibleLabel
                </small>
            </div>

            <b>@HistoryMovementCount</b>
        </section>

        @if (!FilteredHistory.Any())
        {
            <section class="mobile-history-v25-empty">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true"
                     focusable="false">

                    <path d="M5 4H19V20H5Z"></path>
                    <path d="M8 9H16"></path>
                    <path d="M8 13H13"></path>
                </svg>

                <strong>Sin movimientos</strong>

                <span>
                    No hay historial visible para tu usuario,
                    sede o filtros actuales.
                </span>

                <button type="button"
                        class="mobile-history-v25-secondary"
                        @onclick="ClearHistoryFilters" data-ntx-tone="secondary">

                    Limpiar filtros
                </button>
            </section>
        }
        else
        {
            <section class="mobile-history-v25-list">

                @foreach (var item in FilteredHistory.Take(60))
                {
                    var firstItem =
                        item.Items.FirstOrDefault();

                    var firstTool =
                        GetFirstVisibleTool(item);

                    var branchText =
                        GetRequestBranchText(item);

                    <article class="mobile-history-v25-card">

                        <header class="mobile-history-v25-card-header">

                            <div>
                                <span>@Display(item.LoanNumber)</span>

                                <strong>
                                    @Display(firstItem?.ToolInternalCode)
                                    ·
                                    @Display(firstItem?.ToolName)
                                </strong>

                                <small>
                                    @Display(firstTool?.LocationName)
                                </small>
                            </div>

                            <em class="@GetHistoryV25StatusClass(
                                item.Status)">

                                @GetStatusText(item.Status)
                            </em>
                        </header>

                        <section class="mobile-history-v25-card-grid">

                            <div>
                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true"
                                     focusable="false">

                                    <circle cx="12"
                                            cy="8"
                                            r="3">
                                    </circle>

                                    <path d="M5 20C5.8 15.8 8.2 14 12 14C15.8 14 18.2 15.8 19 20"></path>
                                </svg>

                                <span>
                                    <small>Responsable</small>

                                    <strong>
                                        @Display(GetRequesterName(item))
                                    </strong>
                                </span>
                            </div>

                            <div>
                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true"
                                     focusable="false">

                                    <path d="M12 21S18 15.5 18 10A6 6 0 1 0 6 10C6 15.5 12 21 12 21Z"></path>

                                    <circle cx="12"
                                            cy="10"
                                            r="2">
                                    </circle>
                                </svg>

                                <span>
                                    <small>Sede</small>

                                    <strong>@branchText</strong>
                                </span>
                            </div>

                        </section>

                        <section class="mobile-history-v25-dates">

                            <div>
                                <span>Entrega</span>

                                <strong>
                                    @ShowDate(
                                        GetDeliveryReferenceDate(item))
                                </strong>
                            </div>

                            <div>
                                <span>Regreso</span>

                                <strong>
                                    @ShowDate(item.ReturnedAt)
                                </strong>
                            </div>

                            <div>
                                <span>Movimiento</span>

                                <strong>
                                    @ShowDate(GetMovementDate(item))
                                </strong>
                            </div>

                        </section>

                        @if (item.Items.Count > 1)
                        {
                            <div class="mobile-history-v25-related">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true"
                                     focusable="false">

                                    <path d="M4 7H20V20H4Z"></path>
                                    <path d="M8 7V4H16V7"></path>
                                </svg>

                                <span>
                                    @item.Items.Count activos relacionados
                                </span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                        {
                            <p class="mobile-history-v25-notes">
                                @item.Notes
                            </p>
                        }

                    </article>
                }

            </section>
        }
    }

</section>

@code {
    private bool isLoading = true;
    private string? errorMessage;

    // NAVI MOBILE ASSIGNMENT HISTORY V25 UI START

    private bool showSecondaryKpis;

    private int HistoryMovementCount =>
        FilteredHistory.Count();

    private int HistoryInProgressCount =>
        FilteredHistory.Count(item =>
            !item.ReturnedAt.HasValue
            &&
            (
                string.Equals(
                    item.Status,
                    "Approved",
                    StringComparison.OrdinalIgnoreCase)
                ||
                string.Equals(
                    item.Status,
                    "Delivered",
                    StringComparison.OrdinalIgnoreCase)
            ));

    private int HistoryReturnedCount =>
        FilteredHistory.Count(item =>
            item.ReturnedAt.HasValue
            ||
            string.Equals(
                item.Status,
                "Returned",
                StringComparison.OrdinalIgnoreCase));

    private int HistoryResponsibleCount =>
        FilteredHistory
            .Select(GetRequesterName)
            .Where(value =>
                !string.IsNullOrWhiteSpace(value))
            .Distinct(
                StringComparer.OrdinalIgnoreCase)
            .Count();

    private int HistoryBaseFilterCount =>
        VisibleHistory
            .Where(MatchesResponsibleFilter)
            .Where(MatchesSearchFilter)
            .Count();

    private int CountHistoryStatus(
        string status)
    {
        return VisibleHistory
            .Where(MatchesResponsibleFilter)
            .Where(MatchesSearchFilter)
            .Count(item =>
                string.Equals(
                    item.Status,
                    status,
                    StringComparison.OrdinalIgnoreCase));
    }

    private void ToggleSecondaryKpis()
    {
        showSecondaryKpis =
            !showSecondaryKpis;
    }

    private void CloseSecondaryKpis()
    {
        showSecondaryKpis = false;
    }

    private static DateTime?
        GetDeliveryReferenceDate(
            MobileLoanRequestDto request)
    {
        return request.DeliveredAt
            ?? request.ApprovedAt
            ?? request.RequestedAt
            ?? request.CreatedAt;
    }

    private static string
        GetHistoryV25StatusClass(
            string? status)
    {
        return status switch
        {
            "Requested" =>
                "mobile-history-v25-status is-pending",

            "PendingApproval" =>
                "mobile-history-v25-status is-pending",

            "Approved" =>
                "mobile-history-v25-status is-approved",

            "Delivered" =>
                "mobile-history-v25-status is-delivered",

            "Returned" =>
                "mobile-history-v25-status is-returned",

            "Rejected" =>
                "mobile-history-v25-status is-denied",

            "Denied" =>
                "mobile-history-v25-status is-denied",

            "Cancelled" =>
                "mobile-history-v25-status is-cancelled",

            "Canceled" =>
                "mobile-history-v25-status is-cancelled",

            _ =>
                "mobile-history-v25-status is-neutral"
        };
    }

    // NAVI MOBILE ASSIGNMENT HISTORY V25 UI END


private string searchText = string.Empty;
    private string selectedResponsibleId = string.Empty;
    private string selectedBranchCode = string.Empty;
    private HashSet<string> selectedStatuses = new(StringComparer.OrdinalIgnoreCase);

    private List<MobileAvailabilityToolDto> tools = new();
    private List<MobileLoanRequestDto> loanRequests = new();
    private List<MobileResponsibleDto> responsibles = new();
    private List<MobileBranchDto> branches = new();

    private bool CanViewHistory => Auth.HasPermission("AssetAssignment.History");

    private bool HasAnyHistoryManagementPermission =>
        HasAny(
            "AssetAssignment.Assign",
            "AssetAssignment.Return",
            "AssetAssignment.Approve",
            "AssetAssignment.Deny",
            "AssetAssignment.Manage",
            "AssetAssignment.ViewAll",
            "AssetAssignment.History.All");

    private bool ShouldForceOwnHistory =>
        !UserCanSeeAllBranches() &&
        !HasAnyHistoryManagementPermission;

    private bool ShouldDefaultResponsibleFilter =>
        ShouldForceOwnHistory &&
        Auth.CurrentUser?.ResponsiblePersonId.HasValue == true;

    private string ScopeLabel =>
        UserCanSeeAllBranches()
            ? "Todas las sedes"
            : Display(Auth.CurrentUser?.BranchName ?? Auth.CurrentUser?.BranchCode);

    private string SelectedResponsibleLabel
    {
        get
        {
            if (string.IsNullOrWhiteSpace(selectedResponsibleId))
            {
                return "Todos";
            }

            var selected = responsibles.FirstOrDefault(x =>
                x.Id.ToString().Equals(selectedResponsibleId, StringComparison.OrdinalIgnoreCase));

            return selected?.FullName ?? "Seleccionado";
        }
    }

    private string SelectedStatusValue
    {
        get => selectedStatuses.FirstOrDefault() ?? string.Empty;
        set
        {
            selectedStatuses.Clear();

            if (!string.IsNullOrWhiteSpace(value))
            {
                selectedStatuses.Add(value);
            }
        }
    }

    private readonly (string Value, string Text)[] StatusOptions =
    {
        ("Requested", "Solicitada"),
        ("PendingApproval", "Pendiente"),
        ("Approved", "Aprobada"),
        ("Delivered", "Asignada"),
        ("Returned", "Devuelta"),
        ("Rejected", "Denegada"),
        ("Denied", "Denegada"),
        ("Cancelled", "Cancelada")
    };

    private IEnumerable<MobileResponsibleDto> VisibleResponsibles =>
        responsibles
            .Where(IsVisibleResponsible)
            .OrderBy(x => x.FullName);

    private IEnumerable<MobileBranchDto> BranchOptions =>
        branches
            .Where(IsVisibleBranch)
            .OrderBy(x => x.Code);

    private IEnumerable<MobileAvailabilityToolDto> ScopedTools =>
        tools
            .Where(IsSameBranch)
            .OrderBy(x => x.BranchCode)
            .ThenBy(x => x.InternalCode);

    private IEnumerable<MobileLoanRequestDto> VisibleHistory =>
        loanRequests
            .Where(RequestInVisibleScope)
            .Where(MatchesBranchFilter)
            .OrderByDescending(GetMovementDate);

    private IEnumerable<MobileLoanRequestDto> FilteredHistory =>
        VisibleHistory
            .Where(MatchesResponsibleFilter)
            .Where(MatchesStatusFilter)
            .Where(MatchesSearchFilter)
            .OrderByDescending(GetMovementDate);

    private int VisibleBranchCount =>
        ScopedTools
            .Where(x => !string.IsNullOrWhiteSpace(x.BranchCode))
            .Select(x => Normalize(x.BranchCode))
            .Distinct()
            .Count();

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();

        if (!Auth.IsAuthenticated)
        {
            isLoading = false;
            return;
        }

        var refreshedUser = await Api.RefreshCurrentSessionAsync();

        if (refreshedUser is null || !Auth.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        if (!CanViewHistory)
        {
            isLoading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            errorMessage = null;

            tools = await Api.GetAvailabilityToolsAsync();
            loanRequests = await Api.GetLoanRequestsAsync();
            responsibles = (await Api.GetResponsiblesAsync())
                .OrderBy(x => x.FullName)
                .ToList();

            ApplyDefaultResponsibleFilter();

            branches = (await Api.GetBranchesAsync())
                .OrderBy(x => x.Code)
                .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar el historial móvil: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSearchChanged(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;
    }

    private void OnBranchChanged(ChangeEventArgs args)
    {
        selectedBranchCode = args.Value?.ToString() ?? string.Empty;
    }

    private void OnResponsibleChanged(ChangeEventArgs args)
    {
        selectedResponsibleId = args.Value?.ToString() ?? string.Empty;
    }
    private void ApplyDefaultResponsibleFilter()
    {
        if (!ShouldDefaultResponsibleFilter)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(selectedResponsibleId))
        {
            return;
        }

        if (Auth.CurrentUser?.ResponsiblePersonId is Guid responsibleId)
        {
            selectedResponsibleId = responsibleId.ToString();
        }
    }
    private bool MatchesResponsibleFilter(MobileLoanRequestDto request)
    {
        if (ShouldForceOwnHistory)
        {
            return MatchesCurrentUserHistory(request);
        }

        if (string.IsNullOrWhiteSpace(selectedResponsibleId))
        {
            return true;
        }

        return request.RequestedByPersonId.HasValue &&
               request.RequestedByPersonId.Value.ToString().Equals(selectedResponsibleId, StringComparison.OrdinalIgnoreCase);
    }

    private bool IsVisibleResponsible(MobileResponsibleDto responsible)
    {
        if (UserCanSeeAllBranches())
        {
            return true;
        }

        var visibleResponsibleNames = ScopedTools
            .Select(x => Normalize(x.ResponsiblePersonName))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return visibleResponsibleNames.Count == 0 ||
               visibleResponsibleNames.Contains(Normalize(responsible.FullName)) ||
               Auth.CurrentUser?.ResponsiblePersonId == responsible.Id;
    }

    private void ToggleStatus(string status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return;
        }

        if (!selectedStatuses.Add(status))
        {
            selectedStatuses.Remove(status);
        }
    }

    private void ClearStatusFilter()
    {
        selectedStatuses.Clear();
    }
    private void ClearHistoryFilters()
    {
        searchText = string.Empty;
        selectedBranchCode = string.Empty;
        selectedResponsibleId = string.Empty;
        selectedStatuses.Clear();

        ApplyDefaultResponsibleFilter();
    }

    private bool MatchesStatusFilter(MobileLoanRequestDto request)
    {
        return selectedStatuses.Count == 0 ||
               selectedStatuses.Contains(request.Status ?? string.Empty);
    }

    private bool MatchesSearchFilter(MobileLoanRequestDto request)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return true;
        }

        return ContainsText(request.LoanNumber, searchText) ||
               ContainsText(request.Status, searchText) ||
               ContainsText(GetStatusText(request.Status), searchText) ||
               ContainsText(request.CreatedBy, searchText) ||
               ContainsText(GetRequesterName(request), searchText) ||
               ContainsText(GetRequestBranchText(request), searchText) ||
               request.Items.Any(item =>
                   ContainsText(item.ToolInternalCode, searchText) ||
                   ContainsText(item.ToolName, searchText));
    }
    private bool MatchesCurrentUserHistory(MobileLoanRequestDto request)
    {
        var user = Auth.CurrentUser;

        if (user is null)
        {
            return false;
        }

        if (user.ResponsiblePersonId.HasValue &&
            request.RequestedByPersonId.HasValue &&
            request.RequestedByPersonId.Value == user.ResponsiblePersonId.Value)
        {
            return true;
        }

        return SameNormalized(request.CreatedBy, user.UserName) ||
               SameNormalized(request.CreatedBy, user.DisplayName) ||
               SameNormalized(GetRequesterName(request), user.DisplayName) ||
               SameNormalized(GetRequesterName(request), user.UserName);
    }

    private bool Has(string permission)
    {
        return Auth.HasPermission(permission);
    }

    private bool HasAny(params string[] permissions)
    {
        return permissions.Any(Has);
    }

    private bool MatchesBranchFilter(MobileLoanRequestDto request)
    {
        if (!UserCanSeeAllBranches())
        {
            return true;
        }

        if (string.IsNullOrWhiteSpace(selectedBranchCode))
        {
            return true;
        }

        return request.Items.Any(item =>
        {
            var tool = tools.FirstOrDefault(x => x.Id == item.ToolAssetId);

            return tool is not null &&
                   SameNormalized(tool.BranchCode, selectedBranchCode);
        });
    }
    private bool RequestInVisibleScope(MobileLoanRequestDto request)
    {
        if (UserCanSeeAllBranches())
        {
            return true;
        }

        if (ShouldForceOwnHistory)
        {
            return MatchesCurrentUserHistory(request);
        }

        var visibleIds = ScopedTools.Select(x => x.Id).ToHashSet();

        return request.Items.Any(item => visibleIds.Contains(item.ToolAssetId));
    }

    private MobileAvailabilityToolDto? GetFirstVisibleTool(MobileLoanRequestDto request)
    {
        var visibleIds = ScopedTools.Select(x => x.Id).ToHashSet();
        var firstItem = request.Items.FirstOrDefault(x => visibleIds.Contains(x.ToolAssetId));

        if (firstItem is null)
        {
            return null;
        }

        return tools.FirstOrDefault(x => x.Id == firstItem.ToolAssetId);
    }

    private string GetRequestBranchText(MobileLoanRequestDto request)
    {
        var branchesForRequest = request.Items
            .Select(item => tools.FirstOrDefault(tool => tool.Id == item.ToolAssetId))
            .Where(tool => tool is not null)
            .Select(tool => $"{Display(tool!.BranchCode)} - {Display(tool.BranchName)}")
            .Distinct()
            .ToList();

        return branchesForRequest.Count == 0
            ? ScopeLabel
            : string.Join(", ", branchesForRequest);
    }

    private string GetRequesterName(MobileLoanRequestDto request)
    {
        var responsible = request.RequestedByPersonId.HasValue
            ? responsibles.FirstOrDefault(x => x.Id == request.RequestedByPersonId.Value)
            : null;

        return responsible?.FullName ?? request.CreatedBy ?? "Sin solicitante";
    }

    private DateTime? GetMovementDate(MobileLoanRequestDto request)
    {
        return request.ReturnedAt
            ?? request.DeliveredAt
            ?? request.ApprovedAt
            ?? request.RequestedAt
            ?? request.CreatedAt;
    }
    private bool IsSameBranch(MobileAvailabilityToolDto tool)
    {
        var user = Auth.CurrentUser;

        if (user is null)
        {
            return false;
        }

        if (UserCanSeeAllBranches())
        {
            return true;
        }

        if (user.BranchId.HasValue &&
            tool.BranchId.HasValue &&
            user.BranchId.Value == tool.BranchId.Value)
        {
            return true;
        }

        return SameNormalized(tool.BranchCode, user.BranchCode)
            || SameNormalized(tool.BranchName, user.BranchName)
            || SameNormalized(tool.BranchCode, user.BranchName)
            || SameNormalized(tool.BranchName, user.BranchCode);
    }
    private bool IsVisibleBranch(MobileBranchDto branch)
    {
        var user = Auth.CurrentUser;

        if (user is null)
        {
            return false;
        }

        if (UserCanSeeAllBranches())
        {
            return true;
        }

        if (user.BranchId.HasValue && branch.Id == user.BranchId.Value)
        {
            return true;
        }

        return SameNormalized(branch.Code, user.BranchCode)
            || SameNormalized(branch.Name, user.BranchName)
            || SameNormalized(branch.Code, user.BranchName)
            || SameNormalized(branch.Name, user.BranchCode);
    }

    private bool UserCanSeeAllBranches()
    {
        var user = Auth.CurrentUser;

        if (user is null)
        {
            return false;
        }

        return Auth.IsAdmin()
            || SameNormalized(user.BranchCode, "TODAS")
            || SameNormalized(user.BranchCode, "ALL")
            || SameNormalized(user.BranchName, "Todas las sedes")
            || SameNormalized(user.BranchName, "TODAS")
            || SameNormalized(user.BranchName, "ALL");
    }

