@page "/tools/{ToolId:guid}/technical-life-record-view"
@page "/tools/{ToolId:guid}/life-record-view"

@rendermode InteractiveServer

@using System.Net.Http.Json
@using Navi.ToolsAssets.Admin.Services.Auth
@using Navi.ToolsAssets.Admin.Components.Shared
@using System.Text.Json.Nodes

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject WebAuthSessionService AuthSession
@inject IConfiguration Configuration

<PageTitle>Consulta hoja de vida técnica - NAVI Herramientas</PageTitle>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @errorMessage
    </div>
}
else if (isLoading && record is null)
{
    <div class="alert alert-info" role="status" aria-busy="true">
        Cargando consulta de hoja de vida técnica...
    </div>
}
else if (record is not null)
{
@* NAVI TECHNICAL LIFE RECORD READONLY WEB V41 START *@

    <section class="readonly-life-record-v41-header">

        <NaviPageHero
            Pill="ACTIVOS FIJOS"
            Title='@Show(Text("Summary", "Name"))'
            Description="Formato técnico del activo fijo con datos generales, accesorios, documentos, mantenimiento, evidencias, prácticas seguras y trazabilidad.">

        </NaviPageHero>

        <section class="readonly-life-record-v41-toolbar">

            <NaviKpiGrid
                Columns="3"
                Compact="true"
                Dividers="true"
                Class="readonly-life-record-v41-kpis">

                <NaviKpiCard
                    Title="Código interno"
                    Description="Activo fijo"
                    Tone="neutral">

                    <IconContent>
                        <NaviKpiIcon Name="inventory" />
                    </IconContent>

                    <ValueContent>
                        @Show(
                            Text(
                                "Summary",
                                "InternalCode"))
                    </ValueContent>

                </NaviKpiCard>

                <NaviKpiCard
                    Title="Estado operativo"
                    Description="Control actual"
                    Tone="warning">

                    <IconContent>
                        <NaviKpiIcon Name="transfer" />
                    </IconContent>

                    <ValueContent>
                        @GetStatusLabel(
                            Text(
                                "Summary",
                                "OperationalStatus"))
                    </ValueContent>

                </NaviKpiCard>

                <NaviKpiCard
                    Title="Clasificación"
                    Description="Tipo de activo"
                    Tone="soft">

                    <IconContent>
                        <NaviKpiIcon Name="document" />
                    </IconContent>

                    <ValueContent>
                        @(BoolValue(
                            "Summary",
                            "IsSpecialized")
                                ? "Especializada"
                                : "No especializada")
                    </ValueContent>

                </NaviKpiCard>

            </NaviKpiGrid>

            <div class="readonly-life-record-v41-actions">

                <button
                    type="button"
                    class="readonly-life-record-v41-back"
                    @onclick="GoBack"
                    data-ntx-tone="secondary">

                    <svg
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                        focusable="false">

                        <path d="M19 12H5"></path>
                        <path d="M11 6L5 12L11 18"></path>

                    </svg>

                    <span>Volver al detalle</span>

                </button>

                <NaviRefreshButton
                    Class="readonly-life-record-v41-refresh"
                    OnClick="LoadAsync"
                    Loading="@isLoading"
                    Title="Actualizar hoja de vida"
                    AriaLabel="Actualizar hoja de vida" />

            </div>

        </section>

    </section>

@* NAVI TECHNICAL LIFE RECORD READONLY WEB V41 END *@

<section class="life-readonly-note">
        <strong>Modo solo lectura.</strong>
        Esta consulta no permite editar datos técnicos, accesorios, documentos, mantenimientos ni prácticas seguras.
    </section>

    <section class="@GetMaintenanceAlertClass()">
        <div>
            <span>Estado de mantenimiento</span>
            <strong>@GetMaintenanceAlertTitle()</strong>
            <p>@GetMaintenanceAlertDescription()</p>
        </div>

        <div class="maintenance-alert-grid">
            <div>
                <span>Último mantenimiento</span>
                <strong>@ShowDate(Text("MaintenancePlan", "LastMaintenanceDate"))</strong>
            </div>

            <div>
                <span>Próximo mantenimiento</span>
                <strong>@ShowDate(Text("MaintenancePlan", "NextMaintenanceDate"))</strong>
            </div>

            <div>
                <span>Días restantes</span>
                <strong>@GetMaintenanceDaysText()</strong>
            </div>
        </div>
    </section>

    <div class="life-record-grid">
        <section class="life-record-section">
            <div class="section-title">
                <span>1</span>
                <h2>Información del equipo</h2>
            </div>

            <div class="excel-grid two-columns">
                <div><span class="navi-data-label">Código interno</span><strong>@Show(Text("EquipmentInformation", "InternalCode"))</strong></div>
                <div><span class="navi-data-label">Nombre</span><strong>@Show(Text("EquipmentInformation", "Name"))</strong></div>
                <div><span class="navi-data-label">Marca</span><strong>@Show(Text("EquipmentInformation", "Brand"))</strong></div>
                <div><span class="navi-data-label">Modelo</span><strong>@Show(Text("EquipmentInformation", "Model"))</strong></div>
                <div><span class="navi-data-label">Serial</span><strong>@Show(Text("EquipmentInformation", "SerialNumber"))</strong></div>
                <div><span class="navi-data-label">Activo fijo</span><strong>@Show(Text("EquipmentInformation", "FixedAssetCode"))</strong></div>
                <div><span class="navi-data-label">Código Fenix365</span><strong>@Show(Text("EquipmentInformation", "FenixCode"))</strong></div>
                <div><span class="navi-data-label">Fecha adquisición</span><strong>@ShowDate(Text("EquipmentInformation", "AcquisitionDate"))</strong></div>
                <div><span class="navi-data-label">Zona</span><strong>@Join(Text("EquipmentInformation", "ZoneCode"), Text("EquipmentInformation", "ZoneName"))</strong></div>
                <div><span class="navi-data-label">Sede</span><strong>@Join(Text("EquipmentInformation", "BranchCode"), Text("EquipmentInformation", "BranchName"))</strong></div>
