@implements IDisposable

@using System.Collections.Generic
@using Microsoft.AspNetCore.Components
@using Navi.ToolsAssets.Admin.Services.Ui

@inject NaviAdminPageHeaderState PageHeader

@if (HeaderContent is not null ||
     Actions is not null ||
     ChildContent is not null)
{
    <section @attributes="AdditionalAttributes"
             class="@CssClass"
             aria-label="Acciones de la página">
        @if (HeaderContent is not null)
        {
            <div class="navi-page-actions-bar__extra">
                @HeaderContent
            </div>
        }

        @if (Actions is not null ||
             ChildContent is not null)
        {
            <div class="navi-page-actions-bar__actions">
                @if (Actions is not null)
                {
                    @Actions
                }
                else
                {
                    @ChildContent
                }
            </div>
        }
    </section>
}

@code {
    private readonly Guid ownerId = Guid.NewGuid();

    [Parameter]
    public string? Pill { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>?
        AdditionalAttributes { get; set; }

    protected override void OnParametersSet()
    {
        PageHeader.Set(
            ownerId,
            Title,
            Description);
    }

    private string CssClass
    {
        get
        {
            const string baseClass =
                "navi-page-actions-bar";

            return string.IsNullOrWhiteSpace(Class)
                ? baseClass
                : $"{baseClass} {Class.Trim()}";
        }
    }

    public void Dispose()
    {
        PageHeader.Clear(ownerId);
    }
}
