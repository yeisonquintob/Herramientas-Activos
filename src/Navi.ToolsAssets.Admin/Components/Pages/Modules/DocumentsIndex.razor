@page "/documents"
@rendermode InteractiveServer
@inherits DocumentsIndexBase

@using Microsoft.AspNetCore.Components.Forms
@using Navi.ToolsAssets.Admin.Components.Shared

<PageTitle>Documentos - NAVI</PageTitle>

@* NAVI V196-CORR2 - KPI DOCUMENTOS CANONICO *@
<NaviPageHero
    Pill="DOCUMENTOS"
    Title="Gestión documental"
    Description="Consulta, carga y descarga documentos reales asociados a herramientas, activos y procesos de toma física existentes en NAVI." />

<NaviKpiToolbar
    Class="docs-kpi-standard-toolbar"
    Refresh="LoadAsync"
    IsRefreshing="isLoading"
    RefreshTitle="Actualizar gestión documental"
    RefreshAriaLabel="Actualizar indicadores de gestión documental">

    <NaviKpiGrid
        Columns="4"
        Compact="true"
        Dividers="true"
        Class="docs-kpis docs-kpi-standard-grid navi-final-kpi-row">

        <NaviKpiCard
            Title="Total documentos"
            Description="Documentos reales"
            Value="@(documents.Count.ToString())"
            Tone="neutral">

            <IconContent>
                <NaviKpiIcon Name="document" />
            </IconContent>

        </NaviKpiCard>

        <NaviKpiCard
            Title="Activos con soporte"
            Description="Asociados a inventario"
            Value="@(documents.Select(x => x.ToolAssetId).Distinct().Count().ToString())"
            Tone="positive">

            <IconContent>
                <NaviKpiIcon Name="check" />
            </IconContent>

        </NaviKpiCard>

        <NaviKpiCard
            Title="Clasificación actual"
            Description="@selectedCategory"
            Value="@(CountByCategory(selectedCategory).ToString())"
            Tone="warning">

            <IconContent>
                <NaviKpiIcon Name="document" />
            </IconContent>

        </NaviKpiCard>

        <NaviKpiCard
            Title="Inventario"
            Description="Activos disponibles"
            Value="@(assets.Count.ToString())"
            Tone="soft">

            <IconContent>
                <NaviKpiIcon Name="inventory" />
            </IconContent>

        </NaviKpiCard>

    </NaviKpiGrid>

</NaviKpiToolbar>

<section class="docs-workspace">
    <aside class="docs-left-stack">
        <section class="docs-card docs-side-card docs-left-panel docs-classification-card">
            <div class="docs-card-title compact">
                <div>
                    <h3>Clasificación</h3>
                    <p>Define el tipo documental a consultar o cargar.</p>
                </div>
            </div>

            <div class="docs-category-list docs-category-list-standard">
                @foreach (var item in Categories)
                {
                    <button type="button"
                            class="@GetCategoryClass(item.Name)"
                            title="@($"{item.Name}: {CountByCategory(item.Name)} registro(s)")"
                            @onclick="() => SelectCategory(item.Name)" data-ntx-tone="ghost" >
                        <span>@item.Icon</span>
                        <strong>@item.Name</strong>
                        <small>@CountByCategory(item.Name) registro(s)</small>
                    </button>
                }
            </div>
        </section>

        <section class="docs-card docs-side-card docs-manual-panel docs-manual-card">
            <div class="docs-card-title compact manual-title">
                <div>
                    <h3>Manual operativo</h3>
                    <p>Manual operativo detallado por módulo, proceso, permisos, reglas y documentos relacionados.</p>
                </div>
            </div>

            <div class="docs-manual-list docs-manual-list-standard">
                @foreach (var item in ManualOptions)
                {
                    <div class="@GetManualClass(item.Code)">
                        <span>@item.Icon</span>

                        <div>
                            <strong>@item.Title</strong>
                            <small>@item.Module</small>
                        </div>

                        @* NAVI DOCUMENTS MANUAL BUTTON V233.1 *@
                        <button type="button"
                                class="docs-manual-open-v2331"
                                title="@($"Abrir manual operativo: {item.Title}")"
                                aria-label="@($"Abrir manual operativo de {item.Title}")"
                                @onclick="() => OpenManual(item.Code)"
                                data-ntx-tone="consult">

                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">

                                <path d="M4 5.5h5.5A3.5 3.5 0 0 1 13 9v10H7.5A3.5 3.5 0 0 0 4 22V5.5Z"></path>
                                <path d="M20 5.5h-5.5A3.5 3.5 0 0 0 11 9v10h5.5A3.5 3.5 0 0 1 20 22V5.5Z"></path>
                            </svg>

                            <span>Ver manual</span>
                        </button>
                    </div>
                }
            </div>
        </section>
    </aside>

    <main class="docs-main">
        @if (selectedCategory == PhysicalCountCategory)
        {
            <article class="docs-card docs-physical-card">
                <div class="docs-card-title">
                    <div>
                        <h3>Documentación de toma física</h3>
                        <p>Esta clasificación no permite subir documentos. Muestra las tomas físicas reales y sus registros reportados para visualizar o descargar el consolidado.</p>
                    </div>

                    <span class="docs-selected-pill">@selectedCategory</span>
                </div>

                <div class="docs-form-grid physical-selector">
                    <div class="span-2">
                        <label for="navi-documentsindex-control-001">Toma física</label>
                        <select class="form-select" value="@selectedPhysicalCountId" @onchange="OnPhysicalCountSelected" id="navi-documentsindex-control-001">
                            <option value="">Seleccione una toma física</option>

                            @foreach (var count in physicalCounts)
                            {
                                <option value="@count.Id.ToString()">
                                    @count.CountNumber - @Show(count.BranchCode) - @count.StatusLabel
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <NaviKpiGrid
                    Columns="4"
                    Compact="true"
                    Dividers="true"
                    Class="docs-physical-summary">

                    <NaviKpiCard
                        Title="Tomas creadas"
                        Description="Campañas reales"
                        Value="@(physicalCounts.Count.ToString())"
                        Tone="neutral">

                        <IconContent>
                            <NaviKpiIcon Name="calendar" />
                        </IconContent>

                    </NaviKpiCard>

                    <NaviKpiCard
                        Title="Participantes"
                        Description="De la toma seleccionada"
                        Value="@(SelectedBoardSummary.TotalParticipants.ToString())"
                        Tone="soft">

                        <IconContent>
                            <NaviKpiIcon Name="users" />
                        </IconContent>

                    </NaviKpiCard>

                    <NaviKpiCard
                        Title="Reportes"
                        Description="Registros de usuario"
                        Value="@(SelectedReportedSummary.Total.ToString())"
                        Tone="positive">

                        <IconContent>
                            <NaviKpiIcon Name="report" />
                        </IconContent>

                    </NaviKpiCard>

                    <NaviKpiCard
                        Title="Pendientes"
                        Description="Aclarar / crear / conciliar"
                        Value="@(PendingPhysicalDecisions.ToString())"
                        Tone="warning">

                        <IconContent>
                            <NaviKpiIcon Name="clock" />
                        </IconContent>

                    </NaviKpiCard>

                </NaviKpiGrid>

                <div class="docs-physical-actions">
                    <button type="button" @onclick="OpenPhysicalModal" disabled="@(SelectedPhysicalCount is null)" data-ntx-tone="consult" >
                        Visualizar consolidado
                    </button>

                    @if (CanDownloadDocuments)
                    {
                        <a href="@BuildPhysicalCountCsvDataUrl()" download="consolidado-toma-fisica.csv">
                            Descargar consolidado CSV
                        </a>
                    }
                    else
                    {
                        <button type="button" class="docs-disabled-action" disabled data-ntx-tone="consult" >
                            Descargar consolidado CSV
                        </button>
                    }
                </div>

                <div class="docs-table-wrapper">
                    <div class="ntx-table-scroll">
                        <table class="docs-table">
                        <thead>
                            <tr>
                                <th>Toma</th>
                                <th>Sede</th>
                                <th>Estado</th>
                                <th>Fecha inicio</th>
                                <th>Fecha cierre</th>
                                <th>Responsable</th>
                                <th>Inventario</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var row in physicalCounts)
                            {
                                <tr class="@(row.Id.ToString() == selectedPhysicalCountId ? "selected-row" : "")">
                                    <td>
                                        <strong>@row.CountNumber</strong>
                                        <small>@Show(row.Notes)</small>
                                    </td>

                                    <td>
                                        <strong>@Show(row.BranchCode)</strong>
                                        <small>@Show(row.BranchName)</small>
                                    </td>

                                    <td>
                                        <span class="@GetPhysicalStatusClass(row.Status)">
                                            @row.StatusLabel
                                        </span>
                                    </td>

                                    <td>@row.StartedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(row.FinishedAt is null ? "—" : row.FinishedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</td>
                                    <td>@Show(row.ResponsibleBy)</td>

                                    <td>
                                        <strong>Total: @row.TotalItems</strong>
                                        <small>Encontradas: @row.FoundItems</small>
                                        <small>Faltantes: @row.MissingItems</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            </article>

            <article class="docs-card docs-table-card">
                <div class="docs-card-title">
                    <div>
                        <h3>Registros reportados de la toma</h3>
                        <p>Detalle de lo reportado por los usuarios durante la toma física y lo que queda pendiente de aclarar, crear, conciliar o rechazar.</p>
                    </div>

                    <div class="docs-filters one">
                        <input class="form-control"
                               placeholder="Buscar código, nombre, usuario, estado, ubicación..."
                               @bind="physicalSearchText"
                               @bind:event="oninput" name="navi-documentsindex-field-001" />
                    </div>
                </div>

                @if (SelectedPhysicalCount is null)
                {
                    <div class="docs-empty">Selecciona una toma física para visualizar sus registros.</div>
                }
                else if (!FilteredReportedItems.Any())
                {
                    <div class="docs-empty">Esta toma física no tiene registros reportados para los filtros seleccionados.</div>
                }
                else
                {
                    <div class="docs-table-wrapper">
                        <div class="ntx-table-scroll">
                            <table class="docs-table">
                            <thead>
                                <tr>
                                    <th>Tipo</th>
                                    <th>Código / nombre</th>
                                    <th>Usuario</th>
                                    <th>Ubicación</th>
                                    <th>Estado conciliación</th>
                                    <th>Datos mínimos</th>
                                    <th>Fecha</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in FilteredReportedItems)
                                {
                                    <tr>
                                        <td>
                                            <span class="docs-type-pill">@Show(item.ReportTypeLabel)</span>
                                            <small>@Show(item.ReportType)</small>
                                        </td>

                                        <td>
                                            <strong>@Show(item.ToolInternalCode)</strong>
                                            <small>@Show(item.ToolName)</small>
                                            <small>@Show(item.ReportedName)</small>
                                        </td>

                                        <td>
                                            <strong>@Show(item.ParticipantName)</strong>
                                            <small>@Show(item.ParticipantUserName)</small>
                                        </td>

                                        <td>
                                            <strong>@Show(item.FoundLocation)</strong>
                                            <small>@Show(item.ExpectedLocation)</small>
                                        </td>

                                        <td>
                                            <span class="@GetReconciliationClass(item)">
                                                @GetReconciliationLabel(item)
                                            </span>
                                        </td>

                                        <td>@(item.HasMinimumData ? "Completos" : "Incompletos")</td>
                                        <td>@item.ReportedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    </div>
                }
            </article>
        }
        else
        {
            <article class="docs-card docs-upload-card">
                <div class="docs-card-title">
                    <div>
                        <h3>Cargar documento</h3>
                        <p>El documento se guarda sobre un activo real del inventario. La clasificación seleccionada define el tipo documental.</p>
                    </div>

                    <span class="docs-selected-pill">@selectedCategory</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <div class="@messageClass docs-inline-message">@message</div>
                }

                <div class="docs-form-grid">
                    <div>
                        <label for="navi-documentsindex-control-002">Clasificación</label>
                        <input class="form-control" value="@selectedCategory" readonly id="navi-documentsindex-control-002" />
                    </div>

                    <div>
                        <label for="navi-documentsindex-control-003">Activo / herramienta existente</label>
                        <input class="form-control"
                               list="docs-assets-list"
                               placeholder="Escribe código, nombre, serial, sede o responsable"
                               @bind="assetSearchText"
                               @bind:event="oninput" id="navi-documentsindex-control-003" />

                        <datalist id="docs-assets-list">
                            @foreach (var asset in FilteredAssets)
                            {
                                <option value="@FormatAssetOption(asset)"></option>
                            }
                        </datalist>

                        <small class="@GetAssetHintClass()">@GetAssetHint()</small>
                    </div>

                    <div>
                        <label for="navi-documentsindex-control-004">Nombre del documento</label>
                        <input class="form-control"
                               placeholder="Ej: factura compra kit scanner"
                               @bind="documentName" id="navi-documentsindex-control-004" />
                    </div>

                    <div>
                        <label for="navi-documentsindex-control-005">Responsable de carga</label>
                        <input class="form-control"
                               placeholder="Usuario que carga el documento"
                               @bind="uploadedBy" id="navi-documentsindex-control-005" />
                    </div>

                    <div class="span-2">
                        <label for="navi-documentsindex-control-006">Archivo</label>
                        <InputFile class="form-control" OnChange="OnFileSelected" id="navi-documentsindex-control-006" />
                        <small class="docs-asset-hint ok">@(selectedFile is null ? "Seleccione PDF, imagen, Excel o Word." : $"Archivo seleccionado: {selectedFile.Name}")</small>
                    </div>

                    <div class="span-2">
                        <label for="navi-documentsindex-control-007">Descripción</label>
                        <textarea class="form-control"
                                  rows="3"
                                  placeholder="Detalle del soporte o evidencia cargada"
                                  @bind="description" id="navi-documentsindex-control-007"></textarea>
                    </div>
                </div>

                <div class="docs-actions">
                    <button type="button" @onclick="UploadAsync" disabled="@(!CanSaveDocument || isSaving)" data-ntx-tone="affirmative" >
                        @(isSaving ? "Guardando..." : "Guardar documento")
                    </button>

                    <button type="button" class="secondary" @onclick="ClearForm" disabled="@isSaving" data-ntx-tone="secondary" >
                        Limpiar
                    </button>
                </div>
            </article>

            <article class="docs-card docs-table-card">
                <div class="docs-card-title">
                    <div>
                        <h3>Documentos encontrados</h3>
                        <p>Documentos reales cargados desde hoja de vida, facturas, mantenimiento, actas o garantías del activo.</p>
                    </div>

                    <div class="docs-filters">
                        <input class="form-control"
                               placeholder="Buscar documento, activo, código, responsable..."
                               @bind="documentSearchText"
                               @bind:event="oninput" name="navi-documentsindex-field-002" />

                        <select class="form-select" @bind="selectedToolFilter" name="navi-documentsindex-field-003">
                            <option value="">Todos los activos</option>
                            @foreach (var asset in assets.OrderBy(x => x.InternalCode))
                            {
                                <option value="@asset.Id.ToString()">@asset.InternalCode</option>
                            }
                        </select>
                    </div>
                </div>

                @if (isLoading)
                {
                    <div class="docs-empty" role="status" aria-busy="true">Cargando documentos desde inventario...</div>
                }
                else if (!FilteredDocuments.Any())
                {
                    <div class="docs-empty">No hay documentos para la clasificación o filtros seleccionados.</div>
                }
                else
                {
                    <div class="docs-table-wrapper">
                        <div class="ntx-table-scroll">
                            <table class="docs-table">
                            <thead>
                                <tr>
                                    <th>Documento</th>
                                    <th>Clasificación</th>
                                    <th>Activo / herramienta</th>
                                    <th>Responsable</th>
                                    <th>Fecha</th>
                                    <th>Tamaño</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in FilteredDocuments)
                                {
                                    <tr>
                                        <td>
                                            <strong>@GetDocumentDisplayName(item)</strong>
                                            <small>@item.FileName</small>
                                            <small>@Show(item.Description)</small>
                                        </td>

                                        <td>
                                            <span class="docs-type-pill">@GetDocumentCategory(item)</span>
                                        </td>

                                        <td>
                                            <strong>@item.ToolInternalCode</strong>
                                            <small>@item.ToolName</small>
                                            <small>@Show(item.BranchCode) · @Show(item.ResponsiblePersonName)</small>
                                        </td>

                                        <td>@Show(item.UploadedBy)</td>
                                        <td>@item.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@FormatBytes(item.SizeBytes)</td>

                                        <td>
                                            <div class="docs-row-actions">
                                                <button type="button" class="docs-document-view-button-v238" @onclick="() => OpenDocument(item)" data-ntx-tone="ghost" >
                                                    Ver
                                                </button>

                                                @if (CanDownloadDocuments)
                                                {
                                                    <a href="@BuildDownloadUrl(item.DownloadUrl)" target="_blank">
                                                        Descargar
                                                    </a>
                                                }
                                                else
                                                {
                                                    <button type="button" class="docs-disabled-action" disabled data-ntx-tone="consult" >
                                                        Descargar
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    </div>
                }
            </article>
        }
    </main>
</section>

@if (showPhysicalModal)
{
    <div class="docs-modal-backdrop" @onclick="ClosePhysicalModal">
        <section class="docs-modal docs-document-modal" @onclick:stopPropagation="true">
            <header>
                <div class="docs-modal-title">
                    <span>📦</span>
                    <div>
                        <strong>@(SelectedPhysicalCount?.CountNumber ?? "Consolidado de toma física")</strong>
                        <small>@Show(SelectedPhysicalCount?.BranchCode) · @Show(SelectedPhysicalCount?.StatusLabel)</small>
                    </div>
                </div>

                <button type="button" @onclick="ClosePhysicalModal" data-ntx-tone="affirmative" >Cerrar</button>
            </header>

            <div class="docs-modal-body">
                <article>
                    <h3>Resumen de toma</h3>
                    <p><strong>Toma:</strong> @Show(SelectedPhysicalCount?.CountNumber)</p>
                    <p><strong>Sede:</strong> @Show(SelectedPhysicalCount?.BranchCode) - @Show(SelectedPhysicalCount?.BranchName)</p>
                    <p><strong>Estado:</strong> @Show(SelectedPhysicalCount?.StatusLabel)</p>
                    <p><strong>Responsable:</strong> @Show(SelectedPhysicalCount?.ResponsibleBy)</p>
                </article>

                <article>
                    <h3>Avance</h3>
                    <p><strong>Participantes:</strong> @SelectedBoardSummary.TotalParticipants</p>
                    <p><strong>Esperados:</strong> @SelectedBoardSummary.TotalExpected</p>
                    <p><strong>Contados:</strong> @SelectedBoardSummary.TotalCounted</p>
                    <p><strong>Pendientes:</strong> @SelectedBoardSummary.TotalPending</p>
                </article>

                <article class="span-2">
                    <h3>Registros reportados</h3>

                    <div class="docs-table-wrapper">
                        <div class="ntx-table-scroll">
                            <table class="docs-table">
                            <thead>
                                <tr>
                                    <th>Tipo</th>
                                    <th>Código / nombre</th>
                                    <th>Usuario</th>
                                    <th>Estado</th>
                                    <th>Fecha</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in FilteredReportedItems)
                                {
                                    <tr>
                                        <td>@Show(item.ReportTypeLabel)</td>
                                        <td>
                                            <strong>@Show(item.ToolInternalCode)</strong>
                                            <small>@Show(item.ToolName)</small>
                                            <small>@Show(item.ReportedName)</small>
                                        </td>
                                        <td>@Show(item.ParticipantName)</td>
                                        <td>@GetReconciliationLabel(item)</td>
                                        <td>@item.ReportedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    </div>
                </article>
            </div>
        </section>
    </div>
}

@if (showDocumentModal && selectedDocument is not null)
{
    <div class="docs-modal-backdrop" @onclick="CloseDocument">
        <section class="docs-modal docs-document-modal docs-file-view-modal-v238" @onclick:stopPropagation="true">
            <header>
                <div class="docs-modal-title">
                    <span>📄</span>
                    <div>
                        <strong>@GetDocumentDisplayName(selectedDocument)</strong>
                        <small>@selectedDocument.ToolInternalCode · @GetDocumentCategory(selectedDocument)</small>
                    </div>
                </div>

                <button type="button" @onclick="CloseDocument" data-ntx-tone="ghost" >Cerrar</button>
            </header>

            <div class="docs-modal-body">
                <article>
                    <h3>Información del documento</h3>
                    <p><strong>Archivo:</strong> @selectedDocument.FileName</p>
                    <p><strong>Clasificación:</strong> @GetDocumentCategory(selectedDocument)</p>
                    <p><strong>Tamaño:</strong> @FormatBytes(selectedDocument.SizeBytes)</p>
                    <p><strong>Responsable:</strong> @Show(selectedDocument.UploadedBy)</p>
                    <p><strong>Fecha:</strong> @selectedDocument.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                </article>

                <article>
                    <h3>Activo asociado</h3>
                    <p><strong>Código:</strong> @selectedDocument.ToolInternalCode</p>
                    <p><strong>Nombre:</strong> @selectedDocument.ToolName</p>
                    <p><strong>Sede:</strong> @Show(selectedDocument.BranchCode)</p>
                    <p><strong>Responsable activo:</strong> @Show(selectedDocument.ResponsiblePersonName)</p>
                </article>

                <article class="span-2">
                    <h3>Descripción</h3>
                    <p>@Show(selectedDocument.Description)</p>
                </article>

                <article class="span-2">
                    <h3>Acciones</h3>
                    <div class="docs-modal-actions">
                        @if (CanDownloadDocuments)
                        {
                            <a href="@BuildDownloadUrl(selectedDocument.DownloadUrl)" target="_blank">Descargar documento</a>
                        }
                        else
                        {
                            <button type="button" class="docs-disabled-action" disabled data-ntx-tone="ghost" >Descarga restringida</button>
                        }
                    </div>
                </article>
            </div>
        </section>
    </div>
}

@if (showManualModal)
{
    @* NAVI DOCUMENTS MANUAL IMAGES V232.3 *@

    var manualImageIndexV2323 =
        ManualOptions.FindIndex(
            item =>
                string.Equals(
                    item.Code,
                    SelectedManual.Code,
                    StringComparison.OrdinalIgnoreCase))
        + 1;

    var manualImageNameV2323 =
        manualImageIndexV2323 > 0
            ? $"manual_{manualImageIndexV2323:00}.png"
            : "manual_navi.png";

    var manualImageUrlV2323 =
        $"/manuales_navi_19_imagenes/"
        + manualImageNameV2323;

    <div class="docs-modal-backdrop docs-manual-v2323-backdrop"
         @onclick="CloseManual">

        <section class="docs-modal docs-manual-v2323"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="docs-manual-v2323-title"
                 @onclick:stopPropagation="true">

            <header class="docs-manual-v2323-header">
                <div class="docs-manual-v2323-title">
                    <span aria-hidden="true">
                        @SelectedManual.Icon
                    </span>

                    <div>
                        <strong id="docs-manual-v2323-title">
                            @SelectedManual.Title
                        </strong>

                        <small>
                            @SelectedManual.Module
                        </small>
                    </div>
                </div>

                <button type="button"
                        class="docs-manual-v2323-close"
                        @onclick="CloseManual"
                        data-ntx-tone="ghost">

                    Cerrar
                </button>
            </header>

            <div class="docs-modal-body docs-manual-v2323-body">
                <article>
                    <h3>Descripción general</h3>
                    <p>@SelectedManual.Description</p>
                </article>

                <article>
                    <h3>Objetivo</h3>
                    <p>@SelectedManual.Purpose</p>
                </article>

                <article class="span-2">
                    <h3>Proceso funcional</h3>

                    <ol>
                        @foreach (var step in SelectedManual.Steps)
                        {
                            <li>@step</li>
                        }
                    </ol>
                </article>

                <article class="span-2">
                    <h3>Reglas y validaciones</h3>

                    <ul>
                        @foreach (var rule in SelectedManual.Rules)
                        {
                            <li>@rule</li>
                        }
                    </ul>
                </article>

                <article class="span-2">
                    <h3>Documentos relacionados</h3>

                    <ul>
                        @foreach (
                            var document
                            in SelectedManual.RelatedDocuments)
                        {
                            <li>@document</li>
                        }
                    </ul>
                </article>

                <article class="span-2 docs-manual-v2323-preview">
                    <div class="docs-manual-v2323-preview-header">
                        <div>
                            <h3>Manual visual</h3>

                            <p>
                                Imagen correspondiente a
                                @SelectedManual.Title.
                            </p>
                        </div>

                        <span>PNG</span>
                    </div>

                    <div class="docs-manual-v2323-image">
                        <img src="@manualImageUrlV2323"
                             alt="@SelectedManual.Title"
                             loading="eager"
                             decoding="async" />
                    </div>
                </article>
            </div>

            <footer class="docs-manual-v2323-footer">
                <div>
                    <strong>
                        @SelectedManual.Title
                    </strong>

                    <small>
                        Imagen completa del manual seleccionado.
                    </small>
                </div>

                <a class="docs-manual-v2323-download"
                   href="@manualImageUrlV2323"
                   download="@manualImageNameV2323">

                    Descargar imagen
                </a>
            </footer>
        </section>
    </div>
}

