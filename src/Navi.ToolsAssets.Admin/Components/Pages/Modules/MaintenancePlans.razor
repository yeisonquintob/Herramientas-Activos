@page "/maintenance-plans"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Navi.ToolsAssets.Admin.Components.Security
@using Navi.ToolsAssets.Admin.Components.Shared
@using Navi.ToolsAssets.Admin.Services.Auth
@inject IHttpClientFactory HttpClientFactory
@inject WebAuthSessionService AuthSession

<PageTitle>Planes de Mantenimiento</PageTitle>

<PermissionGuard Permission="MaintenancePlans.View" ModuleName="Planes de Mantenimiento">

<NaviPageHero
    Pill="OPERACIONES"
    Title="Planes de mantenimiento"
    Description="Controla vencimientos, cobertura, solicitudes pendientes, cronograma y relación con solicitudes de mantenimiento.">

    @if (CanRequestMaintenance)
    {
        <a href="/maintenance-request">Solicitar</a>
    }

    <button type="button" @onclick="LoadAsync">
        Actualizar
    </button>

</NaviPageHero>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<section class="plans-kpis plans-kpis-inline plans-kpis-standard">
    <article>
        <span>Total activos</span>
        <strong>@FilteredPlans.Count()</strong>
        <small>Según filtros activos</small>
    </article>

    <article class="success">
        <span>Al día</span>
        <strong>@FilteredPlans.Count(x => x.PlanStatus == "OnTime")</strong>
        <small>Sin vencimiento</small>
    </article>

    <article class="warning">
        <span>Por vencer</span>
        <strong>@FilteredPlans.Count(x => x.PlanStatus == "DueSoon")</strong>
        <small>Próximos 30 días</small>
    </article>

    <article class="danger">
        <span>Vencidos</span>
        <strong>@FilteredPlans.Count(x => x.PlanStatus == "Overdue")</strong>
        <small>Requieren atención</small>
    </article>

    <article class="purple">
        <span>Solicitudes</span>
        <strong>@FilteredPlans.Sum(x => x.PendingRequests)</strong>
        <small>Pendientes abiertas</small>
    </article>

    <article class="info">
        <span>Completados</span>
        <strong>@FilteredPlans.Sum(x => x.CompletedMaintenances)</strong>
        <small>Registros cerrados</small>
    </article>
</section>



<section class="plans-status-filters plans-status-filters-modern" aria-label="Estados de planes de mantenimiento">
    <button type="button"
            class="@GetPlanStatusFilterChipClass(string.Empty)"
            @onclick="@(() => SelectPlanStatus(string.Empty))">
        Todos
        <span>@PlanBaseFilteredPlans.Count()</span>
    </button>

    @foreach (var status in PlanStatusOptions)
    {
        <button type="button"
                class="@GetPlanStatusFilterChipClass(status.Value)"
                @onclick="@(() => SelectPlanStatus(status.Value))">
            @status.Text
            <span>@PlanBaseFilteredPlans.Count(x => x.PlanStatus == status.Value)</span>
        </button>
    }
</section>



<section class="plans-page-filters" aria-label="Filtros de planes de mantenimiento">
    <input class="form-control form-control-sm"
           placeholder="Buscar código, activo, ubicación, responsable, proveedor o técnico..."
           @bind="searchText"
           @bind:event="oninput" />

    <select class="form-select form-select-sm" @bind="selectedBranchCode">
        <option value="">Todas las sedes</option>
        @foreach (var branch in PlanBranchOptions)
        {
            <option value="@branch">@branch</option>
        }
    </select>

    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearPlanFilters">
        Limpiar
    </button>
</section>





<section class="plans-card">
    <div class="plans-card-title">
        <div>
            <h3>Tablero de planes</h3>
            <p>Consulta el cronograma por activo. Las acciones visibles dependen de la matriz de permisos.</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="plans-empty">Cargando planes...</div>
    }
    else if (!FilteredPlans.Any())
    {
        <div class="plans-empty">No hay planes con los filtros aplicados.</div>
    }
    else
    {
        <div class="plans-table-wrapper">
            <table class="plans-table">
                <thead>
                    <tr>
                        <th>Activo</th>
                        <th>Sede / ubicación</th>
                        <th>Responsable</th>
                        <th>Periodicidad</th>
                        <th>Último mantenimiento</th>
                        <th>Próximo mantenimiento</th>
                        <th>Estado</th>
                        <th>Indicadores</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in FilteredPlans)
                    {
                        <tr>
                            <td>
                                <strong>@item.InternalCode</strong>
                                <small>@item.Name</small>
                            </td>

                            <td>
                                <strong>@(item.BranchCode ?? "—")</strong>
                                <small>@(item.LocationName ?? item.BranchName ?? "Sin ubicación")</small>
                            </td>

                            <td>@(item.ResponsibleName ?? "—")</td>

                            <td>
                                <strong>@item.PeriodMonths mes(es)</strong>
                                <small>Periodicidad base</small>
                            </td>

                            <td>
                                <strong>@FormatDate(item.LastMaintenanceAt)</strong>
                                <small>@(item.LastMaintenanceNumber ?? "Sin registro previo")</small>
                                <small>@(item.LastProvider ?? "Sin proveedor")</small>
                            </td>

                            <td>
                                <strong>@FormatDate(item.NextMaintenanceAt)</strong>
                                <small>@GetDaysText(item.DaysRemaining)</small>
                            </td>

                            <td>
                                <span class="@GetPlanClass(item.PlanStatus)">
                                    @GetPlanLabel(item.PlanStatus)
                                </span>
                            </td>

                            <td>
                                <small>Total: @item.TotalMaintenances</small>
                                <small>Completados: @item.CompletedMaintenances</small>
                                <small>Programados: @item.ScheduledMaintenances</small>
                                <small>Solicitudes abiertas: @item.PendingRequests</small>
                            </td>

                            <td>
                                <div class="plans-actions">
    @if (CanOpenLifeRecord)
    {
        <a class="plans-action neutral" href="@($"/tools/{item.ToolAssetId}/technical-life-record")">
            Hoja de vida
        </a>
    }

    @if (CanOpenMaintenanceSchedule)
    {
        <a class="plans-action primary" href="@($"/tools/{item.ToolAssetId}/maintenance-schedule")">
            Cronograma
        </a>
    }

    @if (CanRequestMaintenance)
    {
        <a class="plans-action success" href="/maintenance-request">
            Solicitar
        </a>
    }
</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

</PermissionGuard>

<style>
    .plans-hero {
        margin-bottom: .7rem;
        padding: .92rem 1.05rem;
        border-radius: 1rem;
        background: linear-gradient(105deg, #050507 0%, #07070b 34%, #120017 58%, #350040 78%, #710083 100%);
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        box-shadow: 0 .55rem 1.2rem rgba(75,0,92,.18);
    }

    .plans-pill {
        display: inline-flex;
        padding: .18rem .62rem;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,.35);
        background: rgba(255,255,255,.10);
        font-size: .66rem;
        font-weight: 950;
    }

    .plans-hero h2 {
        margin: .32rem 0 .12rem;
        font-size: 1.35rem;
        font-weight: 950;
    }

    .plans-hero p {
        margin: 0;
        color: rgba(255,255,255,.88);
        font-size: .84rem;
    }

    .plans-hero-actions {
        width: 190px;
        display: grid;
        gap: .42rem;
    }

    .plans-hero-btn {
        width: 190px;
        min-height: 36px;
        border-radius: .6rem;
        border: 1px solid rgba(255,255,255,.70);
        background: rgba(255,255,255,.08);
        color: white;
        font-weight: 950;
        font-size: .76rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }

    .plans-kpis {
        display: grid;
        grid-template-columns: repeat(6, minmax(120px, 1fr));
        gap: .45rem;
        margin-bottom: .65rem;
    }

    .plans-kpis article {
        border: 1px solid #eadff0;
        border-left: 4px solid #0d6efd;
        border-radius: .72rem;
        padding: .52rem;
        background: white;
        box-shadow: 0 .2rem .55rem rgba(75,0,92,.04);
    }

    .plans-kpis article.success { border-left-color: #198754; }
    .plans-kpis article.warning { border-left-color: #ffc107; }
    .plans-kpis article.danger { border-left-color: #dc3545; }
    .plans-kpis article.purple { border-left-color: #7b0d8e; }
    .plans-kpis article.info { border-left-color: #0dcaf0; }

    .plans-kpis span {
        display: block;
        color: #526071;
        font-size: .62rem;
        font-weight: 950;
        text-transform: uppercase;
    }

    .plans-kpis strong {
        display: block;
        color: #06111f;
        font-size: 1.28rem;
        font-weight: 950;
        line-height: 1.05;
    }

    .plans-kpis small {
        color: #657083;
        font-size: .62rem;
        font-weight: 750;
    }

    .plans-board {
        display: grid;
        grid-template-columns: .8fr 1.2fr;
        gap: .65rem;
        margin-bottom: .65rem;
    }

    .plans-card {
        background: white;
        border: 1px solid #eadff0;
        border-radius: .95rem;
        padding: .82rem;
        box-shadow: 0 .28rem .8rem rgba(75,0,92,.04);
    }

    .plans-card-title {
        display: flex;
        justify-content: space-between;
        gap: .8rem;
        align-items: flex-start;
        margin-bottom: .62rem;
    }

    .plans-card-title h3 {
        margin: 0;
        font-size: 1rem;
        font-weight: 950;
        color: #100018;
    }

    .plans-card-title p {
        margin: .1rem 0 0;
        color: #657083;
        font-size: .76rem;
    }

    .plans-donut-row {
        display: grid;
        grid-template-columns: 130px minmax(0, 1fr);
        gap: .75rem;
        align-items: center;
    }

    .plans-donut {
        width: 122px;
        height: 122px;
        border-radius: 50%;
        position: relative;
        display: grid;
        place-items: center;
        box-shadow: inset 0 0 0 1px rgba(75,0,92,.12), 0 .25rem .65rem rgba(75,0,92,.08);
    }

    .plans-donut::after {
        content: "";
        position: absolute;
        inset: 30px;
        border-radius: 50%;
        background: #fff;
        box-shadow: inset 0 0 0 1px #eadff0;
    }

    .plans-donut div {
        position: relative;
        z-index: 1;
        text-align: center;
    }

    .plans-donut strong {
        display: block;
        color: #100018;
        font-size: 1.35rem;
        font-weight: 950;
        line-height: 1;
    }

    .plans-donut span {
        display: block;
        color: #657083;
        font-size: .58rem;
        font-weight: 850;
    }

    .plans-legend {
        display: grid;
        gap: .3rem;
        font-size: .68rem;
    }

    .plans-legend div {
        display: grid;
        grid-template-columns: 9px minmax(0, 1fr) auto auto;
        gap: .32rem;
        align-items: center;
    }

    .plans-legend i {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        display: inline-block;
    }

    .plans-legend .green,
    .green { background: #198754; }

    .plans-legend .orange,
    .orange { background: #ffc107; }

    .plans-legend .red,
    .red { background: #dc3545; }

    .plans-legend span {
        color: #2a1734;
        font-weight: 850;
    }

    .plans-legend strong {
        color: #100018;
        font-weight: 950;
    }

    .plans-legend small {
        min-width: 36px;
        text-align: right;
        color: #657083;
        font-weight: 850;
        font-size: .58rem;
    }

    .plans-focus-list {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: .45rem;
    }

    .plans-focus-list div {
        border: 1px solid #eadff0;
        border-radius: .75rem;
        background: #fbf8ff;
        padding: .55rem;
        min-width: 0;
    }

    .plans-focus-list strong,
    .plans-focus-list small {
        display: block;
        line-height: 1.15;
    }

    .plans-focus-list strong {
        margin-top: .3rem;
        font-size: .76rem;
        font-weight: 950;
        color: #100018;
    }

    .plans-focus-list small {
        color: #657083;
        font-size: .62rem;
        margin-top: .12rem;
        overflow-wrap: anywhere;
    }

    .plans-filters {
        display: grid;
        grid-template-columns: 190px minmax(320px, 1fr);
        gap: .45rem;
        min-width: 560px;
    }

    .plans-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .plans-table {
        width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
        font-size: .72rem;
    }

    .plans-table th {
        border-bottom: 1px solid #17111c;
        padding: .42rem .35rem;
        font-size: .63rem;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .plans-table td {
        border-bottom: 1px solid #e5e8ef;
        padding: .45rem .35rem;
        vertical-align: top;
    }

    .plans-table td strong,
    .plans-table td small {
        display: block;
        line-height: 1.18;
        overflow-wrap: anywhere;
    }

    .plans-table td small {
        color: #657083;
        font-size: .64rem;
        margin-top: .12rem;
    }

    .plan-pill {
        display: inline-flex;
        border-radius: 999px;
        padding: .18rem .42rem;
        font-size: .65rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .plan-pill.ontime { background: #d1e7dd; color: #0f5132; }
    .plan-pill.duesoon { background: #fff3cd; color: #7a5200; }
    .plan-pill.overdue { background: #f8d7da; color: #842029; }

    .plans-actions {
        display: grid;
        gap: .28rem;
    }

    .plans-action {
        width: 100%;
        min-height: 28px;
        border-radius: .48rem;
        padding: .26rem .35rem;
        font-size: .65rem;
        font-weight: 950;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        text-decoration: none;
        background: white;
        cursor: pointer;
        line-height: 1.05;
        text-align: center;
    }

    .plans-action.primary { border-color: #2563eb; color: #1d4ed8; background: #eff6ff; }
    .plans-action.success { border-color: #059669; color: #047857; background: #ecfdf5; }
    .plans-action.neutral { border-color: #64748b; color: #334155; background: #f8fafc; }

    .plans-empty {
        padding: .9rem;
        border-radius: .75rem;
        background: #f8fafc;
        color: #526071;
        font-weight: 850;
    }

    .plans-empty.compact {
        padding: .55rem;
        font-size: .72rem;
    }

    @@media (max-width: 1300px) {
        .plans-board,
        .plans-kpis,
        .plans-focus-list {
            grid-template-columns: 1fr;
        }

        .plans-filters {
            min-width: 0;
            width: 100%;
            grid-template-columns: 1fr;
        }

        .plans-card-title {
            flex-direction: column;
        }

        .plans-table {
            min-width: 1100px;
        }
    }

