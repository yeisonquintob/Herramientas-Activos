@page "/settings/responsibles"
@rendermode InteractiveServer
@using Navi.ToolsAssets.Admin.Services.Auth
@using Navi.ToolsAssets.Admin.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject WebAuthSessionService AuthSession

<PageTitle>Responsables - Configuración</PageTitle>

@* NAVI SETTINGS INTERNAL STANDARD V225.1 *@
@* NAVI RESPONSIBLES TABLE V234 *@
<NaviPageHero
    Pill="CONFIGURACIÓN"
    Title="Responsables"
    Description="Administra técnicos, herramienteros, jefes, coordinadores y responsables asociados a activos." />

<div class="settings-v2251-toolbar">

    <a href="/settings"
       class="settings-v2251-back">
        ← Volver a configuración
    </a>

    @if (CanManageSettings)
    {
        <button type="button"
                class="settings-v2251-new"
                @onclick="OpenSettingsV2251NewModal"
                data-ntx-tone="affirmative">
            + Nuevo responsable
        </button>
    }

    <NaviRefreshButton
        OnClick="LoadAsync"
        Loading="isLoading"
        Title="Actualizar"
        AriaLabel="Actualizar información" />
</div>

@if (!showSettingsV2251Modal &&
     !string.IsNullOrWhiteSpace(message))
{
    <div class="@messageClass"
         role="status">
        @message
    </div>
}

<div class="settings-crud-table settings-v2251-list settings-responsibles-v234-list">
        <div class="settings-table-header">
            <h2>Responsables registrados</h2>

        </div>

        @if (isLoading)
        {
            <p role="status" aria-busy="true">Cargando responsables...</p>
        }
        else
        {
            <div class="ntx-table-scroll">
                <table class="table table-hover align-middle settings-v2251-table settings-responsibles-v234-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Cargo</th>
                        <th>Área</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td><strong>@item.EmployeeCode</strong></td>
                            <td>
                                <div class="settings-responsibles-v234-name">@item.FullName</div>
                                <small class="text-muted settings-responsibles-v234-email">@item.Email</small>
                            </td>
                            <td>@item.Position</td>
                            <td>@item.Area</td>
                            <td>
                                <span class="badge @(item.IsActive ? "navi-bg-affirmative" : "bg-secondary")">
                                    @(item.IsActive ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end">
                                @if (CanManageSettings)
                                    {
                                        <button class="btn btn-sm ntx-btn--operation" @onclick="() => OpenSettingsV2251EditModal(item)" data-ntx-tone="operation" >Editar</button>
                                    }
                                @if (CanManageSettings)
                                    {
                                        <button class="btn btn-sm ntx-btn--danger" @onclick="() => DeleteAsync(item.Id)" data-ntx-tone="danger" >Eliminar</button>
                                    }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>

<NaviModal
    IsOpen="showSettingsV2251Modal"
    Title="@SettingsV2251ModalTitle"
    Description="Registra o actualiza técnicos, herramienteros, coordinadores y responsables."
    OnClose="CloseSettingsV2251Modal"
    Class="settings-v2251-modal">

    <EditForm Model="formModel" OnValidSubmit="SaveAsync" class="settings-v2251-modal-form">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="navi-settingsresponsibles-control-001">Código empleado</label>
                    <InputText class="form-control" @bind-Value="formModel.EmployeeCode"  disabled="@(!CanManageSettings)" id="navi-settingsresponsibles-control-001" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="navi-settingsresponsibles-control-002">Documento</label>
                    <InputText class="form-control" @bind-Value="formModel.DocumentNumber"  disabled="@(!CanManageSettings)" id="navi-settingsresponsibles-control-002" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="navi-settingsresponsibles-control-003">Nombre completo</label>
                    <InputText class="form-control" @bind-Value="formModel.FullName"  disabled="@(!CanManageSettings)" id="navi-settingsresponsibles-control-003" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="navi-settingsresponsibles-control-004">Correo</label>
                    <InputText class="form-control" @bind-Value="formModel.Email"  disabled="@(!CanManageSettings)" id="navi-settingsresponsibles-control-004" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="navi-settingsresponsibles-control-005">Cargo</label>
                    <InputText class="form-control" @bind-Value="formModel.Position"  disabled="@(!CanManageSettings)" id="navi-settingsresponsibles-control-005" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="navi-settingsresponsibles-control-006">Área</label>
                    <InputText class="form-control" @bind-Value="formModel.Area"  disabled="@(!CanManageSettings)" id="navi-settingsresponsibles-control-006" />
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" @bind-Value="formModel.IsActive"  disabled="@(!CanManageSettings)" name="navi-settingsresponsibles-field-001" id="navi-settingsresponsibles-control-007" />
                    <label class="form-check-label" for="navi-settingsresponsibles-control-007">Activo</label>
                </div>

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <div class="@messageClass">@message</div>
                }

                <div class="settings-crud-actions">
                    <button class="btn ntx-btn--operation" type="submit" disabled="@(!CanManageSettings)" data-ntx-tone="affirmative" >Guardar</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearSettingsV2251ModalForm" data-ntx-tone="secondary" >Limpiar</button>

    <button class="btn ntx-btn--danger"
            type="button"
            @onclick="CloseSettingsV2251Modal"
            data-ntx-tone="danger">
        Cerrar
    </button>
    </div>
            </EditForm>
</NaviModal>

@code {

// NAVI SETTINGS INTERNAL STANDARD V225.1
private bool showSettingsV2251Modal;

private string SettingsV2251ModalTitle =>
    editingId is null
        ? "Nuevo responsable"
        : "Editar responsable";

private void OpenSettingsV2251NewModal()
{
    if (!CanManageSettings)
    {
        return;
    }

    ClearForm();
    message = string.Empty;
    showSettingsV2251Modal = true;
}

private void OpenSettingsV2251EditModal(
    ResponsibleDto item)
{
    if (!CanManageSettings)
    {
        return;
    }

    Edit(item);
    message = string.Empty;
    showSettingsV2251Modal = true;
}

private void ClearSettingsV2251ModalForm()
{
    ClearForm();
    message = string.Empty;
}

private void CloseSettingsV2251Modal()
{
    showSettingsV2251Modal = false;
    ClearForm();
    message = string.Empty;
}



    private bool IsAdmin =>
        string.Equals(AuthSession.RoleCode, "ADMIN", StringComparison.OrdinalIgnoreCase)
        || string.Equals(AuthSession.RoleCode, "SUPERADMIN", StringComparison.OrdinalIgnoreCase);

    private bool CanManageSettings => IsAdmin || AuthSession.HasPermission("Settings.Manage");


    private HttpClient Api => HttpClientFactory.CreateClient("NaviApi");

    private List<ResponsibleDto> items = new();
    private ResponsibleFormModel formModel = new();
    private Guid? editingId;
    private bool isLoading;
    private string message = string.Empty;
    private string messageClass = "alert alert-info";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        message = string.Empty;

        try
        {
            items = await Api.GetFromJsonAsync<List<ResponsibleDto>>("api/settings/responsibles") ?? new();
        }
        catch (Exception ex)
        {
            ShowError($"No se pudieron cargar los responsables: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (!CanManageSettings)
        {
            ShowError("No tienes permiso para modificar configuración.");
            return;
        }

        if (string.IsNullOrWhiteSpace(formModel.FullName))
        {
            ShowError("El nombre completo es obligatorio.");
            return;
        }

        var request = new
        {
            employeeCode = formModel.EmployeeCode,
            documentNumber = formModel.DocumentNumber,
            fullName = formModel.FullName,
            email = formModel.Email,
            position = formModel.Position,
            area = formModel.Area,
            isActive = formModel.IsActive,
            changedBy = "admin-web"
        };

        try
        {
            HttpResponseMessage response = editingId is null
                ? await Api.PostAsJsonAsync("api/settings/responsibles", request)
                : await Api.PutAsJsonAsync($"api/settings/responsibles/{editingId}", request);

            if (!response.IsSuccessStatusCode)
            {
                ShowError(await response.Content.ReadAsStringAsync());
                return;
            }

            ShowSuccess(editingId is null ? "Responsable creado correctamente." : "Responsable actualizado correctamente.");
            ClearForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowError($"Error guardando responsable: {ex.Message}");
        }
    }

    private void Edit(ResponsibleDto item)
    {
        if (!CanManageSettings)
        {
            ShowError("No tienes permiso para editar configuración.");
            return;
        }

        editingId = item.Id;

        formModel = new ResponsibleFormModel
        {
            EmployeeCode = item.EmployeeCode,
            DocumentNumber = item.DocumentNumber,
            FullName = item.FullName,
            Email = item.Email,
            Position = item.Position,
            Area = item.Area,
            IsActive = item.IsActive
        };
    }

    private async Task DeleteAsync(Guid id)
    {
        if (!CanManageSettings)
        {
            ShowError("No tienes permiso para eliminar configuración.");
            return;
        }

        try
        {
            var response = await Api.DeleteAsync($"api/settings/responsibles/{id}?changedBy=admin-web");

            if (!response.IsSuccessStatusCode)
            {
                ShowError(await response.Content.ReadAsStringAsync());
                return;
            }

            ShowSuccess("Responsable eliminado correctamente.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowError($"Error eliminando responsable: {ex.Message}");
        }
    }

    private void ClearForm()
    {
        editingId = null;
        formModel = new ResponsibleFormModel();
    }

    private void ShowSuccess(string value)
    {
        message = value;
        messageClass = "alert alert-success";
    }

    private void ShowError(string value)
    {
        message = value;
        messageClass = "alert alert-danger";
    }

    private sealed class ResponsibleDto
    {
        public Guid Id { get; set; }
        public string? EmployeeCode { get; set; }
        public string? DocumentNumber { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string? Position { get; set; }
        public string? Area { get; set; }
        public bool IsActive { get; set; }
    }

    private sealed class ResponsibleFormModel
    {
        public string? EmployeeCode { get; set; }
        public string? DocumentNumber { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string? Position { get; set; }
        public string? Area { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
