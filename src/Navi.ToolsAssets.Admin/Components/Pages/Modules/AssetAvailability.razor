@page "/asset-availability"
@rendermode InteractiveServer

@using Navi.ToolsAssets.Admin.Services.Auth
@using System.Net.Http.Json
@using Navi.ToolsAssets.Admin.Components.Shared

@inject IHttpClientFactory HttpClientFactory
@inject NaviAccessScopeService AccessScope
@inject WebAuthSessionService AuthSession

<PageTitle>Disponible y Ubicación de Herramientas - NAVI</PageTitle>

<PermissionGuard Permission="AssetAvailability.View"
                 ModuleName="Disponible y Ubicación de Herramientas">

    <section class="availability-web-v24">

        <NaviPageHero
            Pill="ACTIVOS FIJOS"
            Title="Disponible y Ubicación de Herramientas"
            Description="Gestiona disponibilidad, sede y ubicación interna de las herramientas." />

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="@messageClass"
                 role="alert">

                @message
            </div>
        }


<NaviKpiToolbar Class="availability-v24-kpi-row"
                Refresh="LoadAsync"
                IsRefreshing="isLoading"
                RefreshTitle="Actualizar disponible y ubicación"
                RefreshAriaLabel="Actualizar disponible y ubicación">
    <NaviKpiGrid Columns="5" Dividers="true" Class="availability-v24-kpis">
        <NaviKpiCard Title="Inventario visible" Description="Herramientas según alcance" Tone="neutral">
            <IconContent><NaviKpiIcon Name="inventory" /></IconContent>
            <ValueContent>@FilteredTools.Count()</ValueContent>
        </NaviKpiCard>
        <NaviKpiCard Title="Disponibles" Description="Listas para operación" Tone="positive">
            <IconContent><NaviKpiIcon Name="check" /></IconContent>
            <ValueContent>
                @FilteredTools.Count(tool => string.Equals(
                    tool.OperationalStatus, "Available", StringComparison.OrdinalIgnoreCase))
            </ValueContent>
        </NaviKpiCard>
        <NaviKpiCard Title="En uso" Description="Asignadas o prestadas" Tone="soft">
            <IconContent><NaviKpiIcon Name="transfer" /></IconContent>
            <ValueContent>
                @FilteredTools.Count(tool =>
                    string.Equals(tool.OperationalStatus, "Assigned", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(tool.OperationalStatus, "Loaned", StringComparison.OrdinalIgnoreCase))
            </ValueContent>
        </NaviKpiCard>
        <NaviKpiCard Title="Mantenimiento" Description="Fuera de operación" Tone="warning">
            <IconContent><NaviKpiIcon Name="wrench" /></IconContent>
            <ValueContent>
                @FilteredTools.Count(tool => string.Equals(
                    tool.OperationalStatus, "InMaintenance", StringComparison.OrdinalIgnoreCase))
            </ValueContent>
        </NaviKpiCard>
        <NaviKpiCard Title="Sin ubicación" Description="Requieren revisión" Tone="danger">
            <IconContent><NaviKpiIcon Name="location" /></IconContent>
            <ValueContent>
                @FilteredTools.Count(tool => string.IsNullOrWhiteSpace(tool.LocationName))
            </ValueContent>
        </NaviKpiCard>
    </NaviKpiGrid>
</NaviKpiToolbar>

        <section class="availability-v24-filter-card"
                 aria-label="Filtros de disponibilidad y ubicación">

            <label class="availability-v24-field
                          availability-v24-search">

                <span>Buscar activo</span>

                <div>
                    <svg viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">

                        <circle cx="10.5"
                                cy="10.5"
                                r="6.5">
                        </circle>

                        <path d="M15.5 15.5L21 21"></path>
                    </svg>

                    <input id="availability-search"
                           name="availability-search"
                           type="search"
                           placeholder="Código, nombre, serial, sede, ubicación o responsable..."
                           @bind="search"
                           @bind:event="oninput" />
                </div>
            </label>

            <label class="availability-v24-field">

                <span>Sede</span>

                <select id="availability-branch-filter"
                        name="availability-branch-filter"
                        class="availability-branch-filter"
                        disabled="@(!AccessScope.IsAllBranchScope())"
                        @bind="selectedBranchCode">

                    <option value="">
                        @(AccessScope.IsAllBranchScope()
                            ? "Todas las sedes visibles"
                            : AccessScope.GetDefaultBranchFilterText())
                    </option>

                    @foreach (var branch in ScopedTools
                        .Select(tool => tool.BranchCode)
                        .Where(branch =>
                            !string.IsNullOrWhiteSpace(branch))
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .OrderBy(branch => branch))
                    {
                        <option value="@branch">
                            @branch
                        </option>
                    }
                </select>
            </label>
</section>

        <section class="availability-v24-status-card"
                 aria-label="Estados de disponibilidad">

            <header>
                <div>
                    <strong>Estado operativo</strong>

                    <small>
                        Selecciona un estado para limitar el listado.
                    </small>
                </div>

                <span>
                    @AvailabilityBaseFilteredTools.Count() registros
                </span>
            </header>

            <div class="availability-v24-status-list">

                <button type="button"
                        class="@GetAvailabilityStatusFilterChipClass(string.Empty)"
                        @onclick="@(() => SelectAvailabilityStatus(string.Empty))"
                        data-ntx-tone="ghost">

                    <i aria-hidden="true"></i>

                    <span>Todos</span>

                    <strong>
                        @AvailabilityBaseFilteredTools.Count()
                    </strong>
                </button>

                @foreach (var option in AvailabilityStatusFilterOptions)
                {
                    <button type="button"
                            class="@GetAvailabilityStatusFilterChipClass(option.Value)"
                            @onclick="@(() => SelectAvailabilityStatus(option.Value))"
                            data-ntx-tone="ghost">

                        <i aria-hidden="true"></i>

                        <span>@option.Label</span>

                        <strong>@option.Count</strong>
                    </button>
                }

            </div>
        </section>

        <section class="availability-v24-workspace">

            <aside class="availability-v24-form-card">

                <header class="availability-v24-form-header">

                    <span>GESTIÓN OPERATIVA</span>

                    <h2>Gestionar ubicación</h2>

                    <p>
                        Selecciona una herramienta y actualiza únicamente
                        los campos autorizados para tu usuario.
                    </p>
                </header>

                @if (SelectedAvailabilityTool is not null)
                {
                    <section class="availability-v24-selected-tool">

                        <div>
                            <span>Activo seleccionado</span>

                            <strong>
                                @SelectedAvailabilityTool.InternalCode
                                ·
                                @SelectedAvailabilityTool.Name
                            </strong>
                        </div>

                        <span class="@GetStatusBadge(
                            SelectedAvailabilityTool.OperationalStatus)">

                            @GetStatusLabel(
                                SelectedAvailabilityTool.OperationalStatus)
                        </span>
                    </section>
                }

                <div class="availability-v24-form-fields">

                    <label class="availability-v24-form-field">

                        <span>Herramienta</span>

                        <input id="availability-tool"
                               name="availability-tool"
                               list="availability-tools-list"
                               value="@toolSearchText"
                               @oninput="OnToolSearchInput"
                               placeholder="Escriba código, nombre o serial..." />

                        <datalist id="availability-tools-list">
                            @foreach (var tool in ScopedTools
                                .OrderBy(tool => tool.InternalCode))
                            {
                                <option value="@FormatToolOption(tool)">
                                </option>
                            }
                        </datalist>

                        <small class="@GetToolSearchHintClass()">
                            @GetToolSearchHint()
                        </small>
                    </label>

                    <label class="availability-v24-form-field">

                        <span>Sede</span>

                        <input id="availability-branch"
                               name="availability-branch"
                               list="availability-branches-list"
                               value="@branchSearchText"
                               @oninput="OnBranchSearchInput"
                               disabled="@(
                                   !CanChangeAvailabilityLocation
                                   ||
                                   !AccessScope.IsAllBranchScope())"
                               placeholder="Escriba código o nombre de sede..." />

                        <datalist id="availability-branches-list">
                            @foreach (var branch in branches
                                .Where(branch =>
                                    AccessScope.IsAllBranchScope()
                                    ||
                                    ScopedTools.Any(tool =>
                                        string.Equals(
                                            tool.BranchCode,
                                            branch.Code,
                                            StringComparison.OrdinalIgnoreCase)))
                                .OrderBy(branch => branch.Code))
                            {
                                <option value="@FormatBranchOption(branch)">
                                </option>
                            }
                        </datalist>

                        <small class="@GetBranchSearchHintClass()">
                            @(AccessScope.IsAllBranchScope()
                                ? GetBranchSearchHint()
                                : "La sede está restringida al alcance actual.")
                        </small>
                    </label>

                    <label class="availability-v24-form-field">

                        <span>Ubicación interna</span>

                        <input id="availability-location"
                               name="availability-location"
                               list="availability-locations-list"
                               value="@locationSearchText"
                               @oninput="OnLocationSearchInput"
                               disabled="@(!CanChangeAvailabilityLocation)"
                               placeholder="Escriba estantería, rack, cajón, bahía o zona..." />

                        <datalist id="availability-locations-list">
                            @foreach (var location in AvailableLocations
                                .OrderBy(location => location.Code))
                            {
                                <option value="@FormatLocationOption(location)">
                                </option>
                            }
                        </datalist>

                        <small class="@GetLocationSearchHintClass()">
                            @GetLocationSearchHint()
                        </small>
                    </label>


                    <label class="availability-v24-form-field">

                        <span>Estado operativo</span>

                        <InputSelect id="availability-status"
                                     class="availability-v24-control"
                                     @bind-Value="form.OperationalStatus"
                                     disabled="@(!CanChangeAvailabilityStatus)">

                            <option value="Available">Disponible</option>
                            <option value="Assigned">Asignada</option>
                            <option value="Loaned">Prestada</option>
                            <option value="InMaintenance">En mantenimiento</option>
                            <option value="Damaged">Dañada</option>
                            <option value="NotSuitable">No apta</option>
                            <option value="PendingValidation">Pendiente validación</option>
                            <option value="NotLocated">No localizada</option>
                            <option value="PendingDisposal">Pendiente baja</option>
                            <option value="Disposed">Dada de baja</option>
                        </InputSelect>
                    </label>

                    <label class="availability-v24-form-field">

                        <span>Observación</span>

                        <InputTextArea id="availability-observation"
                                       class="availability-v24-control"
                                       @bind-Value="form.Observation"
                                       rows="3"
                                       placeholder="Motivo del cambio de ubicación o estado..." />
                    </label>

                </div>

                @if (!CanChangeAvailabilityLocation ||
                     !CanChangeAvailabilityStatus)
                {
                    <div class="availability-permission-note">

                        @if (!CanChangeAvailabilityLocation)
                        {
                            <span>Ubicación bloqueada</span>
                        }

                        @if (!CanChangeAvailabilityStatus)
                        {
                            <span>Estado bloqueado</span>
                        }
                    </div>
                }

                <div class="availability-v24-form-actions">

                    <button type="button"
                            class="availability-v24-save"
                            disabled="@(
                                isSaving
                                ||
                                !CanSaveAvailability
                                ||
                                !form.ToolId.HasValue)"
                            @onclick="SaveAsync"
                            data-ntx-tone="affirmative">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true"
                             focusable="false">

                            <path d="M5 4H17L20 7V20H5Z"></path>
                            <path d="M8 4V10H16V4"></path>
                            <path d="M8 16H17"></path>
                        </svg>

                        <span>
                            @(isSaving
                                ? "Guardando..."
                                : "Guardar cambios")
                        </span>
                    </button>

                    <button type="button"
                            class="availability-v24-clear"
                            disabled="@isSaving"
                            @onclick="ClearForm"
                            data-ntx-tone="secondary">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true"
                             focusable="false">

                            <path d="M5 5L19 19"></path>
                            <path d="M19 5L5 19"></path>
                        </svg>

                        <span>Limpiar</span>
                    </button>
                </div>
            </aside>

            <section class="availability-v24-table-card">

                <header class="availability-v24-table-header">

                    <div>
                        <span>MAESTRO DE DISPONIBILIDAD</span>

                        <h2>Herramientas por disponibilidad</h2>

                        <p>
                            Selecciona Gestionar para cargar la herramienta
                            en el formulario operativo.
                        </p>
                    </div>

                    <div class="availability-v24-result-count">

                        <strong>@FilteredTools.Count()</strong>

                        <small>resultados</small>
                    </div>
                </header>

                @if (isLoading)
                {
                    <section class="availability-v24-loading"
                             aria-live="polite">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true"
                             focusable="false">

                            <path d="M20 12a8 8 0 1 1-2.35-5.65"></path>
                            <path d="M20 4V10H14"></path>
                        </svg>

                        <div>
                            <strong>Cargando herramientas</strong>

                            <span>
                                Consultando disponibilidad y ubicación actual.
                            </span>
                        </div>
                    </section>
                }
                else if (!FilteredTools.Any())
                {
                    <section class="availability-v24-empty">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true"
                             focusable="false">

                            <path d="M4 7H20V20H4Z"></path>
                            <path d="M8 7V4H16V7"></path>
                            <path d="M8 12H16"></path>
                        </svg>

                        <div>
                            <strong>No hay herramientas para mostrar</strong>

                            <span>
                                Ajusta la búsqueda, sede o estado seleccionado.
                            </span>
                        </div>
                    </section>
                }
                else
                {
                    <div class="availability-v24-table-scroll">

                        <table class="availability-v24-table">

                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Herramienta o activo</th>
                                    <th>Sede</th>
                                    <th>Ubicación</th>
                                    <th>Responsable</th>
                                    <th>Estado</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var tool in FilteredTools)
                                {
                                    <tr class="@(
                                        form.ToolId == tool.Id
                                            ? "is-selected"
                                            : string.Empty)">

                                        <td class="availability-v24-code">
                                            <strong>@tool.InternalCode</strong>
                                        </td>

                                        <td class="availability-v24-asset">
                                            <strong>@tool.Name</strong>

                                            <small>
                                                Serial:
                                                @Show(tool.SerialNumber)
                                            </small>
                                        </td>

                                        <td>
                                            <strong>
                                                @Show(tool.BranchCode)
                                            </strong>
                                        </td>

                                        <td>
                                            @Show(tool.LocationName)
                                        </td>


                                        <td>
                                            @Show(tool.ResponsiblePersonName)
                                        </td>

                                        <td>
                                            <span class="@GetStatusBadge(
                                                tool.OperationalStatus)">

                                                @GetStatusLabel(
                                                    tool.OperationalStatus)
                                            </span>
                                        </td>

                                        <td>
                                            <button type="button"
                                                    class="availability-v24-manage"
                                                    @onclick="() => SelectTool(tool)"
                                                    data-ntx-tone="operation">

                                                <svg viewBox="0 0 24 24"
                                                     aria-hidden="true"
                                                     focusable="false">

                                                    <path d="M12 3V21"></path>
                                                    <path d="M3 12H21"></path>
                                                    <circle cx="12"
                                                            cy="12"
                                                            r="7">
                                                    </circle>
                                                </svg>

                                                <span>Gestionar</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </section>
    </section>
</PermissionGuard>

@code {
    private HttpClient Api => HttpClientFactory.CreateClient("NaviApi");

    private List<ToolItem> tools = new();
    private List<BranchItem> branches = new();
    private List<LocationItem> locations = new();

    private AvailabilityForm form = new();

    private string toolSearchText = string.Empty;
    private string branchSearchText = string.Empty;
    private string locationSearchText = string.Empty;

    private bool isLoading;
    private bool isSaving;
    private string search = string.Empty;
    private string selectedBranchCode = string.Empty;
    private string selectedStatus = string.Empty;
    private string message = string.Empty;
    private string messageClass = "alert alert-info";

    // NAVI AVAILABILITY INTERNAL LOCATION V229
    private IEnumerable<LocationItem> AvailableLocations
    {
        get
        {
            var internalLocations =
                locations.Where(
                    location =>
                        !IsWarehouseCatalogCodeV229(
                            location.Code));

            if (!form.BranchId.HasValue)
            {
                return internalLocations;
            }

            var selectedBranchId =
                form.BranchId.Value;

            return internalLocations.Where(
                location =>
                    location.BranchId
                    ==
                    selectedBranchId);
        }
    }

    private static bool IsWarehouseCatalogCodeV229(
        string? code)
    {
        var normalized =
            code?
                .Trim()
                .ToUpperInvariant()
            ?? string.Empty;

        return
            normalized.EndsWith(
                "-BOD-HERR",
                StringComparison.Ordinal)
            ||
            normalized.EndsWith(
                "-MANT",
                StringComparison.Ordinal)
            ||
            normalized.EndsWith(
                "-TALLER",
                StringComparison.Ordinal);
    }

    private IEnumerable<ToolItem> ScopedTools =>
        AccessScope.FilterTools(
            tools,
            x => x.BranchCode,
            x => x.ResponsiblePersonName);

    private bool CanChangeAvailabilityLocation =>
        AuthSession.HasPermission("AssetAvailability.Edit");

    private bool CanChangeAvailabilityStatus =>
        AuthSession.HasPermission("AssetAvailability.Status.Change");

    private bool CanSaveAvailability =>
        CanChangeAvailabilityLocation || CanChangeAvailabilityStatus;

    private bool CanManageAvailability =>
        CanSaveAvailability;

    private ToolItem? SelectedAvailabilityTool =>
        form.ToolId.HasValue
            ? tools.FirstOrDefault(x => x.Id == form.ToolId.Value)
            : null;

    private bool HasAvailabilityLocationChange(ToolItem current)
    {
        return form.BranchId != current.BranchId ||
               form.LocationId != current.LocationId;
    }

    private bool HasAvailabilityStatusChange(ToolItem current)
    {
        return !string.Equals(
            form.OperationalStatus ?? string.Empty,
            current.OperationalStatus ?? string.Empty,
            StringComparison.OrdinalIgnoreCase);
    }

    private string? GetAvailabilityPermissionError()
    {
        if (form.ToolId is null)
        {
            return "Seleccione una herramienta antes de guardar cambios.";
        }

        var current = SelectedAvailabilityTool;

        if (current is null)
        {
            return "No se encontró la herramienta seleccionada.";
        }

        if (!CanSaveAvailability)
        {
            return "No tienes permiso para cambiar ubicación ni estado operativo.";
        }

        if (HasAvailabilityLocationChange(current) && !CanChangeAvailabilityLocation)
        {
            return "No tienes permiso para cambiar sede o ubicación interna.";
        }

        if (HasAvailabilityStatusChange(current) && !CanChangeAvailabilityStatus)
        {
            return "No tienes permiso para cambiar el estado operativo.";
        }

        return null;
    }


private IEnumerable<ToolItem> AvailabilityBaseFilteredTools =>
        ScopedTools
            .Where(x => string.IsNullOrWhiteSpace(search) ||
                        x.InternalCode.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                        x.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                        (x.SerialNumber ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                        (x.BranchCode ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                        (x.LocationName ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                        (x.ResponsiblePersonName ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase))
            .Where(x => string.IsNullOrWhiteSpace(selectedBranchCode) ||
                        string.Equals(x.BranchCode ?? string.Empty, selectedBranchCode, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<ToolItem> FilteredTools =>
        AvailabilityBaseFilteredTools
            .Where(x => string.IsNullOrWhiteSpace(selectedStatus) ||
                        string.Equals(x.OperationalStatus, selectedStatus, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.BranchCode)
            .ThenBy(x => x.InternalCode);


    private IEnumerable<AvailabilityStatusFilterOption> AvailabilityStatusFilterOptions =>
        AvailabilityBaseFilteredTools
            .Where(x => !string.IsNullOrWhiteSpace(x.OperationalStatus))
            .GroupBy(x => x.OperationalStatus)
            .Select(x => new AvailabilityStatusFilterOption
            {
                Value = x.Key,
                Label = GetStatusLabel(x.Key),
                Count = x.Count()
            })
            .OrderBy(x => x.Label);

    private void SelectAvailabilityStatus(string status)
    {
        selectedStatus = status;
    }

    private string GetAvailabilityStatusFilterChipClass(string? status)
    {
        var value = status ?? string.Empty;

        var selected = string.Equals(
            selectedStatus ?? string.Empty,
            value,
            StringComparison.OrdinalIgnoreCase)
            ? " active"
            : string.Empty;

        var statusClass = string.IsNullOrWhiteSpace(value)
            ? "all"
            : NormalizeAvailabilityStatusCss(value);

        return $"availability-status-filter-chip availability-status-{statusClass}{selected}";
    }

    private static string NormalizeAvailabilityStatusCss(string status) => status switch
    {
        "Available" => "available",
        "Assigned" => "assigned",
        "Loaned" => "loaned",
        "InMaintenance" => "maintenance",
        "Damaged" => "damaged",
        "NotSuitable" => "not-suitable",
        "PendingValidation" => "pending",
        "NotLocated" => "not-located",
        "PendingDisposal" => "disposal",
        "Disposed" => "disposed",
        _ => "other"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }


    private static bool IsToolOnly(ToolItem item)
    {
        var typeName = item.ToolTypeName ?? string.Empty;
        var typeCode = item.ToolTypeCode ?? string.Empty;

        return typeName.Equals("Herramienta", StringComparison.OrdinalIgnoreCase)
            || typeName.Equals("HERRAMIENTA", StringComparison.OrdinalIgnoreCase)
            || typeCode.Equals("HERRAMIENTA", StringComparison.OrdinalIgnoreCase)
            || typeCode.Equals("TOOL", StringComparison.OrdinalIgnoreCase);
    }
    private async Task LoadAsync()
    {
        isLoading = true;

        try
        {
                        tools = await Api.GetFromJsonAsync<List<ToolItem>>("api/tools") ?? new();
            branches = await Api.GetFromJsonAsync<List<BranchItem>>("api/settings/branches") ?? new();
            locations = await Api.GetFromJsonAsync<List<LocationItem>>("api/settings/warehouses") ?? new();
        }
        catch (Exception ex)
        {
            ShowError($"No se pudo cargar la información: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectTool(ToolItem tool)
    {
        form = new AvailabilityForm
        {
            ToolId = tool.Id,
            BranchId = tool.BranchId,
            LocationId = tool.LocationId,
            OperationalStatus = string.IsNullOrWhiteSpace(tool.OperationalStatus) ? "Available" : tool.OperationalStatus
        };

        toolSearchText = FormatToolOption(tool);

        var branch = branches.FirstOrDefault(x => x.Id == tool.BranchId);
        branchSearchText = branch is null
            ? tool.BranchCode ?? string.Empty
            : FormatBranchOption(branch);

        var location = locations.FirstOrDefault(x => x.Id == tool.LocationId);
        locationSearchText = location is null
            ? tool.LocationName ?? string.Empty
            : FormatLocationOption(location);
    }

    private void LoadSelectedTool()
    {
        var tool = tools.FirstOrDefault(x => x.Id == form.ToolId);

        if (tool is not null)
        {
            SelectTool(tool);
        }
    }

    private void OnBranchChanged()
    {
        if (form.LocationId.HasValue &&
            !locations.Any(x => x.Id == form.LocationId && x.BranchId == form.BranchId))
        {
            form.LocationId = null;
        }
    }

    private async Task SaveAsync()
    {

        var permissionError = GetAvailabilityPermissionError();

        if (!string.IsNullOrWhiteSpace(permissionError))
        {
            ShowError(permissionError);
            return;
        }



        if (form.ToolId is null || form.BranchId is null)
        {
            ShowError("Debe seleccionar activo y sede.");
            return;
        }

        isSaving = true;

        var request = new
        {
            branchId = form.BranchId.Value,
            locationId = form.LocationId,
            operationalStatus = form.OperationalStatus,
            observation = form.Observation,
            changedBy = "admin-web"
        };

        try
        {
            var response = await Api.PatchAsJsonAsync($"api/tools/{form.ToolId}/availability-location", request);

            if (!response.IsSuccessStatusCode)
            {
                ShowError(await response.Content.ReadAsStringAsync());
                return;
            }

            ShowSuccess("Disponibilidad y ubicación actualizadas correctamente.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowError($"Error guardando cambios: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ClearForm()
    {
        form = new AvailabilityForm();
        toolSearchText = string.Empty;
        branchSearchText = string.Empty;
        locationSearchText = string.Empty;
    }


    private void OnToolSearchInput(ChangeEventArgs args)
    {
        toolSearchText = args.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(toolSearchText))
        {
            form.ToolId = null;
            return;
        }

        var tool = ResolveTool(toolSearchText);

        if (tool is not null)
        {
            SelectTool(tool);
        }
    }

    private void OnBranchSearchInput(ChangeEventArgs args)
    {
        branchSearchText = args.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(branchSearchText))
        {
            form.BranchId = null;
            form.LocationId = null;
            locationSearchText = string.Empty;
            return;
        }

        var branch = ResolveBranch(branchSearchText);

        if (branch is not null)
        {
            form.BranchId = branch.Id;
            branchSearchText = FormatBranchOption(branch);
            OnBranchChanged();
        }
    }

    private void OnLocationSearchInput(ChangeEventArgs args)
    {
        locationSearchText = args.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(locationSearchText))
        {
            form.LocationId = null;
            return;
        }

        var location = ResolveLocation(locationSearchText);

        if (location is not null)
        {
            form.LocationId = location.Id;
            locationSearchText = FormatLocationOption(location);
        }
    }

    private ToolItem? ResolveTool(string value)
    {
        return tools.FirstOrDefault(x =>
            string.Equals(FormatToolOption(x), value, StringComparison.OrdinalIgnoreCase) ||
            string.Equals($"{x.InternalCode} - {x.Name}", value, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.InternalCode, value, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.Name, value, StringComparison.OrdinalIgnoreCase));
    }

    private BranchItem? ResolveBranch(string value)
    {
        return branches.FirstOrDefault(x =>
            string.Equals(FormatBranchOption(x), value, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.Code, value, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.Name, value, StringComparison.OrdinalIgnoreCase));
    }

    private LocationItem? ResolveLocation(string value)
    {
        return AvailableLocations.FirstOrDefault(x =>
            string.Equals(FormatLocationOption(x), value, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.Code, value, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.Name, value, StringComparison.OrdinalIgnoreCase));
    }

    private static string FormatToolOption(ToolItem tool)
    {
        var serial = string.IsNullOrWhiteSpace(tool.SerialNumber) ? "Sin serial" : tool.SerialNumber;
        var branch = string.IsNullOrWhiteSpace(tool.BranchCode) ? "Sin sede" : tool.BranchCode;
        return $"{tool.InternalCode} - {tool.Name} · {branch} · {serial}";
    }

    private static string FormatBranchOption(BranchItem branch)
    {
        return $"{branch.Code} - {branch.Name}";
    }

    private static string FormatLocationOption(LocationItem location)
    {
        return $"{location.Code} - {location.Name}";
    }

    private string GetToolSearchHint()
    {
        if (string.IsNullOrWhiteSpace(toolSearchText))
        {
            return "Escriba y seleccione una herramienta existente.";
        }

        return form.ToolId.HasValue
            ? "Herramienta seleccionada correctamente."
            : "Seleccione una herramienta de las coincidencias.";
    }

    private string GetBranchSearchHint()
    {
        if (string.IsNullOrWhiteSpace(branchSearchText))
        {
            return "Escriba y seleccione una sede.";
        }

        return form.BranchId.HasValue
            ? "Sede seleccionada correctamente."
            : "Seleccione una sede de las coincidencias.";
    }

    private string GetLocationSearchHint()
    {
        if (string.IsNullOrWhiteSpace(locationSearchText))
        {
            return "Puede dejarla vacía si no aplica ubicación.";
        }

        return form.LocationId.HasValue
            ? "Ubicación seleccionada correctamente."
            : "Seleccione una ubicación de las coincidencias.";
    }

    private string GetToolSearchHintClass() => form.ToolId.HasValue ? "navi-search-hint ok" : "navi-search-hint";
    private string GetBranchSearchHintClass() => form.BranchId.HasValue ? "navi-search-hint ok" : "navi-search-hint";
    private string GetLocationSearchHintClass() => form.LocationId.HasValue || string.IsNullOrWhiteSpace(locationSearchText) ? "navi-search-hint ok" : "navi-search-hint";

    private static string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string GetStatusLabel(string status) => status switch
    {
        "Available" => "Disponible",
        "Assigned" => "Asignada",
        "Loaned" => "Prestada",
        "InMaintenance" => "En mantenimiento",
        "Damaged" => "Dañada",
        "NotSuitable" => "No apta",
        "PendingValidation" => "Pendiente validación",
        "NotLocated" => "No localizada",
        "PendingDisposal" => "Pendiente baja",
        "Disposed" => "Dada de baja",
        _ => NaviStatusLabels.ToSpanish(status)
    };

    private void ShowSuccess(string value)
    {
        message = value;
        messageClass = "alert alert-success";
    }

    private void ShowError(string value)
    {
        message = value;
        messageClass = "alert alert-danger";
    }


