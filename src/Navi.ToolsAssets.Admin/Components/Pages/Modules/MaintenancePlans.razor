@code {

    private bool CanViewPlans => PlanHasPermission("MaintenancePlans.View");
    private bool CanCreatePlan => PlanHasPermission("MaintenancePlans.Create");
    private bool CanEditPlan => PlanHasPermission("MaintenancePlans.Edit");
    private bool CanDeletePlan => PlanHasPermission("MaintenancePlans.Delete");

    private bool CanOpenMaintenanceSchedule =>
        CanViewPlans || CanCreatePlan || CanEditPlan || CanDeletePlan ||
        PlanHasPermission("TechnicalLifeRecord.Maintenance");

    private bool CanOpenLifeRecord =>
        PlanHasPermission("TechnicalLifeRecord.View") ||
        PlanHasPermission("ToolDetail.LifeRecord.Open") ||
        PlanHasPermission("ToolDetail.View");

    private bool CanRequestMaintenance =>
        PlanHasPermission("Maintenance.Request") ||
        CanCreatePlan ||
        CanEditPlan;

    private bool PlanHasPermission(string permission)
    {
        return AuthSession.HasPermission(permission)
            || string.Equals(AuthSession.RoleCode, "ADMIN", StringComparison.OrdinalIgnoreCase)
            || string.Equals(AuthSession.RoleCode, "SUPERADMIN", StringComparison.OrdinalIgnoreCase);
    }











    private List<MaintenancePlanItem> plans = new();
    private bool isLoading;
    private string selectedStatus = string.Empty;
    private string selectedBranchCode = string.Empty;
    private string searchText = string.Empty;
    private string? errorMessage;

    private readonly (string Value, string Text)[] PlanStatusOptions =
    {
        ("OnTime", "Al día"),
        ("DueSoon", "Por vencer"),
        ("Overdue", "Vencido")
    };




    private IEnumerable<string> PlanBranchOptions =>
        plans
            .Select(x => x.BranchCode)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x);

    private IEnumerable<MaintenancePlanItem> PlanBaseFilteredPlans =>
        plans
            .Where(MatchesSearch)
            .Where(MatchesBranchFilter);

    private IEnumerable<MaintenancePlanItem> FilteredPlans =>
        PlanBaseFilteredPlans
            .Where(x => string.IsNullOrWhiteSpace(selectedStatus) || x.PlanStatus == selectedStatus)
            .OrderBy(x => x.DaysRemaining);


    private void SelectPlanStatus(string status)
    {
        selectedStatus = status;
    }

    private void ClearPlanFilters()
    {
        selectedStatus = string.Empty;
        selectedBranchCode = string.Empty;
        searchText = string.Empty;
    }

    private string GetPlanStatusFilterChipClass(string? status)
    {
        var value = status ?? string.Empty;

        var selected = string.Equals(selectedStatus ?? string.Empty, value, StringComparison.OrdinalIgnoreCase)
            ? " active"
            : string.Empty;

        var css = string.IsNullOrWhiteSpace(value)
            ? "all"
            : value switch
            {
                "OnTime" => "ontime",
                "DueSoon" => "duesoon",
                "Overdue" => "overdue",
                _ => "other"
            };

        return $"plans-status-filter-chip plans-status-{css}{selected}";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private HttpClient CreateApiClient()
    {
        var api = HttpClientFactory.CreateClient("NaviApi");

        api.DefaultRequestHeaders.Remove("X-Navi-User");
        api.DefaultRequestHeaders.Remove("X-Navi-Role");
        api.DefaultRequestHeaders.Remove("X-Navi-Role-Code");
        api.DefaultRequestHeaders.Remove("X-Navi-Permissions");

        api.DefaultRequestHeaders.Add("X-Navi-User", string.IsNullOrWhiteSpace(AuthSession.UserName) ? "admin" : AuthSession.UserName);
        api.DefaultRequestHeaders.Add("X-Navi-Role", string.IsNullOrWhiteSpace(AuthSession.RoleName) ? "Administrador" : AuthSession.RoleName);
        api.DefaultRequestHeaders.Add("X-Navi-Role-Code", string.IsNullOrWhiteSpace(AuthSession.RoleCode) ? "ADMIN" : AuthSession.RoleCode);
        api.DefaultRequestHeaders.Add("X-Navi-Permissions", string.Join(";", AuthSession.Permissions ?? new List<string>()));

        return api;
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var api = CreateApiClient();
            plans = await api.GetFromJsonAsync<List<MaintenancePlanItem>>("api/maintenance-requests/plans-board") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudieron cargar los planes: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }


    private bool MatchesBranchFilter(MaintenancePlanItem item)
    {
        return string.IsNullOrWhiteSpace(selectedBranchCode) ||
               string.Equals(item.BranchCode ?? string.Empty, selectedBranchCode, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesSearch(MaintenancePlanItem item)
    {
        if (string.IsNullOrWhiteSpace(searchText)) return true;

        var value = searchText.Trim();

        return Contains(item.InternalCode, value) ||
               Contains(item.Name, value) ||
               Contains(item.BranchCode, value) ||
               Contains(item.BranchName, value) ||
               Contains(item.LocationName, value) ||
               Contains(item.ResponsibleName, value) ||
               Contains(item.LastProvider, value) ||
               Contains(item.LastTechnician, value);
    }

    private static bool Contains(string? source, string value) =>
        !string.IsNullOrWhiteSpace(source) && source.Contains(value, StringComparison.OrdinalIgnoreCase);

    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "—";

    private static string GetDaysText(int days)
    {
        if (days < 0) return $"Vencido hace {Math.Abs(days)} día(s)";
        if (days == 0) return "Vence hoy";
        return $"Faltan {days} día(s)";
    }

    private static string GetPlanClass(string status) => status switch
    {
        "OnTime" => "plan-pill ontime",
        "DueSoon" => "plan-pill duesoon",
        "Overdue" => "plan-pill overdue",
        _ => "plan-pill"
    };

    private static string GetPlanLabel(string status) => status switch
    {
        "OnTime" => "Al día",
        "DueSoon" => "Por vencer",
        "Overdue" => "Vencido",
        _ => NaviStatusLabels.ToSpanish(status)
    };

    private string GetPlanDonutStyle()
    {
        var total = plans.Count;

        if (total <= 0)
        {
            return "background: conic-gradient(#eadff0 0 100%);";
        }

        var onTime = plans.Count(x => x.PlanStatus == "OnTime");
        var dueSoon = plans.Count(x => x.PlanStatus == "DueSoon");
        var overdue = plans.Count(x => x.PlanStatus == "Overdue");

        var onTimeEnd = PercentEnd(onTime, total, 0);
        var dueSoonEnd = PercentEnd(dueSoon, total, onTimeEnd);

        return $"background: conic-gradient(#198754 0% {onTimeEnd}%, #ffc107 {onTimeEnd}% {dueSoonEnd}%, #dc3545 {dueSoonEnd}% 100%);";
    }

    private static decimal PercentEnd(int value, int total, decimal start)
    {
        if (value <= 0 || total <= 0)
        {
            return start;
        }

        return Math.Min(100, start + Math.Round((decimal)value / total * 100, 2));
    }

    private static string GetPercentLabel(int value, int total)
    {
        if (value <= 0 || total <= 0)
        {
            return "0%";
        }

        return $"{Math.Round((decimal)value / total * 100, 1)}%";
    }

    private sealed class MaintenancePlanItem
    {
        public Guid ToolAssetId { get; set; }
        public string InternalCode { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? BranchCode { get; set; }
        public string? BranchName { get; set; }
        public string? LocationName { get; set; }
        public string? ResponsibleName { get; set; }
        public int PeriodMonths { get; set; }
        public DateTime? LastMaintenanceAt { get; set; }
        public DateTime NextMaintenanceAt { get; set; }
        public int DaysRemaining { get; set; }
        public string PlanStatus { get; set; } = string.Empty;
        public int TotalMaintenances { get; set; }
        public int CompletedMaintenances { get; set; }
        public int ScheduledMaintenances { get; set; }
        public int PendingRequests { get; set; }
        public string? LastMaintenanceNumber { get; set; }
        public string? LastTechnician { get; set; }
        public string? LastProvider { get; set; }
    }
}
