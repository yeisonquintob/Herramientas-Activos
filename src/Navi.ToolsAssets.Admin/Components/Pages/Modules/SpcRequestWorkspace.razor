    // NAVI GENERATED REVIEW VIEW V121 START
    private async Task OpenGeneratedPurchaseDetailAsync(
        Guid requestId)
    {
        showGeneratedPurchaseDetail = true;
        isGeneratedPurchaseDetailLoading = true;
        generatedPurchaseDetailId = requestId;
        generatedPurchaseDetailError = null;
        generatedPurchaseDetail = null;

        await InvokeAsync(StateHasChanged);

        try
        {
            var api = CreateApiClient();

            using var timeout = new CancellationTokenSource(
                TimeSpan.FromSeconds(8));

            var detail =
                await api.GetFromJsonAsync<PurchaseRequestDetailItem>(
                    $"api/purchase-requests/{requestId}",
                    timeout.Token);

            if (generatedPurchaseDetailId != requestId)
            {
                return;
            }

            if (detail is not null)
            {
                using var evidenceTimeout = new CancellationTokenSource(
                    TimeSpan.FromSeconds(20));

                await RehydrateGeneratedEvidencePreviewsAsync(
                    api,
                    detail,
                    evidenceTimeout.Token);
            }

            generatedPurchaseDetail = detail;

            if (generatedPurchaseDetail is null)
            {
                generatedPurchaseDetailError =
                    "No se encontró la información de la solicitud.";
            }
        }
        catch (OperationCanceledException)
        {
            if (generatedPurchaseDetailId == requestId)
            {
                generatedPurchaseDetailError =
                    "La consulta tardó más de lo esperado. " +
                    "Cierra la ventana y vuelve a intentar.";
            }
        }
        catch (Exception ex)
        {
            if (generatedPurchaseDetailId == requestId)
            {
                generatedPurchaseDetailError =
                    $"No se pudo consultar la solicitud: " +
                    $"{ex.Message}";
            }
        }
        finally
        {
            if (generatedPurchaseDetailId == requestId)
            {
                isGeneratedPurchaseDetailLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void CloseGeneratedPurchaseDetail()
    {
        showGeneratedPurchaseDetail = false;
        isGeneratedPurchaseDetailLoading = false;
        generatedPurchaseDetailId = null;
        generatedPurchaseDetailError = null;
        generatedPurchaseDetail = null;
    }

    private static string GetGeneratedPurchaseSummary(
        PurchaseRequestDetailItem detail)
    {
        return !string.IsNullOrWhiteSpace(detail.Notes)
            ? detail.Notes
            : detail.ItemDescription ?? string.Empty;
    }

    private static string? ExtractGeneratedSummaryValue(
        string? summary,
        string label)
    {
        if (string.IsNullOrWhiteSpace(summary) ||
            string.IsNullOrWhiteSpace(label))
        {
            return null;
        }

        var prefix = label.Trim() + ":";

        var lines = summary
            .Replace(
                "\r\n",
                "\n",
                StringComparison.Ordinal)
            .Replace('\r', '\n')
            .Split('\n');

        foreach (var rawLine in lines)
        {
            var line = rawLine.Trim();

            if (line.StartsWith(
                prefix,
                StringComparison.OrdinalIgnoreCase))
            {
                return line[prefix.Length..].Trim();
            }
        }

        return null;
    }

    private static string ExtractGeneratedSummarySection(
        string? summary,
        string sectionTitle,
        string? nextSectionTitle)
    {
        if (string.IsNullOrWhiteSpace(summary))
        {
            return string.Empty;
        }

        var lines = summary
            .Replace(
                "\r\n",
                "\n",
                StringComparison.Ordinal)
            .Replace('\r', '\n')
            .Split('\n');

        var insideSection = false;
        var result = new List<string>();

        foreach (var rawLine in lines)
        {
            var line = rawLine.TrimEnd();
            var normalized = line.Trim();

            if (!insideSection)
            {
                if (normalized.Equals(
                    sectionTitle,
                    StringComparison.OrdinalIgnoreCase))
                {
                    insideSection = true;
                }

                continue;
            }

            if (!string.IsNullOrWhiteSpace(nextSectionTitle) &&
                normalized.Equals(
                    nextSectionTitle,
                    StringComparison.OrdinalIgnoreCase))
            {
                break;
            }

            result.Add(line);
        }

        while (result.Count > 0 &&
               string.IsNullOrWhiteSpace(result[0]))
        {
            result.RemoveAt(0);
        }

        while (result.Count > 0 &&
               string.IsNullOrWhiteSpace(result[^1]))
        {
            result.RemoveAt(result.Count - 1);
        }

        return string.Join(
            Environment.NewLine,
            result);
    }

