    private static string DisplayOr(
        string? value,
        string fallback)
    {
        return string.IsNullOrWhiteSpace(value)
            ? fallback
            : value.Trim();
    }

    public async ValueTask DisposeAsync()
    {
        if (isDisposed)
        {
            return;
        }

        isDisposed = true;

        Auth.OnChange -= OnAuthChanged;

        Navigation.LocationChanged -=
            OnLocationChanged;

        HeaderState.OnChange -=
            OnHeaderStateChanged;

        NotificationState.OnRefreshRequested -=
            OnNotificationRefreshRequested;

        notificationCancellation.Cancel();

        if (notificationRefreshLoopTask is not null)
        {
            try
            {
                await notificationRefreshLoopTask;
            }
            catch
            {
            }
        }

        if (jsRegistered)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "naviMobileShellHeader.unregister",
                    HeaderRootId);
            }
            catch
            {
            }
        }

        dotNetReference?.Dispose();
        notificationRefreshLock.Dispose();
        notificationCancellation.Dispose();
    }

