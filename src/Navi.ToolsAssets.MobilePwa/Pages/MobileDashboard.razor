@page "/mobile/dashboard"

@using Navi.ToolsAssets.MobilePwa.Models

@inject NaviMobileApiClient Api
@inject MobileAuthSessionService Auth
@inject NavigationManager Navigation

<PageTitle>Dashboard móvil - NAVI Herramientas y AF</PageTitle>

<section class="mobile-page mobile-page-compact navi-mobile-dashboard-v6">
    @if (isLoading)
    {
        <div class="mobile-loading">Cargando dashboard móvil...</div>
    }
    else if (!Auth.IsAuthenticated)
    {
        <div class="mobile-empty">
            <strong>Sesión requerida</strong>
            <span>Debes iniciar sesión para consultar el dashboard.</span>
            <button class="mobile-primary-button" type="button" @onclick="GoLogin" data-ntx-tone="secondary" >Ir al login</button>
        </div>
    }
    else if (!CanViewDashboard)
    {
        <div class="mobile-empty">
            <strong>Sin permiso</strong>
            <span>Tu usuario no tiene permiso para visualizar el dashboard móvil.</span>
            <button class="mobile-primary-button" type="button" @onclick="GoHome" data-ntx-tone="warning" >Volver al inicio</button>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="mobile-alert error">@errorMessage</div>

        <button class="mdash-refresh-full" type="button" @onclick="LoadDashboardAsync" data-ntx-tone="warning" >
            Reintentar
        </button>
    }
    else if (dashboard is not null)
    {
        <section class="mdash-board">
            <NaviMobileAppBanner Class="navi-mobile-dashboard-app-banner navi-mobile-app-banner--module mdash-hero"
                                 Pill="PRINCIPAL · DASHBOARD"
                                 Title="Dashboard móvil"
                                 Description="@DashboardHeroDescription"
                                 HomeUrl="/"
                                 ShowHomeButton="true"
                                 ShowBackButton="false" />




            <section class="navi-mobile-dashboard-filter-panel">
                <label>
                    <span>Sede</span>
                    <input @bind="filterBranchCode"
                           @bind:event="oninput"
                           placeholder="Todas / AGU..." />
                </label>

                <label>
                    <span>Estado</span>
                    <select @bind="filterOperationalStatus">
                        <option value="">Todos</option>
                        @foreach (var item in dashboardStatusFilters)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </label>

                <label class="wide">
                    <span>Buscar</span>
                    <input @bind="filterText"
                           @bind:event="oninput"
                           placeholder="Código, nombre, serial..." />
                </label>

                <div>
                    <button type="button" @onclick="ApplyDashboardFiltersAsync" disabled="@isRefreshing" data-ntx-tone="secondary" >Filtrar</button>
                    <button type="button" class="secondary" @onclick="ClearDashboardFiltersAsync" disabled="@isRefreshing" data-ntx-tone="secondary" >Limpiar</button>
                </div>
            </section>

            <section class="mdash-kpis">
                <article class="primary">
                    <span>Total activos</span>
                    <strong>@DashboardTotalTools</strong>
                    <small>@ScopeLabel</small>
                </article>

                <article class="tone-positive">
                    <span>Disponibles</span>
                    <strong>@DashboardAvailableTools</strong>
                    <small>Operación</small>
                </article>

                <article class="tone-warning">
                    <span>Asignados</span>
                    <strong>@DashboardAssignedTools</strong>
                    <small>Custodia</small>
                </article>

                <article class="tone-secondary">
                    <span>Responsables</span>
                    <strong>@DashboardActiveResponsibles</strong>
                    <small>Activos</small>
                </article>

                <article class="tone-danger">
                    <span>Dañadas</span>
                    <strong>@DashboardDamagedTools</strong>
                    <small>Novedades</small>
                </article>

                <article class="primary">
                    <span>Avance</span>
                    <strong>@GetAdvancePercent()%</strong>
                    <small>Hoja de vida</small>
                </article>
            </section>

            <section class="mdash-card mdash-summary-card">
                <div class="mdash-section-head">
                    <div>
                        <h2>Resumen ejecutivo</h2>
                        <p>Indicadores principales del tablero operativo.</p>
                    </div>
                    <span>@FormatDateTime(dashboard.GeneratedAt)</span>
                </div>

                <div class="mdash-info-grid">
                    <div><span>Herramientas</span><strong>@DashboardToolsOnly</strong></div>
                    <div><span>Activos fijos</span><strong>@DashboardFixedAssets</strong></div>
                    <div><span>Especializadas</span><strong>@DashboardSpecializedTools</strong></div>
                    <div><span>Sin código AF</span><strong>@DashboardToolsWithoutFixedAssetCode</strong></div>
                    <div><span>Con hoja de vida</span><strong>@dashboard.Summary.WithLifeRecord</strong></div>
                    <div><span>Sin hoja de vida</span><strong>@dashboard.Summary.WithoutLifeRecord</strong></div>
                    <div><span>Sedes activas</span><strong>@DashboardActiveBranches</strong></div>
                    <div><span>Requieren mtto.</span><strong>@DashboardRequiresMaintenance</strong></div>
                </div>
            </section>

            <section class="mdash-card">
                <h2>Estado operativo</h2>

                <div class="mdash-state-list">
                    <div><span>Disponibles</span><strong>@DashboardAvailableTools</strong></div>
                    <div><span>Asignadas</span><strong>@DashboardAssignedTools</strong></div>
                    <div><span>Prestadas</span><strong>@DashboardLoanedTools</strong></div>
                    <div><span>Mantenimiento</span><strong>@DashboardInMaintenanceTools</strong></div>
                    <div><span>Dañadas</span><strong>@DashboardDamagedTools</strong></div>
                    <div><span>No localizadas</span><strong>@DashboardNotLocatedTools</strong></div>
                    <div><span>Pendientes validación</span><strong>@DashboardPendingValidationTools</strong></div>
                    <div><span>Desactivadas / baja</span><strong>@DashboardDisposedTools</strong></div>
                </div>
            </section>

            <section class="mdash-card mdash-donut-card">
                <h2>Distribución general</h2>

                <div class="mdash-donut-grid">
                    <div class="mdash-mini-donut-card">
                        <div class="mdash-donut md" style="@GetToolsVsAssetsDonut()">
                            <div>
                                <strong>@GetToolsVsAssetsTotal()</strong>
                                <span>Total</span>
                            </div>
                        </div>
                        <h3>Herramientas vs AF</h3>
                        <div class="mdash-legend compact">
                            <div><i class="primary"></i><span>Herramientas</span><strong>@DashboardToolsOnly</strong></div>
                            <div><i class="neutral"></i><span>Activos fijos</span><strong>@DashboardFixedAssets</strong></div>
                            <div><i class="tone-warning"></i><span>Sin código</span><strong>@DashboardToolsWithoutFixedAssetCode</strong></div>
                        </div>
                    </div>

                    <div class="mdash-mini-donut-card">
                        <div class="mdash-donut md" style="@GetStatusDonut()">
                            <div>
                                <strong>@GetStatusDonutTotal()</strong>
                                <span>Total</span>
                            </div>
                        </div>
                        <h3>Estados</h3>
                        <div class="mdash-legend compact">
                            <div><i class="primary"></i><span>Asignadas</span><strong>@DashboardAssignedTools</strong></div>
                            <div><i class="neutral"></i><span>Disponibles</span><strong>@DashboardAvailableTools</strong></div>
                            <div><i class="tone-danger"></i><span>Mtto.</span><strong>@DashboardInMaintenanceTools</strong></div>
                        </div>
                    </div>

                    <div class="mdash-mini-donut-card">
                        <div class="mdash-donut md" style="@GetLifeRecordDonut()">
                            <div>
                                <strong>@GetLifeRecordDonutTotal()</strong>
                                <span>Total</span>
                            </div>
                        </div>
                        <h3>Hoja de vida</h3>
                        <div class="mdash-legend compact">
                            <div><i class="primary"></i><span>Con hoja</span><strong>@dashboard.Summary.WithLifeRecord</strong></div>
                            <div><i class="neutral"></i><span>Sin hoja</span><strong>@dashboard.Summary.WithoutLifeRecord</strong></div>
                            <div><i class="tone-warning"></i><span>Incompletas</span><strong>@dashboard.LifeRecordCoverage.MissingTechnicalData</strong></div>
                        </div>
                    </div>

                    <div class="mdash-mini-donut-card">
                        <div class="mdash-donut md" style="@GetMaintenanceDonut()">
                            <div>
                                <strong>@GetMaintenanceDonutTotal()</strong>
                                <span>Total</span>
                            </div>
                        </div>
                        <h3>Mantenimientos</h3>
                        <div class="mdash-legend compact">
                            <div><i class="primary"></i><span>Este mes</span><strong>@dashboard.MaintenanceSummary.ThisMonth</strong></div>
                            <div><i class="neutral"></i><span>Hoy</span><strong>@dashboard.MaintenanceSummary.Today</strong></div>
                            <div><i class="tone-warning"></i><span>Pendientes</span><strong>@DashboardRequiresMaintenance</strong></div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="mdash-card">
                <div class="mdash-section-head">
                    <div>
                        <h2>Herramientas por sede</h2>
                        <p>Distribución proporcional por sede.</p>
                    </div>

                    <span>Máx. @GetMaxBranch()</span>
                </div>

                <div class="mdash-branch-bars-list">
                    @foreach (var item in DashboardToolsByBranch.Take(10))
                    {
                        <div>
                            <span>@item.BranchCode</span>
                            <div><strong style="@GetBranchLinearBarStyle(item.Total)"></strong></div>
                            <em>@item.Total</em>
                        </div>
                    }
                </div>
            </section>

            <section class="mdash-card">
                <div class="mdash-section-head">
                    <div>
                        <h2>Resumen por sede / responsable</h2>
                        <p>Asignaciones, validaciones, pendientes y diferencias.</p>
                    </div>

                    <span>@DashboardToolsByBranch.Count sedes</span>
                </div>

                <div class="mdash-branch-summary-list">
                    @foreach (var item in DashboardToolsByBranch.Take(7))
                    {
                        var assigned = GetBranchAssigned(item.Total);
                        var valid = GetBranchValidated(item.Total);
                        var pending = GetBranchPending(item.Total);
                        var difference = GetBranchDifferences(item.Total);
                        var percent = GetBranchAdvance(item.Total);

                        <article>
                            <div class="mdash-branch-title">
                                <strong>@item.BranchName</strong>
                                <span>@item.BranchCode · Responsable sede</span>
                            </div>

                            <div class="mdash-branch-metrics">
                                <div><small>Asignadas</small><b>@assigned</b></div>
                                <div><small>Validadas</small><b>@valid</b></div>
                                <div><small>Pendientes</small><b class="pending">@pending</b></div>
                                <div><small>Diferencias</small><b class="difference">@difference</b></div>
                            </div>

                            <div class="mdash-progress-row">
                                <div class="mdash-progress">
                                    <span style="@GetProgressStyle(percent)"></span>
                                </div>
                                <small>@percent%</small>
                            </div>
                        </article>
                    }
                </div>
            </section>

            <section class="mdash-card mdash-day">
                <h2>Mantenimientos por día</h2>

                <div class="mdash-day-metrics">
                    <div><strong>@dashboard.MaintenanceSummary.ThisMonth</strong><span>Por mes</span></div>
                    <div><strong>@dashboard.MaintenanceSummary.Today</strong><span>Por día</span></div>
                    <div><strong>@DashboardRequiresMaintenance</strong><span>Pendientes</span></div>
                </div>

                <div class="mdash-physical-row">
                    <div>
                        <h2>Toma física</h2>
                        <p>Acciones rápidas para control y cierre.</p>
                    </div>

                    <div class="mdash-actions">
                        <a href="/mobile/physical-counts">Volver</a>
                        <a href="/mobile/physical-counts">Participantes</a>
                        <a href="/mobile/physical-counts">Activar toma</a>
                        <a href="/mobile/reconciliation">Cerrar toma</a>
                    </div>
                </div>
            </section>

            <section class="mdash-card">
                <div class="mdash-section-head">
                    <div>
                        <h2>Últimos activos visibles</h2>
                        <p>Activos y herramientas visibles para la sesión actual.</p>
                    </div>

                    @if (CanViewInventory)
                    {
                        <a class="mdash-link-pill" href="/all-tools">Ver inventario</a>
                    }
                </div>

                @if (!VisibleTools.Any())
                {
                    <div class="mobile-empty compact">No hay activos visibles para esta sesión.</div>
                }
                else
                {
                    <div class="mobile-assigned-assets-list">
                        @foreach (var tool in VisibleTools.Take(6))
                        {
                            <article class="mobile-assigned-card">
                                <div class="mobile-assigned-card-head">
                                    <div>
                                        <span>@tool.InternalCode</span>
                                        <strong>@tool.Name</strong>
                                    </div>

                                    <em class="@GetToolStateClass(tool)">
                                        @GetStatusLabel(tool.OperationalStatus)
                                    </em>
                                </div>

                                <div class="mobile-assigned-grid">
                                    <div><span>Sede</span><strong>@Display(tool.BranchCode)</strong></div>
                                    <div><span>Ubicación</span><strong>@Display(tool.LocationName)</strong></div>
                                    <div><span>Responsable</span><strong>@Display(tool.ResponsiblePersonName)</strong></div>
                                    <div><span>Físico</span><strong>@Display(tool.PhysicalStatus)</strong></div>
                                </div>

                                <div class="mobile-assigned-actions">
                                    <a href="@GetDetailUrl(tool.Id)">Detalle</a>
                                    <a href="@GetLifeRecordUrl(tool.Id)">Hoja de vida</a>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="mdash-card mdash-history">
                <div class="mdash-section-head">
                    <div>
                        <h2>Histórico de procesos</h2>
                        <p>Últimos movimientos, validaciones y eventos registrados.</p>
                    </div>

                    <span>@dashboard.RecentActivity.Count eventos</span>
                </div>

                <div class="mdash-history-list">
                    @if (dashboard.RecentActivity.Any())
                    {
                        @foreach (var item in dashboard.RecentActivity.OrderByDescending(x => x.RegisteredAt).Take(8))
                        {
                            <article>
                                <div class="mdash-history-icon">@GetActivityIcon(item.EventType)</div>
                                <div>
                                    <strong>@item.Title</strong>
                                    <p>@Display(item.Description)</p>
                                    <small>@Display(item.ToolInternalCode) · @FormatDateTime(item.RegisteredAt) · @Display(item.User)</small>
                                </div>
                            </article>
                        }
                    }
                    else
                    {
                        <article>
                            <div class="mdash-history-icon">📊</div>
                            <div>
                                <strong>Dashboard ejecutivo actualizado</strong>
                                <p>Se consolidaron indicadores, gráficos de porcentaje, barras por sede y resumen operativo.</p>
                                <small>NAVI · Desarrollo visual</small>
                            </div>
                        </article>
                    }
                </div>
            </section>
        </section>
    }
</section>

@code {
    private bool isLoading = true;

    private bool CanViewDashboard => Auth.HasPermission("Dashboard.View");
    private bool isRefreshing;
    private string? errorMessage;
    private string? filterBranchCode;
    private string? filterOperationalStatus;
    private string? filterText;
    private MobileExecutiveDashboard? dashboard;

    private readonly (string Value, string Text)[] dashboardStatusFilters =
    {
        ("Available", "Disponible"),
        ("Assigned", "Asignada"),
        ("Loaned", "Prestada"),
        ("InMaintenance", "En mantenimiento"),
        ("Damaged", "Dañada"),
        ("NotSuitable", "No apta"),
        ("PendingValidation", "Pendiente de validación"),
        ("NotLocated", "No localizada"),
        ("Disposed", "Dada de baja")
    };
    private List<MobileToolDto> tools = new();

    private bool CanViewInventory => Auth.HasPermission("Tools.View");

    // NAVI DASHBOARD LOCAL FILTERED METRICS START
    private List<MobileToolDto> DashboardFilteredTools =>
        FilterByOperationalScope(tools)
            .Where(MatchesDashboardToolFilters)
            .OrderBy(x => x.BranchCode)
            .ThenBy(x => x.InternalCode)
            .ThenBy(x => x.SerialNumber)
            .ToList();

    private List<MobileBranchItem> DashboardToolsByBranch =>
        DashboardFilteredTools
            .GroupBy(x => new
            {
                Code = string.IsNullOrWhiteSpace(x.BranchCode) ? "-" : x.BranchCode!,
                Name = string.IsNullOrWhiteSpace(x.BranchName) ? (string.IsNullOrWhiteSpace(x.BranchCode) ? "-" : x.BranchCode!) : x.BranchName!
            })
            .Select(x => new MobileBranchItem
            {
                BranchCode = x.Key.Code,
                BranchName = x.Key.Name,
                Total = x.Count()
            })
            .OrderByDescending(x => x.Total)
            .ThenBy(x => x.BranchCode)
            .ToList();

    private int DashboardTotalTools => DashboardFilteredTools.Count;
    private int DashboardAvailableTools => CountDashboardStatus("Available");
    private int DashboardAssignedTools => CountDashboardStatus("Assigned");
    private int DashboardLoanedTools => CountDashboardStatus("Loaned");
    private int DashboardInMaintenanceTools => CountDashboardStatus("InMaintenance");
    private int DashboardDamagedTools => CountDashboardStatus("Damaged");
    private int DashboardNotLocatedTools => CountDashboardStatus("NotLocated");
    private int DashboardPendingValidationTools => CountDashboardStatus("PendingValidation");
    private int DashboardDisposedTools => CountDashboardStatus("Disposed");

    private int DashboardFixedAssets => DashboardFilteredTools.Count(x => !string.IsNullOrWhiteSpace(x.FixedAssetCode));
    private int DashboardToolsWithoutFixedAssetCode => DashboardFilteredTools.Count(x => string.IsNullOrWhiteSpace(x.FixedAssetCode));
    private int DashboardToolsOnly => DashboardFilteredTools.Count(x => string.IsNullOrWhiteSpace(x.FixedAssetCode));
    private int DashboardSpecializedTools => DashboardFilteredTools.Count(x => x.IsSpecialized);
    private int DashboardRequiresMaintenance => DashboardFilteredTools.Count(x => x.RequiresMaintenance);
    private int DashboardActiveBranches => DashboardFilteredTools
        .Select(x => Normalize(x.BranchCode ?? x.BranchName))
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    private int DashboardActiveResponsibles => DashboardFilteredTools
        .Select(x => x.ResponsiblePersonId?.ToString() ?? Normalize(x.ResponsiblePersonName))
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    private bool MatchesDashboardToolFilters(MobileToolDto tool)
    {
        if (!string.IsNullOrWhiteSpace(filterBranchCode))
        {
            var branch = filterBranchCode;

            if (!ContainsText(tool.BranchCode, branch) &&
                !ContainsText(tool.BranchName, branch) &&
                !ContainsText(tool.LocationName, branch) &&
                !ContainsText(tool.InternalCode, branch) &&
                !ContainsText(tool.SerialNumber, branch))
            {
                return false;
            }
        }

        if (!string.IsNullOrWhiteSpace(filterOperationalStatus) &&
            !SameNormalized(tool.OperationalStatus, filterOperationalStatus))
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(filterText))
        {
            var text = filterText;

            if (!ContainsText(tool.InternalCode, text) &&
                !ContainsText(tool.Name, text) &&
                !ContainsText(tool.SerialNumber, text) &&
                !ContainsText(tool.FixedAssetCode, text) &&
                !ContainsText(tool.FenixCode, text) &&
                !ContainsText(tool.BranchCode, text) &&
                !ContainsText(tool.BranchName, text) &&
                !ContainsText(tool.LocationName, text) &&
                !ContainsText(tool.ResponsiblePersonName, text) &&
                !ContainsText(tool.PhysicalStatus, text) &&
                !ContainsText(tool.OperationalStatus, text) &&
                !ContainsText(GetStatusLabel(tool.OperationalStatus), text))
            {
                return false;
            }
        }

        return true;
    }

    private int CountDashboardStatus(string status)
    {
        return DashboardFilteredTools.Count(x => SameNormalized(x.OperationalStatus, status));
    }

    private static bool ContainsText(string? value, string? expected)
    {
        var source = Normalize(value);
        var filter = Normalize(expected);

        return !string.IsNullOrWhiteSpace(source) &&
               !string.IsNullOrWhiteSpace(filter) &&
               source.Contains(filter, StringComparison.OrdinalIgnoreCase);
    }
    // NAVI DASHBOARD LOCAL FILTERED METRICS END

    private string ScopeLabel =>
        UserCanSeeAllBranches()
            ? "Todas las sedes"
            : Display(Auth.CurrentUser?.BranchName ?? Auth.CurrentUser?.BranchCode);

    private string DashboardHeroDescription =>
        $"{Display(Auth.CurrentUser?.DisplayName)} · {Display(Auth.CurrentUser?.BranchName)}";

    private List<MobileToolDto> VisibleTools =>
        DashboardFilteredTools
            .OrderByDescending(x => ContainsStatus(x.OperationalStatus, "Damaged") || ContainsStatus(x.PhysicalStatus, "Damaged"))
            .ThenBy(x => x.BranchCode)
            .ThenBy(x => x.InternalCode)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();

        if (!Auth.IsAuthenticated)
        {
            isLoading = false;
            return;
        }

        if (!CanViewDashboard)
        {
            isLoading = false;
            return;
        }

        await LoadDashboardAsync();
    }


    private async Task LoadDashboardAsync()
    {
        try
        {
            isRefreshing = true;
            errorMessage = null;

            dashboard = await Api.GetDashboardAsync(forceRefresh: true, branchCode: filterBranchCode, operationalStatus: filterOperationalStatus, q: filterText);
            tools = await Api.GetToolsAsync(forceRefresh: true);
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar el dashboard móvil. Valida que la API esté activa en http://localhost:5218. Detalle: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            isRefreshing = false;
        }
    }




    // NAVI DASHBOARD MOBILE PAGE FILTERS START
    private Task ApplyDashboardFiltersAsync()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task ClearDashboardFiltersAsync()
    {
        filterBranchCode = null;
        filterOperationalStatus = null;
        filterText = null;

        StateHasChanged();
        return Task.CompletedTask;
    }
    // NAVI DASHBOARD MOBILE PAGE FILTERS END

    private int GetAdvancePercent()
    {
        if (dashboard is null || DashboardTotalTools <= 0)
        {
            return 0;
        }

        return Math.Min(100, (int)Math.Round((decimal)dashboard.Summary.WithLifeRecord / DashboardTotalTools * 100));
    }

    private int GetToolsVsAssetsTotal()
    {
        if (dashboard is null)
        {
            return 0;
        }

        return DashboardToolsOnly +
               DashboardFixedAssets +
               DashboardToolsWithoutFixedAssetCode;
    }

    private int GetStatusDonutTotal()
    {
        if (dashboard is null)
        {
            return 0;
        }

        return DashboardAssignedTools +
               DashboardAvailableTools +
               DashboardPendingValidationTools +
               DashboardInMaintenanceTools +
               GetOtherStatusTools();
    }

    private int GetLifeRecordDonutTotal()
    {
        if (dashboard is null)
        {
            return 0;
        }

        return dashboard.Summary.WithLifeRecord +
               dashboard.Summary.WithoutLifeRecord +
               dashboard.LifeRecordCoverage.MissingTechnicalData +
               DashboardFixedAssets +
               GetOtherLifeRecords();
    }

    private int GetMaintenanceDonutTotal()
    {
        if (dashboard is null)
        {
            return 0;
        }

        return dashboard.MaintenanceSummary.ThisMonth +
               dashboard.MaintenanceSummary.Today +
               DashboardRequiresMaintenance;
    }

    private int GetOtherStatusTools()
    {
        if (dashboard is null)
        {
            return 0;
        }

        var known = DashboardAssignedTools +
                    DashboardAvailableTools +
                    DashboardPendingValidationTools +
                    DashboardInMaintenanceTools;

        return Math.Max(0, DashboardTotalTools - known);
    }

    private int GetOtherLifeRecords()
    {
        if (dashboard is null)
        {
            return 0;
        }

        var known = dashboard.Summary.WithLifeRecord +
                    dashboard.Summary.WithoutLifeRecord +
                    dashboard.LifeRecordCoverage.MissingTechnicalData +
                    DashboardFixedAssets;

        return Math.Max(0, DashboardTotalTools - known);
    }

    private int GetMaxBranch()
    {
        if (dashboard is null || !DashboardToolsByBranch.Any())
        {
            return 1;
        }

        return Math.Max(1, DashboardToolsByBranch.Max(x => x.Total));
    }

    private string GetToolsVsAssetsDonut()
    {
        if (dashboard is null)
        {
            return "background: #FFFFFF;";
        }

        return BuildDonut(
            new DashboardSegment(DashboardToolsOnly, "#354550"),
            new DashboardSegment(DashboardFixedAssets, "#C3CAC8"),
            new DashboardSegment(DashboardToolsWithoutFixedAssetCode, "#FFB301"));
    }

