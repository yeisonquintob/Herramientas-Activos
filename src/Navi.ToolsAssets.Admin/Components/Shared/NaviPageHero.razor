@using Microsoft.AspNetCore.Components

<section @attributes="AdditionalAttributes" class="@CssClass">
    <div class="navi-page-hero__content">
        @if (!string.IsNullOrWhiteSpace(Pill))
        {
            <span class="navi-page-hero__pill">@Pill</span>
        }

        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <h2 class="navi-page-hero__title">@Title</h2>
        }

        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="navi-page-hero__description">@Description</p>
        }

        @if (HeaderContent is not null)
        {
            <div class="navi-page-hero__extra">
                @HeaderContent
            </div>
        }
    </div>

    @if (Actions is not null || ChildContent is not null)
    {
        <div class="navi-page-hero__actions">
            @if (Actions is not null)
            {
                @Actions
            }
            else
            {
                @ChildContent
            }
        </div>
    }
</section>

@code {
    /// <summary>
    /// Texto corto superior del banner. Ejemplo: ACTIVOS FIJOS.
    /// </summary>
    [Parameter]
    public string? Pill { get; set; }

    /// <summary>
    /// Título principal del banner.
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// Descripción corta del banner.
    /// </summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>
    /// Contenido adicional opcional debajo de la descripción.
    /// No se recomienda para KPIs; los KPIs deben ir fuera del banner.
    /// </summary>
    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    /// <summary>
    /// Zona derecha de acciones del banner.
    /// Puede recibir botones, links o NaviActionButton.
    /// </summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>
    /// Forma corta para pasar acciones directamente dentro del componente.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Clases adicionales para casos específicos.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Atributos adicionales del section.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass
    {
        get
        {
            var baseClass = "navi-page-hero navi-page-hero--official navi-ui-hero";

            if (string.IsNullOrWhiteSpace(Class))
            {
                return baseClass;
            }

            return $"{baseClass} {Class}";
        }
    }
}
