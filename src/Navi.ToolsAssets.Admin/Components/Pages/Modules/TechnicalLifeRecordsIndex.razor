@page "/technical-life-records"
@rendermode InteractiveServer
@using Navi.ToolsAssets.Admin.Services.Auth
@using Navi.ToolsAssets.Admin.Components.Shared
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject NaviAccessScopeService AccessScope

<PageTitle>Hoja de Vida de Herramientas y AF - NAVI</PageTitle>

<PermissionGuard Permission="TechnicalLifeRecord.View" ModuleName="Hoja de Vida de Herramientas y AF">

<section class="technical-life-records-web-v31">

@* NAVI LIFE RECORDS WEB V31 TOP START *@

<NaviPageHero
    Pill="ACTIVOS FIJOS"
    Title="Hoja de Vida de Herramientas y AF"
    Description="Consulta consolidada de hojas de vida con datos generales, técnicos, ubicación, responsable, documentos, mantenimientos y trazabilidad." />

<NaviKpiToolbar
    Class="life-records-kpi-row-v31"
    Refresh="LoadAsync"
    IsRefreshing="isLoading"
    RefreshTitle="Actualizar hojas de vida"
    RefreshAriaLabel="Actualizar hojas de vida">

    <NaviKpiGrid
        Columns="5"
        Compact="true"
        Dividers="true"
        Class="life-records-kpis-v31">

        <NaviKpiCard
            Title="Total herramientas y AF"
            Description="Según filtros activos"
            Tone="neutral">

            <IconContent>
                <NaviKpiIcon Name="inventory" />
            </IconContent>

            <ValueContent>
                @FilteredTools.Count()
            </ValueContent>

        </NaviKpiCard>

        <NaviKpiCard
            Title="Con mantenimiento"
            Description="Control técnico"
            Tone="warning">

            <IconContent>
                <NaviKpiIcon Name="wrench" />
            </IconContent>

            <ValueContent>
                @FilteredTools.Count(
                    item => item.RequiresMaintenance)
            </ValueContent>

        </NaviKpiCard>

        <NaviKpiCard
            Title="Especializados"
            Description="Herramientas críticas"
            Tone="soft">

            <IconContent>
                <NaviKpiIcon Name="document" />
            </IconContent>

            <ValueContent>
                @FilteredTools.Count(
                    item => item.IsSpecialized)
            </ValueContent>

        </NaviKpiCard>

        <NaviKpiCard
            Title="Certificación"
            Description="Requieren control"
            Tone="warning">

            <IconContent>
                <NaviKpiIcon Name="calendar" />
            </IconContent>

            <ValueContent>
                @FilteredTools.Count(
                    item => item.RequiresCertification)
            </ValueContent>

        </NaviKpiCard>

        <NaviKpiCard
            Title="Preoperacional"
            Description="Validación previa"
            Tone="danger">

            <IconContent>
                <NaviKpiIcon Name="alert" />
            </IconContent>

            <ValueContent>
                @FilteredTools.Count(
                    item => item.RequiresPreOperationalCheck)
            </ValueContent>

        </NaviKpiCard>

    </NaviKpiGrid>

</NaviKpiToolbar>

@* NAVI LIFE RECORDS WEB V31 TOP END *@

@* NAVI LIFE RECORDS FILTERS V32 START *@

<section class="life-page-filters life-page-filters-v32"
         aria-label="Filtros de hojas de vida">

    <label class="life-filter-field-v32 life-filter-search-v32">

        <span>Buscar activo</span>

        <div class="life-filter-search-control-v32">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true"
                 focusable="false">

                <circle cx="10.5"
                        cy="10.5"
                        r="6.5">
                </circle>

                <path d="M15.5 15.5L21 21"></path>

            </svg>

            <input class="form-control form-control-sm"
                   placeholder="Código, nombre, serial, activo fijo, sede, ubicación o responsable..."
                   @bind="search"
                   @bind:event="oninput"
                   name="navi-technicalliferecordsindex-field-001" />

        </div>

    </label>

    <label class="life-filter-field-v32">

        <span>Sede</span>

        <select class="form-select form-select-sm"
                @bind="selectedBranchCode"
                name="navi-technicalliferecordsindex-field-002">

            <option value="">
                @(AccessScope.IsAllBranchScope()
                    ? "Todas las sedes visibles"
                    : AccessScope.GetDefaultBranchFilterText())
            </option>

            @foreach (var branch in BranchFilterOptions)
            {
                <option value="@branch.Code">
                    @branch.Code
                </option>
            }

        </select>

    </label>

    <label class="life-filter-field-v32">

        <span>Tipo general</span>

        <select class="form-select form-select-sm"
                @bind="selectedType"
                name="navi-technicalliferecordsindex-field-003">

            <option value="">Todos</option>

            @foreach (var type in LifeTypeOptions)
            {
                <option value="@type">
                    @type
                </option>
            }

        </select>

    </label>

</section>

@* NAVI LIFE RECORDS FILTERS V32 END *@

@* NAVI LIFE RECORDS WEB V31 STATUS START *@

<section class="life-status-filters-modern life-status-card-v31"
         aria-label="Estados de hoja de vida">

    <header>
        <div>
            <strong>Estado operativo</strong>

            <small>
                Selecciona un estado para limitar el listado.
            </small>
        </div>

        <span>
            @FilteredTools.Count() resultados
        </span>
    </header>

    <div class="life-status-list-v31">

        <button type="button"
                class="@GetLifeStatusFilterChipClass(string.Empty)"
                @onclick="@(() => SelectLifeStatus(string.Empty))"
                data-ntx-tone="ghost">

            <i aria-hidden="true"></i>

            <span>Todos</span>

            <strong>
                @LifeBaseFilteredTools.Count()
            </strong>
        </button>

        @foreach (var status in LifeStatusFilterOptions)
        {
            <button type="button"
                    class="@GetLifeStatusFilterChipClass(status.Value)"
                    @onclick="@(() => SelectLifeStatus(status.Value))"
                    data-ntx-tone="ghost">

                <i aria-hidden="true"></i>

                <span>@status.Label</span>

                <strong>@status.Count</strong>
            </button>
        }

    </div>
</section>

@* NAVI LIFE RECORDS WEB V31 STATUS END *@

<section class="af-card">
    <div class="af-table-header">
        <div>
            <h3>Hojas de vida registradas</h3>
            <p>Abre la hoja de vida para gestionar datos técnicos, accesorios, documentos, mantenimiento, prácticas seguras y trazabilidad.</p>
        </div>
    </div>

    @if (isLoading)
    {
        <p role="status" aria-busy="true">Cargando hojas de vida...</p>
    }
    else if (!FilteredTools.Any())
    {
        <div class="alert alert-info">No hay hojas de vida para mostrar.</div>
    }
    else
    {
        <div class="ntx-table-scroll">
            <table class="table table-hover align-middle af-table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Activo fijo</th>
                    <th>Clasificación</th>
                    <th>Sede / ubicación</th>
                    <th>Responsable</th>
                    <th>Estado</th>
                    <th>Controles</th>
                    <th class="text-end">Hoja de vida</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var tool in FilteredTools)
                {
                    <tr>
                        <td>
                            <strong>@tool.InternalCode</strong>
                            <div>
                                <small class="text-muted">@Show(tool.FixedAssetCode)</small>
                            </div>
                        </td>

                        <td>
                            <div>@tool.Name</div>
                            <small class="text-muted">@Show(tool.SerialNumber)</small>
                        </td>

                        <td>
                            <div>@Show(tool.ToolTypeName)</div>
                            <small class="text-muted">@Show(tool.ToolCategoryName)</small>
                        </td>

                        <td>
                            <div>@Show(tool.BranchCode)</div>
                            <small class="text-muted">@Show(tool.LocationName)</small>
                        </td>

                        <td>@Show(tool.ResponsiblePersonName)</td>

                        <td>
                            <span class="@GetStatusBadge(tool.OperationalStatus)">
                                @GetStatusLabel(tool.OperationalStatus)
                            </span>
                        </td>

                        <td>
                            <div class="life-flags">
                                @if (tool.RequiresMaintenance)
                                {
                                    <span>Mantenimiento</span>
                                }

                                @if (tool.RequiresPreOperationalCheck)
                                {
                                    <span>Preoperacional</span>
                                }

                                @if (tool.RequiresCertification)
                                {
                                    <span>Certificación</span>
                                }

                                @if (tool.IsSpecialized)
                                {
                                    <span>Especializado</span>
                                }
                            </div>
                        </td>

                        <td class="text-end">
                            <a class="btn-life-main" href="@($"/tools/{tool.Id}/technical-life-record?from=life-records")" data-ntx-tone="operation" >
                                <span>Ver hoja de vida</span>
                                <strong>↗</strong>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</section>

</section>

</PermissionGuard>



@code {
    private HttpClient Api => HttpClientFactory.CreateClient("NaviApi");

    private List<ToolItem> tools = new();
    private List<BranchItem> branches = new();

    private bool isLoading;
    private string search = string.Empty;
    private string selectedBranchCode = string.Empty;
    private string selectedStatus = string.Empty;
    private string selectedType = string.Empty;
    private bool branchFilterInitialized;

    private IEnumerable<ToolItem> ScopedTools =>
        AccessScope.FilterTools(
            tools,
            x => x.BranchCode,
            x => x.ResponsiblePersonName);

    private IEnumerable<BranchItem> BranchFilterOptions =>
        AccessScope.IsAllBranchScope()
            ? branches
            : branches.Where(x => string.Equals(x.Code, AccessScope.GetDefaultBranchCode(), StringComparison.OrdinalIgnoreCase));

    private IEnumerable<ToolItem> LifeBaseFilteredTools =>
        ScopedTools
            .Where(x => string.IsNullOrWhiteSpace(search) ||
                        Contains(x.InternalCode, search) ||
                        Contains(x.Name, search) ||
                        Contains(x.SerialNumber, search) ||
                        Contains(x.FixedAssetCode, search) ||
                        Contains(x.BranchCode, search) ||
                        Contains(x.LocationName, search) ||
                        Contains(x.ResponsiblePersonName, search) ||
                        Contains(x.ToolTypeName, search) ||
                        Contains(x.ToolCategoryName, search))
            .Where(x => string.IsNullOrWhiteSpace(selectedBranchCode) ||
                        string.Equals(x.BranchCode, selectedBranchCode, StringComparison.OrdinalIgnoreCase))
            .Where(x =>
                string.IsNullOrWhiteSpace(selectedType)
                ||
                string.Equals(
                    GetLifeAssetClass(x),
                    selectedType,
                    StringComparison.OrdinalIgnoreCase));

    private IEnumerable<ToolItem> FilteredTools =>
        LifeBaseFilteredTools
            .Where(x => string.IsNullOrWhiteSpace(selectedStatus) ||
                        string.Equals(x.OperationalStatus, selectedStatus, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.BranchCode)
            .ThenBy(x => x.InternalCode);


    private IEnumerable<LifeStatusFilterOption> LifeStatusFilterOptions =>
        LifeBaseFilteredTools
            .Where(x => !string.IsNullOrWhiteSpace(x.OperationalStatus))
            .GroupBy(x => x.OperationalStatus)
            .Select(x => new LifeStatusFilterOption
            {
                Value = x.Key,
                Label = GetStatusLabel(x.Key),
                Count = x.Count()
            })
            .OrderBy(x => x.Label);

    private IEnumerable<string> LifeTypeOptions =>
        ScopedTools
            .Select(GetLifeAssetClass)
            .Where(value =>
                !string.IsNullOrWhiteSpace(value))
            .Distinct(
                StringComparer.OrdinalIgnoreCase)
            .OrderBy(value =>
                string.Equals(
                    value,
                    "Activo fijo",
                    StringComparison.OrdinalIgnoreCase)
                    ? 0
                    : 1)
            .ThenBy(value => value);

    private static string GetLifeAssetClass(
        ToolItem item)
    {
        var typeName =
            item.ToolTypeName?.Trim()
            ?? string.Empty;

        /*
         * Toda denominación relacionada directamente
         * con herramienta se agrupa como Herramienta.
         *
         * Equipos, celulares, computadores, escáneres
         * y demás activos quedan como Activo fijo.
         */
        if (
            typeName.Contains(
                "herramienta",
                StringComparison.OrdinalIgnoreCase)
            ||
            string.Equals(
                typeName,
                "tool",
                StringComparison.OrdinalIgnoreCase)
            ||
            string.Equals(
                typeName,
                "tools",
                StringComparison.OrdinalIgnoreCase))
        {
            return "Herramienta";
        }

        return "Activo fijo";
    }


    private void SelectLifeStatus(string status)
    {
        selectedStatus = status;
    }

    private string GetLifeStatusFilterChipClass(string? status)
    {
        var value = status ?? string.Empty;

        var selected = string.Equals(
            selectedStatus ?? string.Empty,
            value,
            StringComparison.OrdinalIgnoreCase)
            ? " active"
            : string.Empty;

        var statusClass = string.IsNullOrWhiteSpace(value)
            ? "all"
            : NormalizeLifeStatusCss(value);

        return $"life-status-filter-chip life-status-{statusClass}{selected}";
    }

    private static string NormalizeLifeStatusCss(string status) => status switch
    {
        "Available" => "available",
        "Assigned" => "assigned",
        "Loaned" => "loaned",
        "InMaintenance" => "maintenance",
        "Damaged" => "damaged",
        "NotSuitable" => "not-suitable",
        "PendingValidation" => "pending",
        "NotLocated" => "not-located",
        "PendingDisposal" => "disposal",
        "Disposed" => "disposed",
        _ => "other"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;

        try
        {
            tools = await Api.GetFromJsonAsync<List<ToolItem>>("api/tools") ?? new();
            branches = await Api.GetFromJsonAsync<List<BranchItem>>("api/settings/branches") ?? new();

            if (!branchFilterInitialized)
            {
                selectedBranchCode = AccessScope.GetDefaultBranchCode();
                branchFilterInitialized = true;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private static bool Contains(string? source, string? value)
    {
        return !string.IsNullOrWhiteSpace(source) &&
               !string.IsNullOrWhiteSpace(value) &&
               source.Contains(value, StringComparison.OrdinalIgnoreCase);
    }

    private static string Show(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "—" : value;
    }

    private static string GetStatusLabel(string status) => status switch
    {
        "Available" => "Disponible",
        "Assigned" => "Asignada",
        "Loaned" => "Prestada",
        "InMaintenance" => "En mantenimiento",
        "Damaged" => "Dañada",
        "NotSuitable" => "No apta",
        "PendingValidation" => "Pendiente validación",
        "NotLocated" => "No localizada",
        "PendingDisposal" => "Pendiente baja",
        "Disposed" => "Dada de baja",
        _ => NaviStatusLabels.ToSpanish(status)
    };

    private static string GetStatusBadge(string status) => status switch
    {
        "Available" => "navi-status-badge navi-status-available",
        "Assigned" => "navi-status-badge navi-status-assigned",
        "Loaned" => "navi-status-badge navi-status-assigned",
        "InMaintenance" => "navi-status-badge navi-status-maintenance",
        "Damaged" => "navi-status-badge navi-status-damaged",
        "NotSuitable" => "navi-status-badge navi-status-not-suitable",
        "NotLocated" => "navi-status-badge navi-status-not-located",
        "Disposed" => "navi-status-badge navi-status-disposed",
        "PendingValidation" => "navi-status-badge navi-status-pending",
        _ => "navi-status-badge navi-status-muted"
    };


    private sealed class LifeStatusFilterOption
    {
        public string Value { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public int Count { get; set; }
    }

    private sealed class ToolItem
    {
        public Guid Id { get; set; }

        public string InternalCode { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public string? SerialNumber { get; set; }

        public string? FixedAssetCode { get; set; }

        public string? BranchCode { get; set; }

        public string? LocationName { get; set; }

        public string? ResponsiblePersonName { get; set; }

        public string? ToolTypeName { get; set; }

        public string? ToolCategoryName { get; set; }

        public string OperationalStatus { get; set; } = string.Empty;

        public bool IsSpecialized { get; set; }

        public bool RequiresMaintenance { get; set; }

        public bool RequiresPreOperationalCheck { get; set; }

        public bool RequiresCertification { get; set; }
    }

    private sealed class BranchItem
    {
        public string Code { get; set; } = string.Empty;
    }
}
