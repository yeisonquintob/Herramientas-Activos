@page "/asset-assignment"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject NaviAccessScopeService AccessScope
@using Navi.ToolsAssets.Admin.Services.Auth
@using Navi.ToolsAssets.Admin.Services.Ui
@using Navi.ToolsAssets.Admin.Components.Shared
@inject NavigationManager NavigationManager
@inject WebAuthSessionService AuthSession
@inject NaviAdminNotificationState Notifications

<PageTitle>Asignar Herramientas y AF - NAVI</PageTitle>

<PermissionGuard Permission="AssetAssignment.View" ModuleName="Asignar Herramientas y AF">

<section class="assignment-web-v24">

<NaviPageHero
    Pill="ACTIVOS FIJOS"
    Title="Asignar Herramientas y AF"
    Description="Solicita, aprueba, asigna o regresa activos fijos con trazabilidad de préstamo y responsable." />

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="@messageClass assignment-v24-message"
         role="status">

        @message
    </div>
}


<NaviKpiToolbar Class="assignment-v24-kpi-row"
                Refresh="LoadAsync"
                IsRefreshing="isLoading"
                RefreshTitle="Actualizar información"
                RefreshAriaLabel="Actualizar información">
    <NaviKpiGrid Columns="5" Dividers="true" Class="assignment-v24-kpis">
        <NaviKpiCard Title="Activos visibles"
                     Description="Según filtros y alcance"
                     Tone="neutral">
            <IconContent><NaviKpiIcon Name="inventory" /></IconContent>
            <ValueContent>@FilteredTools.Count()</ValueContent>
        </NaviKpiCard>
        <NaviKpiCard Title="Disponibles"
                     Description="Listos para asignar"
                     Tone="positive">
            <IconContent><NaviKpiIcon Name="check" /></IconContent>
            <ValueContent>
                @(FilteredTools.Count(item =>
                    string.Equals(item.OperationalStatus, "Available", StringComparison.OrdinalIgnoreCase)))
            </ValueContent>
        </NaviKpiCard>
        <NaviKpiCard Title="En uso"
                     Description="Asignadas o prestadas"
                     Tone="soft">
            <IconContent><NaviKpiIcon Name="transfer" /></IconContent>
            <ValueContent>
                @(FilteredTools.Count(item =>
                    string.Equals(item.OperationalStatus, "Assigned", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(item.OperationalStatus, "Loaned", StringComparison.OrdinalIgnoreCase)))
            </ValueContent>
        </NaviKpiCard>
        <NaviKpiCard Title="Solicitudes"
                     Description="Pendientes de decisión"
                     Tone="warning">
            <IconContent><NaviKpiIcon Name="document" /></IconContent>
            <ValueContent>
                @(FilteredTools.Count(item => FindPendingRequestForTool(item.Id) is not null))
            </ValueContent>
        </NaviKpiCard>
        <NaviKpiCard Title="Sin responsable"
                     Description="Disponibles o por revisar"
                     Tone="danger">
            <IconContent><NaviKpiIcon Name="users" /></IconContent>
            <ValueContent>@(FilteredTools.Count(item => item.ResponsiblePersonId is null))</ValueContent>
        </NaviKpiCard>
    </NaviKpiGrid>
</NaviKpiToolbar>

<section class="assignment-v24-filter-card"
         aria-label="Filtros de asignación">

    <label class="assignment-v24-field assignment-v24-search">

        <span>Buscar activo</span>

        <div>

            <svg viewBox="0 0 24 24"
                 aria-hidden="true"
                 focusable="false">

                <circle cx="10.5"
                        cy="10.5"
                        r="6.5">
                </circle>

                <path d="M15.5 15.5L21 21"></path>
            </svg>

            <input id="assignment-table-search"
                   name="assignment-table-search"
                   type="search"
                   autocomplete="off"
                   placeholder="Código, nombre, serial, sede, ubicación o responsable..."
                   @bind="search"
                   @bind:event="oninput" />
        </div>
    </label>

    <label class="assignment-v24-field">

        <span>Sede</span>

        <input id="assignment-table-branch"
               name="assignment-table-branch"
               type="text"
               autocomplete="off"
               list="assignment-table-branches-list"
               value="@selectedBranchSearchText"
               @oninput="OnTableBranchSearchInput"
               placeholder="Todas las sedes" />
    </label>

    <datalist id="assignment-table-branches-list">

        @if (IsAllBranchScope())
        {
            <option value="Todas las sedes">
            </option>
        }

        @foreach (var branch in BranchFilterOptions)
        {
            <option value="@FormatBranchOption(branch)">
            </option>

            <option value="@branch.Code">
            </option>

            <option value="@branch.Name">
            </option>
        }
    </datalist>

    <label class="assignment-v24-field">

        <span>Responsable</span>

        <input id="assignment-table-responsible"
               name="assignment-table-responsible"
               type="text"
               autocomplete="off"
               list="table-responsibles-list"
               value="@selectedResponsibleSearchText"
               @oninput="OnTableResponsibleSearchInput"
               placeholder="Todos los usuarios" />
    </label>

    <datalist id="table-responsibles-list">

        <option value="Todos los usuarios">
        </option>

        <option value="Sin responsable">
        </option>

        @foreach (var responsible in responsibles.OrderBy(
            item => item.FullName))
        {
            <option value="@FormatResponsibleOption(responsible)">
            </option>

            <option value="@responsible.FullName">
            </option>
        }
    </datalist>

    <div class="assignment-v24-filter-result">

        <span>Resultado</span>

        <strong>
            @FilteredTools.Count()
        </strong>

        <small>activos visibles</small>
    </div>
</section>

<section class="assignment-v24-status-card"
         aria-label="Estados de asignación">

    <header>

        <div>
            <strong>Estado operativo</strong>

            <small>
                Selecciona uno o varios estados para limitar el listado.
            </small>
        </div>

        <span>
            @AssignmentBaseFilteredTools.Count() registros
        </span>
    </header>

    <div class="assignment-v24-status-list">

        <button type="button"
                class="assignment-v24-status-chip assignment-status-all @(selectedToolStatuses.Count == 0 ? "active" : string.Empty)"
                @onclick="ClearToolStatusFilter" data-ntx-tone="ghost">

            <i aria-hidden="true"></i>

            <span>Todos</span>

            <strong>
                @AssignmentBaseFilteredTools.Count()
            </strong>
        </button>

        @foreach (var status in ToolStatusFilterOptions)
        {
            var selected =
                selectedToolStatuses.Contains(
                    status.Value);

            <button type="button"
                    class="assignment-v24-status-chip @(GetAssignmentStatusChipClass(status.Value, selected))"
                    @onclick="() => ToggleToolStatusFilter(status.Value)" data-ntx-tone="expand">

                <i aria-hidden="true"></i>

                <span>@status.Text</span>

                <strong>
                    @(AssignmentBaseFilteredTools.Count(item =>
                        string.Equals(
                            item.OperationalStatus,
                            status.Value,
                            StringComparison.OrdinalIgnoreCase)))
                </strong>
            </button>
        }

    </div>
</section>

<section class="af-grid">
    <aside class="af-left-stack">
        <div class="af-card">
            <h3>@GetMovementTitle()</h3>

            <div class="mb-2 navi-search-field">
                <label class="form-label">Activo fijo</label>
                <input class="form-control"
                       list="assignment-tools-list"
                       value="@assignmentToolSearchText"
                       @oninput="OnAssignmentToolSearchInput"
                       placeholder="Escriba código, nombre o serial..." />

                <datalist id="assignment-tools-list">
                    @foreach (var tool in AssignmentToolOptions.OrderBy(x => x.InternalCode))
                    {
                        <option value="@FormatToolOption(tool)"></option>
                    }
                </datalist>

                <small class="@GetAssignmentToolHintClass()">@GetAssignmentToolHint()</small>
            </div>

            <div class="mb-2">
                <label class="form-label">Tipo de movimiento</label>
                <InputSelect class="form-select" @bind-Value="form.AssignmentType">
                    <option value="Responsible">Asignar a usuario/responsable</option>
                    <option value="Warehouse">Regresar a almacén/taller</option>
                </InputSelect>
            </div>

            @if (form.AssignmentType == "Responsible")
            {
                <div class="mb-2 navi-search-field">
                    <label class="form-label">Usuario / Responsable</label>
                    <input class="form-control"
                           list="assignment-responsibles-list"
                           value="@assignmentResponsibleSearchText"
                           @oninput="OnAssignmentResponsibleSearchInput"
                           placeholder="Escriba nombre, cargo o responsable..." />

                    <datalist id="assignment-responsibles-list">
                        @foreach (var responsible in responsibles.OrderBy(x => x.FullName))
                        {
                            <option value="@FormatResponsibleOption(responsible)"></option>
                        }
                    </datalist>

                    <small class="@GetAssignmentResponsibleHintClass()">@GetAssignmentResponsibleHint()</small>
                </div>
            }

            @if (form.AssignmentType == "Warehouse")
            {
                <div class="mb-2 navi-search-field">
                    <label class="form-label">Sede destino</label>
                    <input class="form-control"
                           list="assignment-branches-list"
                           value="@assignmentBranchSearchText"
                           @oninput="OnAssignmentBranchSearchInput"
                           placeholder="Escriba código o nombre de sede..." />

                    <datalist id="assignment-branches-list">
                        @foreach (var branch in branches.OrderBy(x => x.Code))
                        {
                            <option value="@FormatBranchOption(branch)"></option>
                        }
                    </datalist>

                    <small class="@GetAssignmentBranchHintClass()">@GetAssignmentBranchHint()</small>
                </div>

                <div class="mb-2 navi-search-field">
                    <label class="form-label">Almacén / Taller destino</label>
                    <input class="form-control"
                           list="assignment-locations-list"
                           value="@assignmentLocationSearchText"
                           @oninput="OnAssignmentLocationSearchInput"
                           placeholder="Escriba almacén, taller o ubicación..." />

                    <datalist id="assignment-locations-list">
                        @foreach (var location in AvailableLocations.OrderBy(x => x.Code))
                        {
                            <option value="@FormatLocationOption(location)"></option>
                        }
                    </datalist>

                    <small class="@GetAssignmentLocationHintClass()">@GetAssignmentLocationHint()</small>
                </div>

                <div class="mb-2">
                    <label class="form-label">Estantería / ubicación exacta destino</label>
                    <InputText class="form-control"
                               @bind-Value="form.ShelfLocation"
                               placeholder="Ej: EST-A1, RACK-3, CAJÓN 2" />
                    <small class="navi-search-hint ok">Punto exacto donde queda guardado el activo al regresar al almacén/taller.</small>
                </div>

            }

            <div class="mb-2">
                <label class="form-label">
                    @(form.AssignmentType == "Warehouse" ? "Fecha de regreso" : "Fecha de asignación")
                </label>
                <InputDate class="form-control" @bind-Value="form.AssignmentDate" />
            </div>

            <div class="mb-3">
                <label class="form-label">Observación</label>
                <InputTextArea class="form-control" @bind-Value="form.Observation" rows="3" />
            </div>

            <div class="d-grid gap-2">
                @if (form.AssignmentType == "Warehouse")
                {
                    <button type="button" class="assign-main assignment-v25-confirm" @onclick="SaveAsync" disabled="@(isSaving || !CanReturnAsset)" data-ntx-tone="affirmative">
                        @(isSaving ? "Guardando..." : "Confirmar regreso")
                    </button>
                }
                else
                {
                    <button type="button" class="assign-main assignment-v25-confirm" @onclick="SaveAsync" disabled="@(isSaving || !CanAssignAsset)" data-ntx-tone="affirmative">
                        @(isSaving ? "Guardando..." : "Confirmar asignación")
                    </button>
                }

                <button class="assign-main assign-main-neutral" @onclick="ClearForm" data-ntx-tone="secondary" >
                    Limpiar
                </button>
            </div>
        </div>

        <div class="af-card history-launch-card">
            <span class="history-pill">HISTORIAL</span>
            <h3>Historial por usuario</h3>
            <p>Consulta en una vista completa los activos asignados, entregados, regresados y sus detalles.</p>

            <div class="mb-2">
                <label class="form-label">Usuario / Responsable</label>
                <input class="form-control form-control-sm"
                       list="history-responsibles-list"
                       value="@historyResponsibleSearchText"
                       @oninput="OnHistoryResponsibleSearchInput"
                       placeholder="Escriba usuario o responsable..." />

                <datalist id="history-responsibles-list">
                    <option value="Todos los usuarios"></option>
                    @foreach (var responsible in responsibles.OrderBy(x => x.FullName))
                    {
                        <option value="@FormatResponsibleOption(responsible)"></option>
                    }
                </datalist>
            </div>

            <div class="mb-3">
                <label class="form-label">Buscar</label>
                <input class="form-control form-control-sm"
                       placeholder="Código, activo fijo, serial o detalle..."
                       @bind="historySearch"
                       @bind:event="oninput" />
            </div>

            <button class="btn-open-history" @onclick="OpenHistory" disabled="@(!CanViewAssignmentHistory)" data-ntx-tone="consult" >
                Abrir historial de asignaciones
            </button>
        </div>

        <div class="af-card request-card">
            <span class="history-pill request">SOLICITUD</span>
            <h3>Solicitud de asignación</h3>
            <p>Busca una herramienta y solicita que sea asignada a tu usuario. El herramentero la aprueba desde esta misma vista.</p>

            <div class="request-user">
                <span>Solicitante</span>
                <strong>@GetCurrentResponsibleLabel()</strong>
            </div>

            @if (!CanRequestAssignment)
            {
                <div class="assignment-request-warning">
                    No tienes permiso AssetAssignment.Request para crear solicitudes de asignación.
                </div>
            }
            else if (CurrentRequesterPersonId is null)
            {
                <div class="assignment-request-info">
                    No hay responsable operativo asociado al usuario. Asócialo en Configuración > Usuarios antes de crear solicitudes.
                </div>
            }

            <div class="mb-2">
                <label class="form-label">Buscar herramienta</label>
                <input class="form-control form-control-sm"
                       placeholder="Escriba código, nombre o serial..."
                       @bind="requestSearch"
                       @bind:event="oninput" />
            </div>

            @if (!requestForm.ToolId.HasValue && !string.IsNullOrWhiteSpace(requestSearch))
            {
                <div class="request-results">
                    <div class="request-results-title">
                        <div>
                            <span>Disponibles para solicitar</span>
                            <small>
                                Solo herramientas disponibles y sin solicitud activa.
                            </small>
                        </div>

                        <strong>@RequestTools.Count()</strong>
                    </div>

                    @if (!RequestTools.Any())
                    {
                        <div class="request-result-empty">
                            No hay herramientas disponibles con ese criterio.
                        </div>
                    }
                    else
                    {
                        @foreach (var tool in RequestTools.Take(7))
                        {
                            var pending = FindPendingRequestForTool(tool.Id);
                            var isSelected = requestForm.ToolId == tool.Id;

                            <button type="button"
                                    class="request-result-card @(isSelected ? "selected" : "")"
                                    @onclick="() => SelectRequestTool(tool)" data-ntx-tone="ghost" >
                                <span>
                                    <strong>@tool.InternalCode</strong>
                                    <small>@tool.Name</small>
                                    <small>@Show(tool.BranchCode) · @Show(tool.LocationName) · Almacén/Taller: @Show(ResolveWarehouseNameV2301(tool))</small>
                                </span>

                                <em class="request-status request-status-available request-status-available-v54">
                                    <span aria-hidden="true">✓</span>
                                    Disponible
                                </em>
                            </button>
                        }
                    }
                </div>
            }

            @if (SelectedRequestTool is not null)
            {
                <div class="selected-request-tool">
                    <div>
                        <span>Herramienta seleccionada</span>
                        <strong>@SelectedRequestTool.InternalCode - @SelectedRequestTool.Name</strong>
                        <small>@Show(SelectedRequestTool.BranchCode) · @Show(SelectedRequestTool.LocationName) · Almacén/Taller: @Show(ResolveWarehouseNameV2301(SelectedRequestTool))</small>
                    </div>

                    <button type="button" @onclick="ClearRequestToolSelection" data-ntx-tone="operation" >
                        Cambiar
                    </button>
                </div>
            }

            <div class="mb-2">
                <label class="form-label">Fecha estimada de devolución</label>
                <InputDate class="form-control form-control-sm" @bind-Value="requestForm.ExpectedReturnAt" />
            </div>

            <div class="mb-3">
                <label class="form-label">Observación</label>
                <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="requestForm.Notes" />
            </div>

            @if (!CanRequestAssignment)
            {
                <div class="assignment-permission-note">
                    Solicitud bloqueada por permiso AssetAssignment.Request.
                </div>
            }

            <button type="button"
                    class="btn-request-assignment"
                    @onclick="SubmitSelfAssignmentRequestAsync"
                    disabled="@(isSaving
                                || !CanRequestAssignment
                                || CurrentRequesterPersonId is null
                                || !requestForm.ToolId.HasValue
                                || SelectedRequestToolHasPendingRequest)" data-ntx-tone="affirmative" >
                @(isSaving ? "Registrando..." : "Solicitud de asignación")
            </button>
        </div>

        <div id="solicitudes-pendientes" class="af-card pending-card">
            <span class="history-pill approve">APROBACIÓN</span>
            <div class="assignment-v25-pending-title">

                <h3>Solicitudes pendientes</h3>

                <strong>
                    @PendingLoanRequests.Count()
                </strong>
            </div>

            @if (!PendingLoanRequests.Any())
            {
                <div class="pending-empty">No hay solicitudes pendientes.</div>
            }
            else
            {
                <div class="pending-list">
                    @foreach (var request in PendingLoanRequests.Take(6))
                    {
                        var item = request.Items.FirstOrDefault();

                        <article>
                            <div>
                                <strong>@request.LoanNumber</strong>
                                <span>@Show(item?.ToolInternalCode) - @Show(item?.ToolName)</span>
                                <small>Solicita: @Show(request.CreatedBy) · @ShowDate(request.RequestedAt)</small>
                            </div>

                            <div class="pending-actions">
                                <button class="approve" @onclick="() => ApproveRequestAsync(request)"
                                        disabled="@(isSaving || !CanApproveAssignmentRequest)" data-ntx-tone="affirmative" >
                                    Aprobar
                                </button>

                                <button class="deny" @onclick="() => RejectRequestAsync(request)"
                                        disabled="@(isSaving || !CanDenyAssignmentRequest)" data-ntx-tone="danger" >
                                    Denegar
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </aside>

    <section class="af-card">
        <div class="af-table-header">
            <div>
                <h3>Activos asignables</h3>
                <p>Consulta el estado actual y registra asignaciones, regresos o aprobaciones.</p>
            </div>
        </div>

        @if (isLoading)
        {
            <p>Cargando activos...</p>
        }
        else if (!FilteredTools.Any())
        {
            <div class="alert alert-info">No hay activos para los filtros seleccionados.</div>
        }
        else
        {
            <div class="assignment-v24-table-wrap">

    <table class="assignment-v24-table">

        <thead>
            <tr>
                <th>Código</th>
                <th>Activo e identificación</th>
                <th>Sede y ubicación</th>
                <th>Responsable</th>
                <th>Estado y solicitud</th>
                <th>Fechas</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var tool in FilteredTools)
            {
                var pending =
                    FindPendingRequestForTool(
                        tool.Id);

                <tr>

                    <td class="assignment-v24-code">

                        <strong>
                            @tool.InternalCode
                        </strong>
                    </td>

                    <td class="assignment-v24-tool">

                        <strong>
                            @tool.Name
                        </strong>

                        <small>
                            Serial:
                            @Show(tool.SerialNumber)
                        </small>
                    </td>

                    <td class="assignment-v24-location">
                        @* NAVI ASSIGNMENT WAREHOUSE DISPLAY V230.1 *@

                        <strong>
                            @Show(tool.BranchCode)
                        </strong>

                        <span>
                            @Show(tool.LocationName)
                        </span>

                        <small>
                            Almacén / Taller:
                            @Show(ResolveWarehouseNameV2301(tool))
                        </small>
                    </td>

                    <td class="assignment-v24-responsible">

                        <strong>
                            @Show(tool.ResponsiblePersonName)
                        </strong>

                        <small>
                            @Show(tool.ResponsiblePosition)
                        </small>
                    </td>

                    <td class="assignment-v24-state">

                        <span class="@GetStatusBadge(
                            tool.OperationalStatus)">

                            @GetStatusLabel(
                                tool.OperationalStatus)
                        </span>

                        @if (pending is null)
                        {
                            <small class="request-state empty">
                                Sin solicitud
                            </small>
                        }
                        else
                        {
                            <small class="request-state pending">
                                @pending.LoanNumber
                            </small>
                        }
                    </td>

                    <td class="assignment-v24-dates">

                        <div>
                            <span>Asignación</span>

                            <strong>
                                @ShowDate(tool.LastAssignmentDate)
                            </strong>
                        </div>

                        <div>
                            <span>Regreso</span>

                            <strong>
                                @ShowDate(tool.LastReturnDate)
                            </strong>
                        </div>
                    </td>

                    <td class="assignment-v24-actions-cell">

                        <div class="assignment-actions">

                            <button type="button"
                                    class="assign-action assign-action-primary"
                                    title="Asignar activo"
                                    aria-label="Asignar activo"
                                    @onclick="() => SelectForAssignment(tool)"
                                    disabled="@(pending is not null || !CanDirectAssign)"
                                     data-ntx-tone="operation">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true"
                                     focusable="false">

                                    <circle cx="9"
                                            cy="8"
                                            r="3">
                                    </circle>

                                    <path d="M3 20C3.8 15.8 6.2 14 9 14"></path>
                                    <path d="M15 12H21"></path>
                                    <path d="M18 9V15"></path>
                                </svg>

                                <span>Asignar</span>
                            </button>

                            <button type="button"
                                    class="assign-action assign-action-success"
                                    title="Aprobar solicitud"
                                    aria-label="Aprobar solicitud"
                                    @onclick="() => ApproveRequestAsync(pending)"
                                    disabled="@(pending is null || !CanApproveAssignmentRequest || isSaving)" data-ntx-tone="affirmative">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true"
                                     focusable="false">

                                    <path d="M5 12L10 17L19 7"></path>
                                </svg>

                                <span>Aprobar</span>
                            </button>

                            <button type="button"
                                    class="assign-action assign-action-danger"
                                    title="Denegar solicitud"
                                    aria-label="Denegar solicitud"
                                    @onclick="() => RejectRequestAsync(pending)"
                                    disabled="@(pending is null || !CanDenyAssignmentRequest || isSaving)" data-ntx-tone="danger">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true"
                                     focusable="false">

                                    <path d="M5 5L19 19"></path>
                                    <path d="M19 5L5 19"></path>
                                </svg>

                                <span>Denegar</span>
                            </button>

                            <button type="button"
                                    class="assign-action assign-action-warning"
                                    title="Registrar regreso"
                                    aria-label="Registrar regreso"
                                    @onclick="() => SelectForReturn(tool)"
                                    disabled="@(!CanReturnAssignment)" data-ntx-tone="warning">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true"
                                     focusable="false">

                                    <path d="M9 7H19V17H9"></path>
                                    <path d="M9 12H4"></path>
                                    <path d="M7 9L4 12L7 15"></path>
                                </svg>

                                <span>Regresar</span>
                            </button>

                        </div>
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>
        }
    </section>
</section>

</section>

</PermissionGuard>



@code {
