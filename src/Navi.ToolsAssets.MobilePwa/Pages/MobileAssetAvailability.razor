    private string GetAvailabilityStatusFilterChipClass(string? status)
    {
        var value = status ?? string.Empty;

        var selected = SameNormalized(selectedStatus, value)
            ? " active"
            : string.Empty;

        var statusClass = string.IsNullOrWhiteSpace(value)
            ? "all"
            : NormalizeStatusCss(value);

        return $"mobile-av-status-chip mobile-av-status-chip-{statusClass}{selected}";
    }

    private string GetStatusClass(string? status)
    {
        return $"mobile-av-status-badge mobile-av-status-{NormalizeStatusCss(status)}";
    }

    private static string NormalizeStatusCss(string? status)
    {
        return status switch
        {
            "Available" => "available",
            "Assigned" => "assigned",
            "Loaned" => "loaned",
            "InMaintenance" => "maintenance",
            "Damaged" => "damaged",
            "NotSuitable" => "not-suitable",
            "PendingValidation" => "pending",
            "NotLocated" => "not-located",
            "PendingDisposal" => "disposal",
            "Disposed" => "disposed",
            _ => "other"
        };
    }

    private static string StatusLabel(string? status)
    {
        return status switch
        {
            "Available" => "Disponible",
            "Assigned" => "Asignada",
            "Loaned" => "Prestada",
            "InMaintenance" => "En mantenimiento",
            "Damaged" => "Dañada",
            "NotSuitable" => "No apta",
            "PendingValidation" => "Pendiente validación",
            "NotLocated" => "No localizada",
            "PendingDisposal" => "Pendiente baja",
            "Disposed" => "Dada de baja",
            _ => string.IsNullOrWhiteSpace(status) ? "Sin estado" : status
        };
    }

    private static bool IsAvailable(MobileAvailabilityToolDto tool) =>
