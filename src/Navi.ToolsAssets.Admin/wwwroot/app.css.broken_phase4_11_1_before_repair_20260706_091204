.tool-detail-hero {
    background: linear-gradient(90deg, #020202 0%, #180023 55%, #4b005c 100%);
    color: #ffffff;
    border-radius: 0.75rem;
    padding: 1rem;
    margin-bottom: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    box-shadow: 0 0.35rem 1rem rgba(0, 0, 0, 0.12);
}

.tool-detail-hero h2 {
    margin: 0.35rem 0;
    font-weight: 700;
}

.tool-detail-hero p {
    margin: 0;
    color: rgba(255, 255, 255, 0.75);
}

.tool-code {
    display: inline-block;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    padding: 0.22rem 0.6rem;
    font-size: 0.78rem;
    font-weight: 600;
}

.tool-status-box {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.45rem;
}

.tool-detail-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(280px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
}

.tool-detail-panel {
    background: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 0.75rem;
    padding: 1rem;
    box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.04);
}

.tool-detail-panel h2 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.85rem;
}

.detail-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(160px, 1fr));
    gap: 0.75rem;
}

.detail-list div,
.status-chip-grid div {
    background: #f8f9fa;
    border: 1px solid #edf0f2;
    border-radius: 0.55rem;
    padding: 0.65rem;
}

.detail-list span,
.status-chip-grid span {
    display: block;
    color: #6c757d;
    font-size: 0.72rem;
    margin-bottom: 0.25rem;
}

.detail-list strong,
.status-chip-grid strong {
    font-weight: 600;
}

.status-chip-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(130px, 1fr));
    gap: 0.75rem;
}

.timeline {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.timeline-item {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 0.65rem;
}

.timeline-dot {
    width: 11px;
    height: 11px;
    background: #4b005c;
    border-radius: 50%;
    margin-top: 0.35rem;
    box-shadow: 0 0 0 4px rgba(75, 0, 92, 0.10);
}

.timeline-content {
    background: #f8f9fa;
    border: 1px solid #edf0f2;
    border-radius: 0.55rem;
    padding: 0.7rem;
}

.timeline-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
}

.timeline-header span {
    color: #6c757d;
    font-size: 0.72rem;
    white-space: nowrap;
}

.timeline-content p {
    margin: 0.35rem 0;
}

.timeline-values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    color: #6c757d;
    font-size: 0.72rem;
}

@media (max-width: 992px) {
    .tool-detail-grid,
    .detail-list,
    .status-chip-grid {
        grid-template-columns: 1fr;
    }

    .tool-detail-hero {
        flex-direction: column;
    }

    .tool-status-box {
        justify-content: flex-start;
    }
}

.life-record-cover {
    background: linear-gradient(90deg, #020202 0%, #190025 55%, #4b005c 100%);
    color: #ffffff;
    border-radius: 0.75rem;
    padding: 1rem;
    margin-bottom: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    box-shadow: 0 0.35rem 1rem rgba(0, 0, 0, 0.12);
}

.life-record-cover h2 {
    margin: 0.35rem 0 0.15rem 0;
    font-weight: 700;
}

.life-record-cover p {
    margin: 0;
    opacity: 0.78;
}

.life-record-label {
    display: inline-block;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    padding: 0.22rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04rem;
}

.life-record-cover-status {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.life-record-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(280px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
}

.life-record-section {
    background: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 0.75rem;
    padding: 1rem;
    margin-bottom: 1rem;
    box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.04);
}

.section-title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.85rem;
}

.section-title span {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #4b005c;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 700;
}

.section-title h2 {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 700;
}

.excel-grid {
    display: grid;
    gap: 0.45rem;
}

.excel-grid.two-columns {
    grid-template-columns: repeat(2, minmax(160px, 1fr));
}

.excel-grid div {
    border: 1px solid #dfe3e6;
    background: #f8f9fa;
    border-radius: 0.45rem;
    padding: 0.55rem;
}

.excel-grid label {
    display: block;
    color: #6c757d;
    font-size: 0.68rem;
    margin-bottom: 0.18rem;
}

.excel-grid strong {
    font-weight: 600;
    color: #212529;
}

.excel-table {
    font-size: 0.78rem;
}

.excel-table thead th {
    background: #111111;
    color: #ffffff;
    border-color: #111111;
    font-weight: 600;
}

.document-list {
    display: grid;
    gap: 0.5rem;
}

.document-card {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-decoration: none;
    color: #212529;
    border: 1px solid #dfe3e6;
    background: #f8f9fa;
    border-radius: 0.5rem;
    padding: 0.65rem;
}

.document-card:hover {
    border-color: #4b005c;
    color: #4b005c;
}

.document-card span {
    color: #6c757d;
    font-size: 0.72rem;
}

.safe-practices-grid {
    display: grid;
    gap: 0.65rem;
}

.safe-practice-card {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 0.65rem;
    border: 1px solid #dfe3e6;
    background: #f8f9fa;
    border-radius: 0.55rem;
    padding: 0.7rem;
}

.safe-practice-card > span {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #4b005c;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
}

.safe-practice-card p {
    margin: 0.25rem 0 0 0;
    color: #495057;
}

.life-progress-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.35rem;
    font-weight: 600;
}

@media (max-width: 992px) {
    .life-record-grid,
    .excel-grid.two-columns {
        grid-template-columns: 1fr;
    }

    .life-record-cover {
        flex-direction: column;
    }

    .life-record-cover-status {
        justify-content: flex-start;
    }
}

.quick-actions {
    display: grid;
    gap: 0.75rem;
}

.quick-actions .form-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: #495057;
    margin-bottom: 0.25rem;
}

.quick-actions .alert {
    padding: 0.5rem 0.65rem;
    font-size: 0.78rem;
}

.technical-edit-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(280px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
}

.edit-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(180px, 1fr));
    gap: 0.75rem;
}

.edit-form-grid.three-columns {
    grid-template-columns: repeat(3, minmax(180px, 1fr));
}

.edit-form-grid label {
    font-size: 0.72rem;
    font-weight: 600;
    color: #495057;
    margin-bottom: 0.2rem;
}

.form-check-row {
    min-height: 38px;
    display: flex;
