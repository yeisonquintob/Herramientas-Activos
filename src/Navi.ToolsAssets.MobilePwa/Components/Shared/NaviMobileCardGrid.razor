@using System.Collections.Generic
@using Microsoft.AspNetCore.Components

<section @attributes="AdditionalAttributes"
         class="@CssClass"
         data-ntx-component="mobile-card-grid"
         data-ntx-columns="@NormalizedColumns">
    @ChildContent
</section>

@code {
    [Parameter]
    public int Columns { get; set; } = 1;

    [Parameter]
    public bool Compact { get; set; } = true;

    [Parameter]
    public bool EqualHeight { get; set; } = true;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>?
        AdditionalAttributes { get; set; }

    private string NormalizedColumns =>
        Columns switch
        {
            2 => "2",
            _ => "1"
        };

    private string CssClass
    {
        get
        {
            var classes = new List<string>
            {
                "navi-mobile-card-grid",
                $"navi-mobile-card-grid--{NormalizedColumns}"
            };

            if (Compact)
            {
                classes.Add(
                    "navi-mobile-card-grid--compact");
            }

            if (EqualHeight)
            {
                classes.Add(
                    "navi-mobile-card-grid--equal");
            }

            if (!string.IsNullOrWhiteSpace(Class))
            {
                classes.Add(Class.Trim());
            }

            return string.Join(" ", classes);
        }
    }
}
