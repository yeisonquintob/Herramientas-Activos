        {
            var segment = validSegments[i];
            var percent = Math.Round((decimal)segment.Value / total * 100, 2);
            var end = i == validSegments.Count - 1 ? 100 : Math.Min(100, start + percent);

            parts.Add($"{segment.Color} {CssNumber(start)}% {CssNumber(end)}%");
            start = end;
        }

        return $"background: conic-gradient({string.Join(", ", parts)});";
    }

    private static string CssNumber(decimal value)
    {
        return value.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private decimal GetOperationsCostTotalPercentValue(decimal value)
    {
        var total = GetOperationsCostTotal();

        if (value <= 0 || total <= 0)
        {
            return 0;
        }

        return Math.Min(100, Math.Round(value / total * 100, 1));
    }

    private string GetOperationsCostTotalPercentLabel(decimal value)
    {
        return $"{GetOperationsCostTotalPercentValue(value).ToString("0.#", CultureInfo.InvariantCulture)}%";
    }

    private string GetOperationsMaxPercentLabel(int value)
    {
        if (dashboard is null || value <= 0)
        {
            return "0%";
        }

        var max = Math.Max(dashboard.MaintenanceSummary.Total, dashboard.PurchaseSummary.Total);

        if (max <= 0)
        {
            return "0%";
        }

        return $"{Math.Round((decimal)value / max * 100, 1)}%";
    }

    private static string FormatDashboardMoney(decimal value)
    {
        return value <= 0
            ? "$ 0"
            : $"$ {value.ToString("N0", CultureInfo.GetCultureInfo("es-CO"))}";
    }

    private static string FormatDashboardMoneyCompact(decimal value)
    {
        if (value <= 0)
        {
            return "$ 0";
        }

        if (value >= 1_000_000)
        {
            return $"$ {(value / 1_000_000m).ToString("0.#", CultureInfo.GetCultureInfo("es-CO"))}M";
        }

        if (value >= 1_000)
        {
            return $"$ {(value / 1_000m).ToString("0.#", CultureInfo.GetCultureInfo("es-CO"))}K";
        }

        return $"$ {value.ToString("N0", CultureInfo.GetCultureInfo("es-CO"))}";
    }

    private static string GetPercentLabel(int value, int total)
    {
        if (value <= 0 || total <= 0)
        {
            return "0%";
        }

        return $"{Math.Round((decimal)value / total * 100, 1)}%";
    }

    private static string GetProgressStyle(int percent)
    {
        return $"width:{Math.Min(100, Math.Max(0, percent))}%";
    }

    private string GetPendingPanelTitle()
    {
        if (dashboard is null || dashboard.ToolsByBranch.Count == 0)
        {
            return "Pendientes";
        }

        var branch = dashboard.ToolsByBranch
            .OrderByDescending(x => GetBranchPending(x.Total) + GetBranchDifferences(x.Total))
            .First();

        return $"Pendientes de {branch.BranchName}";
    }

    private static string ShortName(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Sin sede";
        }

        return value.Length <= 12 ? value : value[..12];
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "—" : value;
    }

    private static string FormatDateTime(DateTime value)
    {
        return value.ToString("dd/MM/yyyy HH:mm");
    }

    private static string GetActivityIcon(string? eventType)
    {
        if (string.IsNullOrWhiteSpace(eventType))
        {
            return "📌";
        }

        var value = eventType.ToLowerInvariant();

        if (value.Contains("maintenance"))
        {
            return "🛠️";
        }

        if (value.Contains("assignment"))
        {
            return "🔁";
        }

        if (value.Contains("document"))
        {
            return "📄";
        }

        if (value.Contains("purchase"))
        {
            return "🛒";
        }

        if (value.Contains("physical") || value.Contains("count"))
        {
            return "📦";
        }

        return "📌";
    }

