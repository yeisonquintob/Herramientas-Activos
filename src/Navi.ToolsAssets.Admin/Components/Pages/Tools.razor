    private void IncreaseInventoryImageZoom()
    {
        SetInventoryImageZoom(
            inventoryImagePreviewZoom
            +
            0.25);
    }


    private void DecreaseInventoryImageZoom()
    {
        SetInventoryImageZoom(
            inventoryImagePreviewZoom
            -
            0.25);
    }


    private void ResetInventoryImageZoom()
    {
        inventoryImagePreviewZoom =
            1.0;
    }


    // NAVI ADMIN INVENTORY IMAGE ZOOM SLIDER METHODS V64 START

    private int GetInventoryImageZoomPercentage()
    {
        return Convert.ToInt32(
            Math.Round(
                inventoryImagePreviewZoom
                *
                100,
                MidpointRounding.AwayFromZero));
    }


    private void HandleInventoryImageZoomSlider(
        Microsoft.AspNetCore.Components.ChangeEventArgs args)
    {
        var rawValue =
            Convert.ToString(
                args.Value,
                System.Globalization.CultureInfo
                    .InvariantCulture);

        if (
            !double.TryParse(
                rawValue,
                System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture,
                out var percentage)
        )
        {
            return;
        }

        SetInventoryImageZoom(
            percentage
            /
            100.0);
    }

    // NAVI ADMIN INVENTORY IMAGE ZOOM SLIDER METHODS V64 END

    private void HandleInventoryImageWheel(
        Microsoft.AspNetCore.Components.Web
            .WheelEventArgs args)
    {
        if (args.DeltaY < 0)
        {
            IncreaseInventoryImageZoom();
            return;
        }

        if (args.DeltaY > 0)
        {
            DecreaseInventoryImageZoom();
        }
    }


    private void SetInventoryImageZoom(
        double value)
    {
        inventoryImagePreviewZoom =
            Math.Clamp(
                value,
                0.5,
                3.0);
    }


    private string FormatInventoryImageZoom()
    {
        return
            Math.Round(
                inventoryImagePreviewZoom
                *
                100)
            .ToString(
                "0",
                System.Globalization
                    .CultureInfo
                    .InvariantCulture)
            +
            "%";
    }


    private string GetInventoryImageZoomStyle()
    {
        var percentage =
            Math.Round(
                inventoryImagePreviewZoom
                *
                100)
            .ToString(
                "0",
                System.Globalization
                    .CultureInfo
                    .InvariantCulture);

        return
            $"--navi-inventory-image-width: "
            +
            $"{percentage}%;";
    }

