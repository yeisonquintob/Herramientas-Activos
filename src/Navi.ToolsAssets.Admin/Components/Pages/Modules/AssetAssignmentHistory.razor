@page "/asset-assignment-history"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using Navi.ToolsAssets.Admin.Services.Auth
@using Navi.ToolsAssets.Admin.Components.Shared

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject NaviAccessScopeService AccessScope
@inject WebAuthSessionService AuthSession

<PageTitle>Historial de asignaciones - NAVI</PageTitle>

<PermissionGuard Permission="AssetAssignment.History"
                 ModuleName="Historial de asignaciones">

    <section class="assignment-history-web-v26">

        <NaviPageHero
            Pill="ACTIVOS FIJOS"
            Title="Historial de asignaciones"
            Description="Consulta la trazabilidad de responsables, sedes, estados, entregas, regresos y movimientos de herramientas y activos." />


<NaviKpiToolbar Class="assignment-history-v26-kpi-row"
                Refresh="LoadHistoryAsync"
                IsRefreshing="isLoading"
                RefreshTitle="Actualizar historial"
                RefreshAriaLabel="Actualizar historial">
    <NaviKpiGrid Columns="5" Dividers="true" Class="assignment-history-v26-kpis">
        <NaviKpiCard Title="Movimientos" Description="Según filtros activos" Tone="neutral">
            <IconContent><NaviKpiIcon Name="document" /></IconContent>
            <ValueContent>@FilteredHistory.Count()</ValueContent>
        </NaviKpiCard>
        <NaviKpiCard Title="En uso" Description="Asignadas o prestadas" Tone="soft">
            <IconContent><NaviKpiIcon Name="transfer" /></IconContent>
            <ValueContent>
                @(FilteredHistory.Count(item =>
                    string.Equals(item.CurrentStatus, "Assigned", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(item.CurrentStatus, "Loaned", StringComparison.OrdinalIgnoreCase)))
            </ValueContent>
        </NaviKpiCard>
        <NaviKpiCard Title="Regresos" Description="Con fecha registrada" Tone="positive">
            <IconContent><NaviKpiIcon Name="check" /></IconContent>
            <ValueContent>@(FilteredHistory.Count(item => item.ReturnedAt.HasValue))</ValueContent>
        </NaviKpiCard>
        <NaviKpiCard Title="Sedes" Description="En el resultado actual" Tone="neutral">
            <IconContent><NaviKpiIcon Name="location" /></IconContent>
            <ValueContent>
                @(FilteredHistory.Select(item => item.CurrentBranchCode ?? string.Empty)
                    .Where(value => !string.IsNullOrWhiteSpace(value))
                    .Distinct(StringComparer.OrdinalIgnoreCase).Count())
            </ValueContent>
        </NaviKpiCard>
        <NaviKpiCard Title="Responsables" Description="Usuarios visibles" Tone="neutral">
            <IconContent><NaviKpiIcon Name="users" /></IconContent>
            <ValueContent>
                @(FilteredHistory.Select(item => item.CurrentResponsibleName ?? string.Empty)
                    .Where(value => !string.IsNullOrWhiteSpace(value))
                    .Distinct(StringComparer.OrdinalIgnoreCase).Count())
            </ValueContent>
        </NaviKpiCard>
    </NaviKpiGrid>
</NaviKpiToolbar>

        <section class="assignment-history-v26-filter-card"
                 aria-label="Filtros del historial">

            <label class="assignment-history-v26-field
                          assignment-history-v26-search">

                <span>Buscar movimiento</span>

                <div>
                    <svg viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">

                        <circle cx="10.5"
                                cy="10.5"
                                r="6.5">
                        </circle>

                        <path d="M15.5 15.5L21 21"></path>
                    </svg>

                    <input id="assignment-history-search"
                           name="assignment-history-search"
                           type="search"
                           autocomplete="off"
                           placeholder="Código, herramienta, serial, detalle, responsable, sede o ubicación..."
                           @bind="search"
                           @bind:event="oninput" />
                </div>
            </label>

            <label class="assignment-history-v26-field">

                <span>Responsable</span>

                <input id="assignment-history-responsible"
                       name="assignment-history-responsible"
                       list="assignment-history-responsibles-list"
                       value="@selectedResponsibleSearchText"
                       @oninput="OnResponsibleFilterInput"
                       placeholder="Todos los usuarios" />

                <datalist id="assignment-history-responsibles-list">

                    <option value="Todos los usuarios">
                    </option>

                    @foreach (var responsible in VisibleResponsibles)
                    {
                        <option value="@FormatResponsibleHistoryOption(
                            responsible)">
                        </option>

                        <option value="@responsible.FullName">
                        </option>
                    }
                </datalist>
            </label>

            <label class="assignment-history-v26-field">

                <span>Sede</span>

                @if (AccessScope.IsAllBranchScope() ||
                     AccessScope.IsAdminRole())
                {
                    <select id="assignment-history-branch"
                            name="assignment-history-branch"
                            @bind="selectedBranchCode">

                        <option value="">
                            Todas las sedes
                        </option>

                        @foreach (var branch in BranchOptions)
                        {
                            <option value="@branch">
                                @branch
                            </option>
                        }
                    </select>
                }
                else
                {
                    <input id="assignment-history-branch"
                           name="assignment-history-branch"
                           value="@ScopeLabel"
                           disabled />
                }
            </label>

            <div class="assignment-history-v26-filter-actions">

                <button type="button"
                        class="assignment-history-v26-filter-button"
                        disabled="@isLoading"
                        @onclick="LoadHistoryAsync" data-ntx-tone="operation">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">

                        <path d="M4 5H20L14 12V19L10 21V12Z"></path>
                    </svg>

                    <span>Filtrar</span>
                </button>

                <button type="button"
                        class="assignment-history-v26-clear-button"
                        disabled="@isLoading"
                        @onclick="ClearFilters" data-ntx-tone="secondary">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">

                        <path d="M5 5L19 19"></path>
                        <path d="M19 5L5 19"></path>
                    </svg>

                    <span>Limpiar</span>
                </button>
            </div>
        </section>

        <section class="assignment-history-v26-status-card"
                 aria-label="Estados del historial">

            <header>

                <div>
                    <strong>Estado operativo</strong>

                    <small>
                        Selecciona uno o varios estados para limitar el resultado.
                    </small>
                </div>

                <span>
                    @AssignmentHistoryBaseFiltered.Count() registros
                </span>
            </header>

            <div class="assignment-history-v26-status-list">

                <button type="button"
                        class="assignment-history-status-filter-chip assignment-history-status-all @(selectedStatuses.Count == 0 ? "active" : string.Empty)"
                        @onclick="ClearStatusFilter" data-ntx-tone="ghost">

                    <i aria-hidden="true"></i>

                    <span>Todos</span>

                    <strong>
                        @AssignmentHistoryBaseFiltered.Count()
                    </strong>
                </button>

                @foreach (var status in StatusOptions)
                {
                    var selected =
                        selectedStatuses.Contains(
                            status.Value);

                    <button type="button"
                            class="@(GetAssignmentHistoryStatusChipClass(
                                status.Value,
                                selected))"
                            @onclick="() => ToggleStatus(status.Value)" data-ntx-tone="expand">

                        <i aria-hidden="true"></i>

                        <span>@status.Text</span>

                        <strong>
                            @(AssignmentHistoryBaseFiltered.Count(item =>
                                string.Equals(
                                    item.CurrentStatus,
                                    status.Value,
                                    StringComparison.OrdinalIgnoreCase)))
                        </strong>
                    </button>
                }

            </div>
        </section>

        <section class="assignment-history-v26-result-card">

            <header class="assignment-history-v26-result-header">

                <div>
                    <span>TRAZABILIDAD DE ACTIVOS</span>

                    <h2>Resultado del historial</h2>

                    <p>
                        Asignaciones y regresos encontrados según responsable,
                        sede, estado y texto de búsqueda.
                    </p>
                </div>

                <div class="assignment-history-v26-result-count">

                    <strong>@FilteredHistory.Count()</strong>

                    <small>
                        de @VisibleHistory.Count()
                    </small>
                </div>
            </header>

            <section class="assignment-history-v26-filter-summary"
                     aria-label="Resumen de filtros">

                <span>
                    <b>Alcance:</b>
                    @ScopeLabel
                </span>

                <span>
                    <b>Responsable:</b>
                    @SelectedResponsibleLabel
                </span>

                <span>
                    <b>Estado:</b>
                    @SelectedStatusLabel
                </span>
            </section>

            @if (isLoading)
            {
                <section class="assignment-history-v26-loading"
                         aria-live="polite">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">

                        <path d="M20 12a8 8 0 1 1-2.35-5.65"></path>
                        <path d="M20 4V10H14"></path>
                    </svg>

                    <div>
                        <strong>Cargando historial</strong>

                        <span>
                            Consultando movimientos de asignación y regreso.
                        </span>
                    </div>
                </section>
            }
            else if (!FilteredHistory.Any())
            {
                <section class="assignment-history-v26-empty">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">

                        <path d="M5 4H19V20H5Z"></path>
                        <path d="M8 9H16"></path>
                        <path d="M8 13H13"></path>
                    </svg>

                    <div>
                        <strong>Sin movimientos para mostrar</strong>

                        <span>
                            Ajusta el responsable, sede, estado o búsqueda.
                        </span>
                    </div>
                </section>
            }
            else
            {
                <div class="assignment-history-v26-table-wrap">

                    <table class="assignment-history-v26-table">

                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Herramienta o activo</th>
                                <th>Responsable actual</th>
                                <th>Sede y ubicación</th>
                                <th>Estado</th>
                                <th>Entrega</th>
                                <th>Regreso</th>
                                <th>Detalle</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in FilteredHistory)
                            {
                                <tr>

                                    <td class="assignment-history-v26-code">

                                        <strong>
                                            @Show(item.ToolInternalCode)
                                        </strong>
                                    </td>

                                    <td class="assignment-history-v26-tool">

                                        <strong>
                                            @Show(item.ToolName)
                                        </strong>

                                        <small>
                                            Serial:
                                            @Show(item.ToolSerialNumber)
                                        </small>
                                    </td>

                                    <td>
                                        @Show(item.CurrentResponsibleName)
                                    </td>

                                    <td class="assignment-history-v26-location">

                                        <strong>
                                            @Show(item.CurrentBranchCode)
                                        </strong>

                                        <small>
                                            @Show(item.CurrentLocationName)
                                        </small>
                                    </td>

                                    <td>
                                        <span class="@(GetStatusBadge(
                                            item.CurrentStatus
                                            ??
                                            string.Empty))">

                                            @(GetStatusLabel(
                                                item.CurrentStatus
                                                ??
                                                string.Empty))
                                        </span>
                                    </td>

                                    <td class="assignment-history-v26-date">
                                        @ShowDate(item.AssignedAt)
                                    </td>

                                    <td class="assignment-history-v26-date">
                                        @ShowDate(item.ReturnedAt)
                                    </td>

                                    <td class="assignment-history-v26-detail">

                                        <span>
                                            @Show(item.Detail)
                                        </span>

                                        @if (!string.IsNullOrWhiteSpace(
                                                item.ReturnDetail))
                                        {
                                            <small>
                                                <b>Regreso:</b>
                                                @item.ReturnDetail
                                            </small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </section>
</PermissionGuard>

@code {
    [SupplyParameterFromQuery(Name = "responsiblePersonId")]
    public Guid? ResponsiblePersonId { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    private HttpClient Api => HttpClientFactory.CreateClient("NaviApi");

    private List<ResponsibleItem> responsibles = new();
    private List<AssignmentHistoryItem> historyItems = new();

    private bool isLoading;
    private string selectedResponsibleId = string.Empty;
    private string selectedResponsibleSearchText = "Todos los usuarios";
    private string selectedBranchCode = string.Empty;
    private string search = string.Empty;
    private HashSet<string> selectedStatuses = new(StringComparer.OrdinalIgnoreCase);

    private readonly (string Value, string Text)[] StatusOptions =
    {
        ("Available", "Disponible"),
        ("Assigned", "Asignada"),
        ("Loaned", "Prestada"),
        ("InMaintenance", "Mantenimiento"),
        ("Damaged", "Dañada"),
        ("NotSuitable", "No apta"),
        ("PendingValidation", "Pendiente validación"),
        ("NotLocated", "No localizada"),
        ("Disposed", "Baja")
    };

    private IEnumerable<ResponsibleItem> VisibleResponsibles =>
        responsibles.OrderBy(x => x.FullName);

    private IEnumerable<string> BranchOptions =>
        historyItems
            .Where(x => AccessScope.CanSeeBranch(x.CurrentBranchCode))
            .Select(x => x.CurrentBranchCode)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x);

    private IEnumerable<AssignmentHistoryItem> VisibleHistory =>
        historyItems
            .Where(x => AccessScope.CanSeeBranch(x.CurrentBranchCode));

    private IEnumerable<AssignmentHistoryItem> AssignmentHistoryBaseFiltered =>
        VisibleHistory
            .Where(MatchesResponsibleFilter)
            .Where(MatchesBranchFilter)
            .Where(MatchesSearchFilter);

    private IEnumerable<AssignmentHistoryItem> FilteredHistory =>
        AssignmentHistoryBaseFiltered
            .Where(MatchesStatusFilter)
            .OrderByDescending(x => x.AssignedAt);

    private int VisibleBranchCount =>
        VisibleHistory
            .Select(x => x.CurrentBranchCode)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

    private string ScopeLabel =>
        AccessScope.IsAllBranchScope() || AccessScope.IsAdminRole()
            ? "Todas las sedes"
            : AuthSession.BranchCode;

    private bool ShouldDefaultResponsibleFilter =>
        !AccessScope.IsAdminRole() &&
        !AccessScope.IsAllBranchScope();


    private string SelectedResponsibleLabel
    {
        get
        {
            if (string.IsNullOrWhiteSpace(selectedResponsibleId))
            {
                return "Todos";
            }

            var selected = responsibles.FirstOrDefault(x => x.Id.ToString() == selectedResponsibleId);
            return selected?.FullName ?? "Seleccionado";
        }
    }

    private string SelectedStatusLabel =>
        selectedStatuses.Count == 0
            ? "Todos"
            : selectedStatuses.Count == 1
                ? StatusOptions.FirstOrDefault(x => selectedStatuses.Contains(x.Value)).Text ?? "1"
                : $"{selectedStatuses.Count} seleccionados";

    protected override async Task OnInitializedAsync()
    {
        search = Query ?? string.Empty;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        responsibles = await Api.GetFromJsonAsync<List<ResponsibleItem>>("api/settings/responsibles") ?? new();

        if (ResponsiblePersonId.HasValue)
        {
            selectedResponsibleId = ResponsiblePersonId.Value.ToString();
        }
        else if (ShouldDefaultResponsibleFilter &&
                 string.IsNullOrWhiteSpace(selectedResponsibleId) &&
                 AuthSession.ResponsiblePersonId.HasValue)
        {
            selectedResponsibleId = AuthSession.ResponsiblePersonId.Value.ToString();
        }
        else if (!ShouldDefaultResponsibleFilter &&
                 string.IsNullOrWhiteSpace(selectedResponsibleId))
        {
            selectedResponsibleId = string.Empty;
        }

        SyncResponsibleSearchTextFromSelected();

        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        isLoading = true;

        try
        {
            var endpoint = string.IsNullOrWhiteSpace(selectedResponsibleId)
                ? "api/tools/assignment-history"
                : $"api/tools/assignment-history?responsiblePersonId={Uri.EscapeDataString(selectedResponsibleId)}";

            historyItems = await Api.GetFromJsonAsync<List<AssignmentHistoryItem>>(endpoint) ?? new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ClearFilters()
    {
        search = string.Empty;
        selectedBranchCode = string.Empty;
        selectedStatuses.Clear();

        selectedResponsibleId = ShouldDefaultResponsibleFilter && AuthSession.ResponsiblePersonId.HasValue
            ? AuthSession.ResponsiblePersonId.Value.ToString()
            : string.Empty;

        
        SyncResponsibleSearchTextFromSelected();
await LoadHistoryAsync();
    }

    private void ToggleStatus(string status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return;
        }

        if (!selectedStatuses.Add(status))
        {
            selectedStatuses.Remove(status);
        }
    }

    private void ClearStatusFilter()
    {
        selectedStatuses.Clear();
    }


    private void OnResponsibleFilterInput(ChangeEventArgs args)
    {
        selectedResponsibleSearchText = args?.Value?.ToString() ?? string.Empty;

        if (selectedResponsibleSearchText.Contains("Microsoft.AspNetCore.Components", StringComparison.OrdinalIgnoreCase))
        {
            selectedResponsibleSearchText = string.Empty;
        }

        if (string.IsNullOrWhiteSpace(selectedResponsibleSearchText) ||
            selectedResponsibleSearchText.Equals("Todos los usuarios", StringComparison.OrdinalIgnoreCase))
        {
            selectedResponsibleId = string.Empty;
            selectedResponsibleSearchText = "Todos los usuarios";
            return;
        }

        var responsible = ResolveResponsibleFilter(selectedResponsibleSearchText);

        if (responsible is not null)
        {
            selectedResponsibleId = responsible.Id.ToString();
            selectedResponsibleSearchText = FormatResponsibleHistoryOption(responsible);
            return;
        }

        selectedResponsibleId = string.Empty;
    }

    private ResponsibleItem? ResolveResponsibleFilter(string value)
    {
        return VisibleResponsibles.FirstOrDefault(x =>
            string.Equals(FormatResponsibleHistoryOption(x), value, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.FullName, value, StringComparison.OrdinalIgnoreCase) ||
            ContainsText(x.FullName, value));
    }

    private static string FormatResponsibleHistoryOption(ResponsibleItem responsible)
    {
        return responsible.FullName;
    }

    private void SyncResponsibleSearchTextFromSelected()
    {
        if (string.IsNullOrWhiteSpace(selectedResponsibleId))
        {
            selectedResponsibleSearchText = "Todos los usuarios";
            return;
        }

        var selected = responsibles.FirstOrDefault(x => x.Id.ToString() == selectedResponsibleId);

        selectedResponsibleSearchText = selected is null
            ? "Seleccionado"
            : FormatResponsibleHistoryOption(selected);
    }

    private bool MatchesResponsibleFilter(AssignmentHistoryItem item)
    {
        if (!string.IsNullOrWhiteSpace(selectedResponsibleId))
        {
            return item.CurrentResponsiblePersonId.HasValue &&
                   item.CurrentResponsiblePersonId.Value.ToString().Equals(selectedResponsibleId, StringComparison.OrdinalIgnoreCase);
        }

        if (string.IsNullOrWhiteSpace(selectedResponsibleSearchText) ||
            selectedResponsibleSearchText.Equals("Todos los usuarios", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return ContainsText(item.CurrentResponsibleName, selectedResponsibleSearchText);
    }

    private bool MatchesBranchFilter(AssignmentHistoryItem item)
    {
        if (string.IsNullOrWhiteSpace(selectedBranchCode))
        {
            return true;
        }

        return SameNormalized(item.CurrentBranchCode, selectedBranchCode);
    }

    private bool MatchesStatusFilter(AssignmentHistoryItem item)
    {
        return selectedStatuses.Count == 0 ||
               selectedStatuses.Contains(item.CurrentStatus ?? string.Empty);
    }

    private bool MatchesSearchFilter(AssignmentHistoryItem item)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return true;
        }

        return ContainsText(item.ToolInternalCode, search) ||
               ContainsText(item.ToolName, search) ||
               ContainsText(item.ToolSerialNumber, search) ||
               ContainsText(item.Detail, search) ||
               ContainsText(item.ReturnDetail, search) ||
               ContainsText(item.CurrentResponsibleName, search) ||
               ContainsText(item.CurrentBranchCode, search) ||
               ContainsText(item.CurrentLocationName, search) ||
               ContainsText(GetStatusLabel(item.CurrentStatus ?? string.Empty), search);
    }

    private void GoBackToAssignment()
    {
        NavigationManager.NavigateTo("/asset-assignment");
    }

    private static bool ContainsText(string? value, string expected)
    {
        return !string.IsNullOrWhiteSpace(value) &&
               !string.IsNullOrWhiteSpace(expected) &&
               Normalize(value).Contains(Normalize(expected), StringComparison.OrdinalIgnoreCase);
    }

    private static bool SameNormalized(string? left, string? right)
    {
        var a = Normalize(left);
        var b = Normalize(right);

        return !string.IsNullOrWhiteSpace(a)
            && !string.IsNullOrWhiteSpace(b)
            && string.Equals(a, b, StringComparison.OrdinalIgnoreCase);
    }

    private static string Normalize(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value
            .Trim()
            .ToUpperInvariant()
            .Replace("Á", "A")
            .Replace("É", "E")
            .Replace("Í", "I")
            .Replace("Ó", "O")
            .Replace("Ú", "U")
            .Replace("Ü", "U")
            .Replace("Ñ", "N");
    }

    private static string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string ShowDate(DateTime? value)
    {
        return value.HasValue ? value.Value.ToLocalTime().ToString("dd/MM/yyyy") : "—";
    }

    private static string GetStatusLabel(string status) => status switch
    {
        "Available" => "Disponible",
        "Assigned" => "Asignada",
        "Loaned" => "Prestada",
        "InMaintenance" => "En mantenimiento",
        "Damaged" => "Dañada",
        "NotSuitable" => "No apta",
        "NotLocated" => "No localizada",
        "PendingValidation" => "Pendiente validación",
        "Disposed" => "Baja",
        _ => NaviStatusLabels.ToSpanish(status)
    };

    private sealed class ResponsibleItem
    {
        public Guid Id { get; set; }
        public string FullName { get; set; } = string.Empty;
    }

    private sealed class AssignmentHistoryItem
    {
        public Guid Id { get; set; }
        public Guid ToolAssetId { get; set; }
        public string ToolInternalCode { get; set; } = string.Empty;
        public string ToolName { get; set; } = string.Empty;
        public string? ToolSerialNumber { get; set; }
        public string? CurrentBranchCode { get; set; }
        public string? CurrentLocationName { get; set; }
        public Guid? CurrentResponsiblePersonId { get; set; }
        public string? CurrentResponsibleName { get; set; }
        public string? CurrentStatus { get; set; }
        public DateTime? AssignedAt { get; set; }
        public DateTime? ReturnedAt { get; set; }
        public string? ReturnDetail { get; set; }
        public string? Detail { get; set; }
    }

    private static string GetStatusBadge(string? status)
    {
        return NaviStatusLabels.BadgeClass(status);
    }


    private static string GetStatusBadgeClass(string? status)
    {
        return NaviStatusLabels.BadgeClass(status);
    }



    private string GetAssignmentHistoryStatusChipClass(string status, bool selected)
    {
        var normalized = status switch
        {
            "Available" => "available",
            "Assigned" => "assigned",
            "Loaned" => "loaned",
            "InMaintenance" => "maintenance",
            "Damaged" => "damaged",
            "NotSuitable" => "not-suitable",
            "PendingValidation" => "pending",
            "NotLocated" => "not-located",
            "Disposed" => "disposed",
            _ => "other"
        };

        return selected
            ? $"assignment-history-status-filter-chip assignment-history-status-{normalized} active"
            : $"assignment-history-status-filter-chip assignment-history-status-{normalized}";
    }

    private static string GetStatusFilterChipButtonClass(string status, bool selected)
    {
        var selectedClass = selected ? " selected" : string.Empty;
        return $"{NaviStatusLabels.BadgeClass(status)} navi-status-filter-chip{selectedClass}";
    }

}
