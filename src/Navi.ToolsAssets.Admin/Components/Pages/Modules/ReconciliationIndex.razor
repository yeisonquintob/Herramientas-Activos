@page "/reconciliation"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components
@using System.Net.Http.Json
@using Navi.ToolsAssets.Admin.Components.Security
@using Navi.ToolsAssets.Admin.Components.Shared
@using Navi.ToolsAssets.Admin.Services.Auth

@inject IHttpClientFactory HttpClientFactory
@inject WebAuthSessionService AuthSession
@inject NavigationManager Navigation

<PageTitle>Conciliación</PageTitle>

<PermissionGuard Permission="Reconciliation.View" ModuleName="Conciliación">
    <div class="reconciliation-page">
        <section class="navi-reference-toolbar reconciliation-kpi-toolbar">
            <NaviPageHero
                Class="navi-reference-toolbar__actions"
                Pill="CONTROL"
                Title="Conciliación"
                Description="Revisa lo reportado por los usuarios, filtra diferencias y toma decisiones: aclarar, aprobar creación, crear en Inventario de Herramientas y AF, conciliar o rechazar.">

                @if (SelectedCountId.HasValue)
                {
                    <a class="btn"
                       href="@($"/physical-counts/{SelectedCountId}")"
                       data-ntx-tone="consult">
                        Ver toma
                    </a>
                }

                <NaviRefreshButton
                    OnClick="LoadAsync"
                    Loading="@isLoading"
                    Title="Actualizar conciliación"
                    AriaLabel="Actualizar conciliación" />

            </NaviPageHero>

            <NaviKpiGrid Columns="6"
                         Class="rec-kpi-grid">
                <NaviKpiCard Title="Total filtrado"
                             Description="Registros visibles"
                             Tone="neutral">
                    <IconContent><NaviKpiIcon Name="inventory" /></IconContent>
                    <ValueContent>@FilteredItems.Count()</ValueContent>
                </NaviKpiCard>

                <NaviKpiCard Title="No listadas"
                             Description="Posible creación"
                             Tone="soft">
                    <IconContent><NaviKpiIcon Name="document" /></IconContent>
                    <ValueContent>@FilteredItems.Count(x => x.ReportType == "ExtraNotListed")</ValueContent>
                </NaviKpiCard>

                <NaviKpiCard Title="Pendiente creación"
                             Description="Aprobar o crear"
                             Tone="warning">
                    <IconContent><NaviKpiIcon Name="clock" /></IconContent>
                    <ValueContent>@FilteredItems.Count(x => IsPendingCreation(x))</ValueContent>
                </NaviKpiCard>

                <NaviKpiCard Title="Pendiente conciliación"
                             Description="Revisar trazabilidad"
                             Tone="warning">
                    <IconContent><NaviKpiIcon Name="transfer" /></IconContent>
                    <ValueContent>@FilteredItems.Count(x => x.ReconciliationStatus == "MatchedInSystem")</ValueContent>
                </NaviKpiCard>

                <NaviKpiCard Title="Aclaración"
                             Description="Contactar usuario"
                             Tone="soft">
                    <IconContent><NaviKpiIcon Name="users" /></IconContent>
                    <ValueContent>@FilteredItems.Count(x => x.RequiresUserClarification || x.ReconciliationStatus == "RequiresUserClarification")</ValueContent>
                </NaviKpiCard>

                <NaviKpiCard Title="Completos"
                             Description="Conciliados"
                             Tone="positive">
                    <IconContent><NaviKpiIcon Name="check" /></IconContent>
                    <ValueContent>@FilteredItems.Count(x => x.ReconciliationStatus == "Reconciled")</ValueContent>
                </NaviKpiCard>
            </NaviKpiGrid>
        </section>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="rec-alert rec-alert-danger">@errorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="rec-alert rec-alert-success">@successMessage</div>
        }

        <section class="rec-card rec-filters-card">
            <div class="rec-section-title">
                <div>
                    <h2>Filtros de conciliación</h2>
                    <p>Selecciona una toma física y filtra por sede, usuario, tipo, estado, fechas o texto.</p>
                </div>

                <button type="button" class="rec-secondary-btn" @onclick="ClearFilters" data-ntx-tone="secondary" >
                    Limpiar filtros
                </button>
            </div>

            <div class="rec-filter-grid">
                <label>
                    Toma física
                    <select @bind="selectedCountIdText" @bind:after="OnSelectedCountChangedAsync" name="navi-reconciliationindex-field-001">
                        <option value="">Seleccione toma...</option>
                        @foreach (var count in physicalCounts)
                        {
                            <option value="@count.Id">
                                @count.CountNumber - @count.BranchCode - @count.StatusLabel
                            </option>
                        }
                    </select>
                </label>

                <label>
                    Sede
                    <select @bind="filterBranch" name="navi-reconciliationindex-field-002">
                        <option value="">Todas las sedes</option>
                        @foreach (var branch in BranchOptions)
                        {
                            <option value="@branch">@branch</option>
                        }
                    </select>
                </label>

                <label>
                    Usuario / participante
                    <select @bind="filterParticipant" name="navi-reconciliationindex-field-003">
                        <option value="">Todos los usuarios</option>
                        @foreach (var participant in ParticipantOptions)
                        {
                            <option value="@participant">@participant</option>
                        }
                    </select>
                </label>

                <label>
                    Tipo de reporte
                    <select @bind="filterReportType" name="navi-reconciliationindex-field-004">
                        <option value="">Todos</option>
                        <option value="Found">Encontrada / validada</option>
                        <option value="NotFound">No encontrada</option>
                        <option value="ExtraNotListed">No listada</option>
                        <option value="Damaged">Dañada</option>
                        <option value="ReturnedOrDelivered">Devuelta / entregada</option>
                    </select>
                </label>

                <label>
                    Estado de conciliación
                    <select @bind="filterReconciliationStatus" name="navi-reconciliationindex-field-005">
                        <option value="">Todos</option>
                        <option value="PendingReview">Pendiente revisión</option>
                        <option value="NotFoundInSystem">Pendiente creación</option>
                        <option value="MatchedInSystem">Pendiente conciliación</option>
                        <option value="RequiresUserClarification">Requiere aclaración</option>
                        <option value="ApprovedForCreation">Aprobado para creación</option>
                        <option value="Reconciled">Conciliado / completo</option>
                        <option value="Rejected">Rechazado</option>
                    </select>
                </label>

                <label>
                    Datos mínimos
                    <select @bind="filterMinimumData" name="navi-reconciliationindex-field-006">
                        <option value="">Todos</option>
                        <option value="Complete">Completos</option>
                        <option value="Missing">Sin mínimos</option>
                    </select>
                </label>

                <label>
                    Desde
                    <input @bind="filterFromDateText" placeholder="yyyy-MM-dd" name="navi-reconciliationindex-field-007" />
                </label>

                <label>
                    Hasta
                    <input @bind="filterToDateText" placeholder="yyyy-MM-dd" name="navi-reconciliationindex-field-008" />
                </label>
            </div>

            <div class="rec-filter-bottom">
                <label class="rec-search">
                    Buscar
                    <input @bind="searchText" @bind:event="oninput" placeholder="Código, nombre, serial, usuario, categoría, observación..." name="navi-reconciliationindex-field-009" />
                </label>

                <label class="rec-check">
                    <input type="checkbox" @bind="onlyPending" name="navi-reconciliationindex-field-010" />
                    Mostrar solo pendientes de decisión
                </label>
            </div>
        </section>

        <section class="rec-card">
            <div class="rec-section-title">
                <div>
                    <h2>Registros para conciliación</h2>
                    <p>Vista de conciliación. Administradores y roles conciliadores gestionan decisiones; los demás usuarios solo visualizan sus reportes y el estado de cada activo.</p>
                </div>

                @if (board is not null)
                {
                    <div class="rec-count-context">
                        <strong>@board.CountNumber</strong>
                        <span>@board.BranchCode - @board.BranchName</span>
                    </div>
                }
            </div>

            @if (isLoading)
            {
                <div class="rec-empty" role="status" aria-busy="true">Cargando información de conciliación...</div>
            }
            else if (!physicalCounts.Any())
            {
                <div class="rec-empty">No existen tomas físicas creadas.</div>
            }
            else if (board is null)
            {
                <div class="rec-empty">Seleccione una toma física para iniciar la conciliación.</div>
            }
            else if (!FilteredItems.Any())
            {
                <div class="rec-empty">No hay registros que coincidan con los filtros seleccionados.</div>
            }
            else
            {
                <div class="rec-table-wrapper ntx-table-scroll"
                     tabindex="0"
                     aria-label="Registros para conciliación">
                        <table class="rec-table">
                        <thead>
                            <tr>
                                <th class="rec-col-type">Tipo</th>
                                <th class="rec-col-code">Código / nombre</th>
                                <th class="rec-col-user">Usuario</th>
                                <th class="rec-col-class">Clasificación</th>
                                <th class="rec-col-location">Ubicación / responsable</th>
                                <th class="rec-col-status">Estado reportado</th>
                                <th class="rec-col-reconciliation">Conciliación</th>
                                <th class="rec-col-actions">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in FilteredItems)
                            {
                                <tr class="rec-data-row">
                                    <td>
                                        <span class="@GetReportTypeClass(item)">
                                            @GetReportTypeLabel(item)
                                        </span>
                                        <small>@Display(item.ReportType)</small>
                                    </td>

                                    <td>
                                        <strong>@Display(item.ToolInternalCode ?? item.ReportedCode ?? item.MatchedToolInternalCode)</strong>
                                        <span>@Display(item.ToolName ?? item.ReportedName ?? item.MatchedToolName)</span>

                                        @if (!string.IsNullOrWhiteSpace(item.SerialNumber))
                                        {
                                            <small>Serial: @item.SerialNumber</small>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(item.Brand) || !string.IsNullOrWhiteSpace(item.Model))
                                        {
                                            <small>@Display(item.Brand) @Display(item.Model)</small>
                                        }

                                        @if (item.CreatedToolAssetId.HasValue)
                                        {
                                            <small class="rec-created">Creado en inventario</small>
                                        }
                                    </td>

                                    <td>
                                        <strong>@Display(item.ParticipantName ?? item.ResponsibleName)</strong>
                                        <small>@Display(item.ParticipantUserName)</small>
                                        <small>Reportó: @Display(item.ReportedBy)</small>
                                    </td>

                                    <td>
                                        <span>Tipo: @Display(item.AssetTypeName)</span>
                                        <small>Categoría: @Display(item.CategoryName)</small>
                                    </td>

                                    <td>
                                        <span>Sede: @Display(item.BranchCode ?? board.BranchCode)</span>
                                        <small>Ubicación: @Display(item.FoundLocation)</small>
                                        <small>Responsable: @Display(item.ResponsibleName)</small>
                                    </td>

                                    <td>
                                        <span>Físico: @Display(item.PhysicalStatus)</span>
                                        <small>Operativo: @Display(item.OperationalStatus)</small>
                                        <small>@Display(item.Observation)</small>
                                    </td>

                                    <td>
                                        <span class="@GetReconciliationStatusClass(item)">
                                            @GetReconciliationLabel(item)
                                        </span>
                                        <small>@Display(item.ReconciliationObservation)</small>
                                    </td>

                                    <td>
                                        <div class="rec-actions">

                                            @* NAVI RECONCILIATION VIEW BUTTON V162 CORR1 START *@
                                            <button type="button"
                                                    class="rec-action rec-action-view"
                                                    data-ntx-tone="ghost"
                                                    @onclick="() => OpenDetailWithEvidenceAsync(item)">
                                                Ver
                                            </button>
                                            @* NAVI RECONCILIATION VIEW BUTTON V162 CORR1 END *@
                                            @if (CanRequestClarification(item))
                                            {
                                                <button type="button" class="rec-action warn" @onclick="() => RequestClarificationAsync(item.Id)" data-ntx-tone="ghost" >
                                                    Aclarar
                                                </button>
                                            }

                                            @if (CanResolveClarification(item))
                                            {
                                                <button type="button" class="rec-action neutral" @onclick="() => ResolveClarificationAsync(item.Id)" data-ntx-tone="ghost" >
                                                    Aclarado
                                                </button>
                                            }

                                            @if (CanApproveCreation(item))
                                            {
                                                <button type="button" class="rec-action ok" @onclick="() => ApproveCreationAsync(item.Id)" data-ntx-tone="affirmative" >
                                                    Aprobar creación
                                                </button>
                                            }

                                            @if (CanCreateInventoryAsset(item))
                                            {
                                                <button type="button" class="rec-action ok-fill" @onclick="() => CreateInventoryAssetAsync(item.Id)" data-ntx-tone="operation" >
                                                    Crear activo
                                                </button>
                                            }

                                            @if (CanReconcile(item))
                                            {
                                                <button type="button" class="rec-action neutral" @onclick="() => ReconcileAsync(item.Id)" data-ntx-tone="ghost" >
                                                    Conciliar
                                                </button>
                                            }

                                            @if (CanReject(item))
                                            {
                                                <button type="button" class="rec-action danger" @onclick="() => RejectAsync(item.Id)" data-ntx-tone="danger" >
                                                    Rechazar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>


        @* NAVI RECONCILIATION DETAIL MODAL V162 CORR1 START *@
        @if (detailItem is not null)
        {
            <div class="rec-detail-backdrop"
                 role="presentation"
                 @onclick="CloseDetail">

                <section class="rec-detail-modal"
                         role="dialog"
                         aria-modal="true"
                         aria-labelledby="rec-detail-title"
                         @onclick:stopPropagation="true">

                    <header class="rec-detail-header">

                        <div>
                            <span class="rec-detail-eyebrow">
                                Conciliación
                            </span>

                            <h2 id="rec-detail-title">
                                Detalle del registro
                            </h2>

                            <p>
                                @Display(
                                    detailItem.ToolInternalCode
                                    ?? detailItem.ReportedCode
                                    ?? detailItem.MatchedToolInternalCode
                                )
                                ·
                                @Display(
                                    detailItem.ToolName
                                    ?? detailItem.ReportedName
                                    ?? detailItem.MatchedToolName
                                )
                            </p>
                        </div>

                        <button type="button"
                                class="rec-detail-close"
                                aria-label="Cerrar detalle"
                                title="Cerrar"
                                @onclick="CloseDetail">
                            ×
                        </button>

                    </header>

                    <div class="rec-detail-body">

                        <div class="rec-detail-status-row">

                            <div>
                                <span>Tipo de reporte</span>
                                <strong>
                                    @GetReportTypeLabel(
                                        detailItem
                                    )
                                </strong>
                            </div>

                            <div>
                                <span>Conciliación</span>
                                <strong>
                                    @GetReconciliationLabel(
                                        detailItem
                                    )
                                </strong>
                            </div>

                            <div>
                                <span>Datos mínimos</span>
                                <strong>
                                    @(detailItem.MinimumDataCompleted
                                        ? "Completos"
                                        : "Sin mínimos")
                                </strong>
                            </div>

                            <div>
                                <span>Fecha reportada</span>
                                <strong>
                                    @FormatDate(
                                        detailItem.ReportedAt
                                    )
                                </strong>
                            </div>

                        </div>

                        <div class="rec-detail-sections">

                            <article class="rec-detail-section">

                                <h3>
                                    Identificación del activo
                                </h3>

                                <dl class="rec-detail-grid">

                                    <div>
                                        <dt>Código interno</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .ToolInternalCode
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Nombre del activo</dt>
                                        <dd>
                                            @Display(
                                                detailItem.ToolName
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Código reportado</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .ReportedCode
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Nombre reportado</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .ReportedName
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Código coincidente</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .MatchedToolInternalCode
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Nombre coincidente</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .MatchedToolName
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Serial</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .SerialNumber
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Marca</dt>
                                        <dd>
                                            @Display(
                                                detailItem.Brand
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Modelo</dt>
                                        <dd>
                                            @Display(
                                                detailItem.Model
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Creado en inventario</dt>
                                        <dd>
                                            @(detailItem
                                                .CreatedToolAssetId
                                                .HasValue
                                                    ? "Sí"
                                                    : "No")
                                        </dd>
                                    </div>

                                </dl>

                            </article>


                            <article class="rec-detail-section">

                                <h3>
                                    Usuario y reporte
                                </h3>

                                <dl class="rec-detail-grid">

                                    <div>
                                        <dt>Participante</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .ParticipantName
                                                ?? detailItem
                                                    .ResponsibleName
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Usuario</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .ParticipantUserName
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Reportado por</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .ReportedBy
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Fecha reportada</dt>
                                        <dd>
                                            @FormatDate(
                                                detailItem
                                                    .ReportedAt
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Tipo de reporte</dt>
                                        <dd>
                                            @GetReportTypeLabel(
                                                detailItem
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Código de reporte</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .ReportType
                                            )
                                        </dd>
                                    </div>

                                </dl>

                            </article>


                            <article class="rec-detail-section">

                                <h3>
                                    Clasificación y ubicación
                                </h3>

                                <dl class="rec-detail-grid">

                                    <div>
                                        <dt>Tipo de activo</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .AssetTypeName
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Categoría</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .CategoryName
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Sede</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .BranchCode
                                                ?? board
                                                    ?.BranchCode
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>
                                            Ubicación encontrada
                                        </dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .FoundLocation
                                            )
                                        </dd>
                                    </div>

                                    <div class="rec-detail-field-wide">
                                        <dt>Responsable</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .ResponsibleName
                                            )
                                        </dd>
                                    </div>

                                </dl>

                            </article>


                            <article class="rec-detail-section">

                                <h3>
                                    Estado reportado
                                </h3>

                                <dl class="rec-detail-grid">

                                    <div>
                                        <dt>Estado físico</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .PhysicalStatus
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Estado operativo</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .OperationalStatus
                                            )
                                        </dd>
                                    </div>

                                    <div class="rec-detail-field-wide">
                                        <dt>Observación</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .Observation
                                            )
                                        </dd>
                                    </div>

                                </dl>

                            </article>


                            <article class="rec-detail-section">

                                <h3>
                                    Conciliación
                                </h3>

                                <dl class="rec-detail-grid">

                                    <div>
                                        <dt>Estado</dt>
                                        <dd>
                                            @GetReconciliationLabel(
                                                detailItem
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>
                                            Requiere aclaración
                                        </dt>
                                        <dd>
                                            @(detailItem
                                                .RequiresUserClarification
                                                    ? "Sí"
                                                    : "No")
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>
                                            Aprobado para creación
                                        </dt>
                                        <dd>
                                            @(detailItem
                                                .ApprovedForCreation
                                                    ? "Sí"
                                                    : "No")
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Rechazado</dt>
                                        <dd>
                                            @(detailItem.Rejected
                                                ? "Sí"
                                                : "No")
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>Conciliado por</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .ReconciledBy
                                            )
                                        </dd>
                                    </div>

                                    <div>
                                        <dt>
                                            Fecha de conciliación
                                        </dt>
                                        <dd>
                                            @FormatDate(
                                                detailItem
                                                    .ReconciledAt
                                            )
                                        </dd>
                                    </div>

                                    <div class="rec-detail-field-wide">
                                        <dt>
                                            Observación de conciliación
                                        </dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .ReconciliationObservation
                                            )
                                        </dd>
                                    </div>

                                </dl>

                            </article>


                            <article class="rec-detail-section">

                                <h3>
                                    Datos mínimos
                                </h3>

                                <dl class="rec-detail-grid">

                                    <div>
                                        <dt>Estado</dt>
                                        <dd>
                                            @(detailItem
                                                .MinimumDataCompleted
                                                    ? "Completos"
                                                    : "Sin mínimos")
                                        </dd>
                                    </div>

                                    <div class="rec-detail-field-wide">
                                        <dt>Datos faltantes</dt>
                                        <dd>
                                            @Display(
                                                detailItem
                                                    .MissingRequiredData
                                            )
                                        </dd>
                                    </div>

                                </dl>

                            </article>

                        </div>


                        @* NAVI RECONCILIATION EVIDENCE GALLERY V170 START *@
                        <article class="rec-detail-section
                                        rec-detail-evidence-section">

                            <div class="rec-evidence-heading">

                                <div>
                                    <h3>Evidencias subidas</h3>

                                    <p>
                                        Fotografías y documentos asociados
                                        al registro y a la herramienta.
                                    </p>
                                </div>

                                <span class="rec-evidence-count">
                                    @detailEvidences.Count archivo(s)
                                </span>

                            </div>


                            @if (isLoadingDetailEvidences)
                            {
