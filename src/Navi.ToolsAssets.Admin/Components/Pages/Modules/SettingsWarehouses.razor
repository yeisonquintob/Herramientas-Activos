@page "/settings/warehouses"
@rendermode InteractiveServer
@using Navi.ToolsAssets.Admin.Services.Auth
@using Navi.ToolsAssets.Admin.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject WebAuthSessionService AuthSession

<PageTitle>Almacenes / Talleres - Configuración</PageTitle>

@* NAVI SETTINGS INTERNAL STANDARD V225.1 *@
<NaviPageHero
    Pill="CONFIGURACIÓN"
    Title="Almacenes / Talleres"
    Description="Administra almacenes, talleres, bodegas, patios, oficinas y áreas técnicas asociadas a cada sede." />

<div class="settings-v2251-toolbar">

    <a href="/settings"
       class="settings-v2251-back">
        ← Volver a configuración
    </a>

    @if (CanManageSettings)
    {
        <button type="button"
                class="settings-v2251-new"
                @onclick="OpenSettingsV2251NewModal"
                data-ntx-tone="affirmative">
            + Nuevo almacén / taller
        </button>
    }

    <NaviRefreshButton
        OnClick="LoadAsync"
        Loading="isLoading"
        Title="Actualizar"
        AriaLabel="Actualizar información" />
</div>

@if (!showSettingsV2251Modal &&
     !string.IsNullOrWhiteSpace(message))
{
    <div class="@messageClass"
         role="status">
        @message
    </div>
}

<div class="settings-crud-table settings-v2251-list">
        <div class="settings-table-header">
            <h2>Almacenes / Talleres registrados</h2>

        </div>

        @if (isLoading)
        {
            <p role="status" aria-busy="true">Cargando almacenes y talleres...</p>
        }
        else if (warehouses.Count == 0)
        {
            <div class="alert alert-info">No hay almacenes o talleres registrados.</div>
        }
        else
        {
            <div class="ntx-table-scroll">
                <table class="table table-hover align-middle settings-v2251-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Sede</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var warehouse in warehouses)
                    {
                        <tr>
                            <td><strong>@warehouse.Code</strong></td>
                            <td>@warehouse.Name</td>
                            <td>@(warehouse.Branch is null ? "Sin sede" : $"{warehouse.Branch.Code} - {warehouse.Branch.Name}")</td>
                            <td>
                                <span class="settings-description-cell">
                                    @warehouse.Description
                                </span>
                            </td>
                            <td>
                                <span class="badge @(warehouse.IsActive ? "navi-bg-affirmative" : "bg-secondary")">
                                    @(warehouse.IsActive ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end">
                                @if (CanManageSettings)
                                    {
                                        <button class="btn btn-sm ntx-btn--operation" @onclick="() => OpenSettingsV2251EditModal(warehouse)" data-ntx-tone="operation" >Editar</button>
                                    }
                                @if (CanManageSettings)
                                    {
                                        <button class="btn btn-sm ntx-btn--danger" @onclick="() => DeleteAsync(warehouse.Id)" data-ntx-tone="danger" >Eliminar</button>
                                    }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>

<NaviModal
    IsOpen="showSettingsV2251Modal"
    Title="@SettingsV2251ModalTitle"
    Description="Registra o actualiza almacenes, talleres, bodegas y áreas operativas."
    OnClose="CloseSettingsV2251Modal"
    Class="settings-v2251-modal">

    <EditForm Model="formModel" OnValidSubmit="SaveAsync" class="settings-v2251-modal-form">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="navi-settingswarehouses-control-001">Código</label>
                    <InputText class="form-control" @bind-Value="formModel.Code" placeholder="AGU-TALLER, AGU-BOD-HERR"  disabled="@(!CanManageSettings)" id="navi-settingswarehouses-control-001" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="navi-settingswarehouses-control-002">Nombre</label>
                    <InputText class="form-control" @bind-Value="formModel.Name" placeholder="Taller, Bodega de herramientas"  disabled="@(!CanManageSettings)" id="navi-settingswarehouses-control-002" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="navi-settingswarehouses-control-003">Sede</label>
                    <InputSelect class="form-select" @bind-Value="formModel.BranchId" disabled="@(!CanManageSettings)" id="navi-settingswarehouses-control-003">
                        <option value="">Seleccione sede</option>
                        @foreach (var branch in branches)
                        {
                            <option value="@branch.Id">@branch.Code - @branch.Name</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="navi-settingswarehouses-control-004">Descripción</label>
                    <InputTextArea class="form-control" @bind-Value="formModel.Description" rows="3" placeholder="Zona de mantenimiento, almacén principal, patio operativo..."  disabled="@(!CanManageSettings)" id="navi-settingswarehouses-control-004" />
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" @bind-Value="formModel.IsActive"  disabled="@(!CanManageSettings)" name="navi-settingswarehouses-field-001" id="navi-settingswarehouses-control-005" />
                    <label class="form-check-label" for="navi-settingswarehouses-control-005">Activo</label>
                </div>

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <div class="@messageClass">@message</div>
                }

                <div class="settings-crud-actions">
                    <button class="btn ntx-btn--operation" type="submit" disabled="@(!CanManageSettings)" data-ntx-tone="affirmative" >Guardar</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearSettingsV2251ModalForm" data-ntx-tone="secondary" >Limpiar</button>

    <button class="btn ntx-btn--danger"
            type="button"
            @onclick="CloseSettingsV2251Modal"
            data-ntx-tone="danger">
        Cerrar
    </button>
    </div>
            </EditForm>
</NaviModal>

@code {

// NAVI SETTINGS INTERNAL STANDARD V225.1
private bool showSettingsV2251Modal;

private string SettingsV2251ModalTitle =>
    editingId is null
        ? "Nuevo almacén / taller"
        : "Editar almacén / taller";

private void OpenSettingsV2251NewModal()
{
    if (!CanManageSettings)
    {
        return;
    }

    ClearForm();
    message = string.Empty;
    showSettingsV2251Modal = true;
}

private void OpenSettingsV2251EditModal(
    WarehouseDto item)
{
    if (!CanManageSettings)
    {
        return;
    }

    Edit(item);
    message = string.Empty;
    showSettingsV2251Modal = true;
}

private void ClearSettingsV2251ModalForm()
{
    ClearForm();
    message = string.Empty;
}

private void CloseSettingsV2251Modal()
{
    showSettingsV2251Modal = false;
    ClearForm();
    message = string.Empty;
}



    private bool IsAdmin =>
        string.Equals(AuthSession.RoleCode, "ADMIN", StringComparison.OrdinalIgnoreCase)
        || string.Equals(AuthSession.RoleCode, "SUPERADMIN", StringComparison.OrdinalIgnoreCase);

    private bool CanManageSettings => IsAdmin || AuthSession.HasPermission("Settings.Manage");


    private HttpClient Api => HttpClientFactory.CreateClient("NaviApi");

    private List<WarehouseDto> warehouses = new();
    private List<BranchDto> branches = new();
    private WarehouseFormModel formModel = new();
    private Guid? editingId;
    private bool isLoading;
    private string message = string.Empty;
    private string messageClass = "alert alert-info";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    // NAVI LOCATION TYPE FILTER V228.1
    private static bool IsWarehouseCatalogCodeV2281(
        string? code)
    {
        var normalized =
            code?
                .Trim()
                .ToUpperInvariant()
            ?? string.Empty;

        return
            normalized.EndsWith(
                "-BOD-HERR",
                StringComparison.Ordinal)
            ||
            normalized.EndsWith(
                "-MANT",
                StringComparison.Ordinal)
            ||
            normalized.EndsWith(
                "-TALLER",
                StringComparison.Ordinal);
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        message = string.Empty;

        try
        {
            var loadedWarehouses =
                await Api.GetFromJsonAsync<List<WarehouseDto>>(
                    "api/settings/warehouses")
                ?? new();

            warehouses =
                loadedWarehouses
                    .Where(
                        item =>
                            IsWarehouseCatalogCodeV2281(
                                item.Code))
                    .ToList();
            branches = await Api.GetFromJsonAsync<List<BranchDto>>("api/settings/branches") ?? new();
        }
        catch (Exception ex)
        {
            ShowError($"No se pudieron cargar los almacenes o talleres: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (!CanManageSettings)
        {
            ShowError("No tienes permiso para modificar configuración.");
            return;
        }

        if (string.IsNullOrWhiteSpace(formModel.Code) ||
            string.IsNullOrWhiteSpace(formModel.Name) ||
            formModel.BranchId is null)
        {
            ShowError("Código, nombre y sede son obligatorios.");
            return;
        }

        var request = new
        {
            code = formModel.Code,
            name = formModel.Name,
            description = formModel.Description,
            branchId = formModel.BranchId.Value,
            isActive = formModel.IsActive,
            changedBy = "admin-web"
        };

        try
        {
            HttpResponseMessage response = editingId is null
                ? await Api.PostAsJsonAsync("api/settings/warehouses", request)
                : await Api.PutAsJsonAsync($"api/settings/warehouses/{editingId}", request);

            if (!response.IsSuccessStatusCode)
            {
                ShowError(await response.Content.ReadAsStringAsync());
                return;
            }

            ShowSuccess(editingId is null ? "Almacén / taller creado correctamente." : "Almacén / taller actualizado correctamente.");
            ClearForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowError($"Error guardando almacén / taller: {ex.Message}");
        }
    }

    private void Edit(WarehouseDto warehouse)
    {
        if (!CanManageSettings)
        {
            ShowError("No tienes permiso para editar configuración.");
            return;
        }

        editingId = warehouse.Id;

        formModel = new WarehouseFormModel
        {
            Code = warehouse.Code,
            Name = warehouse.Name,
            Description = warehouse.Description,
            BranchId = warehouse.BranchId,
            IsActive = warehouse.IsActive
        };
    }

    private async Task DeleteAsync(Guid id)
    {
        if (!CanManageSettings)
        {
            ShowError("No tienes permiso para eliminar configuración.");
            return;
        }

        try
        {
            var response = await Api.DeleteAsync($"api/settings/warehouses/{id}?changedBy=admin-web");

            if (!response.IsSuccessStatusCode)
            {
                ShowError(await response.Content.ReadAsStringAsync());
                return;
            }

            ShowSuccess("Almacén / taller eliminado correctamente.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowError($"Error eliminando almacén / taller: {ex.Message}");
        }
    }

    private void ClearForm()
    {
        editingId = null;
        formModel = new WarehouseFormModel();
    }

    private void ShowSuccess(string value)
    {
        message = value;
        messageClass = "alert alert-success";
    }

    private void ShowError(string value)
    {
        message = value;
        messageClass = "alert alert-danger";
    }

    private sealed class WarehouseDto
    {
        public Guid Id { get; set; }
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public Guid BranchId { get; set; }
        public BranchDto? Branch { get; set; }
        public bool IsActive { get; set; }
    }

    private sealed class BranchDto
    {
        public Guid Id { get; set; }
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
    }

    private sealed class WarehouseFormModel
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public Guid? BranchId { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
