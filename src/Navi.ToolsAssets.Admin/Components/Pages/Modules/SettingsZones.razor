@page "/settings/zones"
@rendermode InteractiveServer
@using Navi.ToolsAssets.Admin.Services.Auth
@using Navi.ToolsAssets.Admin.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject WebAuthSessionService AuthSession

<PageTitle>Zonas - Configuración</PageTitle>

@* NAVI ZONES MODAL STANDARD V224.3 *@
<NaviPageHero
    Pill="CONFIGURACIÓN"
    Title="Zonas"
    Description="Administra zonas, regionales o agrupaciones administrativas que organizan las sedes del sistema." />

<div class="zones-v2243-toolbar">

    <NaviActionButton
        Href="/settings"
        Tone="danger"
        Size="sm">
        Volver a configuración
    </NaviActionButton>

    @if (CanManageSettings)
    {
        <NaviActionButton
            Tone="affirmative"
            Size="sm"
            OnClick="OpenCreateZoneModal">
            + Nueva zona
        </NaviActionButton>
    }

    <NaviRefreshButton
        OnClick="LoadAsync"
        Loading="isLoading"
        Title="Actualizar zonas"
        AriaLabel="Actualizar zonas" />
</div>

@if (!showZoneModal &&
     !string.IsNullOrWhiteSpace(message))
{
    <div class="@messageClass"
         role="status">
        @message
    </div>
}

<section class="zones-v2243-list-panel">

    <div class="zones-v2243-list-heading">
        <div>
            <span>CONFIGURACIÓN</span>
            <h2>Zonas registradas</h2>
        </div>

        <strong>
            @zones.Count
            @(zones.Count == 1 ? "zona" : "zonas")
        </strong>
    </div>

    @if (isLoading)
    {
        <p role="status"
           aria-busy="true"
           class="zones-v2243-loading">
            Cargando zonas...
        </p>
    }
    else if (zones.Count == 0)
    {
        <div class="alert alert-info">
            No hay zonas registradas.
        </div>
    }
    else
    {
        <div class="ntx-table-scroll zones-v2243-table-scroll">

            <table class="table table-hover align-middle zones-v2243-table">

                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th class="text-end">
                            Acciones
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var zone in zones)
                    {
                        <tr>
                            <td>
                                <strong>@zone.Code</strong>
                            </td>

                            <td>
                                @zone.Name
                            </td>

                            <td>
                                <span class="settings-description-cell">
                                    @zone.Description
                                </span>
                            </td>

                            <td>
                                <span class="badge @(zone.IsActive
                                    ? "navi-bg-affirmative"
                                    : "bg-secondary")">

                                    @(zone.IsActive
                                        ? "Activa"
                                        : "Inactiva")
                                </span>
                            </td>

                            <td class="text-end zones-v2243-row-actions">

                                @if (CanManageSettings)
                                {
                                    <button
                                        type="button"
                                        class="btn btn-sm ntx-btn--operation"
                                        data-ntx-tone="operation"
                                        @onclick="() => OpenEditZoneModal(zone)">

                                        Editar
                                    </button>

                                    <button
                                        type="button"
                                        class="btn btn-sm ntx-btn--danger"
                                        data-ntx-tone="danger"
                                        @onclick="() => DeleteAsync(zone.Id)">

                                        Eliminar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<NaviModal
    IsOpen="showZoneModal"
    Title="@ZoneModalTitle"
    Description="@ZoneModalDescription"
    OnClose="CloseZoneModal"
    Class="zones-v2243-modal">

    <EditForm
        Model="formModel"
        OnValidSubmit="SaveAsync"
        class="zones-v2243-modal-form">

        <DataAnnotationsValidator />

        <div class="zones-v2243-form-grid">

            <div class="zones-v2243-field">
                <label
                    class="form-label"
                    for="navi-settingszones-control-001">

                    Código
                </label>

                <InputText
                    class="form-control"
                    @bind-Value="formModel.Code"
                    placeholder="ANT, CUN, VAL, NOR"
                    disabled="@(!CanManageSettings)"
                    id="navi-settingszones-control-001" />
            </div>

            <div class="zones-v2243-field">
                <label
                    class="form-label"
                    for="navi-settingszones-control-002">

                    Nombre
                </label>

                <InputText
                    class="form-control"
                    @bind-Value="formModel.Name"
                    placeholder="Antioquia, Cundinamarca, Valle"
                    disabled="@(!CanManageSettings)"
                    id="navi-settingszones-control-002" />
            </div>

            <div class="zones-v2243-field zones-v2243-field-wide">
                <label
                    class="form-label"
                    for="navi-settingszones-control-003">

                    Descripción
                </label>

                <InputTextArea
                    class="form-control"
                    @bind-Value="formModel.Description"
                    rows="4"
                    placeholder="Regional, zona operativa o agrupación administrativa."
                    disabled="@(!CanManageSettings)"
                    id="navi-settingszones-control-003" />
            </div>

            <div class="zones-v2243-field-wide zones-v2243-checkbox-row">

                <InputCheckbox
                    class="form-check-input"
                    @bind-Value="formModel.IsActive"
                    disabled="@(!CanManageSettings)"
                    name="navi-settingszones-field-001"
                    id="navi-settingszones-control-004" />

                <label
                    class="form-check-label"
                    for="navi-settingszones-control-004">

                    Activa
                </label>
            </div>
        </div>

        @if (showZoneModal &&
             !string.IsNullOrWhiteSpace(message))
        {
            <div class="@messageClass"
                 role="status">
                @message
            </div>
        }

        <div class="zones-v2243-modal-actions">

            <button
                class="ntx-btn ntx-btn--affirmative"
                type="submit"
                disabled="@(!CanManageSettings)"
                data-ntx-tone="affirmative">

                @(editingId is null
                    ? "Guardar"
                    : "Actualizar")
            </button>

            <NaviActionButton
                Tone="secondary"
                Size="sm"
                OnClick="ClearZoneModalForm">

                Limpiar
            </NaviActionButton>

            <NaviActionButton
                Tone="danger"
                Size="sm"
                OnClick="CloseZoneModal">

                Cerrar
            </NaviActionButton>
        </div>
    </EditForm>
</NaviModal>

@code {

    private bool IsAdmin =>
        string.Equals(AuthSession.RoleCode, "ADMIN", StringComparison.OrdinalIgnoreCase)
        || string.Equals(AuthSession.RoleCode, "SUPERADMIN", StringComparison.OrdinalIgnoreCase);

    private bool CanManageSettings => IsAdmin || AuthSession.HasPermission("Settings.Manage");


    private HttpClient Api => HttpClientFactory.CreateClient("NaviApi");

    private List<ZoneDto> zones = new();
    private ZoneFormModel formModel = new();
    private Guid? editingId;
    private bool isLoading;
    private bool showZoneModal;

    private string ZoneModalTitle =>
        editingId is null
            ? "Nueva zona"
            : "Editar zona";

    private string ZoneModalDescription =>
        editingId is null
            ? "Registra una nueva zona administrativa u operativa."
            : "Actualiza la información de la zona seleccionada.";

    private string message = string.Empty;
    private string messageClass = "alert alert-info";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        message = string.Empty;

        try
        {
            zones = await Api.GetFromJsonAsync<List<ZoneDto>>("api/settings/zones") ?? new();
        }
        catch (Exception ex)
        {
            ShowError($"No se pudieron cargar las zonas: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (!CanManageSettings)
        {
            ShowError("No tienes permiso para modificar configuración.");
            return;
        }

        if (string.IsNullOrWhiteSpace(formModel.Code) ||
            string.IsNullOrWhiteSpace(formModel.Name))
        {
            ShowError("Código y nombre son obligatorios.");
            return;
        }

        var request = new
        {
            code = formModel.Code,
            name = formModel.Name,
            description = formModel.Description,
            isActive = formModel.IsActive,
            changedBy = "admin-web"
        };

        try
        {
            HttpResponseMessage response = editingId is null
                ? await Api.PostAsJsonAsync("api/settings/zones", request)
                : await Api.PutAsJsonAsync($"api/settings/zones/{editingId}", request);

            if (!response.IsSuccessStatusCode)
            {
                ShowError(await response.Content.ReadAsStringAsync());
                return;
            }

            var successMessage =
                editingId is null
                    ? "Zona creada correctamente."
                    : "Zona actualizada correctamente.";

            ClearForm();
            await LoadAsync();

            showZoneModal = false;
            ShowSuccess(successMessage);
        }
        catch (Exception ex)
        {
            ShowError($"Error guardando zona: {ex.Message}");
        }
    }

    // NAVI ZONES MODAL STANDARD V224.3
    private void OpenCreateZoneModal()
    {
        if (!CanManageSettings)
        {
            ShowError(
                "No tienes permiso para modificar configuración.");

            return;
        }

        ClearForm();
        message = string.Empty;
        showZoneModal = true;
    }

    private void OpenEditZoneModal(
        ZoneDto zone)
    {
        if (!CanManageSettings)
        {
            ShowError(
                "No tienes permiso para editar configuración.");

            return;
        }

        message = string.Empty;
        Edit(zone);
        showZoneModal = true;
    }

    private void CloseZoneModal()
    {
        showZoneModal = false;
        ClearForm();
        message = string.Empty;
    }

    private void ClearZoneModalForm()
    {
        ClearForm();
        message = string.Empty;
    }

    private void Edit(ZoneDto zone)
    {
        if (!CanManageSettings)
        {
            ShowError("No tienes permiso para editar configuración.");
            return;
        }

        editingId = zone.Id;

        formModel = new ZoneFormModel
        {
            Code = zone.Code,
            Name = zone.Name,
            Description = zone.Description,
            IsActive = zone.IsActive
        };
    }

    private async Task DeleteAsync(Guid id)
    {
        if (!CanManageSettings)
        {
            ShowError("No tienes permiso para eliminar configuración.");
            return;
        }

        try
        {
            var response = await Api.DeleteAsync($"api/settings/zones/{id}?changedBy=admin-web");

            if (!response.IsSuccessStatusCode)
            {
                ShowError(await response.Content.ReadAsStringAsync());
                return;
            }

            ShowSuccess("Zona eliminada correctamente.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowError($"Error eliminando zona: {ex.Message}");
        }
    }

    private void ClearForm()
    {
        editingId = null;
        formModel = new ZoneFormModel();
    }

    private void ShowSuccess(string value)
    {
        message = value;
        messageClass = "alert alert-success";
    }

    private void ShowError(string value)
    {
        message = value;
        messageClass = "alert alert-danger";
    }

    private sealed class ZoneDto
    {
        public Guid Id { get; set; }
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool IsActive { get; set; }
    }

    private sealed class ZoneFormModel
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
