/* --------------------------------------------------------------------------
   2. Contenedores de tablas
   -------------------------------------------------------------------------- */

.navi-content :where(
    .table-responsive,
    .table-wrapper,
    .data-table-wrapper,
    .navi-table-wrapper,
    .results-table,
    .settings-table,
    .reports-table,
