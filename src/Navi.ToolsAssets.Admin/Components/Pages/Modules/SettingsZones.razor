@page "/settings/zones"
@rendermode InteractiveServer
@using Navi.ToolsAssets.Admin.Services.Auth
@using Navi.ToolsAssets.Admin.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject WebAuthSessionService AuthSession

<PageTitle>Zonas - Configuración</PageTitle>

<NaviPageHero
    Pill="CONFIGURACIÓN"
    Title="Zonas"
    Description="Administra zonas, regionales o agrupaciones administrativas que organizan las sedes del sistema.">

    <a href="/settings">
        Volver a Configuración
    </a>

</NaviPageHero>

<section class="settings-crud-layout">
    <div class="settings-crud-form">
        <h2>@(editingId is null ? "Crear zona" : "Editar zona")</h2>

        <EditForm Model="formModel" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label" for="navi-settingszones-control-001">Código</label>
                <InputText class="form-control" @bind-Value="formModel.Code" placeholder="ANT, CUN, VAL, NOR"  disabled="@(!CanManageSettings)" id="navi-settingszones-control-001" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="navi-settingszones-control-002">Nombre</label>
                <InputText class="form-control" @bind-Value="formModel.Name" placeholder="Antioquia, Cundinamarca, Valle"  disabled="@(!CanManageSettings)" id="navi-settingszones-control-002" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="navi-settingszones-control-003">Descripción</label>
                <InputTextArea class="form-control" @bind-Value="formModel.Description" rows="3" placeholder="Regional, zona operativa o agrupación administrativa."  disabled="@(!CanManageSettings)" id="navi-settingszones-control-003" />
            </div>

            <div class="form-check mb-3">
                <InputCheckbox class="form-check-input" @bind-Value="formModel.IsActive"  disabled="@(!CanManageSettings)" name="navi-settingszones-field-001" id="navi-settingszones-control-004" />
                <label class="form-check-label" for="navi-settingszones-control-004">Activa</label>
            </div>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="@messageClass">@message</div>
            }

            <div class="settings-crud-actions">
                <button class="btn ntx-btn--operation" type="submit" disabled="@(!CanManageSettings)" data-ntx-tone="affirmative" >Guardar</button>
                <button class="btn btn-outline-secondary" type="button" @onclick="ClearForm" data-ntx-tone="secondary" >Limpiar</button>
            </div>
        </EditForm>
    </div>

    <div class="settings-crud-table">
        <div class="settings-table-header">
            <h2>Zonas registradas</h2>
            <button class="btn btn-sm ntx-btn--operation" @onclick="LoadAsync" data-ntx-tone="refresh" >Actualizar</button>
        </div>

        @if (isLoading)
        {
            <p role="status" aria-busy="true">Cargando zonas...</p>
        }
        else if (zones.Count == 0)
        {
            <div class="alert alert-info">No hay zonas registradas.</div>
        }
        else
        {
            <div class="ntx-table-scroll">
                <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var zone in zones)
                    {
                        <tr>
                            <td><strong>@zone.Code</strong></td>
                            <td>@zone.Name</td>
                            <td>
                                <span class="settings-description-cell">
                                    @zone.Description
                                </span>
                            </td>
                            <td>
                                <span class="badge @(zone.IsActive ? "navi-bg-affirmative" : "bg-secondary")">
                                    @(zone.IsActive ? "Activa" : "Inactiva")
                                </span>
                            </td>
                            <td class="text-end">
                                @if (CanManageSettings)
                                    {
                                        <button class="btn btn-sm ntx-btn--operation" @onclick="() => Edit(zone)" data-ntx-tone="operation" >Editar</button>
                                    }
                                @if (CanManageSettings)
                                    {
                                        <button class="btn btn-sm ntx-btn--danger" @onclick="() => DeleteAsync(zone.Id)" data-ntx-tone="danger" >Eliminar</button>
                                    }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
</section>



@code {

    private bool IsAdmin =>
        string.Equals(AuthSession.RoleCode, "ADMIN", StringComparison.OrdinalIgnoreCase)
        || string.Equals(AuthSession.RoleCode, "SUPERADMIN", StringComparison.OrdinalIgnoreCase);

    private bool CanManageSettings => IsAdmin || AuthSession.HasPermission("Settings.Manage");


    private HttpClient Api => HttpClientFactory.CreateClient("NaviApi");

    private List<ZoneDto> zones = new();
    private ZoneFormModel formModel = new();
    private Guid? editingId;
    private bool isLoading;
    private string message = string.Empty;
    private string messageClass = "alert alert-info";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        message = string.Empty;

        try
        {
            zones = await Api.GetFromJsonAsync<List<ZoneDto>>("api/settings/zones") ?? new();
        }
        catch (Exception ex)
        {
            ShowError($"No se pudieron cargar las zonas: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (!CanManageSettings)
        {
            ShowError("No tienes permiso para modificar configuración.");
            return;
        }

        if (string.IsNullOrWhiteSpace(formModel.Code) ||
            string.IsNullOrWhiteSpace(formModel.Name))
        {
            ShowError("Código y nombre son obligatorios.");
            return;
        }

        var request = new
        {
            code = formModel.Code,
            name = formModel.Name,
            description = formModel.Description,
            isActive = formModel.IsActive,
            changedBy = "admin-web"
        };

        try
        {
            HttpResponseMessage response = editingId is null
                ? await Api.PostAsJsonAsync("api/settings/zones", request)
                : await Api.PutAsJsonAsync($"api/settings/zones/{editingId}", request);

            if (!response.IsSuccessStatusCode)
            {
                ShowError(await response.Content.ReadAsStringAsync());
                return;
            }

            ShowSuccess(editingId is null ? "Zona creada correctamente." : "Zona actualizada correctamente.");
            ClearForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowError($"Error guardando zona: {ex.Message}");
        }
    }

    private void Edit(ZoneDto zone)
    {
        if (!CanManageSettings)
        {
            ShowError("No tienes permiso para editar configuración.");
            return;
        }

        editingId = zone.Id;

        formModel = new ZoneFormModel
        {
            Code = zone.Code,
            Name = zone.Name,
            Description = zone.Description,
            IsActive = zone.IsActive
        };
    }

    private async Task DeleteAsync(Guid id)
    {
        if (!CanManageSettings)
        {
            ShowError("No tienes permiso para eliminar configuración.");
            return;
        }

        try
        {
            var response = await Api.DeleteAsync($"api/settings/zones/{id}?changedBy=admin-web");

            if (!response.IsSuccessStatusCode)
            {
                ShowError(await response.Content.ReadAsStringAsync());
                return;
            }

            ShowSuccess("Zona eliminada correctamente.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowError($"Error eliminando zona: {ex.Message}");
        }
    }

    private void ClearForm()
    {
        editingId = null;
        formModel = new ZoneFormModel();
    }

    private void ShowSuccess(string value)
    {
        message = value;
        messageClass = "alert alert-success";
    }

    private void ShowError(string value)
    {
        message = value;
        messageClass = "alert alert-danger";
    }

    private sealed class ZoneDto
    {
        public Guid Id { get; set; }
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool IsActive { get; set; }
    }

    private sealed class ZoneFormModel
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
