/* --------------------------------------------------------------------------
   7. Peligro: rojo
   Uso: Eliminar, Desactivar, Denegar, Cancelar, Rechazar.
   -------------------------------------------------------------------------- */

.btn-danger,
.navi-btn-danger {
    color: #ffffff !important;
    border-color: var(--navi-btn-red) !important;
