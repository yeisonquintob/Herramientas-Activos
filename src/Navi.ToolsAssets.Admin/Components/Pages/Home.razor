    private async Task LoadDashboardFilterDataAsync(HttpClient client)
    {
        try
        {
            dashboardTools = await client.GetFromJsonAsync<List<DashboardToolFilterItem>>("api/tools") ?? new();
        }
        catch
        {
            dashboardTools = new();
        }

        try
        {
            dashboardBranches = await client.GetFromJsonAsync<List<DashboardBranchFilterOption>>("api/settings/branches") ?? new();
        }
        catch
        {
            dashboardBranches = new();
        }

        var branchOptionsFromTools = dashboardTools
            .Where(x => !string.IsNullOrWhiteSpace(x.BranchCode) || !string.IsNullOrWhiteSpace(x.BranchName))
            .Select(x => new DashboardBranchFilterOption
            {
                Code = x.BranchCode,
                Name = x.BranchName
            });

        dashboardBranches = dashboardBranches
            .Concat(branchOptionsFromTools)
            .Where(x => !string.IsNullOrWhiteSpace(x.Code) || !string.IsNullOrWhiteSpace(x.Name))
            .GroupBy(x => $"{NormalizeDashboardWebFilterText(x.Code)}|{NormalizeDashboardWebFilterText(x.Name)}")
            .Select(x => x.First())
            .OrderBy(x => x.Code)
            .ThenBy(x => x.Name)
            .ToList();
    }

    private void ApplyLocalDashboardFilters()
    {
        if (dashboard is null || dashboardTools.Count == 0)
        {
            return;
        }

        var filtered = DashboardFilteredTools.ToList();

        dashboard.Summary = BuildDashboardSummary(filtered);
        dashboard.ToolsByStatus = BuildDashboardStatusItems(filtered);
        dashboard.ToolsByBranch = BuildDashboardBranchItems(filtered);
        dashboard.GeneratedAt = DateTime.Now;
    }

    private IEnumerable<DashboardToolFilterItem> DashboardFilteredTools =>
        dashboardTools
            .Where(MatchesDashboardToolFilters)
            .OrderBy(x => x.BranchCode)
            .ThenBy(x => x.InternalCode)
            .ThenBy(x => x.SerialNumber);

    private bool MatchesDashboardToolFilters(DashboardToolFilterItem tool)
    {
        if (!string.IsNullOrWhiteSpace(filterBranchCode))
        {
            var branch = filterBranchCode;

            if (!ContainsDashboardWebFilterText(tool.BranchCode, branch) &&
                !ContainsDashboardWebFilterText(tool.BranchName, branch))
            {
                return false;
            }
        }

        if (!string.IsNullOrWhiteSpace(filterOperationalStatus))
        {
            if (!SameDashboardWebFilterText(tool.OperationalStatus, filterOperationalStatus) &&
                !SameDashboardWebFilterText(GetDashboardWebStatusLabel(tool.OperationalStatus), filterOperationalStatus))
            {
                return false;
            }
        }

        if (!string.IsNullOrWhiteSpace(filterText))
        {
            var text = filterText;

            if (!ContainsDashboardWebFilterText(tool.InternalCode, text) &&
                !ContainsDashboardWebFilterText(tool.Name, text) &&
                !ContainsDashboardWebFilterText(tool.SerialNumber, text) &&
                !ContainsDashboardWebFilterText(tool.FixedAssetCode, text) &&
                !ContainsDashboardWebFilterText(tool.FenixCode, text) &&
                !ContainsDashboardWebFilterText(tool.BranchCode, text) &&
                !ContainsDashboardWebFilterText(tool.BranchName, text) &&
                !ContainsDashboardWebFilterText(tool.LocationName, text) &&
                !ContainsDashboardWebFilterText(tool.ResponsiblePersonName, text) &&
                !ContainsDashboardWebFilterText(tool.PhysicalStatus, text) &&
                !ContainsDashboardWebFilterText(tool.OperationalStatus, text) &&
                !ContainsDashboardWebFilterText(GetDashboardWebStatusLabel(tool.OperationalStatus), text))
            {
                return false;
            }
        }

        return true;
    }

    private DashboardSummary BuildDashboardSummary(List<DashboardToolFilterItem> source)
    {
        return new DashboardSummary
        {
            TotalTools = source.Count,
            AvailableTools = CountDashboardWebStatus(source, "Available"),
            PendingValidationTools = CountDashboardWebStatus(source, "PendingValidation"),
            AssignedTools = CountDashboardWebStatus(source, "Assigned"),
            LoanedTools = CountDashboardWebStatus(source, "Loaned"),
            InMaintenanceTools = CountDashboardWebStatus(source, "InMaintenance"),
            DamagedTools = CountDashboardWebStatus(source, "Damaged"),
            NotLocatedTools = CountDashboardWebStatus(source, "NotLocated"),
            DisposedTools = CountDashboardWebStatus(source, "Disposed"),

            FixedAssets = source.Count(x => !string.IsNullOrWhiteSpace(x.FixedAssetCode)),
            ToolsWithoutFixedAssetCode = source.Count(x => string.IsNullOrWhiteSpace(x.FixedAssetCode)),
            ToolsOnly = source.Count(x => string.IsNullOrWhiteSpace(x.FixedAssetCode)),
            NonToolAssets = 0,
            SpecializedTools = source.Count(x => x.IsSpecialized),
            RequiresMaintenance = source.Count(x => x.RequiresMaintenance),

            ActiveResponsibles = source
                .Select(x => x.ResponsiblePersonId?.ToString() ?? NormalizeDashboardWebFilterText(x.ResponsiblePersonName))
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count(),

            InactiveResponsibles = 0,

            ActiveBranches = source
                .Select(x => NormalizeDashboardWebFilterText(x.BranchCode ?? x.BranchName))
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count(),

            InactiveBranches = 0,

            WithLifeRecord = source.Count(HasDashboardWebLifeRecord),
            WithoutLifeRecord = source.Count(x => !HasDashboardWebLifeRecord(x))
        };
    }

    private List<StatusItem> BuildDashboardStatusItems(List<DashboardToolFilterItem> source)
    {
        return source
            .GroupBy(x => string.IsNullOrWhiteSpace(x.OperationalStatus) ? "Sin estado" : x.OperationalStatus)
            .Select(x => new StatusItem
            {
                Status = x.Key,
                Count = x.Count()
            })
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Status)
            .ToList();
    }

    private List<BranchItem> BuildDashboardBranchItems(List<DashboardToolFilterItem> source)
    {
        return source
            .GroupBy(x => new
            {
                Code = string.IsNullOrWhiteSpace(x.BranchCode) ? "-" : x.BranchCode!,
                Name = string.IsNullOrWhiteSpace(x.BranchName)
                    ? (string.IsNullOrWhiteSpace(x.BranchCode) ? "-" : x.BranchCode!)
                    : x.BranchName!
            })
            .Select(x => new BranchItem
            {
                BranchCode = x.Key.Code,
                BranchName = x.Key.Name,
                Total = x.Count(),
                Available = CountDashboardWebStatus(x, "Available"),
                Assigned = CountDashboardWebStatus(x, "Assigned"),
                Loaned = CountDashboardWebStatus(x, "Loaned"),
                PendingValidation = CountDashboardWebStatus(x, "PendingValidation"),
                InMaintenance = CountDashboardWebStatus(x, "InMaintenance"),
                Damaged = CountDashboardWebStatus(x, "Damaged"),
                NotLocated = CountDashboardWebStatus(x, "NotLocated"),
                Disposed = CountDashboardWebStatus(x, "Disposed")
            })
            .OrderByDescending(x => x.Total)
            .ThenBy(x => x.BranchCode)
            .ToList();
    }

    private static int CountDashboardWebStatus(IEnumerable<DashboardToolFilterItem> source, string status)
    {
        return source.Count(x => SameDashboardWebFilterText(x.OperationalStatus, status));
    }

    private static bool HasDashboardWebLifeRecord(DashboardToolFilterItem item)
    {
        return item.HasLifeRecord == true ||
               item.LifeRecordId.HasValue ||
               !string.IsNullOrWhiteSpace(item.LifeRecordCode);
    }

    private static bool ContainsDashboardWebFilterText(string? value, string? expected)
    {
        var source = NormalizeDashboardWebFilterText(value);
        var filter = NormalizeDashboardWebFilterText(expected);

        return !string.IsNullOrWhiteSpace(source) &&
               !string.IsNullOrWhiteSpace(filter) &&
               source.Contains(filter, StringComparison.OrdinalIgnoreCase);
    }

    private static bool SameDashboardWebFilterText(string? left, string? right)
    {
        var a = NormalizeDashboardWebFilterText(left);
        var b = NormalizeDashboardWebFilterText(right);

        return !string.IsNullOrWhiteSpace(a) &&
               !string.IsNullOrWhiteSpace(b) &&
               string.Equals(a, b, StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizeDashboardWebFilterText(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? string.Empty
            : value.Trim();
    }

    private static string GetDashboardWebStatusLabel(string? status)
    {
        return status switch
        {
            "Available" => "Disponible",
            "Assigned" => "Asignada",
            "Loaned" => "Prestada",
            "InMaintenance" => "En mantenimiento",
            "Damaged" => "Dañada",
            "NotSuitable" => "No apta",
            "PendingValidation" => "Pendiente validación",
            "NotLocated" => "No localizada",
            "Disposed" => "Baja",
            _ => string.IsNullOrWhiteSpace(status) ? "-" : status
        };
    }
