    background: var(--navi-btn-green-dark) !important;
    box-shadow: 0 .28rem .62rem rgba(25, 135, 84, .16) !important;
}

.btn-outline-success,
.navi-btn-outline-success {
    color: var(--navi-btn-green) !important;
    border-color: var(--navi-btn-green) !important;
    background: #ffffff !important;
}

.btn-outline-success:hover,
.navi-btn-outline-success:hover {
    color: #ffffff !important;
    border-color: var(--navi-btn-green) !important;
    background: var(--navi-btn-green) !important;
