    private string ResolveWarehouseNameV2301(
        ToolItem tool)
    {
        var warehouseCode =
            ResolveWarehouseCodeV2301(
                tool);

        if (string.IsNullOrWhiteSpace(
                warehouseCode))
        {
            return "—";
        }

        var warehouse =
            locations.FirstOrDefault(
                location =>
                    string.Equals(
                        location.Code,
                        warehouseCode,
                        StringComparison.OrdinalIgnoreCase));

        if (
            warehouse is not null
            &&
            !string.IsNullOrWhiteSpace(
                warehouse.Name)
        )
        {
            return warehouse.Name;
        }

        return ResolveWarehouseFallbackNameV2301(
            warehouseCode);
    }

    private string? ResolveWarehouseCodeV2301(
        ToolItem tool)
    {
        var branchCode =
            tool.BranchCode?
                .Trim()
                .ToUpperInvariant();

        if (string.IsNullOrWhiteSpace(
                branchCode))
        {
            return null;
        }

        var locationCode =
            ResolveCurrentLocationCodeV2301(
                tool);

        var locationName =
            tool.LocationName?
                .Trim()
                .ToUpperInvariant()
            ?? string.Empty;

        /*
         * Registros creados durante la separación:
         *
         * EST / RACK / CAJ
         *     -> Bodega de herramientas
         *
         * BAH-MAN
         *     -> Área de mantenimiento
         *
         * PTO-TEC / ZONA
         *     -> Taller principal
         */

        if (
            locationCode.Contains(
                "-EST-",
                StringComparison.Ordinal)
            ||
            locationCode.Contains(
                "-RACK-",
                StringComparison.Ordinal)
            ||
            locationCode.Contains(
                "-CAJ-",
                StringComparison.Ordinal)
            ||
            locationName.Contains(
                "ESTANTERÍA",
                StringComparison.Ordinal)
            ||
            locationName.Contains(
                "ESTANTERIA",
                StringComparison.Ordinal)
            ||
            locationName.Contains(
                "RACK",
                StringComparison.Ordinal)
            ||
            locationName.Contains(
                "CAJÓN",
                StringComparison.Ordinal)
            ||
            locationName.Contains(
                "CAJON",
                StringComparison.Ordinal)
        )
        {
            return
                $"{branchCode}-BOD-HERR";
        }

        if (
            locationCode.Contains(
                "-BAH-MAN-",
                StringComparison.Ordinal)
            ||
            locationName.Contains(
                "BAHÍA DE MANTENIMIENTO",
                StringComparison.Ordinal)
            ||
            locationName.Contains(
                "BAHIA DE MANTENIMIENTO",
                StringComparison.Ordinal)
        )
        {
            return
                $"{branchCode}-MANT";
        }

        if (
            locationCode.Contains(
                "-PTO-TEC-",
                StringComparison.Ordinal)
            ||
            locationCode.Contains(
                "-ZONA-",
                StringComparison.Ordinal)
            ||
            locationName.Contains(
                "PUESTO TÉCNICO",
                StringComparison.Ordinal)
            ||
            locationName.Contains(
                "PUESTO TECNICO",
                StringComparison.Ordinal)
            ||
            locationName.Contains(
                "ZONA DE EQUIPOS",
                StringComparison.Ordinal)
        )
        {
            return
                $"{branchCode}-TALLER";
        }

        /*
         * Compatibilidad cuando una herramienta todavía está
         * relacionada directamente con un almacén o taller.
         */

        if (
            locationCode.EndsWith(
                "-BOD-HERR",
                StringComparison.Ordinal)
            ||
            locationCode.EndsWith(
                "-MANT",
                StringComparison.Ordinal)
            ||
            locationCode.EndsWith(
                "-TALLER",
                StringComparison.Ordinal)
        )
        {
            return locationCode;
        }

        return null;
    }

    private string ResolveCurrentLocationCodeV2301(
        ToolItem tool)
    {
        if (!string.IsNullOrWhiteSpace(
                tool.LocationCode))
        {
            return
                tool.LocationCode
                    .Trim()
                    .ToUpperInvariant();
        }

        if (!tool.LocationId.HasValue)
        {
            return string.Empty;
        }

        var currentLocation =
            locations.FirstOrDefault(
                location =>
                    location.Id
                    ==
                    tool.LocationId.Value);

        return currentLocation?.Code?
            .Trim()
            .ToUpperInvariant()
            ?? string.Empty;
    }

    private static string
        ResolveWarehouseFallbackNameV2301(
            string warehouseCode)
    {
        if (
            warehouseCode.EndsWith(
                "-BOD-HERR",
                StringComparison.OrdinalIgnoreCase)
        )
        {
            return "Bodega de herramientas";
        }

        if (
            warehouseCode.EndsWith(
                "-MANT",
                StringComparison.OrdinalIgnoreCase)
        )
        {
            return "Área de mantenimiento";
        }

        if (
            warehouseCode.EndsWith(
                "-TALLER",
                StringComparison.OrdinalIgnoreCase)
        )
        {
            return "Taller principal";
        }

        return "—";
    }

