@page "/tools/{ToolId:guid}/safe-practices"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Navi.ToolsAssets.Admin.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<PageTitle>Prácticas seguras - NAVI Herramientas</PageTitle>

<PermissionGuard Permission="TechnicalLifeRecord.SafePractices" ModuleName="Prácticas seguras">

<div class="navi-life-record-subpage navi-life-record-subpage--safe-practices">



@* NAVI LIFE RECORD SUBPAGE STANDARD V76 SAFE-PRACTICES START *@

<NaviPageHero
    Pill="ACTIVOS FIJOS"
    Title="Gestión de prácticas seguras"
    Description="Agrega, edita o desactiva prácticas seguras asociadas a la herramienta." />

<NaviKpiToolbar
    Class="navi-life-record-subpage-toolbar
           navi-life-record-subpage-toolbar--safe-practices"
    Refresh="LoadAsync"
    IsRefreshing="isLoading"
    RefreshTitle="Actualizar prácticas seguras"
    RefreshAriaLabel="Actualizar prácticas seguras">

    <div class="navi-life-record-subpage-toolbar__body">

        <NaviKpiGrid
            Columns="3"
            Compact="true"
            Dividers="true"
            Class="navi-life-record-subpage-kpis">

            <NaviKpiCard
                Title="Código interno"
                Description="Identificación del activo"
                Value="@internalCode"
                Tone="neutral"
                Compact="true">

                <IconContent>
                    <NaviKpiIcon Name="inventory" />
                </IconContent>

            </NaviKpiCard>

            <NaviKpiCard
                Title="Activo"
                Description="Hoja de vida técnica"
                Value="@toolName"
                Tone="soft"
                Compact="true"
                     Class="navi-life-record-kpi-asset">

                <IconContent>
                    <NaviKpiIcon Name="document" />
                </IconContent>

            </NaviKpiCard>

            <NaviKpiCard
                Title="Prácticas seguras"
                Description="Controles registrados"
                Value="@safePractices.Count.ToString()"
                Tone="positive"
                Compact="true">

                <IconContent>
                    <NaviKpiIcon Name="check" />
                </IconContent>

            </NaviKpiCard>

        </NaviKpiGrid>

        <a class="navi-life-record-subpage-back"
           href="@($"/tools/{ToolId}/technical-life-record")"
           aria-label="Volver a hoja de vida"
           data-ntx-tone="secondary">

            <span aria-hidden="true">←</span>
            <span>Volver a hoja de vida</span>

        </a>

    </div>

</NaviKpiToolbar>

@* NAVI LIFE RECORD SUBPAGE STANDARD V76 SAFE-PRACTICES END *@

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

<div class="safe-practices-manage-grid">
    <section class="life-record-section">
        <div class="section-title">
            <span>1</span>
            <h2>@(editingSafePracticeId.HasValue ? "Editar práctica segura" : "Nueva práctica segura")</h2>
        </div>

        <EditForm Model="formModel" OnValidSubmit="SaveAsync">
            <div class="edit-form-grid">
                <div>
                    <label for="navi-toolsafepracticesmanage-control-001">Orden</label>
                    <InputNumber class="form-control" @bind-Value="formModel.SortOrder" id="navi-toolsafepracticesmanage-control-001" />
                </div>

                <div>
                    <label for="navi-toolsafepracticesmanage-control-002">Nombre de la práctica</label>
                    <InputText class="form-control" @bind-Value="formModel.PracticeName" placeholder="Ej: Uso de EPP" id="navi-toolsafepracticesmanage-control-002" />
                </div>
            </div>

            <div class="mt-3">
                <label for="navi-toolsafepracticesmanage-control-003">Descripción</label>
                <InputTextArea class="form-control technical-observation"
                               @bind-Value="formModel.Description"
                               placeholder="Describe la práctica segura..." id="navi-toolsafepracticesmanage-control-003" />
            </div>

            <div class="technical-edit-actions static-actions mt-3">
                @if (editingSafePracticeId.HasValue)
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit" data-ntx-tone="secondary" >
                        Cancelar edición
                    </button>
                }

                <button type="submit" class="btn ntx-btn--operation" disabled="@isSaving" data-ntx-tone="affirmative" >
                    @GetSaveButtonText()
                </button>
            </div>
        </EditForm>
    </section>

    <section class="life-record-section">
        <div class="section-title section-title-actions">
            <div class="section-title-main">
                <span>2</span>
                <h2>Prácticas registradas</h2>
            </div>

            <button class="btn btn-sm ntx-btn--secondary" @onclick="CreateDefaultsAsync" disabled="@isSaving" data-ntx-tone="ghost" >
                Cargar predeterminadas
            </button>
        </div>

        @if (isLoading)
        {
            <div class="alert alert-info mb-0" role="status" aria-busy="true">Cargando prácticas seguras...</div>
        }
        else if (safePractices.Count == 0)
        {
            <p class="text-muted mb-0">No hay prácticas seguras registradas para esta herramienta.</p>
        }
        else
        {
            <div class="safe-practices-list-admin">
                @foreach (var item in safePractices)
                {
                    <div class="safe-practice-admin-card">
                        <div class="safe-practice-order">@item.SortOrder</div>

                        <div>
                            <strong>@item.PracticeName</strong>
                            <p>@item.Description</p>

                            <div class="d-flex gap-1 flex-wrap mt-2 navi-life-record-paired-actions">
<button class="btn btn-sm ntx-btn--operation" @onclick="() => StartEdit(item)" data-ntx-tone="operation" >
                                    Editar
                                </button>

                                <button class="btn btn-sm ntx-btn--danger" @onclick="() => DeleteAsync(item)" data-ntx-tone="danger" >
                                    Desactivar
                                </button>
</div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>



</div>

</PermissionGuard>

@code {
    [Parameter]
    public Guid ToolId { get; set; }

    private bool isLoading;
    private bool isSaving;
    private string? errorMessage;
    private string? successMessage;
    private string internalCode = string.Empty;
    private string toolName = string.Empty;
    private Guid? editingSafePracticeId;

    private SafePracticeFormModel formModel = new()
    {
        SortOrder = 1
    };

    private List<SafePracticeItemModel> safePractices = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var client = HttpClientFactory.CreateClient("NaviApi");

            var record = await client.GetFromJsonAsync<TechnicalLifeRecordHeaderModel>($"api/tools/{ToolId}/technical-life-record");

            if (record is not null)
            {
                internalCode = record.Summary.InternalCode;
                toolName = record.Summary.Name;
            }

            safePractices = await client.GetFromJsonAsync<List<SafePracticeItemModel>>($"api/tools/{ToolId}/safe-practices") ?? new();

            if (!editingSafePracticeId.HasValue && safePractices.Count > 0 && formModel.SortOrder <= 1)
            {
                formModel.SortOrder = safePractices.Max(x => x.SortOrder) + 1;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudieron cargar las prácticas seguras. Valida que la API esté activa. Detalle: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            if (string.IsNullOrWhiteSpace(formModel.PracticeName))
            {
                errorMessage = "El nombre de la práctica segura es obligatorio.";
                return;
            }

            if (string.IsNullOrWhiteSpace(formModel.Description))
            {
                errorMessage = "La descripción de la práctica segura es obligatoria.";
                return;
            }

            var client = HttpClientFactory.CreateClient("NaviApi");

            HttpResponseMessage response;

            if (editingSafePracticeId.HasValue)
            {
                var payload = new
                {
                    practiceName = formModel.PracticeName,
                    description = formModel.Description,
                    sortOrder = formModel.SortOrder,
                    updatedBy = "yquinto"
                };

                response = await client.PutAsJsonAsync($"api/tools/safe-practices/{editingSafePracticeId.Value}", payload);
            }
            else
            {
                var payload = new
                {
                    practiceName = formModel.PracticeName,
                    description = formModel.Description,
                    sortOrder = formModel.SortOrder,
                    createdBy = "yquinto"
                };

                response = await client.PostAsJsonAsync($"api/tools/{ToolId}/safe-practices", payload);
            }

            if (!response.IsSuccessStatusCode)
            {
                var detail = await response.Content.ReadAsStringAsync();
                errorMessage = $"No se pudo guardar la práctica segura. Código: {(int)response.StatusCode}. Detalle: {detail}";
                return;
            }

            successMessage = editingSafePracticeId.HasValue
                ? "Práctica segura actualizada correctamente."
                : "Práctica segura creada correctamente.";

            CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo guardar la práctica segura. Detalle: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task CreateDefaultsAsync()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            var client = HttpClientFactory.CreateClient("NaviApi");

            var response = await client.PostAsync($"api/tools/{ToolId}/safe-practices/defaults", null);

            if (!response.IsSuccessStatusCode)
            {
                var detail = await response.Content.ReadAsStringAsync();
                errorMessage = $"No se pudieron cargar prácticas predeterminadas. Código: {(int)response.StatusCode}. Detalle: {detail}";
                return;
            }

            successMessage = "Prácticas seguras predeterminadas cargadas correctamente.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudieron cargar prácticas predeterminadas. Detalle: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void StartEdit(SafePracticeItemModel item)
    {
        editingSafePracticeId = item.Id;

        formModel = new SafePracticeFormModel
        {
            PracticeName = item.PracticeName,
            Description = item.Description,
            SortOrder = item.SortOrder
        };

        successMessage = null;
        errorMessage = null;
    }

    private void CancelEdit()
    {
        editingSafePracticeId = null;

        var nextOrder = safePractices.Count == 0
            ? 1
            : safePractices.Max(x => x.SortOrder) + 1;

        formModel = new SafePracticeFormModel
        {
            SortOrder = nextOrder
        };
    }

    private async Task DeleteAsync(SafePracticeItemModel item)
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            var client = HttpClientFactory.CreateClient("NaviApi");

            var response = await client.DeleteAsync($"api/tools/safe-practices/{item.Id}?deletedBy=yquinto");

            if (!response.IsSuccessStatusCode)
            {
                var detail = await response.Content.ReadAsStringAsync();
                errorMessage = $"No se pudo desactivar la práctica segura. Código: {(int)response.StatusCode}. Detalle: {detail}";
                return;
            }

            successMessage = $"Práctica segura desactivada correctamente: {item.PracticeName}.";

            if (editingSafePracticeId == item.Id)
            {
                CancelEdit();
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo desactivar la práctica segura. Detalle: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo($"/tools/{ToolId}/technical-life-record");
    }

    private string GetSaveButtonText()
    {
        if (isSaving)
        {
            return "Guardando...";
        }

        return editingSafePracticeId.HasValue
            ? "Actualizar práctica"
            : "Crear práctica";
    }

    private sealed class SafePracticeFormModel
    {
        public string? PracticeName { get; set; }

        public string? Description { get; set; }

        public int SortOrder { get; set; }
    }

    private sealed class SafePracticeItemModel
    {
        public Guid Id { get; set; }

        public Guid ToolAssetId { get; set; }

        public string PracticeName { get; set; } = string.Empty;

        public string Description { get; set; } = string.Empty;

        public int SortOrder { get; set; }
    }

    private sealed class TechnicalLifeRecordHeaderModel
    {
        public SummaryInfo Summary { get; set; } = new();
    }

    private sealed class SummaryInfo
    {
        public string InternalCode { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;
    }
}
