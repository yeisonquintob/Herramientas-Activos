    private static int GetPercent(int value, int max)
    {
        if (value <= 0 || max <= 0)
        {
            return 0;
        }

        return Math.Max(5, (int)Math.Round((decimal)value / max * 100));
    }

    private string GetToolsVsAssetsDonut()
    {
        if (dashboard is null)
        {
            return "background: var(--navi-color-surface);";
        }

        return BuildDonut(
            new DashboardSegment(dashboard.Summary.ToolsOnly, "var(--navi-color-institutional)"),
            new DashboardSegment(dashboard.Summary.FixedAssets, "var(--navi-color-border)"),
            new DashboardSegment(dashboard.Summary.ToolsWithoutFixedAssetCode, "var(--navi-action-warning)"));
    }

    private string GetOperationsCostDonut()
    {
        if (operationCosts.MaintenanceCost <= 0 && operationCosts.PurchaseCost <= 0)
        {
            return "background: var(--navi-color-surface);";
        }

        return BuildMoneyDonut(
            new DashboardMoneySegment(operationCosts.MaintenanceCost, "var(--navi-color-institutional)"),
            new DashboardMoneySegment(operationCosts.PurchaseCost, "var(--navi-color-border)"));
    }

    private string GetOperationsDonut()
    {
        if (dashboard is null)
        {
            return "background: var(--navi-color-surface);";
        }

        return BuildDonut(
            new DashboardSegment(dashboard.MaintenanceSummary.Total, "var(--navi-color-institutional)"),
            new DashboardSegment(dashboard.PurchaseSummary.Total, "var(--navi-color-border)"));
    }

    private string GetStatusDonut()
    {
        if (dashboard is null)
        {
            return "background: var(--navi-color-surface);";
        }

        return BuildDonut(
            new DashboardSegment(dashboard.Summary.AssignedTools, "var(--navi-color-institutional)"),
            new DashboardSegment(dashboard.Summary.AvailableTools, "var(--navi-color-border)"),
            new DashboardSegment(dashboard.Summary.PendingValidationTools, "var(--navi-action-warning)"),
            new DashboardSegment(dashboard.Summary.InMaintenanceTools, "var(--navi-action-danger)"),
            new DashboardSegment(GetOtherStatusTools(), "var(--navi-color-institutional)"));
    }

    private string GetLifeRecordDonut()
    {
        if (dashboard is null)
        {
            return "background: var(--navi-color-surface);";
        }

        return BuildDonut(
            new DashboardSegment(dashboard.Summary.WithLifeRecord, "var(--navi-color-institutional)"),
            new DashboardSegment(dashboard.Summary.WithoutLifeRecord, "var(--navi-color-border)"),
            new DashboardSegment(dashboard.LifeRecordCoverage.MissingTechnicalData, "var(--navi-action-warning)"),
            new DashboardSegment(dashboard.Summary.FixedAssets, "var(--navi-action-danger)"),
            new DashboardSegment(GetOtherLifeRecords(), "var(--navi-color-institutional)"));
    }

    private static string BuildMoneyDonut(params DashboardMoneySegment[] segments)
    {
        var validSegments = segments
            .Where(x => x.Value > 0)
            .ToList();

        var total = validSegments.Sum(x => x.Value);

        if (total <= 0)
        {
            return "background: var(--navi-color-surface);";
        }

        var parts = new List<string>();
        decimal start = 0;

        for (var i = 0; i < validSegments.Count; i++)
        {
            var segment = validSegments[i];
            var percent = Math.Round(segment.Value / total * 100, 2);
            var end = i == validSegments.Count - 1 ? 100 : Math.Min(100, start + percent);

            parts.Add($"{segment.Color} {CssNumber(start)}% {CssNumber(end)}%");
            start = end;
        }

        return "background: var(--navi-color-surface);";
    }

    private static string BuildDonut(params DashboardSegment[] segments)
    {
        var validSegments = segments
            .Where(x => x.Value > 0)
            .ToList();

        var total = validSegments.Sum(x => x.Value);

        if (total <= 0)
        {
            return "background: var(--navi-color-surface);";
        }

        var parts = new List<string>();
        decimal start = 0;

        for (var i = 0; i < validSegments.Count; i++)
        {
            var segment = validSegments[i];
            var percent = Math.Round((decimal)segment.Value / total * 100, 2);
            var end = i == validSegments.Count - 1 ? 100 : Math.Min(100, start + percent);

            parts.Add($"{segment.Color} {CssNumber(start)}% {CssNumber(end)}%");
            start = end;
        }

        return "background: var(--navi-color-surface);";
    }

