@page "/"
@page "/dashboard"
@rendermode InteractiveServer

@using System.Globalization
@using System.Net.Http.Json
@using Navi.ToolsAssets.Admin.Components.Shared
@using System.Text.Json
@using System.Text.RegularExpressions
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Dashboard - NAVI</PageTitle>

<PermissionGuard Permission="Dashboard.View" ModuleName="Dashboard">

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (isLoading && dashboard is null)
{
    <div class="alert alert-info">Cargando dashboard...</div>
}
else if (dashboard is not null)
{
    <section class="dash-board dash-board-v5">
        <NaviPageHero
            Pill="DASHBOARD · CONTROL"
            Title="Dashboard"
            Description="Vista ejecutiva de inventario, responsables, mantenimiento, documentos y avance de toma física.">

            <button type="button" @onclick="LoadDashboardAsync" disabled="@isLoading" data-ntx-tone="secondary" >
                @(isLoading ? "Actualizando..." : "Actualizar")
            </button>

        </NaviPageHero>
        <section class="dash-kpis">
            <article class="primary">
                <span>Participantes</span>
                <strong>@dashboard.Summary.ActiveResponsibles</strong>
                <small>Usuario / responsable</small>
            </article>

            <article class="tone-secondary">
                <span>En proceso</span>
                <strong>@GetInProcess()</strong>
                <small>Inventario activo</small>
            </article>

            <article class="tone-positive">
                <span>Finalizados</span>
                <strong>@dashboard.Summary.WithLifeRecord</strong>
                <small>Con hoja de vida</small>
            </article>

            <article class="tone-warning">
                <span>Pendientes</span>
                <strong>@GetPendingTotal()</strong>
                <small>Por validar</small>
            </article>

            <article class="tone-danger">
                <span>Diferencias</span>
                <strong>@GetDifferences()</strong>
                <small>Conciliación</small>
            </article>

            <article class="primary">
                <span>Avance</span>
                <strong>@GetAdvancePercent()%</strong>
                <small>@dashboard.Summary.WithLifeRecord de @dashboard.Summary.TotalTools</small>
            </article>
        </section>

        <section class="navi-dashboard-filter-panel">
            <label class="navi-dashboard-branch-filter">
                <span>Sede</span>

                <input list="dashboardBranchOptions"
                       @bind="filterBranchCode"
                       @bind:event="oninput"
                       placeholder="Todas / escribe o selecciona sede..." />

                <datalist id="dashboardBranchOptions">
                    @foreach (var branch in dashboardBranches)
                    {
                        @if (!string.IsNullOrWhiteSpace(branch.Code))
                        {
                            <option value="@branch.Code">@branch.Label</option>
                        }

                        @if (!string.IsNullOrWhiteSpace(branch.Name) &&
                             !string.Equals(branch.Name, branch.Code, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@branch.Name">@branch.Label</option>
                        }
                    }
                </datalist>
            </label>

            <label>
                <span>Estado</span>
                <select @bind="filterOperationalStatus">
                    <option value="">Todos</option>
                    @foreach (var item in dashboardStatusFilters)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </label>

            <label>
                <span>Buscar</span>
                <input @bind="filterText"
                       @bind:event="oninput"
                       placeholder="Código, serial, nombre, responsable..." />
            </label>

            <div>
                <button type="button" class="btn btn-primary dash-filter-btn" @onclick="ApplyDashboardFiltersAsync" disabled="@isLoading" data-ntx-tone="secondary" >Filtrar</button>
                <button type="button" class="btn btn-outline-secondary dash-filter-btn secondary" @onclick="ClearDashboardFiltersAsync" disabled="@isLoading" data-ntx-tone="secondary" >Limpiar</button>
            </div>
        </section>

        <section class="dash-executive-grid">
            <section class="dash-executive-column dash-executive-column-primary">
                <article class="dash-card dash-branch-triple-card">
                    <div class="dash-section-head">
                        <div>
                            <h3>Herramientas por sede</h3>
                            <p>Total, asignadas y disponibles por sede.</p>
                        </div>

                        <span>Máx. @GetBranchChartMax()</span>
                    </div>

                    <div class="dash-branch-triple-chart">
                        <div class="dash-axis">
                            @foreach (var mark in GetBranchAxisLabels())
                            {
                                <span>@mark</span>
                            }
                        </div>

                        <div class="dash-branch-triple-bars">
                            @foreach (var item in GetBranchChartItems())
                            {
                                var total = item.Branch.Total;
                                var assigned = GetBranchAssigned(item.Branch);
                                var available = GetBranchAvailable(item.Branch);

                                <div class="dash-branch-triple-group" title="@($"{item.Branch.BranchCode} - {item.Branch.BranchName}")">
                                    <div class="dash-branch-triple-barset">
                                        <strong class="dash-triple-bar total" style="@GetBranchTripleBarStyle(total)" title="@($"Total: {total}")">
                                            <em>@total</em>
                                        </strong>

                                        <strong class="dash-triple-bar assigned" style="@GetBranchTripleBarStyle(assigned)" title="@($"Asignadas: {assigned}")">
                                            <em>@assigned</em>
                                        </strong>

                                        <strong class="dash-triple-bar available" style="@GetBranchTripleBarStyle(available)" title="@($"Disponibles: {available}")">
                                            <em>@available</em>
                                        </strong>
                                    </div>

                                    <span>@item.Branch.BranchCode</span>
                                    <small>@ShortName(item.Branch.BranchName)</small>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="dash-triple-legend">
                        <span><i class="total"></i>Total herramientas</span>
                        <span><i class="assigned"></i>Asignadas</span>
                        <span><i class="available"></i>Disponibles</span>
                    </div>
                </article>

                <article class="dash-card dash-table-card dash-branch-summary-card">
                    <div class="dash-section-head">
                        <div>
                            <h3>Resumen por sede</h3>
                            <p>Asignación, validación, pendientes, diferencias, mantenimiento y daños.</p>
                        </div>

                        <span>@dashboard.ToolsByBranch.Count sedes</span>
                    </div>

                    <table class="dash-table dash-branch-summary-table">
                        <thead>
                            <tr>
                                <th>Sede</th>
                                <th>Asig.</th>
                                <th>Val.</th>
                                <th>Pend.</th>
                                <th>Dif.</th>
                                <th>Mtto.</th>
                                <th>Daños</th>
                                <th>Baja</th>
                                <th>% Asig.</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in dashboard.ToolsByBranch.Take(12))
                            {
                                var assigned = GetBranchAssigned(item);
                                var valid = GetBranchValidated(item);
                                var pending = GetBranchPending(item);
                                var difference = GetBranchDifferences(item);
                                var maintenance = GetBranchMaintenance(item);
                                var damaged = GetBranchDamaged(item);
                                var disposed = GetBranchDisposed(item);
                                var assignedPercent = GetBranchAssignedPercent(item);

                                <tr>
                                    <td>
                                        <div class="dash-branch-name">
                                            <strong>@item.BranchName</strong>
                                            <span>@item.BranchCode</span>
                                        </div>
                                    </td>

                                    <td>@assigned</td>
                                    <td>@valid</td>
                                    <td><span class="dash-pending">@pending</span></td>
                                    <td><span class="dash-difference">@difference</span></td>
                                    <td><span class="dash-maintenance-pill">@maintenance</span></td>
                                    <td><span class="dash-damaged-pill">@damaged</span></td>
                                    <td><span class="dash-disposed-pill">@disposed</span></td>

                                    <td>
                                        <div class="dash-progress">
                                            <span style="@GetProgressStyle(assignedPercent)"></span>
                                        </div>
                                        <small>@assignedPercent%</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </article>
            </section>

            <section class="dash-executive-column">
                <article class="dash-card dash-vs dash-dashboard-chart-card">
                    <h3>Mantenimientos vs compras</h3>

                    <div class="dash-dashboard-donut-row">
                        <div class="dash-donut lg" style="@GetOperationsCostDonut()">
                            <div>
                                <strong>@FormatDashboardMoneyCompact(GetOperationsCostTotal())</strong>
                                <span>Total</span>
                            </div>
                        </div>

                        <div class="dash-legend compact dash-cost-legend">
                            <div>
                                <i class="primary"></i>
                                <span>Mantenimientos</span>
                                <strong>@FormatDashboardMoney(operationCosts.MaintenanceCost)</strong>
                                <small>@GetOperationsCostTotalPercentLabel(operationCosts.MaintenanceCost)</small>
                            </div>

                            <div>
                                <i class="neutral"></i>
                                <span>Compras</span>
                                <strong>@FormatDashboardMoney(operationCosts.PurchaseCost)</strong>
                                <small>@GetOperationsCostTotalPercentLabel(operationCosts.PurchaseCost)</small>
                            </div>

                            <div class="dash-total-row">
                                <i class="tone-secondary"></i>
                                <span>Total</span>
                                <strong>@FormatDashboardMoney(GetOperationsCostTotal())</strong>
                                <small>100%</small>
                            </div>
                        </div>
                    </div>
                </article>

                <article class="dash-card dash-donut-card dash-dashboard-chart-card">
                    <h3>Herramientas por mes</h3>

                    <div class="dash-dashboard-donut-row">
                        <div class="dash-donut lg" style="@GetStatusDonut()">
                            <div>
                                <strong>@GetStatusDonutTotal().ToString("N0")</strong>
                                <span>Total</span>
                            </div>
                        </div>

                        <div class="dash-legend">
                            <div><i class="primary"></i><span>Asignada</span><strong>@dashboard.Summary.AssignedTools</strong><small>@GetPercentLabel(dashboard.Summary.AssignedTools, GetStatusDonutTotal())</small></div>
                            <div><i class="neutral"></i><span>Disponible</span><strong>@dashboard.Summary.AvailableTools</strong><small>@GetPercentLabel(dashboard.Summary.AvailableTools, GetStatusDonutTotal())</small></div>
                            <div><i class="tone-warning"></i><span>Pendientes</span><strong>@dashboard.Summary.PendingValidationTools</strong><small>@GetPercentLabel(dashboard.Summary.PendingValidationTools, GetStatusDonutTotal())</small></div>
                            <div><i class="tone-danger"></i><span>Técnico</span><strong>@dashboard.Summary.InMaintenanceTools</strong><small>@GetPercentLabel(dashboard.Summary.InMaintenanceTools, GetStatusDonutTotal())</small></div>
                            <div><i class="tone-secondary"></i><span>Otras</span><strong>@GetOtherStatusTools()</strong><small>@GetPercentLabel(GetOtherStatusTools(), GetStatusDonutTotal())</small></div>
                        </div>
                    </div>
                </article>

                <article class="dash-card dash-day dash-maintenance-day-card">
                    <h3>Mantenimientos por día</h3>

                    <div class="dash-day-metrics">
                        <div><strong>@dashboard.MaintenanceSummary.Today</strong><span>Hoy</span></div>
                        <div><strong>@dashboard.MaintenanceSummary.ThisMonth</strong><span>Mes</span></div>
                        <div><strong>@dashboard.Summary.RequiresMaintenance</strong><span>Pendientes</span></div>
                    </div>
                </article>
            </section>

            <section class="dash-executive-column">
                <article class="dash-card dash-donut-card dash-dashboard-chart-card">
                    <h3>Distribución de activos fijos</h3>

                    <div class="dash-dashboard-donut-row">
                        <div class="dash-donut lg" style="@GetToolsVsAssetsDonut()">
                            <div>
                                <strong>@GetToolsVsAssetsTotal().ToString("N0")</strong>
                                <span>Total</span>
                            </div>
                        </div>

                        <div class="dash-legend">
                            <div><i class="primary"></i><span>Herramientas</span><strong>@dashboard.Summary.ToolsOnly</strong><small>@GetPercentLabel(dashboard.Summary.ToolsOnly, GetToolsVsAssetsTotal())</small></div>
                            <div><i class="neutral"></i><span>Activos fijos</span><strong>@dashboard.Summary.FixedAssets</strong><small>@GetPercentLabel(dashboard.Summary.FixedAssets, GetToolsVsAssetsTotal())</small></div>
                            <div><i class="tone-warning"></i><span>Sin código Herramientas y AF</span><strong>@dashboard.Summary.ToolsWithoutFixedAssetCode</strong><small>@GetPercentLabel(dashboard.Summary.ToolsWithoutFixedAssetCode, GetToolsVsAssetsTotal())</small></div>
                        </div>
                    </div>
                </article>

                <article class="dash-card dash-donut-card dash-dashboard-chart-card">
                    <h3>Hojas de vida</h3>

                    <div class="dash-dashboard-donut-row">
                        <div class="dash-donut lg" style="@GetLifeRecordDonut()">
                            <div>
                                <strong>@GetLifeRecordDonutTotal().ToString("N0")</strong>
                                <span>Total</span>
                            </div>
                        </div>

                        <div class="dash-legend">
                            <div><i class="primary"></i><span>Con hoja</span><strong>@dashboard.Summary.WithLifeRecord</strong><small>@GetPercentLabel(dashboard.Summary.WithLifeRecord, GetLifeRecordDonutTotal())</small></div>
                            <div><i class="neutral"></i><span>Sin hoja</span><strong>@dashboard.Summary.WithoutLifeRecord</strong><small>@GetPercentLabel(dashboard.Summary.WithoutLifeRecord, GetLifeRecordDonutTotal())</small></div>
                            <div><i class="tone-warning"></i><span>Incompletos</span><strong>@dashboard.LifeRecordCoverage.MissingTechnicalData</strong><small>@GetPercentLabel(dashboard.LifeRecordCoverage.MissingTechnicalData, GetLifeRecordDonutTotal())</small></div>
                            <div><i class="tone-danger"></i><span>Activos fijos</span><strong>@dashboard.Summary.FixedAssets</strong><small>@GetPercentLabel(dashboard.Summary.FixedAssets, GetLifeRecordDonutTotal())</small></div>
                            <div><i class="tone-secondary"></i><span>Otras</span><strong>@GetOtherLifeRecords()</strong><small>@GetPercentLabel(GetOtherLifeRecords(), GetLifeRecordDonutTotal())</small></div>
                        </div>
                    </div>
                </article>

                <article class="dash-card dash-physical-card">
                    <div>
                        <h3>Toma física</h3>
                        <p>@GetLatestPhysicalCountText()</p>
                    </div>

                    @if (latestOpenPhysicalCount is not null)
                    {
                        <div class="dash-physical-current">
                            <span>@Display(latestOpenPhysicalCount.StatusLabel)</span>
                            <strong>@Display(latestOpenPhysicalCount.CountNumber)</strong>
                            <small>@Display(latestOpenPhysicalCount.BranchCode) · @Display(latestOpenPhysicalCount.ResponsibleBy)</small>
                        </div>
                    }

                    <div class="dash-actions">
                        <a href="@GetPhysicalCountsHref()">Ver tomas</a>
                        <a href="@GetPhysicalParticipantsHref()">Participantes</a>
                        <a href="@GetReconciliationHref()">Conciliación</a>
                    </div>
                </article>
            </section>
        </section>

        <section class="dash-card dash-process-summary-card">
            <div class="dash-section-head">
                <div>
                    <h3>Resumen de proceso</h3>
                    <p>Actividad reciente del inventario según los filtros activos del dashboard.</p>
                </div>

                <span>@GetProcessActivityCount() movimientos</span>
            </div>

            @if (GetProcessActivityCount() == 0)
            {
                <div class="dash-process-empty">
                    No hay movimientos recientes para los filtros activos.
                </div>
            }
            else
            {
                <div class="dash-process-activity-list">
                    @foreach (var activity in GetProcessActivityItems())
                    {
                        <article class="dash-process-activity-item">
                            <div class="dash-process-activity-head">
                                <div>
                                    <span>@GetProcessActivityScope(activity)</span>
                                    <strong>@Display(activity.Title)</strong>
                                </div>

                                <time>@FormatProcessDate(activity.RegisteredAt)</time>
                            </div>

                            <p>@GetProcessActivitySentence(activity)</p>

                            <div class="dash-process-activity-meta">
                                <span>Usuario: @Display(activity.User)</span>
                                <span>Activo: @Display(activity.ToolInternalCode)</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </section>
}

</PermissionGuard>



@code {
    private bool isLoading;
    private string? errorMessage;
    private ExecutiveDashboard? dashboard;
    private DashboardOperationCosts operationCosts = new();
    private PhysicalCountListItem? latestOpenPhysicalCount;
    private string maintenanceTab = "month";
    private string? filterBranchCode;
    private string? filterOperationalStatus;
    private string? filterText;
    private List<DashboardToolFilterItem> dashboardTools = new();
    private List<DashboardBranchFilterOption> dashboardBranches = new();

    private readonly (string Value, string Text)[] dashboardStatusFilters =
    {
        ("Available", "Disponible"),
        ("Assigned", "Asignada"),
        ("Loaned", "Prestada"),
        ("InMaintenance", "En mantenimiento"),
        ("Damaged", "Dañada"),
        ("NotSuitable", "No apta"),
        ("PendingValidation", "Pendiente validación"),
        ("NotLocated", "No localizada"),
        ("Disposed", "Dada de baja")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var client = HttpClientFactory.CreateClient("NaviApi");

            dashboard = await client.GetFromJsonAsync<ExecutiveDashboard>("api/dashboard/executive") ?? new ExecutiveDashboard
            {
                GeneratedAt = DateTime.Now
            };

            await LoadDashboardFilterDataAsync(client);
            ApplyLocalDashboardFilters();

            operationCosts = await LoadDashboardOperationCostsAsync(client);
            latestOpenPhysicalCount = await LoadLatestOpenPhysicalCountAsync(client);
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar el dashboard. Valida que la API esté activa en http://localhost:5218. Detalle: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }




    // NAVI DASHBOARD WEB FILTERS START
    private Task ApplyDashboardFiltersAsync()
    {
        ApplyLocalDashboardFilters();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task ClearDashboardFiltersAsync()
    {
        filterBranchCode = null;
        filterOperationalStatus = null;
        filterText = null;

        ApplyLocalDashboardFilters();
        StateHasChanged();

        return Task.CompletedTask;
    }
    // NAVI DASHBOARD WEB FILTERS END

    private void SetMaintenanceTab(string value)
    {
        maintenanceTab = value;
    }

    private string GetMaintenanceTabClass(string value)
    {
        return maintenanceTab == value ? "active" : string.Empty;
    }

    private int GetSelectedMaintenanceValue()
    {
        if (dashboard is null)
        {
            return 0;
        }

        return maintenanceTab == "day"
            ? dashboard.MaintenanceSummary.Today
            : dashboard.MaintenanceSummary.ThisMonth;
    }


    private IEnumerable<DashboardMiniMetric> GetMaintenanceMiniChartItems()
    {
        if (dashboard is null)
        {
            return Enumerable.Empty<DashboardMiniMetric>();
        }

        return new[]
        {
            new DashboardMiniMetric(maintenanceTab == "month" ? "Mes" : "Día", GetSelectedMaintenanceValue(), "primary"),
            new DashboardMiniMetric("Proceso", dashboard.Summary.InMaintenanceTools, "neutral"),
            new DashboardMiniMetric("Pendientes", dashboard.Summary.RequiresMaintenance, "orange"),
            new DashboardMiniMetric("Otras", GetOtherStatusTools(), "gray")
        };
    }

    private int GetMaintenanceMiniMax()
    {
        var items = GetMaintenanceMiniChartItems().ToArray();

        if (items.Length == 0)
        {
            return 1;
        }

        return Math.Max(1, items.Max(x => x.Value));
    }

    private decimal GetMaintenancePercent(int value)
    {
        if (dashboard?.Summary is null || dashboard.Summary.TotalTools <= 0 || value <= 0)
        {
            return 0;
        }

        return Math.Min(100, Math.Max(0, Math.Round((decimal)value / dashboard.Summary.TotalTools * 100, 1)));
    }

    private string GetMaintenanceMiniBarStyle(int value)
    {
        var percent = GetMaintenancePercent(value);

        if (percent <= 0)
        {
            return "width:0%;";
        }

        var visualPercent = Math.Min(100, Math.Max(4, percent));

        return $"width:{visualPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%;";
    }

    private int GetInProcess()
    {
        if (dashboard is null)
        {
            return 0;
        }

        return dashboard.Summary.AssignedTools + dashboard.Summary.LoanedTools + dashboard.Summary.InMaintenanceTools;
    }

    private int GetPendingTotal()
    {
        if (dashboard is null)
        {
            return 0;
        }

        return dashboard.Summary.PendingValidationTools + dashboard.Summary.WithoutLifeRecord;
    }

    private int GetDifferences()
    {
        if (dashboard is null)
        {
            return 0;
        }

        return dashboard.Summary.DamagedTools + dashboard.Summary.NotLocatedTools + dashboard.Summary.PendingValidationTools;
    }

    private int GetAdvancePercent()
    {
        if (dashboard is null || dashboard.Summary.TotalTools <= 0)
        {
            return 0;
        }

        return Math.Min(100, Math.Max(0, (int)Math.Round((decimal)dashboard.Summary.WithLifeRecord / dashboard.Summary.TotalTools * 100)));
    }

    private int GetToolsVsAssetsTotal()
    {
        if (dashboard is null)
        {
            return 1;
        }

        return Math.Max(
            1,
            dashboard.Summary.ToolsOnly
            + dashboard.Summary.FixedAssets
            + dashboard.Summary.ToolsWithoutFixedAssetCode);
    }

    private decimal GetOperationsCostTotal()
    {
        return Math.Max(0, operationCosts.MaintenanceCost + operationCosts.PurchaseCost);
    }

    private int GetOperationsDonutTotal()
    {
        if (dashboard is null)
        {
            return 1;
        }

        return Math.Max(1, dashboard.MaintenanceSummary.Total + dashboard.PurchaseSummary.Total);
    }

    private int GetStatusDonutTotal()
    {
        if (dashboard is null)
        {
            return 1;
        }

        return Math.Max(
            1,
            dashboard.Summary.AssignedTools
            + dashboard.Summary.AvailableTools
            + dashboard.Summary.PendingValidationTools
            + dashboard.Summary.InMaintenanceTools
            + GetOtherStatusTools());
    }

    private int GetLifeRecordDonutTotal()
    {
        if (dashboard is null)
        {
            return 1;
        }

        return Math.Max(
            1,
            dashboard.Summary.WithLifeRecord
            + dashboard.Summary.WithoutLifeRecord
            + dashboard.LifeRecordCoverage.MissingTechnicalData
            + dashboard.Summary.FixedAssets
            + GetOtherLifeRecords());
    }

    private int GetOtherStatusTools()
    {
        if (dashboard is null)
        {
            return 0;
        }

        return Math.Max(
            0,
            dashboard.Summary.TotalTools
            - dashboard.Summary.AssignedTools
            - dashboard.Summary.AvailableTools
            - dashboard.Summary.PendingValidationTools
            - dashboard.Summary.InMaintenanceTools);
    }

    private int GetOtherLifeRecords()
    {
        if (dashboard is null)
        {
            return 0;
        }

        return Math.Max(
            0,
            dashboard.Summary.TotalTools
            - dashboard.Summary.WithLifeRecord
            - dashboard.Summary.WithoutLifeRecord
            - dashboard.LifeRecordCoverage.MissingTechnicalData);
    }

    private int GetBranchAssigned(BranchItem item)
    {
        return Math.Max(0, item.Assigned + item.Loaned);
    }

    private int GetBranchAvailable(BranchItem item)
    {
        return Math.Max(0, item.Available);
    }

    private int GetBranchAssignedPercent(BranchItem item)
    {
        if (item.Total <= 0)
        {
            return 0;
        }

        return Math.Min(100, Math.Max(0, (int)Math.Round((decimal)GetBranchAssigned(item) / item.Total * 100)));
    }

    private int GetBranchPending(BranchItem item)
    {
        return Math.Max(0, item.PendingValidation);
    }

    private int GetBranchDifferences(BranchItem item)
    {
        return Math.Max(0, item.NotLocated);
    }

    private int GetBranchMaintenance(BranchItem item)
    {
        return Math.Max(0, item.InMaintenance);
    }

    private int GetBranchDamaged(BranchItem item)
    {
        return Math.Max(0, item.Damaged);
    }

    private int GetBranchDisposed(BranchItem item)
    {
        return Math.Max(0, item.Disposed);
    }

    private int GetBranchValidated(BranchItem item)
    {
        var notValidated =
            GetBranchPending(item) +
            GetBranchDifferences(item) +
            GetBranchMaintenance(item) +
            GetBranchDamaged(item) +
            GetBranchDisposed(item);

        return Math.Max(0, item.Total - notValidated);
    }

    private int GetBranchAdvance(BranchItem item)
    {
        if (item.Total <= 0)
        {
            return 0;
        }

        var valid = GetBranchValidated(item);

        return Math.Min(100, Math.Max(0, (int)Math.Round((decimal)valid / item.Total * 100)));
    }

