        font-size: .92rem;
        font-weight: 650;
        line-height: 1.45;
    }

    .login-alert {
        text-align: left;
        margin-bottom: .95rem;
        background: #fff1f2;
        color: #9f1239;
        border: 1px solid #fecdd3;
        border-radius: .75rem;
