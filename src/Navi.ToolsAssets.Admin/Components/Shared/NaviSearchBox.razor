@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<label class="@CssClass">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <span class="navi-search-box__label">@Label</span>
    }

    <span class="navi-search-box__control">
        <span aria-hidden="true">⌕</span>
        <input @attributes="AdditionalAttributes"
               type="search"
               value="@Value"
               placeholder="@Placeholder"
               disabled="@Disabled"
               aria-label="@ResolvedAriaLabel"
               @oninput="HandleInputAsync"
               @onkeydown="HandleKeyDownAsync" />
    </span>
</label>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public EventCallback OnSearch { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Buscar…";
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ResolvedAriaLabel =>
        AriaLabel ?? Label ?? Placeholder;

    private string CssClass =>
        string.IsNullOrWhiteSpace(Class)
            ? "navi-search-box"
            : $"navi-search-box {Class.Trim()}";

    private Task HandleInputAsync(ChangeEventArgs args) =>
        ValueChanged.InvokeAsync(args.Value?.ToString());

    private Task HandleKeyDownAsync(KeyboardEventArgs args) =>
        args.Key == "Enter" && OnSearch.HasDelegate
            ? OnSearch.InvokeAsync()
            : Task.CompletedTask;
}
