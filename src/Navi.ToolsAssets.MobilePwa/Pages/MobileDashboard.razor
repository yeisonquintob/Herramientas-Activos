            + DashboardLoanedTools);
    }

    private int GetDashboardAlertTotal()
    {
        return Math.Max(
            0,
            DashboardPendingValidationTools
            + DashboardDamagedTools
            + DashboardNotLocatedTools);
    }

    private int GetDashboardCompleteLifeRecords()
    {
        if (dashboard is null)
        {
            return 0;
        }

        var withLifeRecord = Math.Clamp(
            dashboard.Summary.WithLifeRecord,
            0,
            DashboardTotalTools);

        var missingTechnicalData = Math.Clamp(
            dashboard.LifeRecordCoverage
                .MissingTechnicalData,
            0,
            DashboardTotalTools);

        return Math.Clamp(
            withLifeRecord - missingTechnicalData,
            0,
            DashboardTotalTools);
    }

    private int GetDashboardIncompleteLifeRecords()
    {
        return Math.Max(
            0,
            DashboardTotalTools
            - GetDashboardCompleteLifeRecords());
    }

    private string
        GetDashboardLifeCompletionPercentLabel()
    {
        return GetDashboardPercentLabel(
            GetDashboardCompleteLifeRecords(),
            DashboardTotalTools);
    }

    private string
        GetDashboardFixedAssetPercentLabel()
    {
        return GetDashboardPercentLabel(
            DashboardFixedAssets,
            DashboardTotalTools);
    }

    private static string GetDashboardPercentLabel(
        int value,
        int total)
    {
        if (value <= 0 || total <= 0)
        {
            return "0%";
        }

        var percentage = Math.Round(
            (decimal)value / total * 100,
            1);

        return percentage.ToString(
            "0.#",
            System.Globalization
                .CultureInfo
                .InvariantCulture)
            + "%";
    }

    private static string
        GetDashboardRingSegmentStyle(
            int value,
            int total,
            int previousValue)
    {
        if (value <= 0 || total <= 0)
        {
            return
                "stroke-dasharray:0 100;"
                + "stroke-dashoffset:0;";
        }

        var percentage = Math.Clamp(
            Math.Round(
                (decimal)value / total * 100,
                2),
            0,
            100);

        var previousPercentage = Math.Clamp(
            Math.Round(
                (decimal)previousValue / total * 100,
                2),
            0,
            100);

        var remaining = Math.Max(
            0,
            100 - percentage);

        var percentageText = percentage.ToString(
            "0.##",
            System.Globalization
                .CultureInfo
                .InvariantCulture);

        var remainingText = remaining.ToString(
            "0.##",
            System.Globalization
                .CultureInfo
                .InvariantCulture);

        var offsetText = (-previousPercentage).ToString(
            "0.##",
            System.Globalization
                .CultureInfo
                .InvariantCulture);

        return
            "stroke-dasharray:"
            + percentageText
            + " "
            + remainingText
            + ";stroke-dashoffset:"
            + offsetText
            + ";";
    }

    private string
        GetDashboardBranchBarStyle(
            int value)
    {
        var max = Math.Max(
            1,
            DashboardToolsByBranch
                .DefaultIfEmpty()
                .Max(item => item?.Total ?? 0));

        var percentage = value <= 0
            ? 0
            : Math.Max(
                4,
                (int)Math.Round(
                    (decimal)value / max * 100));

        return
            "height:"
            + percentage.ToString(
                System.Globalization
                    .CultureInfo
                    .InvariantCulture)
            + "%;";
    }

    private string
        GetDashboardBranchPercentLabel(
            MobileBranchItem branch)
    {
        return GetDashboardPercentLabel(
            GetDashboardBranchInUse(branch),
            branch.Total);
    }

    private string
        GetDashboardBranchProgressStyle(
            MobileBranchItem branch)
    {
        var total = Math.Max(
            1,
            branch.Total);

        var percentage = Math.Clamp(
            (int)Math.Round(
                (decimal)GetDashboardBranchInUse(branch)
                / total
                * 100),
            0,
            100);

        return
            "width:"
            + percentage.ToString(
                System.Globalization
                    .CultureInfo
                    .InvariantCulture)
            + "%;";
    }

    private string
        GetDashboardMaintenanceProgressStyle()
    {
        if (DashboardTotalTools <= 0)
        {
            return "width:0%;";
        }

        var percentage = Math.Clamp(
            (int)Math.Round(
                (decimal)DashboardInMaintenanceTools
                / DashboardTotalTools
                * 100),
            0,
            100);

        return
            "width:"
            + percentage.ToString(
                System.Globalization
                    .CultureInfo
                    .InvariantCulture)
            + "%;";
    }

    private string GetDashboardScopeTitle()
    {
        var count =
            DashboardToolsByBranch.Count;

        return count == 1
            ? "1 sede en el resultado"
            : count.ToString(
                System.Globalization
                    .CultureInfo
                    .InvariantCulture)
              + " sedes en el resultado";
    }

    private string GetDashboardScopeDescription()
    {
        return UserCanSeeAllBranches()
            ? "Registros visibles en todas las sedes autorizadas."
            : "Registros limitados a la sede asignada al usuario.";
    }

    private static string FormatDashboardNumber(
        int value)
    {
        return Math.Max(0, value).ToString(
            "N0",
            System.Globalization
                .CultureInfo
                .GetCultureInfo("es-CO"));
    }

