@page "/login"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Navi.ToolsAssets.Admin.Services.Auth

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject WebAuthSessionService AuthSession
@inject IJSRuntime JS

<PageTitle>Ingreso - NAVI Herramientas y AF</PageTitle>

<div class="login-shell">
    <header class="login-topbar login-topbar-balanced">
        <div class="login-brand login-brand-balanced">
            <div class="login-brand-icon login-brand-icon-balanced">N</div>

            <div class="login-brand-copy login-brand-copy-balanced">
                <h1>
                    <span class="brand-navi">NAVI</span>
                    <span class="brand-tools">Herramientas y AF</span>
                </h1>
                <p>Consola de administración</p>
            </div>
        </div>
    </header>

    <main class="login-main">
        <section class="login-card">
                        <div class="login-avatar-pro" aria-hidden="true">
                <span class="login-avatar-pro-head"></span>
                <span class="login-avatar-pro-body"></span>
            </div>


            <h2>Bienvenido</h2>

            <p class="login-subtitle">
                Ingresa tus credenciales para acceder<br />
                a la consola de administración.
            </p>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="login-alert">@errorMessage</div>
            }

            <EditForm Model="loginModel" OnValidSubmit="LoginAsync">
                <div class="login-field">
                    <label>Documento / usuario</label>

                    <div class="login-input-wrap">
                        <span class="login-input-icon" aria-hidden="true">&#128100;</span>

                        <InputText class="login-input"
                                   @bind-Value="loginModel.UserName"
                                   placeholder="Ingresa tu documento o usuario" />
                    </div>
                </div>

                <div class="login-field">
                    <label>Contraseña</label>

                    <div class="login-input-wrap">
                        <span class="login-input-icon" aria-hidden="true">&#128274;</span>

                        <InputText class="login-input"
                                   type="@passwordInputType"
                                   @bind-Value="loginModel.Password"
                                   placeholder="Ingresa tu contraseña" />

                        <button type="button" class="login-eye" @onclick="TogglePassword">
                            @((MarkupString)(showPassword ? "&#128065;" : "&#128065;"))
                        </button>
                    </div>
                </div>

                                <div class="login-remember-panel">
                    <label class="login-remember-row" for="rememberCredentials">
                        <InputCheckbox id="rememberCredentials"
                                       class="login-remember-check"
                                       @bind-Value="loginModel.RememberCredentials" />

                        <span class="login-remember-copy">
                            <span class="login-remember-title">Recordar acceso</span>
                            <span class="login-remember-subtitle">Guardar usuario y contraseña en este equipo</span>
                        </span>
                    </label>
                </div><button class="login-submit" type="submit" disabled="@isLoading">
                    @(isLoading ? "Ingresando..." : "Ingresar")
                </button>
            </EditForm>
        </section>
    </main>

    <footer class="login-footer">
        Navitrans 40 años <span>•</span> Soluciones que impulsan tu operación
    </footer>

    <div class="login-bg-letter">N</div>
    <div class="login-bg-lines"></div>
    <div class="login-bg-dots"></div>
</div>

@code {
    // NAVI LOGIN HISTORY FIX:
    // Cuando el usuario ya está autenticado, /login debe redirigir reemplazando el historial.
    // Así el botón atrás del navegador no vuelve a mostrar el formulario de login.
    private const string StorageKey = "navi-auth-session";
    private const string RememberEnabledKey = "navi-login-remember-enabled";
    private const string RememberUserNameKey = "navi-login-remember-username";
    private const string RememberPasswordKey = "navi-login-remember-password";

    private LoginFormModel loginModel = new();
    private bool isLoading;
    private bool showPassword;
    private string? errorMessage;

    private string passwordInputType => showPassword ? "text" : "password";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (AuthSession.IsAuthenticated)
        {
            Navigation.NavigateTo(NaviPermissionRouteService.GetStartRoute(AuthSession), replace: true);
            return;
        }

        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);

            if (!string.IsNullOrWhiteSpace(json))
            {
                var user = JsonSerializer.Deserialize<AuthSessionUser>(
                    json,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (user is not null && !string.IsNullOrWhiteSpace(user.UserName))
                {
                    AuthSession.Login(user);
                    Navigation.NavigateTo(NaviPermissionRouteService.GetStartRoute(AuthSession), replace: true);
                }
            }

            var rememberEnabled = await JS.InvokeAsync<string?>("localStorage.getItem", RememberEnabledKey);

            if (string.Equals(rememberEnabled, "true", StringComparison.OrdinalIgnoreCase))
            {
                loginModel.RememberCredentials = true;
                loginModel.UserName = await JS.InvokeAsync<string?>("localStorage.getItem", RememberUserNameKey);
                loginModel.Password = await JS.InvokeAsync<string?>("localStorage.getItem", RememberPasswordKey);

                StateHasChanged();
            }

        }
        catch
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", StorageKey);
        }
    }

    private async Task LoginAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(loginModel.UserName) ||
            string.IsNullOrWhiteSpace(loginModel.Password))
        {
            errorMessage = "Debe ingresar documento/usuario y contraseña.";
            return;
        }

        isLoading = true;

        try
        {
            var api = HttpClientFactory.CreateClient("NaviApi");

            var response = await api.PostAsJsonAsync("api/auth/login", new
            {
                userName = loginModel.UserName,
                password = loginModel.Password
            });

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();

                errorMessage = string.IsNullOrWhiteSpace(error)
                    ? "Usuario o contraseña inválidos."
                    : error;

                return;
            }

            var user = await response.Content.ReadFromJsonAsync<AuthSessionUser>();

            if (user is null)
            {
                errorMessage = "No se recibió la información de sesión.";
                return;
            }

            AuthSession.Login(user);

            if (loginModel.RememberCredentials)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", RememberEnabledKey, "true");
                await JS.InvokeVoidAsync("localStorage.setItem", RememberUserNameKey, loginModel.UserName?.Trim() ?? string.Empty);
                await JS.InvokeVoidAsync("localStorage.setItem", RememberPasswordKey, loginModel.Password ?? string.Empty);
            }
            else
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", RememberEnabledKey);
                await JS.InvokeVoidAsync("localStorage.removeItem", RememberUserNameKey);
                await JS.InvokeVoidAsync("localStorage.removeItem", RememberPasswordKey);
            }


            var json = JsonSerializer.Serialize(user);
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, json);

            Navigation.NavigateTo(NaviPermissionRouteService.GetStartRoute(AuthSession), replace: true);
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo iniciar sesión: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private sealed class LoginFormModel
    {
        public string? UserName { get; set; }
        public string? Password { get; set; }
        public bool RememberCredentials { get; set; }
    }
}

<style>
    .login-shell {
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        color: #ffffff;
        display: grid;
        grid-template-rows: auto 1fr auto;
        padding: 2.5rem 3rem;
        background:
            radial-gradient(circle at 48% 44%, rgba(157, 37, 174, .48), transparent 24%),
            radial-gradient(circle at 80% 38%, rgba(118, 0, 136, .42), transparent 26%),
            linear-gradient(135deg, #120016 0%, #24002e 42%, #5b006a 100%);
    }

    .login-topbar {
        position: relative;
        z-index: 5;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .login-brand {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .login-brand-icon,
    .login-card-icon {
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #8b1fc2, #4b005c);
        color: white;
        font-weight: 950;
        box-shadow: 0 1rem 2rem rgba(0, 0, 0, .26);
    }

    .login-brand-icon {
        width: 62px;
        height: 62px;
        border-radius: .9rem;
        font-size: 1.85rem;
    }

    .login-brand h1 {
        margin: 0;
        color: white;
        font-size: 1.95rem;
        font-weight: 950;
        letter-spacing: -.04rem;
    }

    .login-brand p {
        margin: .2rem 0 0;
        color: rgba(255, 255, 255, .68);
        font-size: 1rem;
        font-weight: 700;
    }

    .login-brand-right {
        display: flex;
        align-items: center;
        gap: 1rem;
        color: rgba(255, 255, 255, .72);
        font-size: 1.05rem;
        padding-top: .4rem;
    }

    .login-divider {
        display: block;
        width: 1px;
        height: 38px;
        background: rgba(255, 255, 255, .45);
    }

    .login-main {
        position: relative;
        z-index: 5;
        display: grid;
        place-items: center;
        padding: 2rem 0 1rem;
    }

    .login-card {
        width: min(460px, 100%);
        background: rgba(255, 255, 255, .98);
