            "var(--navi-color-institutional)",
            "var(--navi-action-danger)",
            "var(--navi-color-border)",
            "var(--navi-color-border)",
            "var(--navi-color-institutional)"
        };

        var color = colors[index % colors.Length];

        return $"height:{percent}%; background:{color};";
    }

    // NAVI DASHBOARD BRANCH GRID 20260714 START

    private string GetBranchChartGridStyle()
    {
