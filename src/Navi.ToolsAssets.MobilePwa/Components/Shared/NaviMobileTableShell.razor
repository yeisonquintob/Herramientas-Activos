@using System.Collections.Generic
@using Microsoft.AspNetCore.Components

<section @attributes="AdditionalAttributes"
         class="@CssClass"
         data-ntx-component="mobile-table-shell">
    @if (HasHeader)
    {
        <header class="navi-mobile-table-shell__header">
            <div class="navi-mobile-table-shell__heading">
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <h2 class="navi-mobile-table-shell__title">
                        @Title
                    </h2>
                }

                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <p class="navi-mobile-table-shell__description">
                        @Description
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(CountLabel))
                {
                    <span class="navi-mobile-table-shell__count">
                        @CountLabel
                    </span>
                }
            </div>

            @if (HeaderActions is not null)
            {
                <div class="navi-mobile-table-shell__header-actions">
                    @HeaderActions
                </div>
            }
        </header>
    }

    <div class="navi-mobile-table-shell__viewport"
         role="region"
         aria-label="@ResolvedAriaLabel"
         tabindex="0">
        @ChildContent
    </div>

    @if (FooterContent is not null)
    {
        <footer class="navi-mobile-table-shell__footer">
            @FooterContent
        </footer>
    }
</section>

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? CountLabel { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public bool Compact { get; set; } = true;

    [Parameter]
    public bool StickyHeader { get; set; } = true;

    [Parameter]
    public bool Flush { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? FooterContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>?
        AdditionalAttributes { get; set; }

    private bool HasHeader =>
        !string.IsNullOrWhiteSpace(Title) ||
        !string.IsNullOrWhiteSpace(Description) ||
        !string.IsNullOrWhiteSpace(CountLabel) ||
        HeaderActions is not null;

    private string ResolvedAriaLabel =>
        !string.IsNullOrWhiteSpace(AriaLabel)
            ? AriaLabel.Trim()
            : !string.IsNullOrWhiteSpace(Title)
                ? Title.Trim()
                : "Tabla de información";

    private string CssClass
    {
        get
        {
            var classes = new List<string>
            {
                "navi-mobile-table-shell"
            };

            if (Compact)
            {
                classes.Add(
                    "navi-mobile-table-shell--compact");
            }

            if (StickyHeader)
            {
                classes.Add(
                    "navi-mobile-table-shell--sticky");
            }

            if (Flush)
            {
                classes.Add(
                    "navi-mobile-table-shell--flush");
            }

            if (!HasHeader)
            {
                classes.Add(
                    "navi-mobile-table-shell--without-header");
            }

            if (!string.IsNullOrWhiteSpace(Class))
            {
                classes.Add(Class.Trim());
            }

            return string.Join(" ", classes);
        }
    }
}
