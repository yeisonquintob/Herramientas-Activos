        color: #fff;
        font-size: .9rem;
        font-weight: 950;
        box-shadow: 0 .75rem 1.35rem rgba(99, 0, 113, .25);
        transition: transform .12s ease, box-shadow .12s ease, opacity .12s ease;
    }

    .login-submit:hover {
        transform: translateY(-1px);
        box-shadow: 0 .95rem 1.6rem rgba(99, 0, 113, .32);
    }

    .login-submit:disabled {
        opacity: .72;
        cursor: not-allowed;
        transform: none;
    }

    .login-footer {
        position: relative;
        z-index: 5;
        text-align: center;
        color: rgba(255, 255, 255, .78);
        font-size: .86rem;
        font-weight: 650;
    }

    .login-footer span {
        margin: 0 .65rem;
    }

    .login-bg-letter {
        position: absolute;
        z-index: 1;
        right: -5rem;
        bottom: -13rem;
        font-size: 36rem;
        line-height: 1;
        font-weight: 950;
        color: transparent;
        -webkit-text-stroke: 2px rgba(255, 255, 255, .12);
        text-stroke: 2px rgba(255, 255, 255, .12);
        user-select: none;
        pointer-events: none;
    }

    .login-bg-lines {
        position: absolute;
        z-index: 2;
        right: 7%;
        top: 25%;
        width: 360px;
        height: 420px;
        border: 2px solid rgba(255, 255, 255, .13);
        border-left-color: rgba(255, 255, 255, .24);
        border-radius: 7rem 0 0 7rem;
        transform: skewX(-28deg);
        opacity: .75;
        pointer-events: none;
    }

    .login-bg-dots {
        position: absolute;
        z-index: 2;
        right: 4%;
        top: 15%;
        width: 180px;
        height: 180px;
        opacity: .20;
        background-image: radial-gradient(rgba(255, 255, 255, .85) 1px, transparent 1px);
        background-size: 18px 18px;
        pointer-events: none;
    }

    @@media (max-width: 900px) {
        .login-shell {
            padding: 1.35rem;
        }

        .login-topbar {
            flex-direction: column;
        }

        .login-brand-right {
            display: none;
        }

        .login-brand h1 {
            font-size: 1.45rem;
        }

        .login-brand-icon {
            width: 52px;
            height: 52px;
            font-size: 1.55rem;
        }

        .login-card {
            padding: 1.55rem;
        }

        .login-bg-letter,
        .login-bg-lines,
        .login-bg-dots {
            display: none;
        }
    }

