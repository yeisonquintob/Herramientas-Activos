    private void ToggleToolStatusFilter(string status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return;
        }

        if (!selectedToolStatuses.Add(status))
        {
            selectedToolStatuses.Remove(status);
        }
    }

    private void ClearToolStatusFilter()
    {
