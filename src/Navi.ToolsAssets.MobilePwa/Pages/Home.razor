@page "/"

@using Microsoft.AspNetCore.Components
@using Navi.ToolsAssets.MobilePwa.Models

@inject NaviMobileApiClient Api
@inject MobileAuthSessionService Auth
@inject NavigationManager Navigation

<PageTitle>Inicio móvil - NAVI Herramientas y AF</PageTitle>

@if (isInitializing)
{
    <section class="mobile-page mobile-page-compact navi-mobile-home-form-fix-v10">
        <div class="mobile-loading" role="status" aria-busy="true">Cargando aplicación móvil...</div>
    </section>
}
else if (!Auth.IsAuthenticated)
{
    <section class="mobile-page mobile-page-compact">
        <div class="mobile-empty">
            <strong>Sesión requerida</strong>
            <span>Debes iniciar sesión para ingresar a la app móvil.</span>
            <button class="mobile-primary-button" type="button" @onclick="GoLogin" data-ntx-tone="ghost" >Ir al login</button>
        </div>
    </section>
}
else
{
    <section class="mobile-page mobile-page-compact navi-mobile-home-page-v8">
        <NaviMobileAppBanner Class="navi-mobile-home-principal-banner"
                             Pill="PRINCIPAL · APP MÓVIL"
                             Title="@($"Hola, {Display(Auth.CurrentUser?.DisplayName)}")"
                             Description="@Display(Auth.CurrentUser?.BranchName)"
                             ShowHomeButton="false"
                             ShowBackButton="false">
        </NaviMobileAppBanner>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="@messageClass">@message</div>
        }

        <NaviMobileKpiGrid Dividers="true" Columns="3"  Class="mobile-kpi-grid mobile-kpi-grid-compact mobile-kpi-grid-ultra navi-mobile-home-kpis-one-line">
            <NaviMobileKpiCard Class="mobile-kpi-card mobile-kpi-compact mobile-kpi-ultra" IconKey="inventory">
                <span>Mis activos</span>
                <strong>@assignedTools.Count</strong>
                <small>Asignados</small>
            </NaviMobileKpiCard>

            <NaviMobileKpiCard Class="mobile-kpi-card mobile-kpi-compact mobile-kpi-ultra warning" IconKey="bell">
                <span>Novedad</span>
                <strong>@damageReportedCount</strong>
                <small>Reportados</small>
            </NaviMobileKpiCard>

            <NaviMobileKpiCard Class="mobile-kpi-card mobile-kpi-compact mobile-kpi-ultra ok" IconKey="check">
                <span>Disponibles</span>
                <strong>@availableCount</strong>
                <small>Operación</small>
            </NaviMobileKpiCard>
        </NaviMobileKpiGrid>

        <section class="mobile-quick-actions navi-mobile-home-actions-v8"
                 aria-label="Acciones principales">

            <button type="button"
                    class="navi-mobile-home-action-v8 navi-mobile-home-action-request-v8"
                    aria-label="Solicitar asignación de una herramienta"
                    aria-expanded="@showLoanWindow"
                    @onclick="ToggleLoanRequest" data-ntx-tone="operation">

                <span class="navi-mobile-home-action-icon-v8"
                      aria-hidden="true">

                    <svg viewBox="0 0 24 24"
                         focusable="false">
                        <path d="M4 8h16v11H4z"></path>
                        <path d="M8 8V5h8v3"></path>
                        <path d="M12 11v5"></path>
                        <path d="M9.5 13.5h5"></path>
                    </svg>
                </span>

                <span class="navi-mobile-home-action-copy-v8">
                    <strong>Solicitar asignación</strong>
                    <small>
                        Buscar herramienta y enviar solicitud
                    </small>
                </span>

                <span class="navi-mobile-home-action-arrow-v8"
                      aria-hidden="true">

                    <svg viewBox="0 0 24 24"
                         focusable="false">
                        <path d="m9 6 6 6-6 6"></path>
                    </svg>
                </span>
            </button>

            <button type="button"
                    class="navi-mobile-home-action-v8 navi-mobile-home-action-report-v8"
                    aria-label="Reportar daño o novedad"
                    aria-expanded="@showDamageWindow"
                    @onclick="ToggleDamageReport" data-ntx-tone="operation">

                <span class="navi-mobile-home-action-icon-v8"
                      aria-hidden="true">

                    <svg viewBox="0 0 24 24"
                         focusable="false">
                        <path d="M10.3 4.3 2.8 17.2A2 2 0 0 0 4.5 20h15a2 2 0 0 0 1.7-2.8L13.7 4.3a2 2 0 0 0-3.4 0Z"></path>
                        <path d="M12 9v4"></path>
                        <path d="M12 17h.01"></path>
                    </svg>
                </span>

                <span class="navi-mobile-home-action-copy-v8">
                    <strong>Reportar daño</strong>
                    <small>
                        Registrar falla o novedad
                    </small>
                </span>

                <span class="navi-mobile-home-action-arrow-v8"
                      aria-hidden="true">

                    <svg viewBox="0 0 24 24"
                         focusable="false">
                        <path d="m9 6 6 6-6 6"></path>
                    </svg>
                </span>
            </button>
        </section>

        @if (showLoanWindow)
        {
            <section class="mobile-loan-window navi-action-window navi-mobile-home-form-v10 is-loan navi-mobile-request-form-v11">
                <div class="mobile-loan-head navi-mobile-home-form-head-v10 navi-mobile-form-header-v11">
                    <div>
                        <strong>Solicitud de asignación</strong>
                        <span>La solicitud queda pendiente de aprobación.</span>
                    </div>

                    <button type="button"
                            class="navi-mobile-purple-close-v11"
                            title="Cerrar solicitud"
                            aria-label="Cerrar solicitud de asignación"
                            @onclick="CloseLoanRequest" data-ntx-tone="operation">

                        <span class="navi-mobile-purple-close-v11__icon"
                              aria-hidden="true">
                            ×
                        </span>

                        <span>Cerrar</span>
                    </button>
                </div>

                <div class="mobile-loan-user navi-mobile-home-form-user-v10">
                    <span>Solicitante</span>
                    <strong>@CurrentResponsibleLabel</strong>
                </div>

                <label class="mobile-field
                              navi-mobile-tool-search-v11">

                    <span class="navi-mobile-tool-search-v11__label">
                        Buscar herramienta
                    </span>

                    <div class="navi-mobile-tool-search-v11__control">
                        <span class="navi-mobile-tool-search-v11__icon"
                              aria-hidden="true">
                        </span>

                        <input value="@loanSearch"
                               @oninput="OnLoanSearchChanged"
                               autocomplete="off"
                               aria-label="Buscar herramienta para solicitar"
                               placeholder="Código, nombre, serial, sede o responsable..." name="navi-home-field-001" />
                    </div>

                    <small class="navi-mobile-tool-search-v11__help">
                        Escribe para consultar las herramientas
                        disponibles dentro de tu alcance.
                    </small>
                </label>

                @if (ShowLoanSearchResults)
                {
                    <section class="navi-mobile-tool-results-v11"
                             aria-label="Resultados de búsqueda">

                        <header class="navi-mobile-tool-results-v11__header">
                            <div>
                                <strong>Disponibles para solicitar</strong>
                                <small>
                                    Solo aparecen herramientas disponibles y sin responsable.
                                </small>
                            </div>

                            <span title="Cantidad de resultados">
                                @LoanRequestTools.Count()
                            </span>
                        </header>

                        @if (!LoanRequestTools.Any())
                        {
                            <div class="navi-mobile-tool-results-v11__empty">
                                <strong>Sin coincidencias</strong>
                                <small>
                                    Prueba con otro código, nombre,
                                    serial, sede o responsable.
                                </small>
                            </div>
                        }
                        else
                        {
                            @foreach (var tool in LoanRequestTools)
                            {
                                var selected =
                                    loanForm.ToolId == tool.Id;

                                <button type="button"
                                        class="navi-mobile-tool-option-v11 @GetToolStateClass(tool) @(selected ? "selected" : string.Empty)"
                                        aria-pressed="@(selected ? "true" : "false")"
                                        @onclick="() => SelectLoanTool(tool)" data-ntx-tone="ghost">

                                    <span class="navi-mobile-tool-option-v11__marker"
                                          aria-hidden="true">
                                    </span>

                                    <span class="navi-mobile-tool-option-v11__body">
                                        <span class="navi-mobile-tool-option-v11__top">
                                            <strong>
                                                @tool.InternalCode
                                            </strong>

                                            <em>
                                                @GetStatusLabel(
                                                    tool.OperationalStatus)
                                            </em>
                                        </span>

                                        <span class="navi-mobile-tool-option-v11__name">
                                            @tool.Name
                                        </span>

                                        <span class="navi-mobile-tool-option-v11__data">
                                            <span>
                                                <small>Sede</small>
                                                <strong>
                                                    @Display(tool.BranchCode)
                                                </strong>
                                            </span>

                                            <span>
                                                <small>Ubicación</small>
                                                <strong>
                                                    @Display(tool.LocationName)
                                                </strong>
                                            </span>
                                        </span>

                                        @if (
                                            !string.IsNullOrWhiteSpace(
                                                tool.SerialNumber) ||
                                            !string.IsNullOrWhiteSpace(
                                                tool.ResponsiblePersonName)
                                        )
                                        {
                                            <span class="navi-mobile-tool-option-v11__extra">
                                                @if (
                                                    !string.IsNullOrWhiteSpace(
                                                        tool.SerialNumber)
                                                )
                                                {
                                                    <span>
                                                        Serial:
                                                        @tool.SerialNumber
                                                    </span>
                                                }

                                                @if (
                                                    !string.IsNullOrWhiteSpace(
                                                        tool.ResponsiblePersonName)
                                                )
                                                {
                                                    <span>
                                                        Responsable:
                                                        @tool.ResponsiblePersonName
                                                    </span>
                                                }
                                            </span>
                                        }
                                    </span>
                                </button>
                            }
                        }
                    </section>
                }

                @if (selectedLoanTool is not null)
                {
                    <div class="mobile-loan-selected navi-mobile-selected-tool-v10">
                        <span>@selectedLoanTool.InternalCode</span>
                        <strong>@selectedLoanTool.Name</strong>
                        <small>@Display(selectedLoanTool.BranchCode) · @Display(selectedLoanTool.LocationName)</small>
                    </div>
                }

                <label class="mobile-field">
                    <span>Fecha estimada devolución</span>
                    <input type="date"
                           value="@FormatDateInput(loanForm.ExpectedReturnAt)"
                           @onchange="OnLoanExpectedReturnChanged" name="navi-home-field-002" />
                </label>

                <label class="mobile-field">
                    <span>Observación</span>
                    <textarea class="navi-mobile-compact-textarea-v10 navi-mobile-observation-v11"
                              value="@loanForm.Notes"
                              @oninput="OnLoanNotesChanged"
                              placeholder="Indique para qué requiere la herramienta..." name="navi-home-field-003"></textarea>
                </label>

                <button class="mobile-loan-submit navi-mobile-positive-submit-v10 navi-mobile-positive-submit-v11"
                        type="button"
                        disabled="@isSaving"
                        @onclick="SubmitLoanRequestAsync" data-ntx-tone="affirmative">
                    @(isSaving ? "Enviando..." : "Enviar solicitud")
                </button>
            </section>
        }

        @if (showDamageWindow)
        {
            <section class="mobile-loan-window navi-action-window navi-mobile-home-form-v10 is-damage navi-mobile-report-form-v11">
                <div class="mobile-loan-head navi-mobile-home-form-head-v10 navi-mobile-form-header-v11">
                    <div>
                        <strong>Reporte de daño</strong>
                        <span>Registra una falla, daño o novedad del activo.</span>
                    </div>

                    <button type="button"
                            class="navi-mobile-purple-close-v11"
                            title="Cerrar reporte"
                            aria-label="Cerrar reporte de daño"
                            @onclick="CloseDamageReport" data-ntx-tone="ghost">

                        <span class="navi-mobile-purple-close-v11__icon"
                              aria-hidden="true">
                            ×
                        </span>

                        <span>Cerrar</span>
                    </button>
                </div>

                <div class="mobile-loan-user navi-mobile-home-form-user-v10">
                    <span>Reportado por</span>
                    <strong>@Display(Auth.CurrentUser?.DisplayName)</strong>
                </div>

                <label class="mobile-field
                              navi-mobile-tool-search-v11">

                    <span class="navi-mobile-tool-search-v11__label">
                        Buscar herramienta
                    </span>

                    <div class="navi-mobile-tool-search-v11__control">
                        <span class="navi-mobile-tool-search-v11__icon"
                              aria-hidden="true">
                        </span>

                        <input value="@damageSearch"
                               @oninput="OnDamageSearchChanged"
                               autocomplete="off"
                               aria-label="Buscar herramienta para reportar"
                               placeholder="Código, nombre, serial, sede o responsable..." name="navi-home-field-004" />
                    </div>

                    <small class="navi-mobile-tool-search-v11__help">
                        Selecciona el activo sobre el cual
                        registrarás la novedad.
                    </small>
                </label>

                @if (ShowDamageSearchResults)
                {
                    <section class="navi-mobile-tool-results-v11"
                             aria-label="Resultados de búsqueda">

                        <header class="navi-mobile-tool-results-v11__header">
                            <div>
                                <strong>Activos bajo tu responsabilidad</strong>
                                <small>
                                    Selecciona uno de tus activos asignados.
                                </small>
                            </div>

                            <span title="Cantidad de resultados">
                                @DamageTools.Count()
                            </span>
                        </header>

                        @if (!DamageTools.Any())
                        {
                            <div class="navi-mobile-tool-results-v11__empty">
                                <strong>Sin coincidencias</strong>
                                <small>
                                    Prueba con otro código, nombre,
                                    serial, sede o responsable.
                                </small>
                            </div>
                        }
                        else
                        {
                            @foreach (var tool in DamageTools)
                            {
                                var selected =
                                    damageForm.ToolAssetId == tool.Id;

                                <button type="button"
                                        class="navi-mobile-tool-option-v11 @GetToolStateClass(tool) @(selected ? "selected" : string.Empty)"
                                        aria-pressed="@(selected ? "true" : "false")"
                                        @onclick="() => SelectDamageTool(tool)" data-ntx-tone="ghost">

                                    <span class="navi-mobile-tool-option-v11__marker"
                                          aria-hidden="true">
                                    </span>

                                    <span class="navi-mobile-tool-option-v11__body">
                                        <span class="navi-mobile-tool-option-v11__top">
                                            <strong>
                                                @tool.InternalCode
                                            </strong>

                                            <em>
                                                @GetStatusLabel(
                                                    tool.OperationalStatus)
                                            </em>
                                        </span>

                                        <span class="navi-mobile-tool-option-v11__name">
                                            @tool.Name
                                        </span>

                                        <span class="navi-mobile-tool-option-v11__data">
                                            <span>
                                                <small>Sede</small>
                                                <strong>
                                                    @Display(tool.BranchCode)
                                                </strong>
                                            </span>

                                            <span>
                                                <small>Ubicación</small>
                                                <strong>
                                                    @Display(tool.LocationName)
                                                </strong>
                                            </span>
                                        </span>

                                        @if (
                                            !string.IsNullOrWhiteSpace(
                                                tool.SerialNumber) ||
                                            !string.IsNullOrWhiteSpace(
                                                tool.ResponsiblePersonName)
                                        )
                                        {
                                            <span class="navi-mobile-tool-option-v11__extra">
                                                @if (
                                                    !string.IsNullOrWhiteSpace(
                                                        tool.SerialNumber)
                                                )
                                                {
                                                    <span>
                                                        Serial:
                                                        @tool.SerialNumber
                                                    </span>
                                                }

                                                @if (
                                                    !string.IsNullOrWhiteSpace(
                                                        tool.ResponsiblePersonName)
                                                )
                                                {
                                                    <span>
                                                        Responsable:
                                                        @tool.ResponsiblePersonName
                                                    </span>
                                                }
                                            </span>
                                        }
                                    </span>
                                </button>
                            }
                        }
                    </section>
                }

                @if (selectedDamageTool is not null)
                {
                    <div class="mobile-loan-selected navi-mobile-selected-tool-v10">
                        <span>@selectedDamageTool.InternalCode</span>
                        <strong>@selectedDamageTool.Name</strong>
                        <small>@Display(selectedDamageTool.BranchCode) · @Display(selectedDamageTool.LocationName)</small>
                    </div>
                }

                <label class="mobile-field">
                    <span>Severidad</span>
                    <select value="@damageForm.Severity" @onchange="OnDamageSeverityChanged" name="navi-home-field-005">
                        <option value="Low">Baja</option>
                        <option value="Medium">Media</option>
                        <option value="High">Alta</option>
                        <option value="Critical">Crítica</option>
                    </select>
                </label>

                <label class="mobile-check-field">
                    <input type="checkbox"
                           checked="@damageForm.BlocksLoan"
                           @onchange="OnDamageBlocksLoanChanged" name="navi-home-field-006" />
                    <span>Bloquea préstamo o asignación hasta revisión</span>
                </label>

                <label class="mobile-field">
                    <span>Descripción del daño o novedad</span>
                    <textarea class="navi-mobile-compact-textarea-v10 navi-mobile-observation-v11"
                              value="@damageForm.Description"
                              @oninput="OnDamageDescriptionChanged"
                              placeholder="Describe claramente la falla, daño o novedad..." name="navi-home-field-007"></textarea>
                </label>

                <button class="mobile-loan-submit navi-mobile-positive-submit-v10 navi-mobile-positive-submit-v11"
                        type="button"
                        disabled="@isSaving"
                        @onclick="SubmitDamageReportAsync" data-ntx-tone="affirmative">
                    @(isSaving ? "Enviando..." : "Enviar reporte")
                </button>
            </section>
        }

        @if (MenuItems.Any())
        {
            <section class="mobile-menu-panel mobile-menu-panel-compact mobile-menu-panel-full mobile-menu-white-panel navi-operational-menu-panel">
                <div class="mobile-panel-head mobile-panel-head-compact navi-operational-menu-head">
                    <h2>Menú operativo</h2>

                    <button class="navi-operational-menu-toggle navi-operational-menu-toggle-primary-v7"
                            type="button"
                            aria-expanded="@showOperationalMenu"
                            aria-controls="navi-operational-menu-content"
                            @onclick="ToggleOperationalMenu" data-ntx-tone="expand" >
                        @(showOperationalMenu ? "Ocultar" : "Mostrar")
                    </button>
                </div>

                @if (showOperationalMenu)
                {
                    <div id="navi-operational-menu-content" class="mobile-menu-grid mobile-menu-grid-compact mobile-menu-grid-full navi-operational-menu-grid">
                        @foreach (var item in MenuItems)
                        {
                            <a class="mobile-menu-card mobile-menu-card-compact mobile-menu-card-full mobile-menu-card-white" href="@item.Url">
                                <span class="mobile-icon-code mobile-icon-real">@GetMenuIcon(item.IconKey)</span>
                                <strong>@item.Title</strong>
                                <small>@item.Description</small>
                            </a>
                        }
                    </div>
                }
            </section>
        }

        <section class="mobile-panel mobile-panel-compact mobile-last-assets-panel navi-mobile-home-assets-panel-v8">
            <div class="mobile-panel-head
                    mobile-panel-head-compact
                    mobile-assigned-head-no-link
                    navi-mobile-home-assets-head-v8">

                <div class="navi-mobile-home-assets-title-v8">
                    <span class="navi-mobile-home-assets-eyebrow-v8">
                        INVENTARIO PERSONAL
                    </span>

                    <h2>Herramientas asignadas a mi nombre</h2>

                    <p>
                        Activos que se encuentran actualmente
                        bajo tu responsabilidad.
                    </p>
                </div>

                <span class="navi-mobile-home-assets-count-v8"
                      title="Cantidad de herramientas asignadas">
                    @assignedTools.Count
                </span>
            </div>

            @if (!assignedTools.Any())
            {
                <div class="mobile-empty compact
                            navi-mobile-home-assets-empty-v8">

                    <span aria-hidden="true">
                        <svg viewBox="0 0 24 24"
                             focusable="false">
                            <path d="M4 8h16v11H4z"></path>
                            <path d="M8 8V5h8v3"></path>
                            <path d="M9 13h6"></path>
                        </svg>
                    </span>

                    <div>
                        <strong>Sin herramientas asignadas</strong>
                        <small>
                            No se encontraron activos asociados
                            a tu usuario.
                        </small>
                    </div>
                </div>
            }
            else
            {
                <div class="mobile-assigned-assets-list">
                    @foreach (var tool in assignedTools)
                    {
                        <article class="mobile-assigned-card navi-mobile-home-asset-card-v8">
                            <div class="mobile-assigned-card-head navi-mobile-home-asset-head-v8">
                                <div>
                                    <span>@tool.InternalCode</span>
                                    <strong>@tool.Name</strong>
                                </div>

                                <em class="@GetToolStateClass(tool)">
                                    @GetStatusLabel(tool.OperationalStatus)
                                </em>
                            </div>

                            <div class="mobile-assigned-grid navi-mobile-home-asset-info-v8">
                                <div>
                                    <span>Sede</span>
                                    <strong>@Display(tool.BranchCode)</strong>
                                </div>

                                <div>
                                    <span>Ubicación</span>
                                    <strong>@Display(tool.LocationName)</strong>
                                </div>

                                <div>
                                    <span>Responsable</span>
                                    <strong>@Display(tool.ResponsiblePersonName)</strong>
                                </div>

                                <div>
                                    <span>Físico</span>
                                    <strong>@Display(tool.PhysicalStatus)</strong>
                                </div>
                            </div>

                            <div class="mobile-assigned-actions
                                        navi-mobile-home-asset-actions-v8">

                                <a class="navi-mobile-home-asset-action-v8
                                          navi-mobile-home-asset-detail-v8"
                                   href="@GetDetailUrl(tool.Id)"
                                   aria-label="@($"Ver detalle de {tool.Name}")">

                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true"
                                         focusable="false">
                                        <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
                                        <circle cx="12" cy="12" r="2.5"></circle>
                                    </svg>

                                    <span>Ver detalle</span>
                                </a>

@* NAVI MOBILE HOME IMAGE ACTION V80 START *@

                                <button
                                    type="button"
                                    class="navi-mobile-home-asset-action-v8 navi-mobile-home-asset-view-v80"
                                    title="Visualizar imagen"
                                    aria-label="@($"Visualizar imagen de {tool.Name}")"
                                    data-ntx-tone="consult"
                                    @onclick="() => OpenHomeImagePreviewV80(tool)">

                                    <svg
                                        viewBox="0 0 24 24"
                                        aria-hidden="true"
                                        focusable="false">

                                        <rect
                                            x="3"
                                            y="5"
                                            width="18"
                                            height="14"
                                            rx="2">
                                        </rect>

                                        <circle
                                            cx="9"
                                            cy="10"
                                            r="2">
                                        </circle>

                                        <path d="M4 17L9 13L13 16L16 13L20 17"></path>

                                    </svg>

                                    <span>Ver</span>

                                </button>

@* NAVI MOBILE HOME IMAGE ACTION V80 END *@

                                <a class="navi-mobile-home-asset-action-v8
                                          navi-mobile-home-asset-report-v8"
                                   href="@GetDamageUrl(tool.Id)"
                                   aria-label="@($"Reportar novedad de {tool.Name}")">

                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true"
                                         focusable="false">
                                        <path d="M10.3 4.3 2.8 17.2A2 2 0 0 0 4.5 20h15a2 2 0 0 0 1.7-2.8L13.7 4.3a2 2 0 0 0-3.4 0Z"></path>
                                        <path d="M12 9v4"></path>
                                        <path d="M12 17h.01"></path>
                                    </svg>

                                    <span>Reportar novedad</span>
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </section>
}

