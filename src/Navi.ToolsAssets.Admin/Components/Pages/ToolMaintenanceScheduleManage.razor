@page "/tools/{ToolId:guid}/maintenance-schedule"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Navi.ToolsAssets.Admin.Services.Auth
@using Navi.ToolsAssets.Admin.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject WebAuthSessionService AuthSession
@inject NavigationManager NavigationManager

<PageTitle>Cronograma mantenimiento - NAVI Herramientas</PageTitle>

<PermissionGuard Permission="MaintenancePlans.View" ModuleName="Cronograma de mantenimiento">

<div class="navi-life-record-subpage navi-life-record-subpage--maintenance">



@* NAVI LIFE RECORD SUBPAGE STANDARD V76 MAINTENANCE START *@

<NaviPageHero
    Pill="ACTIVOS FIJOS"
    Title="Cronograma de mantenimiento"
    Description="Registra, actualiza o desactiva mantenimientos preventivos, correctivos y de calibración." />

<NaviKpiToolbar
    Class="navi-life-record-subpage-toolbar
           navi-life-record-subpage-toolbar--maintenance"
    Refresh="LoadAsync"
    IsRefreshing="isLoading"
    RefreshTitle="Actualizar cronograma de mantenimiento"
    RefreshAriaLabel="Actualizar cronograma de mantenimiento">

    <div class="navi-life-record-subpage-toolbar__body">

        <NaviKpiGrid
            Columns="3"
            Compact="true"
            Dividers="true"
            Class="navi-life-record-subpage-kpis">

            <NaviKpiCard
                Title="Código interno"
                Description="Identificación del activo"
                Value="@internalCode"
                Tone="neutral"
                Compact="true">

                <IconContent>
                    <NaviKpiIcon Name="inventory" />
                </IconContent>

            </NaviKpiCard>

            <NaviKpiCard
                Title="Activo"
                Description="Hoja de vida técnica"
                Value="@toolName"
                Tone="soft"
                Compact="true"
                     Class="navi-life-record-kpi-asset">

                <IconContent>
                    <NaviKpiIcon Name="document" />
                </IconContent>

            </NaviKpiCard>

            <NaviKpiCard
                Title="Mantenimientos"
                Description="Cronograma y evidencias"
                Value="@maintenanceRecords.Count.ToString()"
                Tone="warning"
                Compact="true">

                <IconContent>
                    <NaviKpiIcon Name="wrench" />
                </IconContent>

            </NaviKpiCard>

        </NaviKpiGrid>

        <a class="navi-life-record-subpage-back"
           href="@($"/tools/{ToolId}/technical-life-record")"
           aria-label="Volver a hoja de vida"
           data-ntx-tone="secondary">

            <span aria-hidden="true">←</span>
            <span>Volver a hoja de vida</span>

        </a>

    </div>

</NaviKpiToolbar>

@* NAVI LIFE RECORD SUBPAGE STANDARD V76 MAINTENANCE END *@

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

<div class="maintenance-schedule-manage-grid">
    <section class="life-record-section">
        <div class="section-title">
            <span>1</span>
            <h2>@(editingMaintenanceId.HasValue ? "Editar mantenimiento" : "Nuevo mantenimiento")</h2>
        </div>

        <EditForm Model="formModel" OnValidSubmit="SaveAsync">
            @if (!CanUseMaintenanceForm)
            {
                <div class="alert alert-warning">
                    No tienes permiso para crear o editar registros de mantenimiento en este cronograma.
                </div>
            }

            <fieldset class="schedule-permission-fieldset" disabled="@(!CanUseMaintenanceForm)">
            <div class="edit-form-grid">
                <div>
                    <label for="navi-toolmaintenanceschedulemanage-control-001">Número mantenimiento</label>
                    <InputText class="form-control" @bind-Value="formModel.MaintenanceNumber" placeholder="Ej: MTTO-AGU-001" id="navi-toolmaintenanceschedulemanage-control-001" />
                </div>

                <div>
                    <label for="navi-toolmaintenanceschedulemanage-control-002">Fecha programada</label>
                    <InputDate class="form-control" @bind-Value="formModel.ScheduledAt" id="navi-toolmaintenanceschedulemanage-control-002" />
                </div>

                <div>
                    <label for="navi-toolmaintenanceschedulemanage-control-003">Tipo</label>
                    <InputSelect class="form-select" @bind-Value="formModel.Type" id="navi-toolmaintenanceschedulemanage-control-003">
                        <option value="Preventive">Preventivo</option>
                        <option value="Corrective">Correctivo</option>
                        <option value="Calibration">Calibración</option>
                        <option value="Inspection">Inspección</option>
                    </InputSelect>
                </div>

                <div>
                    <label for="navi-toolmaintenanceschedulemanage-control-004">Estado</label>
                    <InputSelect class="form-select" @bind-Value="formModel.Status" id="navi-toolmaintenanceschedulemanage-control-004">
                        <option value="Scheduled">Programado</option>
                        <option value="InProgress">En proceso</option>
                        <option value="Completed">Completado</option>
                        <option value="Cancelled">Cancelado</option>
                    </InputSelect>
                </div>

                <div>
                    <label for="navi-toolmaintenanceschedulemanage-control-005">Proveedor</label>
                    <InputText class="form-control" @bind-Value="formModel.Provider" id="navi-toolmaintenanceschedulemanage-control-005" />
                </div>

                <div>
                    <label for="navi-toolmaintenanceschedulemanage-control-006">Técnico</label>
                    <InputText class="form-control" @bind-Value="formModel.Technician" id="navi-toolmaintenanceschedulemanage-control-006" />
                </div>

                <div>
                    <label for="navi-toolmaintenanceschedulemanage-control-007">Responsable</label>
                    <InputText class="form-control" @bind-Value="formModel.ResponsibleName" id="navi-toolmaintenanceschedulemanage-control-007" />
                </div>

                <div>
                    <label for="navi-toolmaintenanceschedulemanage-control-008">Cargo responsable</label>
                    <InputText class="form-control" @bind-Value="formModel.ResponsiblePosition" id="navi-toolmaintenanceschedulemanage-control-008" />
                </div>

                <div>
                    <label for="navi-toolmaintenanceschedulemanage-control-009">Factura</label>
                    <InputText class="form-control" @bind-Value="formModel.InvoiceNumber" id="navi-toolmaintenanceschedulemanage-control-009" />
                </div>

                <div>
                    <label for="navi-toolmaintenanceschedulemanage-control-010">Costo</label>
                    <InputNumber class="form-control" @bind-Value="formModel.Cost" id="navi-toolmaintenanceschedulemanage-control-010" />
                </div>

                <div>
                    <label for="navi-toolmaintenanceschedulemanage-control-011">Documento evidencia</label>
                    <InputSelect class="form-select" @bind-Value="formModel.EvidenceDocumentIdText" id="navi-toolmaintenanceschedulemanage-control-011">
                        <option value="">Sin evidencia</option>
                        @foreach (var doc in documents)
                        {
                            <option value="@doc.Id">@doc.FileName - @TranslateDocumentType(doc.DocumentType)</option>
                        }
                    </InputSelect>

                    <div class="maintenance-evidence-actions">
                        <a class="btn btn-sm ntx-btn--operation"
                           href="@($"/tools/{ToolId}/documents")" data-ntx-tone="operation" >
                            Cargar evidencia / documentos
                        </a>

                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="LoadAsync" data-ntx-tone="refresh" >
                            Recargar documentos
                        </button>
                    </div>
                </div>

                <div>
                    <label for="navi-toolmaintenanceschedulemanage-control-012">Fecha inicio</label>
                    <InputDate class="form-control" @bind-Value="formModel.StartedAt" id="navi-toolmaintenanceschedulemanage-control-012" />
                </div>

                <div>
                    <label for="navi-toolmaintenanceschedulemanage-control-013">Fecha finalización</label>
                    <InputDate class="form-control" @bind-Value="formModel.FinishedAt" id="navi-toolmaintenanceschedulemanage-control-013" />
                </div>

                <div class="form-check-row">
                    <InputCheckbox class="form-check-input" @bind-Value="formModel.IsToolOperational" name="navi-toolmaintenanceschedulemanage-field-001" id="navi-toolmaintenanceschedulemanage-control-014" />
                    <label for="navi-toolmaintenanceschedulemanage-control-014">Herramienta operativa</label>
                </div>
            </div>

            <div class="mt-3">
                <label for="navi-toolmaintenanceschedulemanage-control-015">Descripción</label>
                <InputTextArea class="form-control technical-observation"
                               @bind-Value="formModel.Description"
                               placeholder="Descripción general del mantenimiento..." id="navi-toolmaintenanceschedulemanage-control-015" />
            </div>

            <div class="mt-3">
                <label for="navi-toolmaintenanceschedulemanage-control-016">Actividades realizadas / programadas</label>
                <InputTextArea class="form-control technical-observation"
                               @bind-Value="formModel.MaintenanceActivities"
                               placeholder="Ej: Limpieza | Inspección | Verificación funcional" id="navi-toolmaintenanceschedulemanage-control-016" />
            </div>

            <div class="mt-3">
                <label for="navi-toolmaintenanceschedulemanage-control-017">Notas de ejecución</label>
                <InputTextArea class="form-control technical-observation"
                               @bind-Value="formModel.ExecutionNotes"
                               placeholder="Notas o hallazgos del mantenimiento..." id="navi-toolmaintenanceschedulemanage-control-017" />
            </div>

            <div class="mt-3">
                <label for="navi-toolmaintenanceschedulemanage-control-018">Resultado</label>
                <InputTextArea class="form-control technical-observation"
                               @bind-Value="formModel.Result"
                               placeholder="Resultado final o pendiente..." id="navi-toolmaintenanceschedulemanage-control-018" />
            </div>

            </fieldset>

            <div class="technical-edit-actions static-actions mt-3">
                @if (editingMaintenanceId.HasValue)
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit" data-ntx-tone="secondary" >
                        Cancelar edición
                    </button>
                }

                <button type="submit" class="btn ntx-btn--operation" disabled="@(!CanUseMaintenanceForm || isSaving)" data-ntx-tone="affirmative" >
                    @GetSaveButtonText()
                </button>
            </div>
        </EditForm>
    </section>

    <section class="life-record-section">
        <div class="section-title">
            <span>2</span>
            <h2>Registros de mantenimiento</h2>
        </div>

        @if (isLoading)
        {
            <div class="alert alert-info mb-0" role="status" aria-busy="true">Cargando cronograma...</div>
        }
        else if (maintenanceRecords.Count == 0)
        {
            <p class="text-muted mb-0">No hay mantenimientos registrados para esta herramienta.</p>
        }
        else
        {
            <div class="maintenance-card-list">
                @foreach (var item in maintenanceRecords)
                {
                    <div class="maintenance-card">
                        <div class="maintenance-card-header">
                            <div>
                                <strong>@item.MaintenanceNumber</strong>
                                <p>@FormatDate(item.ScheduledAt) · @TranslateType(item.Type)</p>
                            </div>

                            <span class="maintenance-status">@TranslateStatus(item.Status)</span>
                        </div>

                        <div class="maintenance-card-body">
                            <div><span>Proveedor:</span> @Show(item.Provider)</div>
                            <div><span>Técnico:</span> @Show(item.Technician)</div>
                            <div><span>Responsable:</span> @Show(item.ResponsibleName)</div>
                            <div><span>Factura:</span> @Show(item.InvoiceNumber)</div>
                            <div><span>Costo:</span> @FormatMoney(item.Cost)</div>
                            <div><span>Operativa:</span> @(item.IsToolOperational == true ? "Sí" : "No")</div>
                            <div>
                                <span>Evidencia:</span> @GetEvidenceDisplay(item.EvidenceDocumentId)

                                @if (HasEvidence(item.EvidenceDocumentId))
                                {
                                    <a class="btn btn-sm ntx-btn--affirmative maintenance-evidence-download"
                                       href="@BuildEvidenceDownloadUrl(item.EvidenceDocumentId)"
                                       target="_blank" data-ntx-tone="operation" >
                                        Descargar evidencia
                                    </a>
                                }
                            </div>
                        </div>

                        <p class="maintenance-description">@Show(item.Description)</p>

                        <div class="d-flex gap-1 flex-wrap mt-2 navi-life-record-paired-actions">
<button class="btn btn-sm ntx-btn--operation" disabled="@(!CanEditSchedule)" @onclick="() => StartEdit(item)" data-ntx-tone="operation" >
                                Editar
                            </button>

                            <button class="btn btn-sm ntx-btn--danger" disabled="@(!CanDeleteSchedule)" @onclick="() => DeleteAsync(item)" data-ntx-tone="danger" >
                                Desactivar
                            </button>
</div>
                    </div>
                }
            </div>
        }
    </section>
</div>



</div>

</PermissionGuard>

@code {

    private bool CanViewSchedule =>
        ScheduleHasPermission("MaintenancePlans.View") ||
        ScheduleHasPermission("MaintenancePlans.Create") ||
        ScheduleHasPermission("MaintenancePlans.Edit") ||
        ScheduleHasPermission("MaintenancePlans.Delete") ||
        ScheduleHasPermission("TechnicalLifeRecord.Maintenance");

    private bool CanCreateSchedule => ScheduleHasPermission("MaintenancePlans.Create");
    private bool CanEditSchedule => ScheduleHasPermission("MaintenancePlans.Edit");
    private bool CanDeleteSchedule => ScheduleHasPermission("MaintenancePlans.Delete");

    private bool CanUseMaintenanceForm =>
        (!editingMaintenanceId.HasValue && CanCreateSchedule) ||
        (editingMaintenanceId.HasValue && CanEditSchedule);

    private bool ScheduleHasPermission(string permission)
    {
        return AuthSession.HasPermission(permission)
            || string.Equals(AuthSession.RoleCode, "ADMIN", StringComparison.OrdinalIgnoreCase)
            || string.Equals(AuthSession.RoleCode, "SUPERADMIN", StringComparison.OrdinalIgnoreCase);
    }


    [Parameter]
    public Guid ToolId { get; set; }

    private bool isLoading;
    private bool isSaving;
    private string? errorMessage;
    private string? successMessage;
    private string internalCode = string.Empty;
    private string toolName = string.Empty;
    private Guid? editingMaintenanceId;

    private MaintenanceFormModel formModel = new()
    {
        Type = "Preventive",
        Status = "Scheduled",
        ScheduledAt = DateTime.Today.AddDays(30),
        IsToolOperational = true
    };

    private List<MaintenanceItemModel> maintenanceRecords = new();
    private List<DocumentItemModel> documents = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var client = HttpClientFactory.CreateClient("NaviApi");

            var record = await client.GetFromJsonAsync<TechnicalLifeRecordHeaderModel>($"api/tools/{ToolId}/technical-life-record");

            if (record is not null)
            {
                internalCode = record.Summary.InternalCode;
                toolName = record.Summary.Name;
            }

            maintenanceRecords = await client.GetFromJsonAsync<List<MaintenanceItemModel>>($"api/tools/{ToolId}/maintenance-schedule") ?? new();
            documents = await client.GetFromJsonAsync<List<DocumentItemModel>>($"api/tools/{ToolId}/documents") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar el cronograma. Valida que la API esté activa. Detalle: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
private async Task SaveAsync()
    {
        if (editingMaintenanceId.HasValue && !CanEditSchedule)
        {
            errorMessage = "No tienes permiso para editar registros del cronograma de mantenimiento.";
            return;
        }

        if (!editingMaintenanceId.HasValue && !CanCreateSchedule)
        {
            errorMessage = "No tienes permiso para crear registros del cronograma de mantenimiento.";
            return;
        }

        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            var client = HttpClientFactory.CreateClient("NaviApi");

            HttpResponseMessage response;

            if (editingMaintenanceId.HasValue)
            {
                var payload = BuildPayload("updated");
                response = await client.PutAsJsonAsync($"api/tools/maintenance-schedule/{editingMaintenanceId.Value}", payload);
            }
            else
            {
                var payload = BuildPayload("created");
                response = await client.PostAsJsonAsync($"api/tools/{ToolId}/maintenance-schedule", payload);
            }

            if (!response.IsSuccessStatusCode)
            {
                var detail = await response.Content.ReadAsStringAsync();
                errorMessage = $"No se pudo guardar el mantenimiento. Código: {(int)response.StatusCode}. Detalle: {detail}";
                return;
            }

            successMessage = editingMaintenanceId.HasValue
                ? "Mantenimiento actualizado correctamente."
                : "Mantenimiento creado correctamente.";

            CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo guardar el mantenimiento. Detalle: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }


    private object BuildPayload(string mode)
    {
        return new
        {
            maintenanceNumber = string.IsNullOrWhiteSpace(formModel.MaintenanceNumber)
                ? null
                : formModel.MaintenanceNumber,

            type = formModel.Type,
            status = formModel.Status,
            scheduledAt = formModel.ScheduledAt,
            startedAt = formModel.StartedAt,
            finishedAt = formModel.FinishedAt,
            provider = formModel.Provider,
            technician = formModel.Technician,
            description = formModel.Description,
            maintenanceActivities = formModel.MaintenanceActivities,
            executionNotes = formModel.ExecutionNotes,
            invoiceNumber = formModel.InvoiceNumber,
            responsibleName = formModel.ResponsibleName,
            responsiblePosition = formModel.ResponsiblePosition,
            isToolOperational = formModel.IsToolOperational,
            evidenceDocumentId = GetSelectedEvidenceDocumentId(),
            cost = formModel.Cost,
            result = formModel.Result,
            createdBy = mode == "created" ? "yquinto" : null,
            updatedBy = mode == "updated" ? "yquinto" : null
        };
    }
private void StartEdit(MaintenanceItemModel item)
    {
        if (!CanEditSchedule)
        {
            errorMessage = "No tienes permiso para editar registros del cronograma de mantenimiento.";
            return;
        }

        editingMaintenanceId = item.Id;

        formModel = new MaintenanceFormModel
        {
            MaintenanceNumber = item.MaintenanceNumber,
            Type = item.Type,
            Status = item.Status,
            ScheduledAt = item.ScheduledAt.Date,
            StartedAt = item.StartedAt?.Date,
            FinishedAt = item.FinishedAt?.Date,
            Provider = item.Provider,
            Technician = item.Technician,
            Description = item.Description,
            MaintenanceActivities = item.MaintenanceActivities,
            ExecutionNotes = item.ExecutionNotes,
            InvoiceNumber = item.InvoiceNumber,
            ResponsibleName = item.ResponsibleName,
            ResponsiblePosition = item.ResponsiblePosition,
            IsToolOperational = item.IsToolOperational ?? true,
            EvidenceDocumentIdText = item.EvidenceDocumentId?.ToString(),
            Cost = item.Cost,
            Result = item.Result
        };

        successMessage = null;
        errorMessage = null;
    }


    private void CancelEdit()
    {
        editingMaintenanceId = null;

        formModel = new MaintenanceFormModel
        {
            Type = "Preventive",
            Status = "Scheduled",
            ScheduledAt = DateTime.Today.AddDays(30),
            IsToolOperational = true
        };
    }
private async Task DeleteAsync(MaintenanceItemModel item)
    {
        if (!CanDeleteSchedule)
        {
            errorMessage = "No tienes permiso para desactivar registros del cronograma de mantenimiento.";
            return;
        }

        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            var client = HttpClientFactory.CreateClient("NaviApi");

            var deletedBy = string.IsNullOrWhiteSpace(AuthSession.UserName)
                ? "admin"
                : AuthSession.UserName;

            var response = await client.DeleteAsync($"api/tools/maintenance-schedule/{item.Id}?deletedBy={Uri.EscapeDataString(deletedBy)}");

            if (!response.IsSuccessStatusCode)
            {
                var detail = await response.Content.ReadAsStringAsync();
                errorMessage = $"No se pudo desactivar el mantenimiento. Código: {(int)response.StatusCode}. Detalle: {detail}";
                return;
            }

            successMessage = $"Mantenimiento desactivado correctamente: {item.MaintenanceNumber}.";

            if (editingMaintenanceId == item.Id)
            {
                CancelEdit();
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo desactivar el mantenimiento. Detalle: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

private void GoBack()
    {
        NavigationManager.NavigateTo("/maintenance-plans");
    }


    private string GetSaveButtonText()
    {
        if (isSaving)
        {
            return "Guardando...";
        }

        return editingMaintenanceId.HasValue
            ? "Actualizar mantenimiento"
            : "Crear mantenimiento";
    }

    private static string Show(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static string FormatDate(DateTime value)
    {
        return value.ToString("dd/MM/yyyy");
    }

    private static string FormatMoney(decimal? value)
    {
        return value.HasValue ? value.Value.ToString("C0") : "-";
    }

    private Guid? GetSelectedEvidenceDocumentId()
    {
        if (string.IsNullOrWhiteSpace(formModel.EvidenceDocumentIdText))
        {
            return null;
        }

        return Guid.TryParse(formModel.EvidenceDocumentIdText, out var documentId)
            ? documentId
            : null;
    }

    private string GetEvidenceFileName(Guid? documentId)
    {
        if (!documentId.HasValue)
        {
            return "-";
        }

        var document = documents.FirstOrDefault(x => x.Id == documentId.Value);

        return document is null
            ? "-"
            : document.FileName;
    }

    private string GetEvidenceDisplay(Guid? documentId)
    {
        var fileName = GetEvidenceFileName(documentId);

        return fileName == "-"
            ? "-"
            : fileName;
    }

    private bool HasEvidence(Guid? documentId)
    {
        return documentId.HasValue && documents.Any(x => x.Id == documentId.Value);
    }

    private string BuildEvidenceDownloadUrl(Guid? documentId)
    {
        if (!documentId.HasValue)
        {
            return "#";
        }

        var client = HttpClientFactory.CreateClient("NaviApi");
        var baseUrl = client.BaseAddress?.ToString().TrimEnd('/') ?? "http://localhost:5218";

        return $"{baseUrl}/api/tools/documents/{documentId.Value}/download";
    }

    private static string TranslateDocumentType(string? value)
    {
        return value switch
        {
            "TechnicalDocument" => "Documento técnico",
            "PhotographicRecord" => "Registro fotográfico",
            "MaintenanceEvidence" => "Evidencia mantenimiento",
            "Other" => "Otro",
            _ => value ?? "-"
        };
    }

    private static string TranslateType(string? value)
    {
        return value switch
        {
            "Preventive" => "Preventivo",
            "Corrective" => "Correctivo",
            "Calibration" => "Calibración",
            "Inspection" => "Inspección",
            _ => value ?? "-"
        };
    }

    private static string TranslateStatus(string? value)
    {
        return value switch
        {
            "Scheduled" => "Programado",
            "InProgress" => "En proceso",
            "Completed" => "Completado",
            "Cancelled" => "Cancelado",
            _ => value ?? "-"
        };
    }

    private sealed class MaintenanceFormModel
    {
        public string? MaintenanceNumber { get; set; }
        public string Type { get; set; } = "Preventive";
        public string Status { get; set; } = "Scheduled";
        public DateTime ScheduledAt { get; set; }
        public DateTime? StartedAt { get; set; }
        public DateTime? FinishedAt { get; set; }
        public string? Provider { get; set; }
        public string? Technician { get; set; }
        public string? Description { get; set; }
        public string? MaintenanceActivities { get; set; }
        public string? ExecutionNotes { get; set; }
        public string? InvoiceNumber { get; set; }
        public string? ResponsibleName { get; set; }
        public string? ResponsiblePosition { get; set; }
        public bool IsToolOperational { get; set; } = true;
                public string? EvidenceDocumentIdText { get; set; }
        public decimal? Cost { get; set; }
        public string? Result { get; set; }
    }

    private sealed class MaintenanceItemModel
    {
        public Guid Id { get; set; }
        public Guid ToolAssetId { get; set; }
        public string MaintenanceNumber { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public DateTime ScheduledAt { get; set; }
        public DateTime? StartedAt { get; set; }
        public DateTime? FinishedAt { get; set; }
        public string? Provider { get; set; }
        public string? Technician { get; set; }
        public string? Description { get; set; }
        public string? MaintenanceActivities { get; set; }
        public string? ExecutionNotes { get; set; }
        public string? InvoiceNumber { get; set; }
        public string? ResponsibleName { get; set; }
        public string? ResponsiblePosition { get; set; }
