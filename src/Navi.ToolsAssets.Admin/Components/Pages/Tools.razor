    private static string GetBrandModel(
        ToolListItem tool)
    {
        var values =
            new[]
            {
                tool.Brand,
                tool.Model
            }
            .Where(value =>
                !string.IsNullOrWhiteSpace(value))
            .Select(value =>
                value!.Trim());

        return string.Join(
            " · ",
            values);
    }

    private static string GetBranchLabel(
        ToolListItem tool)
    {
        var code =
            tool.BranchCode?.Trim();

        var name =
            tool.BranchName?.Trim();

        if (string.IsNullOrWhiteSpace(code) &&
            string.IsNullOrWhiteSpace(name))
        {
            return "-";
        }

        if (string.IsNullOrWhiteSpace(name))
        {
            return code ?? "-";
        }

        if (string.IsNullOrWhiteSpace(code) ||
            string.Equals(
                name,
                code,
                StringComparison.OrdinalIgnoreCase))
        {
            return name;
        }

        return name + " - " + code;
    }

    private static string GetCustodyLabel(
        ToolListItem tool)
    {
        if (!string.IsNullOrWhiteSpace(
                tool.CustodyStatus))
        {
            return NaviStatusLabels.ToSpanish(
                tool.CustodyStatus);
        }

        return string.IsNullOrWhiteSpace(
            tool.ResponsiblePersonName)
                ? "Sin responsable"
                : "Con responsable";
    }

