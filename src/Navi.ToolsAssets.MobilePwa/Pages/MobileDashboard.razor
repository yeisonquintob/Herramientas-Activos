    private bool MatchesDashboardToolFilters(MobileToolDto tool)
    {
        if (!string.IsNullOrWhiteSpace(filterBranchCode))
        {
            var branch = filterBranchCode;

            if (!ContainsText(tool.BranchCode, branch) &&
                !ContainsText(tool.BranchName, branch) &&
                !ContainsText(tool.LocationName, branch) &&
                !ContainsText(tool.InternalCode, branch) &&
                !ContainsText(tool.SerialNumber, branch))
            {
                return false;
            }
        }

        if (!string.IsNullOrWhiteSpace(filterOperationalStatus) &&
            !SameNormalized(tool.OperationalStatus, filterOperationalStatus))
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(filterText))
        {
            var text = filterText;

            if (!ContainsText(tool.InternalCode, text) &&
                !ContainsText(tool.Name, text) &&
                !ContainsText(tool.SerialNumber, text) &&
                !ContainsText(tool.FixedAssetCode, text) &&
                !ContainsText(tool.FenixCode, text) &&
                !ContainsText(tool.BranchCode, text) &&
                !ContainsText(tool.BranchName, text) &&
                !ContainsText(tool.LocationName, text) &&
                !ContainsText(tool.ResponsiblePersonName, text) &&
                !ContainsText(tool.PhysicalStatus, text) &&
                !ContainsText(tool.OperationalStatus, text) &&
                !ContainsText(GetStatusLabel(tool.OperationalStatus), text))
            {
                return false;
            }
        }

        return true;
    }

    private int CountDashboardStatus(string status)
    {
        return DashboardFilteredTools.Count(x => SameNormalized(x.OperationalStatus, status));
    }

    private static bool ContainsText(string? value, string? expected)
    {
        var source = Normalize(value);
        var filter = Normalize(expected);

        return !string.IsNullOrWhiteSpace(source) &&
               !string.IsNullOrWhiteSpace(filter) &&
               source.Contains(filter, StringComparison.OrdinalIgnoreCase);
    }
