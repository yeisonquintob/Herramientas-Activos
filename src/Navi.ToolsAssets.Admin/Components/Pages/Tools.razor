        return string.IsNullOrWhiteSpace(value)
            ? "-"
            : value.Trim();
    }

    private static string GetStatusLabel(
        string? status)
    {
        return status switch
        {
            "Available" =>
                "Disponible",

            "Assigned" =>
                "Asignada",

            "Loaned" =>
                "Prestada",

            "InMaintenance" =>
                "En mantenimiento",

            "Damaged" =>
                "Dañada",

            "NotSuitable" =>
                "No apta",

            "PendingValidation" =>
                "Pendiente validación",

            "Inconsistent" =>
                "Inconsistente",

            "NotLocated" =>
                "No localizada",

            "PendingDisposal" =>
                "Pendiente de baja",

            "Disposed" =>
                "Dada de baja",

            _ =>
                NaviStatusLabels.ToSpanish(
                    status)
        };
    }

