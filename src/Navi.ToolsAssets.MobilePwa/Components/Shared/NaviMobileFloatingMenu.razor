@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing

@implements IDisposable

@inject MobileAuthSessionService Auth
@inject NavigationManager Navigation

@if (CanShowMenu && MenuGroups.Any())
{
    <button type="button"
            class="navi-mobile-floating-menu-trigger navi-mobile-floating-menu-trigger-aligned-v4 @(isOpen ? "is-open" : "")"
            aria-label="Abrir menú operativo"
            aria-expanded="@isOpen"
            @onclick="ToggleMenu">
        <span></span>
        <span></span>
        <span></span>
    </button>

    @if (isOpen)
    {
        <div class="navi-mobile-floating-menu-backdrop"
             aria-hidden="true"
             @onclick="CloseMenu"></div>

        <aside class="navi-mobile-floating-menu-panel navi-mobile-floating-menu-panel-v3"
               role="dialog"
               aria-modal="true"
               aria-label="Menú operativo">
            <div class="navi-mobile-floating-menu-head">
                <div class="navi-mobile-floating-menu-head-copy">
                    <span>MENÚ OPERATIVO</span>
                    <strong>@Display(Auth.CurrentUser?.DisplayName)</strong>
                    <small>@Display(Auth.CurrentUser?.BranchName)</small>
                </div>

                <button type="button"
                        class="navi-mobile-floating-menu-close"
                        aria-label="Cerrar menú operativo"
                        @onclick="CloseMenu">
                    ×
                </button>
            </div>

            <div class="navi-mobile-floating-menu-list">
                @foreach (var group in MenuGroups)
                {
                    <section class="navi-mobile-floating-menu-group">
                        <div class="navi-mobile-floating-menu-group-title">@group.Title</div>

                        <div class="navi-mobile-floating-menu-group-items">
                            @foreach (var item in group.Items)
                            {
                                var active = IsActive(item.Url);

                                <button type="button"
                                        class="@GetItemClass(item.IconKey, active)"
                                        data-navi-floating-menu-item="white"
                                        style="background:#ffffff !important;background-color:#ffffff !important;background-image:none !important;color:#101828 !important;"
                                        @onclick="() => NavigateTo(item.Url)">
                                    <span class="@GetIconClass(item.IconKey)">@GetMenuSymbol(item.IconKey)</span>

                                    <span class="navi-mobile-floating-menu-text">
                                        <strong>@item.Title</strong>
                                        <small>@item.Description</small>
                                    </span>
                                </button>
                            }
                        </div>
                    </section>
                }
            </div>
        </aside>
    }
}

<style>
    html body .navi-mobile-floating-menu-panel-v3 .navi-mobile-floating-menu-item,
    html body .navi-mobile-floating-menu-panel-v3 button.navi-mobile-floating-menu-item,
    html body .navi-mobile-floating-menu-panel-v3 .navi-mobile-floating-menu-group-items > button {
        background: #ffffff !important;
        background-color: #ffffff !important;
        background-image: none !important;
        color: #101828 !important;
        border: 1px solid #dfe7f1 !important;
        box-shadow: 0 .06rem .18rem rgba(15, 23, 42, .035) !important;
        filter: none !important;
        opacity: 1 !important;
    }

    html body .navi-mobile-floating-menu-panel-v3 .navi-mobile-floating-menu-item:hover,
    html body .navi-mobile-floating-menu-panel-v3 .navi-mobile-floating-menu-item:focus,
    html body .navi-mobile-floating-menu-panel-v3 button.navi-mobile-floating-menu-item:hover,
    html body .navi-mobile-floating-menu-panel-v3 button.navi-mobile-floating-menu-item:focus {
        background: #ffffff !important;
        background-color: #ffffff !important;
        background-image: none !important;
        color: #101828 !important;
        border-color: #8a179d !important;
        box-shadow:
            0 .14rem .42rem rgba(15, 23, 42, .08),
            0 0 0 2px rgba(138, 23, 157, .10) !important;
        outline: none !important;
    }

    html body .navi-mobile-floating-menu-panel-v3 .navi-mobile-floating-menu-item.active,
    html body .navi-mobile-floating-menu-panel-v3 button.navi-mobile-floating-menu-item.active {
        background: #ffffff !important;
        background-color: #ffffff !important;
        background-image: none !important;
        color: #101828 !important;
        border-color: #8a179d !important;
        box-shadow:
            0 .16rem .48rem rgba(15, 23, 42, .09),
            0 0 0 2px rgba(138, 23, 157, .12) !important;
    }

    html body .navi-mobile-floating-menu-panel-v3 .navi-mobile-floating-menu-text strong {
        color: #101828 !important;
        opacity: 1 !important;
    }

    html body .navi-mobile-floating-menu-panel-v3 .navi-mobile-floating-menu-text small {
        color: #667085 !important;
        opacity: 1 !important;
    }
</style>

<!-- NAVI FLOATING MENU FORCE WHITE FINAL START -->
