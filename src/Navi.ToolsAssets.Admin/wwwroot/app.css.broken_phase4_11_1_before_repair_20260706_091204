    overflow-x: auto !important;
    overflow-y: visible !important;
    border-radius: var(--navi-table-radius) !important;
    scrollbar-width: thin !important;
    scrollbar-color: rgba(118, 0, 143, .35) transparent !important;
}

.navi-content :where(
    .table-responsive,
    .table-wrapper,
    .data-table-wrapper,
    .navi-table-wrapper,
    .results-table,
    .settings-table,
    .reports-table,
    .documents-table,
    .inventory-table,
    .history-table,
    .assignment-table,
    .maintenance-table,
    .physical-count-table,
    .reconciliation-table
