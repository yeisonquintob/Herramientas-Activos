    private bool OperationalStatusReasonRequired =>
        tool is not null &&
        RequiresReasonForStatusChange(
            tool.OperationalStatus,
            selectedOperationalStatus);

    private async Task ChangeOperationalStatusAsync()
    {
        if (!CanChangeOperationalStatus)
        {
            DenyAction(
                "cambiar el estado operativo del activo");

            return;
        }

        if (tool is null)
        {
            return;
        }

        var currentStatus =
            tool.OperationalStatus?.Trim()
            ?? string.Empty;

        var targetStatus =
            selectedOperationalStatus?.Trim()
            ?? string.Empty;

        var reason =
            actionObservation?.Trim()
            ?? string.Empty;

        actionMessage = null;
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(targetStatus))
        {
            errorMessage =
                "Debes seleccionar el nuevo estado operativo.";

            return;
        }

        if (currentStatus.Equals(
                targetStatus,
                StringComparison.OrdinalIgnoreCase))
        {
            actionMessage =
                $"La herramienta ya se encuentra en estado "
                + $"{GetStatusLabel(targetStatus)}.";

            return;
        }

        if (
            RequiresReasonForStatusChange(
                currentStatus,
                targetStatus)
            &&
            string.IsNullOrWhiteSpace(reason)
        )
        {
            errorMessage =
                $"Para cambiar la herramienta de "
                + $"{GetStatusLabel(currentStatus)} a "
                + $"{GetStatusLabel(targetStatus)} debes indicar "
                + "una razón en el campo Observación.";

            return;
        }

        try
        {
            isSaving = true;

            var client =
                HttpClientFactory.CreateClient(
                    "NaviApi");

            var payload = new
            {
                operationalStatus = targetStatus,
                changedBy = "yquinto",
                updatedBy = "yquinto",
                reason,
                observation = reason
            };

            var response =
                await client.PatchAsJsonAsync(
                    $"api/tools/{tool.Id}/operational-status",
                    payload);

            if (!response.IsSuccessStatusCode)
            {
                var detail =
                    await ReadApiErrorMessageAsync(
                        response);

                errorMessage =
                    $"No se pudo cambiar el estado. "
                    + $"Código: {(int)response.StatusCode}. "
                    + detail;

                return;
            }

            actionMessage =
                "Estado operativo actualizado correctamente.";

            actionObservation =
                string.Empty;

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"No se pudo cambiar el estado. "
                + $"Detalle: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static bool RequiresReasonForStatusChange(
        string? currentStatus,
        string? targetStatus)
    {
        var current =
            currentStatus?.Trim()
            ?? string.Empty;

        var target =
            targetStatus?.Trim()
            ?? string.Empty;

        if (
            target.Equals(
                "Damaged",
                StringComparison.OrdinalIgnoreCase)
            ||
            target.Equals(
                "NotSuitable",
                StringComparison.OrdinalIgnoreCase)
            ||
            target.Equals(
                "InMaintenance",
                StringComparison.OrdinalIgnoreCase)
            ||
            target.Equals(
                "PendingDisposal",
                StringComparison.OrdinalIgnoreCase)
            ||
            target.Equals(
                "Disposed",
                StringComparison.OrdinalIgnoreCase)
        )
        {
            return true;
        }

        return
            target.Equals(
                "Available",
                StringComparison.OrdinalIgnoreCase)
            &&
            IsBlockedForDirectAvailability(
                current);
    }

    private static bool IsBlockedForDirectAvailability(
        string? status)
    {
        var value =
            status?.Trim()
            ?? string.Empty;

        return
            value.Equals(
                "Damaged",
                StringComparison.OrdinalIgnoreCase)
            ||
            value.Equals(
                "NotSuitable",
                StringComparison.OrdinalIgnoreCase)
            ||
            value.Equals(
                "InMaintenance",
                StringComparison.OrdinalIgnoreCase)
            ||
            value.Equals(
                "PendingDisposal",
                StringComparison.OrdinalIgnoreCase);
    }

    private static async Task<string>
        ReadApiErrorMessageAsync(
            System.Net.Http.HttpResponseMessage response)
    {
        var content =
            await response.Content.ReadAsStringAsync();

        if (string.IsNullOrWhiteSpace(content))
        {
            return
                "La API no devolvió información adicional.";
        }

        try
        {
            using var document =
                JsonDocument.Parse(content);

            var root =
                document.RootElement;

            if (
                root.ValueKind
                    == JsonValueKind.Object
                &&
                root.TryGetProperty(
                    "message",
                    out var message)
                &&
                message.ValueKind
                    == JsonValueKind.String
            )
            {
                return
                    message.GetString()
                    ?? content;
            }

            if (
                root.ValueKind
                    == JsonValueKind.Object
                &&
                root.TryGetProperty(
                    "Message",
                    out var upperMessage)
                &&
                upperMessage.ValueKind
                    == JsonValueKind.String
            )
            {
                return
                    upperMessage.GetString()
                    ?? content;
            }
        }
        catch (JsonException)
        {
            // La respuesta no es JSON.
        }

        return content;
    }

