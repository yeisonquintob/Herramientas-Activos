@page "/tools/{ToolId:guid}/technical-life-record/edit"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Navi.ToolsAssets.Admin.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<PageTitle>Editar datos técnicos - NAVI Herramientas</PageTitle>

<PermissionGuard Permission="TechnicalLifeRecord.Edit" ModuleName="Editar hoja de vida">

<div class="navi-life-record-subpage navi-life-record-subpage--technical-edit">



@* NAVI LIFE RECORD SUBPAGE STANDARD V76 TECHNICAL-EDIT START *@

<NaviPageHero
    Pill="ACTIVOS FIJOS"
    Title="Editar datos técnicos"
    Description="Actualiza la información técnica, garantía, vida útil y plan de mantenimiento de la herramienta." />

<NaviKpiToolbar
    Class="navi-life-record-subpage-toolbar
           navi-life-record-subpage-toolbar--technical-edit"
    Refresh="LoadAsync"
    IsRefreshing="isLoading"
    RefreshTitle="Actualizar datos técnicos"
    RefreshAriaLabel="Actualizar datos técnicos">

    <div class="navi-life-record-subpage-toolbar__body">

        <NaviKpiGrid
            Columns="3"
            Compact="true"
            Dividers="true"
            Class="navi-life-record-subpage-kpis">

            <NaviKpiCard
                Title="Código interno"
                Description="Identificación del activo"
                Value="@internalCode"
                Tone="neutral"
                Compact="true">

                <IconContent>
                    <NaviKpiIcon Name="inventory" />
                </IconContent>

            </NaviKpiCard>

            <NaviKpiCard
                Title="Herramienta / activo"
                Description="Hoja de vida técnica"
                Value="@toolName"
                Tone="soft"
                Compact="true"
                     Class="navi-life-record-kpi-asset">

                <IconContent>
                    <NaviKpiIcon Name="document" />
                </IconContent>

            </NaviKpiCard>

            <NaviKpiCard
                Title="Modo"
                Description="Datos técnicos controlados"
                Value="Edición"
                Tone="warning"
                Compact="true">

                <IconContent>
                    <NaviKpiIcon Name="wrench" />
                </IconContent>

            </NaviKpiCard>

        </NaviKpiGrid>

        <a class="navi-life-record-subpage-back"
           href="@($"/tools/{ToolId}/technical-life-record")"
           aria-label="Volver a hoja de vida"
           data-ntx-tone="secondary">

            <span aria-hidden="true">←</span>
            <span>Volver a hoja de vida</span>

        </a>

    </div>

</NaviKpiToolbar>

@* NAVI LIFE RECORD SUBPAGE STANDARD V76 TECHNICAL-EDIT END *@

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (isLoading && editModel is null)
{
    <div class="alert alert-info" role="status" aria-busy="true">
        Cargando datos técnicos...
    </div>
}
else if (editModel is not null)
{

    <EditForm Model="editModel" OnValidSubmit="SaveAsync">
        <div class="technical-edit-grid">
            <section class="life-record-section">
                <div class="section-title">
                    <span>1</span>
                    <h2>Información del equipo</h2>
                </div>

                <div class="edit-form-grid">
                    <div>
                        <label for="navi-technicalliferecordedit-control-001">Marca</label>
                        <InputText class="form-control" @bind-Value="editModel.Brand" id="navi-technicalliferecordedit-control-001" />
                    </div>

                    <div>
                        <label for="navi-technicalliferecordedit-control-002">Modelo</label>
                        <InputText class="form-control" @bind-Value="editModel.Model" id="navi-technicalliferecordedit-control-002" />
                    </div>

                    <div>
                        <label for="navi-technicalliferecordedit-control-003">Serial</label>
                        <InputText class="form-control" @bind-Value="editModel.SerialNumber" id="navi-technicalliferecordedit-control-003" />
                    </div>

                    <div>
                        <label for="navi-technicalliferecordedit-control-004">Activo fijo</label>
                        <InputText class="form-control" @bind-Value="editModel.FixedAssetCode" id="navi-technicalliferecordedit-control-004" />
                    </div>

                    <div>
                        <label for="navi-technicalliferecordedit-control-005">Código Fenix365</label>
                        <InputText class="form-control" @bind-Value="editModel.FenixCode" id="navi-technicalliferecordedit-control-005" />
                    </div>

                    <div>
                        <label for="navi-technicalliferecordedit-control-006">Fecha adquisición</label>
                        <InputDate class="form-control" @bind-Value="editModel.AcquisitionDate" id="navi-technicalliferecordedit-control-006" />
                    </div>
                </div>
            </section>

            <section class="life-record-section">
                <div class="section-title">
                    <span>2</span>
                    <h2>Especificaciones técnicas</h2>
                </div>

                <div class="edit-form-grid">
                    <div>
                        <label for="navi-technicalliferecordedit-control-007">Voltaje</label>
                        <InputText class="form-control" @bind-Value="editModel.Voltage" id="navi-technicalliferecordedit-control-007" />
                    </div>

                    <div>
                        <label for="navi-technicalliferecordedit-control-008">Capacidad de carga</label>
                        <InputText class="form-control" @bind-Value="editModel.LoadCapacity" id="navi-technicalliferecordedit-control-008" />
                    </div>

                    <div>
                        <label for="navi-technicalliferecordedit-control-009">Proveedor</label>
                        <InputText class="form-control" @bind-Value="editModel.Provider" id="navi-technicalliferecordedit-control-009" />
                    </div>

                    <div class="form-check-row">
                        <InputCheckbox class="form-check-input" @bind-Value="editModel.RequiresMaintenance" name="navi-technicalliferecordedit-field-001" id="navi-technicalliferecordedit-control-018" />
                        <label for="navi-technicalliferecordedit-control-018">Requiere mantenimiento</label>
                    </div>

                    <div class="form-check-row">
                        <InputCheckbox class="form-check-input" @bind-Value="editModel.RequiresPreOperationalCheck" name="navi-technicalliferecordedit-field-002" id="navi-technicalliferecordedit-control-019" />
                        <label for="navi-technicalliferecordedit-control-019">Requiere preoperacional</label>
                    </div>

                    <div class="form-check-row">
                        <InputCheckbox class="form-check-input" @bind-Value="editModel.RequiresCertification" name="navi-technicalliferecordedit-field-003" id="navi-technicalliferecordedit-control-020" />
                        <label for="navi-technicalliferecordedit-control-020">Requiere certificación</label>
                    </div>

                    <div>
                        <label for="navi-technicalliferecordedit-control-010">Fecha vencimiento certificación</label>
                        <InputDate class="form-control" @bind-Value="editModel.CertificationExpirationDate" id="navi-technicalliferecordedit-control-010" />
                    </div>
                </div>
            </section>
        </div>

        <div class="technical-edit-grid">
            <section class="life-record-section">
                <div class="section-title">
                    <span>3</span>
                    <h2>Garantía</h2>
                </div>

                <div class="edit-form-grid">
                    <div class="form-check-row">
                        <InputCheckbox class="form-check-input" @bind-Value="editModel.HasWarranty" name="navi-technicalliferecordedit-field-004" id="navi-technicalliferecordedit-control-021" />
                        <label for="navi-technicalliferecordedit-control-021">Tiene garantía</label>
                    </div>

                    <div>
                        <label for="navi-technicalliferecordedit-control-011">Tipo de garantía</label>
                        <InputText class="form-control" @bind-Value="editModel.WarrantyType" id="navi-technicalliferecordedit-control-011" />
                    </div>
                </div>
            </section>

            <section class="life-record-section">
                <div class="section-title">
                    <span>4</span>
                    <h2>Vida útil</h2>
                </div>

                <div class="edit-form-grid">
                    <div>
                        <label for="navi-technicalliferecordedit-control-012">Fecha inicial vida útil</label>
                        <InputDate class="form-control" @bind-Value="editModel.UsefulLifeStartDate" id="navi-technicalliferecordedit-control-012" />
                    </div>

                    <div>
                        <label for="navi-technicalliferecordedit-control-013">Vida útil meses</label>
                        <InputNumber class="form-control" @bind-Value="editModel.UsefulLifeMonths" id="navi-technicalliferecordedit-control-013" />
                    </div>

                    <div>
                        <label for="navi-technicalliferecordedit-control-014">Vida útil días</label>
                        <InputNumber class="form-control" @bind-Value="editModel.UsefulLifeDays" id="navi-technicalliferecordedit-control-014" />
                    </div>
                </div>
            </section>
        </div>

        <section class="life-record-section">
            <div class="section-title">
                <span>5</span>
                <h2>Plan de mantenimiento</h2>
            </div>

            <div class="edit-form-grid three-columns">
                <div>
                    <label for="navi-technicalliferecordedit-control-015">Último mantenimiento</label>
                    <InputDate class="form-control" @bind-Value="editModel.LastMaintenanceDate" id="navi-technicalliferecordedit-control-015" />
                </div>

                <div>
                    <label for="navi-technicalliferecordedit-control-016">Próximo mantenimiento</label>
                    <InputDate class="form-control" @bind-Value="editModel.NextMaintenanceDate" id="navi-technicalliferecordedit-control-016" />
                </div>

                <div>
                    <label for="navi-technicalliferecordedit-control-017">Periodicidad meses</label>
                    <InputNumber class="form-control" @bind-Value="editModel.MaintenancePeriodMonths" id="navi-technicalliferecordedit-control-017" />
                </div>
            </div>
        </section>

        <section class="life-record-section">
            <div class="section-title">
                <span>6</span>
                <h2>Observación del cambio</h2>
            </div>

            <InputTextArea class="form-control technical-observation"
                           @bind-Value="editModel.Observation"
                           placeholder="Describe el motivo de la actualización..." name="navi-technicalliferecordedit-field-005" />
        </section>

        <div class="technical-edit-actions">
            <button type="button" class="btn btn-outline-secondary" @onclick="GoBack" data-ntx-tone="secondary" >
                Cancelar
            </button>

            <button type="submit" class="btn ntx-btn--operation" disabled="@isSaving" data-ntx-tone="affirmative" >
                @(isSaving ? "Guardando..." : "Guardar datos técnicos")
            </button>
        </div>
    </EditForm>
}



</div>

</PermissionGuard>

@code {
    [Parameter]
    public Guid ToolId { get; set; }

    private bool isLoading;
    private bool isSaving;
    private string? errorMessage;
    private string? successMessage;
    private string internalCode = string.Empty;
    private string toolName = string.Empty;
    private TechnicalEditModel? editModel;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            successMessage = null;

            var client = HttpClientFactory.CreateClient("NaviApi");

            var record = await client.GetFromJsonAsync<TechnicalLifeRecordForEditModel>($"api/tools/{ToolId}/technical-life-record");

            if (record is null)
            {
                errorMessage = "No se encontró información técnica para la herramienta.";
                return;
            }

            internalCode = record.Summary.InternalCode;
            toolName = record.Summary.Name;

            editModel = new TechnicalEditModel
            {
                Brand = record.EquipmentInformation.Brand,
                Model = record.EquipmentInformation.Model,
                SerialNumber = record.EquipmentInformation.SerialNumber,
                FixedAssetCode = record.EquipmentInformation.FixedAssetCode,
                FenixCode = record.EquipmentInformation.FenixCode,
                AcquisitionDate = record.EquipmentInformation.AcquisitionDate?.Date,

                Voltage = record.TechnicalSpecifications.Voltage,
                LoadCapacity = record.TechnicalSpecifications.LoadCapacity,
                Provider = record.TechnicalSpecifications.Provider,
                RequiresMaintenance = record.TechnicalSpecifications.RequiresMaintenance,
                RequiresPreOperationalCheck = record.TechnicalSpecifications.RequiresPreOperationalCheck,
                RequiresCertification = record.TechnicalSpecifications.RequiresCertification,
                CertificationExpirationDate = record.TechnicalSpecifications.CertificationExpirationDate?.Date,

                HasWarranty = record.Warranty.HasWarranty,
                WarrantyType = record.Warranty.WarrantyType,

                UsefulLifeStartDate = record.UsefulLife.StartDate?.Date,
                UsefulLifeMonths = record.UsefulLife.UsefulLifeMonths,
                UsefulLifeDays = record.UsefulLife.UsefulLifeDays,

                LastMaintenanceDate = record.MaintenancePlan.LastMaintenanceDate?.Date,
                NextMaintenanceDate = record.MaintenancePlan.NextMaintenanceDate?.Date,
                MaintenancePeriodMonths = record.MaintenancePlan.MaintenancePeriodMonths,

                UpdatedBy = "yquinto",
                Observation = "Actualización de datos técnicos desde Admin."
            };
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar la información técnica. Valida que la API esté activa. Detalle: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (editModel is null)
        {
            return;
        }

        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            var client = HttpClientFactory.CreateClient("NaviApi");

            var response = await client.PatchAsJsonAsync($"api/tools/{ToolId}/technical-data", editModel);

            if (!response.IsSuccessStatusCode)
            {
                var detail = await response.Content.ReadAsStringAsync();
                errorMessage = $"No se pudieron actualizar los datos técnicos. Código: {(int)response.StatusCode}. Detalle: {detail}";
                return;
            }

            successMessage = "Datos técnicos actualizados correctamente.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudieron actualizar los datos técnicos. Detalle: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo($"/tools/{ToolId}/technical-life-record");
    }

    private sealed class TechnicalEditModel
    {
        public string? Brand { get; set; }
        public string? Model { get; set; }
        public string? SerialNumber { get; set; }
        public string? FixedAssetCode { get; set; }
        public string? FenixCode { get; set; }
        public DateTime? AcquisitionDate { get; set; }
        public string? Voltage { get; set; }
        public string? LoadCapacity { get; set; }
        public string? Provider { get; set; }
        public bool HasWarranty { get; set; }
        public string? WarrantyType { get; set; }
        public DateTime? UsefulLifeStartDate { get; set; }
        public int? UsefulLifeMonths { get; set; }
        public int? UsefulLifeDays { get; set; }
        public DateTime? LastMaintenanceDate { get; set; }
        public DateTime? NextMaintenanceDate { get; set; }
        public int? MaintenancePeriodMonths { get; set; }
        public bool RequiresMaintenance { get; set; }
        public bool RequiresPreOperationalCheck { get; set; }
        public bool RequiresCertification { get; set; }
        public DateTime? CertificationExpirationDate { get; set; }
        public string? UpdatedBy { get; set; }
        public string? Observation { get; set; }
    }

    private sealed class TechnicalLifeRecordForEditModel
    {
        public SummaryInfo Summary { get; set; } = new();
        public EquipmentInfo EquipmentInformation { get; set; } = new();
        public TechnicalInfo TechnicalSpecifications { get; set; } = new();
        public WarrantyInfo Warranty { get; set; } = new();
        public UsefulLifeInfo UsefulLife { get; set; } = new();
        public MaintenancePlanInfo MaintenancePlan { get; set; } = new();
    }

    private sealed class SummaryInfo
    {
        public string InternalCode { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
    }

    private sealed class EquipmentInfo
    {
        public string? Brand { get; set; }
        public string? Model { get; set; }
        public string? SerialNumber { get; set; }
        public string? FixedAssetCode { get; set; }
        public string? FenixCode { get; set; }
        public DateTime? AcquisitionDate { get; set; }
    }

    private sealed class TechnicalInfo
    {
        public string? Voltage { get; set; }
        public string? LoadCapacity { get; set; }
        public string? Provider { get; set; }
        public bool RequiresMaintenance { get; set; }
        public bool RequiresPreOperationalCheck { get; set; }
        public bool RequiresCertification { get; set; }
        public DateTime? CertificationExpirationDate { get; set; }
    }

    private sealed class WarrantyInfo
    {
        public bool HasWarranty { get; set; }
        public string? WarrantyType { get; set; }
    }

    private sealed class UsefulLifeInfo
    {
        public DateTime? StartDate { get; set; }
        public int? UsefulLifeMonths { get; set; }
        public int? UsefulLifeDays { get; set; }
    }

    private sealed class MaintenancePlanInfo
    {
        public DateTime? LastMaintenanceDate { get; set; }
        public DateTime? NextMaintenanceDate { get; set; }
        public int? MaintenancePeriodMonths { get; set; }
    }
}
