                <div><span class="navi-data-label">Responsable</span><strong>@Show(Text("EquipmentInformation", "ResponsibleName"))</strong></div>
                <div><span class="navi-data-label">Tipo</span><strong>@Show(Text("EquipmentInformation", "ToolTypeName"))</strong></div>
                <div><span class="navi-data-label">Categoría</span><strong>@Show(Text("EquipmentInformation", "ToolCategoryName"))</strong></div>
                <div><span class="navi-data-label">Unidad</span><strong>@Show(Text("EquipmentInformation", "UnitOfMeasure"))</strong></div>
                <div><span class="navi-data-label">Cantidad</span><strong>@Show(Text("EquipmentInformation", "Quantity"))</strong></div>
            </div>
