@using Microsoft.AspNetCore.Components

<span class="@CssClass"
      aria-hidden="true"
      data-kpi-icon="@NormalizedName">

    <svg viewBox="0 0 24 24"
         focusable="false">

        @switch (NormalizedName)
        {
            case "users":
                <circle cx="9" cy="7" r="3"></circle>
                <path d="M3.5 20v-2a4.5 4.5 0 0 1 4.5-4.5h2a4.5 4.5 0 0 1 4.5 4.5v2"></path>
                <path d="M16 4.5a3 3 0 0 1 0 5.8"></path>
                <path d="M17 13.5a4 4 0 0 1 3.5 4V20"></path>
                break;

            case "inventory":
                <path d="M4 8h16v11H4z"></path>
                <path d="M8 8V5h8v3"></path>
                <path d="M9 13h6"></path>
                break;

            case "check":
                <circle cx="12" cy="12" r="9"></circle>
                <path d="m8 12 2.6 2.7L16.5 9"></path>
                break;

            case "clock":
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 7v5l3 2"></path>
                break;

            case "alert":
                <path d="M10.3 4.3 2.8 17.2A2 2 0 0 0 4.5 20h15a2 2 0 0 0 1.7-2.8L13.7 4.3a2 2 0 0 0-3.4 0Z"></path>
                <path d="M12 9v4"></path>
                <path d="M12 17h.01"></path>
                break;

            case "progress":
                <path d="M21 12a9 9 0 1 1-3-6.7"></path>
                <path d="M21 4v6h-6"></path>
                <path d="m8.5 12 2.2 2.2 4.8-5"></path>
                break;

            case "bell":
                <path d="M18 8a6 6 0 0 0-12 0c0 6-2.5 7-2.5 9h17c0-2-2.5-3-2.5-9"></path>
                <path d="M10 21h4"></path>
                break;

            case "location":
                <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                <circle cx="12" cy="10" r="2.5"></circle>
                break;

            case "transfer":
                <path d="M4 8h13"></path>
                <path d="m14 5 3 3-3 3"></path>
                <path d="M20 16H7"></path>
                <path d="m10 13-3 3 3 3"></path>
                break;

            case "document":
                <path d="M6 3h8l4 4v14H6z"></path>
                <path d="M14 3v5h5"></path>
                <path d="M9 13h6"></path>
                <path d="M9 17h6"></path>
                break;

            case "wrench":
                <path d="M14.7 6.3a4 4 0 0 0-5 5L4 17l3 3 5.7-5.7a4 4 0 0 0 5-5l-2.5 2.5-3-3z"></path>
                break;

            case "cart":
                <path d="M3 4h2l2 11h10l3-7H6"></path>
                <circle cx="9" cy="19" r="1.5"></circle>
                <circle cx="17" cy="19" r="1.5"></circle>
                break;

            case "calendar":
                <rect x="4" y="5" width="16" height="15" rx="2"></rect>
                <path d="M8 3v4M16 3v4M4 10h16"></path>
                break;

            case "report":
                <path d="M5 19V9"></path>
                <path d="M12 19V5"></path>
                <path d="M19 19v-7"></path>
                <path d="M3 19h18"></path>
                break;

            default:
                <path d="M4 15a8 8 0 0 1 16 0"></path>
                <path d="m12 15 4-4"></path>
                <path d="M6 19h12"></path>
                break;
        }
    </svg>
</span>

@code {
    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private string NormalizedName =>
        Normalize(Name);

    private string CssClass =>
        string.IsNullOrWhiteSpace(Class)
            ? "navi-kpi-icon"
            : Class.Trim();

    private static string Normalize(
        string? value)
    {
        return value?.Trim().ToLowerInvariant() switch
        {
            "user" or "users" or "person" or
            "people" or "participant" or
            "responsible" => "users",

            "asset" or "assets" or "tool" or
            "tools" or "inventory" or
            "briefcase" => "inventory",

            "success" or "available" or
            "approved" or "completed" or
            "check" => "check",

            "pending" or "time" or
            "clock" or "history" => "clock",

            "danger" or "damage" or
            "difference" or "warning-alert" or
            "alert" => "alert",

            "advance" or "progress" or
            "percentage" => "progress",

            "notification" or "novelty" or
            "bell" => "bell",

            "branch" or "site" or
            "location" => "location",

            "assignment" or "loan" or
            "movement" or "transfer" => "transfer",

            "file" or "document" or
            "life-record" => "document",

            "maintenance" or "repair" or
            "wrench" => "wrench",

            "purchase" or "cost" or
            "cart" => "cart",

            "plan" or "date" or
            "calendar" => "calendar",

            "chart" or "report" => "report",

            _ => "metric"
        };
    }
}
