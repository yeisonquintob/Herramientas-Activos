@using Microsoft.AspNetCore.Components

<section @attributes="AdditionalAttributes"
         class="@CssClass"
         data-ntx-component="filter-bar"
         role="search"
         aria-label="@AriaLabel">
    @ChildContent
</section>

@code {
    [Parameter] public string AriaLabel { get; set; } = "Filtros";
    [Parameter] public bool Compact { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass =>
        string.Join(
            " ",
            new[]
            {
                "navi-filter-bar",
                Compact ? "is-compact" : null,
                string.IsNullOrWhiteSpace(Class) ? null : Class.Trim()
            }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
