    // NAVI ADMIN DASHBOARD COSTS RESTORE START
    private async Task<decimal> LoadNaviDashboardCostTotalAsync(HttpClient client, string endpoint)
    {
        try
        {
            using var response = await client.GetAsync(endpoint);

            if (!response.IsSuccessStatusCode)
            {
                return 0;
            }

            await using var stream = await response.Content.ReadAsStreamAsync();
            using var document = await JsonDocument.ParseAsync(stream);

            if (document.RootElement.ValueKind != JsonValueKind.Array)
            {
                return 0;
            }

            decimal total = 0;

            foreach (var item in document.RootElement.EnumerateArray())
            {
                if (item.ValueKind != JsonValueKind.Object)
                {
                    continue;
                }

                if (!MatchesNaviDashboardCostFilters(item))
                {
                    continue;
                }

                var status = GetNaviDashboardJsonString(
                    item,
                    "Status",
                    "status",
                    "State",
                    "state",
                    "StatusLabel",
                    "statusLabel",
                    "StatusText",
                    "statusText",
                    "RequestStatus",
                    "requestStatus");

                if (!IsNaviDashboardPositiveCostStatus(status))
                {
                    continue;
                }

                var costText = GetNaviDashboardJsonString(
                    item,
                    "EstimatedCostText",
                    "estimatedCostText",
                    "EstimatedCost",
                    "estimatedCost",
                    "Cost",
                    "cost",
                    "Total",
                    "total",
                    "TotalCost",
                    "totalCost",
                    "TotalBeforeTax",
                    "totalBeforeTax",
                    "PriceBeforeVat",
                    "priceBeforeVat",
                    "Amount",
                    "amount",
                    "Value",
                    "value");

                var cost = ParseNaviDashboardMoney(costText);

                if (cost > 0)
                {
                    total += cost;
                }
            }

            return total;
        }
        catch
        {
            return 0;
        }
    }

    private bool MatchesNaviDashboardCostFilters(JsonElement item)
    {
        if (!string.IsNullOrWhiteSpace(filterBranchCode))
        {
            var branch = NormalizeNaviDashboardCostText(filterBranchCode);

            if (!NaviDashboardJsonContainsAny(
                item,
                branch,
                "BranchCode",
                "branchCode",
                "BranchName",
                "branchName",
                "Sede",
                "sede",
                "ToolBranchCode",
                "toolBranchCode",
                "ToolBranchName",
                "toolBranchName"))
            {
                return false;
            }
        }

        if (!string.IsNullOrWhiteSpace(filterOperationalStatus))
        {
            var status = NormalizeNaviDashboardCostText(filterOperationalStatus);

            if (!NaviDashboardJsonContainsAny(
                item,
                status,
                "Status",
                "status",
                "State",
                "state",
                "StatusLabel",
                "statusLabel",
                "StatusText",
                "statusText",
                "RequestStatus",
                "requestStatus"))
            {
                return false;
            }
        }

        if (!string.IsNullOrWhiteSpace(filterText))
        {
            var text = NormalizeNaviDashboardCostText(filterText);

            if (!NaviDashboardJsonContainsAny(
                item,
                text,
                "RequestNumber",
                "requestNumber",
                "MaintenanceNumber",
                "maintenanceNumber",
                "PurchaseNumber",
                "purchaseNumber",
                "ToolInternalCode",
                "toolInternalCode",
                "InternalCode",
                "internalCode",
                "ToolName",
                "toolName",
                "Name",
                "name",
                "ItemCode",
                "itemCode",
                "ItemName",
                "itemName",
                "ItemDescription",
                "itemDescription",
                "RequestedByUserName",
                "requestedByUserName",
                "RequestedByResponsiblePersonName",
                "requestedByResponsiblePersonName",
                "ResponsiblePersonName",
                "responsiblePersonName",
                "PreparedBy",
                "preparedBy",
                "BranchCode",
                "branchCode",
                "BranchName",
                "branchName",
                "Status",
                "status",
                "StatusLabel",
                "statusLabel",
                "Provider",
                "provider",
                "Supplier",
                "supplier",
                "Technician",
                "technician",
                "Description",
                "description"))
            {
                return false;
            }
        }

        return true;
    }

    private static bool NaviDashboardJsonContainsAny(JsonElement item, string search, params string[] names)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return true;
        }

        foreach (var name in names)
        {
            var value = GetNaviDashboardJsonString(item, name);

            if (NormalizeNaviDashboardCostText(value).Contains(search, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    private static string? GetNaviDashboardJsonString(JsonElement item, params string[] names)
    {
        if (item.ValueKind != JsonValueKind.Object)
        {
            return null;
        }

        foreach (var name in names)
        {
            if (!item.TryGetProperty(name, out var value))
            {
                continue;
            }

            if (value.ValueKind == JsonValueKind.String)
            {
                return value.GetString();
            }

            if (value.ValueKind == JsonValueKind.Number)
            {
                if (value.TryGetDecimal(out var decimalValue))
                {
                    return decimalValue.ToString(CultureInfo.InvariantCulture);
                }

                if (value.TryGetInt64(out var integerValue))
                {
                    return integerValue.ToString(CultureInfo.InvariantCulture);
                }
            }

            if (value.ValueKind == JsonValueKind.True)
            {
                return "true";
            }

            if (value.ValueKind == JsonValueKind.False)
            {
                return "false";
            }
        }

        return null;
    }

    private static decimal ParseNaviDashboardMoney(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return 0;
        }

        var clean = value
            .Replace("COP", "", StringComparison.OrdinalIgnoreCase)
            .Replace("$", "", StringComparison.OrdinalIgnoreCase)
            .Replace(" ", "", StringComparison.OrdinalIgnoreCase)
            .Trim();

        if (string.IsNullOrWhiteSpace(clean))
        {
            return 0;
        }

        var cultures = new[]
        {
            new CultureInfo("es-CO"),
            CultureInfo.InvariantCulture,
            CultureInfo.CurrentCulture
        };

        foreach (var culture in cultures)
        {
            if (decimal.TryParse(clean, NumberStyles.Any, culture, out var parsed))
            {
                return parsed;
            }
        }

        clean = clean.Replace(".", "").Replace(",", ".");

        return decimal.TryParse(clean, NumberStyles.Any, CultureInfo.InvariantCulture, out var fallback)
            ? fallback
            : 0;
    }

    private static bool IsNaviDashboardPositiveCostStatus(string? status)
    {
        var value = NormalizeNaviDashboardCostText(status);

        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        var blocked = new[]
        {
            "rechaz",
            "cancel",
            "anulad",
            "elimin",
            "void",
            "reject",
            "denied",
            "baja"
        };

        return !blocked.Any(value.Contains);
    }

    private static string NormalizeNaviDashboardCostText(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? string.Empty
            : value.Trim().ToLowerInvariant();
    }
    // NAVI ADMIN DASHBOARD COSTS RESTORE END
    private async Task<PhysicalCountListItem?> LoadLatestOpenPhysicalCountAsync(HttpClient client)
    {
        try
        {
            using var response = await client.GetAsync("api/physical-counts");

            if (!response.IsSuccessStatusCode)
            {
                return null;
            }

            var items = await response.Content.ReadFromJsonAsync<List<PhysicalCountListItem>>() ?? new();

            return items
                .Where(x =>
                    ContainsNaviPhysicalStatus(x.StatusLabel, "abierta") ||
                    ContainsNaviPhysicalStatus(x.StatusLabel, "open") ||
                    ContainsNaviPhysicalStatus(x.StatusLabel, "proceso") ||
                    ContainsNaviPhysicalStatus(x.StatusLabel, "active") ||
                    ContainsNaviPhysicalStatus(x.StatusLabel, "pendiente"))
                .OrderByDescending(x => x.CreatedAt)
                .FirstOrDefault();
        }
        catch
        {
            return null;
        }
    }

    private static bool ContainsNaviPhysicalStatus(string? value, string expected)
    {
        return !string.IsNullOrWhiteSpace(value) &&
               value.Contains(expected, StringComparison.OrdinalIgnoreCase);
    }


