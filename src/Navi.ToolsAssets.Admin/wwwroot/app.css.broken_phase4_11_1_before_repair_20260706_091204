html, body {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

a, .btn-link {
    color: #006bb7;
}

.btn-primary {
    color: #fff;
    background-color: #1b6ec2;
    border-color: #1861ac;
}

.btn:focus, .btn:active:focus, .btn-link.nav-link:focus, .form-control:focus, .form-check-input:focus {
  box-shadow: 0 0 0 0.1rem white, 0 0 0 0.25rem #258cfb;
}

.content {
    padding-top: 1.1rem;
}

h1:focus {
    outline: none;
}

.valid.modified:not([type=checkbox]) {
    outline: 1px solid #26b050;
}

.invalid {
    outline: 1px solid #e50000;
}

.validation-message {
    color: #e50000;
}

.blazor-error-boundary {
    background: url(data:image/svg+xml;base64,) no-repeat 1rem/1.8rem, #b32121;
    padding: 1rem 1rem 1rem 3.7rem;
    color: white;
}

    .blazor-error-boundary::after {
        content: "An error has occurred."
    }

.darker-border-checkbox.form-check-input {
    border-color: #929292;
}

.dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.dashboard-header h1 {
    margin-bottom: 0.25rem;
    font-weight: 700;
}

.dashboard-header p {
    margin: 0;
    color: #6c757d;
}

.kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(160px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.kpi-card {
    background: #ffffff;
    border: 1px solid #dee2e6;
    border-left: 5px solid #0d6efd;
    border-radius: 0.75rem;
    padding: 1rem;
    box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.04);
}

.kpi-card span {
    display: block;
    color: #6c757d;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
}

.kpi-card strong {
    font-size: 2rem;
    line-height: 1;
}

.kpi-card.success {
    border-left-color: #198754;
}

.kpi-card.warning {
    border-left-color: #ffc107;
}

.kpi-card.danger {
    border-left-color: #dc3545;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(280px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
}

.dashboard-panel {
    background: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 0.75rem;
    padding: 1rem;
    box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.04);
}

.dashboard-panel h2 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    font-weight: 700;
}

.dashboard-footer {
    color: #6c757d;
    font-size: 0.9rem;
    margin-top: 1rem;
}

@media (max-width: 992px) {
    .kpi-grid,
    .dashboard-grid {
        grid-template-columns: 1fr;
    }
}

.bar-chart {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.bar-row {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
}

.bar-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
}

.bar-label span {
    font-weight: 600;
}

.bar-label strong {
    font-size: 1rem;
}

.bar-track {
    width: 100%;
    height: 16px;
    background: #e9ecef;
    border-radius: 999px;
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    background: #0d6efd;
    border-radius: 999px;
    transition: width 0.35s ease;
}

.bar-fill.branch {
    background: #198754;
}

.top-title {
    font-weight: 600;
    color: #495057;
}

.top-title {
    font-weight: 600;
    color: #495057;
}

html, body {
    font-family: 'Poppins', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button,
input,
select,
textarea,
.table,
.nav-link,
.navbar-brand {
    font-family: 'Poppins', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

h1, h2, h3, h4, h5, h6,
.kpi-card strong,
.dashboard-header h1 {
    font-family: 'Poppins', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.page-header h1 {
    margin-bottom: 0.25rem;
    font-weight: 700;
}

.page-header p {
    margin: 0;
    color: #6c757d;
}

.inventory-summary {
    display: grid;
    grid-template-columns: repeat(4, minmax(160px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.inventory-summary-card {
    background: #ffffff;
    border: 1px solid #dee2e6;
    border-left: 5px solid #0d6efd;
    border-radius: 0.75rem;
    padding: 1rem;
    box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.04);
}

.inventory-summary-card span {
    display: block;
    color: #6c757d;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
}

.inventory-summary-card strong {
    font-size: 1.8rem;
    line-height: 1;
}

.inventory-summary-card.success {
    border-left-color: #198754;
}

.inventory-summary-card.warning {
    border-left-color: #ffc107;
}

.inventory-summary-card.danger {
    border-left-color: #dc3545;
}

.inventory-panel {
    background: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 0.75rem;
    padding: 1rem;
    box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.04);
}

.inventory-toolbar {
    display: grid;
    grid-template-columns: 1fr 220px 180px;
    gap: 0.75rem;
    margin-bottom: 1rem;
}

.inventory-count {
    color: #6c757d;
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
}

.inventory-table thead th {
    color: #495057;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.03rem;
}

.inventory-table tbody td {
    vertical-align: middle;
}

.nav-section-title {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06rem;
    padding: 1rem 1rem 0.35rem 1rem;
}

@media (max-width: 992px) {
    .inventory-summary,
    .inventory-toolbar {
        grid-template-columns: 1fr;
    }
}

/* Modo compacto NAVI: reduce fuente, espacios y separaciones aproximadamente 15% */
:root {
    font-size: 85%;
}

body {
    font-size: 0.85rem;
}

.content {
    padding-top: 0.85rem !important;
}

.top-row {
    height: 3rem;
}

.dashboard-header,
.page-header {
    margin-bottom: 1.15rem;
    gap: 0.85rem;
}

.dashboard-header h1,
.page-header h1 {
    font-size: 1.85rem;
}

.dashboard-header p,
.page-header p {
    font-size: 0.85rem;
}

.kpi-grid,
.dashboard-grid,
.inventory-summary {
    gap: 0.85rem;
    margin-bottom: 1.15rem;
}

.kpi-card,
.dashboard-panel,
.inventory-summary-card,
.inventory-panel {
    padding: 0.85rem;
    border-radius: 0.65rem;
}

.kpi-card span,
.inventory-summary-card span {
    font-size: 0.78rem;
    margin-bottom: 0.35rem;
}

.kpi-card strong,
.inventory-summary-card strong {
    font-size: 1.55rem;
}

.dashboard-panel h2 {
    font-size: 0.98rem;
    margin-bottom: 0.75rem;
}

.inventory-toolbar {
    gap: 0.65rem;
    margin-bottom: 0.85rem;
}

.inventory-count {
    font-size: 0.78rem;
    margin-bottom: 0.6rem;
}

.table {
    font-size: 0.82rem;
}

.table > :not(caption) > * > * {
    padding: 0.42rem 0.45rem;
}

.badge {
    font-size: 0.72rem;
    padding: 0.32em 0.55em;
}

.btn {
    font-size: 0.82rem;
    padding: 0.38rem 0.68rem;
}

.form-control,
.form-select {
    font-size: 0.82rem;
    padding: 0.38rem 0.6rem;
}

.navbar-brand {
    font-size: 0.95rem;
}

.nav-link {
    font-size: 0.82rem;
    padding: 0.55rem 0.75rem;
}

.nav-section-title {
    font-size: 0.65rem;
    padding: 0.8rem 1rem 0.25rem 1rem;
}

.bar-chart {
    gap: 0.75rem;
}

.bar-row {
    gap: 0.25rem;
}

.bar-track {
    height: 13px;
}

.dashboard-footer {
    font-size: 0.78rem;
}

.navi-bottom-bar {
    position: fixed;
    left: 250px;
    right: 0;
    bottom: 0;
    height: 28px;
    background: linear-gradient(90deg, #071f5f, #4b005c);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.02rem;
    z-index: 1000;
    box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.12);
}

.navi-bottom-bar .separator {
    opacity: 0.65;
}

main {
    padding-bottom: 34px;
}

@media (max-width: 640px) {
    .navi-bottom-bar {
        left: 0;
        font-size: 0.68rem;
    }
}

/* Ajuste visual corporativo: negro + morado */
.sidebar {
    background: linear-gradient(180deg, #020202 0%, #090012 38%, #250034 68%, #4b005c 100%) !important;
}

.sidebar .top-row,
.navbar,
.navbar-dark {
    background: #020202 !important;
}

.navbar-brand {
    color: #ffffff !important;
    font-weight: 600;
}

.nav-scrollable {
    background: transparent !important;
}

.nav-section-title {
    color: rgba(255, 255, 255, 0.62) !important;
}

.nav-item .nav-link {
    color: rgba(255, 255, 255, 0.92) !important;
    background: transparent !important;
    border-radius: 0.35rem;
}

.nav-item .nav-link:hover {
    background: rgba(255, 255, 255, 0.10) !important;
}

.nav-item .nav-link.active {
    background: rgba(255, 255, 255, 0.18) !important;
    color: #ffffff !important;
    font-weight: 600;
}

/* Barra superior más limpia */
.top-row {
    background: #ffffff !important;
    border-bottom: 1px solid #dee2e6;
}

.top-title {
    color: #1f2937 !important;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Barra inferior en toda la pantalla */
.navi-bottom-bar {
    left: 0 !important;
    right: 0 !important;
    width: 100vw !important;
    background: linear-gradient(90deg, #020202 0%, #14001f 45%, #4b005c 100%) !important;
    color: #ffffff !important;
    z-index: 3000 !important;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Evita que el contenido quede tapado por la barra inferior */
