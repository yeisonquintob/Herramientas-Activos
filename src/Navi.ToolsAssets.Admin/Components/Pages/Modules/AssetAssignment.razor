@page "/asset-assignment"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject NaviAccessScopeService AccessScope
@using Navi.ToolsAssets.Admin.Services.Auth
@using Navi.ToolsAssets.Admin.Components.Shared
@inject NavigationManager NavigationManager
@inject WebAuthSessionService AuthSession

<PageTitle>Asignar Herramientas y AF - NAVI</PageTitle>

<PermissionGuard Permission="AssetAssignment.View" ModuleName="Asignar Herramientas y AF">

<NaviPageHero
    Pill="ACTIVOS FIJOS"
    Title="Asignar Herramientas y AF"
    Description="Solicita, aprueba, asigna o regresa activos fijos con trazabilidad de préstamo y responsable.">

    <button type="button" @onclick="LoadAsync" data-ntx-tone="secondary" >
        Actualizar
    </button>

</NaviPageHero>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="@messageClass">@message</div>
}


<section class="assignment-kpi-grid">
    <article class="assignment-kpi total">
        <span>Total activos</span>
        <strong>@FilteredTools.Count()</strong>
        <small>Según filtros activos</small>
    </article>

    <article class="assignment-kpi success">
        <span>Disponibles</span>
        <strong>@FilteredTools.Count(x => string.Equals(x.OperationalStatus, "Available", StringComparison.OrdinalIgnoreCase))</strong>
        <small>Listos para asignar</small>
    </article>

    <article class="assignment-kpi neutral">
        <span>Asignadas / prestadas</span>
        <strong>@FilteredTools.Count(x => string.Equals(x.OperationalStatus, "Assigned", StringComparison.OrdinalIgnoreCase) || string.Equals(x.OperationalStatus, "Loaned", StringComparison.OrdinalIgnoreCase))</strong>
        <small>Con responsable</small>
    </article>

    <article class="assignment-kpi warning">
        <span>Solicitudes</span>
        <strong>@FilteredTools.Count(x => FindPendingRequestForTool(x.Id) is not null)</strong>
        <small>Pendientes de decisión</small>
    </article>

    <article class="assignment-kpi danger">
        <span>Sin responsable</span>
        <strong>@FilteredTools.Count(x => x.ResponsiblePersonId is null)</strong>
        <small>Disponibles o por revisar</small>
    </article>
</section>

<section class="assignment-status-filters assignment-status-filters-modern" aria-label="Estados de asignación">
    <button type="button"
            class="assignment-status-filter-chip assignment-status-all @(selectedToolStatuses.Count == 0 ? "active" : "")"
            @onclick="ClearToolStatusFilter" data-ntx-tone="primary" >
        Todos
        <span>@AssignmentBaseFilteredTools.Count()</span>
    </button>

    @foreach (var status in ToolStatusFilterOptions)
    {
        var selected = selectedToolStatuses.Contains(status.Value);

        <button type="button"
                class="@GetAssignmentStatusChipClass(status.Value, selected)"
                @onclick="() => ToggleToolStatusFilter(status.Value)" data-ntx-tone="primary" >
            @status.Text
            <span>@AssignmentBaseFilteredTools.Count(x => string.Equals(x.OperationalStatus, status.Value, StringComparison.OrdinalIgnoreCase))</span>
        </button>
    }
</section>

<section class="assignment-page-filters" aria-label="Filtros de asignación">
    <input class="form-control form-control-sm"
           placeholder="Buscar código, nombre, serial, sede, ubicación o responsable..."
           @bind="search"
           @bind:event="oninput" />

    <input class="form-control form-control-sm"
           list="assignment-table-branches-list"
           value="@selectedBranchSearchText"
           @oninput="OnTableBranchSearchInput"
           placeholder="Todas las sedes" />

    <datalist id="assignment-table-branches-list">
        @if (IsAllBranchScope())
        {
            <option value="Todas las sedes"></option>
        }

        @foreach (var branch in BranchFilterOptions)
        {
            <option value="@FormatBranchOption(branch)"></option>
            <option value="@branch.Code"></option>
            <option value="@branch.Name"></option>
        }
    </datalist>

    <input class="form-control form-control-sm"
           list="table-responsibles-list"
           value="@selectedResponsibleSearchText"
           @oninput="OnTableResponsibleSearchInput"
           placeholder="Todos los usuarios" />

    <datalist id="table-responsibles-list">
        <option value="Todos los usuarios"></option>
        <option value="Sin responsable"></option>
        @foreach (var responsible in responsibles.OrderBy(x => x.FullName))
        {
            <option value="@FormatResponsibleOption(responsible)"></option>
            <option value="@responsible.FullName"></option>
        }
    </datalist>
</section>

<section class="af-grid">
    <aside class="af-left-stack">
        <div class="af-card">
            <h3>@GetMovementTitle()</h3>

            <div class="mb-2 navi-search-field">
                <label class="form-label">Activo fijo</label>
                <input class="form-control"
                       list="assignment-tools-list"
                       value="@assignmentToolSearchText"
                       @oninput="OnAssignmentToolSearchInput"
                       placeholder="Escriba código, nombre o serial..." />

                <datalist id="assignment-tools-list">
                    @foreach (var tool in ScopedTools.OrderBy(x => x.InternalCode))
                    {
                        <option value="@FormatToolOption(tool)"></option>
                    }
                </datalist>

                <small class="@GetAssignmentToolHintClass()">@GetAssignmentToolHint()</small>
            </div>

            <div class="mb-2">
                <label class="form-label">Tipo de movimiento</label>
                <InputSelect class="form-select" @bind-Value="form.AssignmentType">
                    <option value="Responsible">Asignar a usuario/responsable</option>
                    <option value="Warehouse">Regresar a almacén/taller</option>
                </InputSelect>
            </div>

            @if (form.AssignmentType == "Responsible")
            {
                <div class="mb-2 navi-search-field">
                    <label class="form-label">Usuario / Responsable</label>
                    <input class="form-control"
                           list="assignment-responsibles-list"
                           value="@assignmentResponsibleSearchText"
                           @oninput="OnAssignmentResponsibleSearchInput"
                           placeholder="Escriba nombre, cargo o responsable..." />

                    <datalist id="assignment-responsibles-list">
                        @foreach (var responsible in responsibles.OrderBy(x => x.FullName))
                        {
                            <option value="@FormatResponsibleOption(responsible)"></option>
                        }
                    </datalist>

                    <small class="@GetAssignmentResponsibleHintClass()">@GetAssignmentResponsibleHint()</small>
                </div>
            }

            @if (form.AssignmentType == "Warehouse")
            {
                <div class="mb-2 navi-search-field">
                    <label class="form-label">Sede destino</label>
                    <input class="form-control"
                           list="assignment-branches-list"
                           value="@assignmentBranchSearchText"
                           @oninput="OnAssignmentBranchSearchInput"
                           placeholder="Escriba código o nombre de sede..." />

                    <datalist id="assignment-branches-list">
                        @foreach (var branch in branches.OrderBy(x => x.Code))
                        {
                            <option value="@FormatBranchOption(branch)"></option>
                        }
                    </datalist>

                    <small class="@GetAssignmentBranchHintClass()">@GetAssignmentBranchHint()</small>
                </div>

                <div class="mb-2 navi-search-field">
                    <label class="form-label">Almacén / Taller destino</label>
                    <input class="form-control"
                           list="assignment-locations-list"
                           value="@assignmentLocationSearchText"
                           @oninput="OnAssignmentLocationSearchInput"
                           placeholder="Escriba almacén, taller o ubicación..." />

                    <datalist id="assignment-locations-list">
                        @foreach (var location in AvailableLocations.OrderBy(x => x.Code))
                        {
                            <option value="@FormatLocationOption(location)"></option>
                        }
                    </datalist>

                    <small class="@GetAssignmentLocationHintClass()">@GetAssignmentLocationHint()</small>
                </div>

                <div class="mb-2">
                    <label class="form-label">Estantería / ubicación exacta destino</label>
                    <InputText class="form-control"
                               @bind-Value="form.ShelfLocation"
                               placeholder="Ej: EST-A1, RACK-3, CAJÓN 2" />
                    <small class="navi-search-hint ok">Punto exacto donde queda guardado el activo al regresar al almacén/taller.</small>
                </div>

            }

            <div class="mb-2">
                <label class="form-label">
                    @(form.AssignmentType == "Warehouse" ? "Fecha de regreso" : "Fecha de asignación")
                </label>
                <InputDate class="form-control" @bind-Value="form.AssignmentDate" />
            </div>

            <div class="mb-3">
                <label class="form-label">Observación</label>
                <InputTextArea class="form-control" @bind-Value="form.Observation" rows="3" />
            </div>

            <div class="d-grid gap-2">
                @if (form.AssignmentType == "Warehouse")
                {
                    <button class="assign-main assign-main-warning" @onclick="SaveAsync" disabled="@(isSaving || !CanReturnAsset)" data-ntx-tone="primary" >
                        @(isSaving ? "Guardando..." : "Confirmar regreso")
                    </button>
                }
                else
                {
                    <button class="assign-main assign-main-primary" @onclick="SaveAsync" disabled="@(isSaving || !CanAssignAsset)" data-ntx-tone="primary" >
                        @(isSaving ? "Guardando..." : "Confirmar asignación")
                    </button>
                }

                <button class="assign-main assign-main-neutral" @onclick="ClearForm" data-ntx-tone="secondary" >
                    Limpiar
                </button>
            </div>
        </div>

        <div class="af-card history-launch-card">
            <span class="history-pill">HISTORIAL</span>
            <h3>Historial por usuario</h3>
            <p>Consulta en una vista completa los activos asignados, entregados, regresados y sus detalles.</p>

            <div class="mb-2">
                <label class="form-label">Usuario / Responsable</label>
                <input class="form-control form-control-sm"
                       list="history-responsibles-list"
                       value="@historyResponsibleSearchText"
                       @oninput="OnHistoryResponsibleSearchInput"
                       placeholder="Escriba usuario o responsable..." />

                <datalist id="history-responsibles-list">
                    <option value="Todos los usuarios"></option>
                    @foreach (var responsible in responsibles.OrderBy(x => x.FullName))
                    {
                        <option value="@FormatResponsibleOption(responsible)"></option>
                    }
                </datalist>
            </div>

            <div class="mb-3">
                <label class="form-label">Buscar</label>
                <input class="form-control form-control-sm"
                       placeholder="Código, activo fijo, serial o detalle..."
                       @bind="historySearch"
                       @bind:event="oninput" />
            </div>

            <button class="btn-open-history" @onclick="OpenHistory" disabled="@(!CanViewAssignmentHistory)" data-ntx-tone="ghost" >
                Abrir historial de asignaciones
            </button>
        </div>

        <div class="af-card request-card">
            <span class="history-pill request">SOLICITUD</span>
            <h3>Solicitud de asignación</h3>
            <p>Busca una herramienta y solicita que sea asignada a tu usuario. El herramentero la aprueba desde esta misma vista.</p>

            <div class="request-user">
                <span>Solicitante</span>
                <strong>@GetCurrentResponsibleLabel()</strong>
            </div>

            @if (!CanRequestAssignment)
            {
                <div class="assignment-request-warning">
                    No tienes permiso AssetAssignment.Request para crear solicitudes de asignación.
                </div>
            }
            else if (CurrentRequesterPersonId is null)
            {
                <div class="assignment-request-info">
                    No hay responsable operativo asociado al usuario. Asócialo en Configuración > Usuarios antes de crear solicitudes.
                </div>
            }

            <div class="mb-2">
                <label class="form-label">Buscar herramienta</label>
                <input class="form-control form-control-sm"
                       placeholder="Escriba código, nombre o serial..."
                       @bind="requestSearch"
                       @bind:event="oninput" />
            </div>

            @if (!requestForm.ToolId.HasValue && !string.IsNullOrWhiteSpace(requestSearch))
            {
                <div class="request-results">
                    <div class="request-results-title">
                        <span>Resultados filtrados</span>
                        <strong>@RequestTools.Count()</strong>
                    </div>

                    @if (!RequestTools.Any())
                    {
                        <div class="request-result-empty">
                            No se encontraron herramientas con ese criterio.
                        </div>
                    }
                    else
                    {
                        @foreach (var tool in RequestTools.Take(7))
                        {
                            var pending = FindPendingRequestForTool(tool.Id);
                            var isSelected = requestForm.ToolId == tool.Id;

                            <button type="button"
                                    class="request-result-card @(isSelected ? "selected" : "")"
                                    @onclick="() => SelectRequestTool(tool)" data-ntx-tone="ghost" >
                                <span>
                                    <strong>@tool.InternalCode</strong>
                                    <small>@tool.Name</small>
                                    <small>@Show(tool.BranchCode) · @Show(tool.LocationName) · Est: @Show(tool.ShelfLocation)</small>
                                </span>

                                <em class="@GetRequestAvailabilityClass(tool, pending)">
                                    @(pending is not null ? "Con solicitud" : GetStatusLabel(tool.OperationalStatus))
                                </em>
                            </button>
                        }
                    }
                </div>
            }

            @if (SelectedRequestTool is not null)
            {
                <div class="selected-request-tool">
                    <div>
                        <span>Herramienta seleccionada</span>
                        <strong>@SelectedRequestTool.InternalCode - @SelectedRequestTool.Name</strong>
                        <small>@Show(SelectedRequestTool.BranchCode) · @Show(SelectedRequestTool.LocationName) · Est: @Show(SelectedRequestTool.ShelfLocation)</small>
                    </div>

                    <button type="button" @onclick="ClearRequestToolSelection" data-ntx-tone="ghost" >
                        Cambiar
                    </button>
                </div>
            }

            <div class="mb-2">
                <label class="form-label">Fecha estimada de devolución</label>
                <InputDate class="form-control form-control-sm" @bind-Value="requestForm.ExpectedReturnAt" />
            </div>

            <div class="mb-3">
                <label class="form-label">Observación</label>
                <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="requestForm.Notes" />
            </div>

            @if (!CanRequestAssignment)
            {
                <div class="assignment-permission-note">
                    Solicitud bloqueada por permiso AssetAssignment.Request.
                </div>
            }

            <button type="button"
                    class="btn-request-assignment"
                    @onclick="SubmitSelfAssignmentRequestAsync"
                    disabled="@(isSaving || !CanRequestAssignment || CurrentRequesterPersonId is null || !requestForm.ToolId.HasValue)" data-ntx-tone="ghost" >
                @(isSaving ? "Registrando..." : "Solicitud de asignación")
            </button>
        </div>

        <div class="af-card pending-card">
            <span class="history-pill approve">APROBACIÓN</span>
            <h3>Solicitudes pendientes</h3>

            @if (!PendingLoanRequests.Any())
            {
                <div class="pending-empty">No hay solicitudes pendientes.</div>
            }
            else
            {
                <div class="pending-list">
                    @foreach (var request in PendingLoanRequests.Take(6))
                    {
                        var item = request.Items.FirstOrDefault();

                        <article>
                            <div>
                                <strong>@request.LoanNumber</strong>
                                <span>@Show(item?.ToolInternalCode) - @Show(item?.ToolName)</span>
                                <small>Solicita: @Show(request.CreatedBy) · @ShowDate(request.RequestedAt)</small>
                            </div>

                            <div class="pending-actions">
                                <button class="approve" @onclick="() => ApproveRequestAsync(request)"
                                        disabled="@(isSaving || !CanApproveAssignmentRequest)" data-ntx-tone="danger" >
                                    Aprobar
                                </button>

                                <button class="deny" @onclick="() => RejectRequestAsync(request)"
                                        disabled="@(isSaving || !CanDenyAssignmentRequest)" data-ntx-tone="danger" >
                                    Denegar
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </aside>

    <section class="af-card">
        <div class="af-table-header">
            <div>
                <h3>Activos asignables</h3>
                <p>Consulta el estado actual y registra asignaciones, regresos o aprobaciones.</p>
            </div>
        </div>

        @if (isLoading)
        {
            <p>Cargando activos...</p>
        }
        else if (!FilteredTools.Any())
        {
            <div class="alert alert-info">No hay activos para los filtros seleccionados.</div>
        }
        else
        {
            <table class="table table-hover align-middle af-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Activo</th>
                        <th>Sede</th>
                        <th>Ubicación</th>
                        <th>Estantería</th>
                        <th>Usuario / Responsable</th>
                        <th>Estado</th>
                        <th>Solicitud</th>
                        <th>Fecha asignación</th>
                        <th>Fecha entrega</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tool in FilteredTools)
                    {
                        var pending = FindPendingRequestForTool(tool.Id);

                        <tr>
                            <td><strong>@tool.InternalCode</strong></td>
                            <td>
                                <div>@tool.Name</div>
                                <small class="text-muted">@Show(tool.SerialNumber)</small>
                            </td>
                            <td>@Show(tool.BranchCode)</td>
                            <td>@Show(tool.LocationName)</td>
                            <td><span class="assignment-shelf-pill">@Show(tool.ShelfLocation)</span></td>
                            <td>
                                <div>@Show(tool.ResponsiblePersonName)</div>
                                <small class="text-muted">@Show(tool.ResponsiblePosition)</small>
                            </td>
                            <td><span class="@GetStatusBadge(tool.OperationalStatus)">@GetStatusLabel(tool.OperationalStatus)</span></td>
                            <td>
                                @if (pending is null)
                                {
                                    <span class="request-state empty">Sin solicitud</span>
                                }
                                else
                                {
                                    <span class="request-state pending">@pending.LoanNumber</span>
                                }
                            </td>
                            <td>@ShowDate(tool.LastAssignmentDate)</td>
                            <td>@ShowDate(tool.LastReturnDate)</td>
                            <td class="text-end">
                                <div class="assignment-actions">
                                    <button class="assign-action assign-action-primary" @onclick="() => SelectForAssignment(tool)" disabled="@(!CanDirectAssign)" data-ntx-tone="positive" >
                                        Asignar
                                    </button>

                                    <button class="assign-action assign-action-success"
                                            @onclick="() => ApproveRequestAsync(pending)"
                                            disabled="@(pending is null || !CanApproveAssignmentRequest || isSaving)" data-ntx-tone="danger" >
                                        Aprobar
                                    </button>

                                    <button class="assign-action assign-action-danger"
                                            @onclick="() => RejectRequestAsync(pending)"
                                            disabled="@(pending is null || !CanDenyAssignmentRequest || isSaving)" data-ntx-tone="danger" >
                                        Denegar
                                    </button>

                                    <button class="assign-action assign-action-warning" @onclick="() => SelectForReturn(tool)" disabled="@(!CanReturnAssignment)" data-ntx-tone="primary" >
                                        Regresar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</section>

</PermissionGuard>



@code {
    private bool showStatusFilterPanel;
    private HashSet<string> selectedToolStatuses = new(StringComparer.OrdinalIgnoreCase);

    private readonly (string Value, string Text)[] ToolStatusFilterOptions =
    {
        ("Available", "Disponible"),
        ("Assigned", "Asignada"),
        ("Loaned", "Prestada"),
        ("InMaintenance", "Mantenimiento"),
        ("Damaged", "Dañada"),
        ("NotSuitable", "No apta"),
        ("PendingValidation", "Pendiente validación"),
        ("NotLocated", "No localizada"),
        ("Disposed", "Baja")
    };



    private static string FormatNullableLocalDateTime(DateTime? value, string format)
    {
        return value.HasValue
            ? value.Value.ToLocalTime().ToString(format)
            : "—";
    }

    private static string FormatNullableLocalDateTime(DateTime value, string format)
    {
        return value.ToLocalTime().ToString(format);
    }

    private static DateTime? GetNullableLocalDateTime(DateTime? value)
    {
        return value.HasValue
            ? value.Value.ToLocalTime()
            : null;
    }

    private static DateTime GetNullableLocalDateTime(DateTime value)
    {
        return value.ToLocalTime();
    }



    private Guid? ReadGuidProperty(object? item, string propertyName)
    {
        if (item is null || string.IsNullOrWhiteSpace(propertyName))
        {
            return null;
        }

        var flags = System.Reflection.BindingFlags.Instance
            | System.Reflection.BindingFlags.Public
            | System.Reflection.BindingFlags.NonPublic
            | System.Reflection.BindingFlags.IgnoreCase;

        var property = item.GetType().GetProperty(propertyName, flags);
        var value = property?.GetValue(item);

        if (value is Guid guidValue && guidValue != Guid.Empty)
        {
            return guidValue;
        }

        if (value is string stringValue && Guid.TryParse(stringValue, out var parsedGuid) && parsedGuid != Guid.Empty)
        {
            return parsedGuid;
        }

        return null;
    }


















    private Guid? CurrentRequesterResponsibleId =>
        ReadGuidProperty(CurrentRequesterResponsible, "Id")
        ?? ReadGuidProperty(CurrentSessionUser?.ResponsiblePerson, "Id")
        ?? ReadGuidProperty(CurrentSessionUser, "ResponsiblePersonId")
        ?? ReadGuidProperty(CurrentSessionUser, "ResponsibleId")
        ?? ReadGuidProperty(CurrentSessionUser, "AssociatedResponsiblePersonId");

    private string CurrentRequesterResponsibleName =>
        ReadTextProperty(CurrentRequesterResponsible, "Name")
        ?? ReadTextProperty(CurrentRequesterResponsible, "FullName")
        ?? ReadTextProperty(CurrentRequesterResponsible, "DisplayName")
        ?? ReadTextProperty(CurrentRequesterResponsible, "Description")
        ?? ReadTextProperty(CurrentSessionUser?.ResponsiblePerson, "Name")
        ?? ReadTextProperty(CurrentSessionUser?.ResponsiblePerson, "FullName")
        ?? ReadTextProperty(CurrentSessionUser?.ResponsiblePerson, "DisplayName")
        ?? ReadTextProperty(CurrentSessionUser, "ResponsiblePersonName")
        ?? ReadTextProperty(CurrentSessionUser, "ResponsibleName")
        ?? ReadTextProperty(CurrentSessionUser, "AssociatedResponsiblePersonName")
        ?? ReadTextProperty(CurrentSessionUser, "FullName")
        ?? ReadTextProperty(CurrentSessionUser, "Name")
        ?? AuthSession.DisplayName
        ?? AuthSession.UserName
        ?? string.Empty;




    private string GetRequesterDisplayName(object? item)
    {
        var value =
            ReadTextProperty(item, "RequestedByResponsiblePersonName") ??
            ReadTextProperty(item, "RequestedByPersonName") ??
            ReadTextProperty(item, "RequesterResponsibleName") ??
            ReadTextProperty(item, "ResponsiblePersonName") ??
            ReadTextProperty(item, "RequestedByUserName") ??
            ReadTextProperty(item, "RequesterName") ??
            ReadTextProperty(item, "CreatedByName") ??
            ReadTextProperty(item, "CreatedBy");

        if (string.IsNullOrWhiteSpace(value) || value == "-")
        {
            value =
                ReadTextProperty(CurrentRequesterResponsible, "Name") ??
                ReadTextProperty(CurrentSessionUser?.ResponsiblePerson, "Name") ??
                AuthSession.DisplayName ??
                AuthSession.UserName ??
                "—";
        }

        return value;
    }

    private string? ReadTextProperty(object? item, string propertyName)
    {
        if (item is null)
        {
            return null;
        }

        var property = item.GetType().GetProperty(propertyName);
        if (property is null)
        {
            return null;
        }

        var value = property.GetValue(item)?.ToString();
        return string.IsNullOrWhiteSpace(value) ? null : value;
    }
private bool CanAssignAsset =>
        AuthSession.HasPermission("AssetAssignment.Assign");

    private bool CanReturnAsset =>
        AuthSession.HasPermission("AssetAssignment.Return");

    private bool CanRequestAssignment =>
        AuthSession.HasPermission("AssetAssignment.Request");

    private bool CanApproveAssignmentRequest =>
        AuthSession.HasPermission("AssetAssignment.Approve");

    private bool CanDenyAssignmentRequest =>
        AuthSession.HasPermission("AssetAssignment.Deny");

    private bool CanViewAssignmentHistory =>
        AuthSession.HasPermission("AssetAssignment.History");

    private bool CanDirectAssign => CanAssignAsset;

    private bool CanReturnAssignment => CanReturnAsset;

    private UserItem? CurrentSessionUser =>
        users.FirstOrDefault(x =>
            string.Equals(x.UserName, AuthSession.UserName, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.DisplayName, AuthSession.DisplayName, StringComparison.OrdinalIgnoreCase));

    private ResponsibleItem? CurrentRequesterResponsible
    {
        get
        {
            if (AuthSession.ResponsiblePersonId.HasValue)
            {
                var sessionResponsible = responsibles.FirstOrDefault(x => x.Id == AuthSession.ResponsiblePersonId);

                if (sessionResponsible is not null)
                {
                    return sessionResponsible;
                }
            }

            if (CurrentSessionUser?.ResponsiblePerson is not null)
            {
                return CurrentSessionUser.ResponsiblePerson;
            }

            return responsibles.FirstOrDefault(x =>
                string.Equals(x.FullName, AuthSession.ResponsiblePersonName, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(x.FullName, AuthSession.DisplayName, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(x.DocumentNumber, AuthSession.UserName, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(x.EmployeeCode, AuthSession.UserName, StringComparison.OrdinalIgnoreCase));
        }
    }

