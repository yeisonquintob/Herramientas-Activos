html body :where(
    section.spc-hero.navi-standard-hero,
    section.navi-module-hero,
    section.plans-hero
) {
    width: 100% !important;
    min-height: 96px !important;
    height: auto !important;

    display: grid !important;
    grid-template-columns: minmax(0, 1fr) 190px !important;
    align-items: center !important;
    gap: 1rem !important;

    margin: 0 0 .85rem 0 !important;
    padding: 1.05rem 1.65rem 1.05rem 1.2rem !important;

    color: #ffffff !important;

    border-radius: .95rem !important;
    border: 1px solid rgba(255,255,255,.10) !important;

    background:
        radial-gradient(circle at 88% 16%, rgba(175, 0, 210, .34), transparent 32%),
        linear-gradient(135deg, #050008 0%, #100016 36%, #30003c 66%, #76008f 100%) !important;

    box-shadow:
        0 .45rem 1.05rem rgba(75,0,92,.15),
        inset 0 1px 0 rgba(255,255,255,.06) !important;

    overflow: hidden !important;
}

/* Quitar cajas internas dentro del banner */
